{"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"kind":"symbol","sections":[],"variants":[{"paths":["\/documentation\/openswiftui\/app"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"A type that represents the structure and behavior of an app.","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"App","kind":"identifier"}]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create an app by declaring a structure that conforms to the "},{"type":"codeVoice","code":"App"},{"type":"text","text":" protocol."},{"type":"text","text":" "},{"type":"text","text":"Implement the required "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/App\/body-swift.property","isActive":true},{"type":"text","text":" computed property"},{"type":"text","text":" "},{"type":"text","text":"to define the app’s content:"}]},{"syntax":null,"type":"codeListing","code":["@main","struct MyApp: App {","    var body: some Scene {","        WindowGroup {","            Text(\"Hello, world!\")","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Precede the structure’s declaration with the"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/docs.swift.org\/swift-book\/ReferenceManual\/Attributes.html#ID626","isActive":true},{"type":"text","text":" "},{"type":"text","text":"attribute to indicate that your custom "},{"type":"codeVoice","code":"App"},{"type":"text","text":" protocol conformer provides the"},{"type":"text","text":" "},{"type":"text","text":"entry point into your app. The protocol provides a de