pe":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentObject","isActive":true},{"type":"text","text":" to scenes in the app:"}]},{"syntax":null,"type":"codeListing","code":["@main","struct Mail: App {","    @StateObject private var model = MailModel()","","    var body: some Scene {","        WindowGroup {","            MailViewer()","                .environmentObject(model) \/\/ Passed through the environment.","        }","        Settings {","            SettingsView(model: model) \/\/ Passed as an observed object.","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A type conforming to this protocol inherits "},{"type":"codeVoice","code":"@preconcurrency @MainActor"},{"type":"text","text":" "},{"type":"text","text":"isolation from the protocol if the conformance is included in the type’s"},{"type":"text","text":" "},{"type":"text","text":"base declaration:"}]},{"syntax":null,"type":"codeListing","code":["struct MyCustomType: Transition {","    \/\/ `@preconcurrency @MainActor` isolation by default","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Isolation to the main actor is the default, but it’s not required. Declare"},{"type":"text","text":" "},{"type":"text","text":"the conformance in an extension to opt out of main actor isolation:"}]},{"syntax":null,"type":"codeListing","code":["extension MyCustomType: Transition {","    \/\/ `nonisolated` by default","}"]}],"kind":"content"}],"metadata":{"navigatorTitle":[{"text":"App","kind":"identifier"}],"title":"App","role":"symbol","symbolKind":"protocol","roleHeading":"Protocol","externalID":"s:11OpenSwiftUI3AppP","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"App","kind":"identifier"}],"modules":[{"name":"OpenSwiftUI"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/App"},"schemaVersion":{"patch":0,"minor":3,"major":0},"topicSections":[{