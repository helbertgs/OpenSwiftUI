\/StateObject","type":"codeVoice"},{"text":" attribute to initialize a","type":"text"},{"text":" ","type":"text"},{"text":"data model, and then provide that model on a view input as an","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ObservedObject"},{"text":" or through the environment as an","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentObject"},{"text":" to scenes in the app:","type":"text"}],"type":"paragraph"},{"code":["@main","struct Mail: App {","    @StateObject private var model = MailModel()","","    var body: some Scene {","        WindowGroup {","            MailViewer()","                .environmentObject(model) \/\/ Passed through the environment.","        }","        Settings {","            SettingsView(model: model) \/\/ Passed as an observed object.","        }","    }","}"],"syntax":null,"type":"codeListing"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/openswiftui\/app"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/App\/Body-swift.associatedtype"],"title":"Associated Types","anchor":"Associated-Types","generated":true},{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/App\/init()"],"title":"Initializers","anchor":"Initializers","generated":true},{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/App\/body-swift.property"],"title":"Instance Properties","anchor":"Instance-Properties","generated":true},{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/App\/main()"],"title":"Type Methods","anchor":"Type-Methods","generated":true}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/App/body-swift.property":{"url":"\/documentation\/openswiftui\/app\/body-swift.property","abstract":[{"type":"text","text":"Th