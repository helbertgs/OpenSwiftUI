{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"@preconcurrency","kind":"attribute"},{"text":" ","kind":"text"},{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"App","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Create an app by declaring a structure that conforms to the "},{"type":"codeVoice","code":"App"},{"type":"text","text":" protocol."},{"type":"text","text":" "},{"type":"text","text":"Implement the required "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/App\/body-swift.property"},{"type":"text","text":" computed property"},{"type":"text","text":" "},{"type":"text","text":"to define the app’s content:"}],"type":"paragraph"},{"syntax":null,"code":["@main","struct MyApp: App {","    var body: some Scene {","        WindowGroup {","            Text(\"Hello, world!\")","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Precede the structure’s declaration with the"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/docs.swift.org\/swift-book\/ReferenceManual\/Attributes.html#ID626"},{"type":"text","text":" "},{"type":"text","text":"attribute to indicate that your custom "},{"type":"codeVoice","code":"App"},{"type":"text","text":" protocol conformer provides the"},{"type":"text","text":" "},{"type":"text","text":"entry point into your app. The protocol provides a default implementation of"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/App\/main()"},{"type":"text","text":" method that the system calls to launch your app."},{"type":"text","text":" "},{"type":"text","text":"You can have exactly one entry point among all of your app’s files."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Compose the app’s body from instances that conform to the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"},{"type":"text","text":" "},{"type":"text","text":"protocol. Each scene contains the root view of a view hierarchy and has a"},{"type":"text","text":" "},{"type":"text","text":"life cycle managed by the system. OpenSwiftUI provides some concrete scene types"},{"type":"text","text":" "},{"type":"text","text":"to handle common scenarios, like for displaying documents or settings. You"},{"type":"text","text":" "},{"type":"text","text":"can also create custom scenes."}],"type":"paragraph"},{"syntax":null,"code":["@main","struct Mail: App {","    var body: some Scene {","        WindowGroup {","            MailViewer()","        }","        Settings {","            SettingsView()","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"You can declare state in your app to share across all of its scenes. For"},{"type":"text","text":" "},{"type":"text","text":"example, you can use the "},{"type":"codeVoice","code":"OpenSwiftUI\/StateObject"},{"type":"text","text":" attribute to initialize a"},{"type":"text","text":" "},{"type":"text","text":"data model, and then provide that model on a view input as an"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ObservedObject"},{"type":"text","text":" or through the environment as an"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentObject"},{"type":"text","text":" to scenes in the app:"}],"type":"paragraph"},{"syntax":null,"code":["@main","struct Mail: App {","    @StateObject private var model = MailModel()","","    var body: some Scene {","        WindowGroup {","            MailViewer()","                .environmentObject(model) \/\/ Passed through the environment.","        }","        Settings {","            SettingsView(model: model) \/\/ Passed as an observed object.","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A type conforming to this protocol inherits "},{"type":"codeVoice","code":"@preconcurrency @MainActor"},{"type":"text","text":" "},{"type":"text","text":"isolation from the protocol if the conformance is included in the type’s"},{"type":"text","text":" "},{"type":"text","text":"base declaration:"}],"type":"paragraph"},{"syntax":null,"code":["struct MyCustomType: Transition {","    \/\/ `@preconcurrency @MainActor` isolation by default","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Isolation to the main actor is the default, but it’s not required. Declare"},{"type":"text","text":" "},{"type":"text","text":"the conformance in an extension to opt out of main actor isolation:"}],"type":"paragraph"},{"syntax":null,"code":["extension MyCustomType: Transition {","    \/\/ `nonisolated` by default","}"],"type":"codeListing"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"topicSections":[{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/App\/Body-swift.associatedtype"],"anchor":"Associated-Types","title":"Associated Types","generated":true},{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/App\/init()"],"anchor":"Initializers","title":"Initializers","generated":true},{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/App\/body-swift.property"],"anchor":"Instance-Properties","title":"Instance Properties","generated":true},{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/App\/main()"],"anchor":"Type-Methods","title":"Type Methods","generated":true}],"ident