penSwiftUI\/StateObject","type":"codeVoice"},{"text":" attribute to initialize a","type":"text"},{"text":" ","type":"text"},{"text":"data model, and then provide that model on a view input as an","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ObservedObject"},{"text":" or through the environment as an","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentObject"},{"text":" to scenes in the app:","type":"text"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["@main","struct Mail: App {","    @StateObject private var model = MailModel()","","    var body: some Scene {","        WindowGroup {","            MailViewer()","                .environmentObject(model) \/\/ Passed through the environment.","        }","        Settings {","            SettingsView(model: model) \/\/ Passed as an observed object.","        }","    }","}"]},{"inlineContent":[{"text":"A type conforming to this protocol inherits ","type":"text"},{"code":"@preconcurrency @MainActor","type":"codeVoice"},{"text":" ","type":"text"},{"text":"isolation from the protocol if the conformance is included in the type’s","type":"text"},{"text":" ","type":"text"},{"text":"base declaration:","type":"text"}],"type":"paragraph"},{"code":["struct MyCustomType: Transition {","    \/\/ `@preconcurrency @MainActor` isolation by default","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"Isolation to the main actor is the default, but it’s not required. Declare","type":"text"},{"text":" ","type":"text"},{"text":"the conformance in an extension to opt out of main actor isolation:","type":"text"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["extension MyCustomType: Transition {","    \/\/ `nonisolated` by default","}"]}],"kind":"content"}],"variants":[{"paths":["\/documentatio