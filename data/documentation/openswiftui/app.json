{"sections":[],"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/App","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/openswiftui\/app"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"A type that represents the structure and behavior of an app.","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"@preconcurrency","kind":"attribute"},{"text":" ","kind":"text"},{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"App","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"Create an app by declaring a structure that conforms to the ","type":"text"},{"code":"App","type":"codeVoice"},{"text":" protocol.","type":"text"},{"text":" ","type":"text"},{"text":"Implement the required ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/App\/body-swift.property","type":"reference","isActive":true},{"text":" computed property","type":"text"},{"text":" ","type":"text"},{"text":"to define the app’s content:","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["@main","struct MyApp: App {","    var body: some Scene {","        WindowGroup {","            Text(\"Hello, world!\")","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Precede the structure’s declaration with the"},{"type":"text","text":" "},{"identifier":"https:\/\/docs.swift.org\/swift-book\/ReferenceManual\/Attributes.html#ID626","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"attribute to indicate that your custom "},{"code":"App","type":"codeVoice"},{"type":"text"