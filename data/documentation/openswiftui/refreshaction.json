{"relationshipsSections":[{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/OpenSwiftUI\/s8CopyableP","doc:\/\/OpenSwiftUI\/SQ","doc:\/\/OpenSwiftUI\/s9EscapableP"],"title":"Conforms To"}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"sections":[],"metadata":{"symbolKind":"struct","externalID":"s:11OpenSwiftUI13RefreshActionV","role":"symbol","modules":[{"name":"OpenSwiftUI"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RefreshAction","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"RefreshAction"}],"title":"RefreshAction","roleHeading":"Structure"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"RefreshAction"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"text":"When the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/refresh","type":"reference"},{"text":" environment value contains an","type":"text"},{"text":" ","type":"text"},{"text":"instance of this structure, certain built-in views in the corresponding","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","type":"reference"},{"text":" begin offering a refresh capability. They apply the","type":"text"},{"text":" ","type":"text"},{"text":"instance’s handler to any refresh operation that the user initiates.","type":"text"},{"text":" ","type":"text"},{"text":"By default, the environment value is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", but you can use the","type":"text"},{"text":" ","type":"text"},{"code":"View\/refreshable(action:)","type":"codeVoice"},{"text":" modifier to create and store a new","type":"text"},{"text":" ","type":"text"},{"text":"refresh action that uses the handler that you specify:","type":"text"}],"type":"paragraph"},{"code":["List(mailbox.conversations) { conversation in","    ConversationCell(conversation)","}",".refreshable {","    await mailbox.fetch()","}"],"type":"codeListing","syntax":null},{"inlineContent":[{"type":"text","text":"On iOS and iPadOS, the "},{"type":"codeVoice","code":"List"},{"type":"text","text":" in the example above offers a"},{"text":" ","type":"text"},{"type":"text","text":"pull to refresh gesture because it detects the refresh action. When"},{"type":"text","text":" "},{"type":"text","text":"the user drags the list down and releases, the list calls the action’s"},{"type":"text","text":" "},{"type":"text","text":"handler. Because OpenSwiftUI declares the handler as asynchronous, it can"},{"type":"text","text":" "},{"type":"text","text":"safely make long-running asynchronous calls, like fetching network data."}],"type":"paragraph"},{"anchor":"Refreshing-Custom-Views","type":"heading","text":"Refreshing Custom Views","level":3},{"type":"paragraph","inlineContent":[{"text":"You can also offer refresh capability in your custom views.","type":"text"},{"type":"text","text":" "},{"text":"Read the ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/refresh","type":"reference","isActive":true},{"type":"text","text":" environment value to get the"},{"type":"text","text":" "},{"code":"RefreshAction","type":"codeVoice"},{"type":"text","text":" instance for a given "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","type":"reference","isActive":true},{"type":"text","text":". If you find"},{"type":"text","text":" "},{"type":"text","text":"a non-"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" value, change your view’s appearance or behavior to offer"},{"type":"text","text":" "},{"type":"text","text":"the refresh to the user, and call the instance to conduct the"},{"type":"text","text":" "},{"type":"text","text":"refresh. You can call the refresh instance directly because it defines"},{"type":"text","text":" "},{"type":"text","text":"a "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/RefreshAction\/callAsFunction()","type":"reference","isActive":true},{"type":"text","text":" method that Swift calls"},{"type":"text","text":" "},{"type":"text","text":"when you call the instance:"}]},{"type":"codeListing","syntax":null,"code":["struct RefreshableView: View {","    @Environment(\\.refresh) private var refresh","","    var body: some View {","        Button(\"Refresh\") {","            Task {","                await refresh?()","            }","        }","        .disabled(refresh == nil)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Be sure to call the handler asynchronously by preceding it"},{"type":"text","text":" "},{"type":"text","text":"with "},{"code":"await","type":"codeVoice"},{"type":"text","text":". Because the call is asynchronous, you can use"},{"type":"text","text":" "},{"type":"text","text":"its lifetime to indicate progress to the user. For example,"},{"type":"text","text":" "},{"type":"text","text":"you might reveal an indeterminate "},{"code":"ProgressView","type":"codeVoice"},{"type":"text","text":" before"},{"type":"text","text":" "},{"type":"text","text":"calling the handler, and hide it when the handler completes."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your code isn’t already in an asynchronous context, create a"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Swift\/Task"},{"type":"text","text":" for the"},{"type":"text","text":" "},{"type":"text","text":"method to run in. If you do this, consider adding a way for the"},{"type":"text","text":" "},{"type":"text","text":"user to cancel the task. For more information, see"},{"type":"text","text":" "},{"identifier":"https:\/\/docs.swift.org\/swift-book\/LanguageGuide\/Concurrency.html","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"in "},{"inlineContent":[{"text":"The Swift Programming Language","type":"text"}],"type":"emphasis"},{"type":"text","text":"."}]}]}],"variants":[{"paths":["\/documentation\/openswiftui\/refreshaction"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","abstract":[{"text":"An action that initiates a refresh operation.","type":"text"}],"topicSections":[{"anchor":"Instance-Methods","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/RefreshAction\/callAsFunction()"],"title":"Instance Methods","generated":true},{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/RefreshAction\/Equatable-Implementations"],"generated":true,"title":"Default Implementations","anchor":"Default-Implementations"}],"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/RefreshAction","interfaceLanguage":"swift"},"references":{"doc://OpenSwiftUI/s9EscapableP":{"title":"Swift.Escapable","identifier":"doc:\/\/OpenSwiftUI\/s9EscapableP","type":"unresolvable"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues/refresh":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"refresh","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI13RefreshActionV","text":"RefreshAction","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/refresh","role":"symbol","abstract":[{"type":"text","text":"A refresh action stored in a view’s environment."}],"title":"refresh","url":"\/documentation\/openswiftui\/environmentvalues\/refresh","kind":"symbol","type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","abstract":[],"title":"O