{"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"topicSections":[{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/RefreshAction\/callAsFunction()"],"anchor":"Instance-Methods","title":"Instance Methods","generated":true},{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/RefreshAction\/Equatable-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations","generated":true}],"metadata":{"externalID":"s:11OpenSwiftUI13RefreshActionV","title":"RefreshAction","navigatorTitle":[{"kind":"identifier","text":"RefreshAction"}],"roleHeading":"Structure","symbolKind":"struct","modules":[{"name":"OpenSwiftUI"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RefreshAction"}],"role":"symbol"},"abstract":[{"type":"text","text":"An action that initiates a refresh operation."}],"sections":[],"relationshipsSections":[{"identifiers":["doc:\/\/OpenSwiftUI\/s8CopyableP","doc:\/\/OpenSwiftUI\/SQ"],"type":"conformsTo","title":"Conforms To","kind":"relationships"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RefreshAction"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"When the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/refresh"},{"text":" environment value contains an","type":"text"},{"text":" ","type":"text"},{"text":"instance of this structure, certain built-in views in the corresponding","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment"},{"text":" begin offering a refresh capability. They apply the","type":"text"},{"text":" ","type":"text"},{"text":"instance’s handler to any refresh operation that the user initiates.","type":"text"},{"text":" ","type":"text"},{"text":"By default, the environment value is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", but you can use the","type":"text"},{"text":" ","type":"text"},{"code":"View\/refreshable(action:)","type":"codeVoice"},{"text":" modifier to create and store a new","type":"text"},{"text":" ","type":"text"},{"text":"refresh action that uses the handler that you specify:","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["List(mailbox.conversations) { conversation in","    ConversationCell(conversation)","}",".refreshable {","    await mailbox.fetch()","}"],"type":"codeListing"},{"inlineContent":[{"text":"On iOS and iPadOS, the ","type":"text"},{"code":"List","type":"codeVoice"},{"text":" in the example above offers a","type":"text"},{"text":" ","type":"text"},{"text":"pull to refresh gesture because it detects the refresh action. When","type":"text"},{"text":" ","type":"text"},{"text":"the user drags the list down and releases, the list calls the action’s","type":"text"},{"text":" ","type":"text"},{"text":"handler. Because SwiftUI declares the handler as asynchronous, it can","type":"text"},{"text":" ","type":"text"},{"text":"safely make long-running asynchronous calls, like fetching network data.","type":"text"}],"type":"paragraph"},{"anchor":"Refreshing-Custom-Views","level":3,"text":"Refreshing Custom Views","type":"heading"},{"inlineContent":[{"type":"text","text":"You can also offer refresh capability in your custom views."},{"type":"text","text":" "},{"type":"text","text":"Read the "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/refresh","type":"reference","isActive":true},{"type":"text","text":" environment value to get the"},{"type":"text","text":" "},{"code":"RefreshAction","type":"codeVoice"},{"type":"text","text":" instance for a given "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","type":"reference","isActive":true},{"type":"text","text":". If you find"},{"type":"text","text":" "},{"type":"text","text":"a non-"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" value, change your view’s appearance or behavior to offer"},{"type":"text","text":" "},{"type":"text","text":"the refresh to the user, and call the instance to conduct the"},{"type":"text","text":" "},{"type":"text","text":"refresh. You can call the refresh instance directly because it defines"},{"type":"text","text":" "},{"type":"text","text":"a "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/RefreshAction\/callAsFunction()","type":"reference","isActive":true},{"type":"text","text":" method that Swift calls"},{"type":"text","text":" "},{"type":"text","text":"when you call the instance:"}],"type":"paragraph"},{"syntax":null,"code":["struct RefreshableView: View {","    @Environment(\\.refresh) private var refresh","","    var body: some View {","        Button(\"Refresh\") {","            Task {","                await refresh?()","            }","        }","        .disabled(refresh == nil)","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Be sure to call the handler asynchronously by preceding it"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":"await"},{"type":"text","text":". Because the call is asynchronous, you can use"},{"type":"text","text":" "},{"type":"text","text":"its lifetime to indicate progress to the user. For example,"},{"type":"text","text":" "},{"type":"text","text":"you might reveal an indeterminate "},{"type":"codeVoice","code":"ProgressView"},{"type":"text","text":" before"},{"type":"text","text":" "},{"type":"text","text":"calling the handler, and hide it when the handler completes."}],"type":"paragraph"},{"inlineContent":[{"text":"If your code isn’t already in an asynchronous context, create a","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Swift\/Task","type":"text"},{"text":" for the","type":"text"},{"text":" ","type":"text"},{"text":"method to run in. If you do this, consider adding a way for the","type":"text"},{"text":" ","type":"text"},{"text":"user to cancel the task. For more information, see","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/docs.swift.org\/swift-book\/LanguageGuide\/Concurrency.html","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"in ","type":"text"},{"inlineContent":[{"text":"The Swift Programming Language","type":"text"}],"type":"emphasis"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/refreshaction"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/RefreshAction","interfaceLanguage":"swift"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/RefreshAction/callAsFunction()":{"role":"symbol","url":"\/documentation\/openswiftui\/refreshaction\/callasfunction()","title":"callAsFunction()","type":"topic","abstract":[{"text":"Initiates a refresh action.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/RefreshAction\/callAsFunction()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"callAsFunction"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Environment":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Environment"}],"role":"symbol","url":"\/documentation\/openswiftui\/environment","abstract":[{"type":"text","text":"A property wrapper that reads a value from a view’s environment."}],"type":"topic","kind":"symbol","title":"Environment","navigator