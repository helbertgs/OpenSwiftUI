{"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"metadata":{"modules":[{"name":"OpenSwiftUI"}],"title":"RefreshAction","roleHeading":"Structure","symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RefreshAction"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"RefreshAction"}],"externalID":"s:11OpenSwiftUI13RefreshActionV"},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/RefreshAction","interfaceLanguage":"swift"},"kind":"symbol","abstract":[{"type":"text","text":"An action that initiates a refresh operation."}],"topicSections":[{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/RefreshAction\/callAsFunction()"],"anchor":"Instance-Methods","generated":true,"title":"Instance Methods"},{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/RefreshAction\/Equatable-Implementations"],"anchor":"Default-Implementations","generated":true,"title":"Default Implementations"}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/OpenSwiftUI\/s8CopyableP","doc:\/\/OpenSwiftUI\/SQ"],"type":"conformsTo","title":"Conforms To"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RefreshAction","kind":"identifier"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"When the ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/refresh","type":"reference","isActive":true},{"text":" environment value contains an","type":"text"},{"text":" ","type":"text"},{"text":"instance of this structure, certain built-in views in the corresponding","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","type":"reference","isActive":true},{"text":" begin offering a refresh capability. They apply the","type":"text"},{"text":" ","type":"text"},{"text":"instance’s handler to any refresh operation that the user initiates.","type":"text"},{"text":" ","type":"text"},{"text":"By default, the environment value is ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":", but you can use the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"View\/refreshable(action:)"},{"text":" modifier to create and store a new","type":"text"},{"text":" ","type":"text"},{"text":"refresh action that uses the handler that you specify:","type":"text"}]},{"type":"codeListing","syntax":null,"code":["List(mailbox.conversations) { conversation in","    ConversationCell(conversation)","}",".refreshable {","    await mailbox.fetch()","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On iOS and iPadOS, the "},{"type":"codeVoice","code":"List"},{"type":"text","text":" in the example above offers a"},{"type":"text","text":" "},{"type":"text","text":"pull to refresh gesture because it detects the refresh action. When"},{"type":"text","text":" "},{"type":"text","text":"the user drags the list down and releases, the list calls the action’s"},{"type":"text","text":" "},{"type":"text","text":"handler. Because SwiftUI declares the handler as asynchronous, it can"},{"type":"text","text":" "},{"type":"text","text":"safely make long-running asynchronous calls, like fetching network data."}]},{"type":"heading","anchor":"Refreshing-Custom-Views","level":3,"text":"Refreshing Custom Views"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can also offer refresh capability in your custom views."},{"type":"text","text":" "},{"type":"text","text":"Read the "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/refresh","type":"reference","isActive":true},{"type":"text","text":" environment value to get the"},{"type":"text","text":" "},{"code":"RefreshAction","type":"codeVoice"},{"type":"text","text":" instance for a given "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","type":"reference","isActive":true},{"type":"text","text":". If you find"},{"type":"text","text":" "},{"type":"text","text":"a non-"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" value, change your view’s appearance or behavior to offer"},{"type":"text","text":" "},{"type":"text","text":"the refresh to the user, and call the instance to conduct the"},{"type":"text","text":" "},{"type":"text","text":"refresh. You can call the refresh instance directly because it defines"},{"type":"text","text":" "},{"type":"text","text":"a "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/RefreshAction\/callAsFunction()","type":"reference","isActive":true},{"type":"text","text":" method that Swift calls"},{"type":"text","text":" "},{"type":"text","text":"when you call the instance:"}]},{"type":"codeListing","syntax":null,"code":["struct RefreshableView: View {","    @Environment(\\.refresh) private var refresh","","    var body: some View {","        Button(\"Refresh\") {","            Task {","                await refresh?()","            }","        }","        .disabled(refresh == nil)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Be sure to call the handler asynchronously by preceding it"},{"type":"text","text":" "},{"type":"text","text":"with "},{"code":"await","type":"codeVoice"},{"type":"text","text":". Because the call is asynchronous, you can use"},{"type":"text","text":" "},{"type":"text","text":"its lifetime to indicate progress to the user. For example,"},{"type":"text","text":" "},{"type":"text","text":"you might reveal an indeterminate "},{"code":"ProgressView","type":"codeVoice"},{"type":"text","text":" before"},{"type":"text","text":" "},{"type":"text","text":"calling the handler, and hide it when the handler completes."}]},{"type":"paragraph","inlineContent":[{"text":"If your code isn’t already in an asynchronous context, create a","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Swift\/Task","type":"text"},{"text":" for the","type":"text"},{"text":" ","type":"text"},{"text":"method to run in. If you do this, consider adding a way for the","type":"text"},{"text":" ","type":"text"},{"text":"user to cancel the task. For more information, see","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/docs.swift.org\/swift-book\/LanguageGuide\/Concurrency.html"},{"text":" ","type":"text"},{"text":"in ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"The Swift Programming Language"}]},{"text":".","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/refreshaction"]}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"kind":"symbol","role":"collection","title":"OpenSwiftUI","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","abstract":[],"type":"topic","url":"\/documentation\/openswiftui"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues/refresh":{"url":"\/documentation\/openswiftui\/environmentvalues\/refresh","title":"refresh","type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"refresh"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"RefreshAction","preciseIdentifier":"s:11OpenSwiftUI13RefreshActionV"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/refresh","abstract":[{"type":"text","text":"A refresh action stored in a view’s environment."}]},"doc://OpenSwiftUI/s8CopyableP":{"identifier":"doc:\/\/OpenSwiftUI\/s8CopyableP","title":"Swift.Copyable","type":"unresolvable"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Environment":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Environment","kind":"identifier"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","role":"symbol","type":"topic","url":"\/documentation\/openswiftui\/environment","navigatorTitle":[{"text":"Environment","kind":"identifier"}],"abstract":[{"type":"text","text":"A property wrapper that reads a value from a view’s environment."}],"kind":"symbol","title":"Environment"},"https://docs.swift.org/swift-book/LanguageGuide/Concurrency.html":{"type":"link","title":"Concurrency","identifier":"https:\/\/docs.swift.org\/swift-book\/LanguageGuide\/Concurrency.html","url":"https:\/\/docs.swift.org\/swift-book\/LanguageGuide\/Concurrency.html","titleInlineContent":[{"text":"Concurrency","type":"text"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/RefreshAction/callAsFunction()":{"url":"\/documentation\/openswiftui\/refreshaction\/callasfunction()","title":"callAsFunction()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"callAsFunction","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"}],"abstract":[{"text":"Initiates a refresh action.","type":"text"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/RefreshAction\/callAsFunction()","type":"topic","role":"symbol"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/RefreshAction/Equatable-Implementations":{"title":"Equatable Implementations","role":"collectionGroup","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/RefreshAction\/Equatable-Implementations","url":"\/documentation\/openswiftui\/refreshaction\/equatable-implementations","abstract":[],"kind":"article"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/RefreshAction":{"title":"RefreshAction","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/RefreshAction","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RefreshAction","kind":"identifier"}],"role":"symbol","url":"\/documentation\/openswiftui\/refreshaction","navigatorTitle":[{"text":"RefreshAction","kind":"identifier"}],"abstract":[{"text":"An action that initiates a refresh operation.","type":"text"}],"kind":"symbol"},"doc://OpenSwiftUI/SQ":{"type":"unresolvable","title":"Swift.Equatable","identifier":"doc:\/\/OpenSwiftUI\/SQ"}}}