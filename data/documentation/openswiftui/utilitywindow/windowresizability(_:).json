{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UtilityWindow\/windowResizability(_:)"},"sections":[],"variants":[{"paths":["\/documentation\/openswiftui\/utilitywindow\/windowresizability(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"preciseIdentifier":"s:ScM","kind":"attribute","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"windowResizability"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"resizability"},{"kind":"text","text":": "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowResizability","preciseIdentifier":"s:11OpenSwiftUI18WindowResizabilityV","kind":"typeIdentifier","text":"WindowResizability"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP","kind":"typeIdentifier","text":"Scene"},{"kind":"text","text":"\n"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The resizability to use for windows created by"},{"type":"text","text":" "},{"type":"text","text":"this scene."}],"type":"paragraph"}],"name":"resizability"}]},{"content":[{"level":2,"text":"Return Value","type":"heading","anchor":"return-value"},{"inlineContent":[{"type":"text","text":"A scene that uses the specified resizability strategy."}],"type":"paragraph"}],"kind":"content"},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Use this scene modifier to apply a value of type "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowResizability","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"to a "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","type":"reference","isActive":true},{"type":"text","text":" that you define in your "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/App","type":"reference","isActive":true},{"type":"text","text":" declaration."},{"type":"text","text":" "},{"type":"text","text":"The value that you specify indicates the strategy the system uses to"},{"type":"text","text":" "},{"type":"text","text":"place minimum and maximum size restrictions on windows that it creates"},{"type":"text","text":" "},{"type":"text","text":"from that scene."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, you can create a window group that people can resize to"},{"type":"text","text":" "},{"type":"text","text":"between 100 and 400 points in both dimensions by applying both a frame"},{"type":"text","text":" "},{"type":"text","text":"with those constraints to the scene’s content, and the"},{"type":"text","text":" "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowResizability\/contentSize","type":"reference","isActive":true},{"type":"text","text":" resizability to the scene:"}],"type":"paragraph"},{"code":["@main","struct MyApp: App {","    var body: some Scene {","        WindowGroup {","            ContentView()","                .frame(","                    minWidth: 100, maxWidth: 400,","                    minHeight: 100, maxHeight: 400)","        }","        .windowResizability(.contentSize)","    }","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The default value for all scenes if you don’t apply the modifier is"},{"type":"text","text":" "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowResizability\/automatic","type":"reference","isActive":true},{"type":"text","text":". With that strategy, "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Settings","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"windows use the "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowResizability\/contentSize","type":"reference","isActive":true},{"type":"text","text":" strategy, while"},{"type":"text","text":" "},{"type":"text","text":"all others use "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowResizability\/contentMinSize","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UtilityWindow"]]},"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"windowResizability","kind":"identifier"},{"text":"(","kind":"text"},{"text":"WindowResizability","preciseIdentifier":"s:11OpenSwiftUI18WindowResizabilityV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP","kind":"typeIdentifier"}],"modules":[{"name":"OpenSwiftUI"}],"title":"windowResizability(_:)","role":"symbol","extendedModule":"OpenSwiftUI","roleHeading":"Instance Method","symbolKind":"method","externalID":"s:11OpenSwiftUI5ScenePAAE18windowResizabilityyQrAA06WindowF0VF::SYNTHESIZED::s:11OpenSwiftUI13UtilityWindowV"},"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","abstract":[{"text":"Sets the kind of resizability to use for a window.","type":"text"}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/UtilityWindow/windowResizability(_:)":{"url":"\/documentation\/openswiftui\/utilitywindow\/windowresizability(_:)","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UtilityWindow\/windowResizability(_:)","title":"windowResizability(_:)","role":"symbol","type":"t