text","text":" "},{"type":"text","text":"the default size."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you specify a default size that’s outside the range of the window’s"},{"text":" ","type":"text"},{"text":"inherent resizability in one or both dimensions, the system clamps the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"affected dimension to keep it in range. You can configure the"},{"type":"text","text":" "},{"type":"text","text":"resizability of a scene using the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/windowResizability(_:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"modifier."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default size modifier affects any scene type that creates windows"},{"type":"text","text":" "},{"type":"text","text":"in Windows, namely:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup","type":"reference"}]}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"DocumentGroup","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Settings","type":"reference"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"If you want to specify the size input in terms of size instance,","type":"text"},{"text":" ","type":"text"},{"text":"use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/defaultSize(_:)"},{"text":" instead.","type":"text"}]}]}],"metadata":{"title":"defaultSize(_:_:_:)","role":"symbol","extendedModule":"OpenSwiftUI","roleHeading":"Insta