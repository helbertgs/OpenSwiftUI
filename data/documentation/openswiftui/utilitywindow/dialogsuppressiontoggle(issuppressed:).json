t":": ","kind":"text"},{"text":"Binding","preciseIdentifier":"s:11OpenSwiftUI7BindingV","kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding"},{"text":"<","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5SceneP","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"},{"text":"\n","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"name":"isSuppressed","content":[{"inlineContent":[{"type":"text","text":"Whether the suppression toggle is on or off"},{"type":"text","text":" "},{"type":"text","text":"in the dialog."}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Applying dialog suppression adds a toggle to dialogs on Windows,"},{"type":"text","text":" "},{"type":"text","text":"which allows the user to request the alert not be displayed again."},{"type":"text","text":" "},{"type":"text","text":"Typically whether a dialog is suppressed is stored in "},{"type":"codeVoice","code":"AppStorage"},{"type":"text","text":" "},{"text":"and used to decide whether to present the dialog in the future.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example configures an alert with a"},{"type":"text","text":" "},{"type":"text","text":"suppression toggle. The toggle’s state is stored in "},{"type":"codeVoice","code":"AppStorage"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"used to determine whether or not to show the dialog when the"},{"text":" ","type":"text"},{"text":"“Delete Items” button is pressed.","type":"text"}]},{"type":"codeListing","syntax":null,"code":["struct MyApp: App {","    @State private var isShowingDialog = false","    @AppStorage(\"suppressEraseItemAlert\")","    private var suppressAlert = false","","    var body: some Scene {","        Window(...) {","            Button(\"Delete items\") {","                isShowingDialog = true","            }","        }","","        AlertScene(","            \"Are you sure you want to erase these items?\",","            isPresented: $isShowingDialog","        ) {","            Button(\"Erase\", role: .destructive) {","                \/\/ Handle item deletion.","            }","            Button(\"Cancel\", role: .cancel) {","                \/\/ Handle cancellation","            }","        }","        .dialogSuppressionToggle(","            \"Do not ask about erasing items again\",","            isSuppressed: $suppressAlert)","    }","}"]}]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene":{"abstract":[{"type":"text","text":"A part of an app’s user interface with a life cycle managed by the"},{"type":"text","text":" "},{"type":"text","text":"system."}],"kind":"symbol","navigatorTitle":[{"text":"Scene","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","title":"Scene","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scene"}],"url":"\/documentation\/openswiftui\/scene"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Binding":{"abstract":[{"type":"text","text":"A property wrapper type that can read and write a value owned by a source of"},{"type":"text","text":" "},{"type":"text","text":"truth."}],"kind":"symbol","navigatorTitle":[{"text":"Binding","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding","title":"Binding","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Binding","kind":"identifier"}],"url"