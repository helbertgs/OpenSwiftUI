N"},{"type":"text","text":":"}]},{"code":["WindowGroup {","    ContentView()","}",".keyboardShortcut(\"n\", modifiers: [.option, .command])"],"syntax":null,"type":"codeListing"},{"level":3,"text":"Localization","anchor":"Localization","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Provide a "},{"type":"codeVoice","code":"localization"},{"type":"text","text":" value to specify how this shortcut"},{"type":"text","text":" "},{"type":"text","text":"should be localized."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Given that "},{"type":"codeVoice","code":"key"},{"type":"text","text":" is always defined in relation to the US-English"},{"type":"text","text":" "},{"type":"text","text":"keyboard layout, it might be hard to reach on different international"},{"type":"text","text":" "},{"type":"text","text":"layouts. For example the shortcut "},{"type":"codeVoice","code":"⌘["},{"type":"text","text":" works well for the"},{"type":"text","text":" "},{"type":"text","text":"US layout but is hard to reach for German users, where"},{"type":"text","text":" "},{"type":"codeVoice","code":"["},{"type":"text","text":" is available by pressing "},{"type":"codeVoice","code":"⌥5"},{"type":"text","text":", making users type "},{"type":"codeVoice","code":"⌥⌘5"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The automatic keyboard shortcut remapping re-assigns the shortcut to"},{"type":"text","text":" "},{"type":"text","text":"an appropriate replacement, "},{"type":"codeVoice","code":"⌘Ö"},{"type":"text","text":" in this case."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Providing the option"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyboardShortcut\/Localization-swift.struct\/custom"},{"type":"text","text":" "},{"type":"text","text":"disables the automatic localization for this shortcut to tell the system"},{"t