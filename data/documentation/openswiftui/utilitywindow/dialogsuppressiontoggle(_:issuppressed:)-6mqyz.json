used to determine whether or not to show the dialog when the"},{"type":"text","text":" "},{"type":"text","text":"“Delete Items” button is pressed."}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["struct MyApp: App {","    @State private var isShowingDialog = false","    @AppStorage(\"suppressEraseItemAlert\")","    private var suppressAlert = false","","    var body: some Scene {","        Window(...) {","            Button(\"Delete items\") {","                isShowingDialog = true","            }","        }","","        AlertScene(","            \"Are you sure you want to erase these items?\",","            isPresented: $isShowingDialog","        ) {","            Button(\"Erase\", role: .destructive) {","                \/\/ Handle item deletion.","            }","            Button(\"Cancel\", role: .cancel) {","                \/\/ Handle cancellation","            }","        }","        .dialogSuppressionToggle(","            \"Do not ask about erasing items again\",","            isSuppressed: $suppressAlert)","    }","}"]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/openswiftui\/utilitywindow\/dialogsuppressiontoggle(_:issuppressed:)-6mqyz"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","abstract":[{"type":"text","text":"Enables user suppression of an alert with a custom suppression"},{"type":"text","text":" "},{"type":"text","text":"message."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UtilityWindow\/dialogSuppressionToggle(_:isSuppressed:)-6mqyz"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/UtilityWindow":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UtilityWindow"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UtilityWindow","role":"symbol","abstract":[{"type":"text","text":"A specialized window scene that provides secondary utility to the content"},{"type":"t