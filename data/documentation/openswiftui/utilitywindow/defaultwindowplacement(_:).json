{"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UtilityWindow"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UtilityWindow\/defaultWindowPlacement(_:)"},"abstract":[{"text":"Defines a function used for determining the default placement","type":"text"},{"text":" ","type":"text"},{"text":"of windows.","type":"text"}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultWindowPlacement","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"makePlacement","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"@escaping ","kind":"attribute"},{"text":"(","kind":"text"},{"text":"WindowLayoutRoot","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowLayoutRoot","preciseIdentifier":"s:11OpenSwiftUI16WindowLayoutRootV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"WindowPlacementContext","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowPlacementContext","preciseIdentifier":"s:11OpenSwiftUI22WindowPlacementContextV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"WindowPlacement","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowPlacement","preciseIdentifier":"s:11OpenSwiftUI15WindowPlacementV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP","kind":"typeIdentifier"},{"text":"\n","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"A closure to generate the default window placement."}],"type":"paragraph"}],"name":"makePlacement"}]},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Use this scene modifier to indicate a default initial size and position"},{"type":"text","text":" "},{"text":"for a new window that the system creates from a ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","isActive":true,"type":"reference"},{"text":" declaration.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"On Windows, you can use the screen’s bounds to place the window.","type":"text"},{"text":" ","type":"text"},{"text":"For example, you can specify that the window is always placed 140","type":"text"},{"text":" ","type":"text"},{"text":"points from the bottom of the screen:","type":"text"}]},{"type":"codeListing","syntax":null,"code":["struct MyApp: App {","    var body: some Scene {","        ...","","        Window(\"Status\", id: \"status\") {","            StatusView()","        }","        .windowResizability(.contentSize)","        .defaultWindowPlacement { content, context in","            let displayBounds = context.defaultDisplay.visibleRect","            let size = content.sizeThatFits(.unspecified)","            let position = CGPoint(","                x: displayBounds.midX - (size.width \/ 2),","                y: displayBounds.maxY - size.height - 140)","            return WindowPlacement(position: position, size: size)","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"On visionOS, the system always places the first window","type":"text"},{"text":" ","type":"text"},{"text":"relative to where the person is looking.","type":"text"},{"text":" ","type":"text"},{"text":"The system ignores calls to ","type":"text"},{"code":"defaultWindowPlacement(_:)","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"You can place any subsequent windows relative to existing ones by","type":"text"},{"text":" ","type":"text"},{"text":"returning one of the methods defined by ","type":"text"},{"code":"WindowPlacement\/Position","type":"codeVoice"},{"text":" ","type":"text"},{"text":"with the existing window.","type":"text"},{"text":" ","type":"text"},{"text":"For example, you can align the new window with the trailing edge of","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"Content","type":"codeVoice"},{"text":" window:","type":"text"}]},{"type":"codeListing","syntax":null,"code":["struct MyApp: App {","    @Environment(\\.openWindow) private var openWindow","","    var body: some Scene {","        WindowGroup(\"Content\", id: \"content\") {","            Button(\"Open status window\") {","                openWindow(id: \"status\")","            }","        }","","        WindowGroup(\"Status\", id: \"status\") {","            StatusView()","        }","        .windowResizability(.contentSize)","        .defaultWindowPlacement { content, context in","            if let contentWindow = context.windows.first(","            where: { $0.id == \"content\" }) {","                WindowPlacement(.trailing(contentWindow))","            } else {","                WindowPlacement()","            }","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The placement that your function returns acts as a default for when the","type":"text"},{"text":" ","type":"text"},{"text":"window first appears. People can later resize and move the window using","type":"text"},{"text":" ","type":"text"},{"text":"interface controls that the system provides. Also, during state","type":"text"},{"text":" ","type":"text"},{"text":"restoration, the system restores the window to it’s most recent size and","type":"text"},{"text":" ","type":"text"},{"text":"position, rather than the default placement.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For more information on configuring how scenes behave with"},{"type":"text","text":" "},{"type":"text","text":"state restoration, see "},{"type":"codeVoice","code":"Scene.stateRestoration(_:)"},{"type":"text","text":"."}]}],"kind":"content"}],"metadata":{"externalID":"s:11OpenSwiftUI5ScenePAAE22defaultWindowPlacementyQrAA0fG0VAA0F10LayoutRootV_AA0fG7ContextVtcF::SYNTHESIZED::s:11OpenSwiftUI13UtilityWindowV","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"defaultWindowPlacement","kind":"identifier"},{"text":"((","kind":"text"},{"text":"WindowLayoutRoot","preciseIdentifier":"s:11OpenSwiftUI16WindowLayoutRootV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"WindowPlacementContext","preciseIdentifier":"s:11OpenSwiftUI22WindowPlacementContextV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"WindowPlacement","preciseIdentifier":"s:11OpenSwiftUI15WindowPlacementV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP","kind":"typeIdentifier"}],"extendedModule":"OpenSwiftUI","role":"symbol","title":"defaultWindowPlacement(_:)","symbolKind":"method","modules":[{"name":"OpenSwiftUI"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/utilitywindow\/defaultwindowplacement(_:)"]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/UtilityWindow":{"type":"topic","role":"symbol","navigatorTitle":[{"text":"UtilityWindow","kind":"identifier"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UtilityWindow","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UtilityWindow","kind":"identifier"}],"abstract":[{"type":"tex