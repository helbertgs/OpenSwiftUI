{"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup"},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"sections":[],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"],"title":"Conforms To"}],"abstract":[{"type":"text","text":"A scene that presents a group of identically structured windows."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WindowGroup","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Content","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI4ViewP","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/View","text":"View","kind":"typeIdentifier"}]}]},{"content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"text":"Use a ","type":"text"},{"type":"codeVoice","code":"WindowGroup"},{"text":" as a container for a view hierarchy presented by your","type":"text"},{"text":" ","type":"text"},{"text":"app. The hierarchy that you declare as the group’s content serves as a","type":"text"},{"text":" ","type":"text"},{"text":"template for each window that the app creates from that group:","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["@main","struct Mail: App {","    var body: some Scene {","        WindowGroup {","            MailViewer() \/\/ Declare a view hierarchy here.","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"OpenSwiftUI takes care of certain platform-specific behaviors. For example,","type":"text"},{"text":" ","type":"text"},{"text":"on platforms that support it, like macOS and iPadOS, users can open more","type":"text"},{"text":" ","type":"text"},{"text":"than one window from the group simultaneously. In macOS, users","type":"text"},{"text":" ","type":"text"},{"text":"can gather open windows together in a tabbed interface. Also in macOS,","type":"text"},{"text":" ","type":"text"},{"text":"window groups automatically provide commands for standard window","type":"text"},{"text":" ","type":"text"},{"text":"management.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every window created from the group maintains independent state. For"},{"type":"text","text":" "},{"type":"text","text":"example, for each new window created from the group the system allocates new"},{"type":"text","text":" "},{"type":"text","text":"storage for any "},{"type":"codeVoice","code":"State"},{"type":"text","text":" or "},{"type":"codeVoice","code":"StateObject"},{"type":"text","text":" variables instantiated by the"},{"type":"text","text":" "},{"type":"text","text":"scene’s view hierarchy."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You typically use a window group for the main interface of an app that isn’t"},{"type":"text","text":" "},{"type":"text","text":"document-based. For document-based apps, use a "},{"type":"codeVoice","code":"DocumentGroup"},{"type":"text","text":" instead."}],"type":"paragraph"}],"kind":"content"}],"topicSections":[{"anchor":"Initializers","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup\/init(_:content:)","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup\/init(_:id:content:)","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup\/init(content:)","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup\/init(id:content:)"],"title":"Initializers","generated":true},{"anchor":"Instance-Properties","identi