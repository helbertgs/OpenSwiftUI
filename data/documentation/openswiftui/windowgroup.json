ent":[{"type":"text","text":"Use a "},{"type":"codeVoice","code":"WindowGroup"},{"text":" as a container for a view hierarchy presented by your","type":"text"},{"text":" ","type":"text"},{"text":"app. The hierarchy that you declare as the group’s content serves as a","type":"text"},{"text":" ","type":"text"},{"text":"template for each window that the app creates from that group:","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["@main","struct Mail: App {","    var body: some Scene {","        WindowGroup {","            MailViewer() \/\/ Declare a view hierarchy here.","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"OpenSwiftUI takes care of certain platform-specific behaviors. For example,"},{"type":"text","text":" "},{"text":"on platforms that support it, like Windows and iPadOS, users can open more","type":"text"},{"type":"text","text":" "},{"text":"than one window from the group simultaneously. In Windows, users","type":"text"},{"text":" ","type":"text"},{"text":"can gather open windows together in a tabbed interface. Also in Windows,","type":"text"},{"type":"text","text":" "},{"text":"window groups automatically provide commands for standard window","type":"text"},{"type":"text","text":" "},{"text":"management.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every window created from the group maintains independent state. For"},{"type":"text","text":" "},{"text":"example, for each new window created from the group the system allocates new","type":"text"},{"type":"text","text":" "},{"text":"storage for any ","type":"text"},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/State","isActive":true},{"text":" or ","type":"text"},{"code":"StateObject","type":"codeVoice"},{"text":" variables instantiated by the","type":"text"},{"text":" ","type":"text"},{"text":"scene’s view hierarchy.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You typically use a window group for the main interface of an app that isn’t","type":"text"},{"text":" ","type":"text"},{"text":"document-based. For document-based apps, use a ","type":"text"},{"code":"DocumentGroup","type":"codeVoice"},{"text":" instead.","type":"text"}],"type":"paragraph"}]}],"topicSections":[{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup\/init(_:content:)","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup\/init(_:id:content:)","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup\/init(content:)","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup\/init(id:content:)"],"anchor":"Initializers","title":"Initializers","generated":true},{"generated":true,"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup\/body-swift.property","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup\/content","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup\/id","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup\/title"],"anchor":"Instance-Properties","title":"Instance Properties"},{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup\/Body-swift.typealias"],"anchor":"Type-Aliases","title":"Type Aliases","generated":true},{"generated":true,"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup\/Scene-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations"}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/WindowGroup/init(id:content:)":{"abstract":[{"type":"text","text":"Creates a window group with an identifier."}],"role":"symbol","type":"topic","url":"\/documentation\/openswiftui\/windowgroup\/init(id:content:)","kind":"symbol","title":"init(id:content:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ",