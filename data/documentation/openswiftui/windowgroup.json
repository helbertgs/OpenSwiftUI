group simultaneously. In Windows, users"},{"type":"text","text":" "},{"type":"text","text":"can gather open windows together in a tabbed interface. Also in Windows,"},{"type":"text","text":" "},{"type":"text","text":"window groups automatically provide commands for standard window"},{"type":"text","text":" "},{"type":"text","text":"management."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every window created from the group maintains independent state. For"},{"type":"text","text":" "},{"type":"text","text":"example, for each new window created from the group the system allocates new"},{"type":"text","text":" "},{"type":"text","text":"storage for any "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/State","isActive":true},{"type":"text","text":" or "},{"type":"codeVoice","code":"StateObject"},{"type":"text","text":" variables instantiated by the"},{"type":"text","text":" "},{"type":"text","text":"scene’s view hierarchy."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You typically use a window group for the main interface of an app that isn’t"},{"type":"text","text":" "},{"type":"text","text":"document-based. For document-based apps, use a "},{"code":"DocumentGroup","type":"codeVoice"},{"type":"text","text":" instead."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/windowgroup"]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/WindowGroup/init(_:id:content:)":{"url":"\/documentation\/openswiftui\/windowgroup\/init(_:id:content:)","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup\/init(_:id:content:)","title":"init(_:id:content:)","role":"symbol","type":"topic","kind":"symbol","abstract":[{"text":"Creates a window group with a title string and an identifier.","type":"text"}],"fragments":[{"text":"init","kind":"identifier"},{"text":"<","kind":"text"},{"text":"S","kind":"gener