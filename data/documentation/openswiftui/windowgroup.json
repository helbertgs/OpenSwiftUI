{"abstract":[{"text":"A scene that presents a group of identically structured windows.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"navigatorTitle":[{"text":"WindowGroup","kind":"identifier"}],"title":"WindowGroup","symbolKind":"struct","externalID":"s:11OpenSwiftUI11WindowGroupV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WindowGroup"}],"role":"symbol","roleHeading":"Structure","modules":[{"name":"OpenSwiftUI"}]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WindowGroup","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Content","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/View","text":"View","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI4ViewP"}]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Use a ","type":"text"},{"type":"codeVoice","code":"WindowGroup"},{"text":" as a container for a view hierarchy presented by your","type":"text"},{"text":" ","type":"text"},{"text":"app. The hierarchy that you declare as the group’s content serves as a","type":"text"},{"text":" ","type":"text"},{"text":"template for each window that the app creates from that group:","type":"text"}]},{"type":"codeListing","code":["@main","struct Mail: App {","    var body: some Scene {","        WindowGroup {","            MailViewer() \/\/ Declare a view hierarchy here.","        }","    }","}"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"OpenSwiftUI takes care of certain platform-specific behaviors. For example,"},{"type":"text","text":" "},{"type":"text","text":"on platforms that support it, like macOS and iPadOS, users can open more"},{"type":"text","text":" "},{"type":"text","text":"than one window from the group simultaneously. In macOS, users"},{"type":"text","text":" "},{"type":"text","text":"can gather open windows together in a tabbed interface. Also in macOS,"},{"type":"text","text":" "},{"type":"text","text":"window groups automatically provide commands for standard window"},{"type":"text","text":" "},{"type":"text","text":"management."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every window created from the group maintains independent state. For"},{"type":"text","text":" "},{"type":"text","text":"example, for each new window created from the group the system allocates new"},{"type":"text","text":" "},{"type":"text","text":"storage for any "},{"type":"codeVoice","code":"State"},{"type":"text","text":" or "},{"type":"codeVoice","code":"StateObject"},{"type":"text","text":" variables instantiated by the"},{"type":"text","text":" "},{"type":"text","text":"scene’s view hierarchy."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You typically use a window group for the main interface of an app that isn’t"},{"type":"text","text":" "},{"type":"text","text":"document-based. For document-based apps, use a "},{"type":"codeVoice","code":"DocumentGroup"},{"type":"text","text":" instead."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/openswiftui\/windowgroup"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"],"title":"Conforms To"}],"topicSections":[{"generated":true,"anchor":"Initializers","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI