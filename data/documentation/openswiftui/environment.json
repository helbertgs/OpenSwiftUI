]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"type":"codeVoice","code":"Environment"},{"text":" property wrapper to read a value","type":"text"},{"text":" ","type":"text"},{"text":"stored in a view’s environment. Indicate the value to read using an","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues","isActive":true,"type":"reference"},{"text":" key path in the property declaration. For example, you","type":"text"},{"text":" ","type":"text"},{"text":"can create a property that reads the color scheme of the current","type":"text"},{"text":" ","type":"text"},{"text":"view using the key path of the ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/colorScheme","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"property:","type":"text"}]},{"type":"codeListing","syntax":null,"code":["@Environment(\\.colorScheme) var colorScheme: ColorScheme"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can condition a view’s content on the associated value, which"},{"type":"text","text":" "},{"type":"text","text":"you read from the declared property’s "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment\/wrappedValue","isActive":true},{"type":"text","text":". As with any property"},{"type":"text","text":" "},{"type":"text","text":"wrapper, you access the wrapped value by directly referring to the property:"}]},{"type":"codeListing","syntax":null,"code":["if colorScheme == .dark { \/\/ Checks the wrapped value.","    DarkContent()","} else {","    LightContent()","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the value changes, OpenSwiftUI updates any parts of your view that depend on"},{"type":"text","text":" "},{"type":"text","text":"the value. For example, that might happen in the above example if the user"},{"type":"text","text":" "},{"type":"text","text":"changes the Appearance settings."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use this property wrapper to read — but not set — an environment"},{"type":"text","text":" "},{"type":"text","text":"value. OpenSwiftUI updates some environment values automatically based on system"},{"type":"text","text":" "},{"type":"text","text":"settings and provides reasonable defaults for others. You can override some"},{"type":"text","text":" "},{"type":"text","text":"of these, as well as set custom environment values that you define,"},{"type":"text","text":" "},{"type":"text","text":"using the "},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/View\/environment(_:_:)","type":"reference"},{"type":"text","text":" view modifier."}]},{"type":"paragraph","inlineContent":[{"text":"For the complete list of environment values provided by OpenSwiftUI, see the","type":"text"},{"text":" ","type":"text"},{"text":"properties of the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues","type":"reference"},{"text":" structure. For information about","type":"text"},{"text":" ","type":"text"},{"text":"creating custom environment values, see the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentKey","type":"reference"},{"text":" protocol.","type":"text"}]}],"kind":"content"}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues":{"role":"symbol","navigatorTitle":[{"text":"EnvironmentValues","kind":"identifier"}],"abstract":[{"text":"OpenSwiftUI exposes a collection of values to your app’s views in an","type":"text"},{"text":" ","type":"text"},{"code":"EnvironmentValues","type":"codeVoice"},{"text":" structure. To read a value from the structure,","type":"text"},{"text"