/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup"},{"type":"text","text":" "},{"type":"text","text":"generates occupy 600 points in the x-dimension and 400 points in"},{"type":"text","text":" "},{"type":"text","text":"the y-dimension:"}]},{"syntax":null,"type":"codeListing","code":["@main","struct MyApp: App {","    var body: some Scene {","        WindowGroup {","            ContentView()","        }","        .defaultSize(width: 600, height: 400)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The size that you specify acts only as a default for when the window"},{"type":"text","text":" "},{"type":"text","text":"first appears. People can later resize the window using interface"},{"type":"text","text":" "},{"type":"text","text":"controls that the system provides. Also, during state restoration,"},{"type":"text","text":" "},{"type":"text","text":"the system restores windows to their most recent size rather than"},{"type":"text","text":" "},{"type":"text","text":"the default size."}]},{"inlineContent":[{"type":"text","text":"If you specify a default size that’s outside the range of the window’s"},{"type":"text","text":" "},{"type":"text","text":"inherent resizability in one or both dimensions, the system clamps the"},{"type":"text","text":" "},{"type":"text","text":"affected dimension to keep it in range. You can configure the"},{"type":"text","text":" "},{"type":"text","text":"resizability of a scene using the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/windowResizability(_:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"modifier."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default size modifier affects any scene type that creates windows"},{"type":"text","text":" "},{"type":"text","text":"in Windows, namely:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifie