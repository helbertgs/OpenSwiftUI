text":"A closure to run when the value changes.","type":"text"}]}],"name":"action"}],"kind":"parameters"},{"content":[{"anchor":"return-value","type":"heading","level":2,"text":"Return Value"},{"inlineContent":[{"text":"A scene that triggers an action in response to a change.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"type":"text","text":"Use this modifier to trigger a side effect when a value changes, like"},{"type":"text","text":" "},{"type":"text","text":"the value associated with an "},{"code":"SwiftUI\/Environment","type":"codeVoice"},{"type":"text","text":" key or a"},{"type":"text","text":" "},{"code":"SwiftUI\/Binding","type":"codeVoice"},{"type":"text","text":". For example, you can clear a cache when you notice"},{"type":"text","text":" "},{"type":"text","text":"that a scene moves to the background:"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["struct MyScene: Scene {","    @Environment(\\.scenePhase) private var scenePhase","    @StateObject private var cache = DataCache()","","    var body: some Scene {","        WindowGroup {","            MyRootView(cache: cache)","        }","        .onChange(of: scenePhase) { oldScenePhase, newScenePhase in","            if newScenePhase == .background {","                cache.empty()","            }","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"The system may call the action closure on the main actor, so avoid"},{"type":"text","text":" "},{"type":"text","text":"long-running tasks in the closure. If you need to perform such tasks,"},{"type":"text","text":" "},{"type":"text","text":"detach an asynchronous background task:"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":[".onChange(of: scenePhase) { oldScenePhase, newScenePhase in","    if newScenePhase == .background {","        Task.detached(priority: .background) {","            \/\/ ...","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"When the value changes, the new version of the closure will be called,"},{"type":"text","text":" "},{"type":"text","text":"so any captured values will have their values from the time that the"},{"type":"text","text":" "},{"type":"text","text":"observed value has its new value. The system passes the old and new"},{"type":"text","text":" "},{"type":"text","text":"observed values into the closure."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","sections":[],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"kind":"symbol","role":"collection","title":"OpenSwiftUI","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","abstract":[],"type":"topic","url":"\/documentation\/openswiftui"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene":{"kind":"symbol","title":"Scene","abstract":[{"type":"text","text":"A part of an app’s user interface with a life cycle managed by the"},{"type":"text","text":" "},{"type":"text","text":"system."}],"url":"\/documentation\/openswiftui\/scene","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"identifier"}],"navigatorTitle":[{"text":"Scene","kind":"identifier"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","type":"topic","role":"symbol"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene/onChange(of:initial:_:)-5057h":{"role":"symbol","type":"topic","url":"\/documentation\/openswiftui\/scene\/onchange(of:initial:_:)-5057h","title":"onChange(of:initial:_:)","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/onChange(of:initial:_:)-5057h","abstract":[{"text":"Adds an action to perform when the given value changes.","type":"text"}],"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onChange","kind":"identifier"},{"text":"<","kind":"text"},{"text":"V","kind":"genericParameter"},{"text":">(","kind":"text"},{"tex