{"sections":[],"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/dialogSuppressionToggle(isSuppressed:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dialogSuppressionToggle","kind":"identifier"},{"text":"(","kind":"text"},{"text":"isSuppressed","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding","preciseIdentifier":"s:11OpenSwiftUI7BindingV","text":"Binding","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP","text":"Scene","kind":"typeIdentifier"},{"text":"\n","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]},{"parameters":[{"name":"isSuppressed","content":[{"inlineContent":[{"type":"text","text":"Whether the suppression toggle is on or off"},{"type":"text","text":" "},{"type":"text","text":"in the dialog."}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Applying dialog suppression adds a toggle to dialogs on Windows,","type":"text"},{"text":" ","type":"text"},{"text":"which allows the user to request the alert not be displayed again.","type":"text"},{"text":" ","type":"text"},{"text":"Typically whether a dialog is suppressed is stored in ","type":"text"},{"code":"AppStorage","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and used to decide whether to present the dialog in the future.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The following example configures an alert with a","type":"text"},{"text":" ","type":"text"},{"text":"suppression toggle. The toggle’s state is stored in ","type":"text"},{"code":"AppStorage","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"used to determine whether or not to show the dialog when the","type":"text"},{"text":" ","type":"text"},{"text":"“Delete Items” button is pressed.","type":"text"}]},{"type":"codeListing","code":["struct MyApp: App {","    @State private var isShowingDialog = false","    @AppStorage(\"suppressEraseItemAlert\")","    private var suppressAlert = false","","    var body: some Scene {","        Window(...) {","            Button(\"Delete items\") {","                isShowingDialog = true","            }","        }","","        AlertScene(","            \"Are you sure you want to erase these items?\",","            isPresented: $isShowingDialog","        ) {","            Button(\"Erase\", role: .destructive) {","                \/\/ Handle item deletion.","            }","            Button(\"Cancel\", role: .cancel) {","                \/\/ Handle cancellation","            }","        }","        .dialogSuppressionToggle(","            \"Do not ask about erasing items again\",","            isSuppressed: $suppressAlert)","    }","}"],"syntax":null}],"kind":"content"}],"metadata":{"roleHeading":"Instance Method","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"dialogSuppressionToggle"},{"text":"(","kind":"text"},{"text":"isSuppressed","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Binding","preciseIdentifier":"s:11OpenSwiftUI7BindingV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP"}],"title":"dialogSuppressionToggle(isSuppressed:)","extendedModule":"OpenSwiftUI","role":"symbol","externalID":"s:11OpenSwiftUI5ScenePAAE23dialogSuppressionToggle12isSuppressedQrAA7BindingVySbG_tF","modules":[{"name":"OpenSwiftUI"}]},"kind":"symbol","abstract":[{"type":"text","text":"Enables user suppression of an alert with a custom suppression"},{"type":"text","text":" "},{"type":"text","text":"message."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/scene\/dialogsuppressiontoggle(issuppressed:)"]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene/dialogSuppressionToggle(isSuppressed:)":{"abstract":[{"type":"text","text":"Enables user suppression of an alert with a custom suppression"},{"type":"text","text":" "},{"type":"text","text":"message."}],"type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/openswiftui\/scene\/dialogsuppressiontoggle(issuppressed:)","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/dialogSuppressionToggle(isSuppressed:)","title":"dialogSuppressionToggle(isSuppressed:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dialogSuppressionToggle","kind":"identifier"},{"text":"(","kind":"text"},{"text":"isSuppressed","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Binding","preciseIdentifier":"s:11OpenSwiftUI7BindingV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP","kind":"typeIdentifier"}]},"doc://OpenSwiftUI/documentation/OpenSwiftU