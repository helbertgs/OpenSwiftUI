{"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"]]},"metadata":{"roleHeading":"Instance Method","extendedModule":"OpenSwiftUI","externalID":"s:11OpenSwiftUI5ScenePAAE15defaultPositionyQrAA9UnitPointVF","role":"symbol","symbolKind":"method","title":"defaultPosition(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultPosition","kind":"identifier"},{"text":"(","kind":"text"},{"text":"UnitPoint","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI9UnitPointV"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5SceneP"}],"modules":[{"name":"OpenSwiftUI"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultPosition"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"position"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UnitPoint","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint","preciseIdentifier":"s:11OpenSwiftUI9UnitPointV"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Scene","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP"},{"kind":"text","text":"\n"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"position","content":[{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint"},{"type":"text","text":" that specifies where to place a"},{"type":"text","text":" "},{"type":"text","text":"newly opened window relative to the screen bounds."}],"type":"paragraph"}]}]},{"content":[{"anchor":"return-value","type":"heading","text":"Return Value","level":2},{"type":"paragraph","inlineContent":[{"text":"A scene that uses a default position for new windows.","type":"text"}]}],"kind":"content"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"text":"The first time your app opens a window from a particular scene","type":"text"},{"text":" ","type":"text"},{"text":"declaration, the system places the window at the center of the screen by","type":"text"},{"text":" ","type":"text"},{"text":"default. For scene types that support multiple simultaneous windows, the","type":"text"},{"text":" ","type":"text"},{"text":"system offsets each additional window by a small amount to avoid","type":"text"},{"text":" ","type":"text"},{"text":"completely obscuring existing windows.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can override the default placement of the first window by"},{"type":"text","text":" "},{"type":"text","text":"applying a scene modifier that indicates where to place the window"},{"type":"text","text":" "},{"type":"text","text":"relative to the screen bounds. For example, you can request that the"},{"type":"text","text":" "},{"type":"text","text":"system place a new window in the bottom trailing corner of the screen:"}],"type":"paragraph"},{"code":["@main","struct MyApp: App {","    var body: some Scene {","        WindowGroup {","            ContentView()","        }","        .defaultPosition(.bottomTrailing)","    }","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The system aligns the point in the window that corresponds to the"},{"type":"text","text":" "},{"type":"text","text":"specified "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint","isActive":true},{"type":"text","text":" with the point in the screen that corresponds"},{"type":"text","text":" "},{"type":"text","text":"to the same unit point."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You typically use one of the predefined unit points — like"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/bottomTrailing","isActive":true},{"type":"text","text":" in the above example — but"},{"type":"text","text":" "},{"type":"text","text":"you can also use a custom unit point. For example, the following"},{"type":"text","text":" "},{"type":"text","text":"modifier aligns the point that’s one quarter of the way from the"},{"type":"text","text":" "},{"type":"text","text":"leading edge of the window with the point that’s one quarter of"},{"type":"text","text":" "},{"type":"text","text":"the way from the leading edge of the screen, while centering the"},{"type":"text","text":" "},{"type":"text","text":"window in the y-dimension:"}],"type":"paragraph"},{"code":["WindowGroup {","    ContentView()","}",".defaultPosition(UnitPoint(x: 0.25, y: 0.5))"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The modifier affects any scene type that creates windows in macOS,"},{"type":"text","text":" "},{"type":"text","text":"namely:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup","isActive":true}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"Window","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DocumentGroup"}]}]},{"content":[{"inlineContent":[{"code":"Settings","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The value that you provide acts only as an initial default. During state"},{"type":"text","text":" "},{"type":"text","text":"restoration, the system restores the window to the position that it"},{"type":"text","text":" "},{"type":"text","text":"last occupied."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/defaultPosition(_:)"},"abstract":[{"text":"Sets a default position for a window.","type":"text"}],"sections":[],"variants":[{"paths":["\/documentation\/openswiftui\/scene\/defaultposition(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/UnitPoint":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UnitPoint"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"UnitPoint"}],"url":"\/documentation\/openswiftui\/unitpoint","title":"UnitPoint","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint","kind":"symbol","abstract":[{"type":"text","text":"A normalized 2D point in a view’s coordinate space."}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/WindowGroup":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WindowGroup","kind":"identifier"}],"kind":"symbol","role":"symbol","type":"topic","navigatorTitle":[{"text":"WindowGroup","kind":"identifier"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup","url":"\/documentation\/openswiftui\/windowgroup","abstract":[{"text":"A scene that presents a group of identically structured windows.","type":"text"}],"title":"WindowGroup"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene":{"kind":"symbol","title":"Scene","abstract":[{"type":"text","text":"A part of an app’s user interface with a life cycle managed by the"},{"type":"text","text":" "},{"type":"text","text":"system."}],"url":"\/documentation\/openswiftui\/scene","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"identifier"}],"navigatorTitle":[{"text":"Scene","kind":"identifier"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","type":"topic","role":"symbol"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene/defaultPosition(_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultPosition","kind":"identifier"},{"text":"(","kind":"text"},{"text":"UnitPoint","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI9UnitPointV"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5SceneP"}],"url":"\/documentation\/openswiftui\/scene\/defaultposition(_:)","type":"topic","role":"symbol","kind":"symbol","abstract":[{"text":"Sets a default position for a window.","type":"text"}],"title":"defaultPosition(_:)","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/defaultPosition(_:)"},"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"kind":"symbol","role":"collection","title":"OpenSwiftUI","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","abstract":[],"type":"topic","url":"\/documentation\/openswiftui"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/UnitPoint/bottomTrailing":{"role":"symbol","title":"bottomTrailing","abstract":[{"type":"text","text":"A point that’s in the bottom, trailing corner of a view."}],"kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/bottomTrailing","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bottomTrailing","kind":"identifier"},{"text":": ","kind":"text"},{"text":"UnitPoint","preciseIdentifier":"s:11OpenSwiftUI9UnitPointV","kind":"typeIdentifier"}],"type":"topic","url":"\/documentation\/openswiftui\/unitpoint\/bottomtrailing"}}}