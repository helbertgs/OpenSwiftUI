{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/defaultPosition(_:)"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultPosition"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"position"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI9UnitPointV","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint","text":"UnitPoint"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","text":"Scene","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","kind":"typeIdentifier"},{"text":"\n","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"position","content":[{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint","isActive":true,"type":"reference"},{"text":" that specifies where to place a","type":"text"},{"text":" ","type":"text"},{"text":"newly opened window relative to the screen bounds.","type":"text"}]}]}]},{"kind":"content","content":[{"anchor":"return-value","type":"heading","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"text":"A scene that uses a default position for new windows.","type":"text"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The first time your app opens a window from a particular scene"},{"type":"text","text":" "},{"type":"text","text":"declaration, the system places the window at the center of the screen by"},{"type":"text","text":" "},{"type":"text","text":"default. For scene types that support multiple simultaneous windows, the"},{"type":"text","text":" "},{"type":"text","text":"system offsets each additional window by a small amount to avoid"},{"type":"text","text":" "},{"type":"text","text":"completely obscuring existing windows."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can override the default placement of the first window by"},{"type":"text","text":" "},{"type":"text","text":"applying a scene modifier that indicates where to place the window"},{"type":"text","text":" "},{"type":"text","text":"relative to the screen bounds. For example, you can request that the"},{"type":"text","text":" "},{"type":"text","text":"system place a new window in the bottom trailing corner of the screen:"}]},{"type":"codeListing","code":["@main","struct MyApp: App {","    var body: some Scene {","        WindowGroup {","            ContentView()","        }","        .defaultPosition(.bottomTrailing)","    }","}"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"The system aligns the point in the window that corresponds to the"},{"type":"text","text":" "},{"type":"text","text":"specified "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint","type":"reference","isActive":true},{"type":"text","text":" with the point in the screen that corresponds"},{"type":"text","text":" "},{"type":"text","text":"to the same unit point."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You typically use one of the predefined unit points — like"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/bottomTrailing"},{"type":"text","text":" in the above example — but"},{"type":"text","text":" "},{"type":"text","text":"you can also use a custom unit point. For example, the following"},{"type":"text","text":" "},{"type":"text","text":"modifier aligns the point that’s one quarter of the way from the"},{"type":"text","text":" "},{"type":"text","text":"leading edge of the window with the point that’s one quarter of"},{"type":"text","text":" "},{"type":"text","text":"the way from the leading edge of the screen, while centering the"},{"type":"text","text":" "},{"type":"text","text":"window in the y-dimension:"}]},{"type":"codeListing","code":["WindowGroup {","    ContentView()","}",".defaultPosition(UnitPoint(x: 0.25, y: 0.5))"],"syntax":null},{"type":"paragraph","inlineContent":[{"text":"The modifier affects any scene type that creates windows in macOS,","type":"text"},{"text":" ","type":"text"},{"text":"namely:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup","type":"reference"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Window"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DocumentGroup"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Settings"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The value that you provide acts only as an initial default. During state"},{"text":" ","type":"text"},{"text":"restoration, the system restores the window to the position that it","type":"text"},{"text":" ","type":"text"},{"text":"last occupied.","type":"text"}]}]}],"metadata":{"extendedModule":"OpenSwiftUI","modules":[{"name":"OpenSwiftUI"}],"title":"defaultPosition(_:)","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultPosition"},{"kind":"text","text":"("},{"preciseIdentifier":"s:11OpenSwiftUI9UnitPointV","kind":"typeIdentifier","text":"UnitPoint"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","kind":"typeIdentifier","