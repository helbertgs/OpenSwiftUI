{"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/defaultLaunchBehavior(_:)","interfaceLanguage":"swift"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"defaultLaunchBehavior"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"text":"behavior","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI19SceneLaunchBehaviorV","text":"SceneLaunchBehavior","kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneLaunchBehavior"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"text":" ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5SceneP","text":"Scene","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"},{"text":"\n","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"This behavior can be used to define if a scene is shown on application"},{"type":"text","text":" "},{"type":"text","text":"launch in the absence of any previously saved state."}],"type":"paragraph"},{"inlineContent":[{"text":"On platforms that do not support multiple windows, this value is","type":"text"},{"text":" ","type":"text"},{"text":"ignored.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"On platforms other than Windows, there must be at least one scene that"},{"type":"text","text":" "},{"type":"text","text":"presents itself. If no scenes are defined to present, the first scene"},{"type":"text","text":" "},{"text":"will be presented, regardless of the value provided to this modifier.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"During app launch, on platforms other than Windows, the system"},{"type":"text","text":" "},{"type":"text","text":"will only consider scenes whose role matches the"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/bundleresources\/information_property_list\/uiapplicationpreferreddefaultscenesessionrole"},{"type":"text","text":" "},{"type":"text","text":"key in the application scene manifest of the "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" file."},{"type":"text","text":" "},{"type":"text","text":"For instance, a volumetric window would need the"},{"type":"text","text":" "},{"code":"UIWindowSceneSessionRoleVolumetricApplication","type":"codeVoice"},{"type":"text","text":" role."}]}],"name":"Note","type":"aside","style":"note"},{"type":"paragraph","inlineContent":[{"type":"text","text":"On Windows, this behavior will also be used to determine which scene is"},{"type":"text","text":" "},{"text":"presented when clicking on the icon of a running application with no","type":"text"},{"text":" ","type":"text"},{"text":"visible windows.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"On visionOS, the system may background the last dismissed scene instead","type":"text"},{"text":" ","type":"text"},{"text":"of closing it. Thus, the suppressed behavior additionally specifies that","type":"text"},{"text":" ","type":"text"},{"text":"the scene should not be presented when tapping on the application icon","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"with no visible windows."}]},{"inlineContent":[{"type":"text","text":"For example, you may wish to present a welcome window on launch of your"},{"type":"text","text":" "},{"type":"text","text":"app when there are no previous document windows being restored:"}],"type":"paragraph"},{"code":["@main","struct MyApp: App {","    var body: some Scene {","        DocumentGroup(newDocument: MyDocument()) { configuration in","            DocumentEditor(configuration.$document)","        }","","        Window(\"Welcome to My App\", id: \"welcome\") {","            WelcomeView()","        }","        .defaultLaunchBehavior(.presented)","    }","}"],"syntax":null,"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default value for all scenes if you do not apply this modifier is"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneLaunchBehavior\/automatic","isActive":true},{"type":"text","text":". With that strategy, a scene"},{"text":" ","type":"text"},{"text":"will only present itself if it is the first scene defined by the app,","type":"text"},{"text":" ","type":"text"},{"text":"and no other scenes have presented themselves.","type":"text"}]}],"kind":"content"}],"sections":[],"abstract":[{"text":"Sets the default launch behavior for this scene.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/scene\/defaultlaunchbehavior(_:)"]}],"metadata":{"role":"symbol","symbolKind":"method","extendedModule":"OpenSwiftUI","externalID":"s:11OpenSwiftUI5ScenePAAE21defaultLaunchBehavioryQrAA0dfG0VF","title":"defaultLaunchBehavior(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultLaunchBehavior","kind":"identifier"},{"text":"(","kind":"text"},{"text":"SceneLaunchBehavior","preciseIdentifier":"s:11OpenSwiftUI19SceneLaunchBehaviorV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP","kind":"typeIdentifier