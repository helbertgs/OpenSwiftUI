pe":"text","text":"controls that the system provides. Also, during state restoration,"},{"type":"text","text":" "},{"type":"text","text":"the system restores windows to their most recent size rather than"},{"type":"text","text":" "},{"type":"text","text":"the default size."}],"type":"paragraph"},{"inlineContent":[{"text":"If you specify a default size that’s outside the range of the window’s","type":"text"},{"text":" ","type":"text"},{"text":"inherent resizability in one or both dimensions, the system clamps the","type":"text"},{"text":" ","type":"text"},{"text":"affected dimension to keep it in range. You can configure the","type":"text"},{"text":" ","type":"text"},{"text":"resizability of a scene using the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/windowResizability(_:)","type":"reference"},{"text":" ","type":"text"},{"text":"modifier.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The default size modifier affects any scene type that creates windows"},{"type":"text","text":" "},{"type":"text","text":"in macOS, namely:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup","isActive":true,"type":"reference"}]}]},{"content":[{"inlineContent":[{"code":"Window","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"DocumentGroup","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Settings"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"If you want to specify the size input in terms of size instance,"},{"type":"text","text":" "},{"type":"text","text":"use "},{"type":"codeVoice","code":"Scene\/defaultSize(_:)-5y8n"},{"type":"text","text":" instead."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/do