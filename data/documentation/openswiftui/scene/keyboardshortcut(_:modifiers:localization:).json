e","code":"WindowGroup"},{"type":"text","text":" normally"},{"type":"text","text":" "},{"type":"text","text":"creates a File > New Window menu command whose keyboard shortcut is"},{"type":"text","text":" "},{"type":"codeVoice","code":"⌘N"},{"type":"text","text":". The following code changes it to "},{"type":"codeVoice","code":"⌥⌘N"},{"type":"text","text":":"}]},{"type":"codeListing","code":["WindowGroup {","    ContentView()","}",".keyboardShortcut(\"n\", modifiers: [.option, .command])"],"syntax":null},{"type":"heading","text":"Localization","level":3,"anchor":"Localization"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Provide a "},{"type":"codeVoice","code":"localization"},{"type":"text","text":" value to specify how this shortcut"},{"type":"text","text":" "},{"type":"text","text":"should be localized."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Given that "},{"type":"codeVoice","code":"key"},{"type":"text","text":" is always defined in relation to the US-English"},{"type":"text","text":" "},{"type":"text","text":"keyboard layout, it might be hard to reach on different international"},{"type":"text","text":" "},{"type":"text","text":"layouts. For example the shortcut "},{"type":"codeVoice","code":"⌘["},{"type":"text","text":" works well for the"},{"type":"text","text":" "},{"type":"text","text":"US layout but is hard to reach for German users, where"},{"type":"text","text":" "},{"type":"codeVoice","code":"["},{"type":"text","text":" is available by pressing "},{"type":"codeVoice","code":"⌥5"},{"type":"text","text":", making users type "},{"type":"codeVoice","code":"⌥⌘5"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The automatic keyboard shortcut remapping re-assigns the shortcut to"},{"type":"text","text":" "},{"type":"text","text":"an appropriate replacement, "},{"type":"codeVoice","code":"⌘Ö"},{"type":"text","text":" in this case."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"