ll any actions associated with matching tasks. When","type":"text"},{"text":" ","type":"text"},{"text":"your async actions return, the system put your app back into a suspended","type":"text"},{"text":" ","type":"text"},{"text":"state. The system considers the task completed when the action closure","type":"text"},{"text":" ","type":"text"},{"text":"that you provide returns. If the action closure has not returned when","type":"text"},{"text":" ","type":"text"},{"text":"the task runs out of time to complete, the system cancels the task. Use","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Swift\/withTaskCancellationHandler(operation:onCancel:)","type":"text"},{"text":" ","type":"text"},{"text":"to observe whether the task is low on runtime.","type":"text"}]},{"type":"codeListing","code":["\/\/\/ An example of a Weather Application.","struct WeatherApp: App {","    var body: some Scene {","        WindowGroup {","            Text(\"Responds to App Refresh\")","        }","        .backgroundTask(.appRefresh(\"WEATHER_DATA\")) {","            await updateWeatherData()","        }","    }","    func updateWeatherData() async {","        \/\/ fetches new weather data and updates app state","    }","}"],"syntax":null}]}],"kind":"symbol","abstract":[{"type":"text","text":"Runs the specified action when the system provides a background task."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/scene\/backgroundtask(_:action:)-4bcuo"]}],"sections":[],"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/backgroundTask(_:action:)-4bcuo","interfaceLanguage":"swift"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"title":"OpenSwiftUI","abstract":[],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","type":"topic","url":"\/documentation\/openswiftui","kind":"symbol","role":"collection"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene/