{"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"]]},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultWindowPlacement"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"makePlacement"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI16WindowLayoutRootV","text":"WindowLayoutRoot","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowLayoutRoot"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI22WindowPlacementContextV","text":"WindowPlacementContext","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowPlacementContext"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI15WindowPlacementV","text":"WindowPlacement","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowPlacement"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5SceneP","text":"Scene","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"},{"kind":"text","text":"\n"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"A closure to generate the default window placement.","type":"text"}],"type":"paragraph"}],"name":"makePlacement"}]},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this scene modifier to indicate a default initial size and position"},{"text":" ","type":"text"},{"type":"text","text":"for a new window that the system creates from a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"},{"type":"text","text":" declaration."}]},{"inlineContent":[{"type":"text","text":"On Windows, you can use the screen’s bounds to place the window."},{"type":"text","text":" "},{"type":"text","text":"For example, you can specify that the window is always placed 140"},{"type":"text","text":" "},{"type":"text","text":"points from the bottom of the screen:"}],"type":"paragraph"},{"code":["struct MyApp: App {","    var body: some Scene {","        ...","","        Window(\"Status\", id: \"status\") {","            StatusView()","        }","        .windowResizability(.contentSize)","        .defaultWindowPlacement { content, context in","            let displayBounds = context.defaultDisplay.visibleRect","            let size = content.sizeThatFits(.unspecified)","            let position = CGPoint(","                x: displayBounds.midX - (size.width \/ 2),","                y: displayBounds.maxY - size.height - 140)","            return WindowPlacement(position: position, size: size)","        }","    }","}"],"type":"codeListing","syntax":null},{"inlineContent":[{"type":"text","text":"On visionOS, the system always places the first window"},{"type":"text","text":" "},{"type":"text","text":"relative to where the person is looking."},{"type":"text","text":" "},{"type":"text","text":"The system ignores calls to "},{"code":"defaultWindowPlacement(_:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You can place any subsequent windows relative to existing ones by","type":"text"},{"text":" ","type":"text"},{"text":"returning one of the methods defined by ","type":"text"},{"code":"WindowPlacement\/Position","type":"codeVoice"},{"text":" ","type":"text"},{"text":"with the existing window.","type":"text"},{"text":" ","type":"text"},{"text":"For example, you can align the new window with the trailing edge of","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"Content","type":"codeVoice"},{"text":" window:","type":"text"}],"type":"paragraph"},{"code":["struct MyApp: App {","    @Environment(\\.openWindow) private var openWindow","","    var body: some Scene {","        WindowGroup(\"Content\", id: \"content\") {","            Button(\"Open status window\") {","                openWindow(id: \"status\")","            }","        }","","        WindowGroup(\"Status\", id: \"status\") {","            StatusView()","        }","        .windowResizability(.contentSize)","        .defaultWindowPlacement { content, context in","            if let contentWindow = context.windows.first(","            where: { $0.id == \"content\" }) {","                WindowPlacement(.trailing(contentWindow))","            } else {","                WindowPlacement()","            }","        }","    }","}"],"type":"codeListing","syntax":null},{"inlineContent":[{"text":"The placement that your function returns acts as a default for when the","type":"text"},{"text":" ","type":"text"},{"text":"window first appears. People can later resize and move the window using","type":"text"},{"text":" ","type":"text"},{"text":"interface controls that the system provides. Also, during state","type":"text"},{"text":" ","type":"text"},{"text":"restoration, the system restores the window to it’s most recent size and","type":"text"},{"text":" ","type":"text"},{"text":"position, rather than the default placement.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For more information on configuring how scenes behave with","type":"text"},{"text":" ","type":"text"},{"text":"state restoration, see ","type":"text"},{"code":"Scene.stateRestoration(_:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/scene\/defaultwindowplacement(_:)"]}],"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"defaultWindowPlacement","kind":"identifier"},{"kind":"text","text":"(("},{"preciseIdentifier":"s:11OpenSwiftUI16WindowLayoutRootV","text":"WindowLayoutRoot","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI22WindowPlacementContextV","text":"WindowPlacementContext","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI15WindowPlacementV","text":"WindowPlacement","kind":"typeIdentifier"},{"kind":"text","text":") -> "},{"text":"some","kind":"keyword"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","text":"Scene","kind":"typeIdentifier"}],"roleHeading":"Instance Method","modules":[{"name":"OpenSwiftUI"}],"externalID":"s:11OpenSwiftUI5ScenePAAE22defaultWindowPlacementyQrAA0fG0VAA0F10LayoutRootV_AA0fG7ContextVtcF","extendedModule":"OpenSwiftUI","title":"defaultWindowPlacement(_:)","role":"symbol","symbolKind":"method"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/defaultWindowPlacement(_:)"},"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"Defines a function used for determining the default placement"},{"type":"text","text":" "},{"type":"text","text":"of windows."}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene/defaultWindowPlacement(_:)":{"url":"\/documentation\/openswiftui\/scene\/defaultwindowplacement(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultWindowPlacement","kind":"identifier"},{"text":"((","kind":"text"},{"text":"WindowLayoutRoot","preciseIdentifier":"s:11OpenSwiftUI16WindowLayoutRootV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"tex