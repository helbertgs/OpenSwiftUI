{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/scene\/defaultwindowplacement(_:)"]}],"abstract":[{"type":"text","text":"Defines a function used for determining the default placement"},{"type":"text","text":" "},{"type":"text","text":"of windows."}],"metadata":{"symbolKind":"method","title":"defaultWindowPlacement(_:)","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultWindowPlacement"},{"kind":"text","text":"(("},{"preciseIdentifier":"s:11OpenSwiftUI16WindowLayoutRootV","kind":"typeIdentifier","text":"WindowLayoutRoot"},{"kind":"text","text":", "},{"preciseIdentifier":"s:11OpenSwiftUI22WindowPlacementContextV","kind":"typeIdentifier","text":"WindowPlacementContext"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:11OpenSwiftUI15WindowPlacementV","kind":"typeIdentifier","text":"WindowPlacement"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","kind":"typeIdentifier","text":"Scene"}],"modules":[{"name":"OpenSwiftUI"}],"externalID":"s:11OpenSwiftUI5ScenePAAE22defaultWindowPlacementyQrAA0fG0VAA0F10LayoutRootV_AA0fG7ContextVtcF","extendedModule":"OpenSwiftUI","role":"symbol"},"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultWindowPlacement"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"makePlacement"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"text","text":"("},{"preciseIdentifier":"s:11OpenSwiftUI16WindowLayoutRootV","kind":"typeIdentifier","text":"WindowLayoutRoot","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowLayoutRoot"},{"kind":"text","text":", "},{"preciseIdentifier":"s:11OpenSwiftUI22WindowPlacementContextV","kind":"typeIdentifier","text":"WindowPlacementContext","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowPlacementContext"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:11OpenSwiftUI15WindowPlacementV","kind":"typeIdentifier","text":"WindowPlacement","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowPlacement"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","kind":"typeIdentifier","text":"Scene","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"},{"kind":"text","text":"\n"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"name":"makePlacement","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A closure to generate the default window placement."}]}]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"Use this scene modifier to indicate a default initial size and position"},{"type":"text","text":" "},{"type":"text","text":"for a new window that the system creates from a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"},{"type":"text","text":" declaration."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"On Windows, you can use the screen’s bounds to place the window."},{"type":"text","text":" "},{"type":"text","text":"For example, you can specify that the window is always placed 140"},{"type":"text","text":" "},{"type":"text","text":"points from the bottom of the screen:"}],"type":"paragraph"},{"code":["struct MyApp: App {","    var body: some Scene {","        ...","","        Window(\"Status\", id: \"status\") {","            StatusView()","        }","        .windowResizability(.contentSize)","        .defaultWindowPlacement { content, context in","            let displayBounds = context.defaultDisplay.visibleRect","            let size = content.sizeThatFits(.unspecified)","            let position = CGPoint(","                x: displayBounds.midX - (size.width \/ 2),","                y: displayBounds.maxY - size.height - 140)","            return WindowPlacement(position: position, size: size)","        }","    }","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"On visionOS, the system always places the first window"},{"type":"text","text":" "},{"type":"text","text":"relative to where the person is looking."},{"type":"text","text":" "},{"type":"text","text":"The system ignores calls to "},{"type":"codeVoice","code":"defaultWindowPlacement(_:)"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"You can place any subsequent windows relative to existing ones by","type":"text"},{"type":"text","text":" "},{"text":"returning one of the methods defined by ","type":"text"},{"code":"WindowPlacement\/Position","type":"codeVoice"},{"text":" ","type":"text"},{"text":"with the existing window.","type":"text"},{"text":" ","type":"text"},{"text":"For example, you can align the new window with the trailing edge of","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"Content","type":"codeVoice"},{"type":"text","text":" window:"}],"type":"paragraph"},{"code":["struct MyApp: App {","    @Environment(\\.openWindow) private var openWindow","","    var body: some Scene {","        WindowGroup(\"Content\", id: \"content\") {","            Button(\"Open status window\") {","                openWindow(id: \"status\")","            }","        }","","        WindowGroup(\"Status\", id: \"status\") {","            StatusView()","        }","        .windowResizability(.contentSize)","        .defaultWindowPlacement { content, context in","            if let contentWindow = context.windows.first(","            where: { $0.id == \"content\" }) {","                WindowPlacement(.trailing(contentWindow))","            } else {","                WindowPlacement()","            }","        }","    }","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The placement that your function returns acts as a default for when the"},{"type":"text","text":" "},{"type":"text","text":"window first appears. People can later resize and move the window using"},{"type":"text","text":" "},{"type":"text","text":"interface controls that the system provides. Also, during state"},{"type":"text","text":" "},{"type":"text","text":"restoration, the system restores the window to it’s most recent size and"},{"type":"text","text":" "},{"type":"text","text":"position, rather than the default placement."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For more information on configuring how scenes behave with"},{"type":"text","text":" "},{"type":"text","text":"state restoration, see "},{"type":"codeVoice","code":"Scene.stateRestoration(_:)"},{"type":"text","text":"."}],"type":"paragraph"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/defaultWindowPlacement(_:)"},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"]]},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","abstract":[],"title":"OpenSwiftUI","url":"\/documentation\/openswiftui","kind":"symbol","type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/WindowLayoutRoot":{"url":"\/documentation\/openswiftui\/windowlayoutroot","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowLayoutRoot","title":"WindowLayoutRoot","role":"symbol","type":"topic","abstract":[{"text":"A proxy which represents the root contents of a window.","type":"text"}],"kind":"symbol","navigatorTitle":[{"text":"WindowLayoutRoot","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WindowLayoutRoot","kind":"identifier"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/WindowPlacementContext":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WindowPlacementContext"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowPlacementContext","role":"symbol","abstract":[{"type":"text","text":"A type which represents contextual information used for sizing and"},{"type":"text","text":" "},{"type":"text","text":"positioning windows."}],"title":"WindowPlacementContext","kind":"symbol","url":"\/documentation\/openswiftui\/windowplacementcontext","navigatorTitle":[{"kind":"identifier","text":"WindowPlacementContext"}],"type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scene"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","role":"symbol","abstract":[{"type":"text","text":"A part of an app’s user interface with a life cycle managed by the"},{"type":"text","text":" "},{"type":"text","text":"system."}],"title":"Scene","kind":"symbol","url":"\/documentation\/openswiftui\/scene","navigatorTitle":[{"kind":"identifier","text":"Scene"}],"type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/WindowPlacement":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WindowPlacement"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowPlacement","role":"symbol","abstract":[{"type":"text","text":"A type which represents a preferred size and position for a window."}],"title":"WindowPlacement","url":"\/documentation\/openswiftui\/windowplacement","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"WindowPlacement"}],"type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene/defaultWindowPlacement(_:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultWindowPlacement"},{"kind":"text","text":"(("},{"kind":"typeIdentifier","text":"WindowLayoutRoot","preciseIdentifier":"s:11OpenSwiftUI16WindowLayoutRootV"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"WindowPlacementContext","preciseIdentifier":"s:11OpenSwiftUI22WindowPlacementContextV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"WindowPlacement","preciseIdentifier":"s:11OpenSwiftUI15WindowPlacementV"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","kind":"typeIdentifier","text":"Scene"}],"title":"defaultWindowPlacement(_:)","abstract":[{"type":"text","text":"Defines a function used for determining the default placement"},{"text":" ","type":"text"},{"type":"text","text":"of windows."}],"kind":"symbol","url":"\/documentation\/openswiftui\/scene\/defaultwindowplacement(_:)","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/defaultWindowPlacement(_:)","role":"symbol"}}}