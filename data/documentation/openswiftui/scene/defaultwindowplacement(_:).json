identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","title":"Scene","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scene"}],"url":"\/documentation\/openswiftui\/scene"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/WindowPlacement":{"abstract":[{"type":"text","text":"A type which represents a preferred size and position for a window."}],"kind":"symbol","navigatorTitle":[{"text":"WindowPlacement","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowPlacement","title":"WindowPlacement","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WindowPlacement","kind":"identifier"}],"url":"\/documentation\/openswiftui\/windowplacement"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/WindowLayoutRoot":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WindowLayoutRoot"}],"kind":"symbol","title":"WindowLayoutRoot","url":"\/documentation\/openswiftui\/windowlayoutroot","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowLayoutRoot","abstract":[{"text":"A proxy which represents the root contents of a window.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"WindowLayoutRoot"}]}}}