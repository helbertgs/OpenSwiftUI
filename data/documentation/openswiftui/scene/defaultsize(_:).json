window’s"},{"type":"text","text":" "},{"type":"text","text":"inherent resizability in one or both dimensions, the system clamps the"},{"type":"text","text":" "},{"type":"text","text":"affected dimension to keep it in range. You can configure the"},{"type":"text","text":" "},{"type":"text","text":"resizability of a scene using the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/windowResizability(_:)"},{"type":"text","text":" "},{"type":"text","text":"modifier."}]},{"type":"paragraph","inlineContent":[{"text":"The default size modifier affects any scene type that creates windows","type":"text"},{"text":" ","type":"text"},{"text":"in macOS, namely:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup","type":"reference"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Window"}]}]},{"content":[{"inlineContent":[{"code":"DocumentGroup","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Settings"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you want to specify the input directly in terms of width and height,"},{"type":"text","text":" "},{"type":"text","text":"use "},{"type":"codeVoice","code":"Scene\/defaultSize(width:height:)"},{"type":"text","text":" instead."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"]]},"sections":[],"kind":"symbol","references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Size":{"role":"symbol","abstract":[],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Size","title":"Size","type":"topic","url":"\/documentation\/openswiftui\/size","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "