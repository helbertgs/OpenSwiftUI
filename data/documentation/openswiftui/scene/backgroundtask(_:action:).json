"kind":"genericParameter"},{"kind":"text","text":">("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"task"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSwiftUI14BackgroundTaskV","kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/BackgroundTask","text":"BackgroundTask"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"D"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"R"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"action"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" ("},{"kind":"typeIdentifier","text":"D"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"R"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"D","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"R","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"},{"text":"\n","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The type of task with which to associate the provided action."}],"type":"paragraph"}],"name":"task"},{"content":[{"inlineContent":[{"type":"text","text":"An async closure that the system runs for the specified task"},{"type":"text","text":" "},{"type":"text","text":"type."}],"type":"paragraph"}],"name":"action"}],"kind":"parameters"},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"text":"When the system wakes your app or extension for one or more background","type":"text"},{"text":" ","type":"text"},{"text":"tasks, it will call any actions associated with matching tasks. When","type":"text"},{"text":" ","type":"text"},{"text":"your async actions return, the system put your app back into a suspended","type":"text"},{"text":" ","type":"text"},{"text":"state. The system considers the task completed when the action closure","type":"text"},{"text":" ","type":"text"},{"text":"that you provide returns. If the action closure has not returned when","type":"text"},{"text":" ","type":"text"},{"text":"the task runs out of time to complete, the system cancels the task. Use","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Swift\/withTaskCancellationHandler(operation:onCancel:)","type":"text"},{"text":" ","type":"text"},{"text":"to observe whether the task is low on runtime.","type":"text"}],"type":"paragraph"},{"code":["\/\/\/ An example of a Weather Application.","struct WeatherApp: App {","    var body: some Scene {","        WindowGroup {","            Text(\"Responds to App Refresh\")","        }","        .backgroundTask(.appRefresh(\"WEATHER_DATA\")) {","            await updateWeatherData()","        }","    }","    func updateWeatherData() async {","        \/\/ fetches new weather data and updates app state","    }","}"],"type":"codeListing","syntax":null}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/backgroundTask(_:action:)"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/BackgroundTask":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind"