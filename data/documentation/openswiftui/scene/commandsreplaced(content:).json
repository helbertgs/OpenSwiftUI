scene."}],"type":"paragraph"}],"name":"content"}]},{"kind":"content","content":[{"level":2,"anchor":"return-value","type":"heading","text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A scene that replaces any commands defined by its children"},{"type":"text","text":" "},{"type":"text","text":"with alternative content."}]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"WindowGroup"},{"type":"text","text":", "},{"type":"codeVoice","code":"Window"},{"type":"text","text":", and other scene types all have an associated"},{"type":"text","text":" "},{"type":"text","text":"set of commands that they include by default. Apply this modifier to a"},{"type":"text","text":" "},{"type":"text","text":"scene to replace those commands with the output from the given builder."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, the following code adds a scene for showing the contents of"},{"type":"text","text":" "},{"type":"text","text":"the pasteboard in a dedicated window. We replace the scene’s default"},{"type":"text","text":" "},{"type":"text","text":"Window > Clipboard menu command with a custom Edit > Show Clipboard"},{"type":"text","text":" "},{"type":"text","text":"command that we place next to the other pasteboard commands."}]},{"type":"codeListing","syntax":null,"code":["@main","struct Example: App {","    @Environment(\\.openWindow) var openWindow","","    var body: some Scene {","        ...","","        Window(\"Clipboard\", id: \"clipboard\") {","            ClipboardContentView()","        }","        .commandsReplaced {","            CommandGroup(after: .pasteboard) {","                Section {","                    Button(\"Show Clipboard\") {","                        openWindow(id: \"clipboard\")","                    }","                }","            }","        }","    }","}"]}]}],"schema