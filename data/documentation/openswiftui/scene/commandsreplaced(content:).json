ace the scene’s default"},{"type":"text","text":" "},{"type":"text","text":"Window > Clipboard menu command with a custom Edit > Show Clipboard"},{"type":"text","text":" "},{"type":"text","text":"command that we place next to the other pasteboard commands."}]},{"code":["@main","struct Example: App {","    @Environment(\\.openWindow) var openWindow","","    var body: some Scene {","        ...","","        Window(\"Clipboard\", id: \"clipboard\") {","            ClipboardContentView()","        }","        .commandsReplaced {","            CommandGroup(after: .pasteboard) {","                Section {","                    Button(\"Show Clipboard\") {","                        openWindow(id: \"clipboard\")","                    }","                }","            }","        }","    }","}"],"syntax":null,"type":"codeListing"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/scene\/commandsreplaced(content:)"]}],"abstract":[{"text":"Replaces all commands defined by the modified scene with the commands","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"from the builder."}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/CommandsBuilder":{"navigatorTitle":[{"kind":"identifier","text":"CommandsBuilder"}],"title":"CommandsBuilder","role":"symbol","type":"topic","url":"\/documentation\/openswiftui\/commandsbuilder","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/CommandsBuilder","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CommandsBuilder"}],"abstract":[{"text":"Constructs command sets from multi-expression closures. Like ","type":"text"},{"code":"ViewBuilder","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"it supports up to ten expressions in the closure body.","type":"text"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene":{"navigatorTitle":[{"kind":"ide