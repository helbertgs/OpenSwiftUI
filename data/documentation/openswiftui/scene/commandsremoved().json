"text":", "},{"code":"Window","type":"codeVoice"},{"type":"text","text":", and other scene types all have an associated"},{"type":"text","text":" "},{"type":"text","text":"set of commands that they include by default. Apply this modifier to a"},{"type":"text","text":" "},{"type":"text","text":"scene to exclude those commands."}],"type":"paragraph"},{"inlineContent":[{"text":"For example, the following code adds a scene for presenting the details","type":"text"},{"text":" ","type":"text"},{"text":"of an individual data model in a separate window. To ensure that the","type":"text"},{"text":" ","type":"text"},{"text":"window can only appear programmatically, we remove the scene’s commands,","type":"text"},{"text":" ","type":"text"},{"text":"including File > New Note Window.","type":"text"}],"type":"paragraph"},{"code":["@main","struct Example: App {","    var body: some Scene {","        ...","","        WindowGroup(\"Note\", id: \"note\", for: Note.ID.self) {","            NoteDetailView(id: $0)","        }","        .commandsRemoved()","    }","}"],"syntax":null,"type":"codeListing"}]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"abstract":[],"kind":"symbol","url":"\/documentation\/openswiftui","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","type":"topic","title":"OpenSwiftUI"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene":{"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"identifier"}],"navigatorTitle":[{"text":"Scene","kind":"identifier"}],"url":"\/documentation\/openswiftui\/scene","kind":"symbol","abstract":[{"text":"A part of an app’s user interface with a life cycle managed by the","type":"text"},{"text":" ","type":"text"},{"text":"system.","type":"text"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","type":"topic","title":"Scene"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene/commandsRemoved()":{"abstract"