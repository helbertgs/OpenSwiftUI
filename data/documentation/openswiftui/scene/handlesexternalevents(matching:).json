{"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/handlesExternalEvents(matching:)"},"abstract":[{"text":"Specifies the external events for which OpenSwiftUI opens a new instance","type":"text"},{"text":" ","type":"text"},{"text":"of the modified scene.","type":"text"}],"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"handlesExternalEvents"},{"kind":"text","text":"("},{"kind":"externalParam","text":"matching"},{"kind":"text","text":" "},{"kind":"internalParam","text":"conditions"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sh","text":"Set"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":">) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5SceneP","text":"Scene"},{"kind":"text","text":"\n"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A set of strings that OpenSwiftUI compares against"},{"type":"text","text":" "},{"type":"text","text":"the incoming user activity or URL to see if OpenSwiftUI"},{"type":"text","text":" "},{"type":"text","text":"can open a new scene instance to handle the external event."}]}],"name":"conditions"}],"kind":"parameters"},{"content":[{"anchor":"return-value","level":2,"text":"Return Value","type":"heading"},{"inlineContent":[{"type":"text","text":"A scene type that limits the kinds of external events for"},{"type":"text","text":" "},{"type":"text","text":"which OpenSwiftUI opens a new instance."}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"When your app receives an external event like a user activity or a"},{"type":"text","text":" "},{"type":"text","text":"URL, OpenSwiftUI routes the event to a scene for processing. OpenSwiftUI"},{"type":"text","text":" "},{"type":"text","text":"selects the scene that receives the event according to the following"},{"type":"text","text":" "},{"type":"text","text":"rules, which it evaluates in order until it finds a destination scene:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"On platforms that support only a single scene per app, send","type":"text"},{"text":" ","type":"text"},{"text":"the event to the one open scene.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Find an open scene that indicates it prefers to or can handle the"},{"type":"text","text":" "},{"type":"text","text":"event, if any, and send the event to that scene. You use the"},{"type":"text","text":" "},{"code":"View\/handlesExternalEvents(preferring:allowing:)","type":"codeVoice"},{"type":"text","text":" view modifier"},{"type":"text","text":" "},{"type":"text","text":"on a view inside the scene to register this preference."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Find a scene declaration with a ","type":"text"},{"code":"handlesExternalEvents(matching:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"scene modifier containing ","type":"text"},{"code":"conditions","type":"codeVoice"},{"text":" that match the external event.","type":"text"},{"text":" ","type":"text"},{"text":"Create a new instance of the first scene that matches and route the","type":"text"},{"text":" ","type":"text"},{"text":"event there.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Find the first scene declaration that doesn’t have the scene modifier."},{"type":"text","text":" "},{"type":"text","text":"Create a new instance of this scene and route the event there."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Make sure that at least one of these rules succeeds in your app for all"},{"type":"text","text":" "},{"type":"text","text":"events that your app claims to handle. Also, make sure"},{"type":"text","text":" "},{"type":"text","text":"that the scene that receives an event actually handles it. For example,"},{"type":"text","text":" "},{"type":"text","text":"be sure that a scene that receives user activities handles them with an"},{"type":"text","text":" "},{"type":"text","text":"appropriate "},{"code":"View\/onContinueUserActivity(_:perform:)","type":"codeVoice"},{"type":"text","text":" view modifier."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Don’t confuse the "},{"code":"handlesExternalEvents(matching:)","type":"codeVoice"},{"type":"text","text":" scene"},{"type":"text","text":" "},{"type":"text","text":"modifier with the "},{"code":"View\/handlesExternalEvents(preferring:allowing:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"view"}]},{"type":"text","text":" modifier. You use the scene modifier to help OpenSwiftUI choose a"},{"type":"text","text":" "},{"type":"text","text":"new scene to open when no open scene handles an external event,"},{"type":"text","text":" "},{"type":"text","text":"whereas you use the view modifier to indicate that an open scene can"},{"type":"text","text":" "},{"type":"text","text":"or prefers to handle certain events."}],"type":"paragraph"},{"anchor":"Matching-an-event","level":3,"text":"Matching an event","type":"heading"},{"inlineContent":[{"type":"text","text":"To find a scene type that handles a particular external event, OpenSwiftUI"},{"type":"text","text":" "},{"type":"text","text":"compares a property of the event against the strings that you specify"},{"type":"text","text":" "},{"type":"text","text":"in the "},{"code":"conditions","type":"codeVoice"},{"type":"text","text":" set. OpenSwiftUI examines the following event"},{"type":"text","text":" "},{"type":"text","text":"properties to perform the comparison:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"For an","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/NSUserActivity","type":"text"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"like when your app handles Handoff, OpenSwiftUI uses the activity’s","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/NSUserActivity\/3238062-targetContentIdentifier","type":"text"},{"text":" ","type":"text"},{"text":"property, or if that’s ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", its","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/NSUserActivity\/1418086-webpageurl","type":"text"},{"text":" ","type":"text"},{"text":"property rendered as an","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/URL\/1779984-absoluteString","type":"text"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For a"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/URL"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"like when another process opens a URL that your app handles,"},{"type":"text","text":" "},{"type":"text","text":"OpenSwiftUI uses the URL’s"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/URL\/1779984-absoluteString"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"An empty set of strings never matches. Similarly, empty strings never"},{"type":"text","text":" "},{"type":"text","text":"match. Conversely, as a special case, the string that contains only an"},{"type":"text","text":" "},{"type":"text","text":"asterisk ("},{"code":"*","type":"codeVoice"},{"type":"text","text":") matches anything. The modifier performs string"},{"type":"text","text":" "},{"type":"text","text":"comparisons that are case and diacritic insensitive."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"DocumentGroup"},{"type":"text","text":" scenes ignore this modifier. Instead,"},{"type":"text","text":" "},{"type":"text","text":"document scenes decide whether to open a new scene to handle an"},{"type":"text","text":" "},{"type":"text","text":"external event by comparing the incoming URL or user activity’s"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/NSUserActivity\/1418086-webpageurl"},{"type":"text","text":" "},{"type":"text","text":"against the document group’s supported types."}]}],"name":"Important","style":"important","type":"aside"},{"anchor":"Choosing-a-window-to-open","level":3,"text":"Choosing a window to open","type":"heading"},{"inlineContent":[{"type":"text","text":"The following example shows an app with a photo browser scene"},{"text":" ","type":"text"},{"text":"that displays a collection of photos, and a photo detail scene that","type":"text"},{"type":"text","text":" "},{"text":"enables closer examination of a particular photo:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["@main","struct MyPhotos: App {","    var body: some Scene {","        WindowGroup {","            PhotosBrowser()","        }","","        WindowGroup(\"Photo\") {","            PhotoDetail()","        }","        .handlesExternalEvents(matching: [\"photoIdentifier=\"])","    }","}"],"syntax":null},{"type":"paragraph","inlineContent":[{"text":"The app uses the ","type":"text"},{"type":"codeVoice","code":"handlesExternalEvents(matching:)"},{"text":" modifier on the","type":"text"},{"text":" ","type":"text"},{"text":"second scene to ensure that an external event with an identifier","type":"text"},{"text":" ","type":"text"},{"text":"that contains the string ","type":"text"},{"type":"codeVoice","code":"photoIdentifier="},{"text":" creates a new scene of","type":"text"},{"text":" ","type":"text"},{"text":"the second type. Other events, if not handled by an open scene,","type":"text"},{"text":" ","type":"text"},{"text":"cause the creation of a new browser window instead.","type":"text"}]}],"kind":"content"}],"metadata":{"externalID":"s:11OpenSwiftUI5ScenePAAE21handlesExternalEvents8matchingQrShySSG_tF","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"handlesExternalEvents","kind":"identifier"},{"text":"(","kind":"text"},{"text":"matching","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sh","text":"Set","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","text":"Scene","kind":"typeIdentifier"}],"extendedModule":"OpenSwiftUI","role":"symbol","title":"handlesExternalEvents(matching:)","symbolKind":"method","modules":[{"name":"OpenSwiftUI"}]},"variants":[{"paths":["\/documentation\/openswiftui\/scene\/handlesexternalevents(matching:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene/handlesExternalEvents(matching:)":{"fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"handlesExternalEvents"},{"kind":"text","text":"("},{"kind":"externalParam","text":"matching"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sh","text":"Set"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":">) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5SceneP","text":"Scene"}],"title":"handlesExternalEvents(matching:)","url":"\/documentation\/openswiftui\/scene\/handlesexternalevents(matching:)","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/handlesExternalEvents(matching:)","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Specifies the external events for which OpenSwiftUI opens a new instance"},{"type":"text","text":" "},{"type":"text","text":"of the modified scene."}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"title":"OpenSwiftUI","url":"\/documentation\/openswiftui","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","kind":"symbol","abstract":[]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene":{"navigatorTitle":[{"kind":"identifier","text":"Scene"}],"title":"Scene","role":"symbol","type":"topic","url":"\/documentation\/openswiftui\/scene","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scene"}],"abstract":[{"text":"A part of an app’s user interface with a life cycle managed by the","type":"text"},{"text":" ","type":"text"},{"text":"system.","type":"text"}]}}}