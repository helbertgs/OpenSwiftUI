{"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"]]},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/handlesExternalEvents(matching:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Specifies the external events for which OpenSwiftUI opens a new instance"},{"type":"text","text":" "},{"type":"text","text":"of the modified scene."}],"metadata":{"modules":[{"name":"OpenSwiftUI"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"handlesExternalEvents"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"matching"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sh","kind":"typeIdentifier","text":"Set"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"text":">) -> ","kind":"text"},{"kind":"keyword","text":"some"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","kind":"typeIdentifier","text":"Scene"}],"role":"symbol","title":"handlesExternalEvents(matching:)","externalID":"s:11OpenSwiftUI5ScenePAAE21handlesExternalEvents8matchingQrShySSG_tF","roleHeading":"Instance Method","extendedModule":"OpenSwiftUI","symbolKind":"method"},"kind":"symbol","sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"handlesExternalEvents","kind":"identifier"},{"text":"(","kind":"text"},{"text":"matching","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"conditions","kind":"internalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Set","preciseIdentifier":"s:Sh"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":">) -> "},{"kind":"keyword","text":"some"},{"text":" ","kind":"text"},{"text":"Scene","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5SceneP","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"},{"text":"\n","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"name":"conditions","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A set of strings that OpenSwiftUI compares against"},{"type":"text","text":" "},{"type":"text","text":"the incoming user activity or URL to see if OpenSwiftUI"},{"type":"text","text":" "},{"type":"text","text":"can open a new scene instance to handle the external event."}]}]}]},{"kind":"content","content":[{"anchor":"return-value","level":2,"type":"heading","text":"Return Value"},{"inlineContent":[{"type":"text","text":"A scene type that limits the kinds of external events for"},{"type":"text","text":" "},{"type":"text","text":"which OpenSwiftUI opens a new instance."}],"type":"paragraph"}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"When your app receives an external event like a user activity or a"},{"type":"text","text":" "},{"type":"text","text":"URL, OpenSwiftUI routes the event to a scene for processing. OpenSwiftUI"},{"type":"text","text":" "},{"type":"text","text":"selects the scene that receives the event according to the following"},{"type":"text","text":" "},{"type":"text","text":"rules, which it evaluates in order until it finds a destination scene:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"On platforms that support only a single scene per app, send"},{"type":"text","text":" "},{"type":"text","text":"the event to the one open scene."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Find an open scene that indicates it prefers to or can handle the"},{"type":"text","text":" "},{"type":"text","text":"event, if any, and send the event to that scene. You use the"},{"type":"text","text":" "},{"type":"codeVoice","code":"View\/handlesExternalEvents(preferring:allowing:)"},{"type":"text","text":" view modifier"},{"type":"text","text":" "},{"type":"text","text":"on a view inside the scene to register this preference."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Find a scene declaration with a "},{"type":"codeVoice","code":"handlesExternalEvents(matching:)"},{"type":"text","text":" "},{"type":"text","text":"scene modifier containing "},{"type":"codeVoice","code":"conditions"},{"type":"text","text":" that match the external event."},{"type":"text","text":" "},{"type":"text","text":"Create a new instance of the first scene that matches and route the"},{"type":"text","text":" "},{"type":"text","text":"event there."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Find the first scene declaration that doesn’t have the scene modifier."},{"type":"text","text":" "},{"type":"text","text":"Create a new instance of this scene and route the event there."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Make sure that at least one of these rules succeeds in your app for all"},{"type":"text","text":" "},{"type":"text","text":"events that your app claims to handle. Also, make sure"},{"type":"text","text":" "},{"type":"text","text":"that the scene that receives an event actually handles it. For example,"},{"type":"text","text":" "},{"type":"text","text":"be sure that a scene that receives user activities handles them with an"},{"type":"text","text":" "},{"type":"text","text":"appropriate "},{"type":"codeVoice","code":"View\/onContinueUserActivity(_:perform:)"},{"type":"text","text":" view modifier."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Don’t confuse the "},{"type":"codeVoice","code":"handlesExternalEvents(matching:)"},{"type":"text","text":" scene"},{"type":"text","text":" "},{"type":"text","text":"modifier with the "},{"type":"codeVoice","code":"View\/handlesExternalEvents(preferring:allowing:)"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"view"}]},{"type":"text","text":" modifier. You use the scene modifier to help OpenSwiftUI choose a"},{"type":"text","text":" "},{"type":"text","text":"new scene to open when no open scene handles an external event,"},{"type":"text","text":" "},{"type":"text","text":"whereas you use the view modifier to indicate that an open scene can"},{"type":"text","text":" "},{"type":"text","text":"or prefers to handle certain events."}],"type":"paragraph"},{"anchor":"Matching-an-event","level":3,"type":"heading","text":"Matching an event"},{"inlineContent":[{"type":"text","text":"To find a scene type that handles a particular external event, OpenSwiftUI"},{"type":"text","text":" "},{"type":"text","text":"compares a property of the event against the strings that you specify"},{"type":"text","text":" "},{"type":"text","text":"in the "},{"type":"codeVoice","code":"conditions"},{"type":"text","text":" set. OpenSwiftUI examines the following event"},{"type":"text","text":" "},{"type":"text","text":"properties to perform the comparison:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For an"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/NSUserActivity"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"like when your app handles Handoff, OpenSwiftUI uses the activity’s"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/NSUserActivity\/3238062-targetContentIdentifier"},{"type":"text","text":" "},{"type":"text","text":"property, or if that’s "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", its"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/NSUserActivity\/1418086-webpageurl"},{"type":"text","text":" "},{"type":"text","text":"property rendered as an"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/URL\/1779984-absoluteString"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For a"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/URL"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"like when another process opens a URL that your app handles,"},{"type":"text","text":" "},{"type":"text","text":"OpenSwiftUI uses the URL’s"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/URL\/1779984-absoluteString"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"An empty set of strings never matches. Similarly, empty strings never"},{"type":"text","text":" "},{"type":"text","text":"match. Conversely, as a special case, the string that contains only an"},{"type":"text","text":" "},{"type":"text","text":"asterisk ("},{"type":"codeVoice","code":"*"},{"type":"text","text":") matches anything. The modifier performs string"},{"type":"text","text":" "},{"type":"text","text":"comparisons that are case and diacritic insensitive."}],"type":"paragraph"},{"name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"DocumentGroup"},{"type":"text","text":" scenes ignore this modifier. Instead,"},{"type":"text","text":" "},{"type":"text","text":"document scenes decide whether to open a new scene to handle an"},{"type":"text","text":" "},{"type":"text","text":"external event by comparing the incoming URL or user activity’s"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/NSUserActivity\/1418086-webpageurl"},{"type":"text","text":" "},{"type":"text","text":"against the document group’s supported types."}]}],"style":"important","type":"aside"},{"anchor":"Choosing-a-window-to-open","level":3,"type":"heading","text":"Choosing a window to open"},{"inlineContent":[{"type":"text","text":"The following example shows an app with a photo browser scene"},{"type":"text","text":" "},{"type":"text","text":"that displays a collection of photos, and a photo detail scene that"},{"type":"text","text":" "},{"type":"text","text":"enables closer examination of a particular photo:"}],"type":"paragraph"},{"code":["@main","struct MyPhotos: App {","    var body: some Scene {","        WindowGroup {","            PhotosBrowser()","        }","","        WindowGroup(\"Photo\") {","            PhotoDetail()","        }","        .handlesExternalEvents(matching: [\"photoIdentifier=\"])","    }","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The app uses the "},{"type":"codeVoice","code":"handlesExternalEvents(matching:)"},{"type":"text","text":" modifier on the"},{"type":"text","text":" "},{"type":"text","text":"second scene to ensure that an external event with an identifier"},{"type":"text","text":" "},{"type":"text","text":"that contains the string "},{"type":"codeVoice","code":"photoIdentifier="},{"type":"text","text":" creates a new scene of"},{"type":"text","text":" "},{"type":"text","text":"the second type. Other events, if not handled by an open scene,"},{"type":"text","text":" "},{"type":"text","text":"cause the creation of a new browser window instead."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/openswiftui\/scene\/handlesexternalevents(matching:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","abstract":[],"title":"OpenSwiftUI","url":"\/documentation\/openswiftui","kind":"symbol","type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scene"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","role":"symbol","abstract":[{"type":"text","text":"A part of an app’s user interface with a life cycle managed by the"},{"type":"text","text":" "},{"type":"text","text":"system."}],"title":"Scene","kind":"symbol","url":"\/documentation\/openswiftui\/scene","navigatorTitle":[{"kind":"identifier","text":"Scene"}],"type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene/handlesExternalEvents(matching:)":{"url":"\/documentation\/openswiftui\/scene\/handlesexternalevents(matching:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"handlesExternalEvents"},{"kind":"text","text":"("},{"kind":"externalParam","text":"matching"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Set","preciseIdentifier":"s:Sh"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":">) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP"}],"type":"topic","abstract":[{"type":"text","text":"Specifies the external events for which OpenSwiftUI opens a new instance"},{"type":"text","text":" "},{"type":"text","text":"of the modified scene."}],"title":"handlesExternalEvents(matching:)","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/handlesExternalEvents(matching:)"}}}