{"kind":"symbol","abstract":[{"type":"text","text":"Specifies a modifier to indicate if this Scene can be used"},{"type":"text","text":" "},{"type":"text","text":"when creating a new Scene for the received External Event."}],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"handlesExternalEvents","kind":"identifier"},{"text":"(","kind":"text"},{"text":"matching","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"conditions","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sh","text":"Set","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP"},{"text":"\n","kind":"text"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"This modifier is only supported for WindowGroup Scene types.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For DocumentGroups, the received External Event must have a URL","type":"text"},{"text":" ","type":"text"},{"text":"for the DocumentGroup to be considered. (Either via openURL, or","type":"text"},{"text":" ","type":"text"},{"text":"the webPageURL property of an NSUserActivity). The UTI for the URL","type":"text"},{"text":" ","type":"text"},{"text":"is implicitly matched against the DocumentGroup’s supported types.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If the modifier evaluates to true, an instance of the","type":"text"},{"text":" ","type":"text"},{"text":"Scene will be used.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the modifier evaluates to false, on macOS the Scene"},{"type":"text","text":" "},{"type":"text","text":"will not be used even if no other Scenes are available."},{"type":"text","text":" "},{"type":"text","text":"This case is considered an error. On iOS, the first Scene"},{"type":"text","text":" "},{"type":"text","text":"specified in the body property for the App will be used."}]},{"type":"paragraph","inlineContent":[{"text":"If no modifier is set, the Scene will be used if all","type":"text"},{"text":" ","type":"text"},{"text":"other WindowGroups with a modifier evaluate to false.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On platforms that only allow a single Window\/Scene, this method is"},{"type":"text","text":" "},{"type":"text","text":"ignored."}]}]}],"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/handlesExternalEvents(matching:)","interfaceLanguage":"swift"},"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"handlesExternalEvents"},{"kind":"text","text":"("},{"kind":"externalParam","text":"matching"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sh","text":"Set"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":">) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5SceneP","text":"Scene"}],"roleHeading":"Instance Method","role":"symbol","externalID":"s:11OpenSwiftUI5ScenePAAE21handlesExternalEvents8matchingQrShySSG_tF","modules":[{"name":"OpenSwiftUI"}],"extendedModule":"OpenSwiftUI","title":"handlesExternalEvents(matching:)","symbolKind":"method"},"variants":[{"paths":["\/documentation\/openswiftui\/scene\/handlesexternalevents(matching:)"],"traits":[{"interfaceLanguage":"swift"}]}],"