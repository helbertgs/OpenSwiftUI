{"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint"},"relationshipsSections":[{"identifiers":["doc:\/\/OpenSwiftUI\/s15BitwiseCopyableP","doc:\/\/OpenSwiftUI\/SQ","doc:\/\/OpenSwiftUI\/SH","doc:\/\/OpenSwiftUI\/s8SendableP"],"type":"conformsTo","title":"Conforms To","kind":"relationships"}],"variants":[{"paths":["\/documentation\/openswiftui\/unitpoint"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"metadata":{"roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UnitPoint"}],"navigatorTitle":[{"text":"UnitPoint","kind":"identifier"}],"role":"symbol","modules":[{"name":"OpenSwiftUI"}],"title":"UnitPoint","externalID":"s:11OpenSwiftUI9UnitPointV","symbolKind":"struct"},"topicSections":[{"generated":true,"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/init(x:y:)"],"anchor":"Initializers","title":"Initializers"},{"generated":true,"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/x","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/y"],"anchor":"Instance-Properties","title":"Instance Properties"},{"generated":true,"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/bottom","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/bottomLeading","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/bottomTrailing","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/center","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/leading","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/top","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/topLeading","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/topTrailing","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/trailing","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/zero"],"anchor":"Type-Properties","title":"Type Properties"},{"generated":true,"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/Equatable-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UnitPoint"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Use a unit point to represent a location in a view without having to know"},{"type":"text","text":" "},{"type":"text","text":"the view’s rendered size. The point stores a value in each dimension that"},{"type":"text","text":" "},{"type":"text","text":"indicates the fraction of the view’s size in that dimension — measured"},{"type":"text","text":" "},{"type":"text","text":"from the view’s origin — where the point appears. For example, you can"},{"type":"text","text":" "},{"type":"text","text":"create a unit point that represents the center of any view by using the"},{"type":"text","text":" "},{"type":"text","text":"value "},{"code":"0.5","type":"codeVoice"},{"type":"text","text":" for each dimension:"}],"type":"paragraph"},{"syntax":null,"code":["let unitPoint = UnitPoint(x: 0.5, y: 0.5)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"To project the unit point into the rendered view’s coordinate space,"},{"type":"text","text":" "},{"type":"text","text":"multiply each component of the unit point with the corresponding"},{"type":"text","text":" "},{"type":"text","text":"component of the view’s size:"}],"type":"paragraph"},{"syntax":null,"code":["let projectedPoint = CGPoint(","    x: unitPoint.x * size.width,","    y: unitPoint.y * size.height",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"You can perform this calculation yourself if you happen to know a view’s"},{"type":"text","text":" "},{"type":"text","text":"size, or if you want to use the unit point for some custom purpose, but"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI typically does this for you to carry out operations that"},{"type":"text","text":" "},{"type":"text","text":"you request, like when you:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Transform a shape using a shape modifier. For example, to rotate a"},{"type":"text","text":" "},{"type":"text","text":"shape with "},{"type":"codeVoice","code":"Shape\/rotation(_:anchor:)"},{"type":"text","text":", you indicate an anchor point"},{"type":"text","text":" "},{"type":"text","text":"that you want to rotate the shape around."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Override the alignment of the view in a "},{"type":"codeVoice","code":"Grid"},{"type":"text","text":" cell using the"},{"type":"text","text":" "},{"type":"codeVoice","code":"View\/gridCellAnchor(_:)"},{"type":"text","text":" view modifier. The grid aligns the projection"},{"type":"text","text":" "},{"type":"text","text":"of a unit point onto the view with the projection of the same unit point"},{"type":"text","text":" "},{"type":"text","text":"onto the cell."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Create a gradient that has a center, or start and stop points, relative","type":"text"},{"text":" ","type":"text"},{"text":"to the shape that you are styling. See the gradient methods in","type":"text"},{"text":" ","type":"text"},{"code":"ShapeStyle","type":"codeVoice"},{"text":".","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"You can create custom unit points with explicit values, like the example"},{"type":"text","text":" "},{"type":"text","text":"above, or you can use one of the built-in unit points that SwiftUI provides,"},{"type":"text","text":" "},{"type":"text","text":"like "},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/zero","type":"reference"},{"type":"text","text":", "},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/center","type":"reference"},{"type":"text","text":", or "},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/topTrailing","type":"reference"},{"type":"text","text":". The built-in values"},{"type":"text","text":" "},{"type":"text","text":"correspond to the alignment positions of the similarly named, built-in"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Alignment","type":"reference"},{"type":"text","text":" types."}],"type":"paragraph"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"A unit point with one or more components outside the range ","type":"text"},{"code":"[0, 1]","type":"codeVoice"},{"text":" ","type":"text"},{"text":"projects to a point outside of the view.","type":"text"}]}],"type":"aside"},{"level":3,"text":"Layout direction","anchor":"Layout-direction","type":"heading"},{"inlineContent":[{"type":"text","text":"When a person configures their device to use a left-to-right language like"},{"type":"text","text":" "},{"type":"text","text":"English, the system places the view’s origin in its top-left corner,"},{"type":"text","text":" "},{"type":"text","text":"with positive x toward the right and positive y toward the bottom of the"},{"type":"text","text":" "},{"type":"text","text":"view. In a right-to-left environment, the origin moves to the upper-right"},{"type":"text","text":" "},{"type":"text","text":"corner, and the positive x direction changes to be toward the left. You"},{"type":"text","text":" "},{"type":"text","text":"don’t typically need to do anything to handle this change, because SwiftUI"},{"type":"text","text":" "},{"type":"text","text":"applies the change to all aspects of the system. For example, see the"},{"type":"text","text":" "},{"type":"text","text":"discussion about layout direction in "},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/HorizontalAlignment","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It’s important to test your app for the different locales that you"},{"type":"text","text":" "},{"type":"text","text":"distribute your app in. For more information about the localization process,"},{"type":"text","text":" "},{"type":"text","text":"see "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Xcode\/localization"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","abstract":[{"type":"text","text":"A normalized 2D point in a view’s coordinate space."}],"references":{"doc://OpenSwiftUI/SH":{"identifier":"doc:\/\/OpenSwiftUI\/SH","type":"unresolvable","title":"Swift.Hashable"},"doc://OpenSwiftUI/s15BitwiseCopyableP":{"identifier":"doc:\/\/OpenSwiftUI\/s15BitwiseCopyableP","title":"Swift.BitwiseCopyable","type":"unresolvable"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Alignment":{"title":"Alignment","abstract":[{"text":"An alignment in both axes.","type":"text"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Alignment","kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Alignment"}],"navigatorTitle":[{"kind":"identifier","text":"Alignment"}],"url":"\/documentation\/openswiftui\/alignment"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/HorizontalAlignment":{"kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/HorizontalAlignment","navigatorTitle":[{"kind":"identifier",