{"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"navigatorTitle":[{"text":"UnitPoint","kind":"identifier"}],"externalID":"s:11OpenSwiftUI9UnitPointV","title":"UnitPoint","role":"symbol","roleHeading":"Structure","symbolKind":"struct","modules":[{"name":"OpenSwiftUI"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UnitPoint","kind":"identifier"}]},"abstract":[{"type":"text","text":"A normalized 2D point in a view’s coordinate space."}],"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"relationshipsSections":[{"kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/OpenSwiftUI\/s15BitwiseCopyableP","doc:\/\/OpenSwiftUI\/SQ","doc:\/\/OpenSwiftUI\/SH","doc:\/\/OpenSwiftUI\/s8SendableP","doc:\/\/OpenSwiftUI\/s16SendableMetatypeP"],"title":"Conforms To"}],"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/unitpoint"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UnitPoint"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a unit point to represent a location in a view without having to know"},{"type":"text","text":" "},{"type":"text","text":"the view’s rendered size. The point stores a value in each dimension that"},{"type":"text","text":" "},{"type":"text","text":"indicates the fraction of the view’s size in that dimension — measured"},{"type":"text","text":" "},{"type":"text","text":"from the view’s origin — where the point appears. For example, you can"},{"type":"text","text":" "},{"type":"text","text":"create a unit point that represents the center of any view by using the"},{"type":"text","text":" "},{"type":"text","text":"value "},{"code":"0.5","type":"codeVoice"},{"type":"text","text":" for each dimension:"}]},{"type":"codeListing","syntax":null,"code":["let unitPoint = UnitPoint(x: 0.5, y: 0.5)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To project the unit point into the rendered view’s coordinate space,"},{"type":"text","text":" "},{"type":"text","text":"multiply each component of the unit point with the corresponding"},{"type":"text","text":" "},{"type":"text","text":"component of the view’s size:"}]},{"type":"codeListing","syntax":null,"code":["let projectedPoint = CGPoint(","    x: unitPoint.x * size.width,","    y: unitPoint.y * size.height",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can perform this calculation yourself if you happen to know a view’s"},{"type":"text","text":" "},{"type":"text","text":"size, or if you want to use the unit point for some custom purpose, but"},{"type":"text","text":" "},{"type":"text","text":"OpenSwiftUI typically does this for you to carry out operations that"},{"type":"text","text":" "},{"type":"text","text":"you request, like when you:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Transform a shape using a shape modifier. For example, to rotate a","type":"text"},{"text":" ","type":"text"},{"text":"shape with ","type":"text"},{"code":"Shape\/rotation(_:anchor:)","type":"codeVoice"},{"text":", you indicate an anchor point","type":"text"},{"text":" ","type":"text"},{"text":"that you want to rotate the shape around.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Override the alignment of the view in a ","type":"text"},{"code":"Grid","type":"codeVoice"},{"text":" cell using the","type":"text"},{"text":" ","type":"text"},{"code":"View\/gridCellAnchor(_:)","type":"codeVoice"},{"text":" view modifier. The grid aligns the projection","type":"text"},{"text":" ","type":"text"},{"text":"of a unit point onto the view with the projection of the same unit point","type":"text"},{"text":" ","type":"text"},{"text":"onto the cell.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Create a gradient that has a center, or start and stop points, relative","type":"text"},{"text":" ","type":"text"},{"text":"to the shape that you are styling. See the gradient methods in","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ShapeStyle","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can create custom unit points with explicit values, like the example"},{"type":"text","text":" "},{"type":"text","text":"above, or you can use one of the built-in unit points that OpenSwiftUI provides,"},{"type":"text","text":" "},{"type":"text","text":"like "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/zero"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/center"},{"type":"text","text":", or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/topTrailing"},{"type":"text","text":". The built-in values"},{"type":"text","text":" "},{"type":"text","text":"correspond to the alignment positions of the similarly named, built-in"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Alignment"},{"type":"text","text":" types."}]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"A unit point with one or more components outside the range ","type":"text"},{"code":"[0, 1]","type":"codeVoice"},{"text":" ","type":"text"},{"text":"projects to a point outside of the view.","type":"text"}]}],"name":"Note"},{"type":"heading","anchor":"Layout-direction","level":3,"text":"Layout direction"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a person configures their device to use a left-to-right language like"},{"type":"text","text":" "},{"type":"text","text":"English, the system places the view’s origin in its top-left corner,"},{"type":"text","text":" "},{"type":"text","text":"with positive x toward the right and positive y toward the bottom of the"},{"type":"text","text":" "},{"type":"text","text":"view. In a right-to-left environment, the origin moves to the upper-right"},{"type":"text","text":" "},{"type":"text","text":"corner, and the positive x direction changes to be toward the left. You"},{"type":"text","text":" "},{"type":"text","text":"don’t typically need to do anything to handle this change, because OpenSwiftUI"},{"type":"text","text":" "},{"type":"text","text":"applies the change to all aspects of the system. For example, see the"},{"type":"text","text":" "},{"type":"text","text":"discussion about layout direction in "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/HorizontalAlignment"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It’s important to test your app for the different locales that you"},{"type":"text","text":" "},{"type":"text","text":"distribute your app in. For more information about the localization process,"},{"type":"text","text":" "},{"type":"text","text":"see "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Xcode\/localization"},{"type":"text","text":"."}]}]}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/init(x:y:)"],"anchor":"Initializers","title":"Initializers"},{"generated":true,"identifiers":["doc:\/\/OpenSwiftUI\/documen