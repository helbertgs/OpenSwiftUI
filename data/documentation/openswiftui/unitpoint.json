{"relationshipsSections":[{"identifiers":["doc:\/\/OpenSwiftUI\/s15BitwiseCopyableP","doc:\/\/OpenSwiftUI\/SQ","doc:\/\/OpenSwiftUI\/SH","doc:\/\/OpenSwiftUI\/s8SendableP","doc:\/\/OpenSwiftUI\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo","title":"Conforms To"}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"sections":[],"metadata":{"symbolKind":"struct","externalID":"s:11OpenSwiftUI9UnitPointV","role":"symbol","modules":[{"name":"OpenSwiftUI"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UnitPoint"}],"navigatorTitle":[{"text":"UnitPoint","kind":"identifier"}],"title":"UnitPoint","roleHeading":"Structure"},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UnitPoint"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a unit point to represent a location in a view without having to know"},{"type":"text","text":" "},{"type":"text","text":"the view’s rendered size. The point stores a value in each dimension that"},{"type":"text","text":" "},{"type":"text","text":"indicates the fraction of the view’s size in that dimension — measured"},{"type":"text","text":" "},{"type":"text","text":"from the view’s origin — where the point appears. For example, you can"},{"type":"text","text":" "},{"type":"text","text":"create a unit point that represents the center of any view by using the"},{"type":"text","text":" "},{"type":"text","text":"value "},{"code":"0.5","type":"codeVoice"},{"type":"text","text":" for each dimension:"}]},{"type":"codeListing","code":["let unitPoint = UnitPoint(x: 0.5, y: 0.5)"],"syntax":null},{"type":"paragraph","inlineContent":[{"text":"To project the unit point into the rendered view’s coordinate space,","type":"text"},{"text":" ","type":"text"},{"text":"multiply each component of the unit point with the corresponding","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"component of the view’s size:"}]},{"type":"codeListing","code":["let projectedPoint = CGPoint(","    x: unitPoint.x * size.width,","    y: unitPoint.y * size.height",")"],"syntax":null},{"type":"paragraph","inlineContent":[{"text":"You can perform this calculation yourself if you happen to know a view’s","type":"text"},{"text":" ","type":"text"},{"text":"size, or if you want to use the unit point for some custom purpose, but","type":"text"},{"text":" ","type":"text"},{"text":"OpenSwiftUI typically does this for you to carry out operations that","type":"text"},{"text":" ","type":"text"},{"text":"you request, like when you:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Transform a shape using a shape modifier. For example, to rotate a","type":"text"},{"text":" ","type":"text"},{"text":"shape with ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Shape\/rotation(_:anchor:)","isActive":true,"type":"reference"},{"type":"text","text":", you indicate an anchor point"},{"type":"text","text":" "},{"text":"that you want to rotate the shape around.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Override the alignment of the view in a ","type":"text"},{"code":"Grid","type":"codeVoice"},{"text":" cell using the","type":"text"},{"text":" ","type":"text"},{"code":"View\/gridCellAnchor(_:)","type":"codeVoice"},{"text":" view modifier. The grid aligns the projection","type":"text"},{"text":" ","type":"text"},{"text":"of a unit point onto the view with the projection of the same unit point","type":"text"},{"text":" ","type":"text"},{"text":"onto the cell.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Create a gradient that has a center, or start and stop points, relative","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"to the shape that you are styling. See the gradient methods in"},{"type":"text","text":" "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ShapeStyle","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can create custom unit points with explicit values, like the example"},{"type":"text","text":" "},{"type":"text","text":"above, or you can use one of the built-in unit points that OpenSwiftUI provides,"},{"type":"text","text":" "},{"type":"text","text":"like "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/zero","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/center","type":"reference","isActive":true},{"type":"text","text":", or "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/topTrailing","type":"reference","isActive":true},{"type":"text","text":". The built-in values"},{"type":"text","text":" "},{"type":"text","text":"correspond to the alignment positions of the similarly named, built-in"},{"type":"text","text":" "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Alignment","type":"reference","isActive":true},{"type":"text","text":" types."}]},{"type":"aside","content":[{"inlineContent":[{"text":"A unit point with one or more components outside the range ","type":"text"},{"type":"codeVoice","code":"[0, 1]"},{"type":"text","text":" "},{"type":"text","text":"projects to a point outside of the view."}],"type":"paragraph"}],"style":"note","name":"Note"},{"type":"heading","text":"Layout direction","level":3,"anchor":"Layout-direction"},{"inlineContent":[{"type":"text","text":"When a person configures their device to use a left-to-right language like"},{"type":"text","text":" "},{"type":"text","text":"English, the system places the view’s origin in its top-left corner,"},{"type":"text","text":" "},{"type":"text","text":"with positive x toward the right and positive y toward the bottom of the"},{"type":"text","text":" "},{"type":"text","text":"view. In a right-to-left environment, the origin moves to the upper-right"},{"type":"text","text":" "},{"type":"text","text":"corner, and the positive x direction changes to be toward the left. You"},{"type":"text","text":" "},{"type":"text","text":"don’t typically need to do anything to handle this change, because OpenSwiftUI"},{"type":"text","text":" "},{"text":"applies the change to all aspects of the system. For example, see the","type":"text"},{"text":" ","type":"text"},{"text":"discussion about layout direction in ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/HorizontalAlignment","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It’s important to test your app for the different locales that you"},{"type":"text","text":" "},{"type":"text","text":"distribute your app in. For more information about the localization process,"},{"type":"text","text":" "},{"type":"text","text":"see "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Xcode\/localization"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/unitpoint"]}],"kind":"symbol","abstract":[{"type":"text","text":"A normalized 2D point in a view’s coordinate space."}],"topicSections":[{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/init(x:y:)"],"anchor":"Initializers","generated":true,"title":"Initializers"},{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/x","doc:\/\/OpenSwiftUI\