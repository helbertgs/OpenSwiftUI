{"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/OpenSwiftUI\/s15BitwiseCopyableP","doc:\/\/OpenSwiftUI\/SQ","doc:\/\/OpenSwiftUI\/SH","doc:\/\/OpenSwiftUI\/s8SendableP"]}],"topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/init(x:y:)"]},{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/x","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/y"]},{"generated":true,"anchor":"Type-Properties","title":"Type Properties","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/bottom","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/bottomLeading","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/bottomTrailing","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/center","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/leading","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/top","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/topLeading","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/topTrailing","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/trailing","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/zero"]},{"generated":true,"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/Equatable-Implementations"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/unitpoint"]}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"abstract":[{"text":"A normalized 2D point in a view’s coordinate space.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UnitPoint"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Use a unit point to represent a location in a view without having to know","type":"text"},{"text":" ","type":"text"},{"text":"the view’s rendered size. The point stores a value in each dimension that","type":"text"},{"text":" ","type":"text"},{"text":"indicates the fraction of the view’s size in that dimension — measured","type":"text"},{"text":" ","type":"text"},{"text":"from the view’s origin — where the point appears. For example, you can","type":"text"},{"text":" ","type":"text"},{"text":"create a unit point that represents the center of any view by using the","type":"text"},{"text":" ","type":"text"},{"text":"value ","type":"text"},{"type":"codeVoice","code":"0.5"},{"text":" for each dimension:","type":"text"}]},{"syntax":null,"type":"codeListing","code":["let unitPoint = UnitPoint(x: 0.5, y: 0.5)"]},{"type":"paragraph","inlineContent":[{"text":"To project the unit point into the rendered view’s coordinate space,","type":"text"},{"text":" ","type":"text"},{"text":"multiply each component of the unit point with the corresponding","type":"text"},{"text":" ","type":"text"},{"text":"component of the view’s size:","type":"text"}]},{"syntax":null,"type":"codeListing","code":["let projectedPoint = CGPoint(","    x: unitPoint.x * size.width,","    y: unitPoint.y * size.height",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can perform this calculation yourself if you happen to know a view’s"},{"type":"text","text":" "},{"type":"text","text":"size, or if you want to use the unit point for some custom purpose, but"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI typically does this for you to carry out operations that"},{"type":"text","text":" "},{"type":"text","text":"you request, like when you:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Transform a shape using a shape modifier. For example, to rotate a"},{"type":"text","text":" "},{"type":"text","text":"shape with "},{"type":"codeVoice","code":"Shape\/rotation(_:anchor:)"},{"type":"text","text":", you indicate an anchor point"},{"type":"text","text":" "},{"type":"text","text":"that you want to rotate the shape around."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Override the alignment of the view in a "},{"code":"Grid","type":"codeVoice"},{"type":"text","text":" cell using the"},{"type":"text","text":" "},{"code":"View\/gridCellAnchor(_:)","type":"codeVoice"},{"type":"text","text":" view modifier. The grid aligns the projection"},{"type":"text","text":" "},{"type":"text","text":"of a unit point onto the view with the projection of the same unit point"},{"type":"text","text":" "},{"type":"text","text":"onto the cell."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Create a gradient that has a center, or start and stop points, relative"},{"type":"text","text":" "},{"type":"text","text":"to the shape that you are styling. See the gradient methods in"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ShapeStyle"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can create custom unit points with explicit values, like the example"},{"type":"text","text":" "},{"type":"text","text":"above, or you can use one of the built-in unit points that SwiftUI provides,"},{"type":"text","text":" "},{"type":"text","text":"like "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/zero","isActive":true,"type":"reference"},{"type":"text","text":", "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/center","isActive":true,"type":"reference"},{"type":"text","text":", or "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/topTrailing","isActive":true,"type":"reference"},{"type":"text","text":". The built-in values"},{"type":"text","text":" "},{"type":"text","text":"correspond to the alignment positions of the similarly named, built-in"},{"type":"text","text":" "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Alignment","isActive":true,"type":"reference"},{"type":"text","text":" types."}]},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A unit point with one or more components outside the range "},{"type":"codeVoice","code":"[0, 1]"},{"type":"text","text":" "},{"type":"text","text":"projects to a point outside of the view."}]}],"type":"aside","name":"Note"},{"text":"Layout direction","level":3,"anchor":"Layout-direction","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a person configures their device to use a left-to-right language like"},{"type":"text","text":" "},{"type":"text","text":"English, the system places the view’s origin in its top-left corner,"},{"type":"text","text":" "},{"type":"text","text":"with positive x toward the right and positive y toward the bottom of the"},{"type":"text","text":" "},{"type":"text","text":"view. In a right-to-left environment, the origin moves to the upper-right"},{"type":"text","text":" "},{"type":"text","text":"corner, and the positive x direction changes to be toward the left. You"},{"type":"text","text":" "},{"type":"text","text":"don’t typically need to do anything to handle this change, because SwiftUI"},{"type":"text","text":" "},{"type":"text","text":"applies the change to all aspects of the system. For example, see the"},{"type":"text","text":" "},{"type":"text","text":"discussion about layout direction in "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/HorizontalAlignment"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"It’s important to test your app for the different locales that you","type":"text"},{"text":" ","type":"text"},{"text":"distribute your app in. For more information about the localization process,","type":"text"},{"text":" ","type":"text"},{"text":"see ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Xcode\/localization","type":"text"},{"text":".","type":"text"}]}]}],"metadata":{"navigatorTitle":[{"kind":"identifier","text":"UnitPoint"}],"title":"UnitPoint","symbolKind":"struct","modules":[{"name":"OpenSwiftUI"}],"role":"symbol","externalID":"s:11OpenSwiftUI9UnitPointV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UnitPoint"}],"roleHeading":"Structure"},"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint","interfaceLanguage":"swift"},"kind":"symbol","sections":[],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/UnitPoint/y":{"title":"y","kind":"symbol","role":"symbol","url":"\/documentation\/openswiftui\/unitpoint\/y","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"y"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sf","text":"Float"}],"type":"topic","abstract":[{"type":"text","text":"The normalized distance from the origin to the point in the vertical"},{"type":"text","text":" "},{"type":"text","text":"dimension."}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/y"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Alignment":{"url":"\/documentation\/openswiftui\/alignment","role":"symbol","type":"topic","navigatorTitle":[{"text":"Alignment","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSw