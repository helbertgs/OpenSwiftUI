ement { content, context in","            let displayBounds = context.defaultDisplay.visibleRect","            let proposal = ProposedViewSize(","                width: nil, height: displayBounds.height)","            let contentSize = content.sizeThatFits(proposal)","            return .init(","                width: contentSize.width,","                height: contentSize.height)","        }","    }","}"],"syntax":null,"type":"codeListing"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/openswiftui\/scenemodifier_content\/windowidealplacement(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","abstract":[{"text":"Provides a function which determines a placement to use when windows","type":"text"},{"text":" ","type":"text"},{"text":"of a scene zoom.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneModifier_Content\/windowIdealPlacement(_:)"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/WindowLayoutRoot":{"url":"\/documentation\/openswiftui\/windowlayoutroot","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowLayoutRoot","title":"WindowLayoutRoot","role":"symbol","type":"topic","abstract":[{"text":"A proxy which represents the root contents of a window.","type":"text"}],"kind":"symbol","navigatorTitle":[{"text":"WindowLayoutRoot","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WindowLayoutRoot","kind":"identifier"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/WindowPlacement":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WindowPlacement"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowPlacement","role":"symbol","abstract":[{"type":"text","text":"A type which represents a preferred size and position for a window."}],"title":"WindowPlacement","url":"\/documentation\/openswiftui\/windowplacement","kind