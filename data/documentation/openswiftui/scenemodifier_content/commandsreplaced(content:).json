hat they include by default. Apply this modifier to a"},{"type":"text","text":" "},{"type":"text","text":"scene to replace those commands with the output from the given builder."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, the following code adds a scene for showing the contents of"},{"type":"text","text":" "},{"text":"the pasteboard in a dedicated window. We replace the scene’s default","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Window > Clipboard menu command with a custom Edit > Show Clipboard"},{"text":" ","type":"text"},{"type":"text","text":"command that we place next to the other pasteboard commands."}]},{"code":["@main","struct Example: App {","    @Environment(\\.openWindow) var openWindow","","    var body: some Scene {","        ...","","        Window(\"Clipboard\", id: \"clipboard\") {","            ClipboardContentView()","        }","        .commandsReplaced {","            CommandGroup(after: .pasteboard) {","                Section {","                    Button(\"Show Clipboard\") {","                        openWindow(id: \"clipboard\")","                    }","                }","            }","        }","    }","}"],"syntax":null,"type":"codeListing"}],"kind":"content"}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene":{"navigatorTitle":[{"kind":"identifier","text":"Scene"}],"title":"Scene","role":"symbol","type":"topic","url":"\/documentation\/openswiftui\/scene","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scene"}],"abstract":[{"text":"A part of an app’s user interface with a life cycle managed by the","type":"text"},{"text":" ","type":"text"},{"text":"system.","type":"text"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Commands":{"navigatorTitle":[{"kind":"identifier","text":"Commands"}],"title":"Commands","role":"symbol",