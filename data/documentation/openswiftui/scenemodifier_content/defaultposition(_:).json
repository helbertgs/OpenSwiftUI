{"sections":[],"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneModifier_Content\/defaultPosition(_:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneModifier_Content"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultPosition","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"kind":"internalParam","text":"position"},{"kind":"text","text":": "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI9UnitPointV","text":"UnitPoint"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"text":" ","kind":"text"},{"text":"Scene","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5SceneP"},{"text":"\n","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"position","content":[{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint","isActive":true},{"type":"text","text":" that specifies where to place a"},{"type":"text","text":" "},{"type":"text","text":"newly opened window relative to the screen bounds."}],"type":"paragraph"}]}]},{"content":[{"text":"Return Value","type":"heading","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"text":"A scene that uses a default position for new windows.","type":"text"}]}],"kind":"content"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"The first time your app opens a window from a particular scene","type":"text"},{"text":" ","type":"text"},{"text":"declaration, the system places the window at the center of the screen by","type":"text"},{"text":" ","type":"text"},{"text":"default. For scene types that support multiple simultaneous windows, the","type":"text"},{"text":" ","type":"text"},{"text":"system offsets each additional window by a small amount to avoid","type":"text"},{"text":" ","type":"text"},{"text":"completely obscuring existing windows.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You can override the default placement of the first window by","type":"text"},{"text":" ","type":"text"},{"text":"applying a scene modifier that indicates where to place the window","type":"text"},{"text":" ","type":"text"},{"text":"relative to the screen bounds. For example, you can request that the","type":"text"},{"text":" ","type":"text"},{"text":"system place a new window in the bottom trailing corner of the screen:","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["@main","struct MyApp: App {","    var body: some Scene {","        WindowGroup {","            ContentView()","        }","        .defaultPosition(.bottomTrailing)","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The system aligns the point in the window that corresponds to the","type":"text"},{"text":" ","type":"text"},{"text":"specified ","type":"text"},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint","isActive":true},{"text":" with the point in the screen that corresponds","type":"text"},{"text":" ","type":"text"},{"text":"to the same unit point.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You typically use one of the predefined unit points — like","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/bottomTrailing","isActive":true},{"text":" in the above example — but","type":"text"},{"text":" ","type":"text"},{"text":"you can also use a custom unit point. For example, the following","type":"text"},{"text":" ","type":"text"},{"text":"modifier aligns the point that’s one quarter of the way from the","type":"text"},{"text":" ","type":"text"},{"text":"leading edge of the window with the point that’s one quarter of","type":"text"},{"text":" ","type":"text"},{"text":"the way from the leading edge of the screen, while centering the","type":"text"},{"text":" ","type":"text"},{"text":"window in the y-dimension:","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["WindowGroup {","    ContentView()","}",".defaultPosition(UnitPoint(x: 0.25, y: 0.5))"],"type":"codeListing"},{"inlineContent":[{"text":"The modifier affects any scene type that creates windows in Windows,","type":"text"},{"text":" ","type":"text"},{"text":"namely:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup","isActive":true,"type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"DocumentGroup","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Settings","isActive":true}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The value that you provide acts only as an initial default. During state","type":"text"},{"text":" ","type":"text"},{"text":"restoration, the system restores the window to the position that it","type":"text"},{"text":" ","type":"text"},{"text":"last occupied.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultPosition","kind":"identifier"},{"text":"(","kind":"text"},{"text":"UnitPoint","preciseIdentifier":"s:11OpenSwiftUI9UnitPointV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP","kind":"typeIdentifier"}],"externalID":"s:11OpenSwiftUI5ScenePAAE15defaultPositionyQrAA9UnitPointVF::SYNTHESIZED::s:11OpenSwiftUI21SceneModifier_ContentV","title":"defaultPosition(_:)","role":"symbol","roleHeading":"Instance Method","symbolKind":"method","modules":[{"name":"OpenSwiftUI"}],"extendedModule":"OpenSwiftUI"},"kind":"symbol","abstract":[{"type":"text","text":"Sets a default position for a window."}],"variants":[{"paths":["\/documentation\/openswiftui\/scenemodifier_content\/defaultposition(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Settings":{"type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Settings"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Settings","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Settings"}],"abstract":[{"text":"A scene that presents an interface for viewing and modifying an app’s","type":"text"},{"text":" ","type":"text"},{"text":"settings.","type":"text"}],"url":"\/documentation\/openswiftui\/settings","title":"Settings","kind":"symbol"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/WindowGroup":{"navigatorTitle":[{"kind":"identifier","text":"WindowGroup"}],"title":"WindowGroup","role":"symbol","type":"topic","url":"\/documentation\/openswiftui\/windowgroup","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WindowGroup"}],"abstract":[{"text":"A scene that presents a group of identically structured windows.","type":"text"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene":{"navigatorTitle":[{"kind":"identifier","text":"Scene"}],"title":"Scene","role":"symbol","type":"topic","url":"\/documentation\/openswiftui\/scene","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scene"}],"abstract":[{"text":"A part of an app’s user interface with a life cycle managed by the","type":"text"},{"text":" ","type":"text"},{"text":"system.","type":"text"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/UnitPoint":{"navigatorTitle":[{"kind":"identifier","text":"UnitPoint"}],"title":"UnitPoint","role":"symbol","type":"topic","url":"\/documentation\/openswiftui\/unitpoint","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UnitPoint"}],"abstract":[{"text":"A normalized 2D point in a view’s coordinate space.","type":"text"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/SceneModifier_Content":{"title":"SceneModifier_Content","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneModifier_Content","type":"topic","url":"\/documentation\/openswiftui\/scenemodifier_content","navigatorTitle":[{"text":"SceneModifier_Content","kind":"identifier"}],"abstract":[],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SceneModifier_Content","kind":"identifier"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"title":"OpenSwiftUI","url":"\/documentation\/openswiftui","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","kind":"symbol","abstract":[]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/SceneModifier_Content/defaultPosition(_:)":{"title":"defaultPosition(_:)","ro