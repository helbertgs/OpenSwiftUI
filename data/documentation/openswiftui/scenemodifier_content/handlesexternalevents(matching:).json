{"metadata":{"symbolKind":"method","externalID":"s:11OpenSwiftUI5ScenePAAE21handlesExternalEvents8matchingQrShySSG_tF::SYNTHESIZED::s:11OpenSwiftUI21SceneModifier_ContentV","extendedModule":"OpenSwiftUI","title":"handlesExternalEvents(matching:)","modules":[{"name":"OpenSwiftUI"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"handlesExternalEvents","kind":"identifier"},{"text":"(","kind":"text"},{"text":"matching","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Set","kind":"typeIdentifier","preciseIdentifier":"s:Sh"},{"text":"<","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":">) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5SceneP"}],"role":"symbol","roleHeading":"Instance Method"},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneModifier_Content"]]},"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"Specifies the external events for which OpenSwiftUI opens a new instance"},{"type":"text","text":" "},{"type":"text","text":"of the modified scene."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"handlesExternalEvents","kind":"identifier"},{"text":"(","kind":"text"},{"text":"matching","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"conditions","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Set","kind":"typeIdentifier","preciseIdentifier":"s:Sh"},{"text":"<","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":">) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5SceneP"},{"text":"\n","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"parameters":[{"name":"conditions","content":[{"type":"paragraph","inlineContent":[{"text":"A set of strings that OpenSwiftUI compares against","type":"text"},{"text":" ","type":"text"},{"text":"the incoming user activity or URL to see if OpenSwiftUI","type":"text"},{"text":" ","type":"text"},{"text":"can open a new scene instance to handle the external event.","type":"text"}]}]}],"kind":"parameters"},{"content":[{"text":"Return Value","type":"heading","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A scene type that limits the kinds of external events for"},{"type":"text","text":" "},{"type":"text","text":"which OpenSwiftUI opens a new instance."}]}],"kind":"content"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"When your app receives an external event like a user activity or a","type":"text"},{"text":" ","type":"text"},{"text":"URL, OpenSwiftUI routes the event to a scene for processing. OpenSwiftUI","type":"text"},{"text":" ","type":"text"},{"text":"selects the scene that receives the event according to the following","type":"text"},{"text":" ","type":"text"},{"text":"rules, which it evaluates in order until it finds a destination scene:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"On platforms that support only a single scene per app, send","type":"text"},{"text":" ","type":"text"},{"text":"the event to the one open scene.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Find an open scene that indicates it prefers to or can handle the"},{"type":"text","text":" "},{"type":"text","text":"event, if any, and send the event to that scene. You use the"},{"type":"text","text":" "},{"code":"View\/handlesExternalEvents(preferring:allowing:)","type":"codeVoice"},{"type":"text","text":" view modifier"},{"type":"text","text":" "},{"type":"text","text":"on a view inside the scene to register this preference."}]}]},{"content":[{"inlineContent":[{"text":"Find a scene declaration with a ","type":"text"},{"type":"codeVoice","code":"handlesExternalEvents(matching:)"},{"text":" ","type":"text"},{"text":"scene modifier containing ","type":"text"},{"type":"codeVoice","code":"conditions"},{"text":" that match the external event.","type":"text"},{"text":" ","type":"text"},{"text":"Create a new instance of the first scene that matches and route the","type":"text"},{"text":" ","type":"text"},{"text":"event there.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Find the first scene declaration that doesn’t have the scene modifier.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Create a new instance of this scene and route the event there."}]}]}]},{"inlineContent":[{"text":"Make sure that at least one of these rules succeeds in your app for all","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"events that your app claims to handle. Also, make sure"},{"text":" ","type":"text"},{"text":"that the scene that receives an event actually handles it. For example,","type":"text"},{"text":" ","type":"text"},{"text":"be sure that a scene that receives user activities handles them with an","type":"text"},{"text":" ","type":"text"},{"text":"appropriate ","type":"text"},{"type":"codeVoice","code":"View\/onContinueUserActivity(_:perform:)"},{"text":" view modifier.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Don’t confuse the ","type":"text"},{"code":"handlesExternalEvents(matching:)","type":"codeVoice"},{"text":" scene","type":"text"},{"type":"text","text":" "},{"type":"text","text":"modifier with the "},{"type":"codeVoice","code":"View\/handlesExternalEvents(preferring:allowing:)"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"view","type":"text"}]},{"text":" modifier. You use the scene modifier to help OpenSwiftUI choose a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"new scene to open when no open scene handles an external event,"},{"type":"text","text":" "},{"type":"text","text":"whereas you use the view modifier to indicate that an open scene can"},{"type":"text","text":" "},{"type":"text","text":"or prefers to handle certain events."}]},{"level":3,"text":"Matching an event","anchor":"Matching-an-event","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To find a scene type that handles a particular external event, OpenSwiftUI"},{"type":"text","text":" "},{"type":"text","text":"compares a property of the event against the strings that you specify"},{"type":"text","text":" "},{"type":"text","text":"in the "},{"type":"codeVoice","code":"conditions"},{"type":"text","text":" set. OpenSwiftUI examines the following event"},{"type":"text","text":" "},{"type":"text","text":"properties to perform the comparison:"}]},{"items":[{"content":[{"inlineContent":[{"text":"For an","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/NSUserActivity","type":"text"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"like when your app handles Handoff, OpenSwiftUI uses the activity’s","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/NSUserActivity\/3238062-targetContentIdentifier","type":"text"},{"text":" ","type":"text"},{"text":"property, or if that’s ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":", its","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/NSUserActivity\/1418086-webpageurl","type":"text"},{"text":" ","type":"text"},{"text":"property rendered as an","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/URL\/1779984-absoluteString","type":"text"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For a"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/URL"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"like when another process opens a URL that your app handles,"},{"type":"text","text":" "},{"type":"text","text":"OpenSwiftUI uses the URL’s"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/URL\/1779984-absoluteString"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An empty set of strings never matches. Similarly, empty strings never"},{"type":"text","text":" "},{"type":"text","text":"match. Conversely, as a special case, the string that contains only an"},{"type":"text","text":" "},{"type":"text","text":"asterisk ("},{"type":"codeVoice","code":"*"},{"type":"text","text":") matches anything. The modifier performs string"},{"type":"text","text":" "},{"type":"text","text":"comparisons that are case and diacritic insensitive."}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"DocumentGroup","type":"codeVoice"},{"text":" scenes ignore this modifier. Instead,","type":"text"},{"text":" ","type":"text"},{"text":"document scenes decide whether to open a new scene to handle an","type":"text"},{"text":" ","type":"text"},{"text":"external event by comparing the incoming URL or user activity’s","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/NSUserActivity\/1418086-webpageurl","type":"text"},{"text":" ","type":"text"},{"text":"against the document group’s supported types.","type":"text"}]}],"type":"aside","style":"important","name":"Important"},{"text":"Choosing a window to open","level":3,"anchor":"Choosing-a-window-to-open","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example shows an app with a photo browser scene"},{"type":"text","text":" "},{"type":"text","text":"that displays a collection of photos, and a photo detail scene that"},{"type":"text","text":" "},{"type":"text","text":"enables closer examination of a particular photo:"}]},{"code":["@main","struct MyPhotos: App {","    var body: some Scene {","        WindowGroup {","            PhotosBrowser()","        }","","        WindowGroup(\"Photo\") {","            PhotoDetail()","        }","        .handlesExternalEvents(matching: [\"photoIdentifier=\"])","    }","}"],"syntax":null,"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The app uses the "},{"type":"codeVoice","code":"handlesExternalEvents(matching:)"},{"type":"text","text":" modifier on the"},{"type":"text","text":" "},{"type":"text","text":"second scene to ensure that an external event with an identifier"},{"type":"text","text":" "},{"type":"text","text":"that contains the string "},{"type":"codeVoice","code":"photoIdentifier="},{"type":"text","text":" creates a new scene of"},{"type":"text","text":" "},{"type":"text","text":"the second type. Other events, if not handled by an open scene,"},{"type":"text","text":" "},{"type":"text","text":"cause the creation of a new browser window instead."}]}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneModifier_Content\/handlesExternalEvents(matching:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/scenemodifier_content\/handlesexternalevents(matching:)"]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/SceneModifier_Content/handlesExternalEvents(matching:)":{"abstract":[{"text":"Specifies the external events for which OpenSwiftUI opens a new instance","type":"text"},{"text":" ","type":"text"},{"text":"of the modified scene.","type":"text"}],"url":"\/documentation\/openswiftui\/scenemodifier_content\/handlesexternalevents(matching:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"handlesExternalEvents"},{"kind":"text","text":"("},{"kind":"externalParam","text":"matching"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sh","kind":"typeIdentifier","text":"Set"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":">) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","kind":"typeIdentifier","text":"Scene"}],"title":"handlesExternalEvents(matching:)","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneModifier_Content\/handlesExternalEvents(matching:)","role":"symbol"},"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"title":"OpenSwiftUI","url":"\/documentation\/openswiftui","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","kind":"symbol","abstract":[]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene":{"navigatorTitle":[{"kind":"identifier","text":"Scene"}],"title":"Scene","role":"symbol","type":"topic","url":"\/documentation\/openswiftui\/scene","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scene"}],"abstract":[{"text":"A part of an app’s user interface with a life cycle managed by the","type":"text"},{"text":" ","type":"text"},{"text":"system.","type":"text"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/SceneModifier_Content":{"title":"SceneModifier_Content","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneModifier_Content","type":"topic","url":"\/documentation\/openswiftui\/scenemodifier_content","navigatorTitle":[{"text":"SceneModifier_Content","kind":"identifier"}],"abstract":[],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SceneModifier_Content","kind":"identifier"}]}}}