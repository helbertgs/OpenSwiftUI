{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/scenemodifier_content\/defaultwindowplacement(_:)"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultWindowPlacement","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"makePlacement","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"@escaping ","kind":"attribute"},{"text":"(","kind":"text"},{"text":"WindowLayoutRoot","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowLayoutRoot","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI16WindowLayoutRootV"},{"text":", ","kind":"text"},{"text":"WindowPlacementContext","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowPlacementContext","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI22WindowPlacementContextV"},{"text":") -> ","kind":"text"},{"text":"WindowPlacement","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowPlacement","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI15WindowPlacementV"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5SceneP"},{"text":"\n","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A closure to generate the default window placement."}]}],"name":"makePlacement"}],"kind":"parameters"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this scene modifier to indicate a default initial size and position"},{"type":"text","text":" "},{"type":"text","text":"for a new window that the system creates from a "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","isActive":true},{"type":"text","text":" declaration."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On Windows, you can use the screen’s bounds to place the window."},{"type":"text","text":" "},{"type":"text","text":"For example, you can specify that the window is always placed 140"},{"type":"text","text":" "},{"type":"text","text":"points from the bottom of the screen:"}]},{"syntax":null,"type":"codeListing","code":["struct MyApp: App {","    var body: some Scene {","        ...","","        Window(\"Status\", id: \"status\") {","            StatusView()","        }","        .windowResizability(.contentSize)","        .defaultWindowPlacement { content, context in","            let displayBounds = context.defaultDisplay.visibleRect","            let size = content.sizeThatFits(.unspecified)","            let position = CGPoint(","                x: displayBounds.midX - (size.width \/ 2),","                y: displayBounds.maxY - size.height - 140)","            return WindowPlacement(position: position, size: size)","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On visionOS, the system always places the first window"},{"type":"text","text":" "},{"type":"text","text":"relative to where the person is looking."},{"type":"text","text":" "},{"type":"text","text":"The system ignores calls to "},{"type":"codeVoice","code":"defaultWindowPlacement(_:)"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can place any subsequent windows relative to existing ones by"},{"type":"text","text":" "},{"type":"text","text":"returning one of the methods defined by "},{"type":"codeVoice","code":"WindowPlacement\/Position"},{"type":"text","text":" "},{"type":"text","text":"with the existing window."},{"type":"text","text":" "},{"type":"text","text":"For example, you can align the new window with the trailing edge of"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"Content"},{"type":"text","text":" window:"}]},{"syntax":null,"type":"codeListing","code":["struct MyApp: App {","    @Environment(\\.openWindow) private var openWindow","","    var body: some Scene {","        WindowGroup(\"Content\", id: \"content\") {","            Button(\"Open status window\") {","                openWindow(id: \"status\")","            }","        }","","        WindowGroup(\"Status\", id: \"status\") {","            StatusView()","        }","        .windowResizability(.contentSize)","        .defaultWindowPlacement { content, context in","            if let contentWindow = context.windows.first(","            where: { $0.id == \"content\" }) {","                WindowPlacement(.trailing(contentWindow))","            } else {","                WindowPlacement()","            }","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The placement that your function returns acts as a default for when the"},{"type":"text","text":" "},{"type":"text","text":"window first appears. People can later resize and move the window using"},{"type":"text","text":" "},{"type":"text","text":"interface controls that the system provides. Also, during state"},{"type":"text","text":" "},{"type":"text","text":"restoration, the system restores the window to it’s most recent size and"},{"type":"text","text":" "},{"type":"text","text":"position, rather than the default placement."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For more information on configuring how scenes behave with"},{"type":"text","text":" "},{"type":"text","text":"state restoration, see "},{"type":"codeVoice","code":"Scene.stateRestoration(_:)"},{"type":"text","text":"."}]}],"kind":"content"}],"sections":[],"metadata":{"symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultWindowPlacement","kind":"identifier"},{"text":"((","kind":"text"},{"text":"WindowLayoutRoot","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI16WindowLayoutRootV"},{"text":", ","kind":"text"},{"text":"WindowPlacementContext","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI22WindowPlacementContextV"},{"text":") -> ","kind":"text"},{"text":"WindowPlacement","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI15WindowPlacementV"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5SceneP"}],"modules":[{"name":"OpenSwiftUI"}],"externalID":"s:11OpenSwiftUI5ScenePAAE22defaultWindowPlacementyQrAA0fG0VAA0F10LayoutRootV_AA0fG7ContextVtcF::SYNTHESIZED::s:11OpenSwiftUI21SceneModifier_ContentV","extendedModule":"OpenSwiftUI","roleHeading":"Instance Method","title":"defaultWindowPlacement(_:)","role":"symbol"},"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneModifier_Content"]]},"abstract":[{"type":"text","text":"Defines a function used for determining the default placement"},{"type":"text","text":" "},{"type":"text","text":"of windows."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneModifier_Content\/defaultWindowPlacement(_:)"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","type":"topic","kind":"symbol","abstract":[],"title":"OpenSwiftUI","url":"\/documentation\/openswiftui"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/WindowPlacement":{"abstract":[{"type":"text","text":"A type which r