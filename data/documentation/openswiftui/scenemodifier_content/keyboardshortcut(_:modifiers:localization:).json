{"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneModifier_Content\/keyboardShortcut(_:modifiers:localization:)","interfaceLanguage":"swift"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneModifier_Content"]]},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"keyboardShortcut"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"key"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI13KeyEquivalentV","text":"KeyEquivalent","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyEquivalent"},{"kind":"text","text":", "},{"text":"modifiers","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI14EventModifiersV","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EventModifiers","text":"EventModifiers","kind":"typeIdentifier"},{"text":" = .command, ","kind":"text"},{"text":"localization","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI16KeyboardShortcutV","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyboardShortcut","text":"KeyboardShortcut","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI16KeyboardShortcutV12LocalizationV","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyboardShortcut\/Localization-swift.struct","text":"Localization","kind":"typeIdentifier"},{"text":" = .automatic) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","text":"Scene","kind":"typeIdentifier"},{"text":"\n","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The key equivalent the user presses to present the scene."}]}],"name":"key"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The modifier keys required to perform the shortcut."}]}],"name":"modifiers"},{"name":"localization","content":[{"inlineContent":[{"type":"text","text":"The localization style to apply to the shortcut."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","anchor":"return-value","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A scene that can be presented with a keyboard shortcut."}]}]},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"A scene’s keyboard shortcut is bound to the command it adds for creating"},{"type":"text","text":" "},{"type":"text","text":"new windows (in the case of "},{"type":"codeVoice","code":"WindowGroup"},{"type":"text","text":" and "},{"type":"codeVoice","code":"DocumentGroup"},{"type":"text","text":") or"},{"type":"text","text":" "},{"type":"text","text":"bringing a singleton window forward (in the case of "},{"type":"codeVoice","code":"Window"},{"type":"text","text":" and, on"},{"type":"text","text":" "},{"type":"text","text":"Windows, "},{"type":"codeVoice","code":"Settings"},{"type":"text","text":"). Pressing the keyboard shortcut is equivalent to"},{"type":"text","text":" "},{"type":"text","text":"selecting the menu command."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In cases where a command already has a keyboard shortcut, the scene’s"},{"type":"text","text":" "},{"type":"text","text":"keyboard shortcut is used instead. For example, "},{"type":"codeVoice","code":"WindowGroup"},{"type":"text","text":" normally"},{"type":"text","text":" "},{"type":"text","text":"creates a File > New Window menu command whose keyboard shortcut is"},{"type":"text","text":" "},{"type":"codeVoice","code":"⌘N"},{"type":"text","text":". The following code changes it to "},{"type":"codeVoice","code":"⌥⌘N"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["WindowGroup {","    ContentView()","}",".keyboardShortcut(\"n\", modifiers: [.option, .command])"]},{"anchor":"Localization","type":"heading","text":"Localization","level":3},{"inlineContent":[{"type":"text","text":"Provide a "},{"type":"codeVoice","code":"localization"},{"type":"text","text":" value to specify how this shortcut"},{"type":"text","text":" "},{"type":"text","text":"should be localized."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Given that "},{"type":"codeVoice","code":"key"},{"type":"text","text":" is always defined in relation to the US-English"},{"type":"text","text":" "},{"type":"text","text":"keyboard layout, it might be hard to reach on different international"},{"type":"text","text":" "},{"type":"text","text":"layouts. For example the shortcut "},{"type":"codeVoice","code":"⌘["},{"type":"text","text":" works well for the"},{"type":"text","text":" "},{"type":"text","text":"US layout but is hard to reach for German users, where"},{"type":"text","text":" "},{"type":"codeVoice","code":"["},{"type":"text","text":" is available by pressing "},{"type":"codeVoice","code":"⌥5"},{"type":"text","text":", making users type "},{"type":"codeVoice","code":"⌥⌘5"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The automatic keyboard shortcut remapping re-assigns the shortcut to"},{"type":"text","text":" "},{"type":"text","text":"an appropriate replacement, "},{"type":"codeVoice","code":"⌘Ö"},{"type":"text","text":" in this case."}],"type":"paragraph"},{"inlineCon