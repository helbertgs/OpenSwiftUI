{"sections":[],"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneModifier_Content\/defaultLaunchBehavior(_:)","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneModifier_Content"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultLaunchBehavior"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"behavior"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"SceneLaunchBehavior","preciseIdentifier":"s:11OpenSwiftUI19SceneLaunchBehaviorV","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneLaunchBehavior"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"},{"kind":"text","text":"\n"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This behavior can be used to define if a scene is shown on application"},{"type":"text","text":" "},{"type":"text","text":"launch in the absence of any previously saved state."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On platforms that do not support multiple windows, this value is"},{"type":"text","text":" "},{"type":"text","text":"ignored."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On platforms other than Windows, there must be at least one scene that"},{"type":"text","text":" "},{"type":"text","text":"presents itself. If no scenes are defined to present, the first scene"},{"type":"text","text":" "},{"type":"text","text":"will be presented, regardless of the value provided to this modifier."}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"During app launch, on platforms other than Windows, the system","type":"text"},{"text":" ","type":"text"},{"text":"will only consider scenes whose role matches the","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/bundleresources\/information_property_list\/uiapplicationpreferreddefaultscenesessionrole","type":"text"},{"text":" ","type":"text"},{"text":"key in the application scene manifest of the ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":" file.","type":"text"},{"text":" ","type":"text"},{"text":"For instance, a volumetric window would need the","type":"text"},{"text":" ","type":"text"},{"code":"UIWindowSceneSessionRoleVolumetricApplication","type":"codeVoice"},{"text":" role.","type":"text"}]}],"type":"aside","style":"note","name":"Note"},{"type":"paragraph","inlineContent":[{"type":"text","text":"On Windows, this behavior will also be used to determine which scene is"},{"type":"text","text":" "},{"type":"text","text":"presented when clicking on the icon of a running application with no"},{"type":"text","text":" "},{"type":"text","text":"visible windows."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On visionOS, the system may background the last dismissed scene instead"},{"type":"text","text":" "},{"type":"text","text":"of closing it. Thus, the suppressed behavior additionally specifies that"},{"type":"text","text":" "},{"text":"the scene should not be presented when tapping on the application icon","type":"text"},{"type":"text","text":" "},{"text":"with no visible windows.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For example, you may wish to present a welcome window on launch of your","type":"text"},{"text":" ","type":"text"},{"text":"app when there are no previous document windows being restored:","type":"text"}]},{"syntax":null,"code":["@main","struct MyApp: App {","    var body: some Scene {","        DocumentGroup(newDocument: MyDocument()) { configuration in","            DocumentEditor(configuration.$document)","        }","","        Window(\"Welcome to My App\", id: \"welcome\") {","            WelcomeView()","        }","        .defaultLaunchBehavior(.presented)","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The default value for all scenes if you do not apply this modifier is","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneLaunchBehavior\/automatic","isActive":true},{"type":"text","text":". With that strategy, a scene"},{"text":" ","type":"text"},{"type":"text","text":"will only present itself if it is the first scene defined by the app,"},{"text":" ","type":"text"},{"type":"text","text":"and no other scenes have presented themselves."}],"type":"paragraph"}]}],"metadata":{"roleHeading":"Instance Method","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultLaunchBehavior","kind":"identifier"},{"text":"(","kind":"text"},{"text":"SceneLaunchBehavior","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI19SceneLaunchBehaviorV"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5SceneP"}],"title":"defaultLaunchBehavior(_:)","extendedModule":"OpenSwiftUI","role":"symbol","externalID":"s:11OpenSwiftUI5ScenePAAE21defaultLaunchBehavioryQrAA0dfG0VF::SYNTHESIZED::s:11OpenSwiftUI21SceneModifier_ContentV","modules":[{"name":"OpenSwiftUI"}]},"kind":"symbol","abstract":[{"text":"Sets the default launch behavior for th