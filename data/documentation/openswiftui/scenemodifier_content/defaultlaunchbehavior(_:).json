{"sections":[],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneModifier_Content"]]},"metadata":{"extendedModule":"OpenSwiftUI","externalID":"s:11OpenSwiftUI5ScenePAAE21defaultLaunchBehavioryQrAA0dfG0VF::SYNTHESIZED::s:11OpenSwiftUI21SceneModifier_ContentV","symbolKind":"method","role":"symbol","modules":[{"name":"OpenSwiftUI"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultLaunchBehavior","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI19SceneLaunchBehaviorV","text":"SceneLaunchBehavior","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5SceneP"}],"title":"defaultLaunchBehavior(_:)","roleHeading":"Instance Method"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"defaultLaunchBehavior","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"kind":"text","text":" "},{"text":"behavior","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"SceneLaunchBehavior","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI19SceneLaunchBehaviorV","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneLaunchBehavior"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5SceneP","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"},{"text":"\n","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This behavior can be used to define if a scene is shown on application"},{"text":" ","type":"text"},{"type":"text","text":"launch in the absence of any previously saved state."}]},{"inlineContent":[{"type":"text","text":"On platforms that do not support multiple windows, this value is"},{"type":"text","text":" "},{"type":"text","text":"ignored."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"On platforms other than Windows, there must be at least one scene that"},{"type":"text","text":" "},{"type":"text","text":"presents itself. If no scenes are defined to present, the first scene"},{"type":"text","text":" "},{"type":"text","text":"will be presented, regardless of the value provided to this modifier."}],"type":"paragraph"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"During app launch, on platforms other than Windows, the system"},{"type":"text","text":" "},{"type":"text","text":"will only consider scenes whose role matches the"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/bundleresources\/information_property_list\/uiapplicationpreferreddefaultscenesessionrole"},{"type":"text","text":" "},{"text":"key in the application scene manifest of the ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":" file.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"For instance, a volumetric window would need the"},{"text":" ","type":"text"},{"code":"UIWindowSceneSessionRoleVolumetricApplication","type":"codeVoice"},{"type":"text","text":" role."}],"type":"paragraph"}],"style":"note","name":"Note"},{"type":"paragraph","inlineContent":[{"text":"On Windows, this behavior will also be used to determine which scene is","type":"text"},{"text":" ","type":"text"},{"text":"presented when clicking on the icon of a running application with no","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"visible windows."}]},{"type":"paragraph","inlineContent":[{"text":"On visionOS, the system may background the last dismissed scene instead","type":"text"},{"text":" ","type":"text"},{"text":"of closing it. Thus, the suppressed behavior additionally specifies that","type":"text"},{"text":" ","type":"text"},{"text":"the scene should not be presented when tapping on the application icon","type":"text"},{"text":" ","type":"text"},{"text":"with no visible windows.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For example, you may wish to present a welcome window on launch of your","type":"text"},{"text":" ","type":"text"},{"text":"app when there are no previous document windows being restored:","type":"text"}]},{"type":"codeListing","code":["@main","struct MyApp: App {","    var body: some Scene {","        DocumentGroup(newDocument: MyDocument()) { configuration in","            DocumentEditor(configuration.$document)","        }","","        Window(\"Welcome to My App\", id: \"welcome\") {","            WelcomeView()","        }","        .defaultLaunchBehavior(.presented)","    }","}"],"syntax":null},{"type":"paragraph","inlineContent":[{"text":"The default value for all scenes if you do not apply this modifier is","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneLaunchBehavior\/automatic","type":"reference"},{"text":". With that strategy, a scene","type":"text"},{"text":" ","type":"text"},{"text":"will only present itself if it is the first scene defined by the app,","type":"text"},{"text":" ","type":"text"},{"text":"and no other scenes have presented themselves.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/scenemodifier_content\/defaultlaunchbehavior(_:)"]}],"kind":"symbol","abstract":[{"type":"text","text":"Sets the default launch behavior for this scene."}],"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneModifier_Content\/defaultLaunchBehavior(_:)","interfaceLanguage":"swift"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/SceneModifier_Content/defaultLaunchBehavior(_:)":{"url":"\/documentation\/openswiftui\/scenemodifier_content\/defaultlaunchbehavior(_:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultLaunchBehavior"},{"kind":"text","text":"("},{"preciseIdentifier":"s:11OpenSwiftUI19SceneLaunchBehaviorV","kind":"typeIdentifier","text":"SceneLaunchBehavior"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","kind":"typeIdentifier","text":"Scene"}],"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Sets the default launch behavior for this scene."}],"title":"defaultLaunchBehavior(_:)","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneModifier_Content\/defaultLaunchBehavior(_:)"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/SceneModifier_Content":{"url":"\/documentation\/openswiftui\/scenemodifier_content","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SceneModifier_Content","kind":"identifier"}],"type":"topic","abstract":[],"kind":"symbol","title":"SceneModifier_Content","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneModifier_Content","navigatorTitle":[{"kind":"identifier","text":"SceneModifier_Content"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/SceneLaunchBehavior":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SceneLaunchBehavior","kind":"identifier"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneLaunchBehavior","role":"symbol","abstract":[{"type":"text","text":"The launch behavior for a scene."}],"title":"SceneLaunchBehavior","url":"\/documentation\/openswiftui\/scenelaunchbehavior","kind":"symbol","navigatorTitle":[{"text":"SceneLaunchBehavior","kind":"identifier"}],"type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scene"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","role":"symbol","abstract":[{"type":"text","text":"A part of an app’s user interface with a life cycle managed by the"},{"type":"text","text":" "},{"type":"text","text":"system."}],"title":"Scene","kind":"symbol","url":"\/documentation\/openswiftui\/scene","navigatorTitle":[{"kind":"identifier","text":"Scene"}],"type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/SceneLaunchBehavior/automatic":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"automatic","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI19SceneLaunchBehaviorV","text":"SceneLaunchBehavior","kind":"typeIdentifier"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneLaunchBehavior\/automatic","role":"symbol","abstract":[{"type":"text","text":"The automatic behavior."}],"title":"automatic","url":"\/documentation\/openswiftui\/scenelaunchbehavior\/automatic","kind":"symbol","type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","abstract":[],"title":"OpenSwiftUI","url":"\/documentation\/openswiftui","kind":"symbol","type":"topic"}}}