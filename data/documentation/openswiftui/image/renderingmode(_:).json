t":[{"type":"text","text":"The mode OpenSwiftUI uses to render images."}]}],"name":"renderingMode"}]},{"content":[{"anchor":"return-value","level":2,"text":"Return Value","type":"heading"},{"inlineContent":[{"type":"text","text":"A modified "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Image"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Image\/TemplateRenderingMode"},{"type":"text","text":" enumeration has two cases:"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Image\/TemplateRenderingMode\/original"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Image\/TemplateRenderingMode\/template"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The original mode renders pixels as they appear in the original source"},{"type":"text","text":" "},{"type":"text","text":"image. Template mode renders all nontransparent pixels as the"},{"type":"text","text":" "},{"type":"text","text":"foreground color, which you can use for purposes like creating image"},{"type":"text","text":" "},{"type":"text","text":"masks."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example shows both rendering modes, as applied to an icon"},{"type":"text","text":" "},{"type":"text","text":"image of a green circle with darker green border:"}],"type":"paragraph"},{"syntax":null,"code":["Image(\"dot_green\")","    .renderingMode(.original)","Image(\"dot_green\")","    .renderingMode(.template)"],"type":"codeListing"},{"inlineContent":[],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You also use "},{"type":"codeVoice","code":"renderingMode"},{"type":"text","text":" to produce multicolored system graphics"},{"type":"text","text":" "},{"type":"text","text":"from the SF Symbols set. Use the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Image\/TemplateRenderingMode\/original"},{"type":"text","text":" "},{"type":"text","text":"mode to apply a foreground color to all parts of the symbol except"},{"type":"text","text":" "},{"type":"text","text":"those that have a distinct color in the graphic. The following"},{"type":"text","text":" "},{"type":"text","text":"example shows three uses of the "},{"type":"codeVoice","code":"person.crop.circle.badge.plus"},{"type":"text","text":" symbol"},{"type":"text","text":" "},{"type":"text","text":"to achieve different effects:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"A default appearance with no foreground color or template rendering","type":"text"},{"text":" ","type":"text"},{"text":"mode specified. The symbol appears all black in light mode, and all","type":"text"},{"text":" ","type":"text"},{"text":"white in Dark Mode.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The multicolor behavior achieved by using "},{"code":"original","type":"codeVoice"},{"type":"text","text":" template"},{"type":"text","text":" "},{"type":"text","text":"rendering mode, along with a blue foreground color. This mode causes the"},{"type":"text","text":" "},{"type":"text","text":"graphic to override the foreground color for distinctive parts of the"},{"type":"text","text":" "},{"type":"text","text":"image, in this case the plus icon."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A single-color template behavior achieved by using ","type":"text"},{"code":"template","type":"codeVoice"},{"text":" ","type":"text"},{"text":"rendering mode with a blue foreground color. This mode applies the","type":"text"},{"text":" ","type":"text"},{"text":"foreground color to the entire image, regardless of the user’s Appearance preferences.","type":"text"}]}]}],"type":"unorderedList"},{"syntax":"swift","code":["HStack {","   Image(systemName: \"person.crop.circle.badge.plus\")","   Image(systemName: \"person.crop.circle.badge.plus\")","       .renderingMode(.original)","       .foregroundColor(.blue)","   Image(systemName: \"person.crop.circle.badge.plus\")","       .renderingMode(.template)","       .foregroundColor(.blue)","}",".font(.largeTitle)"],"type":"codeListing"},{"inlineContent":[],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use the SF Symbols app to find system images that offer the multicolor"},{"type":"text","text":" "},{"type":"text","text":"feature. Keep in mind that some multicolor symbols use both the"},{"type":"text","text":" "},{"type":"text","text":"foreground and accent colors."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Image\/renderingMode(_:)"},"sections":[],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Image"]]},"kind":"symbol","abstract":[{"text":"Indicates whether OpenSwiftUI renders an image as-is, or","type":"text"},{"text":" ","type":"text"},{"text":"by using a different mode.","type":"text"}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Image/TemplateRenderingMode":{"navigatorTitle":[{"kind":"identifier","text":"TemplateRenderingMode"}],"title":"Image.TemplateRenderingMode","role":"symbol","type":"topic","url":"\/documentation\/openswiftui\/image\/templaterenderingmode","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Image\/TemplateRenderingMode","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TemplateRenderingMode"}],"abstract":