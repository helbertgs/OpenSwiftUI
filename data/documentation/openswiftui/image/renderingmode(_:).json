kind":"identifier"}],"kind":"symbol","title":"Image","url":"\/documentation\/openswiftui\/image","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Image","abstract":[{"type":"text","text":"A view that displays an image."}],"role":"symbol","navigatorTitle":[{"text":"Image","kind":"identifier"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Image/TemplateRenderingMode/template":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"template","kind":"identifier"}],"url":"\/documentation\/openswiftui\/image\/templaterenderingmode\/template","type":"topic","title":"Image.TemplateRenderingMode.template","abstract":[{"text":"A mode that renders all non-transparent pixels as the foreground","type":"text"},{"text":" ","type":"text"},{"text":"color.","type":"text"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Image\/TemplateRenderingMode\/template"}}}