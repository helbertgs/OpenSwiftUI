{"abstract":[{"text":"Indicates whether OpenSwiftUI renders an image as-is, or","type":"text"},{"text":" ","type":"text"},{"text":"by using a different mode.","type":"text"}],"kind":"symbol","variants":[{"paths":["\/documentation\/openswiftui\/image\/renderingmode(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"symbolKind":"method","externalID":"s:11OpenSwiftUI5ImageV13renderingModeyA2C017TemplateRenderingF0OSgF","roleHeading":"Instance Method","modules":[{"name":"OpenSwiftUI"}],"role":"symbol","title":"renderingMode(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"renderingMode","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Image","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5ImageV"},{"text":".","kind":"text"},{"text":"TemplateRenderingMode","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5ImageV21TemplateRenderingModeO"},{"text":"?) -> ","kind":"text"},{"text":"Image","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5ImageV"}],"extendedModule":"OpenSwiftUI"},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Image"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Image\/renderingMode(_:)"},"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"renderingMode","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"renderingMode","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Image","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5ImageV","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Image"},{"text":".","kind":"text"},{"text":"TemplateRenderingMode","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5ImageV21TemplateRenderingModeO","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Image\/TemplateRenderingMode"},{"text":"?) -> ","kind":"text"},{"text":"Image","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5ImageV","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Image"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"renderingMode","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The mode OpenSwiftUI uses to render images."}]}]}]},{"kind":"content","content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A modified "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Image","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Image\/TemplateRenderingMode","isActive":true},{"type":"text","text":" enumeration has two cases:"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Image\/TemplateRenderingMode\/original","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Image\/TemplateRenderingMode\/template","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The original mode renders pixels as they appear in the original source"},{"type":"text","text":" "},{"type":"text","text":"image. Template mode renders all nontransparent pixels as the"},{"type":"text","text":" "},{"type":"text","text":"foreground color, which you can use for purposes like creating image"},{"type":"text","text":" "},{"type":"text","text":"masks."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example shows both rendering modes, as applied to an icon"},{"type":"text","text":" "},{"type":"text","text":"image of a green circle with darker green border:"}]},{"syntax":null,"type":"codeListing","code":["Image(\"dot_green\")","    .renderingMode(.original)","Image(\"dot_green\")","    .renderingMode(.template)"]},{"type":"paragraph","inlineContent":[]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You also use "},{"type":"codeVoice","code":"renderingMode"},{"type":"text","text":" to produce multicolored system graphics"},{"type":"text","text":" "},{"type":"text","text":"from the SF Symbols set. Use the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Image\/TemplateRenderingMode\/original","isActive":true},{"type":"text","text":" "},{"type":"text","text":"mode to apply a foreground color to all parts of the symbol except"},{"type":"text","text":" "},{"type":"text","text":"those that have a distinct color in the graphic. The following"},{"type":"text","text":" "},{"type":"text","text":"example shows three uses of the "},{"type":"codeVoice","code":"person.crop.circle.badge.plus"},{"type":"text","text":" symbol"},{"type":"text","text":" "},{"type":"text","text":"to achieve different effects:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"A default appearance with no foreground color or template rendering","type":"text"},{"text":" ","type":"text"},{"text":"mode specified. The symbol appears all black in light mode, and all","type":"text"},{"text":" ","type":"text"},{"text":"white in Dark Mode.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The multicolor behavior achieved by using ","type":"text"},{"code":"original","type":"codeVoice"},{"text":" template","type":"text"},{"text":" ","type":"text"},{"text":"rendering mode, along with a blue foreground color. This mode causes the","type":"text"},{"text":" ","type":"text"},{"text":"graphic to override the foreground color for distinctive parts of the","type":"text"},{"text":" ","type":"text"},{"text":"image, in this case the plus icon.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A single-color template behavior achieved by using ","type":"text"},{"code":"template","type":"codeVoice"},{"text":" ","type":"text"},{"text":"rendering mode with a blue foreground color. This mode applies the","type":"text"},{"text":" ","type":"text"},{"text":"foreground color to the entire image, regardless of the user’s Appearance preferences.","type":"text"}]}]}]},{"syntax":"swift","type":"codeListing","code":["HStack {","   Image(systemName: \"person.crop.circle.badge.plus\")","   Image(systemName: \"person.crop.circle.badge.plus\")","       .renderingMode(.original)","       .foregroundColor(.blue)","   Image(systemName: \"person.crop.circle.badge.plus\")","       .renderingMode(.template)","       .foregroundColor(.blue)","}",".font(.largeTitle)"]},{"type":"paragraph","inlineContent":[]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the SF Symbols app to find system images that offer the multicolor"},{"type":"text","text":" "},{"type":"text","text":"feature. Keep in mind that some multicolor symbols use both the"},{"type":"text","text":" "},{"type":"text","text":"foreground and accent colors."}]}],"kind":"content"}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Image/renderingMode(_:)":{"kind":"symbol","abstract":[{"type":"text","text":"Indicates whether OpenSwiftUI renders an image as-is, or"},{"type":"text","text":" "},{"type":"text","text":"by using a different mode."}],"title":"renderingMode(_:)","role":"symbol","url":"\/documentation\/openswiftui\/image\/renderingmode(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"renderingMode"},{"kind":"text","text":"("},{"preciseIdentifi