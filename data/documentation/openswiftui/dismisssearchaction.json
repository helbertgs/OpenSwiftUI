{"abstract":[{"type":"text","text":"An action that can end a search interaction."}],"kind":"symbol","topicSections":[{"title":"Operators","generated":true,"anchor":"Operators","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction\/==(_:_:)"]},{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction\/callAsFunction()"]},{"title":"Default Implementations","generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction\/Equatable-Implementations"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/dismisssearchaction"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction","interfaceLanguage":"swift"},"metadata":{"symbolKind":"struct","navigatorTitle":[{"text":"DismissSearchAction","kind":"identifier"}],"roleHeading":"Structure","externalID":"s:11OpenSwiftUI19DismissSearchActionV","modules":[{"name":"OpenSwiftUI"}],"role":"symbol","title":"DismissSearchAction","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DismissSearchAction","kind":"identifier"}]},"sections":[],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/OpenSwiftUI\/SQ"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DismissSearchAction","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismissSearch","isActive":true},{"type":"text","text":" environment value to get the"},{"type":"text","text":" "},{"type":"text","text":"instance of this structure for a given "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","isActive":true},{"type":"text","text":". Then call the"},{"type":"text","text":" "},{"type":"text","text":"instance to dismiss the current search interaction. You call the instance"},{"type":"text","text":" "},{"type":"text","text":"directly because it defines a "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction\/callAsFunction()","isActive":true},{"type":"text","text":" "},{"type":"text","text":"method that Swift calls when you call the instance."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you dismiss search, OpenSwiftUI:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"code":"EnvironmentValues\/isSearching","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"false","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Clears any text from the search field.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Removes focus from the search field.","type":"text"}]}]}]},{"name":"Note","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Calling this instance has no effect if the user isn’t"},{"type":"text","text":" "},{"type":"text","text":"interacting with a search field."}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this action to dismiss a search operation based on"},{"type":"text","text":" "},{"type":"text","text":"another user interaction. For example, consider a searchable"},{"type":"text","text":" "},{"type":"text","text":"view with a "},{"type":"codeVoice","code":"Button"},{"type":"text","text":" that presents more information about the first"},{"type":"text","text":" "},{"type":"text","text":"matching item from a collection:"}]},{"syntax":null,"type":"codeListing","code":["struct ContentView: View {","    @State private var text = \"\"","","    var body: some View {","        NavigationView {","            SearchResults(searchText: text)","                .searchable(text: $text)","        }","    }","}","","private struct SearchResults: View {","    let searchText: String","","    let items = [\"a\", \"b\", \"c\"]","    var filteredItems: [String] { items.filter { $0 == searchText.lowercased() } }","","    @State private var isPresented = false","","    var body: some View {","        if let item = filteredItems.first {","            Button(\"Details about \\(item)\") {","                isPresented = true","            }","            .sheet(isPresented: $isPresented) {","                NavigationView {","                    DetailView(item: item)","                }","            }","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The button becomes visible only after the user enters search text"},{"type":"text","text":" "},{"type":"text","text":"that produces a match. When the user taps the button, OpenSwiftUI shows"},{"type":"text","text":" "},{"type":"text","text":"a sheet that provides more information about the item, including"},{"type":"text","text":" "},{"type":"text","text":"an Add button for adding the item to a stored list of items:"}]},{"syntax":null,"type":"codeListing","code":["private struct DetailView: View {","    let item: String","","    @Environment(\\.dismiss) private var dismiss","    @Environment(\\.dismissSearch) private var dismissSearch","","    var body: some View {","        Text(\"Information about \\(item).\")","            .toolbar {","                Button(\"Add\") {","                    \/\/ Store the item here...","","                    dismiss()","                    dismissSearch()","                }","            }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The user can dismiss the sheet by dragging it down, effectively"},{"type":"text","text":" "},{"type":"text","text":"canceling the operation, leaving the in-progress search interaction"},{"type":"text","text":" "},{"type":"text","text":"intact. Alternatively, the user can tap the Add button to store the"},{"type":"text","text":" "},{"type":"text","text":"item. Because the user is likely to be done with both the detail view"},{"type":"text","text":" "},{"type":"text","text":"and the search interaction at this point, the button’s closure also"},{"type":"text","text":" "},{"type":"text","text":"uses the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismiss","isActive":true},{"type":"text","text":" property to dismiss the sheet,"},{"type":"text","text":" "},{"type":"text","text":"and the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismissSearch","isActive":true},{"type":"text","text":" property to reset the"},{"type":"text","text":" "},{"type":"text","text":"search field."}]}],"kind":"content"}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/DismissSearchAction/callAsFunction()":{"abstract":[{"type":"text","text":"Dismisses the current search operation, if any."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction\/callAsFunction()","title":"callAsFunction()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"callAsFunction","kind":"identifier"},{"text":"()","kind":"text"}],"url":"\/documentation\/openswiftui\/dismisssearchaction\/callasfunction()"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues/dismiss":{"identifier":"doc:\/\/OpenSwiftUI\/document