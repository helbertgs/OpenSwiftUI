{"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DismissSearchAction","kind":"identifier"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismissSearch"},{"type":"text","text":" environment value to get the"},{"type":"text","text":" "},{"type":"text","text":"instance of this structure for a given "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment"},{"type":"text","text":". Then call the"},{"type":"text","text":" "},{"type":"text","text":"instance to dismiss the current search interaction. You call the instance"},{"type":"text","text":" "},{"type":"text","text":"directly because it defines a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction\/callAsFunction()"},{"type":"text","text":" "},{"type":"text","text":"method that Swift calls when you call the instance."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you dismiss search, SwiftUI:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Sets "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/isSearching"},{"type":"text","text":" to "},{"code":"false","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Clears any text from the search field.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Removes focus from the search field."}],"type":"paragraph"}]}]},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"Calling this instance has no effect if the user isn’t"},{"type":"text","text":" "},{"type":"text","text":"interacting with a search field."}],"type":"paragraph"}],"type":"aside","name":"Note"},{"type":"paragraph","inlineContent":[{"text":"Use this action to dismiss a search operation based on","type":"text"},{"text":" ","type":"text"},{"text":"another user interaction. For example, consider a searchable","type":"text"},{"text":" ","type":"text"},{"text":"view with a ","type":"text"},{"code":"Button","type":"codeVoice"},{"text":" that presents more information about the first","type":"text"},{"text":" ","type":"text"},{"text":"matching item from a collection:","type":"text"}]},{"type":"codeListing","code":["struct ContentView: View {","    @State private var text = \"\"","","    var body: some View {","        NavigationView {","            SearchResults(searchText: text)","                .searchable(text: $text)","        }","    }","}","","private struct SearchResults: View {","    let searchText: String","","    let items = [\"a\", \"b\", \"c\"]","    var filteredItems: [String] { items.filter { $0 == searchText.lowercased() } }","","    @State private var isPresented = false","","    var body: some View {","        if let item = filteredItems.first {","            Button(\"Details about \\(item)\") {","                isPresented = true","            }","            .sheet(isPresented: $isPresented) {","                NavigationView {","                    DetailView(item: item)","                }","            }","        }","    }","}"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"The button becomes visible only after the user enters search text"},{"type":"text","text":" "},{"type":"text","text":"that produces a match. When the user taps the button, SwiftUI shows"},{"type":"text","text":" "},{"type":"text","text":"a sheet that provides more information about the item, including"},{"type":"text","text":" "},{"type":"text","text":"an Add button for adding the item to a stored list of items:"}]},{"type":"codeListing","code":["private struct DetailView: View {","    let item: String","","    @Environment(\\.dismiss) private var dismiss","    @Environment(\\.dismissSearch) private var dismissSearch","","    var body: some View {","        Text(\"Information about \\(item).\")","            .toolbar {","                Button(\"Add\") {","                    \/\/ Store the item here...","","                    dismiss()","                    dismissSearch()","                }","            }","    }","}"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"The user can dismiss the sheet by dragging it down, effectively"},{"type":"text","text":" "},{"type":"text","text":"canceling the operation, leaving the in-progress search interaction"},{"type":"text","text":" "},{"type":"text","text":"intact. Alternatively, the user can tap the Add button to store the"},{"type":"text","text":" "},{"type":"text","text":"item. Because the user is likely to be done with both the detail view"},{"type":"text","text":" "},{"type":"text","text":"and the search interaction at this point, the button’s closure also"},{"type":"text","text":" "},{"type":"text","text":"uses the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismiss"},{"type":"text","text":" property to dismiss the sheet,"},{"type":"text","text":" "},{"type":"text","text":"and the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismissSearch"},{"type":"text","text":" property to reset the"},{"type":"text","text":" "},{"type":"text","text":"search field."}]}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"An action that can end a search interaction.","type":"text"}],"kind":"symbol","topicSections":[{"anchor":"Initializers","generated":true,"title":"Initializers","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction\/init(onDismiss:)"]},{"anchor":"Instance-Methods","generated":true,"title":"Instance Methods","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction\/callAsFunction()"]},{"anchor":"Default-Implementations","generated":true,"title":"Default Implementations","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction\/Equatable-Implementations"]}],"metadata":{"title":"DismissSearchAction","modules":[{"name":"OpenSwiftUI"}],"role":"symbol","roleHeading":"Structure","symbolKind":"struct","externalID":"s:11OpenSwiftUI19DismissSearchActionV","navigatorTitle":[{"kind":"identifier","text":"DismissSearchAction"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DismissSearchAction"}]},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction","interfaceLanguage":"swift"},"sections":[],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/OpenSwiftUI\/s8CopyableP","doc:\/\/OpenSwiftUI\/SQ"]}],"variants":[{"paths":["\/documentation\/openswiftui\/dismisssearchaction"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues/isSearching":{"role":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/isSearching","title":"isSearching","url":"\/documentation\/openswiftui\/environmentvalues\/issearching","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isSearching","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"kind":"symbol","abstract":[{"type":"text","text":"A Boolean value tha