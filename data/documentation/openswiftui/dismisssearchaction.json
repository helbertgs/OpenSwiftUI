{"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/OpenSwiftUI\/s8CopyableP","doc:\/\/OpenSwiftUI\/SQ"],"type":"conformsTo","kind":"relationships"}],"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction\/init(onDismiss:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Methods","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction\/callAsFunction()"],"generated":true,"anchor":"Instance-Methods"},{"title":"Default Implementations","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction\/Equatable-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/dismisssearchaction"]}],"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction","interfaceLanguage":"swift"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DismissSearchAction","kind":"identifier"}]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"type":"text","text":"Use the "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismissSearch","type":"reference","isActive":true},{"type":"text","text":" environment value to get the"},{"type":"text","text":" "},{"type":"text","text":"instance of this structure for a given "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","isActive":true},{"type":"text","text":". Then call the"},{"type":"text","text":" "},{"type":"text","text":"instance to dismiss the current search interaction. You call the instance"},{"type":"text","text":" "},{"type":"text","text":"directly because it defines a "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction\/callAsFunction()","isActive":true},{"type":"text","text":" "},{"type":"text","text":"method that Swift calls when you call the instance."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When you dismiss search, SwiftUI:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/isSearching","isActive":true},{"text":" to ","type":"text"},{"code":"false","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Clears any text from the search field."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Removes focus from the search field.","type":"text"}]}]}]},{"style":"note","content":[{"inlineContent":[{"text":"Calling this instance has no effect if the user isn’t","type":"text"},{"text":" ","type":"text"},{"text":"interacting with a search field.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Note"},{"inlineContent":[{"type":"text","text":"Use this action to dismiss a search operation based on"},{"type":"text","text":" "},{"type":"text","text":"another user interaction. For example, consider a searchable"},{"type":"text","text":" "},{"type":"text","text":"view with a "},{"code":"Button","type":"codeVoice"},{"type":"text","text":" that presents more information about the first"},{"type":"text","text":" "},{"type":"text","text":"matching item from a collection:"}],"type":"paragraph"},{"syntax":null,"code":["struct ContentView: View {","    @State private var text = \"\"","","    var body: some View {","        NavigationView {","            SearchResults(searchText: text)","                .searchable(text: $text)","        }","    }","}","","private struct SearchResults: View {","    let searchText: String","","    let items = [\"a\", \"b\", \"c\"]","    var filteredItems: [String] { items.filter { $0 == searchText.lowercased() } }","","    @State private var isPresented = false","","    var body: some View {","        if let item = filteredItems.first {","            Button(\"Details about \\(item)\") {","                isPresented = true","            }","            .sheet(isPresented: $isPresented) {","                NavigationView {","                    DetailView(item: item)","                }","            }","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The button becomes visible only after the user enters search text","type":"text"},{"text":" ","type":"text"},{"text":"that produces a match. When the user taps the button, SwiftUI shows","type":"text"},{"text":" ","type":"text"},{"text":"a sheet that provides more information about the item, including","type":"text"},{"text":" ","type":"text"},{"text":"an Add button for adding the item to a stored list of items:","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["private struct DetailView: View {","    let item: String","","    @Environment(\\.dismiss) private var dismiss","    @Environment(\\.dismissSearch) private var dismissSearch","","    var body: some View {","        Text(\"Information about \\(item).\")","            .toolbar {","                Button(\"Add\") {","                    \/\/ Store the item here...","","                    dismiss()","                    dismissSearch()","                }","            }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The user can dismiss the sheet by dragging it down, effectively"},{"type":"text","text":" "},{"type":"text","text":"canceling the operation, leaving the in-progress search interaction"},{"type":"text","text":" "},{"type":"text","text":"intact. Alternatively, the user can tap the Add button to store the"},{"type":"text","text":" "},{"type":"text","text":"item. Because the user is likely to be done with both the detail view"},{"type":"text","text":" "},{"type":"text","text":"and the search interaction at this point, the button’s closure also"},{"type":"text","text":" "},{"type":"text","text":"uses the "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismiss","type":"reference","isActive":true},{"type":"text","text":" property to dismiss the sheet,"},{"type":"text","text":" "},{"type":"text","text":"and the "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismissSearch","type":"reference","isActive":true},{"type":"text","text":" property to reset the"},{"type":"text","text":" "},{"type":"text","text":"search field."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"symbolKind":"struct","roleHeading":"Structure","title":"DismissSearchAction","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DismissSearchAction","kind":"identifier"}],"externalID":"s:11OpenSwiftUI19DismissSearchActionV","navigatorTitle":[{"text":"DismissSearchAction","kind":"identifier"}],"role":"symbol","modules":[{"name":"OpenSwiftUI"}]},"abstract":[{"text":"An action that can end a search interaction.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://OpenSwiftUI/SQ":{"type":"unresolvable","identifier":"doc:\/\/OpenSwiftUI\/SQ","title":"Swift.Equatable"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/DismissSearchAction":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DismissSearchAction","kind":"identifier"}],"navigatorTitle":[{"text":"DismissSearchAction","kind":"identifier"}],"title":"DismissSearchAction","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction","url":"\/documentation\/openswiftui\/dismisssearchaction","type":"topic","abstract":[{"type":"text","text":"An action that can end a search interaction."}],"role":"symbol"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/DismissSearchAction/init(onDismiss:)":{"role":"symbol","kind":"symbol","url":"\/documentation\/openswiftui\/dismisssearchaction\/init(ondismiss:)","type":"topic","abstract":[],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction\/init(onDismiss:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"onDismiss"},{"kind":"text","text":": (() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":")?)"}],"title":"init(onDismiss:)"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Environment":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","type":"topic","abstract":[{"type":"text","text":"A property wrapper that reads a value from a view’s environment."}],"url":"\/documentation\/openswiftui\/environment","kind":"symbol","navigatorTitle":[{"text":"Environment","kind":"identifier"}],"role":"symbol","title":"Environment","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Environment","kind":"identifier"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues/isSearching":{"kind":"symbol","title":"isSearching","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/isSearching","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isSearching"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"abstract":[{"text":"A Boolean value that indicates when the user is searching.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/openswiftui\/environmentvalues\/issearching"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues/dismissSearch":{"role":"symbol","url":"\/documentation\/openswiftui\/environmentvalues\/dismisssearch","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismissSearch","title":"dismissSearch","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"dismissSearch"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSwiftUI19DismissSearchActionV","kind":"typeIdentifier","text":"DismissSearchAction"}],"kind":"symbol","type":"topic","abstract":[{"text":"An action that ends the current search interaction.","type":"text"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues/dismiss":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dismiss"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI13DismissActionV","text":"DismissAction"}],"type":"topic","role":"symbol","abstract":[{"type":"text","text":"An action that dismisses the current presentation."}],"title":"dismiss","url":"\/documentation\/openswiftui\/environmentvalues\/dismiss","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismiss","kind":"symbol"},"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","title":"OpenSwiftUI","abstract":[],"type":"topic","kind":"symbol","url":"\/documentation\/openswiftui","role":"collection"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/DismissSearchAction/Equatable-Implementations":{"abstract":[],"kind":"article","role":"collectionGroup","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction\/Equatable-Implementations","title":"Equatable Implementations","url":"\/documentation\/openswiftui\/dismisssearchaction\/equatable-implementations","type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/DismissSearchAction/callAsFunction()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"callAsFunction"