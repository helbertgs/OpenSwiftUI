{"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"kind":"symbol","sections":[],"topicSections":[{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction\/init(onDismiss:)"],"title":"Initializers","generated":true,"anchor":"Initializers"},{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction\/callAsFunction()"],"title":"Instance Methods","generated":true,"anchor":"Instance-Methods"},{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction\/Equatable-Implementations"],"title":"Default Implementations","generated":true,"anchor":"Default-Implementations"}],"variants":[{"paths":["\/documentation\/openswiftui\/dismisssearchaction"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DismissSearchAction","kind":"identifier"}]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismissSearch","isActive":true,"type":"reference"},{"text":" environment value to get the","type":"text"},{"text":" ","type":"text"},{"text":"instance of this structure for a given ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","isActive":true,"type":"reference"},{"text":". Then call the","type":"text"},{"text":" ","type":"text"},{"text":"instance to dismiss the current search interaction. You call the instance","type":"text"},{"text":" ","type":"text"},{"text":"directly because it defines a ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction\/callAsFunction()","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"method that Swift calls when you call the instance.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you dismiss search, SwiftUI:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/isSearching","type":"reference"},{"text":" to ","type":"text"},{"type":"codeVoice","code":"false"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Clears any text from the search field."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Removes focus from the search field."}]}]}]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"Calling this instance has no effect if the user isn’t","type":"text"},{"text":" ","type":"text"},{"text":"interacting with a search field.","type":"text"}]}],"name":"Note"},{"type":"paragraph","inlineContent":[{"text":"Use this action to dismiss a search operation based on","type":"text"},{"text":" ","type":"text"},{"text":"another user interaction. For example, consider a searchable","type":"text"},{"text":" ","type":"text"},{"text":"view with a ","type":"text"},{"code":"Button","type":"codeVoice"},{"text":" that presents more information about the first","type":"text"},{"text":" ","type":"text"},{"text":"matching item from a collection:","type":"text"}]},{"type":"codeListing","syntax":null,"code":["struct ContentView: View {","    @State private var text = \"\"","","    var body: some View {","        NavigationView {","            SearchResults(searchText: text)","                .searchable(text: $text)","        }","    }","}","","private struct SearchResults: View {","    let searchText: String","","    let items = [\"a\", \"b\", \"c\"]","    var filteredItems: [String] { items.filter { $0 == searchText.lowercased() } }","","    @State private var isPresented = false","","    var body: some View {","        if let item = filteredItems.first {","            Button(\"Details about \\(item)\") {","                isPresented = true","            }","            .sheet(isPresented: $isPresented) {","                NavigationView {","                    DetailView(item: item)","                }","            }","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The button becomes visible only after the user enters search text","type":"text"},{"text":" ","type":"text"},{"text":"that produces a match. When the user taps the button, SwiftUI shows","type":"text"},{"text":" ","type":"text"},{"text":"a sheet that provides more information about the item, including","type":"text"},{"text":" ","type":"text"},{"text":"an Add button for adding the item to a stored list of items:","type":"text"}]},{"type":"codeListing","syntax":null,"code":["private struct DetailView: View {","    let item: String","","    @Environment(\\.dismiss) private var dismiss","    @Environment(\\.dismissSearch) private var dismissSearch","","    var body: some View {","        Text(\"Information about \\(item).\")","            .toolbar {","                Button(\"Add\") {","                    \/\/ Store the item here...","","                    dismiss()","                    dismissSearch()","                }","            }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The user can dismiss the sheet by dragging it down, effectively"},{"type":"text","text":" "},{"type":"text","text":"canceling the operation, leaving the in-progress search interaction"},{"type":"text","text":" "},{"type":"text","text":"intact. Alternatively, the user can tap the Add button to store the"},{"type":"text","text":" "},{"type":"text","text":"item. Because the user is likely to be done with both the detail view"},{"type":"text","text":" "},{"type":"text","text":"and the search interaction at this point, the button’s closure also"},{"type":"text","text":" "},{"type":"text","text":"uses the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismiss","isActive":true},{"type":"text","text":" property to dismiss the sheet,"},{"type":"text","text":" "},{"type":"text","text":"and the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismissSearch","isActive":true},{"type":"text","text":" property to reset the"},{"type":"text","text":" "},{"type":"text","text":"search field."}]}]}],"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/OpenSwiftUI\/s8CopyableP","doc:\/\/OpenSwiftUI\/SQ"],"kind":"relationships","title":"Conforms To"}],"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DismissSearchAction"}],"navigatorTitle":[{"text":"DismissSearchAction","kind":"identifier"}],"roleHeading":"Structure","modules":[{"name":"OpenSwiftUI"}],"externalID":"s:11OpenSwiftUI19DismissSearchActionV","symbolKind":"struct","role":"symbol","title":"DismissSearchAction"},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction","interfaceLanguage":"swift"},"abstract":[{"text":"An action that can end a search interaction.","type":"text"}],"references":{"doc://OpenSwiftUI/s8CopyableP":{"identifier":"doc:\/\/OpenSwiftUI\/s8CopyableP","type":"unresolvable","title":"Swift.Copyable"},"doc://OpenSwiftUI/SQ":{"identifier":"doc:\/\/OpenSwiftUI\/SQ","type":"unresolvable","title":"Swift.Equatable"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/DismissSearchAction":{"type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction","role":"symbol","title":"DismissSearchAction","url":"\/documentation\/openswiftui\/dismisssearchaction","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kin