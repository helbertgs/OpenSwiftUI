{"abstract":[{"type":"text","text":"An action that can end a search interaction."}],"topicSections":[{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction\/init(onDismiss:)"]},{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction\/callAsFunction()"]},{"title":"Default Implementations","generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction\/Equatable-Implementations"]}],"sections":[],"metadata":{"role":"symbol","symbolKind":"struct","externalID":"s:11OpenSwiftUI19DismissSearchActionV","title":"DismissSearchAction","modules":[{"name":"OpenSwiftUI"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DismissSearchAction"}],"navigatorTitle":[{"kind":"identifier","text":"DismissSearchAction"}],"roleHeading":"Structure"},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DismissSearchAction","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismissSearch","type":"reference"},{"text":" environment value to get the","type":"text"},{"text":" ","type":"text"},{"text":"instance of this structure for a given ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","type":"reference"},{"text":". Then call the","type":"text"},{"text":" ","type":"text"},{"text":"instance to dismiss the current search interaction. You call the instance","type":"text"},{"text":" ","type":"text"},{"text":"directly because it defines a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction\/callAsFunction()","type":"reference"},{"text":" ","type":"text"},{"text":"method that Swift calls when you call the instance.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"When you dismiss search, SwiftUI:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/isSearching","isActive":true},{"text":" to ","type":"text"},{"type":"codeVoice","code":"false"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Clears any text from the search field.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Removes focus from the search field.","type":"text"}],"type":"paragraph"}]}]},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"Calling this instance has no effect if the user isn’t","type":"text"},{"text":" ","type":"text"},{"text":"interacting with a search field.","type":"text"}]}]},{"type":"paragraph","inlineContent":[{"text":"Use this action to dismiss a search operation based on","type":"text"},{"text":" ","type":"text"},{"text":"another user interaction. For example, consider a searchable","type":"text"},{"text":" ","type":"text"},{"text":"view with a ","type":"text"},{"code":"Button","type":"codeVoice"},{"text":" that presents more information about the first","type":"text"},{"text":" ","type":"text"},{"text":"matching item from a collection:","type":"text"}]},{"type":"codeListing","code":["struct ContentView: View {","    @State private var text = \"\"","","    var body: some View {","        NavigationView {","            SearchResults(searchText: text)","                .searchable(text: $text)","        }","    }","}","","private struct SearchResults: View {","    let searchText: String","","    let items = [\"a\", \"b\", \"c\"]","    var filteredItems: [String] { items.filter { $0 == searchText.lowercased() } }","","    @State private var isPresented = false","","    var body: some View {","        if let item = filteredItems.first {","            Button(\"Details about \\(item)\") {","                isPresented = true","            }","            .sheet(isPresented: $isPresented) {","                NavigationView {","                    DetailView(item: item)","                }","            }","        }","    }","}"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"The button becomes visible only after the user enters search text"},{"type":"text","text":" "},{"type":"text","text":"that produces a match. When the user taps the button, SwiftUI shows"},{"type":"text","text":" "},{"type":"text","text":"a sheet that provides more information about the item, including"},{"type":"text","text":" "},{"type":"text","text":"an Add button for adding the item to a stored list of items:"}]},{"type":"codeListing","code":["private struct DetailView: View {","    let item: String","","    @Environment(\\.dismiss) private var dismiss","    @Environment(\\.dismissSearch) private var dismissSearch","","    var body: some View {","        Text(\"Information about \\(item).\")","            .toolbar {","                Button(\"Add\") {","                    \/\/ Store the item here...","","                    dismiss()","                    dismissSearch()","                }","            }","    }","}"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"The user can dismiss the sheet by dragging it down, effectively"},{"type":"text","text":" "},{"type":"text","text":"canceling the operation, leaving the in-progress search interaction"},{"type":"text","text":" "},{"type":"text","text":"intact. Alternatively, the user can tap the Add button to store the"},{"type":"text","text":" "},{"type":"text","text":"item. Because the user is likely to be done with both the detail view"},{"type":"text","text":" "},{"type":"text","text":"and the search interaction at this point, the button’s closure also"},{"type":"text","text":" "},{"type":"text","text":"uses the "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismiss","type":"reference","isActive":true},{"type":"text","text":" property to dismiss the sheet,"},{"type":"text","text":" "},{"type":"text","text":"and the "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismissSearch","type":"reference","isActive":true},{"type":"text","text":" property to reset the"},{"type":"text","text":" "},{"type":"text","text":"search field."}]}]}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/OpenSwiftUI\/s8CopyableP","doc:\/\/OpenSwiftUI\/SQ"]}],"variants":[{"paths":["\/documentation\/openswiftui\/dismisssearchaction"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction","interfaceLanguage":"swift"},"references":{"doc://OpenSwiftUI/s8CopyableP":{"title":"Swift.Copyable","type":"unresolvable","identifier":"doc:\/\/OpenSwiftUI\/s8CopyableP"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/DismissSearchAction":{"abstract":[{"type":"text","text":"An action that can end a search interaction."}],"type":"topic","navigatorTitle":[{"text":"DismissSearchAction","kind":"identifier"}],"url":"\/documentation\/openswiftui\/dismisssearchaction","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DismissSearchAction","kind":"identifier"}],"identifier":"doc:\/\/Open