{"topicSections":[{"generated":true,"title":"Operators","anchor":"Operators","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction\/==(_:_:)"]},{"generated":true,"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction\/callAsFunction()"]},{"generated":true,"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction\/Equatable-Implementations"]}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"sections":[],"metadata":{"navigatorTitle":[{"kind":"identifier","text":"DismissSearchAction"}],"externalID":"s:11OpenSwiftUI19DismissSearchActionV","title":"DismissSearchAction","role":"symbol","roleHeading":"Structure","symbolKind":"struct","modules":[{"name":"OpenSwiftUI"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DismissSearchAction"}]},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/OpenSwiftUI\/SQ"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DismissSearchAction"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismissSearch"},{"type":"text","text":" environment value to get the"},{"type":"text","text":" "},{"type":"text","text":"instance of this structure for a given "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment"},{"type":"text","text":". Then call the"},{"type":"text","text":" "},{"type":"text","text":"instance to dismiss the current search interaction. You call the instance"},{"type":"text","text":" "},{"type":"text","text":"directly because it defines a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction\/callAsFunction()"},{"type":"text","text":" "},{"type":"text","text":"method that Swift calls when you call the instance."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you dismiss search, OpenSwiftUI:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"code":"EnvironmentValues\/isSearching","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"false","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Clears any text from the search field.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Removes focus from the search field.","type":"text"}]}]}]},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Calling this instance has no effect if the user isn’t"},{"type":"text","text":" "},{"type":"text","text":"interacting with a search field."}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this action to dismiss a search operation based on"},{"type":"text","text":" "},{"type":"text","text":"another user interaction. For example, consider a searchable"},{"type":"text","text":" "},{"type":"text","text":"view with a "},{"code":"Button","type":"codeVoice"},{"type":"text","text":" that presents more information about the first"},{"type":"text","text":" "},{"type":"text","text":"matching item from a collection:"}]},{"type":"codeListing","code":["struct ContentView: View {","    @State private var text = \"\"","","    var body: some View {","        NavigationView {","            SearchResults(searchText: text)","                .searchable(text: $text)","        }","    }","}","","private struct SearchResults: View {","    let searchText: String","","    let items = [\"a\", \"b\", \"c\"]","    var filteredItems: [String] { items.filter { $0 == searchText.lowercased() } }","","    @State private var isPresented = false","","    var body: some View {","        if let item = filteredItems.first {","            Button(\"Details about \\(item)\") {","                isPresented = true","            }","            .sheet(isPresented: $isPresented) {","                NavigationView {","                    DetailView(item: item)","                }","            }","        }","    }","}"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"The button becomes visible only after the user enters search text"},{"type":"text","text":" "},{"type":"text","text":"that produces a match. When the user taps the button, OpenSwiftUI shows"},{"type":"text","text":" "},{"type":"text","text":"a sheet that provides more information about the item, including"},{"type":"text","text":" "},{"type":"text","text":"an Add button for adding the item to a stored list of items:"}]},{"type":"codeListing","code":["private struct DetailView: View {","    let item: String","","    @Environment(\\.dismiss) private var dismiss","    @Environment(\\.dismissSearch) private var dismissSearch","","    var body: some View {","        Text(\"Information about \\(item).\")","            .toolbar {","                Button(\"Add\") {","                    \/\/ Store the item here...","","                    dismiss()","                    dismissSearch()","                }","            }","    }","}"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"The user can dismiss the sheet by dragging it down, effectively"},{"type":"text","text":" "},{"type":"text","text":"canceling the operation, leaving the in-progress search interaction"},{"type":"text","text":" "},{"type":"text","text":"intact. Alternatively, the user can tap the Add button to store the"},{"type":"text","text":" "},{"type":"text","text":"item. Because the user is likely to be done with both the detail view"},{"type":"text","text":" "},{"type":"text","text":"and the search interaction at this point, the button’s closure also"},{"type":"text","text":" "},{"type":"text","text":"uses the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismiss"},{"type":"text","text":" property to dismiss the sheet,"},{"type":"text","text":" "},{"type":"text","text":"and the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismissSearch"},{"type":"text","text":" property to reset the"},{"type":"text","text":" "},{"type":"text","text":"search field."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/dismisssearchaction"]}],"abstract":[{"type":"text","text":"An action that can end a search interaction."}],"references":{"doc://OpenSwiftUI/SQ":{"title":"Swift.Equatable","type":"unresolvable","identifier":"doc:\/\/OpenSwiftUI\/SQ"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/DismissSearchAction":{"kind":"symbol","url":"\/documentation\/openswiftui\/dismisssearchaction","abstract":[{"text":"An action that can end a search interaction.","type":"text"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction","role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"DismissSearchAction"}],"navigatorTitle":[{"text":"DismissSearchAction","kind":"identifier"}],"title":"DismissSearchAction"},"doc://O