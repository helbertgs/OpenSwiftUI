{"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"kind":"symbol","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/userinterfacesizeclass"]}],"abstract":[{"type":"text","text":"A set of values that indicate the visual size available to the view."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UserInterfaceSizeClass","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You receive a size class value when you read either the"},{"type":"text","text":" "},{"type":"codeVoice","code":"EnvironmentValues\/horizontalSizeClass"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"EnvironmentValues\/verticalSizeClass"},{"type":"text","text":" environment value. The value tells"},{"type":"text","text":" "},{"type":"text","text":"you about the amount of space available to your views in a given"},{"type":"text","text":" "},{"type":"text","text":"direction. You can read the size class like any other of the"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues","isActive":true},{"type":"text","text":", by creating a property with the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","isActive":true},{"type":"text","text":" "},{"type":"text","text":"property wrapper:"}]},{"syntax":null,"type":"codeListing","code":["@Environment(\\.horizontalSizeClass) private var horizontalSizeClass","@Environment(\\.verticalSizeClass) private var verticalSizeClass"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"OpenSwiftUI sets the size class based on several factors, including:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The current device type.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The orientation of the device.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The appearance of Slide Over and Split View on iPad.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Several built-in views change their behavior based on the size class."},{"type":"text","text":" "},{"type":"text","text":"For example, a "},{"type":"codeVoice","code":"NavigationView"},{"type":"text","text":" presents a multicolumn view when"},{"type":"text","text":" "},{"type":"text","text":"the horizontal size class is "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UserInterfaceSizeClass\/regular","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"but a single column otherwise. You can also adjust the appearance of"},{"type":"text","text":" "},{"type":"text","text":"custom views by reading the size class and conditioning your views."},{"type":"text","text":" "},{"type":"text","text":"If you do, be prepared to handle size class changes while"},{"type":"text","text":" "},{"type":"text","text":"your app runs, because factors like device orientation can change at"},{"type":"text","text":" "},{"type":"text","text":"runtime."}]}],"kind":"content"}],"metadata":{"navigatorTitle":[{"text":"UserInterfaceSizeClass","kind":"identifier"}],"title":"UserInterfaceSizeClass","role":"symbol","symbolKind":"enum","roleHeading":"Enumeration","externalID":"s:11OpenSwiftUI22UserInterfaceSizeClassO","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UserInterfaceSizeClass","kind":"identifier"}],"modules":[{"name":"OpenSwiftUI"}]},"relationshipsSections":[{"title":"Conforms To","kind":"relationsh