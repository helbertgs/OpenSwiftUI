ues"},{"type":"text","text":", by creating a property with the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment"},{"type":"text","text":" "},{"type":"text","text":"property wrapper:"}]},{"type":"codeListing","syntax":null,"code":["@Environment(\\.horizontalSizeClass) private var horizontalSizeClass","@Environment(\\.verticalSizeClass) private var verticalSizeClass"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"OpenSwiftUI sets the size class based on several factors, including:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"The current device type.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The orientation of the device.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The appearance of Slide Over and Split View on iPad.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Several built-in views change their behavior based on the size class."},{"type":"text","text":" "},{"type":"text","text":"For example, a "},{"type":"codeVoice","code":"NavigationView"},{"type":"text","text":" presents a multicolumn view when"},{"type":"text","text":" "},{"type":"text","text":"the horizontal size class is "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UserInterfaceSizeClass\/regular"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"but a single column otherwise. You can also adjust the appearance of"},{"type":"text","text":" "},{"type":"text","text":"custom views by reading the size class and conditioning your views."},{"type":"text","text":" "},{"type":"text","text":"If you do, be prepared to handle size class changes while"},{"type":"text","text":" "},{"type":"text","text":"your app runs, because factors like device orientation can change at"},{"type":"text","text":" "},{"type":"text","text":"runtime."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/userinterfacesizeclass"]}],"kind":"symbol","abstract":[{"type":"text","text":"A set of values that indicate the visual size available to the view."}],"topicSections":[{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UserInterfaceSizeClass\/compact","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UserInterfaceSizeClass\/regular"],"anchor":"Enumeration-Cases","generated":true,"title":"Enumeration Cases"},{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UserInterfaceSizeClass\/Comparable-Implementations","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UserInterfaceSizeClass\/Equatable-Implementations"],"anchor":"Default-Implementations","generated":true,"title":"Default Implementations"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UserInterfaceSizeClass"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EnvironmentValues"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues","role":"symbol","abstract":[{"type":"text","text":"OpenSwiftUI exposes a collection of values to your app’s views in an"},{"type":"text","text":" "},{"type":"codeVoice","code":"EnvironmentValues"},{"type":"text","text":" structure. To read a value from the structure,"},{"type":"text","text":" "},{"type":"text","text":"declare a property using the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","isActive":true},{"type":"text","text":" property wrapper and"},{"type":"text","text":" "},{"type":"text","text":"specify the value’s key path. For example, you can read the current locale:"}],"title":"EnvironmentValues","url":"\/documentation\/openswiftui\/environment