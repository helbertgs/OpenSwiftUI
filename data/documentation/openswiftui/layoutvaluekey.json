},{"type":"text","text":"view modifier to the view. To make your custom value easier to work"},{"type":"text","text":" "},{"type":"text","text":"with, you can do this in a convenience modifier in an extension of the"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/View","isActive":true},{"type":"text","text":" protocol:"}],"type":"paragraph"},{"syntax":null,"code":["extension View {","    func layoutFlexibility(_ value: CGFloat?) -> some View {","        layoutValue(key: Flexibility.self, value: value)","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Use your modifier to set the value on any views that need a nondefault","type":"text"},{"text":" ","type":"text"},{"text":"value:","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["BasicVStack {","    Text(\"One View\")","    Text(\"Another View\")","        .layoutFlexibility(3)","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Any view that you don’t explicitly set a value for uses the default"},{"type":"text","text":" "},{"type":"text","text":"value, as with the first "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text"},{"type":"text","text":" view, above."}],"type":"paragraph"},{"anchor":"Retrieve-a-value-during-layout","type":"heading","text":"Retrieve a value during layout","level":3},{"inlineContent":[{"text":"Access a custom layout value using the key as an index","type":"text"},{"text":" ","type":"text"},{"text":"on subview’s proxy (an instance of ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutSubview"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"and use the value to make decisions about sizing, placement, or other","type":"text"},{"text":" ","type":"text"},{"text":"layout operations. For example, you might read the flexibility value","type":"text"},{"text":" 