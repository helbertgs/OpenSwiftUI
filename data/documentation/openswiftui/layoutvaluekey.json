{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/layoutvaluekey"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"LayoutValueKey"}]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"If you create a custom layout by defining a type that conforms to the","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout","type":"reference"},{"text":" protocol, you can also create custom layout values","type":"text"},{"text":" ","type":"text"},{"text":"that you set on individual views, and that your container view can access","type":"text"},{"text":" ","type":"text"},{"text":"to guide its layout behavior. Your custom values resemble","type":"text"},{"text":" ","type":"text"},{"text":"the built-in layout values that you set with view modifiers","type":"text"},{"text":" ","type":"text"},{"text":"like ","type":"text"},{"code":"View\/layoutPriority(_:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"View\/zIndex(_:)","type":"codeVoice"},{"text":", but have a","type":"text"},{"text":" ","type":"text"},{"text":"purpose that you define.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To create a custom layout value, define a type that conforms to the","type":"text"},{"text":" ","type":"text"},{"code":"LayoutValueKey","type":"codeVoice"},{"text":" protocol and implement the one required property that","type":"text"},{"text":" ","type":"text"},{"text":"returns the default value of the property. For example, you can create","type":"text"},{"text":" ","type":"text"},{"text":"a property that defines an amount of flexibility for a view, defined as","type":"text"},{"text":" ","type":"text"},{"text":"an optional floating point number with a default value of ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["private struct Flexibility: LayoutValueKey {","    static let defaultValue: CGFloat? = nil","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The Swift compiler infers this particular key’s associated type as an"},{"type":"text","text":" "},{"type":"text","text":"optional "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/CoreFoundation\/CGFloat"},{"type":"text","text":" "},{"type":"text","text":"from this definition."}],"type":"paragraph"},{"level":3,"text":"Set a value on a view","anchor":"Set-a-value-on-a-view","type":"heading"},{"inlineContent":[{"text":"Set the value on a view by adding the ","type":"text"},{"code":"View\/layoutValue(key:value:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"view modifier to the view. To make your custom value easier to work","type":"text"},{"text":" ","type":"text"},{"text":"with, you can do this in a convenience modifier in an extension of the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/View","isActive":true,"type":"reference"},{"text":" protocol:","type":"text"}],"type":"paragraph"},{"code":["extension View {","    func layoutFlexibility(_ value: CGFloat?) -> some View {","        layoutValue(key: Flexibility.self, value: value)","    }","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Use your modifier to set the value on any views that need a nondefault"},{"type":"text","text":" "},{"type":"text","text":"value:"}],"type":"paragraph"},{"code":["BasicVStack {","    Text(\"One View\")","    Text(\"Another View\")","        .layoutFlexibility(3)","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Any view that you don’t explicitly set a value for uses the default"},{"type":"text","text":" "},{"type":"text","text":"value, as with the first "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text"},{"type":"text","text":" view, above."}],"type":"paragraph"},{"level":3,"text":"Retrieve a value during layout","anchor":"Retrieve-a-value-during-layout","type":"heading"},{"inlineContent":[{"text":"Access a custom layout value using the key as an index","type":"text"},{"text":" ","type":"text"},{"text":"on subview’s proxy (an instance of ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutSubview","isActive":true,"type":"reference"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"and use the value to make decisions about sizing, placement, or other","type":"text"},{"text":" ","type":"text"},{"text":"layout operations. For example, you might read the flexibility value","type":"text"},{"text":" ","type":"text"},{"text":"in your layout view’s ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutSubview\/sizeThatFits(_:)","isActive":true,"type":"reference"},{"text":" method, and","type":"text"},{"text":" ","type":"text"},{"text":"adjust your size calculations accordingly:","type":"text"}],"type":"paragraph"},{"code":["extension BasicVStack {","    func sizeThatFits(","        proposal: ProposedViewSize,","        subviews: Subviews,","        cache: inout Void","    ) -> CGSize {","","        \/\/ Map the flexibility property of each subview into an array.","        let flexibilities = subviews.map { subview in","            subview[Flexibility.self]","        }","","        \/\/ Calculate and return the size of the layout container.","        \/\/ ...","    }","}"],"syntax":null,"type":"codeListing"}]}],"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutValueKey","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Protocol","navigatorTitle":[{"text"