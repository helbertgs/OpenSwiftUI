{"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"kind":"symbol","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/layoutvaluekey"]}],"abstract":[{"text":"A key for accessing a layout value of a layout container’s subviews.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LayoutValueKey","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you create a custom layout by defining a type that conforms to the"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout","isActive":true},{"type":"text","text":" protocol, you can also create custom layout values"},{"type":"text","text":" "},{"type":"text","text":"that you set on individual views, and that your container view can access"},{"type":"text","text":" "},{"type":"text","text":"to guide its layout behavior. Your custom values resemble"},{"type":"text","text":" "},{"type":"text","text":"the built-in layout values that you set with view modifiers"},{"type":"text","text":" "},{"type":"text","text":"like "},{"type":"codeVoice","code":"View\/layoutPriority(_:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"View\/zIndex(_:)"},{"type":"text","text":", but have a"},{"type":"text","text":" "},{"type":"text","text":"purpose that you define."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To create a custom layout value, define a type that conforms to the"},{"type":"text","text":" "},{"type":"codeVoice","code":"LayoutValueKey"},{"type":"text","text":" protocol and implement the one required property that"},{"type":"text","text":" "},{"type":"text","text":"returns the default value of the property. For example, you can create"},{"type":"text","text":" "},{"type":"text","text":"a property that defines an amount of flexibility for a view, defined as"},{"type":"text","text":" "},{"type":"text","text":"an optional floating point number with a default value of "},{"type":"codeVoice","code":"nil"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":null,"code":["private struct Flexibility: LayoutValueKey {","    static let defaultValue: CGFloat? = nil","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Swift compiler infers this particular key’s associated type as an"},{"type":"text","text":" "},{"type":"text","text":"optional "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/CoreFoundation\/CGFloat"},{"type":"text","text":" "},{"type":"text","text":"from this definition."}]},{"type":"heading","level":3,"text":"Set a value on a view","anchor":"Set-a-value-on-a-view"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set the value on a view by adding the "},{"code":"View\/layoutValue(key:value:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"view modifier to the view. To make your custom value easier to work"},{"type":"text","text":" "},{"type":"text","text":"with, you can do this in a convenience modifier in an extension of the"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/View"},{"type":"text","text":" protocol:"}]},{"type":"codeListing","syntax":null,"code":["extension View {","    func layoutFlexibility(_ value: CGFloat?) -> some View {","        layoutValue(key: Flexibility.self, value: value)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use your modifier to set the value on any views that need a nondefault"},{"type":"text","text":" "},{"type":"text","text":"value:"}]},{"type":"codeListing","syntax":null,"code":["BasicVStack {","    Text(\"One View\")","    Text(\"Another View\")","        .layoutFlexibility(3)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Any view that you don’t explicitly set a value for uses the default"},{"type":"text","text":" "},{"type":"text","text":"value, as with the first "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text"},{"type":"text","text":" view, above."}]},{"type":"heading","level":3,"text":"Retrieve a value during layout","anchor":"Retrieve-a-value-during-layout"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Access a custom layout value using the key as an index"},{"type":"text","text":" "},{"type":"text","text":"on subview’s proxy (an instance of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutSubview"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"and use the value to make decisions about sizing, placement, or other"},{"type":"text","text":" "},{"type":"text","text":"layout operations. For example, you might read the flexibility value"},{"type":"text","text":" "},{"type":"text","text":"in your layout view’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutSubview\/sizeThatFits(_:)"},{"type":"text","text":" method, and"},{"type":"text","text":" "},{"type":"text","text":"adjust your size calculations accordingly:"}]},{"type":"codeListing","syntax":null,"code":["extension BasicVStack {","    func sizeThatFits(","        proposal: ProposedViewSize,","        subviews: Subviews,","        cache: inout Void","    ) -> CGSize {","","        \/\/ Map the flexibility property of each subview into an array.","        let flexibilities = subviews.map { subview in","            subview[Flexibility.self]","        }","","        \/\/ Calculate and return the size of the layout container.","        \/\/ ...","    }","}"]}],"kind":"content"}],"metadata":{