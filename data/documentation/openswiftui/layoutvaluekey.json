{"abstract":[{"type":"text","text":"A key for accessing a layout value of a layout container’s subviews."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"metadata":{"roleHeading":"Protocol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"LayoutValueKey"}],"modules":[{"name":"OpenSwiftUI"}],"title":"LayoutValueKey","symbolKind":"protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"LayoutValueKey"}],"externalID":"s:11OpenSwiftUI14LayoutValueKeyP"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutValueKey"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LayoutValueKey","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"text":"If you create a custom layout by defining a type that conforms to the","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout","type":"reference"},{"text":" protocol, you can also create custom layout values","type":"text"},{"text":" ","type":"text"},{"text":"that you set on individual views, and that your container view can access","type":"text"},{"text":" ","type":"text"},{"text":"to guide its layout behavior. Your custom values resemble","type":"text"},{"text":" ","type":"text"},{"text":"the built-in layout values that you set with view modifiers","type":"text"},{"text":" ","type":"text"},{"text":"like ","type":"text"},{"type":"codeVoice","code":"View\/layoutPriority(_:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"View\/zIndex(_:)"},{"text":", but have a","type":"text"},{"text":" ","type":"text"},{"text":"purpose that you define.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To create a custom layout value, define a type that conforms to the"},{"type":"text","text":" "},{"type":"codeVoice","code":"LayoutValueKey"},{"type":"text","text":" protocol and implement the one required property that"},{"type":"text","text":" "},{"type":"text","text":"returns the default value of the property. For example, you can create"},{"type":"text","text":" "},{"type":"text","text":"a property that defines an amount of flexibility for a view, defined as"},{"type":"text","text":" "},{"type":"text","text":"an optional floating point number with a default value of "},{"code":"nil","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["private struct Flexibility: LayoutValueKey {","    static let defaultValue: CGFloat? = nil","}"]},{"inlineContent":[{"text":"The Swift compiler infers this particular key’s associated type as an","type":"text"},{"text":" ","type":"text"},{"text":"optional ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/CoreFoundation\/CGFloat","type":"text"},{"text":" ","type":"text"},{"text":"from this definition.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Set-a-value-on-a-view","text":"Set a value on a view","type":"heading"},{"inlineContent":[{"type":"text","text":"Set the value on a view by adding the "},{"code":"View\/layoutValue(key:value:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"view modifier to the view. To make your custom value easier to work"},{"type":"text","text":" "},{"type":"text","text":"with, you can do this in a convenience modifier in an extension of the"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/View"},{"type":"text","text":" protocol:"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["extension View {","    func layoutFlexibility(_ value: CGFloat?) -> some View {","        layoutValue(key: Flexibility.self, value: value)","    }","}"]},{"inlineContent":[{"type":"text","text":"Use your modifier to set the value on any views that need a nondefault"},{"type":"text","text":" "},{"type":"text","text":"value:"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["BasicVStack {","    Text(\"One View\")","    Text(\"Another View\")","        .layoutFlexibility(3)","}"]},{"inlineContent":[{"type":"text","text":"Any view that you don’t explicitly set a value for uses the default"},{"type":"text","text":" "},{"type":"text","text":"value, as with the first "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text","isActive":true},{"type":"text","text":" view, above."}],"type":"paragraph"},{"level":3,"anchor":"Retrieve-a-value-during-layout","text":"Retrieve a value during layout","type":"heading"},{"inlineContent":[{"text":"Access a custom layout value using the key as an index","type":"text"},{"text":" ","type":"text"},{"text":"on subview’s proxy (an instance of ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutSubview","type":"reference"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"and use the value to make decisions about sizing, placement, or other","type":"text"},{"text":" ","type":"text"},{"text":"layout operations. For example, you might read the flexibility value","type":"text"},{"text":" ","type":"text"},{"text":"in your layout view’s ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutSubview\/sizeThatFits(_:)"},{"type":"text","text":" method, and"},{"type":"text","text":" "},{"type":"text","text":"adjust your size calculations accordingly:"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["extension BasicVStack {","    func sizeThatFits(","        proposal: ProposedViewSize,","        subviews: Subviews,","        cache: inout Void","    ) -> CGSize {","","        \/\/ Map the flexibility property of each subview into an array.","        let flexibilities = subviews.map { subview in","            subview[Flexibility.self]","        }","","        \/\/ Calculate and return the size of the layout container.","        \/\/ ...","    }","}"]}]}],"variants":[{"paths":["\/documentation\/openswiftui\/layoutvaluekey"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"symbol","topicSections":[{"title":"Associated Types","anchor":"Associated-Types","generated":true,"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutValueKey\/Value"]},{"title":"Type Properties","anchor":"Type-Properties","generated":true,"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutValueKey\/defaultValue"]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Layout":{"abstract":[{"text":"A type that defines the geometry of a collection of views.","type":"text"}],"url":"\/documentation\/openswiftui\/layout","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Layout","kind":"identifier"}],"type":"topic","kind":"symbol","navigatorTitle":[{"text":"Layout","kind":"identifier"}],"title":"Layout","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout","role":"symbol"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/LayoutSubview":{"title":"LayoutSubview","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LayoutSubview"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutSubview","navigatorTitle":[{"kind":"identifier","text":"LayoutSubview"}],"url":"\/documentation\/openswiftui\/layoutsubview","abstract":[{"text":"A proxy that represents one subview of a layout.","type":"text"}],"role":"symbol"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/LayoutValueKey/Value":{"ki