{"sections":[],"abstract":[{"text":"An indication of a scene’s operational state.","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/OpenSwiftUI\/s15BitwiseCopyableP","doc:\/\/OpenSwiftUI\/SL","doc:\/\/OpenSwiftUI\/SQ","doc:\/\/OpenSwiftUI\/SH","doc:\/\/OpenSwiftUI\/s8SendableP"],"type":"conformsTo"}],"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ScenePhase","interfaceLanguage":"swift"},"topicSections":[{"title":"Enumeration Cases","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ScenePhase\/active","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ScenePhase\/background","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ScenePhase\/inactive"],"generated":true,"anchor":"Enumeration-Cases"},{"title":"Default Implementations","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ScenePhase\/Comparable-Implementations","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ScenePhase\/Equatable-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/scenephase"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScenePhase","kind":"identifier"}]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The system moves your app’s "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","isActive":true},{"type":"text","text":" instances through phases that reflect"},{"type":"text","text":" "},{"type":"text","text":"a scene’s operational state. You can trigger actions when the phase changes."},{"type":"text","text":" "},{"type":"text","text":"Read the current phase by observing the "},{"type":"codeVoice","code":"EnvironmentValues\/scenePhase"},{"type":"text","text":" "},{"type":"text","text":"value in the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","isActive":true},{"type":"text","text":":"}]},{"code":["@Environment(\\.scenePhase) private var scenePhase"],"type":"codeListing","syntax":null},{"type":"paragraph","inlineContent":[{"text":"How you interpret the value depends on where it’s read from.","type":"text"},{"text":" ","type":"text"},{"text":"If you read the phase from inside a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/View","type":"reference"},{"text":" instance, you obtain a value","type":"text"},{"text":" ","type":"text"},{"text":"that reflects the phase of the scene that contains the view. The following","type":"text"},{"text":" ","type":"text"},{"text":"example uses the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/View\/onChange(of:perform:)","type":"reference"},{"text":" method to enable","type":"text"},{"text":" ","type":"text"},{"text":"a timer whenever the enclosing scene enters the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ScenePhase\/active","type":"reference"},{"text":" phase","type":"text"},{"text":" ","type":"text"},{"text":"and disable the timer when entering any other phase:","type":"text"}]},{"code":["struct MyView: View {","    @ObservedObject var model: DataModel","    @Environment(\\.scenePhase) private var scenePhase","","    var body: some View {","        TimerView()","            .onChange(of: scenePhase) { phase in","                model.isTimerRunning = (phase == .active)","            }","    }","}"],"type":"codeListing","syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you read the phase from within an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/App"},{"type":"text","text":" instance, you obtain an"},{"type":"text","text":" "},{"type":"text","text":"aggregate value that reflects the phases of all the scenes in your app. The"},{"type":"text","text":" "},{"type":"text","text":"app reports a value of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ScenePhase\/active"},{"type":"text","text":" if any scene is active, or a"},{"type":"text","text":" "},{"type":"text","text":"value of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ScenePhase\/inactive"},{"type":"text","text":" when no scenes are active. This includes"},{"type":"text","text":" "},{"type":"text","text":"multiple scene instances created from a single scene declaration; for"},{"type":"text","text":" "},{"type":"text","text":"example, from a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup"},{"type":"text","text":". When an app enters the"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ScenePhase\/background"},{"type":"text","text":" phase, expect the app to terminate soon after."},{"type":"text","text":" "},{"type":"text","text":"You can use that opportunity to free any resources:"}]},{"code":["@main","struct MyApp: App {","    @Environment(\\.scenePhase) private var scenePhase","","    var body: some Scene {","        WindowGroup {","            MyRootView()","        }","        .onChange(of: scenePhase) { phase in","            if phase == .background {","                \/\/ Perform cleanup when all scenes within","                \/\/ MyApp go to the background.","            }","        }","    }","}"],"type":"codeListing","syntax":null},{"type":"paragraph","inlineContent":[{"text":"If you read the phase from within a custom ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","type":"reference"},{"text":" instance, the value","type":"text"},{"text":" ","type":"text"},{"text":"similarly reflects an aggregation of all the scenes that make up the custom","type":"text"},{"text":" ","type":"text"},{"text":"scene:","type":"text"}]},{"code":["struct MyScene: Scene {","    @Environment(\\.scenePhase) private var scenePhase","","    var body: some Scene {","        WindowGroup {","            MyRootView()","        }","        .onChange(of: scenePhase) { phase in","            if phase == .background {","                \/\/ Perform cleanup when all scenes within","                \/\/ MyScene go to the background.","            }","        }","    }","}"],"type":"codeListing","syntax":null}]}],"kind":"symbol","metadata":{"navigatorTitle":[{"text":"ScenePhase","kind":"identifier"}],"title":"ScenePhase","roleHeading":"Enumeration","externalID":"s:11OpenSwiftUI10ScenePhaseO","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScenePhase"}],"modules":[{"name":"OpenSwiftUI"}],"symbolKind":"enum"},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"references":{"doc://OpenSwiftUI/SH":{"title":"Swift.Hashable","identifier":"doc:\/\/OpenSwiftUI\/SH","type":"unresolvable"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/App":{"kind":"symbol","title":"App","navigatorTitle":[{"kind":"identifier","text":"App"}],"abstract":[{"type":"text","text":"A type that represents the structure and behavior of an app."}],"type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"App"}],"url":"\/documentation\/openswiftui\/app","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/App","role":"symbol"},"doc://OpenSwiftUI/documentation/OpenSwiftU