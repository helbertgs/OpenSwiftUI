{"variants":[{"paths":["\/documentation\/openswiftui\/scenephase"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"An indication of a scene’s operational state.","type":"text"}],"metadata":{"symbolKind":"enum","title":"ScenePhase","roleHeading":"Enumeration","navigatorTitle":[{"text":"ScenePhase","kind":"identifier"}],"modules":[{"name":"OpenSwiftUI"}],"externalID":"s:11OpenSwiftUI10ScenePhaseO","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScenePhase","kind":"identifier"}],"role":"symbol"},"topicSections":[{"anchor":"Enumeration-Cases","generated":true,"title":"Enumeration Cases","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ScenePhase\/active","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ScenePhase\/background","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ScenePhase\/inactive"]},{"anchor":"Default-Implementations","generated":true,"title":"Default Implementations","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ScenePhase\/Comparable-Implementations","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ScenePhase\/Equatable-Implementations"]}],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/OpenSwiftUI\/s15BitwiseCopyableP","doc:\/\/OpenSwiftUI\/SL","doc:\/\/OpenSwiftUI\/SQ","doc:\/\/OpenSwiftUI\/SH","doc:\/\/OpenSwiftUI\/s8SendableP","doc:\/\/OpenSwiftUI\/s16SendableMetatypeP"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScenePhase","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The system moves your app’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"},{"type":"text","text":" instances through phases that reflect"},{"type":"text","text":" "},{"type":"text","text":"a scene’s operational state. You can trigger actions when the phase changes."},{"type":"text","text":" "},{"type":"text","text":"Read the current phase by observing the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/scenePhase"},{"text":" ","type":"text"},{"type":"text","text":"value in the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["@Environment(\\.scenePhase) private var scenePhase"]},{"inlineContent":[{"text":"How you interpret the value depends on where it’s read from.","type":"text"},{"text":" ","type":"text"},{"text":"If you read the phase from inside a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/View"},{"type":"text","text":" instance, you obtain a value"},{"type":"text","text":" "},{"text":"that reflects the phase of the scene that contains the view. The following","type":"text"},{"type":"text","text":" "},{"text":"example uses the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/View\/onChange(of:perform:)"},{"text":" method to enable","type":"text"},{"text":" ","type":"text"},{"text":"a timer whenever the enclosing scene enters the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ScenePhase\/active"},{"text":" phase","type":"text"},{"text":" ","type":"text"},{"text":"and disable the timer when entering any other phase:","type":"text"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["struct MyView: View {","    @ObservedObject var model: DataModel","    @Environment(\\.scenePhase) private var scenePhase","","    var body: some View {","        TimerView()","            .onChange(of: scenePhase) { phase in","                model.isTimerRunning = (phase == .active)","            }","    }","}"]},{"inlineContent":[{"type":"text","text":"If you read the phase from within an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/App"},{"text":" instance, you obtain an","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"aggregate value that reflects the phases of all the scenes in your app. The"},{"text":" ","type":"text"},{"type":"text","text":"app reports a value of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ScenePhase\/active"},{"type":"text","text":" if any scene is active, or a"},{"text":" ","type":"text"},{"text":"value of ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ScenePhase\/inactive","type":"reference"},{"text":" when no scenes are active. This includes","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"multiple scene instances created from a single scene declaration; for"},{"text":" ","type":"text"},{"type":"text","text":"example, from a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup"},{"type":"text","text":". When an app enters the"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ScenePhase\/background","type":"reference"},{"text":" phase, expect the app to terminate soon after.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"You can use that opportunity to free any resources:"}],"type":"paragraph"},{"code":["@main","struct MyApp: App {","    @Environment(\\.scenePhase) private var scenePhase","","    var body: some Scene {","        WindowGroup {","            MyRootView()","        }","        .onChange(of: scenePhase) { phase in","            if phase == .background {","                \/\/ Perform cleanup when all scenes within","                \/\/ MyApp go to the background.","            }","        }","    }","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"If you read the phase from within a custom ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","type":"reference"},{"text":" instance, the value","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"similarly reflects an aggregation of all the scenes that make up the custom"},{"type":"text","text":" "},{"type":"text","text":"scene:"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["struct MyScene: Scene {","    @Environment(\\.scenePhase) private var scenePhase","","    var body: some Scene {","        WindowGroup {","            MyRootView()","        }","        .onChange(of: scenePhase) { phase in","            if phase == .background {","                \/\/ Perform cleanup when all scenes within","                \/\/ MyScene go to the background.","            }","        }","    }","}"]}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ScenePhase"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues/scenePhase":{"url":"\/documentation\/openswiftui\/environmentvalues\/scenephase","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"scenePhase","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ScenePhase","preciseIdentifier":"s:11OpenSwiftUI10ScenePhaseO","kind":"typeIdentifier"}],"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The current phase of the scene."}],"title":"scenePhase","ident