{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentKey"},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"roleHeading":"Protocol","title":"EnvironmentKey","symbolKind":"protocol","role":"symbol","modules":[{"name":"OpenSwiftUI"}],"externalID":"s:11OpenSwiftUI14EnvironmentKeyP","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EnvironmentKey","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"EnvironmentKey"}]},"topicSections":[{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentKey\/Value"],"generated":true,"title":"Associated Types","anchor":"Associated-Types"},{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentKey\/defaultValue"],"generated":true,"title":"Type Properties","anchor":"Type-Properties"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EnvironmentKey","kind":"identifier"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can create custom environment values by extending the"},{"type":"text","text":" "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues","isActive":true,"type":"reference"},{"type":"text","text":" structure with new properties."},{"type":"text","text":" "},{"type":"text","text":"First declare a new environment key type and specify a value for the"},{"type":"text","text":" "},{"type":"text","text":"required "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentKey\/defaultValue","isActive":true,"type":"reference"},{"type":"text","text":" property:"}]},{"code":["private struct MyEnvironmentKey: EnvironmentKey {","    static let defaultValue: Str