{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ImageRenderer"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Content"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Content"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/View","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI4ViewP","text":"View"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Use "},{"code":"ImageRenderer","type":"codeVoice"},{"type":"text","text":" to export bitmap image data from a OpenSwiftUI view. You"},{"type":"text","text":" "},{"type":"text","text":"initialize the renderer with a view, then render images on demand,"},{"type":"text","text":" "},{"type":"text","text":"either by calling the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ImageRenderer\/render(rasterizationScale:renderer:)"},{"type":"text","text":" method, or"},{"type":"text","text":" "},{"type":"text","text":"by using the renderer’s properties to create a"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/CoreGraphics\/CGImage"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/AppKit\/NSImage"},{"type":"text","text":", or"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/UIKit\/UIImage"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"By drawing to a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Canvas"},{"type":"text","text":" and exporting with an "},{"code":"ImageRenderer","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"you can generate images from any progammatically-rendered content, like"},{"type":"text","text":" "},{"type":"text","text":"paths, shapes, gradients, and more. You can also render standard OpenSwiftUI"},{"type":"text","text":" "},{"type":"text","text":"views like "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text"},{"type":"text","text":" views, or containers of multiple view types."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example uses a private "},{"code":"createAwardView(forUser:date:)","type":"codeVoice"},{"type":"text","text":" method"},{"type":"text","text":" "},{"type":"text","text":"to create a game app’s view of a trophy symbol with a user name and date."},{"type":"text","text":" "},{"type":"text","text":"This view combines a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Canvas"},{"type":"text","text":" that applies a shadow filter with"},{"type":"text","text":" "},{"type":"text","text":"two "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text"},{"type":"text","text":" views into a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/VStack"},{"type":"text","text":". A "},{"code":"Button","type":"codeVoice"},{"type":"text","text":" allows the person to"},{"type":"text","text":" "},{"type":"text","text":"save this view. The button’s action uses an "},{"code":"ImageRenderer","type":"codeVoice"},{"type":"text","text":" to rasterize a"},{"type":"text","text":" "},{"code":"CGImage","type":"codeVoice"},{"type":"text","text":" and then calls a private "},{"code":"uploadAchievementImage(_:)","type":"codeVoice"},{"type":"text","text":" method to"},{"type":"text","text":" "},{"type":"text","text":"encode and upload the image."}],"type":"paragraph"},{"syntax":null,"code":["var body: some View {","    let trophyAndDate = createAwardView(forUser: playerName,","                                         date: achievementDate)","    VStack {","        trophyAndDate","        Button(\"Save Achievement\") {","            let renderer = ImageRenderer(content: trophyAndDate)","            if let image = renderer.cgImage {","                uploadAchievementImage(image)","            }","        }","    }","}","","private func createAwardView(forUser: String, date: Date) -> some View {","    VStack {","        Image(systemName: \"trophy\")","            .resizable()","            .frame(width: 200, height: 200)","            .frame(maxWidth: .infinity, maxHeight: .infinity)","            .shadow(color: .mint, radius: 5)","        Text(playerName)","            .font(.largeTitle)","        Text(achievementDate.formatted())","    }","    .multilineTextAlignment(.center)","    .frame(width: 200, height: 290)","}"],"type":"codeListing"},{"inlineContent":[],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Because "},{"code":"ImageRenderer","type":"codeVoice"},{"type":"text","text":" conforms to"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Combine\/ObservableObject"},{"type":"text","text":", you"},{"type":"text","text":" "},{"type":"text","text":"can use it to produce a stream of images as its properties change. Subscribe"},{"type":"text","text":" "},{"type":"text","text":"to the renderer’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ImageRenderer\/objectWillChange"},{"type":"text","text":" publisher, then use the"},{"type":"text","text":" "},{"type":"text","text":"renderer to rasterize a new image each time the subscriber receives an"},{"type":"text","text":" "},{"type":"text","text":"update."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"ImageRenderer"},{"type":"text","text":" output only includes views that OpenSwiftUI renders,"},{"type":"text","text":" "},{"type":"text","text":"such as text, images, shapes, and composite views of these types. It"},{"type":"text","text":" "},{"type":"text","text":"does not render views provided by native platform frameworks (AppKit and"},{"type":"text","text":" "},{"type":"text","text":"UIKit) such as web views, media players, and some controls. For these views,"},{"type":"text","text":" "},{"type":"codeVoice","code":"ImageRenderer"},{"type":"text","text":" displays a placeholder image, similar to the behavior of"},{"type":"text","text":" "},{"type":"codeVoice","code":"View\/drawingGroup(opaque:colorMode:)"},{"type":"text","text":"."}]}],"name":"Important","style":"important","type":"aside"},{"anchor":"Rendering-to-a-PDF-context","level":3,"text":"Rendering to a PDF context","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ImageRenderer\/render(rasterizationScale:renderer:)"},{"type":"text","text":" method renders the specified"},{"type":"text","text":" "},{"type":"text","text":"view to any"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/CoreGraphics\/CGContext"},{"type":"text","text":". That"},{"type":"text","text":" "},{"type":"text","text":"means you aren’t limited to creating a rasterized "},{"code":"CGImage","type":"codeVoice"},{"type":"text","text":". For"},{"type":"text","text":" "},{"type":"text","text":"example, you can generate PDF data by rendering to a PDF context. The"},{"type":"text","text":" "},{"type":"text","text":"resulting PDF maintains resolution-independence for supported members of the"},{"type":"text","text":" "},{"type":"text","text":"view hierarchy, such as text, symbol images, lines, shapes, and fills."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example uses the "},{"code":"createAwardView(forUser:date:)","type":"codeVoice"},{"type":"text","text":" method from"},{"type":"text","text":" "},{"type":"text","text":"the previous example, and exports its contents as an 800-by-600 point PDF to"},{"type":"text","text":" "},{"type":"text","text":"the file URL "},{"code":"renderURL","type":"codeVoice"},{"type":"text","text":". It uses the "},{"code":"size","type":"codeVoice"},{"type":"text","text":" parameter sent to the"},{"type":"text","text":" "},{"type":"text","text":"rendering closure to center the "},{"code":"trophyAndDate","type":"codeVoice"},{"type":"text","text":" view vertically and"},{"type":"text","text":" "},{"type":"text","text":"horizontally on the page."}],"type":"paragraph"},{"syntax":null,"code":["var body: some View {","    let trophyAndDate = createAwardView(forUser: playerName,","                                        date: achievementDate)","    VStack {","        trophyAndDate","        Button(\"Save Achievement\") {","            let renderer = ImageRenderer(content: trophyAndDate)","            renderer.render { size, renderer in","                var mediaBox = CGRect(origin: .zero,","                                      size: CGSize(width: 800, height: 600))","                guard let consumer = CGDataConsumer(url: renderURL as CFURL),","                      let pdfContext =  CGContext(consumer: consumer,","                                                  mediaBox: &mediaBox, nil)","                else {","                    return","                }","                pdfContext.beginPDFPage(nil)","                pdfContext.translateBy(x: mediaBox.size.width \/ 2 - size.width \/ 2,","                                       y: mediaBox.size.height \/ 2 - size.height \/ 2)","                renderer(pdfContext)","                pdfContext.endPDFPage()","                pdfContext.closePDF()","            }","        }","    }","}"],"type":"codeListing"},{"anchor":"Creating-an-image-from-drawing-instructions","level":3,"text":"Creating an image from drawing instructions","type":"heading"},{"inlineContent":[{"code":"ImageRenderer","type":"codeVoice"},{"type":"text","text":" makes it possible to create a custom image by drawing into a"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Canvas"},{"type":"text","text":", rendering a "},{"code":"CGImage","type":"codeVoice"},{"type":"text","text":" from it, and using that to initialize an"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Image"},{"type":"text","text":". To simplify this process, use the "},{"code":"Image","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"initializer "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Image\/init(size:label:opaque:colorMode:renderer:)"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"takes a closure whose argument is a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/GraphicsContext"},{"type":"text","text":" that you can"},{"type":"text","text":" "},{"type":"text","text":"directly draw into."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"topicSections":[{"generated":true,"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ImageRenderer\/init(content:)"]},{"generated":true,"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ImageRenderer\/allowedDynamicRange","doc:\/\/OpenSwiftUI\/documentat