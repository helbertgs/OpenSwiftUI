{"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ImageRenderer\/init(content:)"]},{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ImageRenderer\/allowedDynamicRange","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ImageRenderer\/colorMode","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ImageRenderer\/content","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ImageRenderer\/image","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ImageRenderer\/isObservationEnabled","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ImageRenderer\/isOpaque","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ImageRenderer\/objectWillChange","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ImageRenderer\/proposedSize","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ImageRenderer\/scale"]},{"generated":true,"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ImageRenderer\/render(rasterizationScale:renderer:)"]},{"generated":true,"anchor":"Type-Aliases","title":"Type Aliases","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ImageRenderer\/ObjectWillChangePublisher"]}],"metadata":{"roleHeading":"Class","symbolKind":"class","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ImageRenderer","kind":"identifier"}],"title":"ImageRenderer","role":"symbol","modules":[{"name":"OpenSwiftUI"}],"navigatorTitle":[{"kind":"identifier","text":"ImageRenderer"}],"externalID":"s:11OpenSwiftUI13ImageRendererC"},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ImageRenderer","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"An object that creates images from OpenSwiftUI views."}],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/OpenSwiftUI\/11OpenCombine16ObservableObjectP"],"kind":"relationships"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ImageRenderer","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Content","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI4ViewP","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/View","text":"View","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"code":"ImageRenderer","type":"codeVoice"},{"text":" to export bitmap image data from a OpenSwiftUI view. You","type":"text"},{"text":" ","type":"text"},{"text":"initialize the renderer with a view, then render images on demand,","type":"text"},{"type":"text","text":" "},{"text":"either by calling the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ImageRenderer\/render(rasterizationScale:renderer:)"},{"text":" method, or","type":"text"},{"text":" ","type":"text"},{"text":"by using the renderer’s properties to create a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/CoreGraphics\/CGImage"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/AppKit\/NSImage"},{"type":"text","text":", or"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/UIKit\/UIImage"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"By drawing to a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Canvas"},{"type":"text","text":" and exporting with an "},{"code":"ImageRenderer","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"you can generate images from any progammatically-rendered content, like"},{"type":"text","text":" "},{"type":"text","text":"paths, shapes, gradients, and more. You can also render standard OpenSwiftUI"},{"type":"text","text":" "},{"type":"text","text":"views like "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text","isActive":true},{"type":"text","text":" views, or containers of multiple view types."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example uses a private "},{"type":"codeVoice","code":"createAwardView(forUser:date:)"},{"type":"text","text":" method"},{"type":"text","text":" "},{"type":"text","text":"to create a game app’s view of a trophy symbol with a user name and date."},{"type":"text","text":" "},{"type":"text","text":"This view combines a "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Canvas","isActive":true},{"type":"text","text":" that applies a shadow filter with"},{"type":"text","text":" "},{"type":"text","text":"two "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text","isActive":true},{"type":"text","text":" views into a "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/VStack","isActive":true},{"type":"text","text":". A "},{"type":"codeVoice","code":"Button"},{"type":"text","text":" allows the person to"},{"type":"text","text":" "},{"text":"save this view. The button’s action uses an ","type":"text"},{"code":"ImageRenderer","type":"codeVoice"},{"type":"text","text":" to rasterize a"},{"type":"text","text":" "},{"type":"codeVoice","code":"CGImage"},{"type":"text","text":" and then calls a private "},{"type":"codeVoice","code":"uploadAchievementImage(_:)"},{"type":"text","text":" method to"},{"type":"text","text":" "},{"type":"text","text":"encode and upload the image."}]},{"type":"codeListing","syntax":null,"code":["var body: some View {","    let trophyAndDate = createAwardView(forUser: playerName,","                                         date: achievementDate)","    VStack {","        trophyAndDate","        Button(\"Save Achievement\") {","            let renderer = ImageRenderer(content: trophyAndDate)","            if let image = renderer.cgImage {","                uploadAchievementImage(image)","            }","        }","    }","}","","private func createAwardView(forUser: String, date: Date) -> some View {","    VStack {","        Image(systemName: \"trophy\")","            .resizable()","            .frame(width: 200, height: 200)","            .frame(maxWidth: .infinity, maxHeight: .infinity)","            .shadow(color: .mint, radius: 5)","        Text(playerName)","            .font(.largeTitle)","        Text(achievementDate.formatted())","    }","    .multilineTextAlignment(.center)","    .frame(width: 200, height: 290)","}"]},{"type":"paragraph","inlineContent":[]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because "},{"type":"codeVoice","code":"ImageRenderer"},{"type":"text","text":" conforms to"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Combine\/ObservableObject"},{"type":"text","text":", you"},{"type":"text","text":" "},{"type":"text","text":"can use it to produce a stream of images as its properties change. Subscribe"},{"type":"text","text":" "},{"type":"text","text":"to the renderer’s "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ImageRenderer\/objectWillChange","isActive":true},{"type":"text","text":" publisher, then use the"},{"type":"text","text":" "},{"type":"text","text":"renderer to rasterize a new image each time the subscriber receives an"},{"type":"text","text":" "},{"type":"text","text":"update."}]},{"name":"Important","type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"ImageRenderer","type":"codeVoice"},{"text":" output only includes views that OpenSwiftUI renders,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"such as text, images, shapes, and composite views of these types. It"},{"type":"text","text":" "},{"type":"text","text":"does not render views provided by native platform frameworks (AppKit and"},{"text":" ","type":"text"},{"type":"text","text":"UIKit) such as web views, media players, and some controls. For these views,"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ImageRenderer"},{"type":"text","text":" displays a placeholder image, similar to the behavior of"},{"type":"text","text":" "},{"type":"codeVoice","code":"View\/drawingGroup(opaque:colorMode:)"},{"text":".","type":"text"}],"type":"paragraph"}],"style":"important"},{"level":3,"anchor":"Rendering-to-a-PDF-context","text":"Rendering to a PDF context","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ImageRenderer\/render(rasterizationScale:renderer:)"},{"type":"text","text":" method renders the specified"},{"type":"text","text":" "},{"type":"text","text":"view to any"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/CoreGraphics\/CGContext"},{"type":"text","text":". That"},{"type":"text","text":" "},{"type":"text","text":"means you aren’t limited to creating a rasterized "},{"type":"codeVoice","code":"CGImage"},{"type":"text","text":". For"},{"type":"text","text":" "},{"text":"example, you can generate PDF data by rendering to a PDF context. The","type":"text"},{"text":" ","type":"text"},{"text":"resulting PDF maintains resolution-independence for supported members of the","type":"text"},{"text":" ","type":"text"},{"text":"view hierarchy, such as text, symbol images, lines, shapes, and fills.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following example uses the ","type":"text"},{"code":"createAwardView(forUser:date:)","type":"codeVoice"},{"type":"text","text":" method from"},{"type":"text","text":" "},{"text":"the previous example, and exports its contents as an 800-by-600 point PDF to","type":"text"},{"type":"text","text":" "},{"text":"the file URL ","type":"text"},{"code":"renderURL","type":"codeVoice"},{"text":". It uses the ","type":"text"},{"type":"codeVoice","code":"size"},{"text":" parameter sent to the","type":"text"},{"text":" ","type":"text"},{"text":"rendering closure to center the ","type":"text"},{"code":"trophyAndDate","type":"codeVoice"},{"text":" view vertically and","type":"text"},{"text":" ","type":"text"},{"text":"horizontally on the page.","type":"text"}],"type":"paragraph"},{"code":["var body: some View {","    let trophyAndDate = createAwardView(forUser: playerName,","                                        date: achievementDate)","    VStack {","        trophyAndDate","        Button(\"Save Achievement\") {","            let renderer = ImageRenderer(content: trophyAndDate)","            renderer.render { size, renderer in","                var mediaBox = CGRect(origin: .zero,","                                      size: CGSize(width: 800, height: 600))","                guard let consumer = CGDataConsumer(url: renderURL as CFURL),","                      let pdfContext =  CGContext(consumer: consumer,","                                                  mediaBox: &mediaBox, nil)","                else {","                    return","                }","                pdfContext.beginPDFPage(nil)","                pdfContext.translateBy(x: mediaBox.size.width \/ 2 - size.width \/ 2,","                                       y: mediaBox.size.height \/ 2 - size.height \/ 2)","                renderer(pdfContext)","                pdfContext.endPDFPage()","                pdfContext.closePDF()","            }","        }","    }","}"],"type":"codeListing","syntax":null},{"anchor":"Creating-an-image-from-drawing-instructions","type":"heading","level":3,"text":"Creating an image from drawing instructions"},{"inlineContent":[{"code":"ImageRenderer","type":"codeVoice"},{"text":" makes it possible to create a custom image by drawing into a","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Canvas"},{"text":", rendering a ","type":"text"},{"code":"CGImage","type":"codeVoice"},{"text":" from it, and using that to initialize an","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Image"},{"text":". To simplify this process, use the ","type":"text"},{"code":"Image","type":"codeVoice"},{"text":" ","type":"text"},{"text":"initializer ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Image\/init(size:label:opaque:colorMode:renderer:)"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"takes a closure whose argument is a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/GraphicsContext"},{"text":" that you can","type":"text"},{"text":" ","type":"text"},{"text":"directly draw into.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/imagerenderer"]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Image/init(size:label:opaque:colorMode:renderer:)":{"fragments