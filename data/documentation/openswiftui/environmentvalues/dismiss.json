{"abstract":[{"type":"text","text":"An action that dismisses the current presentation."}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/environmentvalues\/dismiss"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues"]]},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismiss","interfaceLanguage":"swift"},"metadata":{"symbolKind":"property","roleHeading":"Instance Property","externalID":"s:11OpenSwiftUI17EnvironmentValuesV7dismissAA13DismissActionVvp","modules":[{"name":"OpenSwiftUI"}],"role":"symbol","title":"dismiss","fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"dismiss"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSwiftUI13DismissActionV","kind":"typeIdentifier","text":"DismissAction"}],"extendedModule":"OpenSwiftUI"},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dismiss","kind":"identifier"},{"text":": ","kind":"text"},{"text":"DismissAction","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI13DismissActionV","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this environment value to get the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction","isActive":true},{"type":"text","text":" instance"},{"type":"text","text":" "},{"type":"text","text":"for the current "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","isActive":true},{"type":"text","text":". Then call the instance"},{"type":"text","text":" "},{"type":"text","text":"to perform the dismissal. You call the instance directly because"},{"type":"text","text":" "},{"type":"text","text":"it defines a "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction\/callAsFunction()","isActive":true},{"type":"text","text":" "},{"type":"text","text":"method that Swift calls when you call the instance."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, you can create a button that calls the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction","isActive":true},{"type":"text","text":":"}]},{"syntax":null,"type":"codeListing","code":["private struct SheetContents: View {","    @Environment(\\.dismiss) private var dismiss","","    var body: some View {","        Button(\"Done\") {","            dismiss()","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you present the "},{"type":"codeVoice","code":"SheetContents"},{"type":"text","text":" view in a sheet, the user can dismiss"},{"type":"text","text":" "},{"type":"text","text":"the sheet by tapping or clicking the sheet’s button:"}]},{"syntax":null,"type":"codeListing","code":["private struct DetailView: View {","    @State private var isSheetPresented = false","","    var body: some View {","        Button(\"Show Sheet\") {","            isSheetPresented = true","        }","        .sheet(isPresented: $isSheetPresented) {","            SheetContents()","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Be sure that you define the action in the appropriate environment."},{"type":"text","text":" "},{"type":"text","text":"For example, don’t reorganize the "},{"type":"codeVoice","code":"DetailView"},{"type":"text","text":" in the example above"},{"type":"text","text":" "},{"type":"text","text":"so that it creates the "},{"type":"codeVoice","code":"dismiss"},{"type":"text","text":" property and calls it from the"},{"type":"text","text":" "},{"type":"codeVoice","code":"View\/sheet(item:onDismiss:content:)"},{"type":"text","text":" view modifier’s "},{"type":"codeVoice","code":"content"},{"type":"text","text":" "},{"type":"text","text":"closure:"}]},{"syntax":null,"type":"codeListing","code":["private struct DetailView: View {","    @State private var isSheetPresented = false","    @Environment(\\.dismiss) private var dismiss \/\/ Applies to DetailView.","","    var body: some View {","        Button(\"Show Sheet\") {","            isSheetPresented = true","        }","        .sheet(isPresented: $isSheetPresented) {","            Button(\"Done\") {","                dismiss() \/\/ Fails to dismiss the sheet.","            }","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you do this, the sheet fails to dismiss because the action applies"},{"type":"text","text":" "},{"type":"text","text":"to the environment where you declared it, which is that of the detail"},{"type":"text","text":" "},{"type":"text","text":"view, rather than the sheet. In fact, if you’ve presented the detail"},{"type":"text","text":" "},{"type":"text","text":"view in a "},{"type":"codeVoice","code":"NavigationView"},{"type":"text","text":", the dismissal pops the detail view"},{"type":"text","text":" "},{"type":"text","text":"the navigation stack."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The dismiss action has no effect on a view that isn’t currently"},{"type":"text","text":" "},{"type":"text","text":"presented. If you need to query whether OpenSwiftUI is currently presenting"},{"type":"text","text":" "},{"type":"text","text":"a view, read the "},{"type":"codeVoice","code":"EnvironmentValues\/isPresented"},{"type":"text","text":" environment value."}]}],"kind":"content"}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","type":"topic","kind":"symbol","abstract":[],"title":"OpenSwiftUI","url":"\/documentation\/openswiftui"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/DismissAction/callAsFunction()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"callAsFunction"},{"kind":"text","text":"()"}],"url":"\/documentation\/openswiftui\/dismissaction\/callasfunction()","type":"topic","title":"callAsFunction()","kind":"symbol","abstract":[{"type":"text","text":"Dismisses the view if it is currently presented."}],"role":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction\/callAsFunction()"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Environment":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Environment","kind":"identifier"}],"kind":"symbol","title":"Environment","type":"topic","url":"\/documentation\/openswiftui\/environment","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","abstract":[{"type":"text","text":"A property wrapper that reads a value from a view’s environment."}],"role":"symbol","navigatorTitle":[{"text":"Environment","kind":"identifier"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues":{"abstract":[{"type":"text","text":"OpenSwiftUI exposes a collection of values to your app’s views in an"},{"type":"text","text":" "},{"type":"codeVoice","code":"EnvironmentValues"},{"type":"text","text":" structure. To read a value from the structure,"},{"type":"text","text":" "},{"type":"text","text":"declare a property using the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","isActive":true},{"type":"text","text":" property wrapper and"},{"type":"text","text":" "},{"type":"text","text":"specify the value’s key path. For example, you can read the current locale:"}],"kind":"symbol","navigatorTitle":[{"text":"EnvironmentValues","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues","title":"EnvironmentValues","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EnvironmentValues","kind":"identifier"}],"url":"\/documentation\/openswiftui\/environmentvalues"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/DismissAction":{"abstract":[{"type":"text","text":"An action that dismisses a presentation."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"DismissAction"}],"type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction","title":"DismissAction","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DismissAction"}],"url":"\/documentation\/openswiftui\/dismissaction"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues/dismiss":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismiss","role":"symbol","kind":"symbol","type":"topic","abstract":[{"text":"An action that dismisses the current presentation.","type":"text"}],"title":"dismiss","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dismiss","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI13DismissActionV","text":"DismissAction","kind":"typeIdentifier"}],"url":"\/documentation\/openswiftui\/environmentvalues\/dismiss"}}}