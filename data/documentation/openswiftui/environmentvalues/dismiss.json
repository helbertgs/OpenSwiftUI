{"metadata":{"extendedModule":"OpenSwiftUI","role":"symbol","symbolKind":"property","externalID":"s:11OpenSwiftUI17EnvironmentValuesV7dismissAA13DismissActionVvp","modules":[{"name":"OpenSwiftUI"}],"roleHeading":"Instance Property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dismiss","kind":"identifier"},{"text":": ","kind":"text"},{"text":"DismissAction","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI13DismissActionV"}],"title":"dismiss"},"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismiss"},"abstract":[{"text":"An action that dismisses the current presentation.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dismiss","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction","text":"DismissAction","preciseIdentifier":"s:11OpenSwiftUI13DismissActionV","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"text":"Use this environment value to get the ","type":"text"},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction","isActive":true},{"text":" instance","type":"text"},{"text":" ","type":"text"},{"text":"for the current ","type":"text"},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","isActive":true},{"text":". Then call the instance","type":"text"},{"text":" ","type":"text"},{"text":"to perform the dismissal. You call the instance directly because","type":"text"},{"text":" ","type":"text"},{"text":"it defines a ","type":"text"},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction\/callAsFunction()","isActive":true},{"text":" ","type":"text"},{"text":"method that Swift calls when you call the instance.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For example, you can create a button that calls the ","type":"text"},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction","isActive":true},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["private struct SheetContents: View {","    @Environment(\\.dismiss) private var dismiss","","    var body: some View {","        Button(\"Done\") {","            dismiss()","        }","    }","}"]},{"inlineContent":[{"text":"If you present the ","type":"text"},{"type":"codeVoice","code":"SheetContents"},{"text":" view in a sheet, the user can dismiss","type":"text"},{"text":" ","type":"text"},{"text":"the sheet by tapping or clicking the sheet’s button:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["private struct DetailView: View {","    @State private var isSheetPresented = false","","    var body: some View {","        Button(\"Show Sheet\") {","            isSheetPresented = true","        }","        .sheet(isPresented: $isSheetPresented) {","            SheetContents()","        }","    }","}"]},{"inlineContent":[{"text":"Be sure that you define the action in the appropriate environment.","type":"text"},{"text":" ","type":"text"},{"text":"For example, don’t reorganize the ","type":"text"},{"code":"DetailView","type":"codeVoice"},{"text":" in the example above","type":"text"},{"text":" ","type":"text"},{"text":"so that it creates the ","type":"text"},{"code":"dismiss","type":"codeVoice"},{"text":" property and calls it from the","type":"text"},{"text":" ","type":"text"},{"code":"View\/sheet(item:onDismiss:content:)","type":"codeVoice"},{"text":" view modifier’s ","type":"text"},{"code":"content","type":"codeVoice"},{"text":" ","type":"text"},{"text":"closure:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["private struct DetailView: View {","    @State private var isSheetPresented = false","    @Environment(\\.dismiss) private var dismiss \/\/ Applies to DetailView.","","    var body: some View {","        Button(\"Show Sheet\") {","            isSheetPresented = true","        }","        .sheet(isPresented: $isSheetPresented) {","            Button(\"Done\") {","                dismiss() \/\/ Fails to dismiss the sheet.","            }","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"If you do this, the sheet fails to dismiss because the action applies"},{"type":"text","text":" "},{"type":"text","text":"to the environment where you declared it, which is that of the detail"},{"type":"text","text":" "},{"type":"text","text":"view, rather than the sheet. In fact, if you’ve presented the detail"},{"type":"text","text":" "},{"type":"text","text":"view in a "},{"type":"codeVoice","code":"NavigationView"},{"type":"text","text":", the dismissal pops the detail view"},{"type":"text","text":" "},{"type":"text","text":"the navigation stack."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The dismiss action has no effect on a view that isn’t currently"},{"type":"text","text":" "},{"type":"text","text":"presented. If you need to query whether OpenSwiftUI is currently presenting"},{"type":"text","text":" "},{"type":"text","text":"a view, read the "},{"type":"codeVoice","code":"EnvironmentValues\/isPresented"},{"type":"text","text":" environment value."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/environmentval