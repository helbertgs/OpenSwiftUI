{"kind":"symbol","metadata":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dismiss"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI13DismissActionV","text":"DismissAction"}],"modules":[{"name":"OpenSwiftUI"}],"role":"symbol","extendedModule":"OpenSwiftUI","title":"dismiss","roleHeading":"Instance Property","externalID":"s:11OpenSwiftUI17EnvironmentValuesV7dismissAA13DismissActionVvp","symbolKind":"property"},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dismiss"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction","text":"DismissAction","preciseIdentifier":"s:11OpenSwiftUI13DismissActionV"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this environment value to get the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction"},{"type":"text","text":" instance"},{"type":"text","text":" "},{"type":"text","text":"for the current "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment"},{"type":"text","text":". Then call the instance"},{"type":"text","text":" "},{"type":"text","text":"to perform the dismissal. You call the instance directly because"},{"type":"text","text":" "},{"type":"text","text":"it defines a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction\/callAsFunction()"},{"type":"text","text":" "},{"type":"text","text":"method that Swift calls when you call the instance."}]},{"type":"paragraph","inlineContent":[{"text":"For example, you can create a button that calls the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction"},{"text":":","type":"text"}]},{"code":["private struct SheetContents: View {","    @Environment(\\.dismiss) private var dismiss","","    var body: some View {","        Button(\"Done\") {","            dismiss()","        }","    }","}"],"type":"codeListing","syntax":null},{"type":"paragraph","inlineContent":[{"text":"If you present the ","type":"text"},{"type":"codeVoice","code":"SheetContents"},{"text":" view in a sheet, the user can dismiss","type":"text"},{"text":" ","type":"text"},{"text":"the sheet by tapping or clicking the sheet’s button:","type":"text"}]},{"code":["private struct DetailView: View {","    @State private var isSheetPresented = false","","    var body: some View {","        Button(\"Show Sheet\") {","            isSheetPresented = true","        }","        .sheet(isPresented: $isSheetPresented) {","            SheetContents()","        }","    }","}"],"type":"codeListing","syntax":null},{"type":"paragraph","inlineContent":[{"text":"Be sure that you define the action in the appropriate environment.","type":"text"},{"text":" ","type":"text"},{"text":"For example, don’t reorganize the ","type":"text"},{"type":"codeVoice","code":"DetailView"},{"text":" in the example above","type":"text"},{"text":" ","type":"text"},{"text":"so that it creates the ","type":"text"},{"type":"codeVoice","code":"dismiss"},{"text":" property and calls it from the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"View\/sheet(item:onDismiss:content:)"},{"text":" view modifier’s ","type":"text"},{"type":"codeVoice","code":"content"},{"text":" ","type":"text"},{"text":"closure:","type":"text"}]},{"code":["private struct DetailView: View {","    @State private var isSheetPresented = false","    @Environment(\\.dismiss) private var dismiss \/\/ Applies to DetailView.","","    var body: some View {","        Button(\"Show Sheet\") {","            isSheetPresented = true","        }","        .sheet(isPresented: $isSheetPresented) {","            Button(\"Done\") {","                dismiss() \/\/ Fails to dismiss the sheet.","            }","        }","    }","}"],"type":"codeListing","syntax":null},{"type":"paragraph","inlineContent":[{"text":"If you do this, the sheet fails to dismiss because the action applies","type":"text"},{"text":" ","type":"text"},{"text":"to the environment where you declared it, which is that of the detail","type":"text"},{"text":" ","type":"text"},{"text":"view, rather than the sheet. In fact, if you’ve presented the detail","type":"text"},{"text":" ","type":"text"},{"text":"view in a ","type":"text"},{"type":"codeVoice","code":"NavigationView"},{"text":", the dismissal pops the detail view","type":"text"},{"text":" ","type":"text"},{"text":"the navigation stack.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The dismiss action has no effect on a view that isn’t currently","type":"text"},{"text":" ","type":"text"},{"text":"presented. If you need to query whether OpenSwiftUI is currently presenting","type":"text"},{"text":" ","type":"text"},{"text":"a view, read the ","type":"text"},{"type":"codeVoice","code":"EnvironmentValues\/isPresented"},{"text":" environment value.","type":"text"}]}]}],"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismiss","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/environmentvalues\/dismiss"]}],"sections":[],"abstract":[{"type":"text","text":"An action that dismisses the current presentation."}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues"]]},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","title":"OpenSwiftUI","abstract":[],"type":"topic","kind":"symbol","url":"\/documentation\/openswiftui","role":"collection"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/DismissAction/callAsFunction()":{"type":"topic","title":"callAsFunction()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"callAsFunction","kind":"identifier"},{"text":"()","kind":"text"}],"abstract":[{"type":"text","text":"Dismisses the view if it is currently presented."}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction\/callAsFunction()","kind":"symbol","url":"\/documentation\/openswiftui\/dismissaction\/callasfunction()"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EnvironmentValues","kind":"identifier"}],"role":"symbol","title":"EnvironmentValues","kind":"symbol","abstract":[{"type":"text","text":"OpenSwiftUI exposes a collection of values to your app’s views in an"},{"type":"text","text":" "},{"code":"EnvironmentValues","type":"codeVoice"},{"type":"text","text":" structure. To read a value from the structure,"},{"type":"text","text":" "},{"type":"text","text":"declare a property using the "},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","type":"reference"},{"type":"text","text":" property wrapper and"},{"type":"text","text":" "},{"type":"text","text":"specify the value’s key path. For example, you can read the current locale:"}],"url":"\/documentation\/openswiftui\/environmentvalues","navigatorTitle":[{"text":"EnvironmentValues","kind":"identifier"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues","type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/DismissAction":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DismissAction"}],"navigatorTitle":[{"kind":"identifier","text":"DismissAction"}],"type":"topic","role":"symbol","abstract":[{"text":"An action that dismisses a presentation.","type":"text"}],"title":"DismissAction","url":"\/documentation\/openswiftui\/dismissaction","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction","kind":"symbol"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Environment":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","type":"topic","abstract":[{"type":"text","text":"A property wrapper that reads a value from a view’s environment."}],"url":"\/documentation\/openswiftui\/environment","kind":"symbol","navigatorTitle":[{"text":"Environment","kind":"identifier"}],"role":"symbol","title":"Environment","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Environment","kind":"identifier"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues/dismiss":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dismiss"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI13DismissActionV","text":"DismissAction"}],"type":"topic","role":"symbol","abstract":[{"type":"text","text":"An action that dismisses the current presentation."}],"title":"dismiss","url":"\/documentation\/openswiftui\/environmentvalues\/dismiss","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismiss","kind":"symbol"}}}