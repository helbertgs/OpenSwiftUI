{"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"An action that dismisses the current presentation."}],"metadata":{"symbolKind":"property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dismiss"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"DismissAction","preciseIdentifier":"s:11OpenSwiftUI13DismissActionV"}],"roleHeading":"Instance Property","extendedModule":"OpenSwiftUI","title":"dismiss","modules":[{"name":"OpenSwiftUI"}],"externalID":"s:11OpenSwiftUI17EnvironmentValuesV7dismissAA13DismissActionVvp","role":"symbol"},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dismiss"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction","text":"DismissAction","preciseIdentifier":"s:11OpenSwiftUI13DismissActionV"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"platforms":["macOS"]}]},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Use this environment value to get the ","type":"text"},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction","isActive":true},{"text":" instance","type":"text"},{"text":" ","type":"text"},{"text":"for the current ","type":"text"},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","isActive":true},{"text":". Then call the instance","type":"text"},{"text":" ","type":"text"},{"text":"to perform the dismissal. You call the instance directly because","type":"text"},{"text":" ","type":"text"},{"text":"it defines a ","type":"text"},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction\/callAsFunction()","isActive":true},{"text":" ","type":"text"},{"text":"method that Swift calls when you call the instance.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, you can create a button that calls the "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction","type":"reference","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","code":["private struct SheetContents: View {","    @Environment(\\.dismiss) private var dismiss","","    var body: some View {","        Button(\"Done\") {","            dismiss()","        }","    }","}"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you present the "},{"type":"codeVoice","code":"SheetContents"},{"type":"text","text":" view in a sheet, the user can dismiss"},{"type":"text","text":" "},{"type":"text","text":"the sheet by tapping or clicking the sheet’s button:"}]},{"type":"codeListing","code":["private struct DetailView: View {","    @State private var isSheetPresented = false","","    var body: some View {","        Button(\"Show Sheet\") {","            isSheetPresented = true","        }","        .sheet(isPresented: $isSheetPresented) {","            SheetContents()","        }","    }","}"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"Be sure that you define the action in the appropriate environment."},{"type":"text","text":" "},{"type":"text","text":"For example, don’t reorganize the "},{"type":"codeVoice","code":"DetailView"},{"type":"text","text":" in the example above"},{"type":"text","text":" "},{"type":"text","text":"so that it creates the "},{"type":"codeVoice","code":"dismiss"},{"type":"text","text":" property and calls it from the"},{"type":"text","text":" "},{"type":"codeVoice","code":"View\/sheet(item:onDismiss:content:)"},{"type":"text","text":" view modifier’s "},{"type":"codeVoice","code":"content"},{"type":"text","text":" "},{"type":"text","text":"closure:"}]},{"type":"codeListing","code":["private struct DetailView: View {","    @State private var isSheetPresented = false","    @Environment(\\.dismiss) private var dismiss \/\/ Applies to DetailView.","","    var body: some View {","        Button(\"Show Sheet\") {","            isSheetPresented = true","        }","        .sheet(isPresented: $isSheetPresented) {","            Button(\"Done\") {","                dismiss() \/\/ Fails to dismiss the sheet.","            }","        }","    }","}"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you do this, the sheet fails to dismiss because the action applies"},{"type":"text","text":" "},{"type":"text","text":"to the environment where you declared it, which is that of the detail"},{"type":"text","text":" "},{"type":"text","text":"view, rather than the sheet. In fact, if you’ve presented the detail"},{"type":"text","text":" "},{"type":"text","text":"view in a "},{"type":"codeVoice","code":"NavigationView"},{"type":"text","text":", the dismissal pops the detail view"},{"type":"text","text":" "},{"type":"text","text":"the navigation stack."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The dismiss action has no effect on a view that isn’t currently"},{"type":"text","text":" "},{"type":"text","text":"presented. If you need to query whether OpenSwiftUI is currently presenting"},{"type":"text","text":" "},{"type":"text","text":"a view, read the "},{"type":"codeVoice","code":"EnvironmentValues\/isPresented"},{"type":"text","text":" environment value."}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismiss"},"sections":[],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/environmentvalues\/dismiss"]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/DismissAction":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DismissAction","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction","navigatorTitle":[{"text":"DismissAction","kind":"identifier"}],"title":"DismissAction","abstract":[{"text":"An action that dismisses a presentation.","type":"text"}],"url":"\/documentation\/openswiftui\/dismissaction"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/DismissAction/callAsFunction()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"callAsFunction"},{"kind":"text","text":"()"}],"kind":"symbol","url":"\/documentation\/openswiftui\/dismissaction\/callasfunction()","role":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction\/callAsFunction()","type":"topic","title":"callAsFunction()","abstract":[{"type":"text","text":"Dismisses the view if it is currently presented."}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues":{"role":"symbol","navigatorTitle":[{"text":"EnvironmentValues","kind":"identifier"}],"abstract":[{"text":"OpenSwiftUI exposes a collection of values to your app’s views in an","type":"text"},{"text":" ","type":"text"},{"code":"EnvironmentValues","type":"codeVoice"},{"text":" structure. To read a value from the structure,","type":"text"},{"text":" ","type":"text"},{"text":"declare a property using the ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","type":"reference","isActive":true},{"text":" property wrapper and","type":"text"},{"text":" ","type":"text"},{"text":"specify the value’s key path. For example, you can read the current locale:","type":"text"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EnvironmentValues","kind":"identifier"}],"title":"EnvironmentValues","type":"topic","kind":"symbol","url":"\/documentation\/openswiftui\/environmentvalues"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Environment":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Environment","kind":"identifier"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","role":"symbol","type":"topic","url":"\/documentation\/openswiftui\/environment","navigatorTitle":[{"text":"Environment","kind":"identifier"}],"abstract":[{"type":"text","text":"A property wrapper that reads a value from a view’s environment."}],"kind":"symbol","title":"Environment"},"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"kind":"symbol","role":"collection","title":"OpenSwiftUI","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","abstract":[],"type":"topic","url":"\/documentation\/openswiftui"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues/dismiss":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dismiss","kind":"identifier"},{"text":": ","kind":"text"},{"text":"DismissAction","preciseIdentifier":"s:11OpenSwiftUI13DismissActionV","kind":"typeIdentifier"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismiss","title":"dismiss","abstract":[{"text":"An action that dismisses the current presentation.","type":"text"}],"url":"\/documentation\/openswiftui\/environmentvalues\/dismiss","type":"topic"}}}