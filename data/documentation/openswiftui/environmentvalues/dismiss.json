:"text"},{"text":"EnvironmentValues","kind":"identifier"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues","navigatorTitle":[{"text":"EnvironmentValues","kind":"identifier"}],"title":"EnvironmentValues","url":"\/documentation\/openswiftui\/environmentvalues"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/DismissAction":{"url":"\/documentation\/openswiftui\/dismissaction","role":"symbol","title":"DismissAction","abstract":[{"type":"text","text":"An action that dismisses a presentation."}],"kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction","navigatorTitle":[{"kind":"identifier","text":"DismissAction"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DismissAction"}],"type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"title":"OpenSwiftUI","abstract":[],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","type":"topic","url":"\/documentation\/openswiftui","kind":"symbol","role":"collection"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/DismissAction/callAsFunction()":{"url":"\/documentation\/openswiftui\/dismissaction\/callasfunction()","abstract":[{"type":"text","text":"Dismisses the view if it is currently presented."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"callAsFunction"},{"kind":"text","text":"()"}],"title":"callAsFunction()","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction\/callAsFunction()","type":"topic","role":"symbol","kind":"symbol"}}}