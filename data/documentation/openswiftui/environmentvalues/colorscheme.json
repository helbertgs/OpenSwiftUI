{"abstract":[{"text":"The color scheme of this environment.","type":"text"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues"]]},"metadata":{"modules":[{"name":"OpenSwiftUI"}],"externalID":"s:11OpenSwiftUI17EnvironmentValuesV11colorSchemeAA05ColorG0Ovp","title":"colorScheme","role":"symbol","roleHeading":"Instance Property","extendedModule":"OpenSwiftUI","symbolKind":"property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"colorScheme","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI11ColorSchemeO","text":"ColorScheme","kind":"typeIdentifier"}]},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/colorScheme","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"colorScheme","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ColorScheme","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ColorScheme","preciseIdentifier":"s:11OpenSwiftUI11ColorSchemeO","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" ","kind":"text"},{"text":"set","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Read this environment value from within a view to find out if OpenSwiftUI"},{"type":"text","text":" "},{"type":"text","text":"is currently displaying the view using the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ColorScheme\/light"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ColorScheme\/dark"},{"type":"text","text":" appearance. The value that you receive depends on"},{"type":"text","text":" "},{"type":"text","text":"whether the user has enabled Dark Mode, possibly superseded by"},{"type":"text","text":" "},{"type":"text","text":"the configuration of the current presentation’s view hierarchy."}]},{"syntax":null,"code":["@Environment(\\.colorScheme) private var colorScheme","","var body: some View {","    Text(colorScheme == .dark ? \"Dark\" : \"Light\")","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"You can set the ","type":"text"},{"type":"codeVoice","code":"colorScheme"},{"text":" environment value directly,","type":"text"},{"text":" ","type":"text"},{"text":"but that usually isn’t what you want. Doing so changes the color","type":"text"},{"text":" ","type":"text"},{"text":"scheme of the given view and its child views but ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"emphasis"},{"text":" the views","type":"text"},{"text":" ","type":"text"},{"text":"above it in the view hierarchy. Instead, set a color scheme using the","type":"text"},{"type":"text","text":" "},{"code":"View\/preferredColorScheme(_:)","type":"codeVoice"},{"type":"text","text":" modifier, which also propagates the"},{"type":"text","text":" "},{"type":"text","text":"value up through the view hierarchy to the enclosing presentation, like"},{"type":"text","text":" "},{"type":"text","text":"a sheet or a window."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When adjusting your app’s user interface to match the color scheme,"},{"type":"text","text":" "},{"type":"text","text":"consider also checking the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/colorSchemeContrast"},{"type":"text","text":" "},{"type":"text","text":"property, which reflects a system-wide contrast setting that the user"},{"type":"text","text":" "},{"type":"text","text":"controls. For information about using color and contrast in your app,"},{"type":"text","text":" "},{"type":"text","text":"see "},{"isActive":true,"type":"reference","identifier":"https:\/\/developer.apple.com\/design\/human-interface-guidelines\/accessibility\/overview\/color-and-contrast\/"},{"type":"text","text":"."}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If you only need to provide different colors or","type":"text"},{"text":" ","type":"text"},{"text":"images for different color scheme and contrast settings, do that in","type":"text"},{"text":" ","type":"text"},{"text":"your app’s Asset Catalog. See","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Xcode\/Asset-Management","type":"text"},{"text":".","type":"text"}]}],"style":"note","type":"aside","name":"Note"}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"variants":[{"paths":["\/documentation\/openswiftui\/environmentvalues\/colorscheme"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues/colorScheme":{"url":"\/documentation\/openswiftui\/environmentvalues\/colorscheme","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"colorScheme"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSwiftUI11ColorSchemeO","kind":"typeIdentifier","text":"ColorScheme"}],"abstract":[{"text":"The color scheme of this environment.","type":"text"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/colorScheme","title":"colorScheme","type":"topic"},"https://developer.apple.com/design/human-interface-guidelines/accessibility/overview/color-and-contrast/":{"url":"https:\/\/developer.apple.com\/design\/human-interface-guidelines\/accessibility\/overview\/color-and-contrast\/","title":"Color and Contrast","i