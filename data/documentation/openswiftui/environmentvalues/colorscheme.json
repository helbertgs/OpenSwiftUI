{"sections":[],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues"]]},"metadata":{"extendedModule":"OpenSwiftUI","externalID":"s:11OpenSwiftUI17EnvironmentValuesV11colorSchemeAA05ColorG0Ovp","symbolKind":"property","role":"symbol","modules":[{"name":"OpenSwiftUI"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"colorScheme","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI11ColorSchemeO","kind":"typeIdentifier","text":"ColorScheme"}],"title":"colorScheme","roleHeading":"Instance Property"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"colorScheme","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ColorScheme","preciseIdentifier":"s:11OpenSwiftUI11ColorSchemeO","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ColorScheme","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" ","kind":"text"},{"text":"set","kind":"keyword"},{"text":" }","kind":"text"}]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"inlineContent":[{"type":"text","text":"Read this environment value from within a view to find out if OpenSwiftUI"},{"type":"text","text":" "},{"type":"text","text":"is currently displaying the view using the "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ColorScheme\/light","type":"reference","isActive":true},{"type":"text","text":" or"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ColorScheme\/dark"},{"text":" appearance. The value that you receive depends on","type":"text"},{"text":" ","type":"text"},{"text":"whether the user has enabled Dark Mode, possibly superseded by","type":"text"},{"text":" ","type":"text"},{"text":"the configuration of the current presentation’s view hierarchy.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["@Environment(\\.colorScheme) private var colorScheme","","var body: some View {","    Text(colorScheme == .dark ? \"Dark\" : \"Light\")","}"]},{"inlineContent":[{"text":"You can set the ","type":"text"},{"code":"colorScheme","type":"codeVoice"},{"text":" environment value directly,","type":"text"},{"text":" ","type":"text"},{"text":"but that usually isn’t what you want. Doing so changes the color","type":"text"},{"text":" ","type":"text"},{"text":"scheme of the given view and its child views but ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"emphasis"},{"text":" the views","type":"text"},{"text":" ","type":"text"},{"text":"above it in the view hierarchy. Instead, set a color scheme using the","type":"text"},{"text":" ","type":"text"},{"code":"View\/preferredColorScheme(_:)","type":"codeVoice"},{"text":" modifier, which also propagates the","type":"text"},{"text":" ","type":"text"},{"text":"value up through the view hierarchy to the enclosing presentation, like","type":"text"},{"text":" ","type":"text"},{"text":"a sheet or a window.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When adjusting your app’s user interface to match the color scheme,","type":"text"},{"text":" ","type":"text"},{"text":"consider also checking the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/colorSchemeContrast"},{"text":" ","type":"text"},{"text":"property, which reflects a system-wide contrast setting that the user","type":"text"},{"text":" ","type":"text"},{"text":"controls. For information about using color and contrast in your app,","type":"text"},{"text":" ","type":"text"},{"text":"see ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/developer.apple.com\/design\/human-interface-guidelines\/accessibility\/overview\/color-and-contrast\/"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":"If you only need to provide different colors or"},{"type":"text","text":" "},{"type":"text","text":"images for different color scheme and contrast settings, do that in"},{"type":"text","text":" "},{"type":"text","text":"your app’s Asset Catalog. See"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Xcode\/Asset-Management"},{"type":"text","text":"."}],"type":"paragraph"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/openswiftui\/environmentvalues\/colorscheme"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","abstract":[{"type":"text","text":"The color scheme of this environment."}],"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/colorScheme","interfaceLanguage":"swift"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues/colorScheme":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"colorScheme"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSwiftUI11ColorSchemeO","kind":"typeIdentifier","text":"ColorScheme"}],"abstract":[{"text":"The color scheme of this environment.","type":"text"}],"title":"colorScheme","kind":"symbol","url":"\/documentation\/openswiftui\/environmentvalues\/colorscheme","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/colorScheme","role":"symbol"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues/colorSchemeContrast":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"colorSchemeContrast"},{"kind":"text","text":": "},{"kind":"typeIdentifier"