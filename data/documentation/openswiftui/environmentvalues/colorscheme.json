{"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"colorScheme"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ColorScheme","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ColorScheme","preciseIdentifier":"s:11OpenSwiftUI11ColorSchemeO"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" "},{"kind":"keyword","text":"set"},{"kind":"text","text":" }"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Read this environment value from within a view to find out if OpenSwiftUI","type":"text"},{"text":" ","type":"text"},{"text":"is currently displaying the view using the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ColorScheme\/light","type":"reference"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ColorScheme\/dark","type":"reference"},{"text":" appearance. The value that you receive depends on","type":"text"},{"text":" ","type":"text"},{"text":"whether the user has enabled Dark Mode, possibly superseded by","type":"text"},{"text":" ","type":"text"},{"text":"the configuration of the current presentation’s view hierarchy.","type":"text"}]},{"syntax":null,"type":"codeListing","code":["@Environment(\\.colorScheme) private var colorScheme","","var body: some View {","    Text(colorScheme == .dark ? \"Dark\" : \"Light\")","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can set the "},{"type":"codeVoice","code":"colorScheme"},{"type":"text","text":" environment value directly,"},{"type":"text","text":" "},{"type":"text","text":"but that usually isn’t what you want. Doing so changes the color"},{"type":"text","text":" "},{"type":"text","text":"scheme of the given view and its child views but "},{"inlineContent":[{"type":"text","text":"not"}],"type":"emphasis"},{"type":"text","text":" the views"},{"type":"text","text":" "},{"type":"text","text":"above it in the view hierarchy. Instead, set a color scheme using the"},{"text":" ","type":"text"},{"code":"View\/preferredColorScheme(_:)","type":"codeVoice"},{"text":" modifier, which also propagates the","type":"text"},{"text":" ","type":"text"},{"text":"value up through the view hierarchy to the enclosing presentation, like","type":"text"},{"text":" ","type":"text"},{"text":"a sheet or a window.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When adjusting your app’s user interface to match the color scheme,"},{"type":"text","text":" "},{"type":"text","text":"consider also checking the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/colorSchemeContrast","isActive":true},{"type":"text","text":" "},{"type":"text","text":"property, which reflects a system-wide contrast setting that the user"},{"type":"text","text":" "},{"type":"text","text":"controls. For information about using color and contrast in your app,"},{"type":"text","text":" "},{"type":"text","text":"see "},{"type":"reference","identifier":"https:\/\/developer.apple.com\/design\/human-interface-guidelines\/accessibility\/overview\/color-and-contrast\/","isActive":true},{"type":"text","text":"."}]},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If you only need to provide different colors or"},{"type":"text","text":" "},{"type":"text","text":"images for different color scheme and contrast settings, do that in"},{"type":"text","text":" "},{"type":"text","text":"your app’s Asset Catalog. See"},{"type":"text","text":" "},{"type":"text","text":"doc:\