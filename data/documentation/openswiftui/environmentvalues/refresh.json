{"sections":[],"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/environmentvalues\/refresh"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/refresh"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"refresh"},{"kind":"text","text":": "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/RefreshAction","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI13RefreshActionV","text":"RefreshAction"},{"kind":"text","text":"? { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" "},{"kind":"keyword","text":"set"},{"kind":"text","text":" }"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"inlineContent":[{"text":"When this environment value contains an instance of the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/RefreshAction","isActive":true,"type":"reference"},{"text":" structure, certain built-in views in the corresponding","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","isActive":true,"type":"reference"},{"text":" begin offering a refresh capability. They apply the","type":"text"},{"text":" ","type":"text"},{"text":"instance’s handler to any refresh operation that the user initiates.","type":"text"},{"text":" ","type":"text"},{"text":"By default, the environment value is ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":", but you can use the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"View\/refreshable(action:)"},{"text":" modifier to create and store a new","type":"text"},{"text":" ","type":"text"},{"text":"refresh action that uses the handler that you specify:","type":"text"}],"type":"paragraph"},{"code":["List(mailbox.conversations) { conversation in","    ConversationCell(conversation)","}",".refreshable {","    await mailbox.fetch()","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"On iOS and iPadOS, the "},{"type":"codeVoice","code":"List"},{"type":"text","text":" in the example above offers a"},{"type":"text","text":" "},{"type":"text","text":"pull to refresh gesture because it detects the refresh action. When"},{"type":"text","text":" "},{"type":"text","text":"the user drags the list down and releases, the list calls the action’s"},{"type":"text","text":" "},{"type":"text","text":"handler. Because SwiftUI declares the handler as asynchronous, it can"},{"type":"text","text":" "},{"type":"text","text":"safely make long-running asynchronous calls, like fetching network data."}],"type":"paragraph"},{"text":"Refreshing Custom Views","type":"heading","level":3,"anchor":"Refreshing-Custom-Views"},{"inlineContent":[{"text":"You can also offer refresh capability in your custom views.","type":"text"},{"text":" ","type":"text"},{"text":"Read the ","type":"text"},{"type":"codeVoice","code":"refresh"},{"text":" environment value to get the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/RefreshAction","type":"reference"},{"text":" ","type":"text"},{"text":"instance for a given ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","type":"reference"},{"text":". If you find","type":"text"},{"text":" ","type":"text"},{"text":"a non-","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" value, change your view’s appearance or behavior to offer","type":"text"},{"text":" ","type":"text"},{"text":"the refresh to the user, and call the instance to conduct the","type":"text"},{"text":" ","type":"text"},{"text":"refresh. You can call the refresh instance directly because it defines","type":"text"},{"text":" ","type":"text"},{"text":"a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/RefreshAction\/callAsFunction()","type":"reference"},{"text":" method that Swift calls","type":"text"},{"text":" ","type":"text"},{"text":"when you call the instance:","type":"text"}],"type":"paragraph"},{"code":["struct RefreshableView: View {","    @Environment(\\.refresh) private var refresh","","    var body: some View {","        Button(\"Refresh\") {","            Task {","                await refresh?()","            }","        }","        .disabled(refresh == nil)","    }","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Be sure to call the handler asynchronously by preceding it"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":"await"},{"type":"text","text":". Because the call is asynchronous, you can use"},{"type":"text","text":" "},{"type":"text","text":"its lifetime to indicate progress to the user. For example,"},{"type":"text","text":" "},{"type":"text","text":"you can reveal an indeterminate "},{"type":"codeVoice","code":"ProgressView"},{"type":"text","text":" before"},{"type":"text","text":" "},{"type":"text","text":"calling the handler, and hide it when the handler completes."}],"type":"paragraph"},{"inlineContent":[{"text":"If your code isn’t already in an asynchronous context, create a","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Swift\/Task","type":"text"},{"text":" for the","type":"text"},{"text":" ","type":"text"},{"text":"method to run in. If you do this, consider adding a way for the","type":"text"},{"text":" ","type":"text"},{"text":"user to cancel the task. For more information, see","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"https:\/\/docs.swift.org\/swift-book\/LanguageGuide\/Concurrency.html","isActive":true},{"text":" ","type":"text"},{"text":"in ","type":"text"},{"inlineContent":[{"type":"text","text":"The Swift Programming Language"}],"type":"emphasis"},{"text":".","type":"text"}],"type":"paragraph"}]}],"metadata":{"externalID":"s:11OpenSwiftUI17EnvironmentValuesV7refreshAA13RefreshActionVSgvp","roleHeading":"Instance Property","extendedModule":"OpenSwiftUI","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"refresh","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI13RefreshActionV","text":"RefreshAction","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"refresh","symbolKind":"property","modules":[{"name":"OpenSwiftUI"}]},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues"]]},"abstract":[{"type":"text","text":"A refresh action stored in a view’s environment."}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/RefreshAction":{"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RefreshAction"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/RefreshAction","navigatorTitle":[{"kind":"identifier","text":"RefreshAction"}],"type":"topic","title":"RefreshAction","abstract":[{"type":"text","text":"An action that initiates a refresh operation."}],"url":"\/documentation\/openswiftui\/refreshaction"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues/refresh":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"refresh","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI13RefreshActionV","text":"RefreshAction","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"refresh","abstract":[{"text":"A refresh action stored in a view’s environment.","type":"text"}],"type":"topic","url":"\/documentation\/openswiftui\/environmentvalues\/refresh","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/refresh","role":"symbol"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/RefreshAction/callAsFunction()":{"type":"topic","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/RefreshAction\/callAsFunction()","abstract":[{"text":"Initiates a refresh action.","type":"text"}],"role":"symbol","url":"\/documentation\/openswiftui\/refreshaction\/callasfunction()","title":"callAsFunction()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"callAsFunction"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues":{"url":"\/documentation\/openswiftui\/environmentvalues","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EnvironmentValues"}],"abstract":[{"type":"text","text":"OpenSwiftUI exposes a collection of values to your app’s views in an"},{"type":"text","text":" "},{"type":"codeVoice","code":"EnvironmentValues"},{"text":" structure. To read a value from the structure,","type":"text"},{"text":" ","type":"text"},{"text":"declare a property using the ","type":"text"},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","isActive":true},{"text":" property wrapper and","type":"text"},{"text":" ","type":"text"},{"text":"specify the value’s key path. For example, you can read the current locale:","type":"text"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues","title":"EnvironmentValues","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"EnvironmentValues"}],"type":"topic","kind":"symbol"},"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"abstract":[],"kind":"symbol","url":"\/documentation\/openswiftui","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","type":"topic","title":"OpenSwiftUI"},"https://docs.swift.org/swift-book/LanguageGuide/Concurrency.html":{"titleInlineContent":[{"text":"Concurrency","type":"text"}],"type":"link","title":"Concurrency","identifier":"https:\/\/docs.swift.org\/swift-book\/LanguageGuide\/Concurrency.html","url":"https:\/\/docs.swift.org\/swift-book\/LanguageGuide\/Concurrency.html"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Environment":{"kind":"symbol","title":"Environment","url":"\/documentation\/openswiftui\/environment","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Environment","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"Environment","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","abstract":[{"text":"A property wrapper that reads a value from a view’s environment.","type":"text"}]}}}