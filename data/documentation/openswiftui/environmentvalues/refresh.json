{"abstract":[{"type":"text","text":"A refresh action stored in a view’s environment."}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/environmentvalues\/refresh"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues"]]},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/refresh","interfaceLanguage":"swift"},"metadata":{"symbolKind":"property","roleHeading":"Instance Property","externalID":"s:11OpenSwiftUI17EnvironmentValuesV7refreshAA13RefreshActionVSgvp","modules":[{"name":"OpenSwiftUI"}],"role":"symbol","title":"refresh","fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"refresh"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSwiftUI13RefreshActionV","kind":"typeIdentifier","text":"RefreshAction"},{"kind":"text","text":"?"}],"extendedModule":"OpenSwiftUI"},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"refresh","kind":"identifier"},{"text":": ","kind":"text"},{"text":"RefreshAction","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI13RefreshActionV","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/RefreshAction"},{"text":"? { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" ","kind":"text"},{"text":"set","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"When this environment value contains an instance of the","type":"text"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/RefreshAction","isActive":true},{"type":"text","text":" structure, certain built-in views in the corresponding"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","isActive":true},{"type":"text","text":" begin offering a refresh capability. They apply the"},{"type":"text","text":" "},{"type":"text","text":"instance’s handler to any refresh operation that the user initiates."},{"type":"text","text":" "},{"type":"text","text":"By default, the environment value is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", but you can use the"},{"type":"text","text":" "},{"type":"codeVoice","code":"View\/refreshable(action:)"},{"text":" modifier to create and store a new","type":"text"},{"text":" ","type":"text"},{"text":"refresh action that uses the handler that you specify:","type":"text"}]},{"code":["List(mailbox.conversations) { conversation in","    ConversationCell(conversation)","}",".refreshable {","    await mailbox.fetch()","}"],"type":"codeListing","syntax":null},{"inlineContent":[{"type":"text","text":"On iOS and iPadOS, the "},{"type":"codeVoice","code":"List"},{"type":"text","text":" in the example above offers a"},{"type":"text","text":" "},{"type":"text","text":"pull to refresh gesture because it detects the refresh action. When"},{"type":"text","text":" "},{"type":"text","text":"the user drags the list down and releases, the list calls the action’s"},{"type":"text","text":" "},{"type":"text","text":"handler. Because OpenSwiftUI declares the handler as asynchronous, it can"},{"type":"text","text":" "},{"type":"text","text":"safely make long-running asynchronous calls, like fetching network data."}],"type":"paragraph"},{"level":3,"anchor":"Refreshing-Custom-Views","type":"heading","text":"Refreshing Custom Views"},{"inlineContent":[{"type":"text","text":"You can also offer refresh capability in your custom views."},{"type":"text","text":" "},{"type":"text","text":"Read the "},{"type":"codeVoice","code":"refresh"},{"type":"text","text":" environment value to get the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/RefreshAction","isActive":true},{"type":"text","text":" "},{"type":"text","text":"instance for a given "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","isActive":true},{"type":"text","text":". If you find"},{"type":"text","text":" "},{"type":"text","text":"a non-"},{"type":"codeVoice","code":"nil"},{"type":"text","text":" value, change your view’s appearance or behavior to offer"},{"type":"text","text":" "},{"type":"text","text":"the refresh to the user, and call the instance to conduct the"},{"type":"text","text":" "},{"type":"text","text":"refresh. You can call the refresh instance directly because it defines"},{"type":"text","text":" "},{"type":"text","text":"a "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/RefreshAction\/callAsFunction()","isActive":true},{"type":"text","text":" method that Swift calls"},{"type":"text","text":" "},{"type":"text","text":"when you call the instance:"}],"type":"paragraph"},{"code":["struct RefreshableView: View {","    @Environment(\\.refresh) private var refresh","","    var body: some View {","        Button(\"Refresh\") {","            Task {","                await refresh?()","            }","        }","        .disabled(refresh == nil)","    }","}"],"type":"codeListing","syntax":null},{"inlineContent":[{"type":"text","text":"Be sure to call the handler asynchronously by preceding it"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":"await"},{"type":"text","text":". Because the call is asynchronous, you can use"},{"type":"text","text":" "},{"type":"text","text":"its lifetime to indicate progress to the user. For example,"},{"type":"text","text":" "},{"type":"text","text":"you can reveal an indeterminate "},{"type":"codeVoice","code":"ProgressView"},{"type":"text","text":" before"},{"type":"text","text":" "},{"type":"text","text":"calling the handler, and hide it when the handler completes."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If your code isn’t already in an asynchronous context, create a"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Swift\/Task"},{"type":"text","text":" for the"},{"type":"text","text":" "},{"type":"text","text":"method to run in. If you do this, consider adding a way for the"},{"type":"text","text":" "},{"type":"text","text":"user to cancel the task. For more information, see"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/docs.swift.org\/swift-book\/LanguageGuide\/Concurrency.html","isActive":true},{"type":"text","text":" "},{"type":"text","text":"in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"The Swift Programming Language"}]},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","type":"topic","kind":"symbol","abstract":[],"title":"OpenSwiftUI","url":"\/documentation\/openswiftui"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Environment":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Environment","kind":"identifier"}],"kind":"symbol","title":"Environment","type":"topic","url":"\/documentation\/openswiftui\/environment","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","abstract":[{"type":"text","text":"A property wrapper that reads a value from a view’s environment."}],"role":"symbol","navigatorTitle":[{"text":"Environment","kind":"identifier"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues/refresh":{"abstract":[{"type":"text","text":"A refresh action stored in a view’s environment."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/refresh","title":"refresh","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"refresh","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI13RefreshActionV","text":"RefreshAction","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"url":"\/documentation\/openswiftui\/environmentvalues\/refresh"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/RefreshAction":{"abstract":[{"type":"text","text":"An action that initiates a refresh operation."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"RefreshAction"}],"type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/RefreshAction","title":"RefreshAction","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RefreshAction"}],"url":"\/documentation\/openswiftui\/refreshaction"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/RefreshAction/callAsFunction()":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/RefreshAction\/callAsFunction()","role":"symbol","type":"topic","kind":"symbol","abstract":[{"text":"Initiates a refresh action.","type":"text"}],"title":"callAsFunction()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"callAsFunction","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"}],"url":"\/documentation\/openswiftui\/refreshaction\/callasfunction()"},"https://docs.swift.org/swift-book/LanguageGuide/Concurrency.html":{"titleInlineContent":[{"text":"Concurrency","type":"text"}],"type":"link","title":"Concurrency","url":"https:\/\/docs.swift.org\/swift-book\/LanguageGuide\/Concurrency.html","identifier":"https:\/\/docs.swift.org\/swift-book\/LanguageGuide\/Concurrency.html"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues":{"abstract":[{"type":"text","text":"OpenSwiftUI exposes a collection of values to your app’s views in an"},{"type":"text","text":" "},{"type":"codeVoice","code":"EnvironmentValues"},{"type":"text","text":" structure. To read a value from the structure,"},{"type":"text","text":" "},{"type":"text","text":"declare a property using the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","isActive":true},{"type":"text","text":" property wrapper and"},{"type":"text","text":" "},{"type":"text","text":"specify the value’s key path. For example, you can read the current locale:"}],"kind":"symbol","navigatorTitle":[{"text":"EnvironmentValues","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues","title":"EnvironmentValues","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EnvironmentValues","kind":"identifier"}],"url":"\/documentation\/openswiftui\/environmentvalues"}}}