{"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues"]]},"sections":[],"metadata":{"extendedModule":"OpenSwiftUI","externalID":"s:11OpenSwiftUI17EnvironmentValuesV7openURLAA0A9URLActionVvp","symbolKind":"property","role":"symbol","modules":[{"name":"OpenSwiftUI"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"openURL"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSwiftUI0A9URLActionV","kind":"typeIdentifier","text":"OpenURLAction"}],"title":"openURL","roleHeading":"Instance Property"},"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"openURL"},{"kind":"text","text":": "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction","preciseIdentifier":"s:11OpenSwiftUI0A9URLActionV","kind":"typeIdentifier","text":"OpenURLAction"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Read this environment value to get an "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"instance for a given "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","type":"reference","isActive":true},{"type":"text","text":". Call the"},{"type":"text","text":" "},{"type":"text","text":"instance to open a URL. You call the instance directly because it"},{"type":"text","text":" "},{"type":"text","text":"defines a "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction\/callAsFunction(_:)","type":"reference","isActive":true},{"type":"text","text":" method that Swift"},{"type":"text","text":" "},{"type":"text","text":"calls when you call the instance."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, you can open a web site when the user taps a button:"}]},{"type":"codeListing","syntax":null,"code":["struct OpenURLExample: View {","    @Environment(\\.openURL) private var openURL","","    var body: some View {","        Button {","            if let url = URL(string: \"https:\/\/www.example.com\") {","                openURL(url)","            }","        } label: {","            Label(\"Get Help\", systemImage: \"person.fill.questionmark\")","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you want to know whether the action succeeds, add a completion"},{"type":"text","text":" "},{"type":"text","text":"handler that takes a Boolean value. In this case, Swift implicitly"},{"type":"text","text":" "},{"type":"text","text":"calls the "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction\/callAsFunction(_:completion:)","type":"reference","isActive":true},{"type":"text","text":" method"},{"type":"text","text":" "},{"type":"text","text":"instead. That method calls your completion handler after it determines"},{"type":"text","text":" "},{"type":"text","text":"whether it can open the URL, but possibly before it finishes opening"},{"type":"text","text":" "},{"type":"text","text":"the URL. You can add a handler to the example above so that"},{"type":"text","text":" "},{"type":"text","text":"it prints the outcome to the console:"}]},{"type":"codeListing","syntax":null,"code":["openURL(url) { accepted in","    print(accepted ? \"Success\" : \"Failure\")","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The system provides a default open URL action with behavior"},{"type":"text","text":" "},{"type":"text","text":"that depends on the contents of the URL. For example, the default"},{"type":"text","text":" "},{"type":"text","text":"action opens a Universal Link in the associated app if possible,"},{"type":"text","text":" "},{"type":"text","text":"or in the user’s default web browser if not."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can also set a custom action using the "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/View\/environment(_:_:)","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"view modifier. Any views that read the action from the environment,"},{"type":"text","text":" "},{"type":"text","text":"including the built-in "},{"code":"Link","type":"codeVoice"},{"type":"text","text":" view and "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text","type":"reference","isActive":true},{"type":"text","text":" views with markdown"},{"type":"text","text":" "},{"type":"text","text":"links, or links in attributed strings, use your action. Initialize an"},{"type":"text","text":" "},{"type":"text","text":"action by calling the "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction\/init(handler:)","type":"reference","isActive":true},{"type":"text","text":" initializer with"},{"type":"text","text":" "},{"type":"text","text":"a handler that takes a URL and returns an "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction\/Result","type":"reference","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","syntax":null,"code":["Text(\"Visit [Example Company](https:\/\/www.example.com) for details.\")","    .environment(\\.openURL, OpenURLAction { url in","        handleURL(url) \/\/ Define this method to take appropriate action.","        return .handled","    })"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"OpenSwiftUI translates the value that your custom action’s handler"},{"type":"text","text":" "},{"type":"text","text":"returns into an appropriate Boolean result for the action call."},{"type":"text","text":" "},{"type":"text","text":"For example, a view that uses the action declared above"},{"type":"text","text":" "},{"type":"text","text":"receives "},{"code":"true","type":"codeVoice"},{"type":"text","text":" when calling the action, because the"},{"type":"text","text":" "},{"type":"text","text":"handler always returns "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction\/Result\/handled","type":"reference","isActive":true},{"type":"text","text":"."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/environmentvalues\/openurl"]}],"kind":"symbol","abstract":[{"text":"An action that opens a URL.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/openURL"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EnvironmentValues"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues","role":"symbol","abstract":[{"type":"text","text":"OpenSwiftUI exposes a collection of values to your app’s views in an"},{"type":"text","text":" "},{"type":"codeVoice","code":"EnvironmentValues"},{"type":"text","text":" structure. To read a value from the structure,"},{"type":"text","text":" "},{"type":"text","text":"declare a property using the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","isActive":true},{"type":"text","text":" property wrapper and"},{"type":"text","text":" "},{"type":"text","text":"specify the value’s key path. For example, you can read the current locale:"}],"title":"EnvironmentValues","url":"\/documentation\/openswiftui\/environmentvalues","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"EnvironmentValues"}],"type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/OpenURLAction/Result":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Result","kind":"identifier"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction\/Result","role":"symbol","abstract":[{"type":"text","text":"The result of a custom open URL action."}],"title":"OpenURLAction.Result","url":"\/documentation\/openswiftui\/openurlaction\/result","kind":"symbol","navigatorTitle":[{"text":"Result","kind":"identifier"}],"type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","abstract":[],"title":"OpenSwiftUI","url":"\/documentation\/openswiftui","kind":"symbol","type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues/openURL":{"url":"\/documentation\/openswiftui\/environmentvalues\/openurl","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"openURL","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI0A9URLActionV","text":"OpenURLAction","kind":"typeIdentifier"}],"type":"topic","abstract":[{"type":"text","text":"An action that opens a URL."}],"title":"openURL","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/openURL"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Text":{"url":"\/documentation\/openswiftui\/text","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text","title":"Text","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A view that displays one or more lines of read-only text."}],"navigatorTitle":[{"kind":"identifier","text":"Text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Text","kind":"identifier"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/OpenURLAction/Result/handled":{"url":"\/documentation\/openswi