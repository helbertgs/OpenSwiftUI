{"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"extendedModule":"OpenSwiftUI","role":"symbol","roleHeading":"Instance Property","symbolKind":"property","externalID":"s:11OpenSwiftUI17EnvironmentValuesV7openURLAA0A9URLActionVvp","title":"openURL","modules":[{"name":"OpenSwiftUI"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"openURL"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"OpenURLAction","preciseIdentifier":"s:11OpenSwiftUI0A9URLActionV"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/environmentvalues\/openurl"]}],"abstract":[{"type":"text","text":"An action that opens a URL."}],"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"openURL"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"OpenURLAction","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction","preciseIdentifier":"s:11OpenSwiftUI0A9URLActionV"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"text":"Read this environment value to get an ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"instance for a given ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","isActive":true,"type":"reference"},{"text":". Call the","type":"text"},{"text":" ","type":"text"},{"text":"instance to open a URL. You call the instance directly because it","type":"text"},{"text":" ","type":"text"},{"text":"defines a ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction\/callAsFunction(_:)","isActive":true,"type":"reference"},{"text":" method that Swift","type":"text"},{"text":" ","type":"text"},{"text":"calls when you call the instance.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, you can open a web site when the user taps a button:"}],"type":"paragraph"},{"syntax":null,"code":["struct OpenURLExample: View {","    @Environment(\\.openURL) private var openURL","","    var body: some View {","        Button {","            if let url = URL(string: \"https:\/\/www.example.com\") {","                openURL(url)","            }","        } label: {","            Label(\"Get Help\", systemImage: \"person.fill.questionmark\")","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"If you want to know whether the action succeeds, add a completion"},{"type":"text","text":" "},{"type":"text","text":"handler that takes a Boolean value. In this case, Swift implicitly"},{"type":"text","text":" "},{"type":"text","text":"calls the "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction\/callAsFunction(_:completion:)","type":"reference","isActive":true},{"type":"text","text":" method"},{"type":"text","text":" "},{"type":"text","text":"instead. That method calls your completion handler after it determines"},{"type":"text","text":" "},{"type":"text","text":"whether it can open the URL, but possibly before it finishes opening"},{"type":"text","text":" "},{"type":"text","text":"the URL. You can add a handler to the example above so that"},{"type":"text","text":" "},{"type":"text","text":"it prints the outcome to the console:"}],"type":"paragraph"},{"syntax":null,"code":["openURL(url) { accepted in","    print(accepted ? \"Success\" : \"Failure\")","}"],"type":"codeListing"},{"inlineContent":[{"text":"The system provides a default open URL action with behavior","type":"text"},{"text":" ","type":"text"},{"text":"that depends on the contents of the URL. For example, the default","type":"text"},{"text":" ","type":"text"},{"text":"action opens a Universal Link in the associated app if possible,","type":"text"},{"text":" ","type":"text"},{"text":"or in the user’s default web browser if not.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You can also set a custom action using the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/View\/environment(_:_:)","type":"reference"},{"text":" ","type":"text"},{"text":"view modifier. Any views that read the action from the environment,","type":"text"},{"text":" ","type":"text"},{"text":"including the built-in ","type":"text"},{"code":"Link","type":"codeVoice"},{"text":" view and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text","type":"reference"},{"text":" views with markdown","type":"text"},{"text":" ","type":"text"},{"text":"links, or links in attributed strings, use your action. Initialize an","type":"text"},{"text":" ","type":"text"},{"text":"action by calling the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction\/init(handler:)","type":"reference"},{"text":" initializer with","type":"text"},{"text":" ","type":"text"},{"text":"a handler that takes a URL and returns an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction\/Result","type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["Text(\"Visit [Example Company](https:\/\/www.example.com) for details.\")","    .environment(\\.openURL, OpenURLAction { url in","        handleURL(url) \/\/ Define this method to take appropriate action.","        return .handled","    })"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"SwiftUI translates the value that your custom action’s handler"},{"type":"text","text":" "},{"type":"text","text":"returns into an appropriate Boolean result for the action call."},{"type":"text","text":" "},{"type":"text","text":"For example, a view that uses the action declared above"},{"type":"text","text":" "},{"type":"text","text":"receives "},{"code":"true","type":"codeVoice"},{"type":"text","text":" when calling the action, because the"},{"type":"text","text":" "},{"type":"text","text":"handler always returns "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction\/Result\/handled"},{"type":"text","text":"."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/openURL","interfaceLanguage":"swift"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/OpenURLAction":{"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OpenURLAction","kind":"identifier"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction","navigatorTitle":[{"text":"OpenURLAction","kind":"identifier"}],"type":"topic","title":"OpenURLAction","abstract":[{"text":"An action that opens a URL.","type":"text"}],"url":"\/documentation\/openswiftui\/openurlaction"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/OpenURLAction/callAsFunction(_:)":{"url":"\/documentation\/openswiftui\/openurlaction\/callasfunction(_:)","abstract":[{"type":"text","text":"Opens a URL, following system conventions."}],"kind":"symbol","title":"callAsFunction(_:)","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction\/callAsFunction(_:)","role":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"callAsFunction","kind":"identifier"},{"text":"(","kind":"text"},{"precise