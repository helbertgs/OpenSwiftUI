\/OpenSwiftUI\/Environment","isActive":true},{"text":" property wrapper and","type":"text"},{"text":" ","type":"text"},{"text":"specify the value’s key path. For example, you can read the current locale:","type":"text"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/OpenURLAction/Result":{"navigatorTitle":[{"text":"Result","kind":"identifier"}],"title":"OpenURLAction.Result","role":"symbol","type":"topic","url":"\/documentation\/openswiftui\/openurlaction\/result","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction\/Result","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Result"}],"abstract":[{"type":"text","text":"The result of a custom open URL action."}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues/openURL":{"type":"topic","role":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/openURL","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"openURL","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI0A9URLActionV","kind":"typeIdentifier","text":"OpenURLAction"}],"abstract":[{"type":"text","text":"An action that opens a URL."}],"title":"openURL","url":"\/documentation\/openswiftui\/environmentvalues\/openurl","kind":"symbol"}}}