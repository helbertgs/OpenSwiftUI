s appearance","type":"text"},{"text":" ","type":"text"},{"text":"depends on the shortcut associated with it. On macOS, for example, when","type":"text"},{"text":" ","type":"text"},{"text":"a button is bound to the Return key, it is typically drawn with a","type":"text"},{"text":" ","type":"text"},{"text":"special emphasis. This happens automatically when using the built-in","type":"text"},{"text":" ","type":"text"},{"text":"button styles, and can be implemented manually in custom styles using","type":"text"},{"text":" ","type":"text"},{"text":"this environment key:","type":"text"}],"type":"paragraph"},{"code":["private struct MyButtonStyle: ButtonStyle {","    @Environment(\\.keyboardShortcut)","    private var shortcut: KeyboardShortcut?","","    func makeBody(configuration: Configuration) -> some View {","        let labelFont = Font.body","            .weight(shortcut == .defaultAction ? .bold : .regular)","        configuration.label","            .font(labelFont)","    }","}"],"type":"codeListing","syntax":null},{"inlineContent":[{"type":"text","text":"If no keyboard shortcut has been applied to the view or its ancestor,"},{"type":"text","text":" "},{"type":"text","text":"then the environment value will be "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues":{"role":"symbol","navigatorTitle":[{"text":"EnvironmentValues","kind":"identifier"}],"abstract":[{"text":"OpenSwiftUI exposes a collection of values to your app’s views in an","type":"text"},{"text":" ","type":"text"},{"code":"EnvironmentValues","type":"codeVoice"},{"text":" structure. To read a value from the structure,","type":"text"},{"text":" ","type":"text"},{"text":"declare a property using the ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","type":"reference","isActive":true},{"text":" property wrapper and","type":"text"},{"text":" ","type":"text"},{"text":"specify the value’s key path. For example, you can read the current locale:","type":"text"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EnvironmentValues","kind":"identifier"}],"title":"EnvironmentValues","type":"topic","kind":"symbol","url":"\/documentation\/openswiftui\/environmentvalues"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues/keyboardShortcut":{"role":"symbol","title":"keyboardShortcut","url":"\/documentation\/openswiftui\/environmentvalues\/keyboardshortcut","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"keyboardShortcut"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSwiftUI16KeyboardShortcutV","kind":"typeIdentifier","text":"KeyboardShortcut"},{"kind":"text","text":"?"}],"abstract":[{"type":"text","text":"The keyboard shortcut that buttons in this environment will be triggered"},{"type":"text","text":" "},{"type":"text","text":"with."}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/keyboardShortcut","kind":"symbol"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Environment":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Environment","kind":"identifier"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","role":"symbol","type":"topic","url":"\/documentation\/openswiftui\/environment","navigatorTitle":[{"text":"Environment","kind":"identifier"}],"abstract":[{"type":"text","text":"A property wrapper that reads a value from a view’s environment."}],"kind":"symbol","title":"Environment"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/KeyboardShortcut":{"url":"\/documentation\/openswiftui\/keyboardshortcut","role":"symbol","navigatorTitle":[{"text":"KeyboardShortcut","kind":"identifier"}],"abstract":[{"type":"text","text":"Keyboard 