{"sections":[],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues"]]},"metadata":{"extendedModule":"OpenSwiftUI","externalID":"s:11OpenSwiftUI17EnvironmentValuesV13dismissSearchAA07DismissG6ActionVvp","symbolKind":"property","modules":[{"name":"OpenSwiftUI"}],"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dismissSearch","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI19DismissSearchActionV","text":"DismissSearchAction","kind":"typeIdentifier"}],"title":"dismissSearch","roleHeading":"Instance Property"},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dismissSearch"},{"kind":"text","text":": "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction","preciseIdentifier":"s:11OpenSwiftUI19DismissSearchActionV","kind":"typeIdentifier","text":"DismissSearchAction"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Use this environment value to get the "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction","type":"reference","isActive":true},{"type":"text","text":" instance"},{"type":"text","text":" "},{"type":"text","text":"for the current "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","type":"reference","isActive":true},{"type":"text","text":". Then call the instance to dismiss"},{"type":"text","text":" "},{"type":"text","text":"the current search interaction. You call the instance directly because"},{"type":"text","text":" "},{"type":"text","text":"it defines a "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction\/callAsFunction()","type":"reference","isActive":true},{"type":"text","text":" method that Swift"},{"type":"text","text":" "},{"type":"text","text":"calls when you call the instance."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When you dismiss search, OpenSwiftUI:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"EnvironmentValues\/isSearching"},{"type":"text","text":" to "},{"type":"codeVoice","code":"false"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Clears any text from the search field."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Removes focus from the search field."}]}]}],"type":"unorderedList"},{"name":"Note","style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"Calling this instance has no effect if the user isn’t"},{"type":"text","text":" "},{"type":"text","text":"interacting with a search field."}],"type":"paragraph"}]},{"inlineContent":[{"type":"text","text":"Use this action to dismiss a search operation based on"},{"type":"text","text":" "},{"type":"text","text":"another user interaction. For example, consider a searchable"},{"type":"text","text":" "},{"type":"text","text":"view with a "},{"code":"Button","type":"codeVoice"},{"type":"text","text":" that presents more information about the first"},{"type":"text","text":" "},{"type":"text","text":"matching item from a collection:"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["struct ContentView: View {","    @State private var text = \"\"","","    var body: some View {","        NavigationView {","            SearchResults(searchText: text)","                .searchable(text: $text)","        }","    }","}","","private struct SearchResults: View {","    let searchText: String","","    let items = [\"a\", \"b\", \"c\"]","    var filteredItems: [String] { items.filter { $0 == searchText.lowercased() } }","","    @State private var isPresented = false","","    var body: some View {","        if let item = filteredItems.first {","            Button(\"Details about \\(item)\") {","                isPresented = true","            }","            .sheet(isPresented: $isPresented) {","                NavigationView {","                    DetailView(item: item)","                }","            }","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"The button becomes visible only after the user enters search text"},{"type":"text","text":" "},{"type":"text","text":"that produces a match. When the user taps the button, OpenSwiftUI shows"},{"type":"text","text":" "},{"type":"text","text":"a sheet that provides more information about the item, including"},{"type":"text","text":" "},{"type":"text","text":"an Add button for adding the item to a stored list of items:"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["private struct DetailView: View {","    let item: String","","    @Environment(\\.dismiss) private var dismiss","    @Environment(\\.dismissSearch) private var dismissSearch","","    var body: some View {","        Text(\"Information about \\(item).\")","            .toolbar {","                Button(\"Add\") {","                    \/\/ Store the item here...","","                    dismiss()","                    dismissSearch()","                }","            }","    }","}"]},{"inlineContent":[{"type":"text","text":"The user can dismiss the sheet by dragging it down, effectively"},{"type":"text","text":" "},{"type":"text","text":"canceling the operation, leaving the in-progress search interaction"},{"type":"text","text":" "},{"type":"text","text":"intact. Alternatively, the user can tap the Add button to store the"},{"type":"text","text":" "},{"type":"text","text":"item. Because the user is likely to be done with both the detail view"},{"type":"text","text":" "},{"type":"text","text":"and the search interaction at this point, the button’s closure also"},{"type":"text","text":" "},{"type":"text","text":"uses the "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismiss","type":"reference","isActive":true},{"type":"text","text":" property to dismiss the sheet,"},{"type":"text","text":" "},{"type":"text","text":"and the "},{"code":"dismissSearch","type":"codeVoice"},{"type":"text","text":" property to reset the search field."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/openswiftui\/environmentvalues\/dismisssearch"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","abstract":[{"text":"An action that ends the current search interaction.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismissSearch"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/DismissSearchAction/callAsFunction()":{"fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"callAsFunction","kind":"identifier"},{"text":"()","kind":"text"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction\/callAsFunction()","role":"symbol","abstract":[{"text":"Dismisses the current search operation, if any.","type":"text"}],"title":"callAsFunction()","url":"\/documentation\/openswiftui\/dismisssearchaction\/callasfunction()","kind":"symbol","type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues/dismissSearch":{"url":"\/documentation\/openswiftui\/environmentvalues\/dismisssearch","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dismissSearch","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI19DismissSearchActionV","text":"DismissSearchAction","kind":"typeIdentifier"}],"type":"topic","abstract":[{"type":"text","text":"An action that ends the current search interaction."}],"title":"dismissSearch","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismissSearch"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EnvironmentValues"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues","role":"symbol","abstract":[{"type":"text","text":"OpenSwiftUI exposes a collection of values to your app’s views in an"},{"type":"text","text":" "},{"type":"codeVoice","code":"EnvironmentValues"},{"type":"text","text":" structure. To read a value from the structure,"},{"type":"text","text":" "},{"type":"text","text":"declare a property using the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","isActive":true},{"type":"text","text":" property wrapper and"},{"type":"text","text":" "},{"type":"text","text":"specify the value’s key path. For example, you can read the current locale:"}],"title":"EnvironmentValues","url":"\/documentation\/openswiftui\/environmentvalues","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"EnvironmentValues"}],"type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","abstract":[],"title":"OpenSwiftUI","url":"\/documentation\/openswiftui","kind":"symbol","type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/DismissSearchAction":{"url":"\/documentation\/openswiftui\/dismisssearchaction","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DismissSearchAction","kind":"identifier"}],"type":"topic","kind":"symbol","title":"DismissSearchAction","abstract":[{"text":"An action that can end a search interaction.","type":"text"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction","navigatorTitle":[{"text":"DismissSearchAction","kind":"identifier"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues/dismiss":{"url":"\/documentation\/openswiftui\/environmentvalues\/dismiss","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismiss","title":"dismiss","role":"symbol","abstract":[{"text":"An action that dismisses the current presentation.","type":"text"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dismiss"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSwiftUI13DismissActionV","kind":"typeIdentifier","text":"DismissAction"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Environment":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","url":"\/documentation\/openswiftui\/environment","title":"Environment","role":"symbol","type":"topic","kind":"symbol","abstract":[{"text":"A property wrapper that reads a value from a view’s environment.","type":"text"}],"navigatorTitle":[{"text":"Environment","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Environment","kind":"identifier"}]}}}