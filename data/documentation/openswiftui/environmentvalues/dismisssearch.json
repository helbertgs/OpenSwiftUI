{"sections":[],"variants":[{"paths":["\/documentation\/openswiftui\/environmentvalues\/dismisssearch"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","abstract":[{"text":"An action that ends the current search interaction.","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dismissSearch"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI19DismissSearchActionV","text":"DismissSearchAction","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"Use this environment value to get the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction","isActive":true},{"type":"text","text":" instance"},{"type":"text","text":" "},{"type":"text","text":"for the current "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","isActive":true},{"type":"text","text":". Then call the instance to dismiss"},{"type":"text","text":" "},{"type":"text","text":"the current search interaction. You call the instance directly because"},{"type":"text","text":" "},{"type":"text","text":"it defines a "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction\/callAsFunction()","isActive":true},{"type":"text","text":" method that Swift"},{"type":"text","text":" "},{"type":"text","text":"calls when you call the instance."}],"type":"paragraph"},{"inlineContent":[{"text":"When you dismiss search, SwiftUI:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Sets ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/isSearching"},{"text":" to ","type":"text"},{"type":"codeVoice","code":"false"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Clears any text from the search field.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Removes focus from the search field."}],"type":"paragraph"}]}]},{"style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":"Calling this instance has no effect if the user isn’t"},{"type":"text","text":" "},{"type":"text","text":"interacting with a search field."}],"type":"paragraph"}],"type":"aside"},{"inlineContent":[{"type":"text","text":"Use this action to dismiss a search operation based on"},{"type":"text","text":" "},{"type":"text","text":"another user interaction. For example, consider a searchable"},{"type":"text","text":" "},{"type":"text","text":"view with a "},{"type":"codeVoice","code":"Button"},{"type":"text","text":" that presents more information about the first"},{"type":"text","text":" "},{"type":"text","text":"matching item from a collection:"}],"type":"paragraph"},{"code":["struct ContentView: View {","    @State private var text = \"\"","","    var body: some View {","        NavigationView {","            SearchResults(searchText: text)","                .searchable(text: $text)","        }","    }","}","","private struct SearchResults: View {","    let searchText: String","","    let items = [\"a\", \"b\", \"c\"]","    var filteredItems: [String] { items.filter { $0 == searchText.lowercased() } }","","    @State private var isPresented = false","","    var body: some View {","        if let item = filteredItems.first {","            Button(\"Details about \\(item)\") {","                isPresented = true","            }","            .sheet(isPresented: $isPresented) {","                NavigationView {","                    DetailView(item: item)","                }","            }","        }","    }","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The button becomes visible only after the user enters search text"},{"type":"text","text":" "},{"type":"text","text":"that produces a match. When the user taps the button, SwiftUI shows"},{"type":"text","text":" "},{"type":"text","text":"a sheet that provides more information about the item, including"},{"type":"text","text":" "},{"type":"text","text":"an Add button for adding the item to a stored list of items:"}],"type":"paragraph"},{"code":["private struct DetailView: View {","    let item: String","","    @Environment(\\.dismiss) private var dismiss","    @Environment(\\.dismissSearch) private var dismissSearch","","    var body: some View {","        Text(\"Information about \\(item).\")","            .toolbar {","                Button(\"Add\") {","                    \/\/ Store the item here...","","                    dismiss()","                    dismissSearch()","                }","            }","    }","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"The user can dismiss the sheet by dragging it down, effectively","type":"text"},{"text":" ","type":"text"},{"text":"canceling the operation, leaving the in-progress search interaction","type":"text"},{"text":" ","type":"text"},{"text":"intact. Alternatively, the user can tap the Add button to store the","type":"text"},{"text":" ","type":"text"},{"text":"item. Because the user is likely to be done with both the detail view","type":"text"},{"text":" ","type":"text"},{"text":"and the search interaction at this point, the button’s closure also","type":"text"},{"text":" ","type":"text"},{"text":"uses the ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismiss","isActive":true,"type":"reference"},{"text":" property to dismiss the sheet,","type":"text"},{"text":" ","type":"text"},{"text":"and the ","type":"text"},{"code":"dismissSearch","type":"codeVoice"},{"text":" property to reset the search field.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dismissSearch","kind":"identifier"},{"text":": ","kind":"text"},{"text":"DismissSearchAction","preciseIdentifier":"s:11OpenSwiftUI19DismissSearchActionV","kind":"typeIdentifier"}],"title":"dismissSearch","role":"symbol","roleHeading":"Instance Property","extendedModule":"OpenSwiftUI","externalID":"s:11OpenSwiftUI17EnvironmentValuesV13dismissSearchAA07DismissG6ActionVvp","modules":[{"name":"OpenSwiftUI"}],"symbolKind":"property"},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismissSearch","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues"]]},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues/dismissSearch":{"role":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismissSearch","title":"dismissSearch","url":"\/documentation\/openswiftui\/environmentvalues\/dismisssearch","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dismissSearch","kind":"identifier"},{"text":": ","kind":"text"},{"text":"DismissSearchAction","preciseIdentifier":"s:11OpenSwiftUI19DismissSearchActionV","kind":"typeIdentifier"}],"kind":"symbol","abstract":[{"text":"An action that ends the current search interaction.","type":"text"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"title":"OpenSwiftUI","abstract":[],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","type":"topic","url":"\/documentation\/openswiftui","kind":"symbol","role":"collection"},"doc: