{"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues"]]},"abstract":[{"text":"An action that ends the current search interaction.","type":"text"}],"variants":[{"paths":["\/documentation\/openswiftui\/environmentvalues\/dismisssearch"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dismissSearch"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"DismissSearchAction","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction","preciseIdentifier":"s:11OpenSwiftUI19DismissSearchActionV"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Use this environment value to get the ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction","isActive":true,"type":"reference"},{"text":" instance","type":"text"},{"text":" ","type":"text"},{"text":"for the current ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","isActive":true,"type":"reference"},{"text":". Then call the instance to dismiss","type":"text"},{"text":" ","type":"text"},{"text":"the current search interaction. You call the instance directly because","type":"text"},{"text":" ","type":"text"},{"text":"it defines a ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissSearchAction\/callAsFunction()","isActive":true,"type":"reference"},{"text":" method that Swift","type":"text"},{"text":" ","type":"text"},{"text":"calls when you call the instance.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"When you dismiss search, SwiftUI:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Sets ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/isSearching","type":"reference"},{"text":" to ","type":"text"},{"code":"false","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Clears any text from the search field.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Removes focus from the search field.","type":"text"}],"type":"paragraph"}]}]},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"Calling this instance has no effect if the user isn’t","type":"text"},{"text":" ","type":"text"},{"text":"interacting with a search field.","type":"text"}]}]},{"type":"paragraph","inlineContent":[{"text":"Use this action to dismiss a search operation based on","type":"text"},{"text":" ","type":"text"},{"text":"another user interaction. For example, consider a searchable","type":"text"},{"text":" ","type":"text"},{"text":"view with a ","type":"text"},{"code":"Button","type":"codeVoice"},{"text":" that presents more information about the first","type":"text"},{"text":" ","type":"text"},{"text":"matching item from a collection:","type":"text"}]},{"code":["struct ContentView: View {","    @State private var text = \"\"","","    var body: some View {","        NavigationView {","            SearchResults(searchText: text)","                .searchable(text: $text)","        }","    }","}","","private struct SearchResults: View {","    let searchText: String","","    let items = [\"a\", \"b\", \"c\"]","    var filteredItems: [String] { items.filter { $0 == searchText.lowercased() } }","","    @State private var isPresented = false","","    var body: some View {","        if let item = filteredItems.first {","            Button(\"Details about \\(item)\") {","                isPresented = true","            }","            .sheet(isPresented: $isPresented) {","                NavigationView {","                    DetailView(item: item)","                }","            }","        }","    }","}"],"type":"codeListing","syntax":null},{"type":"paragraph","inlineContent":[{"text":"The button becomes visible only after the user enters search text","type":"text"},{"text":" ","type":"text"},{"text":"that produces a match. When the user taps the button, SwiftUI shows","type":"text"},{"text":" ","type":"text"},{"text":"a sheet that provides more information about the item, including","type":"text"},{"text":" ","type":"text"},{"text":"an Add button for adding the item to a stored list of items:","type":"text"}]},{"code":["private struct DetailView: View {","    let item: String","","    @Environment(\\.dismiss) private var dismiss","    @Environment(\\.dismissSearch) private var dismissSearch","","    var body: some View {","        Text(\"Information about \\(item).\")","            .toolbar {","                Button(\"Add\") {","                    \/\/ Store the item here...","","                    dismiss()","                    dismissSearch()","                }","            }","    }","}"],"type":"codeListing","syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"The user can dismiss the sheet by dragging it down, effectively"},{"type":"text","text":" "},{"type":"text","text":"canceling the operation, leaving the in-progress search interaction"},{"type":"text","text":" "},{"type":"text","text":"intact. Alternatively, the user can tap the Add button to store the"},{"type":"text","text":" "},{"type":"text","text":"item. Because the user is likely to be done with both the detail view"},{"type":"text","text":" "},{"type":"text","text":"and the search interaction at this point, the button’s closure also"},{"type":"text","text":" "},{"type":"text","text":"uses the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismiss"},{"type":"text","text":" property to dismiss the sheet,"},{"type":"text","text":" "},{"type":"text","text":"and the "},{"type":"codeVoice","code":"dismissSearch"},{"type":"text","text":" property to reset the search field."}]}]}],"kind":"symbol","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismissSearch"},"metadata":{"title":"dismissSearch","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dismissSearch","kind":"identifier"},{"text":": ","kind":"text"},{"text":"DismissSearchAction","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI19DismissSearchActionV"}],"role":"symbol","modules":[{"name":"OpenSwiftUI"}],"extendedModule":"OpenSwiftUI","roleHeading":"Instance Property","externalID":"s:11OpenSwiftUI17EnvironmentValuesV13dismissSearchAA07DismissG6ActionVvp","symbolKind":"property"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues/dismissSearch":{"role":"symbol","url":"\/documentation\/openswiftui\/environmentvalues\/dismisssearch","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismissSearch","title":"dismissSearch","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"dismissSearch"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSwiftUI19DismissSearchActionV","kind":"typeIdentifier","text":"DismissSearchAction"}],"kind":"symbol","type":"topic","abstract":[{"text":"An action that ends the current search interaction.","type":"text"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Environment":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","type":"topic","abstract":[{"type":"text","text":"A property wrapper that reads a value from a view’s env