{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"hue"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"saturation"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"brightness"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"opacity"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":" = 1)"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"name":"hue","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A value in the range "},{"type":"codeVoice","code":"0"},{"type":"text","text":" to "},{"type":"codeVoice","code":"1"},{"type":"text","text":" that maps to an angle"},{"type":"text","text":" "},{"type":"text","text":"from 0° to 360° to represent a shade on the color wheel."}]}]},{"name":"saturation","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A value in the range "},{"type":"codeVoice","code":"0"},{"type":"text","text":" to "},{"type":"codeVoice","code":"1"},{"type":"text","text":" that indicates"},{"type":"text","text":" "},{"type":"text","text":"how strongly the hue affects the color. A value of "},{"type":"codeVoice","code":"0"},{"type":"text","text":" removes the"},{"type":"text","text":" "},{"type":"text","text":"effect of the hue, resulting in gray. As the value increases,"},{"type":"text","text":" "},{"type":"text","text":"the hue becomes more prominent."}]}]},{"name":"brightness","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A value in the range "},{"type":"codeVoice","code":"0"},{"type":"text","text":" to "},{"type":"codeVoice","code":"1"},{"type":"text","text":" that indicates"},{"type":"text","text":" "},{"type":"text","text":"how bright a color is. A value of "},{"type":"codeVoice","code":"0"},{"type":"text","text":" results in black, regardless"},{"type":"text","text":" "},{"type":"text","text":"of the other components. The color lightens as you increase this"},{"type":"text","text":" "},{"type":"text","text":"component."}]}]},{"name":"opacity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An optional degree of opacity, given in the range "},{"type":"codeVoice","code":"0"},{"type":"text","text":" to"},{"type":"text","text":" "},{"type":"codeVoice","code":"1"},{"type":"text","text":". A value of "},{"type":"codeVoice","code":"0"},{"type":"text","text":" means 100% transparency, while a value of "},{"type":"codeVoice","code":"1"},{"type":"text","text":" "},{"type":"text","text":"means 100% opacity. The default is "},{"type":"codeVoice","code":"1"},{"type":"text","text":"."}]}]}]},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This initializer creates a constant color that doesn’t change based"},{"type":"text","text":" "},{"type":"text","text":"on context. For example, it doesn’t have distinct light and dark"},{"type":"text","text":" "},{"type":"text","text":"appearances, unlike various system-defined colors, or a color that"},{"type":"text","text":" "},{"type":"text","text":"you load from an Asset Catalog with "},{"code":"init(_:bundle:)","type":"codeVoice"},{"type":"text","text":"."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Color"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Color\/init(hue:saturation:brightness:opacity:)"},"schem