{"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Key equivalents consist of a letter, punctuation, or function key that can"},{"type":"text","text":" "},{"type":"text","text":"be combined with an optional set of modifier keys to specify a keyboard"},{"type":"text","text":" "},{"type":"text","text":"shortcut."}],"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyEquivalent\/init(_:)"],"generated":true},{"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyEquivalent\/character"],"generated":true},{"anchor":"Type-Properties","title":"Type Properties","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyEquivalent\/clear","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyEquivalent\/delete","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyEquivalent\/deleteForward","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyEquivalent\/downArrow","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyEquivalent\/end","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyEquivalent\/escape","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyEquivalent\/home","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyEquivalent\/leftArrow","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyEquivalent\/pageDown","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyEquivalent\/pageUp","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyEquivalent\/return","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyEquivalent\/rightArrow","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyEquivalent\/space","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyEquivalent\/tab","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyEquivalent\/upArrow"],"generated":true},{"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/OpenSwiftUI\/docume