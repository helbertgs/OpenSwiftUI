{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KeyEquivalent"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Key equivalents are used to establish keyboard shortcuts to app"},{"type":"text","text":" "},{"type":"text","text":"functionality. Any key can be used as a key equivalent as long as pressing"},{"type":"text","text":" "},{"type":"text","text":"it produces a single character value. Key equivalents are typically"},{"type":"text","text":" "},{"type":"text","text":"initialized using a single-character string literal, with constants for"},{"type":"text","text":" "},{"type":"text","text":"unprintable or hard-to-type values."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The modifier keys necessary to type a key equivalent are factored in to the"},{"type":"text","text":" "},{"type":"text","text":"resulting keyboard shortcut. That is, a key equivalent whose raw value is"},{"type":"text","text":" "},{"type":"text","text":"the capitalized string “A” corresponds with the keyboard shortcut"},{"type":"text","text":" "},{"type":"text","text":"Command-Shift-A. The exact mapping may depend on the keyboard layout—for"},{"type":"text","text":" "},{"type":"text","text":"example, a key equivalent with the character value “}” produces a shortcut"},{"type":"text","text":" "},{"type":"text","text":"equivalent to Command-Shift-] on ANSI keyboards, but would produce a"},{"type":"text","text":" "},{"type":"text","text":"different shortcut for keyboard layouts where punctuation characters are in"},{"type":"text","text":" "},{"type":"text","text":"different locations."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"topicSections":[{"identifiers":["doc:\/\/OpenSw