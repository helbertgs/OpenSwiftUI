 depend on the keyboard layout—for"},{"type":"text","text":" "},{"type":"text","text":"example, a key equivalent with the character value “}” produces a shortcut"},{"type":"text","text":" "},{"type":"text","text":"equivalent to Command-Shift-] on ANSI keyboards, but would produce a"},{"type":"text","text":" "},{"type":"text","text":"different shortcut for keyboard layouts where punctuation characters are in"},{"type":"text","text":" "},{"type":"text","text":"different locations."}],"type":"paragraph"}]}],"metadata":{"title":"KeyEquivalent","modules":[{"name":"OpenSwiftUI"}],"roleHeading":"Structure","externalID":"s:11OpenSwiftUI13KeyEquivalentV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KeyEquivalent"}],"navigatorTitle":[{"text":"KeyEquivalent","kind":"identifier"}],"role":"symbol","symbolKind":"struct"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyEquivalent"},"relationshipsSections":[{"identifiers":["doc:\/\/OpenSwiftUI\/s8CopyableP","doc:\/\/OpenSwiftUI\/SQ","doc:\/\/OpenSwiftUI\/s43ExpressibleByExtendedGraphemeClusterLiteralP","doc:\/\/OpenSwiftUI\/s33ExpressibleByUnicodeScalarLiteralP","doc:\/\/OpenSwiftUI\/SH","doc:\/\/OpenSwiftUI\/s8SendableP"],"kind":"relationships","type":"conformsTo","title":"Conforms To"}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/KeyEquivalent/deleteForward":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyEquivalent\/deleteForward","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deleteForward","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI13KeyEquivalentV","text":"KeyEquivalent","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"Delete Forward (U+F728)"}],"url":"\/documentation\/openswiftui\/keyequivalent\/deleteforward","type":"topic","role":"