{"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/TextSelectionAffinity"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"topicSections":[{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/TextSelectionAffinity\/automatic","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/TextSelectionAffinity\/downstream","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/TextSelectionAffinity\/upstream"],"anchor":"Enumeration-Cases","title":"Enumeration Cases","generated":true},{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/TextSelectionAffinity\/init(rawValue:)"],"anchor":"Initializers","title":"Initializers","generated":true},{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/TextSelectionAffinity\/Equatable-Implementations","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/TextSelectionAffinity\/RawRepresentable-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations","generated":true}],"sections":[],"abstract":[{"type":"text","text":"A representation of the direction or association of a selection or cursor relative to a text character."},{"type":"text","text":" "},{"type":"text","text":"This concept becomes much more prominent when dealing with bidirectional text (text that contains both LTR and RTL scripts, like English and Arabic combined)."}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/OpenSwiftUI\/Se","doc:\/\/OpenSwiftUI\/SE","doc:\/\/OpenSwiftUI\/SQ","doc:\/\/OpenSwiftUI\/SH","doc:\/\/OpenSwiftUI\/SY","doc:\/\/OpenSwiftUI\/s8SendableP","doc:\/\/OpenSwiftUI\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TextSelectionAffinity","kind":"identifie