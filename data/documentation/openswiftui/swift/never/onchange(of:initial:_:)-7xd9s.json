lly","type":"text"},{"text":" ","type":"text"},{"text":"appears.","type":"text"}]}],"name":"initial"},{"content":[{"inlineContent":[{"text":"A closure to run when the value changes.","type":"text"}],"type":"paragraph"}],"name":"action"}]},{"kind":"content","content":[{"text":"Return Value","level":2,"anchor":"return-value","type":"heading"},{"inlineContent":[{"type":"text","text":"A scene that triggers an action in response to a change."}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this modifier to trigger a side effect when a value changes, like"},{"type":"text","text":" "},{"type":"text","text":"the value associated with an "},{"type":"codeVoice","code":"SwiftUI\/Environment"},{"type":"text","text":" key or a"},{"type":"text","text":" "},{"type":"codeVoice","code":"SwiftUI\/Binding"},{"type":"text","text":". For example, you can clear a cache when you notice"},{"type":"text","text":" "},{"type":"text","text":"that a scene moves to the background:"}]},{"type":"codeListing","syntax":null,"code":["struct MyScene: Scene {","    @Environment(\\.scenePhase) private var scenePhase","    @StateObject private var cache = DataCache()","","    var body: some Scene {","        WindowGroup {","            MyRootView(cache: cache)","        }","        .onChange(of: scenePhase) { oldScenePhase, newScenePhase in","            if newScenePhase == .background {","                cache.empty()","            }","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The system may call the action closure on the main actor, so avoid"},{"type":"text","text":" "},{"type":"text","text":"long-running tasks in the closure. If you need to perform such tasks,"},{"type":"text","text":" "},{"type":"text","text":"detach an asynchronous background task:"}]},{"type":"codeListing","syntax":null,"code":[".onChange(of: scenePhas