enePhase == .background {","        Task.detached(priority: .background) {","            \/\/ ...","        }","    }","}"],"type":"codeListing","syntax":null},{"type":"paragraph","inlineContent":[{"text":"When the value changes, the new version of the closure will be called,","type":"text"},{"text":" ","type":"text"},{"text":"so any captured values will have their values from the time that the","type":"text"},{"text":" ","type":"text"},{"text":"observed value has its new value. The system passes the old and new","type":"text"},{"text":" ","type":"text"},{"text":"observed values into the closure.","type":"text"}]}]}],"kind":"symbol","references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene":{"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"identifier"}],"navigatorTitle":[{"text":"Scene","kind":"identifier"}],"url":"\/documentation\/openswiftui\/scene","kind":"symbol","abstract":[{"text":"A part of an app’s user interface with a life cycle managed by the","type":"text"},{"text":" ","type":"text"},{"text":"system.","type":"text"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","type":"topic","title":"Scene"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Swift/Never/onChange(of:initial:_:)-7xd9s":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onChange","kind":"identifier"},{"text":"<","kind":"text"},{"text":"V","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"V","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"initial","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":", (","kind":"text"},{"text":"V","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"V","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:s4Voida","text":"Void","kind"