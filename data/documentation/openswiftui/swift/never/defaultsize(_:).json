{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Swift","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Swift\/Never"]]},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Swift\/Never\/defaultSize(_:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Sets a default size for a window."}],"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultSize","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"size","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Size3D","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial6Size3DV"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP"},{"text":"\n","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"name":"size","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The default size for new windows created from a scene."}]}]}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"anchor":"return-value","text":"Return Value"},{"type":"paragraph","inlineContent":[{"text":"A scene that uses a default size for new windows.","type":"text"}]}],"kind":"content"},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Use this scene modifier to indicate a default initial size for a new","type":"text"},{"text":" ","type":"text"},{"text":"window that the system creates from a ","type":"text"},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","isActive":true},{"text":" declaration. For","type":"text"},{"text":" ","type":"text"},{"text":"example, you can request that new windows that a ","type":"text"},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup","isActive":true},{"text":" ","type":"text"},{"text":"generates occupy 600 points in the x-dimension and 400 points in","type":"text"},{"text":" ","type":"text"},{"text":"the y-dimension:","type":"text"}]},{"syntax":null,"code":["@main","struct MyApp: App {","    var body: some Scene {","        WindowGroup {","            ContentView()","        }","        .defaultSize(CGSize(width: 600, height: 400))","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The size that you specify acts only as a default for when the window","type":"text"},{"text":" ","type":"text"},{"text":"first appears. People can later resize the window using interface","type":"text"},{"text":" ","type":"text"},{"text":"controls that the system provides. Also, during state restoration,","type":"text"},{"text":" ","type":"text"},{"text":"the system restores windows to their most recent size rather than","type":"text"},{"text":" ","type":"text"},{"text":"the default size.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If you specify a default size that’s outside the range of the window’s","type":"text"},{"text":" ","type":"text"},{"text":"inherent resizability in one or both dimensions, the system clamps the","type":"text"},{"text":" ","type":"text"},{"text":"affected dimension to keep it in range. You can configure the","type":"text"},{"text":" ","type":"text"},{"text":"resizability of a scene using the ","type":"text"},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/windowResizability(_:)","isActive":true},{"text":" ","type":"text"},{"text":"modifier.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The default size modifier affects any scene type that creates windows","type":"text"},{"text":" ","type":"text"},{"text":"in Windows, namely:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup","isActive":true,"type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window","isActive":true,"type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"DocumentGroup","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Settings","isActive":true,"type":"reference"}]}]}]},{"inlineContent":[{"text":"If you want to specify the input directly in terms of width and height,","type":"text"},{"text":" ","type":"text"},{"text":"use ","type":"text"},{"type":"codeVoice","code":"Scene\/defaultSize(width:height:)"},{"text":" instead.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"externalID":"s:11OpenSwiftUI5ScenePAAE11defaultSizeyQr0A7Spatial6Size3DVF::SYNTHESIZED::s:s5NeverO","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultSize"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial6Size3DV","text":"Size3D"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5SceneP","text":"Scene"}],"extendedModule":"OpenSwiftUI","role":"symbol","title":"defaultSize(_:)","symbolKind":"method","modules":[{"name":"OpenSwiftUI"}]},"variants":[{"paths":["\/documentation\/openswiftui\/swift\/never\/defaultsize(_:)"],"traits":[{"interfaceLanguage