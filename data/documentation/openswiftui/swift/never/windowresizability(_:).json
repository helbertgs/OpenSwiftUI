{"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Swift","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Swift\/Never"]]},"kind":"symbol","sections":[],"variants":[{"paths":["\/documentation\/openswiftui\/swift\/never\/windowresizability(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Sets the kind of resizability to use for a window.","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"windowResizability","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"resizability","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"WindowResizability","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI18WindowResizabilityV","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowResizability"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5SceneP","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"},{"text":"\n","kind":"text"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"resizability","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The resizability to use for windows created by"},{"type":"text","text":" "},{"type":"text","text":"this scene."}]}]}]},{"kind":"content","content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A scene that uses the specified resizability strategy."}],"type":"paragraph"}]},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussi