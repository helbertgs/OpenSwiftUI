 a toggle to dialogs on Windows,"},{"type":"text","text":" "},{"type":"text","text":"which allows the user to request the alert not be displayed again."},{"type":"text","text":" "},{"type":"text","text":"Typically whether a dialog is suppressed is stored in "},{"type":"codeVoice","code":"AppStorage"},{"type":"text","text":" "},{"type":"text","text":"and used to decide whether to present the dialog in the future."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example configures an alert with a"},{"type":"text","text":" "},{"type":"text","text":"suppression toggle. The toggle’s state is stored in "},{"type":"codeVoice","code":"AppStorage"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"used to determine whether or not to show the dialog when the"},{"type":"text","text":" "},{"type":"text","text":"“Delete Items” button is pressed."}]},{"code":["struct MyApp: App {","    @State private var isShowingDialog = false","    @AppStorage(\"suppressEraseItemAlert\")","    private var suppressAlert = false","","    var body: some Scene {","        Window(...) {","            Button(\"Delete items\") {","                isShowingDialog = true","            }","        }","","        AlertScene(","            \"Are you sure you want to erase these items?\",","            isPresented: $isShowingDialog","        ) {","            Button(\"Erase\", role: .destructive) {","                \/\/ Handle item deletion.","            }","            Button(\"Cancel\", role: .cancel) {","                \/\/ Handle cancellation","            }","        }","        .dialogSuppressionToggle(","            \"Do not ask about erasing items again\",","            isSuppressed: $suppressAlert)","    }","}"],"syntax":null,"type":"codeListing"}],"kind":"content"}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Binding":{"abstract":[{"type":"text","text":"A property wrapper type that can read and write a value owned by a so