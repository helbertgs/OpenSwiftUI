{"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultSize","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"width","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"height","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"depth","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":" = 0) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","kind":"typeIdentifier"},{"text":"\n","kind":"text"}],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The default width for windows created from a scene."}]}],"name":"width"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The default height for windows created from a scene."}]}],"name":"height"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The default depth for the created volumetric window."}]}],"name":"depth"}]},{"content":[{"type":"heading","anchor":"return-value","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A scene that uses a default size for new windows."}]}],"kind":"content"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this scene modifier to indicate a default initial size for a new"},{"type":"text","text":" "},{"type":"text","text":"window that the system creates from a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"},{"type":"text","text":" declaration. For"},{"type":"text","text":" "},{"type":"text","text":"example, you can request that new windows that a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup"},{"type":"text","text":" "},{"type":"text","text":"generates occupy 600 points in the x-dimension and 400 points in"},{"type":"text","text":" "},{"type":"text","text":"the y-dimension:"}]},{"type":"codeListing","syntax":null,"code":["@main","struct MyApp: App {","    var body: some Scene {","        WindowGroup {","            ContentView()","        }","        .defaultSize(width: 600, height: 400)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The size that you specify acts only as a default for when the window"},{"type":"text","text":" "},{"type":"text","text":"first appears. People can later resize the window using interface"},{"type":"text","text":" "},{"type":"text","text":"controls that the system provides. Also, during state restoration,"},{"type":"text","text":" "},{"type":"text","text":"the system restores windows to their most recent size rather than"},{"type":"text","text":" "},{"type":"text","text":"the default size."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you specify a default size that’s outside the range of the window’s"},{"type":"text","text":" "},{"type":"text","text":"inherent resizability in one or both dimensions, the system clamps the"},{"type":"text","text":" "},{"type":"text","text":"affected dimension to keep it in range. You can configure the"},{"type":"text","text":" "},{"type":"text","text":"resizability of a scene using the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/windowResizability(_:)"},{"type":"text","text":" "},{"type":"text","text":"modifier."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default size modifier affects any scene type that creates windows"},{"type":"text","text":" "},{"type":"text","text":"in Windows, namely:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup","isActive":true,"type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"DocumentGroup","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Settings","isActive":true}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you want to specify the size input in terms of size instance,"},{"type":"text","text":" "},{"type":"text","text":"use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/defaultSize(_:)"},{"type":"text","text":" instead."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Swift","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Swift\/Never"]]},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Swift\/Never\/defaultSize(_:_:_:)","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"Sets a default width and height for a window."}],"variants":[{"traits":[{"interface