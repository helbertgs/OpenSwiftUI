{"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Swift","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Swift\/Never"]]},"sections":[],"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultWindowPlacement","kind":"identifier"},{"text":"((","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI16WindowLayoutRootV","text":"WindowLayoutRoot","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI22WindowPlacementContextV","text":"WindowPlacementContext","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI15WindowPlacementV","text":"WindowPlacement","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","text":"Scene","kind":"typeIdentifier"}],"externalID":"s:11OpenSwiftUI5ScenePAAE22defaultWindowPlacementyQrAA0fG0VAA0F10LayoutRootV_AA0fG7ContextVtcF::SYNTHESIZED::s:s5NeverO","title":"defaultWindowPlacement(_:)","role":"symbol","roleHeading":"Instance Method","symbolKind":"method","modules":[{"name":"OpenSwiftUI"}],"extendedModule":"OpenSwiftUI"},"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Swift\/Never\/defaultWindowPlacement(_:)"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultWindowPlacement","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"makePlacement","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"@escaping ","kind":"attribute"},{"text":"(","kind":"text"},{"text":"WindowLayoutRoot","kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowLayoutRoot","preciseIdentifier":"s:11OpenSwiftUI16WindowLayoutRootV"},{"text":", ","kind":"text"},{"text":"WindowPlacementContext","kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowPlacementContext","preciseIdentifier":"s:11OpenSwiftUI22WindowPlacementContextV"},{"text":") -> ","kind":"text"},{"text":"WindowPlacement","kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowPlacement","preciseIdentifier":"s:11OpenSwiftUI15WindowPlacementV"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP"},{"text":"\n","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"A closure to generate the default window placement.","type":"text"}]}],"name":"makePlacement"}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"Use this scene modifier to indicate a default initial size and position","type":"text"},{"text":" ","type":"text"},{"text":"for a new window that the system creates from a ","type":"text"},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","isActive":true},{"text":" declaration.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"On Windows, you can use the screen’s bounds to place the window.","type":"text"},{"text":" ","type":"text"},{"text":"For example, you can specify that the window is always placed 140","type":"text"},{"text":" ","type":"text"},{"text":"points from the bottom of the screen:","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["struct MyApp: App {","    var body: some Scene {","        ...","","        Window(\"Status\", id: \"status\") {","            StatusView()","        }","        .windowResizability(.contentSize)","        .defaultWindowPlacement { content, context in","            let displayBounds = context.defaultDisplay.visibleRect","            let size = content.sizeThatFits(.unspecified)","            let position = CGPoint(","                x: displayBounds.midX - (size.width \/ 2),","                y: displayBounds.maxY - size.height - 140)","            return WindowPlacement(position: position, size: size)","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"On visionOS, the system always places the first window","type":"text"},{"text":" ","type":"text"},{"text":"relative to where the person is looking.","type":"text"},{"text":" ","type":"text"},{"text":"The system ignores calls to ","type":"text"},{"code":"defaultWindowPlacement(_:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You can place any subsequent windows relative to existing ones by","type":"text"},{"text":" ","type":"text"},{"text":"returning one of the methods defined by ","type":"text"},{"code":"WindowPlacement\/Position","type":"codeVoice"},{"text":" ","type":"text"},{"text":"with the existing window.","type":"text"},{"text":" ","type":"text"},{"text":"For example, you can align the new window with the trailing edge of","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"Content","type":"codeVoice"},{"text":" window:","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["struct MyApp: App {","    @Environment(\\.openWindow) private var openWindow","","    var body: some Scene {","        WindowGroup(\"Content\", id: \"content\") {","            Button(\"Open status window\") {","                openWindow(id: \"status\")","            }","        }","","        WindowGroup(\"Status\", id: \"status\") {","            StatusView()","        }","        .windowResizability(.contentSize)","        .defaultWindowPlacement { content, context in","            if let contentWindow = context.windows.first(","            where: { $0.id == \"content\" }) {","                WindowPlacement(.trailing(contentWindow))","            } else {","                WindowPlacement()","            }","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The placement that your function returns acts as a default for when the","type":"text"},{"text":" ","type":"text"},{"text":"window first appears. People can later resize and move the window using","type":"text"},{"text":" ","type":"text"},{"text":"interface controls that the system provides. Also, during state","type":"text"},{"text":" ","type":"text"},{"text":"restoration, the system restores the window to it’s most recent size and","type":"text"},{"text":" ","type":"text"},{"text":"position, rather than the default placement.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For more information on configuring how scenes behave with","type":"text"},{"text":" ","type":"text"},{"text":"state restoration, see ","type":"text"},{"code":"Scene.stateRestoration(_:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/swift\/never\/defaultwindowplacement(_:)"]}],"abstract":[{"text":"Defines a function used for determining the default placement","type":"text"},{"text":" ","type":"text"},{"text":"of windows.","type":"text"}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Swift/Never/defaultWindowPlacement(_:)":{"title":"defaultWindowPlacement(_:)","role":"symbol","type":"topic","url":"\/documentation\/openswiftui\/swift\/never\/defaultwindowplacement(_:)","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Swift\/Never\/defaultWindowPlaceme