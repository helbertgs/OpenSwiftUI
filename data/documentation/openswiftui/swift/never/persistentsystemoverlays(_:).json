xt"},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","text":"Scene","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","kind":"typeIdentifier"},{"text":"\n","kind":"text"}]}]},{"content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"inlineContent":[{"text":"Use this modifier to influence the appearance of system overlays","type":"text"},{"text":" ","type":"text"},{"text":"in your app. The behavior varies by platform.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"In iOS, the following example hides every persistent system overlay.","type":"text"},{"text":" ","type":"text"},{"text":"In visionOS 2 and later, the SharePlay Indicator hides if the","type":"text"},{"text":" ","type":"text"},{"text":"scene is shared through SharePlay, or not shared at all.","type":"text"},{"text":" ","type":"text"},{"text":"During screen sharing, the indicator always remains visible.","type":"text"},{"text":" ","type":"text"},{"text":"The Home indicator doesn’t appear without specific user intent","type":"text"},{"text":" ","type":"text"},{"text":"when you set visibility to ","type":"text"},{"code":"hidden","type":"codeVoice"},{"text":". For a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup","type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"the modifier affects the visibility of the window chrome. For an","type":"text"},{"text":" ","type":"text"},{"code":"ImmersiveSpace","type":"codeVoice"},{"text":", it affects the Home indicator.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["struct ImmersiveView: View {","    var body: some View {","        Text(\"Maximum immersion\")","            .persistentSystemOverlays(.hidden)","    }","}"]},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":"You can indicate a preference with this modifier, but the system"},{"type":"text","text":" "},{"type":"text","text":"might or might not be able to honor that preference."}],"type":"paragraph"}]},{"inlineContent":[{"text":"Affected non-transient system views can include, but are not limited to:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"The Home indicator."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The SharePlay indicator."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The Multitasking Controls button and Picture in Picture on iPad."}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/openswiftui\/swift\/never\/persistentsystemoverlays(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Swift/Never":{"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:s5NeverO","kind":"identifier","text":"Never"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Swift\/Never","role":"symbol","abstract":[],"title":"Never","url":"\/documentation\/openswiftui\/swift\/never","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Never"}],"type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","abstract":[],"title":"OpenSwiftUI","url":"\/documentation\/openswiftui","kind":"symbol","type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Swift/Never/persistentSystemOverlays(_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"persistentSystemOverlays","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Visibility","preciseIdentifier":"s:11OpenSwiftUI10VisibilityO","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","preciseIdentifier":"s:11OpenSwiftU