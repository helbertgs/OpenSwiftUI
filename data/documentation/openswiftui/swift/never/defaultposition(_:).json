{"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"externalID":"s:11OpenSwiftUI5ScenePAAE15defaultPositionyQrAA9UnitPointVF::SYNTHESIZED::s:s5NeverO","roleHeading":"Instance Method","title":"defaultPosition(_:)","extendedModule":"OpenSwiftUI","modules":[{"name":"OpenSwiftUI"}],"symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultPosition","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI9UnitPointV","text":"UnitPoint","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","text":"Scene","kind":"typeIdentifier"}],"role":"symbol"},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Swift\/Never\/defaultPosition(_:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Sets a default position for a window."}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/swift\/never\/defaultposition(_:)"]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultPosition"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"position"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSwiftUI9UnitPointV","kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint","text":"UnitPoint"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","text":"Scene"},{"kind":"text","text":"\n"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"position","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint"},{"type":"text","text":" that specifies where to place a"},{"type":"text","text":" "},{"type":"text","text":"newly opened window relative to the screen bounds."}]}]}],"kind":"parameters"},{"content":[{"anchor":"return-value","level":2,"text":"Return Value","type":"heading"},{"inlineContent":[{"type":"text","text":"A scene that uses a default position for new windows."}],"type":"paragraph"}],"kind":"content"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"inlineContent":[{"text":"The first time your app opens a window from a particular scene","type":"text"},{"text":" ","type":"text"},{"text":"declaration, the system places the window at the center of the screen by","type":"text"},{"text":" ","type":"text"},{"text":"default. For scene types that support multiple simultaneous windows, the","type":"text"},{"text":" ","type":"text"},{"text":"system offsets each additional window by a small amount to avoid","type":"text"},{"text":" ","type":"text"},{"text":"completely obscuring existing windows.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can override the default placement of the first window by"},{"type":"text","text":" "},{"type":"text","text":"applying a scene modifier that indicates where to place the window"},{"type":"text","text":" "},{"type":"text","text":"relative to the screen bounds. For example, you can request that the"},{"type":"text","text":" "},{"type":"text","text":"system place a new window in the bottom trailing corner of the screen:"}],"type":"paragraph"},{"type":"codeListing","code":["@main","struct MyApp: App {","    var body: some Scene {","        WindowGroup {","            ContentView()","        }","        .defaultPosition(.bottomTrailing)","    }","}"],"syntax":null},{"inlineContent":[{"text":"The system aligns the point in the window that corresponds to the","type":"text"},{"text":" ","type":"text"},{"text":"specified ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint","type":"reference","isActive":true},{"text":" with the point in the screen that corresponds","type":"text"},{"text":" ","type":"text"},{"text":"to the same unit point.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You typically use one of the predefined unit points — like","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/bottomTrailing","isActive":true},{"text":" in the above example — but","type":"text"},{"text":" ","type":"text"},{"text":"you can also use a custom unit point. For example, the following","type":"text"},{"text":" ","type":"text"},{"text":"modifier aligns the point that’s one quarter of the way from the","type":"text"},{"text":" ","type":"text"},{"text":"leading edge of the window with the point that’s one quarter of","type":"text"},{"text":" ","type":"text"},{"text":"the way from the leading edge of the screen, while centering the","type":"text"},{"text":" ","type":"text"},{"text":"window in the y-dimension:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["WindowGroup {","    ContentView()","}",".defaultPosition(UnitPoint(x: 0.25, y: 0.5))"],"syntax":null},{"inlineContent":[{"type":"text","text":"The modifier affects any scene type that creates windows in macOS,"},{"type":"text","text":" "},{"type":"text","text":"namely:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Window"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"DocumentGroup"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"Settings","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The value that you provide acts only as an initial default. During state","type":"text"},{"text":" ","type":"text"},{"text":"restoration, the system restores the window to the position that it","type":"text"},{"text":" ","type":"text"},{"text":"last occupied.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Swift","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Swift\/Never"]]},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/UnitPoint/bottomTrailing":{"type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"bottomTrailing"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSwiftUI9UnitPointV","kind":"typeIdentifier","text":"UnitPoint"}],"abstract":[{"type":"text","text":"A point that’s in the bottom, trailing corner of a view."}],"title":"bottomTrailing","url":"\/documentation\/openswiftui\/unitpoint\/bottomtrailing","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/bottomTrailing","role":"symbol","kind":"symbol"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Swift":{"title":"Swift","abstract":[],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Swift","type":"topic","role":"collection","kind":"symbol","url":"\/documentation\/openswiftui\/swift"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/WindowGroup":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WindowGroup"}],"type":"topic","title":"WindowGroup","abstract":[{"text":"A scene that presents a group of identically structured windows.","type":"text"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"WindowGroup"}],"url":"\/documentation\/openswiftui\/windowgroup","role":"symbol"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Swift/Never/defaultPosition(_:)":{"url":"\/documentation\/openswiftui\/swift\/never\/defaultposition(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultPosition"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"UnitPoint","preciseIdentifier":"s:11OpenSwiftUI9UnitPointV"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP"}],"role":"symbol","type":"topic","abstract":[{"type":"text","text":"Sets a default position for a window."}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Swift\/Never\/defaultPosition(_:)","title":"defaultPosition(_:)","kind":"symbol"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Swift/Never":{"kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Swift\/Never","title":"Never","type":"topic","url":"\/documentation\/openswiftui\/swift\/never","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:s5NeverO","text":"Never"}],"navigatorTitle":[{"kind":"identifier","text":"Never"}],"role":"symbol","abstract":[]},"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","title":"OpenSwiftUI","abstract":[],"type":"topic","kind":"symbol","url":"\/documentation\/openswiftui","role":"collection"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/UnitPoint":{"url":"\/documentation\/openswiftui\/unitpoint","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UnitPoint","kind":"identifier"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint","type":"topic","title":"UnitPoint","a