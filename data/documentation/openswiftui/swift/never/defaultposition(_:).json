{"sections":[],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Swift","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Swift\/Never"]]},"metadata":{"extendedModule":"OpenSwiftUI","externalID":"s:11OpenSwiftUI5ScenePAAE15defaultPositionyQrAA9UnitPointVF::SYNTHESIZED::s:s5NeverO","symbolKind":"method","modules":[{"name":"OpenSwiftUI"}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"defaultPosition"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI9UnitPointV","kind":"typeIdentifier","text":"UnitPoint"},{"text":") -> ","kind":"text"},{"kind":"keyword","text":"some"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","kind":"typeIdentifier","text":"Scene"}],"title":"defaultPosition(_:)","roleHeading":"Instance Method"},"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"preciseIdentifier":"s:ScM","kind":"attribute","text":"MainActor"},{"kind":"text","text":" "},{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"defaultPosition","kind":"identifier"},{"kind":"text","text":"("},{"text":"_","kind":"externalParam"},{"kind":"text","text":" "},{"text":"position","kind":"internalParam"},{"kind":"text","text":": "},{"text":"UnitPoint","kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint","preciseIdentifier":"s:11OpenSwiftUI9UnitPointV"},{"kind":"text","text":") -> "},{"text":"some","kind":"keyword"},{"kind":"text","text":" "},{"text":"Scene","kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP"},{"kind":"text","text":"\n"}],"languages":["swift"],"platforms":["macOS"]}]},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint","isActive":true},{"text":" that specifies where to place a","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"newly opened window relative to the screen bounds."}],"type":"paragraph"}],"name":"position"}],"kind":"parameters"},{"kind":"content","content":[{"anchor":"return-value","level":2,"type":"heading","text":"Return Value"},{"inlineContent":[{"text":"A scene that uses a default position for new windows.","type":"text"}],"type":"paragraph"}]},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"The first time your app opens a window from a particular scene"},{"type":"text","text":" "},{"type":"text","text":"declaration, the system places the window at the center of the screen by"},{"type":"text","text":" "},{"type":"text","text":"default. For scene types that support multiple simultaneous windows, the"},{"type":"text","text":" "},{"type":"text","text":"system offsets each additional window by a small amount to avoid"},{"type":"text","text":" "},{"type":"text","text":"completely obscuring existing windows."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can override the default placement of the first window by"},{"type":"text","text":" "},{"type":"text","text":"applying a scene modifier that indicates where to place the window"},{"type":"text","text":" "},{"type":"text","text":"relative to the screen bounds. For example, you can request that the"},{"type":"text","text":" "},{"type":"text","text":"system place a new window in the bottom trailing corner of the screen:"}],"type":"paragraph"},{"code":["@main","struct MyApp: App {","    var body: some Scene {","        WindowGroup {","            ContentView()","        }","        .defaultPosition(.bottomTrailing)","    }","}"],"type":"codeListing","syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"The system aligns the point in the window that corresponds to the"},{"type":"text","text":" "},{"type":"text","text":"specified "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint","type":"reference","isActive":true},{"type":"text","text":" with the point in the screen that corresponds"},{"type":"text","text":" "},{"type":"text","text":"to the same unit point."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You typically use one of the predefined unit points — like"},{"type":"text","text":" "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/bottomTrailing","type":"reference","isActive":true},{"type":"text","text":" in the above example — but"},{"type":"text","text":" "},{"type":"text","text":"you can also use a custom unit point. For example, the following"},{"type":"text","text":" "},{"type":"text","text":"modifier aligns the point that’s one quarter of the way from the"},{"type":"text","text":" "},{"type":"text","text":"leading edge of the window with the point that’s one quarter of"},{"type":"text","text":" "},{"type":"text","text":"the way from the leading edge of the screen, while centering the"},{"type":"text","text":" "},{"type":"text","text":"window in the y-dimension:"}]},{"code":["WindowGroup {","    ContentView()","}",".defaultPosition(UnitPoint(x: 0.25, y: 0.5))"],"type":"codeListing","syntax":null},{"inlineContent":[{"type":"text","text":"The modifier affects any scene type that creates windows in Windows,"},{"type":"text","text":" "},{"type":"text","text":"namely:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"DocumentGroup","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Settings","type":"reference","isActive":true}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The value that you provide acts only as an initial default. During state"},{"type":"text","text":" "},{"type":"text","text":"restoration, the system restores the window to the position that it"},{"type":"text","text":" "},{"type":"text","text":"last occupied."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/openswiftui\/swift\/never\/defaultposition(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","abstract":[{"type":"text","text":"Sets a default position for a window."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Swift\/Never\/defaultPosition(_:)"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/UnitPoint/bottomTrailing":{"url":"\/documentation\/openswiftui\/unitpoint\/bottomtrailing","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bottomTrailing","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI9UnitPointV","text":"UnitPoint","kind":"typeIdentifier"}],"type":"topic","abstract":[{"type":"text","text":"A point that’s in the bottom, trailing corner of a view."}],"title":"bottomTrailing","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/bottomTrailing"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scene"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","role":"symbol","abstract":[{"type":"text","text":"A part of an app’s user interface with a life cycle managed by the"},{"type":"text","tex