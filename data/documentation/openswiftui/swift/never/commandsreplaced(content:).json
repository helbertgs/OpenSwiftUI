{"abstract":[{"type":"text","text":"Replaces all commands defined by the modified scene with the commands"},{"type":"text","text":" "},{"type":"text","text":"from the builder."}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"commandsReplaced"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Content"},{"kind":"text","text":">("},{"kind":"attribute","text":"@"},{"preciseIdentifier":"s:11OpenSwiftUI15CommandsBuilderV","kind":"attribute","text":"CommandsBuilder","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/CommandsBuilder"},{"kind":"text","text":" "},{"kind":"externalParam","text":"content"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","text":"Content"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","kind":"typeIdentifier","text":"Scene","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Content"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:11OpenSwiftUI8CommandsP","kind":"typeIdentifier","text":"Commands","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Commands"},{"kind":"text","text":"\n"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Commands"},{"type":"text","text":" builder whose output will be used to replace"},{"type":"text","text":" "},{"type":"text","text":"the commands normally provided by the modified scene."}],"type":"paragraph"}],"name":"content"}]},{"kind":"content","content":[{"level":2,"anchor":"return-value","type":"heading","text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A scene that replaces any commands defined by its children"},{"type":"text","text":" "},{"type":"text","text":"with alternative content."}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"WindowGroup"},{"type":"text","text":", "},{"type":"codeVoice","code":"Window"},{"type":"text","text":", and other scene types all have an associated"},{"type":"text","text":" "},{"type":"text","text":"set of commands that they include by default. Apply this modifier to a"},{"type":"text","text":" "},{"type":"text","text":"scene to replace those commands with the output from the given builder."}]},{"type":"paragraph","inlineContent":[{"text":"For example, the following code adds a scene for showing the contents of","type":"text"},{"text":" ","type":"text"},{"text":"the pasteboard in a dedicated window. We replace the scene’s default","type":"text"},{"text":" ","type":"text"},{"text":"Window > Clipboard menu command with a custom Edit > Show Clipboard","type":"text"},{"text":" ","type":"text"},{"text":"command that we place next to the other pasteboard commands.","type":"text"}]},{"type":"codeListing","syntax":null,"code":["@main","struct Example: App {","    @Environment(\\.openWindow) var openWindow","","    var body: some Scene {","        ...","","        Window(\"Clipboard\", id: \"clipboard\") {","            ClipboardContentView()","        }","        .commandsReplaced {","            CommandGroup(after: .pasteboard) {","                Section {","                    Button(\"Show Clipboard\") {","                        openWindow(id: \"clipboard\")","                    }","                }","            }","        }","    }","}"]}]}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Swift","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Swift\/Never"]]},"schemaVersion":{"patch":0,"major":0,"m