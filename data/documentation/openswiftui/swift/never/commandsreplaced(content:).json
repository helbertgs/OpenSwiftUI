he other pasteboard commands."}]},{"type":"codeListing","syntax":null,"code":["@main","struct Example: App {","    @Environment(\\.openWindow) var openWindow","","    var body: some Scene {","        ...","","        Window(\"Clipboard\", id: \"clipboard\") {","            ClipboardContentView()","        }","        .commandsReplaced {","            CommandGroup(after: .pasteboard) {","                Section {","                    Button(\"Show Clipboard\") {","                        openWindow(id: \"clipboard\")","                    }","                }","            }","        }","    }","}"]}]}],"abstract":[{"text":"Replaces all commands defined by the modified scene with the commands","type":"text"},{"text":" ","type":"text"},{"text":"from the builder.","type":"text"}],"kind":"symbol","variants":[{"paths":["\/documentation\/openswiftui\/swift\/never\/commandsreplaced(content:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Swift","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Swift\/Never"]]},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Swift/Never":{"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:s5NeverO","text":"Never","kind":"identifier"}],"navigatorTitle":[{"text":"Never","kind":"identifier"}],"title":"Never","type":"topic","url":"\/documentation\/openswiftui\/swift\/never","role":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Swift\/Never","kind":"symbol","abstract":[]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene":{"abstract":[{"type":"text","text":"A part of an app’s user interface with a life cycle managed by the"},{"type":"text","text":" "},{"type":"text","text":"system."}],"type":"topic","title":"Scene","url":"\/documentation\/openswiftui\/scene","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/S