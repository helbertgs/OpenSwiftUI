{"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"commandsRemoved"},{"kind":"text","text":"() -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Scene","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP"},{"kind":"text","text":"\n"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"inlineContent":[{"text":"A scene that excludes any commands defined by its children.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"WindowGroup"},{"type":"text","text":", "},{"type":"codeVoice","code":"Window"},{"type":"text","text":", and other scene types all have an associated"},{"type":"text","text":" "},{"type":"text","text":"set of commands that they include by default. Apply this modifier to a"},{"type":"text","text":" "},{"type":"text","text":"scene to exclude those commands."}],"type":"paragraph"},{"inlineContent":[{"text":"For example, the following code adds a scene for presenting the details","type":"text"},{"text":" ","type":"text"},{"text":"of an individual data model in a separate window. To ensure that the","type":"text"},{"text":" ","type":"text"},{"text":"window can only appear programmatically, we remove the scene’s commands,","type":"text"},{"text":" ","type":"text"},{"text":"including File > New Note Window.","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["@main","struct Example: App {","    var body: some Scene {","        ...","","        WindowGroup(\"Note\", id: \"note\", for: Note.ID.self) {","            NoteDetailView(id: $0)","        }","  