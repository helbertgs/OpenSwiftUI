me":"action","content":[{"type":"paragraph","inlineContent":[{"text":"An async closure that the system runs for the specified task","type":"text"},{"text":" ","type":"text"},{"text":"type.","type":"text"}]}]}],"kind":"parameters"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the system wakes your app or extension for one or more background"},{"type":"text","text":" "},{"type":"text","text":"tasks, it will call any actions associated with matching tasks. When"},{"type":"text","text":" "},{"type":"text","text":"your async actions return, the system put your app back into a suspended"},{"type":"text","text":" "},{"type":"text","text":"state. The system considers the task completed when the action closure"},{"type":"text","text":" "},{"type":"text","text":"that you provide returns. If the action closure has not returned when"},{"type":"text","text":" "},{"type":"text","text":"the task runs out of time to complete, the system cancels the task. Use"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Swift\/withTaskCancellationHandler(operation:onCancel:)"},{"type":"text","text":" "},{"type":"text","text":"to observe whether the task is low on runtime."}]},{"type":"codeListing","code":["\/\/\/ An example of a Weather Application.","struct WeatherApp: App {","    var body: some Scene {","        WindowGroup {","            Text(\"Responds to App Refresh\")","        }","        .backgroundTask(.appRefresh(\"WEATHER_DATA\")) {","            await updateWeatherData()","        }","    }","    func updateWeatherData() async {","        \/\/ fetches new weather data and updates app state","    }","}"],"syntax":null}],"kind":"content"}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Swift/Never/backgroundTask(_:action:)-468ox":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier