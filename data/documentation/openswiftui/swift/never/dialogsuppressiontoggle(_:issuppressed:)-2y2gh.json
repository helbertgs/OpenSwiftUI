{"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Swift\/Never\/dialogSuppressionToggle(_:isSuppressed:)-2y2gh","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/openswiftui\/swift\/never\/dialogsuppressiontoggle(_:issuppressed:)-2y2gh"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"preciseIdentifier":"s:ScM","kind":"attribute","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"dialogSuppressionToggle"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"label"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSwiftUI4TextV","kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text","text":"Text"},{"kind":"text","text":", "},{"kind":"externalParam","text":"isSuppressed"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSwiftUI7BindingV","kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding","text":"Binding"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":">) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","text":"Scene"},{"kind":"text","text":"\n"}],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The label of the suppression toggle in the dialog. This"},{"type":"text","text":" "},{"type":"text","text":"parameter can be elided to use the default suppression title."}],"type":"paragraph"}],"name":"label"},{"content":[{"inlineContent":[{"type":"text","text":"Whether the suppression toggle is on or off in the"},{"type":"text","text":" "},{"type":"text","text":"dialog."}],"type":"paragraph"}],"name":"isSuppressed"}]},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"type":"text","text":"Applying dialog suppression adds a toggle to dialogs on Windows,"},{"type":"text","text":" "},{"type":"text","text":"which allows the user to request the alert not be displayed again."},{"type":"text","text":" "},{"type":"text","text":"Typically whether a dialog is suppressed is stored in "},{"code":"AppStorage","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and used to decide whether to present the dialog in the future."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example configures an alert with a"},{"type":"text","text":" "},{"type":"text","text":"suppression toggle. The toggle’s state is stored in "},{"code":"AppStorage","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"used to determine whether or not to show the dialog when the"},{"type":"text","text":" "},{"type":"text","text":"“Delete Items” button is pressed."}],"type":"paragraph"},{"syntax":null,"code":["struct MyApp: App {","    @State private var isShowingDialog = false","    @AppStorage(\"suppressEraseItemAlert\")","    private var suppressAlert = false","","    var body: some Scene {","        Window(...) {","            Button(\"Delete items\") {","                isShowingDialog = true","            }","        }","","        AlertScene(","            \"Are you sure you want to erase these items?\",","            isPresented: $isShowingDialog","        ) {","            Button(\"Erase\", role: .destructive) {","                \/\/ Handle item deletion.","            }","            Button(\"Cancel\", role: .cancel) {","                \/\/ Handle cancellation","            }","        }","        .dialogSuppressionToggle(","            \"Do not ask about erasing items again\",","            isSuppressed: $suppressAlert)","    }","}"],"type":"codeListing"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Swift","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Swift\/Never"]]},"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"dialogSuppressionToggle"},{"kind":"text","text":"("},{"preciseIdentifier":"s:11OpenSwiftUI4TextV","kind":"typeIdentifier","text":"Text"},{"kind":"text","text":", "},{"kind":"externalParam","text":"isSuppressed"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSwiftUI7BindingV","kind":"typeIdentifier","text":"Binding"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":">) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","kind":"typeIdentifier","text":"Scene"}],"modules":[{"name":"OpenSwiftUI"}],"title":"dialogSuppressionToggle(_:isSuppressed:)","role":"symbol","extendedModule":"OpenSwiftUI","roleHeading":"Instance Method","symbolKind":"method","externalID":"s:11OpenSwiftUI5ScenePAAE23dialogSuppressionToggle_12isSuppressedQrAA4TextV_AA7BindingVySbGtF::SYNTHESIZED::s:s5NeverO"},"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Enables user suppression of an alert with a custom suppression"},{"type":"text","text":" "},{"type":"text","text":"message."}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Swift/Never":{"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:s5NeverO","kind":"identifier","text":"Never"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Swift\/Never","role":"symbol","abstract":[],"title":"Never","url":"\/documentation\/openswift