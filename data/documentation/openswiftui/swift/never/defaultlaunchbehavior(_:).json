hBehavior"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"SceneLaunchBehavior","preciseIdentifier":"s:11OpenSwiftUI19SceneLaunchBehaviorV"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Swift":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Swift","role":"collection","abstract":[],"title":"Swift","url":"\/documentation\/openswiftui\/swift","kind":"symbol","type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/SceneLaunchBehavior/automatic":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"automatic","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI19SceneLaunchBehaviorV","text":"SceneLaunchBehavior","kind":"typeIdentifier"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneLaunchBehavior\/automatic","role":"symbol","abstract":[{"type":"text","text":"The automatic behavior."}],"title":"automatic","url":"\/documentation\/openswiftui\/scenelaunchbehavior\/automatic","kind":"symbol","type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scene"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","role":"symbol","abstract":[{"type":"text","text":"A part of an app’s user interface with a life cycle managed by the"},{"type":"text","text":" "},{"type":"text","text":"system."}],"title":"Scene","kind":"symbol","url":"\/documentation\/openswiftui\/scene","navigatorTitle":[{"kind":"identifier","text":"Scene"}],"type":"topic"}}}