 or stroked","type":"text"},{"text":" ","type":"text"},{"text":"shape or conditionally mirror the points in the path of the shape.","type":"text"}],"type":"paragraph"}]}],"sections":[],"abstract":[{"type":"text","text":"Returns the behavior this shape should use for different layout"},{"type":"text","text":" "},{"type":"text","text":"directions."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/circle\/layoutdirectionbehavior"]}],"metadata":{"roleHeading":"Instance Property","symbolKind":"property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"layoutDirectionBehavior"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI23LayoutDirectionBehaviorO","text":"LayoutDirectionBehavior"}],"title":"layoutDirectionBehavior","role":"symbol","modules":[{"name":"OpenSwiftUI"}],"externalID":"s:11OpenSwiftUI6CircleV23layoutDirectionBehaviorAA06LayoutfG0Ovp"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Circle":{"abstract":[{"type":"text","text":"A circle centered on the frame of the view containing it."}],"kind":"symbol","navigatorTitle":[{"text":"Circle","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Circle","title":"Circle","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Circle","kind":"identifier"}],"url":"\/documentation\/openswiftui\/circle"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Circle/layoutDirectionBehavior":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Circle\/layoutDirectionBehavior","role":"symbol","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Returns the behavior this shape should use for different layout"},{"type":"text","text":" "},{"type":"text","text":"directions."}],"title":"layoutDirectionBehavior","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":