 the names "},{"type":"codeVoice","code":"\"Bethany\""},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"\"Eric\""},{"type":"text","text":" do not appear in "},{"type":"codeVoice","code":"eitherNeighborsOrEmployees"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":null,"code":["let employees: Set = [\"Alicia\", \"Bethany\", \"Diana\", \"Eric\"]","let neighbors: Set = [\"Bethany\", \"Eric\", \"Forlani\"]","let eitherNeighborsOrEmployees = employees.symmetricDifference(neighbors)","print(eitherNeighborsOrEmployees)","\/\/ Prints \"[\"Diana\", \"Forlani\", \"Alicia\"]\""],"type":"codeListing"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/accessibilitytechnologies\/symmetricdifference(_:)"]}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/AccessibilityTechnologies"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/AccessibilityTechnologies\/symmetricDifference(_:)","interfaceLanguage":"swift"},"kind":"symbol","abstract":[{"type":"text","text":"Returns a new set with the elements that are either in this set or in the"},{"type":"text","text":" "},{"type":"text","text":"given set, but not in both."}],"sections":[],"metadata":{"modules":[{"name":"OpenSwiftUI"}],"title":"symmetricDifference(_:)","externalID":"s:11OpenSwiftUI25AccessibilityTechnologiesV19symmetricDifferenceyA2CF","role":"symbol","symbolKind":"method","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"symmetricDifference","kind":"identifier"},{"text":"(","kind":"text"},{"text":"AccessibilityTechnologies","preciseIdentifier":"s:11OpenSwiftUI25AccessibilityTechnologiesV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"AccessibilityTechnologies","preciseIdentifier":"s:11OpenSwi