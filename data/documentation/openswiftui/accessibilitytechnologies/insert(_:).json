{"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"insert","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI25AccessibilityTechnologiesV","text":"AccessibilityTechnologies","kind":"typeIdentifier"},{"text":") -> (inserted","kind":"text"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":", memberAfterInsert","kind":"text"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI25AccessibilityTechnologiesV","text":"AccessibilityTechnologies","kind":"typeIdentifier"},{"text":")","kind":"text"}],"externalID":"s:11OpenSwiftUI25AccessibilityTechnologiesV6insertySb8inserted_AC17memberAfterInserttACF","role":"symbol","roleHeading":"Instance Method","modules":[{"name":"OpenSwiftUI"}],"title":"insert(_:)"},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/AccessibilityTechnologies\/insert(_:)","interfaceLanguage":"swift"},"kind":"symbol","variants":[{"paths":["\/documentation\/openswiftui\/accessibilitytechnologies\/insert(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Inserts the given element in the set if it is not already present."}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"insert"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"newMember"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSwiftUI25AccessibilityTechnologiesV","kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/AccessibilityTechnologies","text":"AccessibilityTechnologies"},{"kind":"text","text":") -> (inserted"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":", memberAfterInsert"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSwiftUI25AccessibilityTechnologiesV","kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/AccessibilityTechnologies","text":"AccessibilityTechnologies"},{"kind":"text","text":")"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"An element to insert into the set."}],"type":"paragraph"}],"name":"newMember"}]},{"content":[{"anchor":"return-value","text":"Return Value","type":"heading","level":2},{"inlineContent":[{"type":"text","text":""},{"code":"(true, newMember)","type":"codeVoice"},{"type":"text","text":" if "},{"code":"newMember","type":"codeVoice"},{"type":"text","text":" was not contained in the"},{"type":"text","text":" "},{"type":"text","text":"set. If an element equal to "},{"code":"newMember","type":"codeVoice"},{"type":"text","text":" was already contained in the"},{"type":"text","text":" "},{"type":"text","text":"set, the method returns "},{"code":"(false, oldMember)","type":"codeVoice"},{"type":"text","text":", where "},{"code":"oldMember","type":"codeVoice"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"element that was equal to "},{"code":"newMember","type":"codeVoice"},{"type":"text","text":". In some cases, "},{"code":"oldMember","type":"codeVoice"},{"type":"text","text":" may"},{"type":"text","text":" "},{"type":"text","text":"be distinguishable from "},{"code":"newMember","type":"codeVoice"},{"type":"text","text":" by identity comparison or some"},{"type":"text","text":" "},{"type":"text","text":"other means."}],"type":"paragraph"}],"kind":"content"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If an element equal to "},{"type":"codeVoice","code":"newMember"},{"type":"text","text":" is already contained in the set, this"},{"type":"text","text":" "},{"type":"text","text":"method has no effect. In this example, a new element is inserted into"},{"type":"text","text":" "},{"type":"codeVoice","code":"classDays"},{"type":"text","text":", a set of days of the week. When an existing element is"},{"type":"text","text":" "},{"type":"text","text":"inserted, the "},{"type":"codeVoice","code":"classDays"},{"type":"text","text":" set does not change."}]},{"type":"codeListing","syntax":null,"code":["enum DayOfTheWeek: Int {","    case sunday, monday, tuesday, wednesday, thursday,","        friday, saturday","}","","var classDays: Set<DayOfTheWeek> = [.wednesday, .friday]","print(classDays.insert(.monday))","\/\/ Prints \"(true, .monday)\"","print(classDays)","\/\/ Prints \"[.friday, .wednesday, .monday]\"","","print(classDays.insert(.friday))","\/\/ Prints \"(false, .friday)\"","print(classDays)","\/\/ Prints \"[.friday, .wednesday, .monday]\""]}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/AccessibilityTechnologies"]]},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/AccessibilityTechnologies/insert(_:)":{"kind":"symbol","url":"\/documentation\/openswiftui\/accessibilitytechnologies\/insert(_:)","abstract":[{"text":"Inserts the given element in the set if it is not already present.","type":"text"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/AccessibilityTechnologies\/insert(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"insert"},{"kind":"text","text":"("},{"preciseIdentifier":"s:11OpenSwiftUI25AccessibilityTechnologiesV","kind":"typeIdentifier","text":"AccessibilityTechnologies"},{"kind":"text","text":") -> (inserted"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"B