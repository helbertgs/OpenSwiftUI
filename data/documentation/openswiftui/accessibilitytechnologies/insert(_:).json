{"abstract":[{"text":"Inserts the given element in the set if it is not already present.","type":"text"}],"kind":"symbol","variants":[{"paths":["\/documentation\/openswiftui\/accessibilitytechnologies\/insert(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"symbolKind":"method","externalID":"s:11OpenSwiftUI25AccessibilityTechnologiesV6insertySb8inserted_AC17memberAfterInserttACF","roleHeading":"Instance Method","modules":[{"name":"OpenSwiftUI"}],"role":"symbol","title":"insert(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"insert","kind":"identifier"},{"text":"(","kind":"text"},{"text":"AccessibilityTechnologies","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI25AccessibilityTechnologiesV"},{"text":") -> (inserted","kind":"text"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", memberAfterInsert","kind":"text"},{"text":": ","kind":"text"},{"text":"AccessibilityTechnologies","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI25AccessibilityTechnologiesV"},{"text":")","kind":"text"}]},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/AccessibilityTechnologies"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/AccessibilityTechnologies\/insert(_:)"},"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"insert","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"newMember","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"AccessibilityTechnologies","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI25AccessibilityTechnologiesV","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/AccessibilityTechnologies"},{"text":") -> (inserted","kind":"text"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", memberAfterInsert","kind":"text"},{"text":": ","kind":"text"},{"text":"AccessibilityTechnologies","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI25AccessibilityTechnologiesV","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/AccessibilityTechnologies"},{"text":")","kind":"text"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"newMember","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An element to insert into the set."}]}]}]},{"kind":"content","content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"(true, newMember)"},{"type":"text","text":" if "},{"type":"codeVoice","code":"newMember"},{"type":"text","text":" was not contained in the"},{"type":"text","text":" "},{"type":"text","text":"set. If an element equal to "},{"type":"codeVoice","code":"newMember"},{"type":"text","text":" was already contained in the"},{"type":"text","text":" "},{"type":"text","text":"set, the method returns "},{"type":"codeVoice","code":"(false, oldMember)"},{"type":"text","text":", where "},{"type":"codeVoice","code":"oldMember"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"element that was equal to "},{"type":"codeVoice","code":"newMember"},{"type":"text","text":". In some cases, "},{"type":"codeVoice","code":"oldMember"},{"type":"text","text":" may"},{"type":"text","text":" "},{"type":"text","text":"be distinguishable from "},{"type":"codeVoice","code":"newMember"},{"type":"text","text":" by identity comparison or some"},{"type":"text","text":" "},{"type":"text","text":"other means."}],"type":"paragraph"}]},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If an element equal to "},{"type":"codeVoice","code":"newMember"},{"type":"text","text":" is already contained in the set, this"},{"type":"text","text":" "},{"type":"text","text":"method has no effect. In this example, a new element is inserted into"},{"type":"text","text":" "},{"type":"codeVoice","code":"classDays"},{"type":"text","text":", a set of days of the week. When an existing element is"},{"type":"text","text":" "},{"type":"text","text":"inserted, the "},{"type":"codeVoice","code":"classDays"},{"type":"text","text":" set does not change."}]},{"syntax":null,"type":"codeListing","code":["enum DayOfTheWeek: Int {","    case sunday, monday, tuesday, wednesday, thursday,","        friday, saturday","}","","var classDays: Set<DayOfTheWeek> = [.wednesday, .friday]","print(classDays.insert(.monday))","\/\/ Prints \"(true, .monday)\"","print(classDays)","\/\/ Prints \"[.friday, .wednesday, .monday]\"","","print(classDays.insert(.friday))","\/\/ Prints \"(false, .friday)\"","print(classDays)","\/\/ Prints \"[.friday, .wednesday, .monday]\""]}],"kind":"content"}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/AccessibilityTechnologies/insert(_:)":{"abstract":[{"type":"text","text":"Inserts the given element in the set if it is not already present."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/AccessibilityTechnologies\/insert(_:)","title":"insert(_:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"insert","kind":"identifier"},{"text":"(","kind":"text"},{"text":"AccessibilityTechnologies","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI25AccessibilityTechnologiesV"},{"text":") -> (inserted","kind":"text"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", memberA