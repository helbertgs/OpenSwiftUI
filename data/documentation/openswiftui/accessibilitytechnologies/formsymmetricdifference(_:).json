{"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/AccessibilityTechnologies"]]},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/AccessibilityTechnologies\/formSymmetricDifference(_:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Removes the elements of the set that are also in the given set and adds"},{"type":"text","text":" "},{"type":"text","text":"the members of the given set that are not already in the set."}],"metadata":{"modules":[{"name":"OpenSwiftUI"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"formSymmetricDifference"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"AccessibilityTechnologies","preciseIdentifier":"s:11OpenSwiftUI25AccessibilityTechnologiesV"},{"kind":"text","text":")"}],"role":"symbol","title":"formSymmetricDifference(_:)","externalID":"s:11OpenSwiftUI25AccessibilityTechnologiesV23formSymmetricDifferenceyyACF","roleHeading":"Instance Method","symbolKind":"method"},"kind":"symbol","sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"formSymmetricDifference"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"other"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSwiftUI25AccessibilityTechnologiesV","kind":"typeIdentifier","text":"AccessibilityTechnologies","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/AccessibilityTechnologies"},{"kind":"text","text":")"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A set of the same type."}]}],"name":"other"}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In the following example, the elements of the "},{"type":"codeVoice","code":"employees"},{"type":"text","text":" set that are"},{"type":"text","text":" "},{"type":"text","text":"also members of "},{"type":"codeVoice","code":"neighbors"},{"type":"text","text":" are removed from "},{"type":"codeVoice","code":"employees"},{"type":"text","text":", while the"},{"type":"text","text":" "},{"type":"text","text":"elements of "},{"type":"codeVoice","code":"neighbors"},{"type":"text","text":" that are not members of "},{"type":"codeVoice","code":"employees"},{"type":"text","text":" are added to"},{"type":"text","text":" "},{"type":"codeVoice","code":"employees"},{"type":"text","text":". In particular, the names "},{"type":"codeVoice","code":"\"Bethany\""},{"type":"text","text":" and "},{"type":"codeVoice","code":"\"Eric\""},{"type":"text","text":" are"},{"type":"text","text":" "},{"type":"text","text":"removed from "},{"type":"codeVoice","code":"employees"},{"type":"text","text":" while the name "},{"type":"codeVoice","code":"\"Forlani\""},{"type":"text","text":" is added."}]},{"type":"codeListing","code":["var employees: Set = [\"Alicia\", \"Bethany\", \"Diana\", \"Eric\"]","let neighbors: Set = [\"Bethany\", \"Eric\", \"Forlani\"]","employees.formSymmetricDifference(neighbors)","print(employees)","\/\/ Prints \"[\"Diana\", \"Forlani\", \"Alicia\"]\""],"syntax":null}]}],"variants":[{"paths":["\/documentation\/openswiftui\/accessibilitytechnologies\/formsymmetricdifference(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/AccessibilityTechnologies":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AccessibilityTechnologies"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/AccessibilityTechnologies","role":"symbol","abstract":[{"type":"text","text":"Accessibility technologies available to the system."}],"title":"AccessibilityTechnologies","url":"\/documentation\/openswiftui\/accessibilitytechnologies","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"AccessibilityTechnologies"}],"type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/AccessibilityTechnologies/formSymmetricDifference(_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"formSymmetricDifference","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI25AccessibilityTechnologiesV","text":"AccessibilityTechnologies","kind":"typeIdentifier"},{"text":")","kind":"text"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/AccessibilityTechnologies\/formSymmetricDifference(_:)","role":"symbol","abstract":[{"type":"text","text":"Removes the elements of the set that are also in the given set and adds"},{"type":"text","text":" "},{"type":"text","text":"the members of the given set that are not already in the set."}],"title":"formSymmetricDifference(_:)","url":"\/documentation\/openswiftui\/accessibilitytechnologies\/formsymmetricdifference(_:)","kind":"symbol","type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","abstract":[],"title":"OpenSwiftUI","url":"\/documentation\/openswiftui","kind":"symbol","type":"topic"}}}