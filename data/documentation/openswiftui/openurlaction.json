{"abstract":[{"type":"text","text":"An action that opens a URL."}],"kind":"symbol","topicSections":[{"title":"Structures","generated":true,"anchor":"Structures","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction\/Result"]},{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction\/init(handler:)"]},{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction\/callAsFunction(_:)","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction\/callAsFunction(_:completion:)"]},{"title":"Default Implementations","generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction\/Equatable-Implementations"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/openurlaction"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction","interfaceLanguage":"swift"},"metadata":{"symbolKind":"struct","navigatorTitle":[{"text":"OpenURLAction","kind":"identifier"}],"roleHeading":"Structure","externalID":"s:11OpenSwiftUI0A9URLActionV","modules":[{"name":"OpenSwiftUI"}],"role":"symbol","title":"OpenURLAction","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OpenURLAction","kind":"identifier"}]},"sections":[],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/OpenSwiftUI\/s8CopyableP","doc:\/\/OpenSwiftUI\/SQ","doc:\/\/OpenSwiftUI\/s9EscapableP"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OpenURLAction","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Read the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/openURL","isActive":true},{"type":"text","text":" environment value to get an"},{"type":"text","text":" "},{"type":"text","text":"instance of this structure for a given "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","isActive":true},{"type":"text","text":". Call the"},{"type":"text","text":" "},{"type":"text","text":"instance to open a URL. You call the instance directly because it"},{"type":"text","text":" "},{"type":"text","text":"defines a "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction\/callAsFunction(_:)","isActive":true},{"type":"text","text":" method that Swift"},{"type":"text","text":" "},{"type":"text","text":"calls when you call the instance."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, you can open a web site when the user taps a button:"}]},{"syntax":null,"type":"codeListing","code":["struct OpenURLExample: View {","    @Environment(\\.openURL) private var openURL","","    var body: some View {","        Button {","            if let url = URL(string: \"https:\/\/www.example.com\") {","                openURL(url)","            }","        } label: {","            Label(\"Get Help\", systemImage: \"person.fill.questionmark\")","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you want to know whether the action succeeds, add a completion"},{"type":"text","text":" "},{"type":"text","text":"handler that takes a Boolean value. In this case, Swift implicitly"},{"type":"text","text":" "},{"type":"text","text":"calls the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction\/callAsFunction(_:completion:)","isActive":true},{"type":"text","text":" method"},{"type":"text","text":" "},{"type":"text","text":"instead. That method calls your completion handler after it determines"},{"type":"text","text":" "},{"type":"text","text":"whether it can open the URL, but possibly before it finishes opening"},{"type":"text","text":" "},{"type":"text","text":"the URL. You can add a handler to the example above so that"},{"type":"text","text":" "},{"type":"text","text":"it prints the outcome to the console:"}]},{"syntax":null,"type":"codeListing","code":["openURL(url) { accepted in","    print(accepted ? \"Success\" : \"Failure\")","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The system provides a default open URL action with behavior"},{"type":"text","text":" "},{"type":"text","text":"that depends on the contents of the URL. For example, the default"},{"type":"text","text":" "},{"type":"text","text":"action opens a Universal Link in the associated app if possible,"},{"type":"text","text":" "},{"type":"text","text":"or in the user’s default web browser if not."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can also set a custom action using the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/View\/environment(_:_:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"view modifier. Any views that read the action from the environment,"},{"type":"text","text":" "},{"type":"text","text":"including the built-in "},{"type":"codeVoice","code":"Link"},{"type":"text","text":" view and "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text","isActive":true},{"type":"text","text":" views with markdown"},{"type":"text","text":" "},{"type":"text","text":"links, or links in attributed strings, use your action. Initialize an"},{"type":"text","text":" "},{"type":"text","text":"action by calling the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction\/init(handler:)","isActive":true},{"type":"text","text":" initializer with"},{"type":"text","text":" "},{"type":"text","text":"a handler that takes a URL and returns an "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction\/Result","isActive":true},{"type":"text","text":":"}]},{"syntax":null,"type":"codeListing","code":["Text(\"Visit [Example Company](https:\/\/www.example.com) for details.\")","    .environment(\\.openURL, OpenURLAction { url in","        handleURL(url) \/\/ Define this method to take appropriate action.","        return .handled","    })"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"OpenSwiftUI translates the value that your custom action’s handler"},{"type":"text","text":" "},{"type":"text","text":"returns into an appropriate Boolean result for the action call."},{"type":"text","text":" "},{"type":"text","text":"For example, a view that uses the action declared above"},{"type":"text","text":" "},{"type":"text","text":"receives "},{"type":"codeVoice","code":"true"},{"type":"text","text":" when calling the action, because the"},{"type":"text","text":" "},{"type":"text","text":"handler always returns "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction\/Result\/handled","isActive":true},{"type":"text","text":"."}]}],"kind":"content"}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues/openURL":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/openURL","role":"symbol","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"An action that opens a URL."}],"title":"openURL","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"openURL","kind":"identifier"},{"text":": ","kind":"text"},{"text":"OpenURLAction","preciseIdentifier":"s:11OpenSwiftUI0A9URLActionV","kind":"typeIdentifier"}],"url":"\/documentation\/openswiftui\/environmentvalues\/openurl"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Environment":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Environment","kind":"identifier"}],"kind":"symbol","title":"Environment","type":"topic","url":"\/documentation\/openswiftui\/environment","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","abstract":[{"type":"text","text":"A property wrapper that reads a value from a view’s environment."}],"role":"symbol","navigatorTitle":[{"text":"Environment","kind":"identifier"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/View/environment(_:_:)":{"fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"environment","kind":"identifier"},{"kind":"text","text":"<"},{"text":"V","kind":"genericParameter"},{"kind":"text","text":">("},{"text":"WritableKeyPath","kind":"typeIdentifier","preciseIdentifier":"s:s15WritableKeyPathC"},{"kind":"text","text":"<"},{"text":"EnvironmentValues","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI17EnvironmentValuesV"},{"kind":"text","text":", "},{"text":"V","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"kind":"typeIdentifier","text":"V"},{"text":") -> ","kind":"text"},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI4ViewP","text":"View"}],"kind":"symbol","title":"environment(_:_:)","type":"topic","url":"\/documentation\/openswiftui\/view\/environment(_:_:)","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/View\/environment(_:_:)","abstract":[],"role":"symbol"},"doc://OpenSwiftUI/SQ":{"title":"Swift.Equatable","identifier":"doc:\/\/OpenSwiftUI\/SQ","type":"unresolvable"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/OpenURLAction/Equatable-Implementations":{"abstract":[],"kind":"article","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAct