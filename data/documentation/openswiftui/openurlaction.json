{"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/OpenSwiftUI\/s8CopyableP","doc:\/\/OpenSwiftUI\/SQ","doc:\/\/OpenSwiftUI\/s9EscapableP"]}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"sections":[],"metadata":{"symbolKind":"struct","externalID":"s:11OpenSwiftUI0A9URLActionV","modules":[{"name":"OpenSwiftUI"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OpenURLAction","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"OpenURLAction"}],"title":"OpenURLAction","roleHeading":"Structure"},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OpenURLAction","kind":"identifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"type":"text","text":"Read the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/openURL","isActive":true},{"type":"text","text":" environment value to get an"},{"type":"text","text":" "},{"type":"text","text":"instance of this structure for a given "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","isActive":true},{"type":"text","text":". Call the"},{"type":"text","text":" "},{"type":"text","text":"instance to open a URL. You call the instance directly because it"},{"type":"text","text":" "},{"type":"text","text":"defines a "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction\/callAsFunction(_:)","isActive":true},{"type":"text","text":" method that Swift"},{"type":"text","text":" "},{"type":"text","text":"calls when you call the instance."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, you can open a web site when the user taps a button:"}],"type":"paragraph"},{"code":["struct OpenURLExample: View {","    @Environment(\\.openURL) private var openURL","","    var body: some View {","        Button {","            if let url = URL(string: \"https:\/\/www.example.com\") {","                openURL(url)","            }","        } label: {","            Label(\"Get Help\", systemImage: \"person.fill.questionmark\")","        }","    }","}"],"type":"codeListing","syntax":null},{"inlineContent":[{"type":"text","text":"If you want to know whether the action succeeds, add a completion"},{"type":"text","text":" "},{"type":"text","text":"handler that takes a Boolean value. In this case, Swift implicitly"},{"type":"text","text":" "},{"type":"text","text":"calls the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction\/callAsFunction(_:completion:)","isActive":true},{"type":"text","text":" method"},{"type":"text","text":" "},{"type":"text","text":"instead. That method calls your completion handler after it determines"},{"type":"text","text":" "},{"type":"text","text":"whether it can open the URL, but possibly before it finishes opening"},{"type":"text","text":" "},{"type":"text","text":"the URL. You can add a handler to the example above so that"},{"type":"text","text":" "},{"type":"text","text":"it prints the outcome to the console:"}],"type":"paragraph"},{"code":["openURL(url) { accepted in","    print(accepted ? \"Success\" : \"Failure\")","}"],"type":"codeListing","syntax":null},{"inlineContent":[{"type":"text","text":"The system provides a default open URL action with behavior"},{"type":"text","text":" "},{"type":"text","text":"that depends on the contents of the URL. For example, the default"},{"type":"text","text":" "},{"type":"text","text":"action opens a Universal Link in the associated app if possible,"},{"type":"text","text":" "},{"type":"text","text":"or in the user’s default web browser if not."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can also set a custom action using the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/View\/environment(_:_:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"view modifier. Any views that read the action from the environment,"},{"type":"text","text":" "},{"type":"text","text":"including the built-in "},{"type":"codeVoice","code":"Link"},{"type":"text","text":" view and "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text","isActive":true},{"type":"text","text":" views with markdown"},{"type":"text","text":" "},{"type":"text","text":"links, or links in attributed strings, use your action. Initialize an"},{"type":"text","text":" "},{"type":"text","text":"action by calling the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction\/init(handler:)","isActive":true},{"type":"text","text":" initializer with"},{"type":"text","text":" "},{"type":"text","text":"a handler that takes a URL and returns an "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction\/Result","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"code":["Text(\"Visit [Example Company](https:\/\/www.example.com) for details.\")","    .environment(\\.openURL, OpenURLAction { url in","        handleURL(url) \/\/ Define this method to take appropriate action.","        return .handled","    })"],"type":"codeListing","syntax":null},{"inlineContent":[{"type":"text","text":"OpenSwiftUI translates the value that your custom action’s handler"},{"type":"text","text":" "},{"type":"text","text":"returns into an appropriate Boolean result for the action call."},{"type":"text","text":" "},{"type":"text","text":"For example, a view that uses the action declared above"},{"type":"text","text":" "},{"type":"text","text":"receives "},{"type":"codeVoice","code":"true"},{"type":"text","text":" when calling the action, because the"},{"type":"text","text":" "},{"type":"text","text":"handler always returns "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction\/Result\/handled","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/openswiftui\/openurlaction"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","abstract":[{"type":"text","text":"An action that opens a URL."}],"topicSections":[{"generated":true,"title":"Structures","anchor":"Structures","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction\/Result"]},{"generated":true,"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction\/init(handler:)"]},{"generated":true,"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction\/callAsFunction(_:)","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction\/callAsFunction(_:completion:)"]},{"generated":true,"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction\/Equatable-Implementations"]}],"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction","interfaceLanguage":"swift"},"references":{"doc://OpenSwiftUI/s9EscapableP":{"title":"Swift.Escapable","identifier":"doc:\/\/OpenSwiftUI\/s9EscapableP","type":"unresolvable"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Text":{"url":"\/documentation\/openswiftui\/text","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text","title":"Text","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A view that displays one or more lines of read-only text."}],"navigatorTitle":[{"kind":"identifier","text":"Text"}],"fragment