ll\", systemImage: \"heart\")","    .environment(\\.symbolVariants, .fill)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"OpenSwiftUI sets a variant for you in some environments. For example, OpenSwiftUI"},{"type":"text","text":" "},{"type":"text","text":"automatically applies the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SymbolVariants\/fill-swift.type.property","isActive":true},{"type":"text","text":" "},{"type":"text","text":"symbol variant for items that appear in the "},{"type":"codeVoice","code":"content"},{"type":"text","text":" closure of the"},{"type":"text","text":" "},{"type":"codeVoice","code":"View\/swipeActions(edge:allowsFullSwipe:content:)"},{"type":"text","text":" "},{"type":"text","text":"method, or as the tab bar items of a "},{"type":"codeVoice","code":"TabView"},{"type":"text","text":"."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/openswiftui\/symbolvariants"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","abstract":[{"text":"A variant of a symbol.","type":"text"}],"topicSections":[{"anchor":"Instance-Properties","generated":true,"title":"Instance Properties","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SymbolVariants\/circle-swift.property","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SymbolVariants\/fill-swift.property","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SymbolVariants\/rectangle-swift.property","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SymbolVariants\/slash-swift.property","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SymbolVariants\/square-swift.property"]},{"anchor":"Instance-Methods","generated":true,"title":"Instance Methods","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SymbolVariants\/contains(_:)"]},{"anchor":"Type-Properties","generated":true,"title":"Type Properties","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SymbolVariants\/circle-swift.type.prope