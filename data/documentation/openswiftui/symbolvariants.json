deVoice"},{"type":"text","text":" modifier to a view to set a variant"},{"type":"text","text":" "},{"type":"text","text":"for that view’s environment. For example, you can use the modifier to"},{"type":"text","text":" "},{"type":"text","text":"create the same set of labels as in the example above, using only the"},{"type":"text","text":" "},{"type":"text","text":"base name of the symbol in the label declarations:"}],"type":"paragraph"},{"syntax":null,"code":["VStack(alignment: .leading) {","    Label(\"Default\", systemImage: \"heart\")","    Label(\"Fill\", systemImage: \"heart\")","        .symbolVariant(.fill)","    Label(\"Circle\", systemImage: \"heart\")","        .symbolVariant(.circle)","    Label(\"Circle Fill\", systemImage: \"heart\")","        .symbolVariant(.circle.fill)","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Alternatively, you can set the variant in the environment directly by"},{"type":"text","text":" "},{"type":"text","text":"passing the "},{"code":"EnvironmentValues\/symbolVariants","type":"codeVoice"},{"type":"text","text":" environment value to the"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/View\/environment(_:_:)"},{"type":"text","text":" modifier:"}],"type":"paragraph"},{"syntax":null,"code":["Label(\"Fill\", systemImage: \"heart\")","    .environment(\\.symbolVariants, .fill)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"OpenSwiftUI sets a variant for you in some environments. For example, OpenSwiftUI"},{"type":"text","text":" "},{"type":"text","text":"automatically applies the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SymbolVariants\/fill-swift.type.property"},{"type":"text","text":" "},{"type":"text","text":"symbol variant for items that appear in the "},{"code":"content","type":"codeVoice"},{"type":"text","text":" closure of the"},{"type":"text","text":" "},{"code":"View\/swipeActions(edge:allowsFullSwipe:content:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"method, or as the tab bar items of a "},{"code":"TabView","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"externalID":"s:11OpenSwiftUI14SymbolVariantsV","roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SymbolVariants"}],"role":"symbol","navigatorTitle":[{"text":"SymbolVariants","kind":"identifier"}],"title":"SymbolVariants","symbolKind":"struct","modules":[{"name":"OpenSwiftUI"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/symbolvariants"]}],"references":{"doc://OpenSwiftUI/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/OpenSwiftUI\/s16SendableMetatypeP"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/SymbolVariants/square-swift.property":{"title":"square","role":"symbol","type":"topic","url":"\/documentation\/openswiftui\/symbolvariants\/square-swift.property","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SymbolVariants\/square-swift.property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"square","kind":"identifier"},{"text":": ","kind":"text"},{"text":"SymbolVariants","preciseIdentifier":"s:11OpenSwiftUI14SymbolVariantsV","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"A version of the variant that’s encapsulated in a square."}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Image":{"navigatorTitle":[{"text":"Image","kind":"identifier"}],"title":"Image","role":"symbol","type":"topic","url":"\/documentation\/openswiftui\/image","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Image","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Image","kind":"identifier"