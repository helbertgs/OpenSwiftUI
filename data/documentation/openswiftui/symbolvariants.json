 a variant for you in some environments. For example, OpenSwiftUI"},{"type":"text","text":" "},{"type":"text","text":"automatically applies the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SymbolVariants\/fill-swift.type.property"},{"type":"text","text":" "},{"type":"text","text":"symbol variant for items that appear in the "},{"code":"content","type":"codeVoice"},{"type":"text","text":" closure of the"},{"type":"text","text":" "},{"code":"View\/swipeActions(edge:allowsFullSwipe:content:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"method, or as the tab bar items of a "},{"code":"TabView","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/SymbolVariants/square-swift.type.property":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"text":"square","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI14SymbolVariantsV","kind":"typeIdentifier","text":"SymbolVariants"}],"url":"\/documentation\/openswiftui\/symbolvariants\/square-swift.type.property","type":"topic","kind":"symbol","title":"square","abstract":[{"type":"text","text":"A variant that encapsulates the symbol in a square."}],"role":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SymbolVariants\/square-swift.type.property"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/SymbolVariants/square-swift.property":{"abstract":[{"type":"text","text":"A version of the variant that’s encapsulated in a square."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SymbolVariants\/square-swift.property","title":"square","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"square"},{"kind":"text","text":":