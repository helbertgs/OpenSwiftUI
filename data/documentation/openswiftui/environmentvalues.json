{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EnvironmentValues","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"code":["@Environment(\\.locale) var locale: Locale"],"type":"codeListing","syntax":null},{"inlineContent":[{"type":"text","text":"Use the property you declare to dynamically control a view’s layout."},{"type":"text","text":" "},{"type":"text","text":"OpenSwiftUI automatically sets or updates many environment values, like"},{"type":"text","text":" "},{"type":"codeVoice","code":"EnvironmentValues\/pixelLength"},{"type":"text","text":", "},{"type":"codeVoice","code":"EnvironmentValues\/scenePhase"},{"type":"text","text":", or"},{"type":"text","text":" "},{"type":"codeVoice","code":"EnvironmentValues\/locale"},{"type":"text","text":", based on device characteristics, system state,"},{"type":"text","text":" "},{"type":"text","text":"or user settings. For others, like "},{"type":"codeVoice","code":"EnvironmentValues\/lineLimit"},{"type":"text","text":", OpenSwiftUI"},{"type":"text","text":" "},{"type":"text","text":"provides a reasonable default value."}],"type":"paragraph"},{"inlineContent":[{"text":"You can set or override some values using the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/View\/environment(_:_:)"},{"text":" ","type":"text"},{"text":"view modifier:","type":"text"}],"type":"paragraph"},{"code":["MyView()","    .environment(\\.lineLimit, 2)"],"type":"codeListing","syntax":null},{"inlineContent":[{"text":"The value that you set affects the environment for the view that you modify","type":"text"},{"text":" ","type":"text"},{"text":"— including its descendants in the view hierarchy — but only up to the","type":"text"},{"text":" ","type":"text"},{"text":"point wh