ier"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"codeListing","code":["@Environment(\\.locale) var locale: Locale"],"syntax":null},{"type":"paragraph","inlineContent":[{"text":"Use the property you declare to dynamically control a view’s layout.","type":"text"},{"text":" ","type":"text"},{"text":"OpenSwiftUI automatically sets or updates many environment values, like","type":"text"},{"text":" ","type":"text"},{"code":"EnvironmentValues\/pixelLength","type":"codeVoice"},{"text":", ","type":"text"},{"code":"EnvironmentValues\/scenePhase","type":"codeVoice"},{"text":", or","type":"text"},{"text":" ","type":"text"},{"code":"EnvironmentValues\/locale","type":"codeVoice"},{"text":", based on device characteristics, system state,","type":"text"},{"text":" ","type":"text"},{"text":"or user settings. For others, like ","type":"text"},{"code":"EnvironmentValues\/lineLimit","type":"codeVoice"},{"text":", OpenSwiftUI","type":"text"},{"text":" ","type":"text"},{"text":"provides a reasonable default value.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"You can set or override some values using the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/View\/environment(_:_:)"},{"text":" ","type":"text"},{"text":"view modifier:","type":"text"}]},{"type":"codeListing","code":["MyView()","    .environment(\\.lineLimit, 2)"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"The value that you set affects the environment for the view that you modify"},{"type":"text","text":" "},{"type":"text","text":"— including its descendants in the view hierarchy — but only up to the"},{"type":"text","text":" "},{"type":"text","text":"point where you apply a different environment modifier."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"OpenSwiftUI provides dedicated view modifiers for setting s