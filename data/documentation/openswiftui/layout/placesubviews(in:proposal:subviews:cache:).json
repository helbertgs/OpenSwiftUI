iewSize":{"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ProposedViewSize"}],"navigatorTitle":[{"kind":"identifier","text":"ProposedViewSize"}],"abstract":[{"type":"text","text":"A proposal for the size of a view."}],"title":"ProposedViewSize","kind":"symbol","role":"symbol","url":"\/documentation\/openswiftui\/proposedviewsize","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Layout/Cache":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/Cache","url":"\/documentation\/openswiftui\/layout\/cache","title":"Cache","kind":"symbol","abstract":[{"type":"text","text":"Cached values associated with the layout instance."}],"required":true,"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Cache"},{"kind":"text","text":" = "},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"}],"role":"symbol","type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/ProposedViewSize/unspecified":{"title":"unspecified","abstract":[{"type":"text","text":"The proposed size with both dimensions left unspecified."}],"url":"\/documentation\/openswiftui\/proposedviewsize\/unspecified","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"unspecified"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ProposedViewSize","preciseIdentifier":"s:11OpenSwiftUI16ProposedViewSizeV"}],"role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/unspecified"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Layout/sizeThatFits(proposal:subviews:cache:)":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/sizeThatFits(proposal:subviews:cache:)","fragments":