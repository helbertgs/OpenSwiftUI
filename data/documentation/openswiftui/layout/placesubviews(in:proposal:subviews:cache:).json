and alignment guides."}],"title":"dimensions(in:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dimensions","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ProposedViewSize","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI16ProposedViewSizeV"},{"text":") -> ","kind":"text"},{"text":"ViewDimensions","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI14ViewDimensionsV"}],"url":"\/documentation\/openswiftui\/layoutsubview\/dimensions(in:)"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Layout/Cache":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/Cache","role":"symbol","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Cached values associated with the layout instance."}],"title":"Cache","required":true,"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Cache","kind":"identifier"},{"text":" = ","kind":"text"},{"text":"Void","kind":"typeIdentifier","preciseIdentifier":"s:s4Voida"}],"url":"\/documentation\/openswiftui\/layout\/cache"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Layout/Subviews":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/Subviews","role":"symbol","kind":"symbol","type":"topic","navigatorTitle":[{"text":"Subviews","kind":"identifier"}],"abstract":[{"type":"text","text":"A collection of proxies for the subviews of a layout view."}],"title":"Layout.Subviews","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Subviews","kind":"identifier"}],"url":"\/documentation\/openswiftui\/layout\/subviews"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Layout/sizeThatFits(proposal:subviews:cache:)":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/sizeThatFits(proposal:subviews:cache:)","role":"symbol","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Returns the size of the composite view, given a proposed size"},{"type":"text","text":" "},{"type":"text","text":"and the view’s subviews."}],"title":"sizeThatFits(proposal:subviews:cache:)","required":true,"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sizeThatFits","kind":"identifier"},{"text":"(","kind":"text"},{"text":"proposal","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ProposedViewSize","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI16ProposedViewSizeV"},{"text":", ","kind":"text"},{"text":"subviews","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Subviews","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI6LayoutP8Subviewsa"},{"text":", ","kind":"text"},{"text":"cache","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Cache","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI6LayoutP5CacheQa"},{"text":") -> ","kind":"text"},{"text":"Size3D","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial6Size3DV"}],"url":"\/documentation\/openswiftui\/layout\/sizethatfits(proposal:subviews:cache:)"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/ProposedViewSize":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize","role":"symbol","kind":"symbol","type":"topic","navigatorTitle":[{"text":"ProposedViewSize","kind":"identifier"}],"abstract":[{"type":"text","text":"A proposal for the size of a view."}],"title":"ProposedViewSize","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ProposedViewSize","kind":"identifier"}],"url":"\/documentation\/openswiftui\/proposedviewsize"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/ViewSpacing/distance(to:along:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"distance"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI11ViewSpacingV","text":"ViewSpacing"},{"text":", ","kind":"text"},{"text":"along","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Axis","preciseIdentifier":"s:11OpenSwiftUI4AxisO","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Float","preciseIdentifier":"s:Sf","kind":"typeIdentifier"}],"kind":"symbol","title":"distance(to:along:)","type":"topic","url":"\/documentation\/openswiftui\/viewspacing\/distance(to:along:)","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ViewSpacing\/distance(to:along:)","abstract":[{"text":"Gets the preferred spacing distance along the specified axis to the view","type":"text"},{"text":" ","type":"text"},{"text":"that returns a specified spacing preference.","type":"text"}],"role":"symbol"},"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","type":"topic","kind":"symbol","abstract":[],"title":"OpenSwiftUI","url":"\/documentation\/openswiftui"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/ProposedViewSize/unspecified":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/unspecified","role":"symbol","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The proposed size with both dimensions left unspecified."}],"title":"unspecified","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"unspecified","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ProposedViewSize","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI16ProposedViewSizeV"}],"url":"\/documentation\/openswiftui\/proposedviewsize\/unspecified"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/LayoutSubview/spacing":{"fragments"