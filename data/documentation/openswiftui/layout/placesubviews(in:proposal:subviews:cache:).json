ftUI\/Layout","kind":"symbol","title":"Layout","type":"topic","abstract":[{"text":"A type that defines the geometry of a collection of views.","type":"text"}],"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Layout","kind":"identifier"}],"url":"\/documentation\/openswiftui\/layout","navigatorTitle":[{"text":"Layout","kind":"identifier"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/ProposedViewSize":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize","url":"\/documentation\/openswiftui\/proposedviewsize","navigatorTitle":[{"kind":"identifier","text":"ProposedViewSize"}],"type":"topic","abstract":[{"text":"A proposal for the size of a view.","type":"text"}],"kind":"symbol","title":"ProposedViewSize","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ProposedViewSize"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Layout/placeSubviews(in:proposal:subviews:cache:)":{"abstract":[{"type":"text","text":"Assigns positions to each of the layout’s subviews."}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"placeSubviews"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI4RectV","text":"Rect"},{"kind":"text","text":", "},{"kind":"externalParam","text":"proposal"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI16ProposedViewSizeV","text":"ProposedViewSize"},{"kind":"text","text":", "},{"kind":"externalParam","text":"subviews"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI6LayoutP8Subviewsa","text":"Subviews"},{"kind":"text","text":", "},{"kind":"externalParam","text":"cache"},{"kind":"text