{"sections":[],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout"]]},"metadata":{"symbolKind":"method","externalID":"s:11OpenSwiftUI6LayoutP13placeSubviews2in8proposal8subviews5cachey0A7Spatial6Rect3DV_AA16ProposedViewSizeVAA0dF0V5CacheQzztF","required":true,"modules":[{"name":"OpenSwiftUI"}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"placeSubviews","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Rect3D","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial6Rect3DV"},{"text":", ","kind":"text"},{"text":"proposal","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ProposedViewSize","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI16ProposedViewSizeV"},{"text":", ","kind":"text"},{"text":"subviews","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Subviews","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI6LayoutP8Subviewsa"},{"text":", ","kind":"text"},{"text":"cache","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Cache","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI6LayoutP5CacheQa"},{"text":")","kind":"text"}],"title":"placeSubviews(in:proposal:subviews:cache:)","roleHeading":"Instance Method"},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"placeSubviews","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"bounds","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSpatial6Rect3DV","text":"Rect3D","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"proposal","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI16ProposedViewSizeV","text":"ProposedViewSize","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"subviews","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI6LayoutP8Subviewsa","text":"Subviews","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/Subviews","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"cache","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI6LayoutP5CacheQa","text":"Cache","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/Cache","kind":"typeIdentifier"},{"text":")","kind":"text"}]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The region that the container view’s parent allocates to the","type":"text"},{"text":" ","type":"text"},{"text":"container view, specified in the parent’s coordinate space.","type":"text"},{"text":" ","type":"text"},{"text":"Place all the container’s subviews within the region.","type":"text"},{"text":" ","type":"text"},{"text":"The size of this region matches a size that your container","type":"text"},{"text":" ","type":"text"},{"text":"previously returned from a call to the","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/sizeThatFits(proposal:subviews:cache:)"},{"text":" method.","type":"text"}]}],"name":"bounds"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The size proposal from which the container generated the","type":"text"},{"text":" ","type":"text"},{"text":"size that the parent used to create the ","type":"text"},{"code":"bounds","type":"codeVoice"},{"text":" parameter.","type":"text"},{"text":" ","type":"text"},{"text":"The parent might propose more than one size before calling the","type":"text"},{"text":" ","type":"text"},{"text":"placement method, but it always uses one of the proposals and the","type":"text"},{"text":" ","type":"text"},{"text":"corresponding returned size when placing the container.","type":"text"}]}],"name":"proposal"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A collection of proxies that represent the","type":"text"},{"text":" ","type":"text"},{"text":"views that the container arranges. Use the proxies in the collection","type":"text"},{"text":" ","type":"text"},{"text":"to get information about the subviews and to tell the subviews","type":"text"},{"text":" ","type":"text"},{"text":"where to appear.","type":"text"}]}],"name":"subviews"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Optional storage for calculated data that you can share among","type":"text"},{"text":" ","type":"text"},{"text":"the methods of your custom layout container. See","type":"text"},{"text":" ","type":"text"},{"code":"makeCache(subviews:)-23agy","type":"codeVoice"},{"text":" for details.","type":"text"}]}],"name":"cache"}],"kind":"parameters"},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"OpenSwiftUI calls your implementation of this method to tell your"},{"type":"text","text":" "},{"type":"text","text":"custom layout container to place its subviews. From this method, call"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutSubview\/place(at:anchor:proposal:)"},{"type":"text","text":" method on each"},{"type":"text","text":" "},{"type":"text","text":"element in "},{"type":"codeVoice","code":"subviews"},{"type":"text","text":" to tell the subviews where to appear in the"},{"type":"text","text":" "},{"type":"text","text":"user interface."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, you can create a basic vertical stack that places views"},{"type":"text","text":" "},{"type":"text","text":"in a column, with views horizontally aligned on their leading edge:"}]},{"type":"codeListing","syntax":null,"code":["struct BasicVStack: Layout {","    func placeSubviews(","        in bounds: CGRect,","        proposal: ProposedViewSize,","        subviews: Subviews,","        cache: inout ()","    ) {","        var point = bounds.origin","        for subview in subviews {","            subview.place(at: point, anchor: .topLeading, proposal: .unspecified)","            point.y += subview.dimensions(in: .unspecified).height","        }","    }","","    \/\/ This layout also needs a sizeThatFits() implementation.","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The example creates a placement point that starts at the origin of the"},{"type":"text","text":" "},{"type":"text","text":"specified "},{"type":"codeVoice","code":"bounds"},{"type":"text","text":" input and uses that to place the first subview. It"},{"type":"text","text":" "},{"type":"text","text":"then moves the point in the y dimension by the subview’s height,"},{"type":"text","text":" "},{"type":"text","text":"which it reads using the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutSubview\/dimensions(in:)"},{"type":"text","text":" method."},{"type":"text","text":" "},{"type":"text","text":"This prepares the point for the next iteration of the loop. All"},{"type":"text","text":" "},{"type":"text","text":"subview operations use an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/unspecified"},{"type":"text","text":" size"},{"type":"text","text":" "},{"type":"text","text":"proposal to indicate that subviews should use and report their ideal"},{"type":"text","text":" "},{"type":"text","text":"size."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A more complex layout container might add space between subviews"},{"type":"text","text":" "},{"type":"text","text":"according to their "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutSubview\/spacing"},{"type":"text","text":" preferences, or a"},{"type":"text","text":" "},{"type":"text","text":"fixed space based on input configuration. For example, you can extend"},{"type":"text","text":" "},{"type":"text","text":"the basic vertical stack’s placement method to calculate the"},{"type":"text","text":" "},{"type":"text","text":"preferred distances between adjacent subviews and store the results in"},{"type":"text","text":" "},{"type":"text","text":"an array:"}]},{"type":"codeListing","syntax":null,"code":["let spacing: [CGFloat] = subviews.indices.dropLast().map { index in","    subviews[index].spacing.distance(","        to: subviews[index + 1].spacing,","        along: .vertical)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The spacing’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ViewSpacing\/distance(to:along:)"},{"type":"text","text":" method considers the"},{"type":"text","text":" "},{"type":"text","text":"preferences of adjacent views on the edge where they meet. It returns"},{"type":"text","text":" "},{"type":"text","text":"the smallest distance that satisfies both views’ preferences for the"},{"type":"text","text":" "},{"type":"text","text":"given edge. For example, if one view prefers at least "},{"type":"codeVoice","code":"2"},{"type":"text","text":" points on its"},{"type":"text","text":" "},{"type":"text","text":"bottom edge, and the next view prefers at least "},{"type":"codeVoice","code":"8"},{"type":"text","text":" points on its top"},{"type":"text","text":" "},{"type":"text","text":"edge, the distance method returns "},{"type":"codeVoice","code":"8"},{"type":"text","text":", because that’s the smallest"},{"type":"text","text":" "},{"type":"text","text":"value that satisfies both preferences."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Update the placement calculations to use the spacing values:"}]},{"type":"codeListing","syntax":null,"code":["var point = bounds.origin","for (index, subview) in subviews.enumerated() {","    if index > 0 { point.y += spacing[index - 1] } \/\/ Add spacing.","    subview.place(at: point, anchor: .topLeading, proposal: .unspecified)","    point.y += subview.dimensions(in: .unspecified).height","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Be sure that you use computations during placement that are consistent"},{"type":"text","text":" "},{"type":"text","text":"with those in your implementation of other protocol methods for a given"},{"type":"text","text":" "},{"type":"text","text":"set of inputs. For example, if you add spacing during placement,"},{"type":"text","text":" "},{"type":"text","text":"make sure your implementation of"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/sizeThatFits(proposal:subviews:cache:)"},{"type":"text","text":" accounts for the extra space."},{"type":"text","text":" "},{"type":"text","text":"Similarly, if the sizing method returns different values for different"},{"type":"text","text":" "},{"type":"text","text":"size proposals, make sure the placement method responds to its"},{"type":"text","text":" "},{"type":"codeVoice","code":"proposal"},{"type":"text","text":" input in the same way."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/openswiftui\/layout\/placesubviews(in:proposal:subviews:cache:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","abstract":[{"type":"text","text":"Assigns positions to each of the layout’s subviews."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/placeSubviews(in:proposal:subviews:cache:)"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/LayoutSubview/spacing":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"spacing"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ViewSpacing","preciseIdentifier":"s:11OpenSwiftUI11ViewSpacingV"}],"title":"spacing","abstract":[{"text":"The subviews’s preferred spacing values.","type":"text"}],"kind":"symbol","url":"\/documentation\/openswiftui\/layoutsubview\/spacing","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutSubview\/spacing","role":"symbol"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/LayoutSubview/place(at:anchor:proposal:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"place"},{"kind":"text","text":"("},{"kind":"externalParam","text":"at"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Point3D","preciseIdentifier":"s:11OpenSpatial7Point3DV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"anchor"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UnitPoint","preciseIdentifier":"s:11OpenSwiftUI9UnitPointV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"proposal"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ProposedViewSize","preciseIdentifier":"s:11OpenSwiftUI16ProposedViewSizeV"},{"kind":"text","text":")"}],"title":"place(at:anchor:proposal:)","abstract":[{"text":"Assigns a position and proposed size to the subview.","type":"text"}],"kind":"symbol","url":"\/documentation\/openswiftui\/la