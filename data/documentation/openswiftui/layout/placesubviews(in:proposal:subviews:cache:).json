t"},{"text":" ","type":"text"},{"text":"that returns a specified spacing preference.","type":"text"}],"url":"\/documentation\/openswiftui\/viewspacing\/distance(to:along:)","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ViewSpacing\/distance(to:along:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"distance","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ViewSpacing","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI11ViewSpacingV"},{"text":", ","kind":"text"},{"text":"along","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Axis","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI4AxisO"},{"text":") -> ","kind":"text"},{"text":"Float","kind":"typeIdentifier","preciseIdentifier":"s:Sf"}],"title":"distance(to:along:)"},"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","title":"OpenSwiftUI","abstract":[],"type":"topic","kind":"symbol","url":"\/documentation\/openswiftui","role":"collection"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Layout/sizeThatFits(proposal:subviews:cache:)":{"url":"\/documentation\/openswiftui\/layout\/sizethatfits(proposal:subviews:cache:)","title":"sizeThatFits(proposal:subviews:cache:)","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/sizeThatFits(proposal:subviews:cache:)","required":true,"abstract":[{"text":"Returns the size of the composite view, given a proposed size","type":"text"},{"text":" ","type":"text"},{"text":"and the view’s subviews.","type":"text"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"sizeThatFits"},{"kind":"text","text":"("},{"kind":"externalParam","text":"proposal"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSwiftUI16ProposedViewSizeV","kind":"typeIdentifier","text