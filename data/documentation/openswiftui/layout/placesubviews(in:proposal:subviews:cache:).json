ance(to:along:)","kind":"symbol","type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/LayoutSubview/dimensions(in:)":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutSubview\/dimensions(in:)","url":"\/documentation\/openswiftui\/layoutsubview\/dimensions(in:)","title":"dimensions(in:)","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Asks the subview for its dimensions and alignment guides."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dimensions","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ProposedViewSize","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI16ProposedViewSizeV"},{"text":") -> ","kind":"text"},{"text":"ViewDimensions","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI14ViewDimensionsV"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Layout/sizeThatFits(proposal:subviews:cache:)":{"url":"\/documentation\/openswiftui\/layout\/sizethatfits(proposal:subviews:cache:)","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/sizeThatFits(proposal:subviews:cache:)","title":"sizeThatFits(proposal:subviews:cache:)","role":"symbol","required":true,"abstract":[{"type":"text","text":"Returns the size of the composite view, given a proposed size"},{"type":"text","text":" "},{"type":"text","text":"and the view’s subviews."}],"kind":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sizeThatFits","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"proposal"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI16ProposedViewSizeV","kind":"typeIdentifier","text":"ProposedViewSize"},{"kind":"text","text":", "},{"kind":"externalParam","text":"subviews"},{"kind":"text","text":": "},{"text":"Self","kind":"typeIdentifier"},{"kind":"text","text":"."},{"preciseIdentifier