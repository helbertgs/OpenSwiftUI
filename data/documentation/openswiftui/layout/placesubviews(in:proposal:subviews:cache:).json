eIdentifier":"s:11OpenSwiftUI11ViewSpacingV","text":"ViewSpacing"},{"kind":"text","text":", "},{"kind":"externalParam","text":"along"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI4AxisO","text":"Axis"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sf","text":"Float"}],"abstract":[{"type":"text","text":"Gets the preferred spacing distance along the specified axis to the view"},{"type":"text","text":" "},{"type":"text","text":"that returns a specified spacing preference."}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Rect":{"type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Rect"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Rect"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Rect","title":"Rect","abstract":[{"type":"text","text":"A structure that contains the location and dimensions of a rectangle."}],"kind":"symbol","url":"\/documentation\/openswiftui\/rect"}}}