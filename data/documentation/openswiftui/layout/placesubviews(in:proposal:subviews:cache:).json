out":{"abstract":[{"text":"A type that defines the geometry of a collection of views.","type":"text"}],"url":"\/documentation\/openswiftui\/layout","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Layout","kind":"identifier"}],"type":"topic","kind":"symbol","navigatorTitle":[{"text":"Layout","kind":"identifier"}],"title":"Layout","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout","role":"symbol"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/LayoutSubview/spacing":{"kind":"symbol","abstract":[{"text":"The subviews’s preferred spacing values.","type":"text"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutSubview\/spacing","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spacing","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI11ViewSpacingV","text":"ViewSpacing","kind":"typeIdentifier"}],"role":"symbol","url":"\/documentation\/openswiftui\/layoutsubview\/spacing","type":"topic","title":"spacing"}}}