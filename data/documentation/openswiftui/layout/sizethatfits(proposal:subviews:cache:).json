{"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout"]]},"sections":[],"metadata":{"role":"symbol","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sizeThatFits","kind":"identifier"},{"text":"(","kind":"text"},{"text":"proposal","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ProposedViewSize","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI16ProposedViewSizeV"},{"text":", ","kind":"text"},{"text":"subviews","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Subviews","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI6LayoutP8Subviewsa"},{"text":", ","kind":"text"},{"text":"cache","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Cache","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI6LayoutP5CacheQa"},{"text":") -> ","kind":"text"},{"text":"Size","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI4SizeV"}],"title":"sizeThatFits(proposal:subviews:cache:)","roleHeading":"Instance Method","externalID":"s:11OpenSwiftUI6LayoutP12sizeThatFits8proposal8subviews5cacheAA4SizeVAA012ProposedViewK0V_AA0D8SubviewsV5CacheQzztF","required":true,"modules":[{"name":"OpenSwiftUI"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/sizeThatFits(proposal:subviews:cache:)"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sizeThatFits","kind":"identifier"},{"text":"(","kind":"text"},{"text":"proposal","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ProposedViewSize","kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize","preciseIdentifier":"s:11OpenSwiftUI16ProposedViewSizeV"},{"text":", ","kind":"text"},{"text":"subviews","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Subviews","kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/Subviews","preciseIdentifier":"s:11OpenSwiftUI6LayoutP8Subviewsa"},{"text":", ","kind":"text"},{"text":"cache","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Cache","kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/Cache","preciseIdentifier":"s:11OpenSwiftUI6LayoutP5CacheQa"},{"text":") -> ","kind":"text"},{"text":"Size","kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Size","preciseIdentifier":"s:11OpenSwiftUI4SizeV"}]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A size proposal for the container. The container’s parent"},{"type":"text","text":" "},{"type":"text","text":"view that calls this method might call the method more than once"},{"type":"text","text":" "},{"type":"text","text":"with different proposals to learn more about the container’s"},{"type":"text","text":" "},{"type":"text","text":"flexibility before deciding which proposal to use for placement."}]}],"name":"proposal"},{"content":[{"inlineContent":[{"type":"text","text":"A collection of proxies that represent the"},{"type":"text","text":" "},{"type":"text","text":"views that the container arranges. You can use the proxies in the"},{"type":"text","text":" "},{"type":"text","text":"collection to get information about the subviews as you determine"},{"type":"text","text":" "},{"type":"text","text":"how much space the container needs to display them."}],"type":"paragraph"}],"name":"subviews"},{"content":[{"inlineContent":[{"text":"Optional storage for calculated data that you can share among","type":"text"},{"text":" ","type":"text"},{"text":"the methods of your custom layout container. See","type":"text"},{"text":" ","type":"text"},{"code":"makeCache(subviews:)-23agy","type":"codeVoice"},{"text":" for details.","type":"text"}],"type":"paragraph"}],"name":"cache"}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"return-value","text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A size that indicates how much space the container"},{"type":"text","text":" "},{"type":"text","text":"needs to arrange its subviews."}]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Implement this method to tell your custom layout container’s parent"},{"type":"text","text":" "},{"type":"text","text":"view how much space the container needs for a set of subviews, given"},{"type":"text","text":" "},{"type":"text","text":"a size proposal. The parent might call this method more than once"},{"type":"text","text":" "},{"type":"text","text":"during a layout pass with different proposed sizes to test the"},{"type":"text","text":" "},{"type":"text","text":"flexibility of the container, using proposals like:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/zero"},{"text":" proposal; respond with the","type":"text"},{"text":" ","type":"text"},{"text":"layout’s minimum size.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/infinity","isActive":true},{"type":"text","text":" proposal; respond with the"},{"type":"text","text":" "},{"type":"text","text":"layout’s maximum size."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/unspecified","type":"reference","isActive":true},{"text":" proposal; respond with the","type":"text"},{"text":" ","type":"text"},{"text":"layout’s ideal size.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"The parent might also choose to test flexibility in one dimension at a","type":"text"},{"text":" ","type":"text"},{"text":"time. For example, a horizontal stack might propose a fixed height and","type":"text"},{"text":" ","type":"text"},{"text":"an infinite width, and then the same height with a zero width.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example calculates the size for a basic vertical stack"},{"type":"text","text":" "},{"type":"text","text":"that places views in a column, with no spacing between the views:"}],"type":"paragraph"},{"syntax":null,"code":["private struct BasicVStack: Layout {","    func sizeThatFits(","        proposal: ProposedViewSize,","        subviews: Subviews,","        cache: inout ()","    ) -> CGSize {","        subviews.reduce(CGSize.zero) { result, subview in","            let size = subview.sizeThatFits(.unspecified)","            return CGSize(","                width: max(result.width, size.width),","                height: result.height + size.height)","        }","    }","","    \/\/ This layout also needs a placeSubviews() implementation.","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The implementation asks each subview for its ideal size by calling the"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutSubview\/sizeThatFits(_:)"},{"type":"text","text":" method with an"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/unspecified"},{"type":"text","text":" proposed size."},{"type":"text","text":" "},{"type":"text","text":"It then reduces these values into a single size that represents"},{"type":"text","text":" "},{"type":"text","text":"the maximum subview width and the sum of subview heights."},{"type":"text","text":" "},{"type":"text","text":"Because this example isn’t flexible, it ignores its size proposal"},{"type":"text","text":" "},{"type":"text","text":"input and always returns the same value for a given set of subviews."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"SwiftUI views choose their own size, so the layout engine always"},{"type":"text","text":" "},{"type":"text","text":"uses a value that you return from this method as the actual size of the"},{"type":"text","text":" "},{"type":"text","text":"composite view. That size factors into the construction of the "},{"code":"bounds","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"input to the "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/placeSubviews(in:proposal:subviews:cache:)","isActive":true,"type":"reference"},{"type":"text","text":" method."}],"type":"paragraph"}]}],"abstract":[{"text":"Returns the size of the composite view, given a proposed size","type":"text"},{"text":" ","type":"text"},{"text":"and the view’s subviews.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","variants":[{"paths":["\/documentation\/openswiftui\/layout\/sizethatfits(proposal:subviews:cache:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Size":{"role":"symbol","url":"\/documentation\/openswiftui\/size","abstract":[],"type":"topic","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\