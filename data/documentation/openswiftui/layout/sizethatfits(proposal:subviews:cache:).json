rranges. You can use the proxies in the"},{"type":"text","text":" "},{"type":"text","text":"collection to get information about the subviews as you determine"},{"type":"text","text":" "},{"type":"text","text":"how much space the container needs to display them."}],"type":"paragraph"}]},{"name":"cache","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional storage for calculated data that you can share among"},{"type":"text","text":" "},{"type":"text","text":"the methods of your custom layout container. See"},{"type":"text","text":" "},{"type":"codeVoice","code":"makeCache(subviews:)-23agy"},{"type":"text","text":" for details."}]}]}]},{"kind":"content","content":[{"text":"Return Value","type":"heading","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A size that indicates how much space the container"},{"type":"text","text":" "},{"type":"text","text":"needs to arrange its subviews."}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Implement this method to tell your custom layout container’s parent"},{"type":"text","text":" "},{"type":"text","text":"view how much space the container needs for a set of subviews, given"},{"type":"text","text":" "},{"type":"text","text":"a size proposal. The parent might call this method more than once"},{"type":"text","text":" "},{"type":"text","text":"during a layout pass with different proposed sizes to test the"},{"type":"text","text":" "},{"type":"text","text":"flexibility of the container, using proposals like:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/zero","type":"reference","isActive":true},{"type":"text","text":" proposal; respond with the"},{"type":"text","text":" "},{"type":"text","text":"layout’s minimum size."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/infinity","isActive":true},{"text":" proposal; respond with the","type":"text"},{"text":" ","type":"text"},{"text":"layout’s maximum size.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"The ","type":"text"},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/unspecified","isActive":true},{"text":" proposal; respond with the","type":"text"},{"text":" ","type":"text"},{"text":"layout’s ideal size.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The parent might also choose to test flexibility in one dimension at a"},{"type":"text","text":" "},{"type":"text","text":"time. For example, a horizontal stack might propose a fixed height and"},{"type":"text","text":" "},{"type":"text","text":"an infinite width, and then the same height with a zero width."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example calculates the size for a basic vertical stack"},{"type":"text","text":" "},{"type":"text","text":"that places views in a column, with no spacing between the views:"}]},{"syntax":null,"code":["private struct BasicVStack: Layout {","    func sizeThatFits(","        proposal: ProposedViewSize,","        subviews: Subviews,","        cache: inout ()","    ) -> CGSize {","        subviews.reduce(CGSize.zero) { result, subview in","            let size = subview.sizeThatFits(.unspecified)","            return CGSize(","                width: max(result.width, size.width),","                height: result.height + size.height)","        }","    }","","    \/\/ This layout also needs a placeSubviews() implementation.","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The implementation asks each subview for its ideal size by calling the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutSubview\/sizeThatFits(_:)","type":"reference","isActive":true},{"text":" method with an","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/unspecified","type":"reference","isActive":true},{"text":" proposed size.","type":"text"},{"text":" ","type":"text"},{"text":"It then reduces these values into a single size that represents","type":"text"},{"text":" ","type":"text"},{"text":"the maximum subview width and the sum of subview heights.","type":"text"},{"text":" ","type":"text"},{"text":"Because this example isn’t flexible, it ignores its size proposal","type":"text"},{"text":" ","type":"text"},{"text":"input and always returns the same value for a given set of subviews.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"SwiftUI views choose their own size, so the layout engine always","type":"text"},{"text":" ","type":"text"},{"text":"uses a value that you return from this method as the actual size of the","type":"text"},{"text":" ","type":"text"},{"text":"composite view. That size factors into the construction of the ","type":"text"},{"type":"codeVoice","code":"bounds"},{"text":" ","type":"text"},{"text":"input to the ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/placeSubviews(in:proposal:subviews:cache:)","isActive":true,"type":"reference"},{"text":" method.","type":"text"}]}]}],"abstract":[{"text":"Returns the size of the composite view, given a proposed size","type":"text"},{"text":" ","type":"text"},{"text":"and the view’s subviews.","type":"text"}],"kind":"symbol","references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Layout/sizeThatFits(proposal:subviews:cache:)":{"role":"symbol","type":"topic","title":"sizeThatFits(proposal:subviews:cache:)","required":true,"kind":"symbol","abstract":[{