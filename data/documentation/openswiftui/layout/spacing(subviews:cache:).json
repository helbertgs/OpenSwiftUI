{"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout"]]},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/spacing(subviews:cache:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Returns the preferred spacing values of the composite view."}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spacing","kind":"identifier"},{"text":"(","kind":"text"},{"text":"subviews","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Subviews","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/Subviews","preciseIdentifier":"s:11OpenSwiftUI6LayoutP8Subviewsa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"cache","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Cache","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/Cache","preciseIdentifier":"s:11OpenSwiftUI6LayoutP5CacheQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"ViewSpacing","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ViewSpacing","preciseIdentifier":"s:11OpenSwiftUI11ViewSpacingV","kind":"typeIdentifier"}],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"name":"subviews","content":[{"type":"paragraph","inlineContent":[{"text":"A collection of proxy instances that represent the","type":"text"},{"text":" ","type":"text"},{"text":"views that the container arranges. You can use the proxies in the","type":"text"},{"text":" ","type":"text"},{"text":"collection to get information about the subviews as you determine","type":"text"},{"text":" ","type":"text"},{"text":"how much spacing the container prefers around it.","type":"text"}]}]},{"name":"cache","content":[{"type":"paragraph","inlineContent":[{"text":"Optional storage for calculated data that you can share among","type":"text"},{"text":" ","type":"text"},{"text":"the methods of your custom layout container. See","type":"text"},{"text":" ","type":"text"},{"code":"makeCache(subviews:)-23agy","type":"codeVoice"},{"text":" for details.","type":"text"}]}]}]},{"content":[{"type":"heading","anchor":"return-value","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ViewSpacing","isActive":true,"type":"reference"},{"text":" instance that describes the preferred","type":"text"},{"text":" ","type":"text"},{"text":"spacing around the container view.","type":"text"}]}],"kind":"content"},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Implement this method to provide custom spacing preferences"},{"type":"text","text":" "},{"type":"text","text":"for a layout container. The value you return affects"},{"type":"text","text":" "},{"type":"text","text":"the spacing around the container, but it doesn’t affect how the"},{"type":"text","text":" "},{"type":"text","text":"container arranges subviews relative to one another inside the"},{"type":"text","text":" "},{"type":"text","text":"container."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a custom "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ViewSpacing","isActive":true},{"type":"text","text":" instance for your container by"},{"type":"text","text":" "},{"type":"text","text":"initializing one with default values, and then merging that with"},{"type":"text","text":" "},{"type":"text","text":"spacing instances of certain subviews. For example, if you define"},{"type":"text","text":" "},{"type":"text","text":"a basic vertical stack that places subviews in a column, you could"},{"type":"text","text":" "},{"type":"text","text":"use the spacing preferences of the subview edges that make"},{"type":"text","text":" "},{"type":"text","text":"contact with the container’s edges:"}]},{"type":"codeListing","code":["extension BasicVStack {","    func spacing(subviews: Subviews, cache: inout ()) -> ViewSpacing {","        var spacing = ViewSpacing()","","        for index in subviews.indices {","            var edges: Edge.Set = [.leading, .trailing]","            if index == 0 { edges.formUnion(.top) }","            if index == subviews.count - 1 { edges.formUnion(.bottom) }","            spacing.formUnion(subviews[index].spacing, edges: edges)","        }","","        return spacing","    }","}"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"In the above example, the first and last subviews contribute to the"},{"type":"text","text":" "},{"type":"text","text":"spacing above and below the container, respectively, while all subviews"},{"type":"text","text":" "},{"type":"text","text":"affect the spacing on the leading and trailing edges."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you don’t implement this method, the protocol provides a default"},{"type":"text","text":" "},{"type":"text","text":"implementation, namely "},{"code":"Layout\/spacing(subviews:cache:)-1z0gt","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"that merges the spacing preferences across all subviews on all edges."}]}],"kind":"content"}],"metadata":{"externalID":"s:11OpenSwiftUI6LayoutP7spacing8subviews5cacheAA11ViewSpacingVAA0D8SubviewsV_5CacheQzztF","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"spacing"},{"kind":"text","text":"("},{"ki