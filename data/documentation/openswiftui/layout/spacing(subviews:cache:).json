,"text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"spacing"},{"kind":"text","text":"("},{"kind":"externalParam","text":"subviews"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/Subviews","text":"Subviews","preciseIdentifier":"s:11OpenSwiftUI6LayoutP8Subviewsa"},{"kind":"text","text":", "},{"kind":"externalParam","text":"cache"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/Cache","text":"Cache","preciseIdentifier":"s:11OpenSwiftUI6LayoutP5CacheQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ViewSpacing","text":"ViewSpacing","preciseIdentifier":"s:11OpenSwiftUI11ViewSpacingV"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"subviews","content":[{"inlineContent":[{"type":"text","text":"A collection of proxy instances that represent the"},{"type":"text","text":" "},{"type":"text","text":"views that the container arranges. You can use the proxies in the"},{"type":"text","text":" "},{"type":"text","text":"collection to get information about the subviews as you determine"},{"type":"text","text":" "},{"type":"text","text":"how much spacing the container prefers around it."}],"type":"paragraph"}]},{"name":"cache","content":[{"type":"paragraph","inlineContent":[{"text":"Optional storage for calculated data that you can share among","type":"text"},{"text":" ","type":"text"},{"text":"the methods of your custom layout container. See","type":"text"},{"text":" ","type":"text"},{"code":"makeCache(subviews:)-23agy","type":"codeVoice"},{"text":" for details.","type":"text"}]}]}]},{"kind":"content","content":[{"level":2,"text":"Return Value","type":"heading","anchor":"return-value"},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ViewSpacing"},{"text":" instance that describes the preferred","type":"text"},{"text":" ","type":"text"},{"text":"spacing around the container view.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"Implement this method to provide custom spacing preferences","type":"text"},{"text":" ","type":"text"},{"text":"for a layout container. The value you return affects","type":"text"},{"text":" ","type":"text"},{"text":"the spacing around the container, but it doesn’t affect how the","type":"text"},{"text":" ","type":"text"},{"text":"container arranges subviews relative to one another inside the","type":"text"},{"text":" ","type":"text"},{"text":"container.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Create a custom "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ViewSpacing"},{"type":"text","text":" instance for your container by"},{"type":"text","text":" "},{"type":"text","text":"initializing one with default values, and then merging that with"},{"type":"text","text":" "},{"type":"text","text":"spacing instances of certain subviews. For example, if you define"},{"type":"text","text":" "},{"type":"text","text":"a basic vertical stack that places subviews in a column, you could"},{"type":"text","text":" "},{"type":"text","text":"use the spacing preferences of the subview edges that make"},{"type":"text","text":" "},{"type":"text","text":"contact with the container’s edges:"}],"type":"paragraph"},{"type":"codeListing","code":["extension BasicVStack {","    func spacing(subviews: Subviews, cache: inout ()) -> ViewSpacing {","        var spacing = ViewSpacing()","","        for index in subviews.indices {","            var edges: Edge.Set = [.leading, .trailing]","            if index == 0 { edges.formUnion(.top) }","            if index == subviews.count - 1 { edges.formUnion(.bottom) }","            spacing.formUnion(subviews[index].spacing, edges: edges)","        }","","        return spacing","    }","}"],"syntax":null},{"inlineContent":[{"type":"text","text":"In the above example, the first and last subviews contribute to the"},{"type":"text","text":" "},{"type":"text","text":"spacing above and below the container, respectively, while all subviews"},{"type":"text","text":" "},{"type":"text","text":"affect the spacing on the leading and trailing edges."}],"type":"paragraph"},{"inlineContent":[{"text":"If you don’t implement this method, the protocol provides a default","type":"text"},{"text":" ","type":"text"},{"text":"implementation, namely ","type":"text"},{"type":"codeVoice","code":"Layout\/spacing(subviews:cache:)-1z0gt"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"that merges the spacing preferences across all subviews on all edges.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/ViewSpacing":{"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ViewSpacing","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"A collection of the geometric spacing preferences of a view."}],"url":"\/documentation\/openswiftui\/viewspacing","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ViewSpacing","navigatorTitle":[{"text":"ViewSpacing","kind":"identifier"}],"title":"ViewSpacing"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Layout/spacing(subviews:cache:)-8xd0i":{"abstract":[{"type":"text","text":"Returns the union of all subview spacing."}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/spacing(subviews:cache:)-8xd0i","type":"topic","fragments":[{"tex