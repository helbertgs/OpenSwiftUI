{"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"makeCache"},{"kind":"text","text":"("},{"kind":"externalParam","text":"subviews"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI6LayoutP8Subviewsa","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/Subviews","text":"Subviews"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI6LayoutP5CacheQa","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/Cache","text":"Cache"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"A collection of proxy instances that represent the","type":"text"},{"text":" ","type":"text"},{"text":"views that the container arranges. You can use the proxies in the","type":"text"},{"text":" ","type":"text"},{"text":"collection to get information about the subviews as you","type":"text"},{"text":" ","type":"text"},{"text":"calculate values to store in the cache.","type":"text"}]}],"name":"subviews"}]},{"content":[{"anchor":"return-value","type":"heading","level":2,"text":"Return Value"},{"inlineContent":[{"text":"Storage for calculated data that you share among","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the methods of your custom layout container."}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"You can optionally use a cache to preserve calculated values across","type":"text"},{"text":" ","type":"text"},{"text":"calls to a layout container’s methods. Many layout types don’t need","type":"text"},{"text":" ","type":"text"},{"text":"a cache, because SwiftUI automatically reuses both the results of","type":"text"},{"text":" ","type":"text"},{"text":"calls into the layout and the values that the layout reads from its","type":"text"},{"text":" ","type":"text"},{"text":"subviews. Rely on the protocol’s default implementation of this method","type":"text"},{"text":" ","type":"text"},{"text":"if you don’t need a cache.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"However you might find a cache useful when:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The layout container repeats complex, intermediate calculations","type":"text"},{"text":" ","type":"text"},{"text":"across calls like ","type":"text"},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/sizeThatFits(proposal:subviews:cache:)","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/placeSubviews(in:proposal:subviews:cache:)","isActive":true},{"text":", and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"explicitAlignment(of:in:proposal:subviews:cache:)-8ofeu"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"You might be able to improve performance by calculating values","type":"text"},{"text":" ","type":"text"},{"text":"once and storing them in a cache.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The layout container reads many ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutValueKey"},{"text":" values from","type":"text"},{"text":" ","type":"text"},{"text":"subviews. It might be more efficient to do that once and store the","type":"text"},{"text":" ","type":"text"},{"text":"results in the cache, rather than rereading the subviews’ values before","type":"text"},{"text":" ","type":"text"},{"text":"each layout call.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You want to maintain working storage, like temporary Swift arrays,"},{"type":"text","text":" "},{"type":"text","text":"across calls into the layout, to minimize the number of allocation"},{"type":"text","text":" "},{"type":"text","text":"events."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Only implement a cache if profiling shows that it improves performance."}]},{"anchor":"Initialize-a-cache","type":"heading","text":"Initialize a cache","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Implement the "},{"code":"makeCache(subviews:)","type":"codeVoice"},{"type":"text","text":" method to create a cache."},{"type":"text","text":" "},{"type":"text","text":"You can add computed values to the cache right away, using information"},{"type":"text","text":" "},{"type":"text","text":"from the "},{"code":"subviews","type":"codeVoice"},{"type":"text","text":" input parameter, or you can do that later. The"},{"type":"text","text":" "},{"type":"text","text":"methods of the "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout","type":"reference","isActive":true},{"type":"text","text":" protocol that can access the cache"},{"type":"text","text":" "},{"type":"text","text":"take the cache as an in-out parameter, which enables you to modify"},{"type":"text","text":" "},{"type":"text","text":"the cache anywhere that you can read it."}]},{"type":"paragraph","inlineContent":[{"text":"You can use any storage type that makes sense for your layout","type":"text"},{"text":" ","type":"text"},{"text":"algorithm, but be sure that you only store data that you derive","type":"text"},{"text":" ","type":"text"},{"text":"from the layout and its subviews (lazily, if possible). For this to","type":"text"},{"text":" ","type":"text"},{"text":"work correctly, SwiftUI needs to be able to call this method to","type":"text"},{"text":" ","type":"text"},{"text":"recreate the cache without changing the layout result.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you return a cache from this method, you implicitly define a type"},{"type":"text","text":" "},{"type":"text","text":"for your cache. Be sure to either make the type of the "},{"type":"codeVoice","code":"cache"},{"type":"text","text":" "},{"type":"text","text":"parameters on your other "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout","isActive":true},{"type":"text","text":" protocol methods match, or use"},{"type":"text","text":" "},{"type":"text","text":"a type alias to define the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/Cache","isActive":true},{"type":"text","text":" associated type."}]},{"anchor":"Update-the-cache","type":"heading","text":"Update the cache","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the layout container or any of its subviews change, SwiftUI"},{"type":"text","text":" "},{"type":"text","text":"calls the "},{"type":"codeVoice","code":"updateCache(_:subviews:)-9hkj9"},{"type":"text","text":" method so you can"},{"type":"text","text":" "},{"type":"text","text":"modify or invalidate the contents of the"},{"type":"text","text":" "},{"type":"text","text":"cache. The default implementation of that method calls the"},{"type":"text","text":" "},{"type":"codeVoice","code":"makeCache(subviews:)"},{"type":"text","text":" method to recreate the cache, but you can"},{"type":"text","text":" "},{"type":"text","text":"provide your own implementation of the update method to take an"},{"type":"text","text":" "},{"type":"text","text":"incremental approach, if appropriate."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout"