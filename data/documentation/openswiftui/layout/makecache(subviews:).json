{"metadata":{"symbolKind":"method","role":"symbol","title":"makeCache(subviews:)","externalID":"s:11OpenSwiftUI6LayoutP9makeCache8subviews0F0QzAA0D8SubviewsV_tF","roleHeading":"Instance Method","modules":[{"name":"OpenSwiftUI"}],"required":true,"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"makeCache","kind":"identifier"},{"text":"(","kind":"text"},{"text":"subviews","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI6LayoutP8Subviewsa","text":"Subviews","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI6LayoutP5CacheQa","text":"Cache","kind":"typeIdentifier"}]},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"Creates and initializes a cache for a layout instance.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout"]]},"sections":[],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/makeCache(subviews:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/layout\/makecache(subviews:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"makeCache"},{"kind":"text","text":"("},{"kind":"externalParam","text":"subviews"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/Subviews","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI6LayoutP8Subviewsa","text":"Subviews"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/Cache","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI6LayoutP5CacheQa","text":"Cache"}],"platforms":["macOS"],"languages":["swift"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A collection of proxy instances that represent the"},{"type":"text","text":" "},{"type":"text","text":"views that the container arranges. You can use the proxies in the"},{"type":"text","text":" "},{"type":"text","text":"collection to get information about the subviews as you"},{"type":"text","text":" "},{"type":"text","text":"calculate values to store in the cache."}]}],"name":"subviews"}],"kind":"parameters"},{"content":[{"anchor":"return-value","level":2,"text":"Return Value","type":"heading"},{"inlineContent":[{"type":"text","text":"Storage for calculated data that you share among"},{"type":"text","text":" "},{"type":"text","text":"the methods of your custom layout container."}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"You can optionally use a cache to preserve calculated values across"},{"type":"text","text":" "},{"type":"text","text":"calls to a layout container’s methods. Many layout types don’t need"},{"type":"text","text":" "},{"type":"text","text":"a cache, because OpenSwiftUI automatically reuses both the results of"},{"type":"text","text":" "},{"type":"text","text":"calls into the layout and the values that the layout reads from its"},{"type":"text","text":" "},{"type":"text","text":"subviews. Rely on the protocol’s default implementation of this method"},{"type":"text","text":" "},{"type":"text","text":"if you don’t need a cache."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"However you might find a cache useful when:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The layout container repeats complex, intermediate calculations","type":"text"},{"text":" ","type":"text"},{"text":"across calls like ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/sizeThatFits(proposal:subviews:cache:)","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/placeSubviews(in:proposal:subviews:cache:)","isActive":true,"type":"reference"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":"explicitAlignment(of:in:proposal:subviews:cache:)-8ofeu","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"You might be able to improve performance by calculating values","type":"text"},{"text":" ","type":"text"},{"text":"once and storing them in a cache.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The layout container reads many "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutValueKey","isActive":true},{"type":"text","text":" values from"},{"type":"text","text":" "},{"type":"text","text":"subviews. It might be more efficient to do that once and store the"},{"type":"text","text":" "},{"type":"text","text":"results in the cache, rather than rereading the subviews’ values before"},{"type":"text","text":" "},{"type":"text","text":"each layout call."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You want to maintain working storage, like temporary Swift arrays,"},{"type":"text","text":" "},{"type":"text","text":"across calls into the layout, to minimize the number of allocation"},{"type":"text","text":" "},{"type":"text","text":"events."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Only implement a cache if profiling shows that it improves performance."}],"type":"paragraph"},{"anchor":"Initialize-a-cache","level":3,"text":"Initialize a cache","type":"heading"},{"inlineContent":[{"type":"text","text":"Implement the "},{"type":"codeVoice","code":"makeCache(subviews:)"},{"type":"text","text":" method to create a cache."},{"type":"text","text":" "},{"type":"text","text":"You can add computed values to the cache right away, using information"},{"type":"text","text":" "},{"type":"text","text":"from the "},{"type":"codeVoice","code":"subviews"},{"type":"text","text":" input parameter, or you can do that later. The"},{"type":"text","text":" "},{"type":"text","text":"methods of the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout"},{"type":"text","text":" protocol that can access the cache"},{"type":"text","text":" "},{"type":"text","text":"take the cache as an in-out parameter, which enables you to modify"},{"type":"text","text":" "},{"type":"text","text":"the cache anywhere that you can read it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can use any storage type that makes sense for your layout"},{"type":"text","text":" "},{"type":"text","text":"algorithm, but be sure that you only store data that you derive"},{"type":"text","text":" "},{"type":"text","text":"from the layout and its subviews (lazily, if possible). For this to"},{"type":"text","text":" "},{"type":"text","text":"work correctly, OpenSwiftUI needs to be able to call this method to"},{"type":"text","text":" "},{"type":"text","text":"recreate the cache without changing the layout result."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When you return a cache from this method, you implicitly define a type"},{"type":"text","text":" "},{"type":"text","text":"for your cache. Be sure to either make the type of the "},{"type":"codeVoice","code":"cache"},{"type":"text","text":" "},{"type":"text","text":"parameters on your other "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout"},{"type":"text","text":" protocol methods match, or use"},{"type":"text","text":" "},{"type":"text","text":"a type alias to define the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/Cache"},{"type":"text","text":" associated type."}],"type":"paragraph"},{"anchor":"Update-the-cache","level":3,"text":"Update the cache","type":"heading"},{"inlineContent":[{"type":"text","text":"If the layout container or any of its subviews change, OpenSwiftUI"},{"type":"text","text":" "},{"type":"text","text":"calls the "},{"type":"codeVoice","code":"updateCache(_:subviews:)-9hkj9"},{"type":"text","text":" method so you can"},{"type":"text","text":" "},{"type":"text","text":"modify or invalidate the contents of the"},{"type":"text","text":" "},{"type":"text","text":"cache. The default implementation of that method calls the"},{"type":"text","text":" "},{"type":"codeVoice","code":"makeCache(subviews:)"},{"type":"text","text":" method to recreate the cache, but you can"},{"type":"text","text":" "},{"type":"text","text":"provide your own implementation of the update method to take an"},{"type":"text","text":" "},{"type":"text","text":"incremental approach, if appropriate."}],"type":"paragraph"}],"kind":"content"}],"defaultImplementationsSections":[{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/makeCache(subviews:)-2ml4x"],"anchor":"Layout-Implementations","title":"Layout Implementations"}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Layout/sizeThatFits(proposal:subviews:cache:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sizeThatFits","kind":"identifier"},{"text":"(","kind":"text"},{"text":"proposal","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ProposedViewSize","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI16ProposedViewSizeV"},{"text":", ","kind":"text"},{"text":"subviews","kind":"externalParam"},{"text":": ","kind":"text"},{"t