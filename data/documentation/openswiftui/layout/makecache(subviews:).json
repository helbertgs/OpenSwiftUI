{"variants":[{"paths":["\/documentation\/openswiftui\/layout\/makecache(subviews:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Creates and initializes a cache for a layout instance."}],"metadata":{"symbolKind":"method","title":"makeCache(subviews:)","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"makeCache"},{"kind":"text","text":"("},{"kind":"externalParam","text":"subviews"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Subviews","preciseIdentifier":"s:11OpenSwiftUI6LayoutP8Subviewsa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Cache","preciseIdentifier":"s:11OpenSwiftUI6LayoutP5CacheQa"}],"required":true,"externalID":"s:11OpenSwiftUI6LayoutP9makeCache8subviews0F0QzAA0D8SubviewsV_tF","modules":[{"name":"OpenSwiftUI"}],"role":"symbol"},"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"makeCache","kind":"identifier"},{"text":"(","kind":"text"},{"text":"subviews","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI6LayoutP8Subviewsa","text":"Subviews","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/Subviews","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI6LayoutP5CacheQa","text":"Cache","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/Cache","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["macOS"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A collection of proxy instances that represent the"},{"type":"text","text":" "},{"type":"text","text":"views that the container arranges. You can use the proxies in the"},{"type":"text","text":" "},{"type":"text","text":"collection to get information about the subviews as you"},{"type":"text","text":" "},{"type":"text","text":"calculate values to store in the cache."}]}],"name":"subviews"}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"anchor":"return-value","type":"heading","text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Storage for calculated data that you share among"},{"type":"text","text":" "},{"type":"text","text":"the methods of your custom layout container."}]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can optionally use a cache to preserve calculated values across"},{"type":"text","text":" "},{"type":"text","text":"calls to a layout container’s methods. Many layout types don’t need"},{"type":"text","text":" "},{"type":"text","text":"a cache, because OpenSwiftUI automatically reuses both the results of"},{"type":"text","text":" "},{"type":"text","text":"calls into the layout and the values that the layout reads from its"},{"type":"text","text":" "},{"type":"text","text":"subviews. Rely on the protocol’s default implementation of this method"},{"type":"text","text":" "},{"type":"text","text":"if you don’t need a cache."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"However you might find a cache useful when:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The layout container repeats complex, intermediate calculations"},{"type":"text","text":" "},{"type":"text","text":"across calls like "},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/sizeThatFits(proposal:subviews:cache:)","type":"reference"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/placeSubviews(in:proposal:subviews:cache:)","type":"reference"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"explicitAlignment(of:in:proposal:subviews:cache:)-8ofeu"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"You might be able to improve performance by calculating values"},{"type":"text","text":" "},{"type":"text","text":"once and storing them in a cache."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The layout container reads many "},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutValueKey","type":"reference"},{"type":"text","text":" values from"},{"type":"text","text":" "},{"type":"text","text":"subviews. It might be more efficient to do that once and store the"},{"type":"text","text":" "},{"type":"text","text":"results in the cache, rather than rereading the subviews’ values before"},{"type":"text","text":" "},{"type":"text","text":"each layout call."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You want to maintain working storage, like temporary Swift arrays,"},{"type":"text","text":" "},{"type":"text","text":"across calls into the layout, to minimize the number of allocation"},{"type":"text","text":" "},{"type":"text","text":"events."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Only implement a cache if profiling shows that it improves performance."}]},{"level":3,"anchor":"Initialize-a-cache","type":"heading","text":"Initialize a cache"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Implement the "},{"type":"codeVoice","code":"makeCache(subviews:)"},{"type":"text","text":" method to create a cache."},{"type":"text","text":" "},{"type":"text","text":"You can add computed values to the cache right away, using information"},{"type":"text","text":" "},{"type":"text","text":"from the "},{"type":"codeVoice","code":"subviews"},{"type":"text","text":" input parameter, or you can do that later. The"},{"type":"text","text":" "},{"type":"text","text":"methods of the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout"},{"type":"text","text":" protocol that can access the cache"},{"type":"text","text":" "},{"type":"text","text":"take the cache as an in-out parameter, which enables you to modify"},{"type":"text","text":" "},{"type":"text","text":"the cache anywhere that you can read it."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use any storage type that makes sense for your layout"},{"type":"text","text":" "},{"type":"text","text":"algorithm, but be sure that you only store data that you derive"},{"type":"text","text":" "},{"type":"text","text":"from the layout and its subviews (lazily, if possible). For this to"},{"type":"text","text":" "},{"type":"text","text":"work correctly, OpenSwiftUI needs to be able to call this method to"},{"type":"text","text":" "},{"type":"text","text":"recreate the cache without changing the layout result."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you return a cache from this method, you implicitly define a type"},{"type":"text","text":" "},{"type":"text","text":"for your cache. Be sure to either make the type of the "},{"type":"codeVoice","code":"cache"},{"type":"text","text":" "},{"type":"text","text":"parameters on your other "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout"},{"type":"text","text":" protocol methods match, or use"},{"type":"text","text":" "},{"type":"text","text":"a type alias to define the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/Cache"},{"type":"text","text":" associated type."}]},{"level":3,"anchor":"Update-the-cache","type":"heading","text":"Update the cache"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the layout container or any of its subviews change, OpenSwiftUI"},{"type":"text","text":" "},{"type":"text","text":"calls the "},{"type":"codeVoice","code":"updateCache(_:subviews:)-9hkj9"},{"type":"text","text":" method so you can"},{"type":"text","text":" "},{"type":"text","text":"modify or invalidate the contents of the"},{"type":"text","text":" "},{"type":"text","text":"cache. The default implementation of that method calls the"},{"type":"text","text":" "},{"type":"codeVoice","code":"makeCache(subviews:)"},{"type":"text","text":" method to recreate the cache, but you can"},{"type":"text","text":" "},{"type":"text","text":"provide your own implementation of the update method to take an"},{"type":"text","text":" "},{"type":"text","text":"incremental approach, if appropriate."}]}]}],"sections":[],"defaultImplementationsSections":[{"anchor":"Layout-Implementations","title":"Layout Implementations","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/makeCache(subviews:)-2ml4x"]}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout"]]},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/makeCache(subviews:)","interfaceLanguage":"swift"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Layout/Cache":{"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Cache"},{"kind":"text","text":" = "},{"preciseIdentifier":"s:s4Voida","kind":"typeIdentifier","text":"Void"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/Cache","role":"symbol","abstract":[{"text":"Cached values associated with the layout instance.","type":"text"}],"title":"Cache","url":"\/documentation\/openswiftui\/l