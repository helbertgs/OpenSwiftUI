{"abstract":[{"text":"Creates and initializes a cache for a layout instance.","type":"text"}],"defaultImplementationsSections":[{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/makeCache(subviews:)-2ml4x"],"title":"Layout Implementations","anchor":"Layout-Implementations"}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout"]]},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/makeCache(subviews:)","interfaceLanguage":"swift"},"metadata":{"title":"makeCache(subviews:)","externalID":"s:11OpenSwiftUI6LayoutP9makeCache8subviews0F0QzAA0D8SubviewsV_tF","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"makeCache"},{"kind":"text","text":"("},{"kind":"externalParam","text":"subviews"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Subviews","preciseIdentifier":"s:11OpenSwiftUI6LayoutP8Subviewsa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Cache","preciseIdentifier":"s:11OpenSwiftUI6LayoutP5CacheQa"}],"modules":[{"name":"OpenSwiftUI"}],"required":true,"roleHeading":"Instance Method","role":"symbol"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"makeCache"},{"kind":"text","text":"("},{"kind":"externalParam","text":"subviews"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/Subviews","preciseIdentifier":"s:11OpenSwiftUI6LayoutP8Subviewsa","kind":"typeIdentifier","text":"Subviews"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/Cache","preciseIdentifier":"s:11OpenSwiftUI6LayoutP5CacheQa","kind":"typeIdentifier","text":"Cache"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A collection of proxy instances that represent the"},{"type":"text","text":" "},{"type":"text","text":"views that the container arranges. You can use the proxies in the"},{"type":"text","text":" "},{"type":"text","text":"collection to get information about the subviews as you"},{"type":"text","text":" "},{"type":"text","text":"calculate values to store in the cache."}]}],"name":"subviews"}]},{"kind":"content","content":[{"type":"heading","anchor":"return-value","text":"Return Value","level":2},{"type":"paragraph","inlineContent":[{"text":"Storage for calculated data that you share among","type":"text"},{"text":" ","type":"text"},{"text":"the methods of your custom layout container.","type":"text"}]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"You can optionally use a cache to preserve calculated values across"},{"type":"text","text":" "},{"type":"text","text":"calls to a layout container’s methods. Many layout types don’t need"},{"type":"text","text":" "},{"type":"text","text":"a cache, because SwiftUI automatically reuses both the results of"},{"type":"text","text":" "},{"type":"text","text":"calls into the layout and the values that the layout reads from its"},{"type":"text","text":" "},{"type":"text","text":"subviews. Rely on the protocol’s default implementation of this method"},{"type":"text","text":" "},{"type":"text","text":"if you don’t need a cache."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"However you might find a cache useful when:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The layout container repeats complex, intermediate calculations","type":"text"},{"text":" ","type":"text"},{"text":"across calls like ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/sizeThatFits(proposal:subviews:cache:)","type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/placeSubviews(in:proposal:subviews:cache:)","type":"reference"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":"explicitAlignment(of:in:proposal:subviews:cache:)-8ofeu","type":"codeVoice"},{"text":".","type":"text"},{"type":"text","text":" "},{"type":"text","text":"You might be able to improve performance by calculating values"},{"type":"text","text":" "},{"type":"text","text":"once and storing them in a cache."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The layout container reads many "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutValueKey","isActive":true},{"type":"text","text":" values from"},{"type":"text","text":" "},{"type":"text","text":"subviews. It might be more efficient to do that once and store the"},{"type":"text","text":" "},{"type":"text","text":"results in the cache, rather than rereading the subviews’ values before"},{"type":"text","text":" "},{"type":"text","text":"each layout call."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You want to maintain working storage, like temporary Swift arrays,"},{"type":"text","text":" "},{"type":"text","text":"across calls into the layout, to minimize the number of allocation"},{"type":"text","text":" "},{"type":"text","text":"events."}]}]}]},{"inlineContent":[{"type":"text","text":"Only implement a cache if profiling shows that it improves performance."}],"type":"paragraph"},{"level":3,"anchor":"Initialize-a-cache","type":"heading","text":"Initialize a cache"},{"inlineContent":[{"text":"Implement the ","type":"text"},{"code":"makeCache(subviews:)","type":"codeVoice"},{"text":" method to create a cache.","type":"text"},{"text":" ","type":"text"},{"text":"You can add computed values to the cache right away, using information","type":"text"},{"text":" ","type":"text"},{"text":"from the ","type":"text"},{"code":"subviews","type":"codeVoice"},{"text":" input parameter, or you can do that later. The","type":"text"},{"text":" ","type":"text"},{"text":"methods of the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout","type":"reference"},{"text":" protocol that can access the cache","type":"text"},{"text":" ","type":"text"},{"text":"take the cache as an in-out parameter, which enables you to modify","type":"text"},{"text":" ","type":"text"},{"text":"the cache anywhere that you can read it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can use any storage type that makes sense for your layout"},{"type":"text","text":" "},{"type":"text","text":"algorithm, but be sure that you only store data that you derive"},{"type":"text","text":" "},{"type":"text","text":"from the layout and its subviews (lazily, if possible). For this to"},{"type":"text","text":" "},{"type":"text","text":"work correctly, SwiftUI needs to be able to call this method to"},{"type":"text","text":" "},{"type":"text","text":"recreate the cache without changing the layout result."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When you return a cache from this method, you implicitly define a type"},{"type":"text","text":" "},{"type":"text","text":"for your cache. Be sure to either make the type of the "},{"type":"codeVoice","code":"cache"},{"type":"text","text":" "},{"type":"text","text":"parameters on your other "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout"},{"type":"text","text":" protocol methods match, or use"},{"type":"text","text":" "},{"type":"text","text":"a type alias to define the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/Cache"},{"type":"text","text":" associated type."}],"type":"paragraph"},{"level":3,"anchor":"Update-the-cache","type":"heading","text":"Update the cache"},{"inlineContent":[{"type":"text","text":"If the layout container or any of its subviews change, SwiftUI"},{"type":"text","text":" "},{"type":"text","text":"calls the "},{"code":"updateCache(_:subviews:)-9hkj9","type":"codeVoice"},{"type":"text","text":" method so you can"},{"type":"text","text":" "},{"type":"text","text":"modify or invalidate the contents of the"},{"type":"text","text":" "},{"type":"text","text":"cache. The default implementation of that method calls the"},{"type":"text","text":" "},{"code":"makeCache(subviews:)","type":"codeVoice"},{"type":"text","text":" method to recreate the cache, but you can"},{"type":"text","text":" "},{"type":"text","text":"provide your own implementation of the update method to take an"},{"type":"text","text":" "},{"type":"text","text":"incremental approach, if appropriate."}],"type":"paragraph"}]}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/layout\/makecache(subviews:)"]}],"sections":[],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/LayoutValueKey":{"abstract":[{"type":"text","text":"A key for accessing a layout value of a layout container’s subviews."}],"kind":"symbol","navigatorTitle":[{"text":"LayoutValueKey","kind":"identifier"}],"title":"LayoutValueKey","type":"topic","url":"\/documentation\/openswiftui\/layoutvaluekey","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutValueKey","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LayoutV