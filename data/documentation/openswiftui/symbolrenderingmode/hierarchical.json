{"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SymbolRenderingMode"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/openswiftui\/symbolrenderingmode\/hierarchical"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"externalID":"s:11OpenSwiftUI19SymbolRenderingModeV12hierarchicalACvpZ","symbolKind":"property","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hierarchical","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI19SymbolRenderingModeV","text":"SymbolRenderingMode","kind":"typeIdentifier"}],"title":"hierarchical","role":"symbol","modules":[{"name":"OpenSwiftUI"}],"roleHeading":"Type Property"},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SymbolRenderingMode\/hierarchical","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A mode that renders symbols as multiple layers, with different opacities"},{"type":"text","text":" "},{"type":"text","text":"applied to the foreground style."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hierarchical","kind":"identifier"},{"text":": ","kind":"text"},{"text":"SymbolRenderingMode","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SymbolRenderingMode","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI19SymbolRenderingModeV"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"type":"text","text":"OpenSwiftUI fills the first layer with the foreground style, and the others"},{"type":"text","text":" "},{"type":"text","text":"the secondary, and tertiary variants of the foreground style. You can"},{"type":"text","text":" "},{"type":"text","text":"specify these styles explicitly using the "},{"type":"codeVoice","code":"View\/foregroundStyle(_:_:)"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"View\/foregroundStyle(_:_:_:)"},{"type":"text","text":" modifiers. If you only specify"},{"type":"text","text":" "},{"type":"text","text":"a primary foreground style, OpenSwiftUI automatically derives"},{"type":"text","text":" "},{"type":"text","text":"the others from that style. For example, you can render a filled"},{"type":"text","text":" "},{"type":"text","text":"exclamation mark triangle with purple as the tint color for the"},{"type":"text","text":" "},{"type":"text","text":"exclamation mark, and lower opacity purple for the triangle:"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["Image(systemName: \"exclamationmark.triangle.fill\")","    .symbolRenderingMode(.hierarchical)","    .foregroundStyle(Color.purple)"]}]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/SymbolRenderingMode":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SymbolRenderingMode","kind":"identifier"}],"kind":"symbol","title":"SymbolRenderingMode","type":"topic","url":"\/documentation\/openswiftui\/symbolrenderingmode","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SymbolRenderingMode","abstract":[{"type":"text","text":"A symbol rendering mode."}],"role":"symbol","navigatorTitle":[{"text":"SymbolRenderingMode","kind":"identifier"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/SymbolRenderingMode/hierarchical":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SymbolRenderingMode\/hierarchical","role":"symbol","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A mode that renders symbols as multiple layers, with different opacities"},{"type":"text","text":" "},{"type