{"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SymbolRenderingMode"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SymbolRenderingMode\/hierarchical"},"abstract":[{"text":"A mode that renders symbols as multiple layers, with different opacities","type":"text"},{"text":" ","type":"text"},{"text":"applied to the foreground style.","type":"text"}],"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"hierarchical"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"SymbolRenderingMode","preciseIdentifier":"s:11OpenSwiftUI19SymbolRenderingModeV","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SymbolRenderingMode"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"OpenSwiftUI fills the first layer with the foreground style, and the others"},{"type":"text","text":" "},{"type":"text","text":"the secondary, and tertiary variants of the foreground style. You can"},{"type":"text","text":" "},{"type":"text","text":"specify these styles explicitly using the "},{"type":"codeVoice","code":"View\/foregroundStyle(_:_:)"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"View\/foregroundStyle(_:_:_:)"},{"type":"text","text":" modifiers. If you only specify"},{"type":"text","text":" "},{"type":"text","text":"a primary foreground style, OpenSwiftUI automatically derives"},{"type":"text","text":" "},{"type":"text","text":"the others from that style. For example, you can render a filled"},{"type":"text","text":" "},{"type":"text","text":"exclamation mark triangle with purple as the tint color for the"},{"type":"text","text":" "},{"type":"text","text":"exclamation mark, and lower opacity purple for the triangle:"}],"type":"paragraph"},{"syntax":null,"code":["Image(systemName: \"exclamationmark.triangle.fill\")","    .symbolRenderingMode(.hierarchical)","    .foregroundStyle(Color.purple)"],"type":"codeListing"}]}],"metadata":{"externalID":"s:11OpenSwiftUI19SymbolRenderingModeV12hierarchicalACvpZ","roleHeading":"Type Property","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"hierarchical"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"SymbolRenderingMode","preciseIdentifier":"s:11OpenSwiftUI19SymbolRenderingModeV"}],"role":"symbol","title":"hierarchical","symbolKind":"property","modules":[{"name":"OpenSwiftUI"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/symbolrenderingmode\/hierarchical"]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"title":"OpenSwiftUI","url":"\/documentation\/openswiftui","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","kind":"symbol","abstract":[]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/SymbolRenderingMode/hierarchical":{"type":"topic","role":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SymbolRenderingMode\/hierarchical","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"hierarchical"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI19SymbolRenderingModeV","text":"SymbolRenderingMode"}],"abstract":[{"text":"A mode that renders symbols as multiple layers, with different opacities","type":"text"},{"text":" ","type":"text"},{"text":"applied to the foreground style.","type":"text"}],"title":"hierarchical","url":"\/documentation\/openswiftui\/symbolrenderingmode\/hierarchical","kind":"symbol"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/SymbolRenderingMode":{"type":"topic","role":"symbol","navigatorTitle":[{"text":"SymbolRenderingMode","kind":"identifier"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SymbolRenderingMode","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SymbolRenderingMode"}],"abstract":[{"text":"A symbol rendering mode.","type":"text"}],"url":"\/documentation\/openswiftui\/symbolrenderingmode","title":"SymbolRenderingMode","kind":"symbol"}}}