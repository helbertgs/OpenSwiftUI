{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SymbolRenderingMode\/palette"},"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SymbolRenderingMode"]]},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"palette","kind":"identifier"},{"text":": ","kind":"text"},{"text":"SymbolRenderingMode","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI19SymbolRenderingModeV","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SymbolRenderingMode"}]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In this mode OpenSwiftUI maps each successively defined layer in the image"},{"type":"text","text":" "},{"type":"text","text":"to the next of the primary, secondary, and tertiary variants of the"},{"type":"text","text":" "},{"type":"text","text":"foreground style. You can specify these styles explicitly using the"},{"type":"text","text":" "},{"type":"codeVoice","code":"View\/foregroundStyle(_:_:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"View\/foregroundStyle(_:_:_:)"},{"type":"text","text":" "},{"type":"text","text":"modifiers. If you only specify a primary foreground style, OpenSwiftUI"},{"type":"text","text":" "},{"type":"text","text":"automatically derives the others from that style. For example, you can"},{"type":"text","text":" "},{"type":"text","text":"render a filled exclamation mark triangle with yellow as the tint color"},{"type":"text","text":" "},{"type":"text","text":"for the exclamation mark, and fill the triangle with cyan:"}]},{"syntax":null,"type":"codeListing","code":["Image(systemName: \"exclamationmark.triangle.fill\")","    .symbolRenderingMode(.palette)","    .foregroundStyle(Color.yellow, Color.cyan)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can also omit the symbol rendering mode, as specifying multiple"},{"type":"text","text":" "},{"type":"text","text":"foreground styles implies switching to palette rendering mode:"}]},{"syntax":null,"type":"codeListing","code":["Image(systemName: \"exclamationmark.triangle.fill\")","    .foregroundStyle(Color.yellow, Color.cyan)"]}],"kind":"content"}],"sections":[],"abstract":[{"text":"A mode that renders symbols as multiple layers, with different styles","type":"text"},{"text":" ","type":"text"},{"text":"applied to the layers.","type":"text"}],"variants":[{"paths":["\/documentation\/openswiftui\/symbolrenderingmode\/palette"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"symbol","symbolKind":"property","title":"palette","externalID":"s:11OpenSwiftUI19SymbolRenderingModeV7paletteACvpZ","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"palette","kind":"identifier"},{"text":": ","kind":"text"},{"text":"SymbolRenderingMode","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI19SymbolRenderingModeV"}],"modules":[{"name":"OpenSwiftUI"}],"roleHeading":"Type Property"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/SymbolRenderingMode":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SymbolRenderingMode","kind":"identifier"}],"kind":"symbol","title":"SymbolRenderingMode","type":"topic","url":"\/documentation\/openswiftui\/symbolrenderingmode","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SymbolRenderingMode","abstract":[{"type":"text","text":"A symbol rendering mode."}],"role":"symbol","navigatorTitle":[{"text":"SymbolRenderingMode","kind":"identifier"}]},"doc://OpenSwiftUI/do