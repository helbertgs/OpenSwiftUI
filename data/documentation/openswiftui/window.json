{"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"kind":"symbol","sections":[],"variants":[{"paths":["\/documentation\/openswiftui\/window"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"A scene that presents its content in a single, unique window.","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Window","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Content","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI4ViewP","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/View"}]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Use a ","type":"text"},{"code":"Window","type":"codeVoice"},{"text":" scene to augment the main interface of your app","type":"text"},{"type":"text","text":" "},{"type":"text","text":"with a window that gives people access to supplemental functionality."},{"type":"text","text":" "},{"type":"text","text":"For example, you can create a secondary window in a mail reader app that"},{"type":"text","text":" "},{"type":"text","text":"enables people to view the status of their account connections:"}]},{"type":"codeListing","syntax":null,"code":[" @main"," struct Mail: App {","     var body: some Scene {","         WindowGroup {","             MailViewer()","         }","         Window(\"Connection Doctor\", id: \"connection-doctor\") {","             ConnectionDoctor()","         }","     }"," }"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Provide a title as the first argument to the window’s intializer."},{"type":"text","text":" "},{"type":"text","text":"The system uses the title to identify the window to people using your app"},{"type":"text","text":" "},{"type":"text","text":"in the window’s title bar or in the list of available singleton windows"},{"type":"text","text":" "},{"type":"text","text":"that the Windows menu displays automatically."}]},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You can override the title in the window’s title bar by adding"},{"type":"text","text":" "},{"type":"text","text":"one of the "},{"type":"codeVoice","code":"View\/navigationTitle(_:)"},{"type":"text","text":" view modifiers to the"},{"type":"text","text":" "},{"type":"text","text":"window’s content. This enables you to dynamically update the title bar."}]}],"type":"aside","name":"Note"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"In visionOS, Windows that you create using "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window"},{"type":"text","text":" don’t support"},{"type":"text","text":" "},{"type":"text","text":"the volumetric window style."}],"type":"paragraph"}],"type":"aside","name":"Note"},{"level":3,"anchor":"Open-a-window-programmatically","text":"Open a window programmatically","type":"heading"},{"inlineContent":[{"type":"text","text":"People open the window by selecting it in the Windows menu, but you can also"},{"type":"text","text":" "},{"type":"text","text":"open the window programmatically using the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/openWindow","isActive":true},{"type":"text","text":" "},{"type":"text","text":"action that you read from the environment. Use the "},{"type":"codeVoice","code":"id"},{"type":"text","text":" parameter that you"},{"type":"text","text":" "},{"type":"text","text":"initialize the window with to indicate which window to open. For example,"},{"type":"text","text":" "},{"type":"text","text":"you can create a button to open the window from the previous example:"}],"type":"paragraph"},{"code":["struct OpenConnectionDoctorButton: View {","    @Environment(\\.openWindow) private var openWindow","","    var body: some View {","        Button(\"Connection doctor\") {","            openWindow(id: \"connection-doctor\") \/\/ Match the window's identifier.","        }","    }","}"],"type":"codeListing","syntax":null},{"inlineContent":[{"text":"If the window is already open when you call this action, the action brings","type":"text"},{"type":"text","text":" "},{"text":"the open window to the front. Be sure to use unique identifiers across all","type":"text"},{"type":"text","text":" "},{"text":"of the ","type":"text"},{"code":"Window","type":"codeVoice"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup"},{"type":"text","text":" instances that you define."}],"type":"paragraph"},{"anchor":"Dismiss-a-window-programmatically","type":"heading","text":"Dismiss a window programmatically","level":3},{"inlineContent":[{"type":"text","text":"The system provides people with controls to close windows, but you can also"},{"type":"text","text":" "},{"type":"text","text":"close a window programmatically using the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismiss"},{"type":"text","text":" "},{"type":"text","text":"action from within the window’s view hierarchy. For example, you can"},{"type":"text","text":" "},{"type":"text","text":"include a button in the connection doctor view that dismisses the view:"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["struct ConnectionDoctor: View {","    @Environment(\\.dismiss) private var dismiss","","    var body: some View {","        VStack {","            \/\/ ...","","            Button(\"Dismiss\") {","                dismiss()","            }","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"The dismiss action doesn’t close the window if you call it from a"},{"type":"text","text":" "},{"type":"text","text":"modal — like a sheet or a popover — that you present from within"},{"type":"text","text":" "},{"type":"text","text":"the window. In that case, the action dismisses the modal presentation"},{"type":"text","text":" "},{"type":"text","text":"instead."}],"type":"paragraph"},{"anchor":"Use-a-window-as-the-main-scene","type":"heading","text":"Use a window as the main scene","level":3},{"inlineContent":[{"type":"text","text":"You can use a window as the main scene of your app when multi-window"},{"type":"text","text":" "},{"type":"text","text":"functionality isn’t appropriate. For example, it might not make sense to"},{"type":"text","text":" "},{"type":"text","text":"display more than one window for a video call app that relies on a"},{"type":"text","text":" "},{"type":"text","text":"hardware resource, like a camera:"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["@main","struct VideoCall: App {","    var body: some Scene {","        Window(\"VideoCall\", id: \"main\") {","            CameraView()","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"If your app uses a single window as its primary scene, the app quits when"},{"type":"text","text":" "},{"type":"text","text":"the window closes. This behavior differs from an app that uses"},{"type":"text","text":" "},{"type":"text","text":"a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup"},{"type":"text","text":" as its primary scene, where the app continues to run"},{"type":"text","text":" "},{"type":"text","text":"even after closing all of its windows."}],"type":"paragraph"},{"style":"note","type":"aside","content":[{"inlineContent":[{"text":"In most cases it’s best to use a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup"},{"text":" to represent the","type":"text"},{"text":" ","type":"text"},{"text":"main scene of your app. A window group provides multi-window functionality","type":"text"},{"text":" ","type":"text"},{"text":"on platforms that support it, like iPadOS and Windows, and makes it easier","type":"text"},{"text":" ","type":"text"},{"text":"to share code across platforms.","type":"text"}],"type":"paragraph"}],"name":"Note"}],"kind":"content"}],"metadata":{"navigatorTitle":[{"text":"Window","kind":"identifier"}],"title":"Window","role":"symbol","symbolKind":"struct","roleHeading":"Structure","externalID":"s:11OpenSwiftUI6WindowV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Window","kind":"identifier"}],"modules":[{"name":"OpenSwiftUI"}]},"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","doc:\/\/OpenSwiftUI\/s8SendableP","doc:\/\/OpenSwiftUI\/s16SendableMetatypeP"],"type":"conformsTo"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window"},"schemaVersion":{"patch":0,"minor":3,"major":0},"topicSections":[{"title":"Initializers","generated":true,"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window\/init(_:id:content:)-1afpy","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window\/init(_:id:content:)-2q1qb","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window\/init(_:id:content:)-5hadv"],"anchor":"Initializers"},{"title":"Instance Properties","generated":true,"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window\/body","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window\/content","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window\/id","doc:\/\/OpenS