{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window"},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","doc:\/\/OpenSwiftUI\/s8SendableP","doc:\/\/OpenSwiftUI\/s16SendableMetatypeP"],"title":"Conforms To"}],"sections":[],"topicSections":[{"anchor":"Initializers","generated":true,"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window\/init(_:id:content:)-1afpy","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window\/init(_:id:content:)-2q1qb","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window\/init(_:id:content:)-5hadv"],"title":"Initializers"},{"anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window\/body","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window\/content","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window\/id","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window\/title"],"title":"Instance Properties"},{"anchor":"Default-Implementations","generated":true,"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window\/Scene-Implementations"],"title":"Default Implementations"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Window"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Content"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Content"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:11OpenSwiftUI4ViewP","kind":"typeIdentifier","text":"View","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/View"}]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"Use a "},{"type":"codeVoice","code":"Window"},{"type":"text","text":" scene to augment the main interface of your app"},{"type":"text","text":" "},{"type":"text","text":"with a window that gives people access to supplemental functionality."},{"type":"text","text":" "},{"type":"text","text":"For example, you can create a secondary window in a mail reader app that"},{"type":"text","text":" "},{"type":"text","text":"enables people to view the status of their account connections:"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":[" @main"," struct Mail: App {","     var body: some Scene {","         WindowGroup {","             MailViewer()","         }","         Window(\"Connection Doctor\", id: \"connection-doctor\") {","             ConnectionDoctor()","         }","     }"," }"]},{"inlineContent":[{"type":"text","text":"Provide a title as the first argument to the window’s intializer."},{"type":"text","text":" "},{"type":"text","text":"The system uses the title to identify the window to people using your app"},{"type":"text","text":" "},{"type":"text","text":"in the window’s title bar or in the list of available singleton windows"},{"type":"text","text":" "},{"type":"text","text":"that the Windows menu displays automatically."}],"type":"paragraph"},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You can override the title in the window’s title bar by adding"},{"type":"text","text":" "},{"type":"text","text":"one of the "},{"type":"codeVoice","code":"View\/navigationTitle(_:)"},{"type":"text","text":" view modifiers to the"},{"type":"text","text":" "},{"type":"text","text":"window’s content. This enables you to dynamically update the title bar."}]}]},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In visionOS, Windows that you create using "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window"},{"type":"text","text":" don’t support"},{"type":"text","text":" "},{"type":"text","text":"the volumetric window style."}]}]},{"level":3,"type":"heading","anchor":"Open-a-window-programmatically","text":"Open a window programmatically"},{"inlineContent":[{"type":"text","text":"People open the window by selecting it in the Windows menu, but you can also"},{"type":"text","text":" "},{"type":"text","text":"open the window programmatically using the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/openWindow"},{"type":"text","text":" "},{"type":"text","text":"action that you read from the environment. Use the "},{"type":"codeVoice","code":"id"},{"type":"text","text":" parameter that you"},{"type":"text","text":" "},{"type":"text","text":"initialize the window with to indicate which window to open. For example,"},{"type":"text","text":" "},{"type":"text","text":"you can create a button to open the window from the previous example:"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["struct OpenConnectionDoctorButton: View {","    @Environment(\\.openWindow) private var openWindow","","    var body: some View {","        Button(\"Connection doctor\") {","            openWindow(id: \"connection-doctor\") \/\/ Match the window's identifier.","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"If the window is already open when you call this action, the action brings"},{"type":"text","text":" "},{"type":"text","text":"the open window to the front. Be sure to use unique identifiers across all"},{"type":"text","text":" "},{"type":"text","text":"of the "},{"type":"codeVoice","code":"Window"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup"},{"type":"text","text":" instances that you define."}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"Dismiss-a-window-programmatically","text":"Dismiss a window programmatically"},{"inlineContent":[{"type":"text","text":"The system provides people with controls to close windows, but you can also"},{"type":"text","text":" "},{"type":"text","text":"close a window programmatically using the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismiss"},{"type":"text","text":" "},{"type":"text","text":"action from within the window’s view hierarchy. For example, you can"},{"type":"text","text":" "},{"type":"text","text":"include a button in the connection doctor view that dismisses the view:"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["struct ConnectionDoctor: View {","    @Environment(\\.dismiss) private var dismiss","","    var body: some View {","        VStack {","            \/\/ ...","","            Button(\"Dismiss\") {","                dismiss()","            }","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"The dismiss action doesn’t close the window if you call it from a"},{"type":"text","text":" "},{"type":"text","text":"modal — like a sheet or a popover — that you present from within"},{"type":"text","text":" "},{"type":"text","text":"the window. In that case, the action dismisses the modal presentation"},{"type":"text","text":" "},{"type":"text","text":"instead."}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"Use-a-window-as-the-main-scene","text":"Use a window as the main scene"},{"inlineContent":[{"type":"text","text":"You can use a window as the main scene of your app when multi-window"},{"type":"text","text":" "},{"type":"text","text":"functionality isn’t appropriate. For example, it might not make sense to"},{"type":"text","text":" "},{"type":"text","text":"display more than one window for a video call app that relies on a"},{"type":"text","text":" "},{"type":"text","text":"hardware resource, like a camera:"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["@main","struct VideoCall: App {","    var body: some Scene {","        Window(\"VideoCall\", id: \"main\") {","            CameraView()","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"If your app uses a single window as its primary scene, the app quits when"},{"type":"text","text":" "},{"type":"text","text":"the window closes. This behavior differs from an app that uses"},{"type":"text","text":" "},{"type":"text","text":"a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup"},{"type":"text","text":" as its primary scene, where the app continues to run"},{"type":"text","text":" "},{"type":"text","text":"even after closing all of its windows."}],"type":"paragraph"},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"In most cases it’s best to use a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup","type":"reference"},{"text":" to represent the","type":"text"},{"text":" ","type":"text"},{"text":"main scene of your app. A window group provides multi-window functionality","type":"text"},{"text":" ","type":"text"},{"text":"on platforms that support it, like iPadOS and Windows, and makes it easier","type":"text"},{"text":" ","type":"text"},{"text":"to share code across platforms.","type":"text"}]}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/window"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"kind":"symbol","metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Window"}],"modules":[{"name":"OpenSwiftUI"}],"title":