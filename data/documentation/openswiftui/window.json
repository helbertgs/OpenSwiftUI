{"sections":[],"abstract":[{"text":"A scene that presents its content in a single, unique window.","type":"text"}],"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window","interfaceLanguage":"swift"},"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","doc:\/\/OpenSwiftUI\/s8SendableP","doc:\/\/OpenSwiftUI\/s16SendableMetatypeP"],"kind":"relationships"}],"variants":[{"paths":["\/documentation\/openswiftui\/window"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Window"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Content"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Content"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/View","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI4ViewP","text":"View"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a "},{"code":"Window","type":"codeVoice"},{"type":"text","text":" scene to augment the main interface of your app"},{"type":"text","text":" "},{"type":"text","text":"with a window that gives people access to supplemental functionality."},{"type":"text","text":" "},{"type":"text","text":"For example, you can create a secondary window in a mail reader app that"},{"type":"text","text":" "},{"type":"text","text":"enables people to view the status of their account connections:"}]},{"code":[" @main"," struct Mail: App {","     var body: some Scene {","         WindowGroup {","             MailViewer()","         }","         Window(\"Connection Doctor\", id: \"connection-doctor\") {","             ConnectionDoctor()","         }","     }"," }"],"syntax":null,"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Provide a title as the first argument to the window’s intializer."},{"type":"text","text":" "},{"type":"text","text":"The system uses the title to identify the window to people using your app"},{"type":"text","text":" "},{"type":"text","text":"in the window’s title bar or in the list of available singleton windows"},{"type":"text","text":" "},{"type":"text","text":"that the Windows menu displays automatically."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You can override the title in the window’s title bar by adding"},{"type":"text","text":" "},{"type":"text","text":"one of the "},{"type":"codeVoice","code":"View\/navigationTitle(_:)"},{"type":"text","text":" view modifiers to the"},{"type":"text","text":" "},{"type":"text","text":"window’s content. This enables you to dynamically update the title bar."}]}],"type":"aside","style":"note","name":"Note"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In visionOS, Windows that you create using "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window","isActive":true},{"type":"text","text":" don’t support"},{"type":"text","text":" "},{"type":"text","text":"the volumetric window style."}]}],"type":"aside","style":"note","name":"Note"},{"level":3,"text":"Open a window programmatically","anchor":"Open-a-window-programmatically","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"People open the window by selecting it in the Windows menu, but you can also"},{"type":"text","text":" "},{"type":"text","text":"open the window programmatically using the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/openWindow"},{"type":"text","text":" "},{"type":"text","text":"action that you read from the environment. Use the "},{"code":"id","type":"codeVoice"},{"type":"text","text":" parameter that you"},{"type":"text","text":" "},{"type":"text","text":"initialize the window with to indicate which window to open. For example,"},{"type":"text","text":" "},{"type":"text","text":"you can create a button to open the window from the previous example:"}]},{"code":["struct OpenConnectionDoctorButton: View {","    @Environment(\\.openWindow) private var openWindow","","    var body: some View {","        Button(\"Connection doctor\") {","            openWindow(id: \"connection-doctor\") \/\/ Match the window's identifier.","        }","    }","}"],"syntax":null,"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the window is already open when you call this action, the action brings"},{"type":"text","text":" "},{"type":"text","text":"the open window to the front. Be sure to use unique identifiers across all"},{"type":"text","text":" "},{"type":"text","text":"of the "},{"code":"Window","type":"codeVoice"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup"},{"type":"text","text":" instances that you define."}]},{"level":3,"text":"Dismiss a window programmatically","anchor":"Dismiss-a-window-programmatically","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The system provides people with controls to close windows, but you can also"},{"type":"text","text":" "},{"type":"text","text":"close a window programmatically using the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismiss"},{"type":"text","text":" "},{"type":"text","text":"action from within the window’s view hierarchy. For example, you can"},{"type":"text","text":" "},{"type":"text","text":"include a button in the connection doctor view that dismisses the view:"}]},{"code":["struct ConnectionDoctor: View {","    @Environment(\\.dismiss) private var dismiss","","    var body: some View {","        VStack {","            \/\/ ...","","            Button(\"Dismiss\") {","                dismiss()","            }","        }","    }","}"],"syntax":null,"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The dismiss action doesn’t close the window if you call it from a"},{"type":"text","text":" "},{"type":"text","text":"modal — like a sheet or a popover — that you present from within"},{"type":"text","text":" "},{"type":"text","text":"the window. In that case, the action dismisses the modal presentation"},{"type":"text","text":" "},{"type":"text","text":"instead."}]},{"level":3,"text":"Use a window as the main scene","anchor":"Use-a-window-as-the-main-scene","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use a window as the main scene of your app when multi-window"},{"type":"text","text":" "},{"type":"text","text":"functionality isn’t appropriate. For example, it might not make sense to"},{"type":"text","text":" "},{"type":"text","text":"display more than one window for a video call app that relies on a"},{"type":"text","text":" "},{"type":"text","text":"hardware resource, like a camera:"}]},{"code":["@main","struct VideoCall: App {","    var body: some Scene {","        Window(\"VideoCall\", id: \"main\") {","            CameraView()","        }","    }","}"],"syntax":null,"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your app uses a single window as its primary scene, the app quits when"},{"type":"text","text":" "},{"type":"text","text":"the window closes. This behavior differs from an app that uses"},{"type":"text","text":" "},{"type":"text","text":"a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup"},{"type":"text","text":" as its primary scene, where the app continues to run"},{"type":"text","text":" "},{"type":"text","text":"even after closing all of its windows."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In most cases it’s best to use a "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup","isActive":true},{"type":"text","text":" to represent the"},{"type":"text","text":" "},{"type":"text","text":"main scene of your app. A window group provides multi-window functionality"},{"type":"text","text":" "},{"type":"text","text":"on platforms that support it, like iPadOS and Windows, and makes it easier"},{"type":"text","text":" "},{"type":"text","text":"to share code across platforms."}]}],"type":"aside","style":"note","name":"Note"}],"kind":"content"}],"topicSections":[{"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window\/init(_:id:content:)-1afpy","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window\/init(_:id:content:)-2q1qb","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window\/init(_:id:content:)-5hadv"],"generated":true},{"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window\/body"],"generated":true},{"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window\/Scene-Implementations"],"generated":true}],"metadata":{"navigatorTitle":[{"text":"Window","kind":"identifier"}],"externalID":"s:11OpenSwiftUI6WindowV","roleHeading":"Structure","title":"Window","symbolKind":"struct","modules":[{"name":"OpenSwiftUI"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Window"}]},