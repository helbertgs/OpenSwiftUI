{"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Font"]]},"sections":[],"metadata":{"extendedModule":"OpenSwiftUI","externalID":"s:11OpenSwiftUI4FontV15monospacedDigitACyF","symbolKind":"method","role":"symbol","modules":[{"name":"OpenSwiftUI"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"monospacedDigit"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI4FontV","text":"Font"}],"title":"monospacedDigit()","roleHeading":"Instance Method"},"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"monospacedDigit"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:11OpenSwiftUI4FontV","kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Font","text":"Font"}]}]},{"content":[{"level":2,"type":"heading","anchor":"return-value","text":"Return Value"},{"inlineContent":[{"type":"text","text":"A font that uses fixed-width numeric characters."}],"type":"paragraph"}],"kind":"content"},{"content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"inlineContent":[{"type":"text","text":"This modifier only affects numeric characters, and leaves all other"},{"type":"text","text":" "},{"type":"text","text":"characters unchanged. If the base font doesn’t support fixed-width,"},{"type":"text","text":" "},{"type":"text","text":"or "},{"inlineContent":[{"text":"monospace","type":"text"}],"type":"emphasis"},{"type":"text","text":" digits, the font remains unchanged."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example shows two text fields arranged in a "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/VStack","type":"reference","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Both text fields specify the 12-point system font, with the second"},{"type":"text","text":" "},{"type":"text","text":"adding the "},{"code":"monospacedDigit()","type":"codeVoice"},{"type":"text","text":" modifier to the font. Because the text"},{"type":"text","text":" "},{"type":"text","text":"includes the digit 1, normally a narrow character in proportional"},{"type":"text","text":" "},{"type":"text","text":"fonts, the second text field becomes wider than the first."}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["@State private var userText = \"Effect of monospacing digits: 111,111.\"","","var body: some View {","    VStack {","        TextField(\"Proportional\", text: $userText)","            .font(.system(size: 12))","        TextField(\"Monospaced\", text: $userText)","            .font(.system(size: 12).monospacedDigit())","    }","    .padding()","    .navigationTitle(Text(\"Font + monospacedDigit()\"))","}"]},{"inlineContent":[],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/font\/monospaceddigit()"]}],"kind":"symbol","abstract":[{"type":"text","text":"Returns a modified font that uses fixed-width digits, while leaving"},{"type":"text","text":" "},{"type":"text","text":"other characters proportionally spaced."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Font\/monospacedDigit()"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","abstract":[],"title":"OpenSwiftUI","url":"\/documentation\/openswiftui","kind":"symbol","type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Font/monospacedDigit()":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Font\/monospacedDigit()","url":"\/documentation\/openswiftui\/font\/monospaceddigit()","title":"monospacedDigit()","role":"symbol","type":"topic","kind":"symbol","abstract":[{"text":"Returns a modified font that uses fixed-width digits, while leaving","type":"text"},{"text":" ","type":"text"},{"text":"other characters proportionally spaced.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"monospacedDigit","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Font","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI4FontV"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Font":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Font","kind":"identifier"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Font","role":"symbol","abstract":[{"type":"text","text":"An environment-dependent font."}],"title":"Font","url":"\/documentation\/openswiftui\/font","kind":"symbol","navigatorTitle":[{"text":"Font","kind":"identifier"}],"type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/VStack":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/VStack","url":"\/documentation\/openswiftui\/vstack","title":"VStack","role":"symbol","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A view that arranges its subviews in a vertical line."}],"navigatorTitle":[{"text":"VStack","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VStack","kind":"identifier"}]}}}