{"abstract":[{"type":"text","text":"The interactive dismiss behavior."}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/dismissbehavior\/interactive"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissBehavior"]]},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissBehavior\/interactive","interfaceLanguage":"swift"},"metadata":{"symbolKind":"property","roleHeading":"Type Property","externalID":"s:11OpenSwiftUI15DismissBehaviorV11interactiveACvpZ","modules":[{"name":"OpenSwiftUI"}],"role":"symbol","title":"interactive","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"interactive","kind":"identifier"},{"text":": ","kind":"text"},{"text":"DismissBehavior","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI15DismissBehaviorV"}]},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"interactive","kind":"identifier"},{"text":": ","kind":"text"},{"text":"DismissBehavior","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI15DismissBehaviorV","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissBehavior"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this behavior when you want to dismiss a window in a manner that is"},{"type":"text","text":" "},{"type":"text","text":"similar to the standard system affordances for window dismissal - for"},{"type":"text","text":" "},{"type":"text","text":"example, when a user clicks the close button."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is the default behavior on macOS and iOS."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On macOS, dismissing a window using this behavior will not dismiss a"},{"type":"text","text":" "},{"type":"text","text":"window which is currently showing a modal presentation, such as a sheet"},{"type":"text","text":" "},{"type":"text","text":"or alert. Additionally, a document window that is dismissed with this"},{"type":"text","text":" "},{"type":"text","text":"behavior will show the save dialog if there are unsaved changes to the"},{"type":"text","text":" "},{"type":"text","text":"document."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On iOS, dismissing a window using this behavior will dismiss it"},{"type":"text","text":" "},{"type":"text","text":"regardless of any modal presentations being shown."}]}],"kind":"content"}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/DismissBehavior/interactive":{"url":"\/documentation\/openswiftui\/dismissbehavior\/interactive","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"interactive"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSwiftUI15DismissBehaviorV","kind":"typeIdentifier","text":"DismissBehavior"}],"type":"topic","title":"interactive","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissBehavior\/interactive","role":"symbol","kind":"symbol","abstract":[{"text":"The interactive dismiss behavior.","type":"text"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","type":"topic","kind":"symbol","abstract":[],"title":"OpenSwiftUI","url":"\/documentation\/openswiftui"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/DismissBehavior":{"navigatorTitle":[{"kind":"identifier","text":"DismissBehavi