{"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissBehavior"]]},"sections":[],"metadata":{"symbolKind":"property","externalID":"s:11OpenSwiftUI15DismissBehaviorV11interactiveACvpZ","role":"symbol","modules":[{"name":"OpenSwiftUI"}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"interactive","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI15DismissBehaviorV","text":"DismissBehavior","kind":"typeIdentifier"}],"title":"interactive","roleHeading":"Type Property"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"interactive","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI15DismissBehaviorV","text":"DismissBehavior","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissBehavior","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this behavior when you want to dismiss a window in a manner that is"},{"type":"text","text":" "},{"type":"text","text":"similar to the standard system affordances for window dismissal - for"},{"type":"text","text":" "},{"type":"text","text":"example, when a user clicks the close button."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is the default behavior on macOS and iOS."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On macOS, dismissing a window using this behavior will not dismiss a"},{"type":"text","text":" "},{"type":"text","text":"window which is currently showing a modal presentation, such as a sheet"},{"type":"text","text":" "},{"type":"text","text":"or alert. Additionally, a document window that is dismissed with this"},{"type":"text","text":" "},{"type":"text","text":"behavior will show the save dialog if there are unsaved changes to the"},{"type":"text","text":" "},{"type":"text","text":"document."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On iOS, dismissing a window using this behavior will dismiss it"},{"type":"text","text":" "},{"type":"text","text":"regardless of any modal presentations being shown."}]}]}],"variants":[{"paths":["\/documentation\/openswiftui\/dismissbehavior\/interactive"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","abstract":[{"type":"text","text":"The interactive dismiss behavior."}],"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissBehavior\/interactive","interfaceLanguage":"swift"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/DismissBehavior":{"url":"\/documentation\/openswiftui\/dismissbehavior","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DismissBehavior","kind":"identifier"}],"type":"topic","abstract":[{"text":"Programmatic window dismissal behaviors.","type":"text"}],"title":"DismissBehavior","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissBehavior","navigatorTitle":[{"text":"DismissBehavior","kind":"identifier"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/DismissBehavior/interactive":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissBehavior\/interactive","url":"\/documentation\/openswiftui\/dismissbehavior\/interactive","title":"interactive","role":"symbol","kind":"symbol","type":"topic","abstract":[{"text":"The interactive dismiss behavior.","type":"text"}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"interactive","kind":"identifier"},{"text":": ","kind":"text"},{"text":"DismissBehavior","preciseIdentifier":"s:11OpenSwiftUI15DismissBehaviorV","kind":"typeIdentifier"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","abstract":[],"title":"OpenSwiftUI","url":"\/documentation\/openswiftui","kind":"symbol","type":"topic"}}}