{"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissBehavior"]]},"metadata":{"externalID":"s:11OpenSwiftUI15DismissBehaviorV11interactiveACvpZ","title":"interactive","role":"symbol","roleHeading":"Type Property","symbolKind":"property","modules":[{"name":"OpenSwiftUI"}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"interactive","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI15DismissBehaviorV","text":"DismissBehavior","kind":"typeIdentifier"}]},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissBehavior\/interactive"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"interactive"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissBehavior","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI15DismissBehaviorV","text":"DismissBehavior"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Use this behavior when you want to dismiss a window in a manner that is"},{"text":" ","type":"text"},{"type":"text","text":"similar to the standard system affordances for window dismissal - for"},{"text":" ","type":"text"},{"type":"text","text":"example, when a user clicks the close button."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This is the default behavior on macOS and iOS."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"On macOS, dismissing a window using this behavior will not dismiss a","type":"text"},{"text":" ","type":"text"},{"text":"window which is currently showing a modal presentation, such as a sheet","type":"text"},{"text":" ","type":"text"},{"text":"or alert. Additionally, a document window that is dismissed with this","type":"text"},{"text":" ","type":"text"},{"text":"behavior will show the save dialog if there are unsaved changes to the","type":"text"},{"type":"text","text":" "},{"text":"document.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On iOS, dismissing a window using this behavior will dismiss it"},{"type":"text","text":" "},{"type":"text","text":"regardless of any modal presentations being shown."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/dismissbehavior\/interactive"]}],"abstract":[{"type":"text","text":"The interactive dismiss behavior."}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/DismissBehavior/interactive":{"title":"interactive","role":"symbol","type":"topic","url":"\/documentation\/openswiftui\/dismissbehavior\/interactive","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissBehavior\/interactive","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"interactive"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSwiftUI15DismissBehaviorV","kind":"typeIdentifier","text":"DismissBehavior"}],"abstract":[{"type":"text","text":"The interactive dismiss behavior."}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/DismissBehavior":{"type":"topic","role":"symbol","navigatorTitle":[{"text":"DismissBehavior","kind":"identifier"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissBehavior","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DismissBehavior","kind":"identifie