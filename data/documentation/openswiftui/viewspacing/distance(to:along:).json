,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call this method from your implementation of "},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout","type":"reference"},{"type":"text","text":" protocol"},{"type":"text","text":" "},{"type":"text","text":"methods if you need to measure the default spacing between two"},{"type":"text","text":" "},{"type":"text","text":"views in a custom layout. Call the method on the first view’s"},{"type":"text","text":" "},{"type":"text","text":"preferences instance, and provide the second view’s preferences"},{"type":"text","text":" "},{"type":"text","text":"instance as input."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, consider two views that appear in a custom horizontal"},{"type":"text","text":" "},{"type":"text","text":"stack. The following distance call gets the preferred spacing between"},{"type":"text","text":" "},{"type":"text","text":"these views, where "},{"code":"spacing1","type":"codeVoice"},{"type":"text","text":" contains the preferences of a first"},{"type":"text","text":" "},{"type":"text","text":"view, and "},{"code":"spacing2","type":"codeVoice"},{"type":"text","text":" contains the preferences of a second view:"}]},{"type":"codeListing","syntax":null,"code":["let distance = spacing1.distance(to: spacing2, axis: .horizontal)"]},{"type":"paragraph","inlineContent":[{"text":"The method first determines, based on the axis and the ordering, that","type":"text"},{"text":" ","type":"text"},{"text":"the views abut on the trailing edge of the first view and the leading","type":"text"},{"text":" ","type":"text"},{"text":"edge of the second. It then gets the spacing preferences for the","type":"text"},{"text":" ","type":"text"},{"text":"corresponding edges of each view, and returns the greater of the two","type":"text"},{"text":" ","type":"text"},{"text":"values. This results in the smallest value that provides enough space","type":"text"},{"text":" ","type":"text"},{"text":"to satisfy the preferences of both views.","type":"text"}]},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":"This method returns the default spacing between views, but a"},{"type":"text","text":" "},{"type":"text","text":"layout can choose to ignore the value and use custom spacing instead."}],"type":"paragraph"}]}]}],"kind":"symbol","abstract":[{"text":"Gets the preferred spacing distance along the specified axis to the view","type":"text"},{"text":" ","type":"text"},{"text":"that returns a specified spacing preference.","type":"text"}],"metadata":{"title":"distance(to:along:)","role":"symbol","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"distance"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ViewSpacing","preciseIdentifier":"s:11OpenSwiftUI11ViewSpacingV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"along"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Axis","preciseIdentifier":"s:11OpenSwiftUI4AxisO"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Float","preciseIdentifier":"s:Sf"}],"symbolKind":"method","modules":[{"name":"OpenSwiftUI"}],"externalID":"s:11OpenSwiftUI11ViewSpacingV8distance2to5alongSfAC_AA4AxisOtF"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ViewSpacing\/distance(to:along:)"},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ViewSpacing"]]},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/ViewSpacing":{"role":"symbol","abstract":[{"type":"text","text":"A collection of the geometric spacing preferences of a view."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},