{"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ViewSpacing"]]},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ViewSpacing\/distance(to:along:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Gets the preferred spacing distance along the specified axis to the view"},{"type":"text","text":" "},{"type":"text","text":"that returns a specified spacing preference."}],"metadata":{"modules":[{"name":"OpenSwiftUI"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"distance","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ViewSpacing","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI11ViewSpacingV"},{"text":", ","kind":"text"},{"text":"along","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Axis","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI4AxisO"},{"text":") -> ","kind":"text"},{"text":"Float","kind":"typeIdentifier","preciseIdentifier":"s:Sf"}],"role":"symbol","title":"distance(to:along:)","externalID":"s:11OpenSwiftUI11ViewSpacingV8distance2to5alongSfAC_AA4AxisOtF","roleHeading":"Instance Method","symbolKind":"method"},"kind":"symbol","sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"distance","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"next","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"ViewSpacing","kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ViewSpacing","preciseIdentifier":"s:11OpenSwiftUI11ViewSpacingV"},{"text":", ","kind":"text"},{"text":"along","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"axis","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Axis","kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Axis","preciseIdentifier":"s:11OpenSwiftUI4AxisO"},{"text":") -> ","kind":"text"},{"text":"Float","kind":"typeIdentifier","preciseIdentifier":"s:Sf"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The spacing preferences instance of the adjacent view."}]}],"name":"next"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The axis that the two views align on."}]}],"name":"axis"}]},{"kind":"content","content":[{"anchor":"return-value","type":"heading","text":"Return Value","level":2},{"inlineContent":[{"type":"text","text":"A floating point value that represents the smallest distance"},{"type":"text","text":" "},{"type":"text","text":"in points between two views that satisfies the spacing preferences"},{"type":"text","text":" "},{"type":"text","text":"of both this view and the adjacent views on their shared edge."}],"type":"paragraph"}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"type":"text","text":"Call this method from your implementation of "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout","isActive":true},{"type":"text","text":" protocol"},{"type":"text","text":" "},{"type":"text","text":"methods if you need to measure the default spacing between two"},{"type":"text","text":" "},{"type":"text","text":"views in a custom layout. Call the method on the first view’s"},{"type":"text","text":" "},{"type":"text","text":"preferences instance, and provide the second view’s preferences"},{"type":"text","text":" "},{"type":"text","text":"instance as input."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, consider two views that appear in a custom horizontal"},{"type":"text","text":" "},{"type":"text","text":"stack. The following distance call gets the preferred spacing between"},{"type":"text","text":" "},{"type":"text","text":"these views, where "},{"type":"codeVoice","code":"spacing1"},{"type":"text","text":" contains the preferences of a first"},{"type":"text","text":" "},{"type":"text","text":"view, and "},{"type":"codeVoice","code":"spacing2"},{"type":"text","text":" contains the preferences of a second view:"}],"type":"paragraph"},{"code":["let distance = spacing1.distance(to: spacing2, axis: .horizontal)"],"type":"codeListing","syntax":null},{"inlineContent":[{"type":"text","text":"The method first determines, based on the axis and the ordering, that"},{"type":"text","text":" "},{"type":"text","text":"the views abut on the trailing edge of the first view and the leading"},{"type":"text","text":" "},{"type":"text","text":"edge of the second. It then gets the spacing preferences for the"},{"type":"text","text":" "},{"type":"text","text":"corresponding edges of each view, and returns the greater of the two"},{"type":"text","text":" "},{"type":"text","text":"values. This results in the smallest value that provides enough space"},{"type":"text","text":" "},{"type":"text","text":"to satisfy the preferences of both views."}],"type":"paragraph"},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This method returns the default spacing between views, but a"},{"type":"text","text":" "},{"type":"text","text":"layout can choose to ignore the value and use custom spacing instead."}]}],"name":"Note"}]}],"variants":[{"paths":["\/documentation\/openswiftui\/viewspacing\/distance(to:along:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","abstract":[],"title":"OpenSwiftUI","url":"\/documentation\/openswiftui","kind":"symbol","type":"topic"},"do