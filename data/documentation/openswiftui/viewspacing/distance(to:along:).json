{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"distance"},{"kind":"text","text":"("},{"text":"to","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"next","kind":"internalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ViewSpacing","text":"ViewSpacing","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI11ViewSpacingV"},{"text":", ","kind":"text"},{"text":"along","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"axis","kind":"internalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Axis","text":"Axis","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI4AxisO"},{"text":") -> ","kind":"text"},{"text":"Float","kind":"typeIdentifier","preciseIdentifier":"s:Sf"}],"platforms":["macOS"],"languages":["swift"]}]},{"parameters":[{"name":"next","content":[{"inlineContent":[{"type":"text","text":"The spacing preferences instance of the adjacent view."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The axis that the two views align on."}],"type":"paragraph"}],"name":"axis"}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"A floating point value that represents the smallest distance","type":"text"},{"text":" ","type":"text"},{"text":"in points between two views that satisfies the spacing preferences","type":"text"},{"type":"text","text":" "},{"type":"text","text":"of both this view and the adjacent views on their shared edge."}]}]},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Call this method from your implementation of ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout"},{"type":"text","text":" protocol"},{"type":"text","text":" "},{"type":"text","text":"methods if you need to measure the default spacing between two"},{"type":"text","text":" "},{"type":"text","text":"views in a custom layout. Call the method on the first view’s"},{"type":"text","text":" "},{"type":"text","text":"preferences instance, and provide the second view’s preferences"},{"type":"text","text":" "},{"type":"text","text":"instance as input."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, consider two views that appear in a custom horizontal"},{"type":"text","text":" "},{"type":"text","text":"stack. The following distance call gets the preferred spacing between"},{"type":"text","text":" "},{"type":"text","text":"these views, where "},{"type":"codeVoice","code":"spacing1"},{"type":"text","text":" contains the preferences of a first"},{"type":"text","text":" "},{"type":"text","text":"view, and "},{"type":"codeVoice","code":"spacing2"},{"type":"text","text":" contains the preferences of a second view:"}]},{"type":"codeListing","syntax":null,"code":["let distance = spacing1.distance(to: spacing2, axis: .horizontal)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The method first determines, based on the axis and the ordering, that"},{"type":"text","text":" "},{"type":"text","text":"the views abut on the trailing edge of the first view and the leading"},{"text":" ","type":"text"},{"text":"edge of the second. It then gets the spacing preferences for the","type":"text"},{"text":" ","type":"text"},{"text":"corresponding edges of each view, and returns the greater of the two","type":"text"},{"text":" ","type":"text"},{"text":"values. This results in the smallest value that provides enough space","type":"text"},{"text":" ","type":"text"},{"text":"to satisfy the preferences of both views.","type":"text"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"This method returns the default spacing between views, but a","type":"text"},{"text":" ","type":"text"},{"text":"layout can choose to ignore the value and use custom spacing instead.","type":"text"}]}],"name":"Note","style":"note","type":"aside"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ViewSpacing"]]},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ViewSpacing\/distance(to:along:)","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"Gets the preferred spacing distance along the specified axis to the view"},{"type":"text","text":" "},{"type":"text","text":"that returns a specified spacing preference."}],"variants":[{"paths":["\/documentation\/openswiftui\/viewspacing\/distance(to:along:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"symbolKind":"method","role":"symbol","title":"distance(to:along:)","externalID":"s:11OpenSwiftUI11ViewSpacingV8distance2to5alongSfAC_AA4AxisOtF","roleHeading":"Instance Method","modules":[{"name":"OpenSwiftUI"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"distance","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ViewSpacing","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI11ViewSpacingV"},{"text":", ","kind":"text"},{"text":"along","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Axis","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI4AxisO"},{"text":") -> ","kind":"text"},{"text":"Float","kind":"typeIdentifier","preciseIdentifier":"s:Sf"}]},"kind":"symbol","references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/ViewSpacing":{"navigatorTitle":[{"kind":"identifier","text":"ViewSpacing"}],"title":"ViewSpacing","role":"symbol","type":"topic","url":"\/documentation\/openswiftui\/viewspacing","kind":"symbol