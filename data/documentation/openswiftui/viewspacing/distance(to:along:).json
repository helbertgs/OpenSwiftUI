{"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ViewSpacing\/distance(to:along:)","interfaceLanguage":"swift"},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"distance"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":" "},{"kind":"internalParam","text":"next"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSwiftUI11ViewSpacingV","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ViewSpacing","kind":"typeIdentifier","text":"ViewSpacing"},{"kind":"text","text":", "},{"kind":"externalParam","text":"along"},{"kind":"text","text":" "},{"kind":"internalParam","text":"axis"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Axis","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Axis","preciseIdentifier":"s:11OpenSwiftUI4AxisO"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Float","preciseIdentifier":"s:Sf"}]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The spacing preferences instance of the adjacent view."}],"type":"paragraph"}],"name":"next"},{"content":[{"inlineContent":[{"type":"text","text":"The axis that the two views align on."}],"type":"paragraph"}],"name":"axis"}],"kind":"parameters"},{"content":[{"level":2,"type":"heading","text":"Return Value","anchor":"return-value"},{"inlineContent":[{"text":"A floating point value that represents the smallest distance","type":"text"},{"text":" ","type":"text"},{"text":"in points between two views that satisfies the spacing preferences","type":"text"},{"text":" ","type":"text"},{"text":"of both this view and the adjacent views on their shared edge.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"text":"Call this method from your implementation of ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout"},{"text":" protocol","type":"text"},{"text":" ","type":"text"},{"text":"methods if you need to measure the default spacing between two","type":"text"},{"text":" ","type":"text"},{"text":"views in a custom layout. Call the method on the first view’s","type":"text"},{"text":" ","type":"text"},{"text":"preferences instance, and provide the second view’s preferences","type":"text"},{"text":" ","type":"text"},{"text":"instance as input.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For example, consider two views that appear in a custom horizontal","type":"text"},{"text":" ","type":"text"},{"text":"stack. The following distance call gets the preferred spacing between","type":"text"},{"text":" ","type":"text"},{"text":"these views, where ","type":"text"},{"type":"codeVoice","code":"spacing1"},{"text":" contains the preferences of a first","type":"text"},{"text":" ","type":"text"},{"text":"view, and ","type":"text"},{"type":"codeVoice","code":"spacing2"},{"text":" contains the preferences of a second view:","type":"text"}],"type":"paragraph"},{"code":["let distance = spacing1.distance(to: spacing2, axis: .horizontal)"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The method first determines, based on the axis and the ordering, that"},{"type":"text","text":" "},{"type":"text","text":"the views abut on the trailing edge of the first view and the leading"},{"type":"text","text":" "},{"type":"text","text":"edge of the second. It then gets the spacing preferences for the"},{"type":"text","text":" "},{"type":"text","text":"corresponding edges of each view, and returns the greater of the two"},{"type":"text","text":" "},{"type":"text","text":"values. This results in the smallest value that provides enough space"},{"type":"text","text":" "},{"type":"text","text":"to satisfy the preferences of both views."}],"type":"paragraph"},{"style":"note","name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"This method returns the default spacing between views, but a","type":"text"},{"text":" ","type":"text"},{"text":"layout can choose to ignore the value and use custom spacing instead.","type":"text"}]}]}],"kind":"content"}],"abstract":[{"text":"Gets the preferred spacing distance along the specified axis to the view","type":"text"},{"text":" ","type":"text"},{"text":"that returns a specified spacing preference.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ViewSpacing"]]},"metadata":{"title":"distance(to:along:)","roleHeading":"Instance Method","modules":[{"name":"OpenSwiftUI"}],"symbolKind":"method","role":"symbol","externalID":"s:11OpenSwiftUI11ViewSpacingV8distance2to5alongSfAC_AA4AxisOtF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"distance"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI11ViewSpacingV","text":"ViewSpacing"},{"kind":"text","text":", "},{"kind":"externalParam","text":"along"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI4AxisO","text":"Axis"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sf","text":"Float"}]},"variants":[{"paths":["\/documentation\/openswiftui\/viewspacing\/distance(to:along:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"kind":"symbol","role":"collection","title":"OpenSwiftUI","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","abstract":[],"type":"topic","url":"\/documentation\/openswiftui"},"do