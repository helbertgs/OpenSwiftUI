{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/vstacklayout\/sizethatfits(proposal:subviews:cache:)"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sizeThatFits","kind":"identifier"},{"text":"(","kind":"text"},{"text":"proposal","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ProposedViewSize","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI16ProposedViewSizeV","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize"},{"text":", ","kind":"text"},{"text":"subviews","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"VStackLayout","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI12VStackLayoutV","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/VStackLayout"},{"text":".","kind":"text"},{"text":"Subviews","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI6LayoutP8Subviewsa","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/Subviews"},{"text":", ","kind":"text"},{"text":"cache","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ()) -> ","kind":"text"},{"text":"Size3D","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial6Size3DV"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"proposal","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A size proposal for the container. The container’s parent"},{"type":"text","text":" "},{"type":"text","text":"view that calls this method might call the method more than once"},{"type":"text","text":" "},{"type":"text","text":"with different proposals to learn more about the container’s"},{"type":"text","text":" "},{"type":"text","text":"flexibility before deciding which proposal to use for placement."}]}]},{"name":"subviews","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A collection of proxies that represent the"},{"type":"text","text":" "},{"type":"text","text":"views that the container arranges. You can use the proxies in the"},{"type":"text","text":" "},{"type":"text","text":"collection to get information about the subviews as you determine"},{"type":"text","text":" "},{"type":"text","text":"how much space the container needs to display them."}]}]},{"name":"cache","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional storage for calculated data that you can share among"},{"type":"text","text":" "},{"type":"text","text":"the methods of your custom layout container. See"},{"type":"text","text":" "},{"type":"codeVoice","code":"makeCache(subviews:)-23agy"},{"type":"text","text":" for details."}]}]}]},{"content":[{"text":"Return Value","level":2,"anchor":"return-value","type":"heading"},{"inlineContent":[{"type":"text","text":"A size that indicates how much space the container"},{"type":"text","text":" "},{"type":"text","text":"needs to arrange its subviews."}],"type":"paragraph"}],"kind":"content"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Implement this method to tell your custom layout container’s parent"},{"type":"text","text":" "},{"type":"text","text":"view how much space the container needs for a set of subviews, given"},{"type":"text","text":" "},{"type":"text","text":"a size proposal. The parent might call this method more than once"},{"type":"text","text":" "},{"type":"text","text":"during a layout pass with different proposed sizes to test the"},{"type":"text","text":" "},{"type":"text","text":"flexibility of the container, using proposals like:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/zero"},{"text":" proposal; respond with the","type":"text"},{"text":" ","type":"text"},{"text":"layout’s minimum size.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/infinity"},{"text":" proposal; respond with the","type":"text"},{"text":" ","type":"text"},{"text":"layout’s maximum size.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/unspecified"},{"text":" proposal; respond with the","type":"text"},{"text":" ","type":"text"},{"text":"layout’s ideal size.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The parent might also choose to test flexibility in one dimension at a"},{"type":"text","text":" "},{"type":"text","text":"time. For example, a horizontal stack might propose a fixed height and"},{"type":"text","text":" "},{"type":"text","text":"an infinite width, and then the same height with a zero width."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example calculates the size for a basic vertical stack"},{"type":"text","text":" "},{"type":"text","text":"that places views in a column, with no spacing between the views:"}]},{"syntax":null,"type":"codeListing","code":["private struct BasicVStack: Layout {","    func sizeThatFits(","        proposal: ProposedViewSize,","        subviews: Subviews,","        cache: inout ()","    ) -> CGSize {","        subviews.reduce(CGSize.zero) { result, subview in","            let size = subview.sizeThatFits(.unspecified)","            return CGSize(","                width: max(result.width, size.width),","                height: result.height + size.height)","        }","    }","","    \/\/ This layout also needs a placeSubviews() implementation.","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The implementation asks each subview for its ideal size by calling the"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutSubview\/sizeThatFits(_:)","isActive":true},{"type":"text","text":" method with an"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/unspecified","isActive":true},{"type":"text","text":" proposed size."},{"type":"text","text":" "},{"type":"text","text":"It then reduces these values into a single size that represents"},{"type":"text","text":" "},{"type":"text","text":"the maximum subview width and the sum of subview heights."},{"type":"text","text":" "},{"type":"text","text":"Because this example isn’t flexible, it ignores its size proposal"},{"type":"text","text":" "},{"type":"text","text":"input and always returns the same value for a given set of subviews."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"OpenSwiftUI views choose their own size, so the layout engine always"},{"type":"text","text":" "},{"type":"text","text":"uses a value that you return from this method as the actual size of the"},{"type":"text","text":" "},{"type":"text","text":"composite view. That size factors into the construction of the "},{"type":"codeVoice","code":"bounds"},{"type":"text","text":" "},{"type":"text","text":"input to the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/VStackLayout\/placeSubviews(in:proposal:subviews:cache:)","isActive":true},{"type":"text","text":" method."}]}],"kind":"content"}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"title":"sizeThatFits(proposal:subviews:cache:)","extendedModule":"OpenSwiftUI","role":"symbol","roleHeading":"Instance Method","externalID":"s:11OpenSwiftUI12VStackLayoutV12sizeThatFits8proposal8subviews5cac