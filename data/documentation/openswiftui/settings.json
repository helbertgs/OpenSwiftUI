text":"selects the Settings item from the application menu or the equivalent"},{"type":"text","text":" "},{"type":"text","text":"keyboard shortcut:"}]},{"type":"paragraph","inlineContent":[]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The contents of your settings view are controls that modify bindings"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":" values that OpenSwiftUI manages using the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/AppStorage","isActive":true},{"type":"text","text":" property wrapper:"}]},{"syntax":null,"type":"codeListing","code":["struct GeneralSettingsView: View {","    @AppStorage(\"showPreview\") private var showPreview = true","    @AppStorage(\"fontSize\") private var fontSize = 12.0","","    var body: some View {","        Form {","            Toggle(\"Show Previews\", isOn: $showPreview)","            Slider(value: $fontSize, in: 9...96) {","                Text(\"Font Size (\\(fontSize, specifier: \"%.0f\") pts)\")","            }","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can define your settings in a single view, or you can use a "},{"type":"codeVoice","code":"TabView"},{"type":"text","text":" "},{"type":"text","text":"to group settings into different collections:"}]},{"syntax":null,"type":"codeListing","code":["struct SettingsView: View {","    var body: some View {","        TabView {","            Tab(\"General\", systemImage: \"gear\") {","                GeneralSettingsView()","            }","            Tab(\"Advanced\", systemImage: \"star\") {","                AdvancedSettingsView()","            }","        }","        .scenePadding()","        .frame(maxWidth: 350, minHeight: 100)","    }","}"]},{"type":"paragraph","inlineContent":[]}],"kind":"content"}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Settings/Scene-Implementations"