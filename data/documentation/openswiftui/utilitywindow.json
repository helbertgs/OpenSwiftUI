{"topicSections":[{"title":"Initializers","generated":true,"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UtilityWindow\/init(_:id:content:)-137y9","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UtilityWindow\/init(_:id:content:)-98n29","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UtilityWindow\/init(_:id:content:)-wws"],"anchor":"Initializers"},{"title":"Instance Properties","generated":true,"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UtilityWindow\/body","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UtilityWindow\/content","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UtilityWindow\/id","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UtilityWindow\/title"],"anchor":"Instance-Properties"},{"title":"Default Implementations","generated":true,"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UtilityWindow\/Scene-Implementations"],"anchor":"Default-Implementations"}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","doc:\/\/OpenSwiftUI\/s8SendableP","doc:\/\/OpenSwiftUI\/s16SendableMetatypeP"],"type":"conformsTo"}],"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UtilityWindow","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Content","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI4ViewP","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/View"}]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Utility windows are typically used to display controls, settings, or"},{"type":"text","text":" "},{"type":"text","text":"information associated the main content of an application, sometimes"},{"type":"text","text":" "},{"type":"text","text":"referred to as tool palettes or inspector windows. Because of this"},{"type":"text","text":" "},{"type":"text","text":"role, they have specialized behavior compared to all other windows:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"They receive ","type":"text"},{"code":"FocusedValues","type":"codeVoice"},{"text":" from the focused main scene in an application,","type":"text"},{"text":" ","type":"text"},{"text":"similar to commands in the main menu, which can be used to display","type":"text"},{"text":" ","type":"text"},{"text":"information on the active content as the user focuses on different scenes.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"They have a default window level of ","type":"text"},{"code":".floating","type":"codeVoice"},{"text":" so they remain visible","type":"text"},{"text":" ","type":"text"},{"text":"when moving focus between the main scenes.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"They hide when the window is no longer active.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"They only become focused when explicitly needed, such as clicking","type":"text"},{"text":" ","type":"text"},{"text":"in the titlebar or on a focusable view.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"When focused, they can be dismissed with the Escape key.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"They are not minimizable by default.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"@main","type":"text"},{"text":" ","type":"text"},{"text":"struct PhotoBrowser: App {","type":"text"},{"text":" ","type":"text"},{"text":"var body: some Scene {","type":"text"},{"text":" ","type":"text"},{"text":"WindowGroup {","type":"text"},{"text":" ","type":"text"},{"text":"PhotoGallery()","type":"text"},{"text":" ","type":"text"},{"text":"}","type":"text"}]},{"type":"codeListing","syntax":null,"code":["      UtilityWindow(\"Photo Info\", id: \"photo-info\") {","          PhotoInfoViewer()","      }","  }"]},{"type":"paragraph","inlineContent":[{"text":"}","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"struct PhotoInfoViewer: View {","type":"text"},{"text":" ","type":"text"},{"text":"\/\/ Automatically updates to the photo selection from whichever","type":"text"},{"text":" ","type":"text"},{"text":"\/\/ photo gallery window is focused.","type":"text"},{"text":" ","type":"text"},{"text":"@FocusedValue(PhotoSelection.self) private var selectedPhotos","type":"text"}]},{"type":"codeListing","syntax":null,"code":["  var body: some View {","      Text(\"\\(selectedPhotos.count) photos selected\")","  }"]},{"type":"paragraph","inlineContent":[{"text":"}","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UtilityWindow"},{"type":"text","text":" will automatically add a menu item to show\/hide itself in"},{"type":"text","text":" "},{"type":"text","text":"the “View” menu. This can be removed by applying "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/commandsRemoved()","isActive":true},{"type":"text","text":" "},{"type":"text","text":"to the utility window, and manually placing a "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowVisibilityToggle","isActive":true},{"type":"text","text":" "},{"type":"text","text":"elsewhere in an app’s commands. Utility windows can also be programmatically"},{"text":" ","type":"text"},{"type":"text","text":"presented with "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/openWindow","isActive":true},{"type":"text","text":" and dismissed using"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismiss","isActive":true},{"type":"text","text":"."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/utilitywindow"]}],"metadata":{"symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UtilityWindow","kind":"identifier"}],"modules":[{"name":"OpenSwiftUI"}],"externalID":"s:11OpenSwiftUI13UtilityWindowV","navigatorTitle":[{"text":"UtilityWindow","kind":"identifier"}],"roleHeading":"Structure","title":"UtilityWindow","role":"symbol"},"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"abstract":[{"text":"A specialized window scene that provides secondary utility to the content","type":"text"},{"text":" ","type":"text"},{"text":"of the main scenes of an application.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UtilityWindow"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/UtilityWindow/init(_:id:content:)-137y9":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"S"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"S"},{"kind":"text","text":", "},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"content"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","text":"Content"},{"kind":"text","text":")"}],"url":"\/documentation\/openswiftui\/utilitywindow\/init(_:id:content:)-137y9",