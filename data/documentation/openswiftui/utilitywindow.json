{"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"symbolKind":"struct","role":"symbol","title":"UtilityWindow","roleHeading":"Structure","externalID":"s:11OpenSwiftUI13UtilityWindowV","modules":[{"name":"OpenSwiftUI"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UtilityWindow"}],"navigatorTitle":[{"kind":"identifier","text":"UtilityWindow"}]},"abstract":[{"type":"text","text":"A specialized window scene that provides secondary utility to the content"},{"type":"text","text":" "},{"type":"text","text":"of the main scenes of an application."}],"sections":[],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"kind":"symbol","relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","doc:\/\/OpenSwiftUI\/s8SendableP","doc:\/\/OpenSwiftUI\/s16SendableMetatypeP"]}],"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UtilityWindow","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/utilitywindow"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"preciseIdentifier":"s:ScM","kind":"attribute","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UtilityWindow"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Content"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Content"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:11OpenSwiftUI4ViewP","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/View","kind":"typeIdentifier","text":"View"}],"platforms":["macOS"]}]},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Utility windows are typically used to display controls, settings, or"},{"type":"text","text":" "},{"type":"text","text":"information associated the main content of an application, sometimes"},{"type":"text","text":" "},{"type":"text","text":"referred to as tool palettes or inspector windows. Because of this"},{"type":"text","text":" "},{"type":"text","text":"role, they have specialized behavior compared to all other windows:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"They receive ","type":"text"},{"code":"FocusedValues","type":"codeVoice"},{"text":" from the focused main scene in an application,","type":"text"},{"text":" ","type":"text"},{"text":"similar to commands in the main menu, which can be used to display","type":"text"},{"text":" ","type":"text"},{"text":"information on the active content as the user focuses on different scenes.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"They have a default window level of "},{"code":".floating","type":"codeVoice"},{"type":"text","text":" so they remain visible"},{"type":"text","text":" "},{"type":"text","text":"when moving focus between the main scenes."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"They hide when the window is no longer active.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"They only become focused when explicitly needed, such as clicking"},{"type":"text","text":" "},{"type":"text","text":"in the titlebar or on a focusable view."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"When focused, they can be dismissed with the Escape key.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"They are not minimizable by default."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"@main"},{"type":"text","text":" "},{"type":"text","text":"struct PhotoBrowser: App {"},{"type":"text","text":" "},{"type":"text","text":"var body: some Scene {"},{"type":"text","text":" "},{"type":"text","text":"WindowGroup {"},{"type":"text","text":" "},{"type":"text","text":"PhotoGallery()"},{"type":"text","text":" "},{"type":"text","text":"}"}]},{"type":"codeListing","code":["      UtilityWindow(\"Photo Info\", id: \"photo-info\") {","          PhotoInfoViewer()","      }","  }"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"}"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"struct PhotoInfoViewer: View {"},{"type":"text","text":" "},{"type":"text","text":"\/\/ Automatically updates to the photo selection from whichever"},{"type":"text","text":" "},{"type":"text","text":"\/\/ photo gallery window is focused."},{"type":"text","text":" "},{"type":"text","text":"@FocusedValue(PhotoSelection.self) private var selectedPhotos"}]},{"type":"codeListing","code":["  var body: some View {","      Text(\"\\(selectedPhotos.count) photos selected\")","  }"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"}"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UtilityWindow"},{"type":"text","text":" will automatically add a menu item to show\/hide itself in"},{"type":"text","text":" "},{"type":"text","text":"the “View” menu. This can be removed by applying "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/commandsRemoved()","isActive":true},{"type":"text","text":" "},{"type":"text","text":"to the utility window, and manually placing a "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowVisibilityToggle","isActive":true},{"type":"text","text":" "},{"type":"text","text":"elsewhere in an app’s commands. Utility windows can also be programmatically"},{"type":"text","text":" "},{"type":"text","text":"presented with "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/openWindow","isActive":true},{"type":"text","text":" and dismissed using"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismiss","isActive":true},{"type":"text","text":"."}]}],"kind":"content"}],"topicSections":[{"generated":true,"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UtilityWindow\/init(_:id:content:)-137y9","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UtilityWindow\/init(_:id:content:)-98n29","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UtilityWindow\/init(_:id:content:)-wws"]},{"generated":true,"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UtilityWindow\/body"]},{"generated":true,"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UtilityWindow\/Scene-Implementations"]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues/dismiss":{"title":"dismiss","role":"symbol","type":"topic","url":"\/documentation\/openswiftui\/environmentvalues\/dismiss","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismiss","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dismiss","kind":"identifier"},{"text":": ","kind":"text"},{"text":"DismissAction","preciseIdentifier":"s:11OpenSwiftUI13DismissActionV","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"An action that dismisses the current presentation."}]},"doc://OpenSwiftUI/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/OpenSwiftUI\/s16SendableMetatypeP"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/UtilityWindow":{"type":"topic","role":"symbol","navigatorTitle":[{"text