{"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"symbolKind":"method","role":"symbol","extendedModule":"OpenSwiftUI","title":"defaultWindowPlacement(_:)","roleHeading":"Instance Method","externalID":"s:11OpenSwiftUI5ScenePAAE22defaultWindowPlacementyQrAA0fG0VAA0F10LayoutRootV_AA0fG7ContextVtcF::SYNTHESIZED::s:11OpenSwiftUI15ModifiedContentV","modules":[{"name":"OpenSwiftUI"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultWindowPlacement"},{"kind":"text","text":"(("},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI16WindowLayoutRootV","text":"WindowLayoutRoot"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI22WindowPlacementContextV","text":"WindowPlacementContext"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI15WindowPlacementV","text":"WindowPlacement"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5SceneP","text":"Scene"}]},"abstract":[{"type":"text","text":"Defines a function used for determining the default placement"},{"type":"text","text":" "},{"type":"text","text":"of windows."}],"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ModifiedContent"]]},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ModifiedContent\/defaultWindowPlacement(_:)","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/modifiedcontent\/defaultwindowplacement(_:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"preciseIdentifier":"s:ScM","kind":"attribute","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultWindowPlacement"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"makePlacement"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"text","text":"("},{"preciseIdentifier":"s:11OpenSwiftUI16WindowLayoutRootV","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowLayoutRoot","kind":"typeIdentifier","text":"WindowLayoutRoot"},{"kind":"text","text":", "},{"preciseIdentifier":"s:11OpenSwiftUI22WindowPlacementContextV","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowPlacementContext","kind":"typeIdentifier","text":"WindowPlacementContext"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:11OpenSwiftUI15WindowPlacementV","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowPlacement","kind":"typeIdentifier","text":"WindowPlacement"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","kind":"typeIdentifier","text":"Scene"},{"kind":"text","text":"\n"}],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"name":"makePlacement","content":[{"type":"paragraph","inlineContent":[{"text":"A closure to generate the default window placement.","type":"text"}]}]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Use this scene modifier to indicate a default initial size and position","type":"text"},{"text":" ","type":"text"},{"text":"for a new window that the system creates from a ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","isActive":true,"type":"reference"},{"text":" declaration.","type":"text"}]},{"inlineContent":[{"text":"On Windows, you can use the screen’s bounds to place the window.","type":"text"},{"text":" ","type":"text"},{"text":"For example, you can specify that the window is always placed 140","type":"text"},{"text":" ","type":"text"},{"text":"points from the bottom of the screen:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["struct MyApp: App {","    var body: some Scene {","        ...","","        Window(\"Status\", id: \"status\") {","            StatusView()","        }","        .windowResizability(.contentSize)","        .defaultWindowPlacement { content, context in","            let displayBounds = context.defaultDisplay.visibleRect","            let size = content.sizeThatFits(.unspecified)","            let position = CGPoint(","                x: displayBounds.midX - (size.width \/ 2),","                y: displayBounds.maxY - size.height - 140)","            return WindowPlacement(position: position, size: size)","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"On visionOS, the system always places the first window","type":"text"},{"text":" ","type":"text"},{"text":"relative to where the person is looking.","type":"text"},{"text":" ","type":"text"},{"text":"The system ignores calls to ","type":"text"},{"code":"defaultWindowPlacement(_:)","type":"codeVoice"},{"text":".","type":"text"}]},{"inlineContent":[{"text":"You can place any subsequent windows relative to existing ones by","type":"text"},{"text":" ","type":"text"},{"text":"returning one of the methods defined by ","type":"text"},{"type":"codeVoice","code":"WindowPlacement\/Position"},{"text":" ","type":"text"},{"text":"with the existing window.","type":"text"},{"text":" ","type":"text"},{"text":"For example, you can align the new window with the trailing edge of","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"type":"codeVoice","code":"Content"},{"text":" window:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["struct MyApp: App {","    @Environment(\\.openWindow) private var openWindow","","    var body: some Scene {","        WindowGroup(\"Content\", id: \"content\") {","            Button(\"Open status window\") {","                openWindow(id: \"status\")","            }","        }","","        WindowGroup(\"Status\", id: \"status\") {","            StatusView()","        }","        .windowResizability(.contentSize)","        .defaultWindowPlacement { content, context in","            if let contentWindow = context.windows.first(","            where: { $0.id == \"content\" }) {","                WindowPlacement(.trailing(contentWindow))","            } else {","                WindowPlacement()","            }","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The placement that your function returns acts as a default for when the","type":"text"},{"text":" ","type":"text"},{"text":"window first appears. People can later resize and move the window using","type":"text"},{"text":" ","type":"text"},{"text":"interface controls that the system provides. Also, during state","type":"text"},{"text":" ","type":"text"},{"text":"restoration, the system restores the window to it’s most recent size and","type":"text"},{"text":" ","type":"text"},{"text":"position, rather than the default placement.","type":"text"}]},{"inlineContent":[{"text":"For more information on configuring how scenes behave with","type":"text"},{"text":" ","type":"text"},{"text":"state restoration, see ","type":"text"},{"type":"codeVoice","code":"Scene.stateRestoration(_:)"},{"text":".","type":"text"}],"type":"paragraph"}]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/ModifiedContent/defaultWindowPlacement(_:)":{"title":"defaultWindowPlacement(_:)","role":"symbol","type":"topic","url":"\/documentation\/openswiftui\/modifiedcontent\/defaultwindowplacement(_:)","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ModifiedContent\/defaultWindowPlacement(_:)","fragme