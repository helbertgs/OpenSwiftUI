 ...","","        Window(\"Clipboard\", id: \"clipboard\") {","            ClipboardContentView()","        }","        .commandsReplaced {","            CommandGroup(after: .pasteboard) {","                Section {","                    Button(\"Show Clipboard\") {","                        openWindow(id: \"clipboard\")","                    }","                }","            }","        }","    }","}"],"syntax":null,"type":"codeListing"}]}],"variants":[{"paths":["\/documentation\/openswiftui\/modifiedcontent\/commandsreplaced(content:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ModifiedContent\/commandsReplaced(content:)","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"Replaces all commands defined by the modified scene with the commands","type":"text"},{"text":" ","type":"text"},{"text":"from the builder.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ModifiedContent"]]},"sections":[],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Commands":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Commands"}],"url":"\/documentation\/openswiftui\/commands","title":"Commands","role":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Commands","kind":"symbol","abstract":[{"text":"Conforming types represent a group of related commands that can be exposed","type":"text"},{"text":" ","type":"text"},{"text":"to the user via the main menu on macOS and key commands on iOS.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Commands"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/ModifiedContent/commandsReplaced(content:)":{"abstract":[{"text":"Replaces all commands defined by the modified scene with the commands","type":"text"},{"text":" ","type":"te