{"sections":[],"abstract":[{"type":"text","text":"Replaces all commands defined by the modified scene with the commands"},{"type":"text","text":" "},{"type":"text","text":"from the builder."}],"kind":"symbol","metadata":{"modules":[{"name":"OpenSwiftUI"}],"title":"commandsReplaced(content:)","externalID":"s:11OpenSwiftUI5ScenePAAE16commandsReplaced7contentQrqd__yXE_tAA8CommandsRd__lF::SYNTHESIZED::s:11OpenSwiftUI15ModifiedContentV","roleHeading":"Instance Method","extendedModule":"OpenSwiftUI","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"commandsReplaced","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Content","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"content","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Content","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP","kind":"typeIdentifier"}],"role":"symbol"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/modifiedcontent\/commandsreplaced(content:)"]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"commandsReplaced","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Content","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"@","kind":"attribute"},{"text":"CommandsBuilder","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/CommandsBuilder","preciseIdentifier":"s:11OpenSwiftUI15CommandsBuilderV","kind":"attribute"},{"text":" ","kind":"text"},{"text":"content","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Content","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Commands","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Commands","preciseIdentifier":"s:11OpenSwiftUI8CommandsP","kind":"typeIdentifier"},{"text":"\n","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"code":"Commands","type":"codeVoice"},{"type":"text","text":" builder whose output will be used to replace"},{"type":"text","text":" "},{"type":"text","text":"the commands normally provided by the modified scene."}]}],"name":"content"}],"kind":"parameters"},{"content":[{"text":"Return Value","type":"heading","level":2,"anchor":"return-value"},{"inlineContent":[{"type":"text","text":"A scene that replaces any commands defined by its children"},{"type":"text","text":" "},{"type":"text","text":"with alternative content."}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"WindowGroup"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Window"},{"text":", and other scene types all have an associated","type":"text"},{"text":" ","type":"text"},{"text":"set of commands that they include by default. Apply this modifier to a","type":"text"},{"text":" ","type":"text"},{"text":"scene to replace those commands with the output from the given builder.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For example, the following code adds a scene for showing the contents of","type":"text"},{"text":" ","type":"text"},{"text":"the pasteboard in a dedicated window. We replace the scene’s default","type":"text"},{"text":" ","type":"text"},{"text":"Window > Clipboard menu command with a custom Edit > Show Clipboard","type":"text"},{"text":" ","type":"text"},{"text":"command that we place next to the other pasteboard commands.","type":"text"}]},{"code":["@main","struct Example: App {","    @Environment(\\.openWindow) var openWindow","","    var body: some Scene {","        ...","","        Window(\"Clipboard\", id: \"clipboard\") {","            ClipboardContentView()","        }","        .commandsReplaced {","            CommandGroup(after: .pasteboard) {","                Section {","                    Button(\"Show Clipboard\") {","                        openWindow(id: \"clipboard\")","                    }","                }","            }","        }","    }","}"],"syntax":null,"type":"codeListing"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ModifiedContent\/commandsReplaced(content:)"},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ModifiedContent"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/CommandsBuilder":{"title":"CommandsBuilder","navigatorTitle":[{"text":"CommandsBuilder","kind":"identifier"}],"abstract":[{"type":"text","text":"Constructs command sets from multi-expression closures. Like "},{"type":"codeVoice","code":"ViewBuilder"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"it supports up to ten expressions in the closure body."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CommandsBuilder","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/CommandsBuilder","type":"topic","url":"\/documentation\/openswiftui\/commandsbuilder","kind":"symbol"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/ModifiedContent/commandsReplaced(content:)":{"type":"topic","role":"symbol","identifier