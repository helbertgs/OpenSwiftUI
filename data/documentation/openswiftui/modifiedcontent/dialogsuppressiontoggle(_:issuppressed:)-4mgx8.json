UI\/documentation\/OpenSwiftUI\/Text","kind":"typeIdentifier","text":"Text"},{"kind":"text","text":", "},{"kind":"externalParam","text":"isSuppressed"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSwiftUI7BindingV","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding","kind":"typeIdentifier","text":"Binding"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":">) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","kind":"typeIdentifier","text":"Scene"},{"kind":"text","text":"\n"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The label of the suppression toggle in the dialog. This","type":"text"},{"text":" ","type":"text"},{"text":"parameter can be elided to use the default suppression title.","type":"text"}]}],"name":"label"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Whether the suppression toggle is on or off in the","type":"text"},{"text":" ","type":"text"},{"text":"dialog.","type":"text"}]}],"name":"isSuppressed"}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Applying dialog suppression adds a toggle to dialogs on Windows,"},{"type":"text","text":" "},{"type":"text","text":"which allows the user to request the alert not be displayed again."},{"type":"text","text":" "},{"type":"text","text":"Typically whether a dialog is suppressed is stored in "},{"type":"codeVoice","code":"AppStorage"},{"type":"text","text":" "},{"type":"text","text":"and used to decide whether to present the dialog in the future."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example configures an alert with a"},{"type":"text","text":" "},{"type":"text","text":"suppression toggle. The toggle’s state is stored in "},{"type":"codeVoice","code":"AppStorage"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"used to determine whether or not to show the dialog when the"},{"type":"text","text":" "},{"type":"text","text":"“Delete Items” button is pressed."}]},{"type":"codeListing","syntax":null,"code":["struct MyApp: App {","    @State private var isShowingDialog = false","    @AppStorage(\"suppressEraseItemAlert\")","    private var suppressAlert = false","","    var body: some Scene {","        Window(...) {","            Button(\"Delete items\") {","                isShowingDialog = true","            }","        }","","        AlertScene(","            \"Are you sure you want to erase these items?\",","            isPresented: $isShowingDialog","        ) {","            Button(\"Erase\", role: .destructive) {","                \/\/ Handle item deletion.","            }","            Button(\"Cancel\", role: .cancel) {","                \/\/ Handle cancellation","            }","        }","        .dialogSuppressionToggle(","            \"Do not ask about erasing items again\",","            isSuppressed: $suppressAlert)","    }","}"]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/modifiedcontent\/dialogsuppressiontoggle(_:issuppressed:)-4mgx8"]}],"abstract":[{"type":"text","text":"Enables user suppression of an alert with a custom suppression"},{"type":"text","text":" "},{"type":"text","text":"message."}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Binding":{"abstract":[{"type":"text","text":"A property wrapper type that can read and write a value owned by a source of"},{"type":"text","text":" "},{"type":"text","text":"truth."}],"type":"topic","role":"symbol","kind":"symbol","title":"Binding","url":"\/documentation\/openswiftui\/binding","identifier":"doc:\/\/OpenSwiftUI\/documentation\