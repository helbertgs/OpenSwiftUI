aph","inlineContent":[{"text":"Whether the suppression toggle is on or off in the","type":"text"},{"text":" ","type":"text"},{"text":"dialog.","type":"text"}]}]}]},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Applying dialog suppression adds a toggle to dialogs on Windows,","type":"text"},{"text":" ","type":"text"},{"text":"which allows the user to request the alert not be displayed again.","type":"text"},{"text":" ","type":"text"},{"text":"Typically whether a dialog is suppressed is stored in ","type":"text"},{"code":"AppStorage","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and used to decide whether to present the dialog in the future.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The following example configures an alert with a","type":"text"},{"text":" ","type":"text"},{"text":"suppression toggle. The toggle’s state is stored in ","type":"text"},{"code":"AppStorage","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"used to determine whether or not to show the dialog when the","type":"text"},{"text":" ","type":"text"},{"text":"“Delete Items” button is pressed.","type":"text"}]},{"type":"codeListing","syntax":null,"code":["struct MyApp: App {","    @State private var isShowingDialog = false","    @AppStorage(\"suppressEraseItemAlert\")","    private var suppressAlert = false","","    var body: some Scene {","        Window(...) {","            Button(\"Delete items\") {","                isShowingDialog = true","            }","        }","","        AlertScene(","            \"Are you sure you want to erase these items?\",","            isPresented: $isShowingDialog","        ) {","            Button(\"Erase\", role: .destructive) {","                \/\/ Handle item deletion.","            }","            Button(\"Cancel\", role: .cancel) {","                \/\/ Handle cancellation","            }","        }","        .dialogSuppressionToggle(","            \"Do not ask about erasing items again\",","            isSuppressed: $suppressAlert)","    }","}"]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ModifiedContent"]]},"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dialogSuppressionToggle","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI4TextV","text":"Text","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"isSuppressed","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI7BindingV","text":"Binding","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","text":"Scene","kind":"typeIdentifier"}],"modules":[{"name":"OpenSwiftUI"}],"title":"dialogSuppressionToggle(_:isSuppressed:)","role":"symbol","extendedModule":"OpenSwiftUI","roleHeading":"Instance Method","symbolKind":"method","externalID":"s:11OpenSwiftUI5ScenePAAE23dialogSuppressionToggle_12isSuppressedQrAA4TextV_AA7BindingVySbGtF::SYNTHESIZED::s:11OpenSwiftUI15ModifiedContentV"},"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Enables user suppression of an alert with a custom suppression"},{"type":"text","text":" "},{"type":"text","text":"message."}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/ModifiedContent":{"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"ModifiedContent","kind":"identifier"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ModifiedContent","role":"symbol","abstract":[{"type":"text","text":"A value with a modifier applied to it."}],"title":"ModifiedContent","kin