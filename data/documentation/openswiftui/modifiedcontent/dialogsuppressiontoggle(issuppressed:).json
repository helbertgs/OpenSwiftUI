,"kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Binding","preciseIdentifier":"s:11OpenSwiftUI7BindingV","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","kind":"typeIdentifier"},{"text":"\n","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"name":"isSuppressed","content":[{"inlineContent":[{"text":"Whether the suppression toggle is on or off","type":"text"},{"text":" ","type":"text"},{"text":"in the dialog.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Applying dialog suppression adds a toggle to dialogs on Windows,"},{"type":"text","text":" "},{"type":"text","text":"which allows the user to request the alert not be displayed again."},{"text":" ","type":"text"},{"type":"text","text":"Typically whether a dialog is suppressed is stored in "},{"type":"codeVoice","code":"AppStorage"},{"type":"text","text":" "},{"text":"and used to decide whether to present the dialog in the future.","type":"text"}]},{"inlineContent":[{"type":"text","text":"The following example configures an alert with a"},{"type":"text","text":" "},{"type":"text","text":"suppression toggle. The toggle’s state is stored in "},{"code":"AppStorage","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"used to determine whether or not to show the dialog when the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"“Delete Items” button is pressed."}],"type":"paragraph"},{"code":["struct MyApp: App {","    @State private var isShowingDialog = false","    @AppStorage(\"suppressEraseItemAlert\")","    private var suppressAlert = false","","    var body: some Scene {","        Window(...) {","            Button(\"Delete items\") {","                isShowingDialog = true","            }","        }","","        AlertScene(","            \"Are you sure you want to erase these items?\",","            isPresented: $isShowingDialog","        ) {","            Button(\"Erase\", role: .destructive) {","                \/\/ Handle item deletion.","            }","            Button(\"Cancel\", role: .cancel) {","                \/\/ Handle cancellation","            }","        }","        .dialogSuppressionToggle(","            \"Do not ask about erasing items again\",","            isSuppressed: $suppressAlert)","    }","}"],"type":"codeListing","syntax":null}],"kind":"content"}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/ModifiedContent/dialogSuppressionToggle(isSuppressed:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dialogSuppressionToggle","kind":"identifier"},{"text":"(","kind":"text"},{"text":"isSuppressed","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Binding","preciseIdentifier":"s:11OpenSwiftUI7BindingV","kind":"typeIdentifier"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5SceneP"}],"kind":"symbol","title":"dialogSuppressionToggle(isSuppressed:)","type":"topic","url":"\/documentation\/openswiftui\/modifiedcontent\/dialogsuppressiontoggle(issuppressed:)","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ModifiedContent\/dialogSuppressionToggle(isSuppressed:)","abstract":[{"type":"text","text":"Enables user suppression of an alert with a custom suppression"},{"type":"text"