to place a"},{"type":"text","text":" "},{"type":"text","text":"newly opened window relative to the screen bounds."}]}]}]},{"kind":"content","content":[{"type":"heading","anchor":"return-value","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"text":"A scene that uses a default position for new windows.","type":"text"}]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"text":"The first time your app opens a window from a particular scene","type":"text"},{"text":" ","type":"text"},{"text":"declaration, the system places the window at the center of the screen by","type":"text"},{"text":" ","type":"text"},{"text":"default. For scene types that support multiple simultaneous windows, the","type":"text"},{"text":" ","type":"text"},{"text":"system offsets each additional window by a small amount to avoid","type":"text"},{"text":" ","type":"text"},{"text":"completely obscuring existing windows.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You can override the default placement of the first window by","type":"text"},{"text":" ","type":"text"},{"text":"applying a scene modifier that indicates where to place the window","type":"text"},{"text":" ","type":"text"},{"text":"relative to the screen bounds. For example, you can request that the","type":"text"},{"text":" ","type":"text"},{"text":"system place a new window in the bottom trailing corner of the screen:","type":"text"}],"type":"paragraph"},{"code":["@main","struct MyApp: App {","    var body: some Scene {","        WindowGroup {","            ContentView()","        }","        .defaultPosition(.bottomTrailing)","    }","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"The system aligns the point in the window that corresponds to the","type":"text"},{"text":" ","type":"text"},{"text":"specified ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint","isActive":true,"type":"reference"},{"text":" with the point in the screen that corresponds","type":"text"},{"text":" ","type":"text"},{"text":"to the same unit point.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You typically use one of the predefined unit points — like","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/bottomTrailing","type":"reference","isActive":true},{"text":" in the above example — but","type":"text"},{"text":" ","type":"text"},{"text":"you can also use a custom unit point. For example, the following","type":"text"},{"text":" ","type":"text"},{"text":"modifier aligns the point that’s one quarter of the way from the","type":"text"},{"text":" ","type":"text"},{"text":"leading edge of the window with the point that’s one quarter of","type":"text"},{"text":" ","type":"text"},{"text":"the way from the leading edge of the screen, while centering the","type":"text"},{"text":" ","type":"text"},{"text":"window in the y-dimension:","type":"text"}],"type":"paragraph"},{"code":["WindowGroup {","    ContentView()","}",".defaultPosition(UnitPoint(x: 0.25, y: 0.5))"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The modifier affects any scene type that creates windows in macOS,"},{"type":"text","text":" "},{"type":"text","text":"namely:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup","isActive":true}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"Window","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"DocumentGroup","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Settings"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"The value that you provide acts only as an initial default. During state"},{"type":"text","text":" "},{"type":"text","text":"restoration, the system restores the window to the position that it"},{"type":"text","text":" "},{"type":"text","text":"last occupied."}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"Sets a default position for a window."}],"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ModifiedContent\/defaultPosition(_:)","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/openswiftui\/modifiedcontent\/defaultposition(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/ModifiedContent":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ModifiedContent","navigatorTitle":[{"text":"ModifiedContent","kind":"identifier"}],"type":"topic","title":"ModifiedContent","url":"\/documentation\/openswiftui\/modifiedcontent","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ModifiedContent","kind":"identifier"}],"kind":"symbol","abstract":[]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene":{"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"identifier"}],"navigatorTitle":[{"text":"Scene","kind":"identifier"}],"url":"\/documentation\/openswiftui\/scene","kind":"symbol","abstract":[{"text":"A part of an app’s user interface with a life cycle managed by the","type":"text"},{"text":" ","type":"text"},{"text":"system.","type":"text"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","type":"topic","title":"Scene"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/UnitPoint/bottomTrailing":{"role":"symbol","url":"\/documentation\/openswiftui\/unitpoint\/bottomtrailing","kind":"symbol","abstract":[{"text":"A point that’s in the bottom, trailing corner of a view.","type":"text"}],"type":"topic","title":"bottomTrailing","identifier":"doc:\/\/Open