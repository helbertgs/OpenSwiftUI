":"text","text":" normally"},{"type":"text","text":" "},{"type":"text","text":"creates a File > New Window menu command whose keyboard shortcut is"},{"type":"text","text":" "},{"type":"codeVoice","code":"⌘N"},{"type":"text","text":". The following code changes it to "},{"type":"codeVoice","code":"⌥⌘N"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["WindowGroup {","    ContentView()","}",".keyboardShortcut(\"n\", modifiers: [.option, .command])"]},{"text":"Localization","anchor":"Localization","type":"heading","level":3},{"inlineContent":[{"text":"Provide a ","type":"text"},{"type":"codeVoice","code":"localization"},{"text":" value to specify how this shortcut","type":"text"},{"text":" ","type":"text"},{"text":"should be localized.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Given that "},{"code":"key","type":"codeVoice"},{"type":"text","text":" is always defined in relation to the US-English"},{"type":"text","text":" "},{"type":"text","text":"keyboard layout, it might be hard to reach on different international"},{"type":"text","text":" "},{"type":"text","text":"layouts. For example the shortcut "},{"code":"⌘[","type":"codeVoice"},{"type":"text","text":" works well for the"},{"type":"text","text":" "},{"type":"text","text":"US layout but is hard to reach for German users, where"},{"type":"text","text":" "},{"code":"[","type":"codeVoice"},{"type":"text","text":" is available by pressing "},{"code":"⌥5","type":"codeVoice"},{"type":"text","text":", making users type "},{"code":"⌥⌘5","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The automatic keyboard shortcut remapping re-assigns the shortcut to"},{"type":"text","text":" "},{"type":"text","text":"an appropriate replacement, "},{"type":"codeVoice","code":"⌘Ö"},{"text":" in this case.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Providing th