tent":[{"type":"paragraph","inlineContent":[{"text":"The keyboard shortcut for presenting the scene, or ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":".","type":"text"}]}],"name":"shortcut"}],"kind":"parameters"},{"content":[{"anchor":"return-value","text":"Return Value","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"A scene that can be presented with a keyboard shortcut.","type":"text"}]}],"kind":"content"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"A scene’s keyboard shortcut is bound to the command it adds for creating","type":"text"},{"text":" ","type":"text"},{"text":"new windows (in the case of ","type":"text"},{"type":"codeVoice","code":"WindowGroup"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"DocumentGroup"},{"text":") or","type":"text"},{"text":" ","type":"text"},{"text":"bringing a singleton window forward (in the case of ","type":"text"},{"type":"codeVoice","code":"Window"},{"text":" and, on","type":"text"},{"text":" ","type":"text"},{"text":"macOS, ","type":"text"},{"type":"codeVoice","code":"Settings"},{"text":"). Pressing the keyboard shortcut is equivalent to","type":"text"},{"text":" ","type":"text"},{"text":"selecting the menu command.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"In cases where a command already has a keyboard shortcut, the scene’s","type":"text"},{"text":" ","type":"text"},{"text":"keyboard shortcut is used instead. For example, ","type":"text"},{"code":"WindowGroup","type":"codeVoice"},{"text":" normally","type":"text"},{"text":" ","type":"text"},{"text":"creates a File > New Window menu command whose keyboard shortcut is","type":"text"},{"text":" ","type":"text"},{"code":"⌘N","type":"codeVoice"},{"text":". The following code changes it to something based on dynamic state:","type":"text"}]},{"type":"codeListing","code":["@main","struct Notes: App {","    @State private var newWindowShortcut: KeyboardShortcut? = ...","","    var body: some Scene {","        WindowGroup {","            ContentView($newWindowShortcut)","        }","        .keyboardShortcut(newWindowShortcut)","    }","}"],"syntax":null},{"type":"paragraph","inlineContent":[{"text":"If ","type":"text"},{"type":"codeVoice","code":"shortcut"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", the scene’s presentation command will not be"},{"type":"text","text":" "},{"type":"text","text":"associated with a keyboard shortcut, even if SwiftUI normally assigns"},{"type":"text","text":" "},{"type":"text","text":"one automatically."}]}],"kind":"content"}],"kind":"symbol","identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ModifiedContent\/keyboardShortcut(_:)","interfaceLanguage":"swift"},"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/ModifiedContent":{"role":"symbol","navigatorTitle":[{"text":"ModifiedContent","kind":"identifier"}],"url":"\/documentation\/openswiftui\/modifiedcontent","abstract":[],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ModifiedContent","type":"topic","kind":"symbol","title":"ModifiedContent","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ModifiedContent","kind":"identifier"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene":{"abstract":[{"type":"text","text":"A part of an app’s user interface with a life cycle managed by the"},{"type":"text","text":" "},{"type":"text","text":"system."}],"type":"topic","title":"Scene","url":"\/documentation\/openswiftui\/scene","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scene"}],"navigatorTitle":[{"kind":"identifier","text":"Scene"}]},"doc://OpenSwiftUI/documentation/OpenSw