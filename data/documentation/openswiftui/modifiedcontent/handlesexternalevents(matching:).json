d":"text","text":" "},{"kind":"typeIdentifier","text":"Scene","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP"},{"kind":"text","text":"\n"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This modifier is only supported for WindowGroup Scene types."}]},{"type":"paragraph","inlineContent":[{"text":"For DocumentGroups, the received External Event must have a URL","type":"text"},{"text":" ","type":"text"},{"text":"for the DocumentGroup to be considered. (Either via openURL, or","type":"text"},{"text":" ","type":"text"},{"text":"the webPageURL property of an NSUserActivity). The UTI for the URL","type":"text"},{"text":" ","type":"text"},{"text":"is implicitly matched against the DocumentGroup’s supported types.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the modifier evaluates to true, an instance of the"},{"type":"text","text":" "},{"type":"text","text":"Scene will be used."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the modifier evaluates to false, on macOS the Scene"},{"type":"text","text":" "},{"type":"text","text":"will not be used even if no other Scenes are available."},{"type":"text","text":" "},{"type":"text","text":"This case is considered an error. On iOS, the first Scene"},{"type":"text","text":" "},{"type":"text","text":"specified in the body property for the App will be used."}]},{"type":"paragraph","inlineContent":[{"text":"If no modifier is set, the Scene will be used if all","type":"text"},{"text":" ","type":"text"},{"text":"other WindowGroups with a modifier evaluate to false.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"On platforms that only allow a single Window\/Scene, this method is","type":"text"},{"text":" ","type":"text"},{"text":"ignored.","type":"text"}]}]}],"abstract":[{"type":"text","text":"Specifies a modifier to indicate if this Scene can be used"},{"type":"text","text":" "},{"type":"text","text":"when creating a new Scene for the received External Event."}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/ModifiedContent/handlesExternalEvents(matching:)":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"handlesExternalEvents"},{"kind":"text","text":"("},{"kind":"externalParam","text":"matching"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sh","kind":"typeIdentifier","text":"Set"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":">) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","kind":"typeIdentifier","text":"Scene"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ModifiedContent\/handlesExternalEvents(matching:)","url":"\/documentation\/openswiftui\/modifiedcontent\/handlesexternalevents(matching:)","abstract":[{"type":"text","text":"Specifies a modifier to indicate if this Scene can be used"},{"type":"text","text":" "},{"type":"text","text":"when creating a new Scene for the received External Event."}],"title":"handlesExternalEvents(matching:)"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene":{"abstract":[{"type":"text","text":"A part of an app’s user interface with a life cycle managed by the"},{"type":"text","text":" "},{"type":"text","text":"system."}],"type":"topic","title":"Scene","url":"\/documentation\/openswiftui\/scene","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scene"}],"navigatorTitle":[{"kind":"identifier","text":"Scene"}]},"doc://OpenSwiftUI/documentation/