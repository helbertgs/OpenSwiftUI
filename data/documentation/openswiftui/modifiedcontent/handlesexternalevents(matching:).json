{"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"symbolKind":"method","title":"handlesExternalEvents(matching:)","extendedModule":"OpenSwiftUI","role":"symbol","modules":[{"name":"OpenSwiftUI"}],"roleHeading":"Instance Method","externalID":"s:11OpenSwiftUI5ScenePAAE21handlesExternalEvents8matchingQrShySSG_tF::SYNTHESIZED::s:11OpenSwiftUI15ModifiedContentV","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"handlesExternalEvents"},{"kind":"text","text":"("},{"kind":"externalParam","text":"matching"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sh","kind":"typeIdentifier","text":"Set"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":">) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","kind":"typeIdentifier","text":"Scene"}]},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"handlesExternalEvents","kind":"identifier"},{"text":"(","kind":"text"},{"text":"matching","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"conditions","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Set","preciseIdentifier":"s:Sh","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP","kind":"typeIdentifier"},{"text":"\n","kind":"text"}]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"This modifier is only supported for WindowGroup Scene types.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For DocumentGroups, the received External Event must have a URL","type":"text"},{"text":" ","type":"text"},{"text":"for the DocumentGroup to be considered. (Either via openURL, or","type":"text"},{"text":" ","type":"text"},{"text":"the webPageURL property of an NSUserActivity). The UTI for the URL","type":"text"},{"text":" ","type":"text"},{"text":"is implicitly matched against the DocumentGroup’s supported types.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If the modifier evaluates to true, an instance of the","type":"text"},{"text":" ","type":"text"},{"text":"Scene will be used.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If the modifier evaluates to false, on macOS the Scene"},{"type":"text","text":" "},{"type":"text","text":"will not be used even if no other Scenes are available."},{"type":"text","text":" "},{"type":"text","text":"This case is considered an error. On iOS, the first Scene"},{"type":"text","text":" "},{"type":"text","text":"specified in the body property for the App will be used."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If no modifier is set, the Scene will be used if all"},{"type":"text","text":" "},{"type":"text","text":"other WindowGroups with a modifier evaluate to false."}],"type":"paragraph"},{"inlineContent":[{"text":"On platforms that only allow a single Window\/Scene, this method is","type":"text"},{"text":" ","type":"text"},{"text":"ignored.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"Specifies a modifier to indicate if this Scene can be used"},{"type":"text","text":" "},{"type":"text","text":"when creating a new Scene for the received External Event."}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ModifiedContent"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/modifiedcontent\/handlesexternalevents(matching:)"]}],"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ModifiedContent\/handlesExternalEvents(matching:)","interfaceLanguage":"swift"},"sections":[],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/ModifiedContent/handlesExternalEvents(matching:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"handlesExternalEvents","kind":"identifier"},{"text":"(","kind":"text"},{"text":"matching","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sh","text":"Set","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","text":"Scene","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"Specifies a modifier to indicate if this Scene can be used"},{"type":"text","text":" "},{"type":"text","text":"when creating a new Scene for the received External Event."}],"type":"topic","role":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ModifiedContent\/handlesExternalEvents(matching:)","url":"\/documentation\/openswiftui\/modifiedcontent\/handlesexternalevents(matching:)","title":"handlesExternalEvents(matching:)","kind":"symbol"},"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"kind":"symbol","role":"collection","title":"OpenSwiftUI","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","abstract":[],"type":"topic","url":"\/documentation\/openswiftui"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/ModifiedContent":{"url":"\/documentation\/openswiftui\/modifiedcontent","type":"topic","abstract":[],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ModifiedContent","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ModifiedContent"}],"kind":"symbol",