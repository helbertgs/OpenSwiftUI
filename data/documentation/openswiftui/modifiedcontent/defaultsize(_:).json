{"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ModifiedContent"]]},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ModifiedContent\/defaultSize(_:)","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultSize","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"size","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Size","kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Size","preciseIdentifier":"s:11OpenSwiftUI4SizeV"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","kind":"typeIdentifier","text":"Scene"},{"kind":"text","text":"\n"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"name":"size","content":[{"inlineContent":[{"text":"The default size for new windows created from a scene.","type":"text"}],"type":"paragraph"}]}]},{"content":[{"text":"Return Value","level":2,"anchor":"return-value","type":"heading"},{"inlineContent":[{"text":"A scene that uses a default size for new windows.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Use this scene modifier to indicate a default initial size for a new"},{"type":"text","text":" "},{"type":"text","text":"window that the system creates from a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"},{"type":"text","text":" declaration. For"},{"type":"text","text":" "},{"type":"text","text":"example, you can request that new windows that a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup"},{"type":"text","text":" "},{"type":"text","text":"generates occupy 600 points in the x-dimension and 400 points in"},{"type":"text","text":" "},{"type":"text","text":"the y-dimension:"}],"type":"paragraph"},{"code":["@main","struct MyApp: App {","    var body: some Scene {","        WindowGroup {","            ContentView()","        }","        .defaultSize(CGSize(width: 600, height: 400))","    }","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"The size that you specify acts only as a default for when the window","type":"text"},{"text":" ","type":"text"},{"text":"first appears. People can later resize the window using interface","type":"text"},{"text":" ","type":"text"},{"text":"controls that the system provides. Also, during state restoration,","type":"text"},{"text":" ","type":"text"},{"text":"the system restores windows to their most recent size rather than","type":"text"},{"text":" ","type":"text"},{"text":"the default size.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If you specify a default size that’s outside the range of the window’s"},{"type":"text","text":" "},{"type":"text","text":"inherent resizability in one or both dimensions, the system clamps the"},{"type":"text","text":" "},{"type":"text","text":"affected dimension to keep it in range. You can configure the"},{"type":"text","text":" "},{"type":"text","text":"resizability of a scene using the "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/windowResizability(_:)","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"modifier."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The default size modifier affects any scene type that creates windows"},{"type":"text","text":" "},{"type":"text","text":"in macOS, namely:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Window"}]}]},{"content":[{"inlineContent":[{"code":"DocumentGroup","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"Settings","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"If you want to specify the input directly in terms of width and height,"},{"type":"text","text":" "},{"type":"text","text":"use "},{"type":"codeVoice","code":"Scene\/defaultSize(width:height:)"},{"type":"text","text":" instead."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/modifiedcontent\/defaultsize(_:)"]}],"abstract":[{"text":"Sets a default size for a window.","type":"text"}],"kind":"symbol","metadata":{"role":"symbol","title":"defaultSize(_:)","roleHeading":"Instance Method","modules":[{"name":"OpenSwiftUI"}],"externalID":"s:11OpenSwiftUI5ScenePAAE11defaultSizeyQrAA0F0VF::SYNTHESIZED::s:11OpenSwiftUI15ModifiedContentV","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultSize","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Size","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI4SizeV"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5SceneP"}],"extendedModule":"OpenSwiftUI"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/ModifiedContent":{"role":"symbol","navigatorTitle":[{"text":"ModifiedContent","kind":"identifier"}],"url":"\/documentation\/openswiftui\/modifiedcontent","abstract":[],"ident