er","text":"V"},{"kind":"text","text":", "},{"kind":"externalParam","text":"initial"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":" = false, "},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"action"},{"kind":"text","text":": "},{"kind":"keyword","text":"@escaping"},{"kind":"text","text":" ("},{"kind":"typeIdentifier","text":"V"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"V"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP","text":"Scene"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"V"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SQ","text":"Equatable"},{"kind":"text","text":"\n"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"value","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The value to check when determining whether to run the"},{"type":"text","text":" "},{"type":"text","text":"closure. The value must conform to the"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Swift\/Equatable"},{"type":"text","text":" "},{"type":"text","text":"protocol."}]}]},{"name":"initial","content":[{"inlineContent":[{"text":"Whether the action should be run when this scene initially","type":"text"},{"text":" ","type":"text"},{"text":"appears.","type":"text"}],"type":"paragraph"}]},{"name":"action","content":[{"inlineContent":[{"type":"text","text":"A closure to run when the value changes."}],"type":"paragraph"}]}]},{"content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A scene that triggers an action in response to a change."}]}],"kind":"content"},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"text":"Use this modifier to trigger a side effect when a value changes, like","type":"text"},{"text":" ","type":"text"},{"text":"the value associated with an ","type":"text"},{"code":"SwiftUI\/Environment","type":"codeVoice"},{"text":" key or a","type":"text"},{"text":" ","type":"text"},{"code":"SwiftUI\/Binding","type":"codeVoice"},{"text":". For example, you can clear a cache when you notice","type":"text"},{"text":" ","type":"text"},{"text":"that a scene moves to the background:","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["struct MyScene: Scene {","    @Environment(\\.scenePhase) private var scenePhase","    @StateObject private var cache = DataCache()","","    var body: some Scene {","        WindowGroup {","            MyRootView(cache: cache)","        }","        .onChange(of: scenePhase) { oldScenePhase, newScenePhase in","            if newScenePhase == .background {","                cache.empty()","            }","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The system may call the action closure on the main actor, so avoid"},{"type":"text","text":" "},{"type":"text","text":"long-running tasks in the closure. If you need to perform such tasks,"},{"type":"text","text":" "},{"type":"text","text":"detach an asynchronous background task:"}],"type":"paragraph"},{"syntax":null,"code":[".onChange(of: scenePhase) { oldScenePhase, newScenePhase in","    if newScenePhase == .background {","        Task.detached(priority: .background) {","            \/\/ ...","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"When the value changes, the new version of the closure will be called,","type":"text"},{"text":" ","type":"text"},{"text":"so any captured values will have their values from the time that the","type":"text"},{"text":" ","type":"text"},{"text":"observed value has its new value. The system passes the old and new","type":"text"},{"text":" ","type":"text"},{"text":"observed values into the closure.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"Adds an action to perform when the given value changes."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/modifiedcontent\/onchange(of:initial:_:)-g3ry"]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/ModifiedContent/onChange(of:initial:_:)-g3ry":{"abstract":[{"text":"Adds an action to perform when the given value changes.","type":"text"}],"title":"onChange(of:initial:_:)","type":"topic","url":"\/documentation\/openswiftui\/modifiedcontent\/onchange(of:initial:_:)-g3ry","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onChange"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"V"},{"kind":"text","text":">("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"V"},{"kind":"text","text":", "},{"kind":"externalParam","text":"initial"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":", ("},{"kind":"typeIdentifier","text":"V"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"V"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5SceneP","text":"Scene"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ModifiedContent\/onChange(of:initial:_:)-g3ry","kind":"symbol"},"doc://OpenSwiftUI/docum