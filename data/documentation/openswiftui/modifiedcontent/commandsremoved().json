{"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ModifiedContent"]]},"sections":[],"abstract":[{"type":"text","text":"Removes all commands defined by the modified scene."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"commandsRemoved","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","text":"Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP","kind":"typeIdentifier"},{"text":"\n","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"text":"Return Value","type":"heading","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"A scene that excludes any commands defined by its children.","type":"text"}]}],"kind":"content"},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"code":"WindowGroup","type":"codeVoice"},{"type":"text","text":", "},{"code":"Window","type":"codeVoice"},{"type":"text","text":", and other scene types all have an associated"},{"type":"text","text":" "},{"type":"text","text":"set of commands that they include by default. Apply this modifier to a"},{"type":"text","text":" "},{"type":"text","text":"scene to exclude those commands."}]},{"type":"paragraph","inlineContent":[{"text":"For example, the following code adds a scene for presenting the details","type":"text"},{"text":" ","type":"text"},{"text":"of an individual data model in a separate window. To ensure that the","type":"text"},{"text":" ","type":"text"},{"text":"window can only appear programmatically, we remove the scene’s commands,","type":"text"},{"text":" ","type":"text"},{"text":"including File > New Note Window.","type":"text"}]},{"syntax":null,"type":"codeListing","code":["@main","struct Example: App {","    var body: some Scene {","        ...","","        WindowGroup(\"Note\", id: \"note\", for: Note.ID.self) {","            NoteDetailView(id: $0)","        }","        .commandsRemoved()","    }","}"]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/modifiedcontent\/commandsremoved()"]}],"metadata":{"title":"commandsRemoved()","externalID":"s:11OpenSwiftUI5ScenePAAE15commandsRemovedQryF::SYNTHESIZED::s:11OpenSwiftUI15ModifiedContentV","roleHeading":"Instance Method","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"commandsRemoved","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","text":"Scene","kind":"typeIdentifier"}],"role":"symbol","modules":[{"name":"OpenSwiftUI"}],"extendedModule":"OpenSwiftUI"},"kind":"symbol","identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ModifiedContent\/commandsRemoved()","interfaceLanguage":"swift"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/ModifiedContent":{"role":"symbol","navigatorTitle":[{"text":"ModifiedContent","kind":"identifier"}],"url":"\/documentation\/openswiftui\/modifiedcontent","abstract":[],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ModifiedContent","type":"topic","kind":"symbol","title":"ModifiedContent","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ModifiedContent","kind":"identifier"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/ModifiedContent/commandsRemoved()":{"abstract":[{"type":"text","text":"Removes all commands defined by the modified scene."}],"url":"\/documentation\/openswiftui\/modifiedcontent\/commandsremoved()","title":"commandsRemoved()","role":"symbol","fragments":[{"text":"func","kind":"keyword