{"abstract":[{"text":"Removes all commands defined by the modified scene.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ModifiedContent"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"commandsRemoved"},{"kind":"text","text":"() -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"},{"kind":"text","text":"\n"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"anchor":"return-value","level":2,"type":"heading","text":"Return Value"},{"inlineContent":[{"text":"A scene that excludes any commands defined by its children.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"code":"WindowGroup","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Window","type":"codeVoice"},{"text":", and other scene types all have an associated","type":"text"},{"text":" ","type":"text"},{"text":"set of commands that they include by default. Apply this modifier to a","type":"text"},{"text":" ","type":"text"},{"text":"scene to exclude those commands.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For example, the following code adds a scene for presenting the details","type":"text"},{"text":" ","type":"text"},{"text":"of an individual data model in a separate window. To ensure that the","type":"text"},{"text":" ","type":"text"},{"text":"window can only appear programmatically, we remove the scene’s commands,","type":"text"},{"text":" ","type":"text"},{"text":"including File > New Note Window.","type":"text"}]},{"type":"codeListing","code":["@main","struct Example: App {","    var body: some Scene {","        ...","","        WindowGroup(\"Note\", id: \"note\", for: Note.ID.self) {","            NoteDetailView(id: $0)","        }","        .commandsRemoved()","    }","}"],"syntax":null}],"kind":"content"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ModifiedContent\/commandsRemoved()"},"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"commandsRemoved","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5SceneP"}],"externalID":"s:11OpenSwiftUI5ScenePAAE15commandsRemovedQryF::SYNTHESIZED::s:11OpenSwiftUI15ModifiedContentV","symbolKind":"method","role":"symbol","title":"commandsRemoved()","roleHeading":"Instance Method","extendedModule":"OpenSwiftUI","modules":[{"name":"OpenSwiftUI"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/modifiedcontent\/commandsremoved()"]}],"kind":"symbol","references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"kind":"symbol","role":"collection","title":"OpenSwiftUI","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","abstract":[],"type":"topic","url":"\/documentation\/openswiftui"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene":{"kind":"symbol","title":"Scene","abstract":[{"type":"text","text":"A part of an app’s user interface with a life cycle managed by the"},{"type":"text","text":" "},{"type":"text","text":"system."}],"url":"\/documentation\/openswiftui\/scene","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"identifier"}],"navigatorTitle":[{"text":"Scene","kind":"identifier"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","type":"topic","role":"symbol"},"do