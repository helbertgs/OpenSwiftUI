{"abstract":[{"text":"Removes all commands defined by the modified scene.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"commandsRemoved"},{"kind":"text","text":"() -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5SceneP","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","text":"Scene"},{"kind":"text","text":"\n"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","anchor":"return-value","text":"Return Value"},{"inlineContent":[{"text":"A scene that excludes any commands defined by its children.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"code":"WindowGroup","type":"codeVoice"},{"type":"text","text":", "},{"code":"Window","type":"codeVoice"},{"type":"text","text":", and other scene types all have an associated"},{"type":"text","text":" "},{"type":"text","text":"set of commands that they include by default. Apply this modifier to a"},{"type":"text","text":" "},{"type":"text","text":"scene to exclude those commands."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, the following code adds a scene for presenting the details"},{"type":"text","text":" "},{"type":"text","text":"of an individual data model in a separate window. To ensure that the"},{"type":"text","text":" "},{"type":"text","text":"window can only appear programmatically, we remove the scene’s commands,"},{"type":"text","text":" "},{"type":"text","text":"including File > New Note Window."}]},{"type":"codeListing","code":["@main","struct Example: App {","    var body: some Scene {","        ...","","        WindowGroup(\"Note\", id: \"note\", for: Note.ID.self) {","            NoteDetailView(id: $0)","        }","        .commandsRemoved()","    }","}"],"syntax":null}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ModifiedContent\/commandsRemoved()"},"sections":[],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ModifiedContent"]]},"variants":[{"paths":["\/documentation\/openswiftui\/modifiedcontent\/commandsremoved()"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Instance Method","title":"commandsRemoved()","symbolKind":"method","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"commandsRemoved","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP","kind":"typeIdentifier"}],"modules":[{"name":"OpenSwiftUI"}],"externalID":"s:11OpenSwiftUI5ScenePAAE15commandsRemovedQryF::SYNTHESIZED::s:11OpenSwiftUI15ModifiedContentV","extendedModule":"OpenSwiftUI"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"abstract":[],"kind":"symbol","url":"\/documentation\/openswiftui","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","type":"topic","title":"OpenSwiftUI"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/ModifiedContent":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ModifiedContent","navigatorTitle":[{"text":"ModifiedContent","kind":"identifier"}],"type":"topic","title":"ModifiedContent","url":"\/documentation\/openswiftui\/modifiedcontent","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ModifiedContent","kind":"identifier"}],"kind":"symbol","abstract":[]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene":{"role":"symbol","fragments":[{"text":"proto