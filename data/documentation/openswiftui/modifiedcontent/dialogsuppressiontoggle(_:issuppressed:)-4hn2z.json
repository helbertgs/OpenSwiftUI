e":"AppStorage","type":"codeVoice"},{"text":" and","type":"text"},{"type":"text","text":" "},{"type":"text","text":"used to determine whether or not to show the dialog when the"},{"type":"text","text":" "},{"type":"text","text":"“Delete Items” button is pressed."}]},{"type":"codeListing","code":["struct MyApp: App {","    @State private var isShowingDialog = false","    @AppStorage(\"suppressEraseItemAlert\")","    private var suppressAlert = false","","    var body: some Scene {","        Window(...) {","            Button(\"Delete items\") {","                isShowingDialog = true","            }","        }","","        AlertScene(","            \"Are you sure you want to erase these items?\",","            isPresented: $isShowingDialog","        ) {","            Button(\"Erase\", role: .destructive) {","                \/\/ Handle item deletion.","            }","            Button(\"Cancel\", role: .cancel) {","                \/\/ Handle cancellation","            }","        }","        .dialogSuppressionToggle(","            \"Do not ask about erasing items again\",","            isSuppressed: $suppressAlert)","    }","}"],"syntax":null}],"kind":"content"}],"variants":[{"paths":["\/documentation\/openswiftui\/modifiedcontent\/dialogsuppressiontoggle(_:issuppressed:)-4hn2z"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","abstract":[{"text":"Enables user suppression of an alert with a custom suppression","type":"text"},{"text":" ","type":"text"},{"text":"message.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ModifiedContent\/dialogSuppressionToggle(_:isSuppressed:)-4hn2z"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","abstract":[],"title":"OpenSwiftUI","url":"\/documentation\/openswiftui","kind":"symbol","type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/ModifiedContent"