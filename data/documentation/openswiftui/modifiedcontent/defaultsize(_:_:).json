,"parameters":[{"name":"width","content":[{"inlineContent":[{"type":"text","text":"The default width for windows created from a scene."}],"type":"paragraph"}]},{"name":"height","content":[{"inlineContent":[{"type":"text","text":"The default height for windows created from a scene."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A scene that uses a default size for new windows."}]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this scene modifier to indicate a default initial size for a new"},{"type":"text","text":" "},{"type":"text","text":"window that the system creates from a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"},{"type":"text","text":" declaration. For"},{"type":"text","text":" "},{"type":"text","text":"example, you can request that new windows that a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup"},{"type":"text","text":" "},{"type":"text","text":"generates occupy 600 points in the x-dimension and 400 points in"},{"type":"text","text":" "},{"type":"text","text":"the y-dimension:"}]},{"type":"codeListing","syntax":null,"code":["@main","struct MyApp: App {","    var body: some Scene {","        WindowGroup {","            ContentView()","        }","        .defaultSize(width: 600, height: 400)","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The size that you specify acts only as a default for when the window","type":"text"},{"text":" ","type":"text"},{"text":"first appears. People can later resize the window using interface","type":"text"},{"text":" ","type":"text"},{"text":"controls that the system provides. Also, during state restoration,","type":"text"},{"text":" ","type":"text"},{"text":"the system restores windows to their most recent size rather than","type":"text"},{"text":" ","type":"text"},{"text":"the default size.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you specify a default size that’s outside the range of the window’s"},{"type":"text","text":" "},{"type":"text","text":"inherent resizability in one or both dimensions, the system clamps the"},{"type":"text","text":" "},{"type":"text","text":"affected dimension to keep it in range. You can configure the"},{"type":"text","text":" "},{"type":"text","text":"resizability of a scene using the "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/windowResizability(_:)","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"modifier."}]},{"type":"paragraph","inlineContent":[{"text":"The default size modifier affects any scene type that creates windows","type":"text"},{"text":" ","type":"text"},{"text":"in macOS, namely:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup","isActive":true}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"Window","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DocumentGroup"}]}]},{"content":[{"inlineContent":[{"code":"Settings","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you want to specify the size input in terms of size instance,"},{"type":"text","text":" "},{"type":"text","text":"use "},{"type":"codeVoice","code":"Scene\/defaultSize(_:)-5y8n"},{"type":"text","text":" instead."}]}]}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ModifiedContent"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},