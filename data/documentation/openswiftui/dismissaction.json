{"metadata":{"modules":[{"name":"OpenSwiftUI"}],"title":"DismissAction","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DismissAction"}],"externalID":"s:11OpenSwiftUI13DismissActionV","symbolKind":"struct","roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"DismissAction"}]},"abstract":[{"type":"text","text":"An action that dismisses a presentation."}],"sections":[],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"topicSections":[{"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction\/init(action:)"],"generated":true},{"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction\/callAsFunction()"],"generated":true},{"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction\/Equatable-Implementations"],"generated":true}],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/OpenSwiftUI\/s8CopyableP","doc:\/\/OpenSwiftUI\/SQ"]}],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DismissAction","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismiss","isActive":true,"type":"reference"},{"text":" environment value to get the instance","type":"text"},{"text":" ","type":"text"},{"text":"of this structure for a given ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","isActive":true,"type":"reference"},{"text":". Then call the instance","type":"text"},{"text":" ","type":"text"},{"text":"to perform the dismissal. You call the instance directly because","type":"text"},{"text":" ","type":"text"},{"text":"it defines a ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction\/callAsFunction()","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"method that Swift calls when you call the instance.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, you can create a button that calls the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":null,"code":["private struct SheetContents: View {","    @Environment(\\.dismiss) private var dismiss","","    var body: some View {","        Button(\"Done\") {","            dismiss()","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"If you present the ","type":"text"},{"code":"SheetContents","type":"codeVoice"},{"text":" view in a sheet, the user can dismiss","type":"text"},{"text":" ","type":"text"},{"text":"the sheet by tapping or clicking the sheet’s button:","type":"text"}]},{"type":"codeListing","syntax":null,"code":["private struct DetailView: View {","    @State private var isSheetPresented = false","","    var body: some View {","        Button(\"Show Sheet\") {","            isSheetPresented = true","        }","        .sheet(isPresented: $isSheetPresented) {","            SheetContents()","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Be sure that you define the action in the appropriate environment."},{"type":"text","text":" "},{"type":"text","text":"For example, don’t reorganize the "},{"type":"codeVoice","code":"DetailView"},{"type":"text","text":" in the example above"},{"type":"text","text":" "},{"type":"text","text":"so that it creates the "},{"type":"codeVoice","code":"dismiss"},{"type":"text","text":" property and calls it from the"},{"type":"text","text":" "},{"type":"codeVoice","code":"View\/sheet(item:onDismiss:content:)"},{"type":"text","text":" view modifier’s "},{"type":"codeVoice","code":"content"},{"type":"text","text":" "},{"type":"text","text":"closure:"}]},{"type":"codeListing","syntax":null,"code":["private struct DetailView: View {","    @State private var isSheetPresented = false","    @Environment(\\.dismiss) private var dismiss \/\/ Applies to DetailView.","","    var body: some View {","        Button(\"Show Sheet\") {","            isSheetPresented = true","        }","        .sheet(isPresented: $isSheetPresented) {","            Button(\"Done\") {","                dismiss() \/\/ Fails to dismiss the sheet.","            }","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you do this, the sheet fails to dismiss because the action applies"},{"type":"text","text":" "},{"type":"text","text":"to the environment where you declared it, which is that of the detail"},{"type":"text","text":" "},{"type":"text","text":"view, rather than the sheet. In fact, if you’ve presented the detail"},{"type":"text","text":" "},{"type":"text","text":"view in a "},{"code":"NavigationView","type":"codeVoice"},{"type":"text","text":", the dismissal pops the detail view"},{"type":"text","text":" "},{"type":"text","text":"from the navigation stack."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The dismiss action has no effect on a view that isn’t currently"},{"type":"text","text":" "},{"type":"text","text":"presented. If you need to query whether OpenSwiftUI is currently presenting"},{"type":"text","text":" "},{"type":"text","text":"a view, read the "},{"type":"codeVoice","code":"EnvironmentValues\/isPresented"},{"type":"text","text":" environment value."}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/dismissaction"]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/DismissAction/init(action:)":{"role":"symbol","type":"topic","title":"init(action:)","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction\/init(action:)","abstract":[],"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"action","kind":"externalParam"},{"text":": (() -> ","kind":"text"},{"text":"Void","preciseIdentifier":"s:s4Voida","kind":"typeIdentifier"},{"text":")?)","kind":"text"}],"url":"\/documentation\/openswiftui\/dismissaction\/init(action:)"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Environment":{"kind":"symbol","title":"Environment","url":"\/documentation\/openswiftui\/environment","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Environment","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"Environment","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","abstract":[{"text":"A property wrapper that reads a value from a view’s environment.","type":"text"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/DismissAction":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction","title":"DismissAction","url":"\/documentation\/openswiftui\/dismissaction","kind":"symbol","abstract":[{"type":"text","text":"An action that dismisses a presentation."}],"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DismissAction"}],"navigatorTitle":[{"kind":"identifier","text":"DismissAction"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/DismissAction/Equatable-Implementations":{"type":"topic"