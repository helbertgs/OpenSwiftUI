{"abstract":[{"text":"An action that dismisses a presentation.","type":"text"}],"variants":[{"paths":["\/documentation\/openswiftui\/dismissaction"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/OpenSwiftUI\/s8CopyableP","doc:\/\/OpenSwiftUI\/SQ"],"type":"conformsTo"}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"kind":"symbol","metadata":{"roleHeading":"Structure","role":"symbol","symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DismissAction","kind":"identifier"}],"title":"DismissAction","externalID":"s:11OpenSwiftUI13DismissActionV","modules":[{"name":"OpenSwiftUI"}],"navigatorTitle":[{"text":"DismissAction","kind":"identifier"}]},"sections":[],"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction\/init(action:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Methods","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction\/callAsFunction()"],"generated":true,"anchor":"Instance-Methods"},{"title":"Default Implementations","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction\/Equatable-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DismissAction"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismiss","isActive":true},{"type":"text","text":" environment value to get the instance"},{"type":"text","text":" "},{"type":"text","text":"of this structure for a given "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","isActive":true},{"type":"text","text":". Then call the instance"},{"type":"text","text":" "},{"type":"text","text":"to perform the dismissal. You call the instance directly because"},{"type":"text","text":" "},{"type":"text","text":"it defines a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction\/callAsFunction()"},{"text":" ","type":"text"},{"text":"method that Swift calls when you call the instance.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, you can create a button that calls the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction","isActive":true},{"type":"text","text":":"}]},{"code":["private struct SheetContents: View {","    @Environment(\\.dismiss) private var dismiss","","    var body: some View {","        Button(\"Done\") {","            dismiss()","        }","    }","}"],"type":"codeListing","syntax":null},{"type":"paragraph","inlineContent":[{"text":"If you present the ","type":"text"},{"code":"SheetContents","type":"codeVoice"},{"text":" view in a sheet, the user can dismiss","type":"text"},{"text":" ","type":"text"},{"text":"the sheet by tapping or clicking the sheet’s button:","type":"text"}]},{"code":["private struct DetailView: View {","    @State private var isSheetPresented = false","","    var body: some View {","        Button(\"Show Sheet\") {","            isSheetPresented = true","        }","        .sheet(isPresented: $isSheetPresented) {","            SheetContents()","        }","    }","}"],"type":"codeListing","syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"Be sure that you define the action in the appropriate environment."},{"type":"text","text":" "},{"type":"text","text":"For example, don’t reorganize the "},{"type":"codeVoice","code":"DetailView"},{"type":"text","text":" in the example above"},{"type":"text","text":" "},{"type":"text","text":"so that it creates the "},{"type":"codeVoice","code":"dismiss"},{"type":"text","text":" property and calls it from the"},{"type":"text","text":" "},{"type":"codeVoice","code":"View\/sheet(item:onDismiss:content:)"},{"type":"text","text":" view modifier’s "},{"type":"codeVoice","code":"content"},{"type":"text","text":" "},{"type":"text","text":"closure:"}]},{"code":["private struct DetailView: View {","    @State private var isSheetPresented = false","    @Environment(\\.dismiss) private var dismiss \/\/ Applies to DetailView.","","    var body: some View {","        Button(\"Show Sheet\") {","            isSheetPresented = true","        }","        .sheet(isPresented: $isSheetPresented) {","            Button(\"Done\") {","                dismiss() \/\/ Fails to dismiss the sheet.","            }","        }","    }","}"],"type":"codeListing","syntax":null},{"type":"paragraph","inlineContent":[{"text":"If you do this, the sheet fails to dismiss because the action applies","type":"text"},{"text":" ","type":"text"},{"text":"to the environment where you declared it, which is that of the detail","type":"text"},{"text":" ","type":"text"},{"text":"view, rather than the sheet. In fact, if you’ve presented the detail","type":"text"},{"text":" ","type":"text"},{"text":"view in a ","type":"text"},{"type":"codeVoice","code":"NavigationView"},{"text":", the dismissal pops the detail view","type":"text"},{"text":" ","type":"text"},{"text":"from the navigation stack.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The dismiss action has no effect on a view that isn’t currently"},{"type":"text","text":" "},{"type":"text","text":"presented. If you need to query whether OpenSwiftUI is currently presenting"},{"type":"text","text":" "},{"type":"text","text":"a view, read the "},{"type":"codeVoice","code":"EnvironmentValues\/isPresented"},{"type":"text","text":" environment value."}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/DismissAction/callAsFunction()":{"url":"\/documentation\/openswiftui\/dismissaction\/callasfunction()","abstract":[{"type":"text","text":"Dismisses the view if it is currently presented."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"callAsFunction"},{"kind":"text","text":"()"}],"title":"callAsFunction()","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction\/callAsFunction()","type":"topic","role":"symbol","kind":"symbol"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/DismissAction":{"url":"\/documentation\/openswiftui\/dismissaction","role":"symbol","title":"DismissAction","abstract":[{"type":"text","text":"An action that dismisses a presentation."}],"kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction","navigatorTitle":[{"kind":"identifier","text":"DismissAction"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DismissAction"}],"type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/DismissAction/Equatable-Implementations":{"role":"collectionGroup","abstract":[],"title":"Equatable Implementations","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction\/Equatable-Implementations","type":"topic","kind":"article","url":"\/documentation\/openswiftui\/dismissaction\/equatable-implementations"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/EnvironmentValues/dismiss":{"url":"\/documentation\/openswiftui\/environmentvalues\/dismiss","abstract":[{"text":"An action that dismisses the current presentation.","type":"text"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenS