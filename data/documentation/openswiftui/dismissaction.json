{"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"topicSections":[{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction\/init(action:)"]},{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction\/callAsFunction()"]},{"title":"Default Implementations","generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction\/Equatable-Implementations"]}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/OpenSwiftUI\/s8CopyableP","doc:\/\/OpenSwiftUI\/SQ"]}],"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DismissAction"}]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"text":"Use the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentValues\/dismiss","type":"reference"},{"text":" environment value to get the instance","type":"text"},{"text":" ","type":"text"},{"text":"of this structure for a given ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","type":"reference"},{"text":". Then call the instance","type":"text"},{"text":" ","type":"text"},{"text":"to perform the dismissal. You call the instance directly because","type":"text"},{"text":" ","type":"text"},{"text":"it defines a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction\/callAsFunction()","type":"reference"},{"text":" ","type":"text"},{"text":"method that Swift calls when you call the instance.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For example, you can create a button that calls the ","type":"text"},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DismissAction","isActive":true},{"text":":","type":"text"}],"type":"paragraph"},{"code":["private struct SheetContents: View {","    @Environment(\\.dismiss) private var dismiss","","    var body: some View {","        Button(\"Done\") {","            dismiss()","        }","    }","}"],"type":"codeListing","syntax":null},{"inlineContent":[{"type":"text","text":"If you present the "},{"code":"SheetContents","type":"codeVoice"},{"type":"text","text":" view in a sheet, the user can dismiss"},{"type":"text","text":" "},{"type":"text","text":"the sheet by tapping or clicking the sheet’s button:"}],"type":"paragraph"},{"code":["private struct DetailView: View {","    @State private var isSheetPresented = false","","    var body: some View {","        Button(\"Show Sheet\") {","            isSheetPresented = true","        }","        .sheet(isPresented: $isSheetPresented) {","            SheetContents()","        }","    }","}"],"type":"codeListing","syntax":null},{"inlineContent":[{"text":"Be sure that you define the action in the appropriate environment.","type":"text"},{"text":" ","type":"text"},{"text":"For example, don’t reorganize the ","type":"text"},{"type":"codeVoice","code":"DetailView"},{"text":" in the example above","type":"text"},{"text":" ","type":"text"},{"text":"so that it creates the ","type":"text"},{"type":"codeVoice","code":"dismiss"},{"text":" property and calls it from the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"View\/sheet(item:onDismiss:content:)"},{"text":" view modifier’s ","type":"text"},{"type":"codeVoice","code":"content"},{"text":" ","type":"text"},{"text":"closure:","type":"text"}],"type":"paragraph"},{"code":["private struct DetailView: View {","    @State private var isSheetPresented = false","    @Environment(\\.dismiss) private var dismiss \/\/ Applies to DetailView.","","    var body: some View {","        Button(\"Show Sheet\") {","            isSheetPresented = true","        }","        .sheet(isPresented: $isSheetPresented) {","            Button(\"Done\") {","                dismiss() \/\/ Fails to dismiss the sheet.","            }","        }","    }","}"],"type":"codeListing","syntax":null},{"inlineContent":[{"text":"If you do this, the sheet fails to dismiss because the action applies","type":"text"},{"text":" ","type":"text"},{"text":"to the environment where you declared it, which is that of the detail","type":"text"},{"text":" ","type":"text"},{"text":"view, rather than the sheet. In fact, if you’ve presented the detail","type":"text"},{"text":" ","type":"text"},{"text":"view in a ","type":"text"},{"code":"NavigationView","type":"codeVoice"},{"text":", the dismissal pops the detail view","type":"text"},{"text":" ","type":"text"},{"text":"from the navigation stack.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The dismiss action has no effect on a view that isn’t currently","type":"text"},{"text":" ","type":"text"},{"text":"presented. If you need to query whether OpenSwiftUI is currently presenting","type":"text"},{"text":" ","type":"text"},{"text":"a view, read the ","type":"text"},{"code":"EnvironmentValues\/isPresented","type":"codeVoice"},{"text":" environment value.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"An action that dismisses a presentation."}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/dismissaction"]}],"metadata":{"title":"DismissAction","externalID":"s:11OpenSwiftUI13DismissActionV","roleHeading":"Structure","role":"symbol","modules":[{"