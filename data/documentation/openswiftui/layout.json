{"primaryContentSections":[{"declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Layout","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"You traditionally arrange views in your app’s user interface using built-in"},{"type":"text","text":" "},{"type":"text","text":"layout containers like "},{"code":"HStack","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Grid","type":"codeVoice"},{"type":"text","text":". If you need more complex"},{"type":"text","text":" "},{"type":"text","text":"layout behavior, you can define a custom layout container by creating a type"},{"type":"text","text":" "},{"type":"text","text":"that conforms to the "},{"code":"Layout","type":"codeVoice"},{"type":"text","text":" protocol and implementing its required"},{"type":"text","text":" "},{"type":"text","text":"methods:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/sizeThatFits(proposal:subviews:cache:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"reports the size of the composite layout view."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/placeSubviews(in:proposal:subviews:cache:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"assigns positions to the container’s subviews."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can define a basic layout type with only these two methods:"}]},{"type":"codeListing","code":["struct BasicVStack: Layout {","    func sizeThatFits(","        proposal: ProposedViewSize,","        subviews: Subviews,","        cache: inout ()","    ) -> CGSize {","        \/\/ Calculate and return the size of the layout container.","    }","","    func placeSubviews(","        in bounds: CGRect,","        proposal: ProposedViewSize,","        subviews: Subviews,","        cache: inout ()","    ) {","        \/\/ Tell each subview where to appear.","    }","}"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use your layout the same way you use a built-in layout"},{"type":"text","text":" "},{"type":"text","text":"container, by providing a "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ViewBuilder","isActive":true},{"type":"text","text":" with the list of subviews"},{"type":"text","text":" "},{"type":"text","text":"to arrange:"}]},{"type":"codeListing","code":["BasicVStack {","    Text(\"A Subview\")","    Text(\"Another Subview\")","}"],"syntax":null},{"text":"Support additional behaviors","type":"heading","anchor":"Support-additional-behaviors","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can optionally implement other protocol methods and properties to"},{"type":"text","text":" "},{"type":"text","text":"provide more layout container features:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Define explicit horizontal and vertical layout guides for the container by"},{"type":"text","text":" "},{"type":"text","text":"implementing "},{"type":"codeVoice","code":"explicitAlignment(of:in:proposal:subviews:cache:)-8ofeu"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"explicitAlignment(of:in:proposal:subviews:cache:)-3iqmu"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"respectively."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Establish the preferred spacing around the container by implementing"},{"type":"text","text":" "},{"type":"codeVoice","code":"spacing(subviews:cache:)-86z2e"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Indicate the axis of orientation for a container that has characteristics"},{"type":"text","text":" "},{"type":"text","text":"of a stack by implementing the "},{"type":"codeVoice","code":"layoutProperties-5rb5b"},{"type":"text","text":" static property."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Create and manage a cache to store computed values across different"},{"type":"text","text":" "},{"type":"text","text":"layout protocol calls by implementing "},{"type":"codeVoice","code":"makeCache(subviews:)-23agy"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The protocol provides default implementations for these symbols"},{"type":"text","text":" "},{"type":"text","text":"if you don’t implement them. See each method or property for details."}]},{"text":"Add input parameters","type":"heading","anchor":"Add-input-parameters","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can define parameters as inputs to the layout, like you might"},{"type":"text","text":" "},{"type":"text","text":"for a "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/View","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","code":["struct BasicVStack: Layout {","    var alignment: HorizontalAlignment","","    \/\/ ...","}"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set the parameters at the point where you instantiate the layout:"}]},{"type":"codeListing","code":["BasicVStack(alignment: .leading) {","    \/\/ ...","}"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the layout provides default values for its parameters, you can omit the"},{"type":"text","text":" "},{"type":"text","text":"parameters at the call site, but you might need to keep the parentheses"},{"type":"text","text":" "},{"type":"text","text":"after the name of the layout, depending on how you specify the defaults."},{"type":"text","text":" "},{"type":"text","text":"For example, suppose you set a default alignment for the basic stack in"},{"type":"text","text":" "},{"type":"text","text":"the parameter declaration:"}]},{"type":"codeListing","code":["struct BasicVStack: Layout {","    var alignment: HorizontalAlignment = .center","","    \/\/ ...","}"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"To instantiate this layout using the default center alignment, you don’t"},{"type":"text","text":" "},{"type":"text","text":"have to specify the alignment value, but you do need to add empty"},{"type":"text","text":" "},{"type":"text","text":"parentheses:"}]},{"type":"codeListing","code":["BasicVStack() {","    \/\/ ...","}"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Swift compiler requires the parentheses in this case because of how the"},{"type":"text","text":" "},{"type":"text","text":"layout protocol implements this call site syntax. Specifically, the layout’s"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/callAsFunction(_:)","isActive":true},{"type":"text","text":" method looks for an initializer with exactly zero"},{"type":"text","text":" "},{"type":"text","text":"input arguments when you omit the parentheses from the call site."},{"type":"text","text":" "},{"type":"text","text":"You can enable the simpler call site for a layout that doesn’t have an"},{"type":"text","text":" "},{"type":"text","text":"implicit initializer of this type by explicitly defining one:"}]},{"type":"codeListing","code":["init() {","    self.alignment = .center","}"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"For information about Swift initializers, see"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/docs.swift.org\/swift-book\/LanguageGuide\/Initialization.html","isActive":true},{"type":"text","text":" "},{"type":"text","text":"in "},{"type":"emphasis","inlineContent":[{"text":"The Swift Programming Language","type":"text"}]},{"type":"text","text":"."}]},{"text":"Interact with subviews through their proxies","type":"heading","anchor":"Interact-with-subviews-through-their-proxies","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"To perform layout, you need information about all of its subviews, which"},{"type":"text","text":" "},{"type":"text","text":"are the views that your container arranges. While your layout can’t"},{"type":"text","text":" "},{"type":"text","text":"interact directly with its subviews, it can access a set of subview proxies"},{"type":"text","text":" "},{"type":"text","text":"through the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/Subviews","isActive":true},{"type":"text","text":" collection that each protocol method receives as"},{"type":"text","text":" "},{"type":"text","text":"an input parameter. That type is an alias for the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutSubviews","isActive":true},{"type":"text","text":" "},{"type":"text","text":"collection type, which in turn contains "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutSubview","isActive":true},{"type":"text","text":" instances"},{"type":"text","text":" "},{"type":"text","text":"that are the subview proxies."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can get information about each subview from its proxy, like its"},{"type":"text","text":" "},{"type":"text","text":"dimensions and spacing preferences. This enables"},{"type":"text","text":" "},{"type":"text","text":"you to measure subviews before you commit to placing them. You also"},{"type":"text","text":" "},{"type":"text","text":"assign a position to each subview by calling its proxy’s"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutSubview\/place(at:anchor:proposal:)","isActive":true},{"type":"text","text":" method."},{"type":"text","text":" "},{"type":"text","text":"Call the method on each subview from within your implementation of the"},{"type":"text","text":" "},{"type":"text","text":"layout’s "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/placeSubviews(in:proposal:subviews:cache:)","isActive":true},{"type":"text","text":" method."}]},{"text":"Access layout values","type":"heading","anchor":"Access-layout-values","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Views have layout values that you set with view modifiers."},{"type":"text","text":" "},{"type":"text","text":"Layout containers can choose to condition their behavior accordingly."},{"type":"text","text":" "},{"type":"text","text":"For example, a built-in "},{"code":"HStack","type":"codeVoice"},{"type":"text","text":" allocates space to its subviews based"},{"type":"text","text":" "},{"type":"text","text":"in part on the priorities that you set with the "},{"code":"View\/layoutPriority(_:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"view modifier. Your layout container accesses this value for a subview by"},{"type":"text","text":" "},{"type":"text","text":"reading the proxy’s "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutSubview\/priority","isActive":true},{"type":"text","text":" property."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can also create custom layout values by creating a layout key."},{"type":"text","text":" "},{"type":"text","text":"Set a value on a view with the "},{"code":"View\/layoutValue(key:value:)","type":"codeVoice"},{"type":"text","text":" view"},{"type":"text","text":" "},{"type":"text","text":"modifier. Read the corresponding value from the subview’s proxy using the"},{"type":"text","text":" "},{"type":"text","text":"key as an index on the subview. For more information about creating,"},{"type":"text","text":" "},{"type":"text","text":"setting, and accessing custom layout values, see "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutValueKey","isActive":true},{"type":"text","text":"."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"topicSections":[{"generated":true,"anchor":"Associated-Types","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/Cache"],"title":"Associated Types"},{"generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/callAsFunction(_:)","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/explicitAlignment(of:in:proposal:subviews:cache:)-1jge4","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/explicitAlignment(of:in:proposal:subviews:cache:)-2hh6p","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/makeCache(subviews:)","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/placeSubviews(in:proposal:subviews:cache:)","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/sizeThatFits(proposal:subviews:cache:)","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/spacing(subviews:cache:)","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/updateCache(_:subviews:)"],"title":"Instance Methods"},{"generated":true,"anchor":"Type-Aliases","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/Subviews"],"title":"Type Aliases"},{"generated":true,"anchor":"Type-Properties","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/layoutProperties"],"title":"Type Properties"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout"},"sch