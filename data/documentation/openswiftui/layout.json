{"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"kind":"symbol","sections":[],"variants":[{"paths":["\/documentation\/openswiftui\/layout"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"A type that defines the geometry of a collection of views.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Layout","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"You traditionally arrange views in your app’s user interface using built-in","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"layout containers like "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/HStack"},{"type":"text","text":" and "},{"code":"Grid","type":"codeVoice"},{"text":". If you need more complex","type":"text"},{"text":" ","type":"text"},{"text":"layout behavior, you can define a custom layout container by creating a type","type":"text"},{"type":"text","text":" "},{"text":"that conforms to the ","type":"text"},{"type":"codeVoice","code":"Layout"},{"text":" protocol and implementing its required","type":"text"},{"type":"text","text":" "},{"text":"methods:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/sizeThatFits(proposal:subviews:cache:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"reports the size of the composite layout view."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/placeSubviews(in:proposal:subviews:cache:)"},{"type":"text","text":" "},{"type":"text","text":"assigns positions to the container’s subviews."}]}]}]},{"inlineContent":[{"type":"text","text":"You can define a basic layout type with only these two methods:"}],"type":"paragraph"},{"code":["struct BasicVStack: Layout {","    func sizeThatFits(","        proposal: ProposedViewSize,","        subviews: Subviews,","        cache: inout ()","    ) -> CGSize {","        \/\/ Calculate and return the size of the layout container.","    }","","    func placeSubviews(","        in bounds: CGRect,","        proposal: ProposedViewSize,","        subviews: Subviews,","        cache: inout ()","    ) {","        \/\/ Tell each subview where to appear.","    }","}"],"type":"codeListing","syntax":null},{"inlineContent":[{"type":"text","text":"Use your layout the same way you use a built-in layout"},{"type":"text","text":" "},{"type":"text","text":"container, by providing a "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ViewBuilder","isActive":true},{"type":"text","text":" with the list of subviews"},{"type":"text","text":" "},{"type":"text","text":"to arrange:"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["BasicVStack {","    Text(\"A Subview\")","    Text(\"Another Subview\")","}"]},{"level":3,"anchor":"Support-additional-behaviors","text":"Support additional behaviors","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"You can optionally implement other protocol methods and properties to","type":"text"},{"type":"text","text":" "},{"text":"provide more layout container features:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Define explicit horizontal and vertical layout guides for the container by"},{"type":"text","text":" "},{"type":"text","text":"implementing "},{"type":"codeVoice","code":"explicitAlignment(of:in:proposal:subviews:cache:)-8ofeu"},{"text":" ","type":"text"},{"type":"text","text":"and "},{"type":"codeVoice","code":"explicitAlignment(of:in:proposal:subviews:cache:)-3iqmu"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"respectively."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Establish the preferred spacing around the container by implementing"},{"text":" ","type":"text"},{"code":"spacing(subviews:cache:)-86z2e","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Indicate the axis of orientation for a container that has characteristics"},{"type":"text","text":" "},{"type":"text","text":"of a stack by implementing the "},{"type":"codeVoice","code":"layoutProperties-5rb5b"},{"type":"text","text":" static property."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create and manage a cache to store computed values across different"},{"type":"text","text":" "},{"type":"text","text":"layout protocol calls by implementing "},{"code":"makeCache(subviews:)-23agy","type":"codeVoice"},{"type":"text","text":"."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The protocol provides default implementations for these symbols"},{"type":"text","text":" "},{"type":"text","text":"if you don’t implement them. See each method or property for details."}]},{"type":"heading","level":3,"text":"Add input parameters","anchor":"Add-input-parameters"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can define parameters as inputs to the layout, like you might"},{"type":"text","text":" "},{"type":"text","text":"for a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/View"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":null,"code":["struct BasicVStack: Layout {","    var alignment: HorizontalAlignment","","    \/\/ ...","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set the parameters at the point where you instantiate the layout:"}]},{"type":"codeListing","syntax":null,"code":["BasicVStack(alignment: .leading) {","    \/\/ ...","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the layout provides default values for its parameters, you can omit the"},{"type":"text","text":" "},{"type":"text","text":"parameters at the call site, but you might need to keep the parentheses"},{"type":"text","text":" "},{"type":"text","text":"after the name of the layout, depending on how you specify the defaults."},{"type":"text","text":" "},{"type":"text","text":"For example, suppose you set a default alignment for the basic stack in"},{"type":"text","text":" "},{"type":"text","text":"the parameter declaration:"}]},{"type":"codeListing","syntax":null,"code":["struct BasicVStack: Layout {","    var alignment: HorizontalAlignment = .center","","    \/\/ ...","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To instantiate this layout using the default center alignment, you don’t"},{"type":"text","text":" "},{"type":"text","text":"have to specify the alignment value, but you do need to add empty"},{"type":"text","text":" "},{"type":"text","text":"parentheses:"}]},{"type":"codeListing","syntax":null,"code":["BasicVStack() {","    \/\/ ...","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Swift compiler requires the parentheses in this case because of how the"},{"type":"text","text":" "},{"type":"text","text":"layout protocol implements this call site syntax. Specifically, the layout’s"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/callAsFunction(_:)"},{"type":"text","text":" method looks for an initializer with exactly zero"},{"type":"text","text":" "},{"type":"text","text":"input arguments when you omit the parentheses from the call site."},{"type":"text","text":" "},{"type":"text","text":"You can enable the simpler call site for a layout that doesn’t have an"},{"type":"text","text":" "},{"type":"text","text":"implicit initializer of this type by explicitly defining one:"}]},{"type":"codeListing","syntax":null,"code":["init() {","    self.alignment = .center","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For information about Swift initializers, see"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/docs.swift.org\/swift-book\/LanguageGuide\/Initialization.html"},{"type":"text","text":" "},{"type":"text","text":"in "},{"inlineContent":[{"text":"The Swift Programming Language","type":"text"}],"type":"emphasis"},{"type":"text","text":"."}]},{"type":"heading","level":3,"text":"Interact with subviews through their proxies","anchor":"Interact-with-subviews-through-their-proxies"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To perform layout, you need information about all of its subviews, which"},{"type":"text","text":" "},{"type":"text","text":"are the views that your container arranges. While your layout can’t"},{"type":"text","text":" "},{"type":"text","text":"interact directly with its subviews, it can access a set of subview proxies"},{"type":"text","text":" "},{"type":"text","text":"through the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/Subviews"},{"type":"text","text":" collection that each protocol method receives as"},{"type":"text","text":" "},{"type":"text","text":"an input parameter. That type is an alias for the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutSubviews"},{"type":"text","text":" "},{"type":"text","text":"collection type, which in turn contains "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutSubview"},{"type":"text","text":" instances"},{"type":"text","text":" "},{"type":"text","text":"that are the subview proxies."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can get information about each subview from its proxy, like its"},{"type":"text","text":" "},{"type":"text","text":"dimensions and spacing preferences. This enables"},{"type":"text","text":" "},{"type":"text","text":"you to measure subviews before you commit to placing them. You also"},{"type":"text","text":" "},{"type":"text","text":"assign a position to each subview by calling its proxy’s"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutSubview\/place(at:anchor:proposal:)"},{"type":"text","text":" method."},{"type":"text","text":" "},{"type":"text","text":"Call the method on each subview from within your implementation of the"},{"type":"text","text":" "},{"type":"text","text":"layout’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/placeSubviews(in:proposal:subviews:cache:)"},{"type":"text","text":" method."}]},{"type":"heading","level":3,"text":"Access layout values","anchor":"Access-layout-values"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Views have layout values that you set with view modifiers."},{"type":"text","text":" "},{"type":"text","text":"Layout containers can choose to condition their behavior accordingly."},{"type":"text","text":" "},{"type":"text","text":"For example, a built-in "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/HStack"},{"type":"text","text":" allocates space to its subviews based"},{"type":"text","text":" "},{"type":"text","text":"in part on the priorities that you set with the "},{"code":"View\/layoutPriority(_:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"view modifier. Your layout container accesses this value for a subview by"},{"type":"text","text":" "},{"type":"text","text":"reading the proxy’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutSubview\/priority"},{"type":"text","text":" property."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can also create custom layout values by creating a layout key."},{"type":"text","text":" "},{"type":"text","text":"Set a value on a view with the "},{"code":"View\/layoutValue(key:value:)","type":"codeVoice"},{"type":"text","text":" view"},{"type":"text","text":" "},{"type":"text","text":"modifier. Read the corresponding value from the subview’s proxy using the"},{"type":"text","text":" "},{"type":"text","text":"key as an index on the subview. For more information about creating,"},{"type":"text","text":" "},{"type":"text","text":"setting, and accessing custom layout values, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutValueKey"},{"type":"text","text":"."}]}],"kind":"content"}],"metadata":{"navigatorTitle":[{"text":"Layout","kind":"identifier"}],"title":"Layout","role":"symbol","symbolKind":"protocol","roleHeading":"Protocol","externalID":"s:11OpenSwiftUI6LayoutP","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Layout","kind":"identifier"}],"modules":[{"name":"OpenSwiftUI"}]},"relationshipsSections":[{"kind":"relationships","title":"Conforming Types","type":"conformingTypes","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/HStackLayout","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/VStackLayout"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout"},"schemaVersion":{"patch":0,"minor":3,"major":0},"topicSections":[{"title":"Associated Types","generated":true,"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/Cache"],"anchor":"Associated-Types"},{"title":"Instance Methods","generated":true,"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/callAsFunction(_:)","doc:\/\/OpenSwi