ctive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ViewBuilder","type":"reference"},{"text":" with the list of subviews","type":"text"},{"text":" ","type":"text"},{"text":"to arrange:","type":"text"}]},{"syntax":null,"code":["BasicVStack {","    Text(\"A Subview\")","    Text(\"Another Subview\")","}"],"type":"codeListing"},{"level":3,"text":"Support additional behaviors","type":"heading","anchor":"Support-additional-behaviors"},{"inlineContent":[{"text":"You can optionally implement other protocol methods and properties to","type":"text"},{"text":" ","type":"text"},{"text":"provide more layout container features:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Define explicit horizontal and vertical layout guides for the container by"},{"type":"text","text":" "},{"type":"text","text":"implementing "},{"code":"explicitAlignment(of:in:proposal:subviews:cache:)-8ofeu","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"explicitAlignment(of:in:proposal:subviews:cache:)-3iqmu","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"respectively."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Establish the preferred spacing around the container by implementing"},{"type":"text","text":" "},{"code":"spacing(subviews:cache:)-86z2e","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Indicate the axis of orientation for a container that has characteristics"},{"type":"text","text":" "},{"type":"text","text":"of a stack by implementing the "},{"code":"layoutProperties-5rb5b","type":"codeVoice"},{"type":"text","text":" static property."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create and manage a cache to store computed values across different"},{"type"