{"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"abstract":[{"text":"A type that defines the geometry of a collection of views.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/layout"]}],"topicSections":[{"title":"Associated Types","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/Cache"],"generated":true,"anchor":"Associated-Types"},{"title":"Instance Methods","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/callAsFunction(_:)","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/explicitAlignment(of:in:proposal:subviews:cache:)-1jge4","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/explicitAlignment(of:in:proposal:subviews:cache:)-2hh6p","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/makeCache(subviews:)","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/placeSubviews(in:proposal:subviews:cache:)","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/sizeThatFits(proposal:subviews:cache:)","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/spacing(subviews:cache:)","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/updateCache(_:subviews:)"],"generated":true,"anchor":"Instance-Methods"},{"title":"Type Aliases","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/Subviews"],"generated":true,"anchor":"Type-Aliases"},{"title":"Type Properties","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/layoutProperties"],"generated":true,"anchor":"Type-Properties"}],"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Layout"}]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"inlineContent":[{"type":"text","text":"You traditionally arrange views in your app’s user interface using built-in"},{"type":"text","text":" "},{"type":"text","text":"layout containers like "},{"type":"codeVoice","code":"HStack"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Grid"},{"type":"text","text":". If you need more complex"},{"type":"text","text":" "},{"type":"text","text":"layout behavior, you can define a custom layout container by creating a type"},{"type":"text","text":" "},{"type":"text","text":"that conforms to the "},{"code":"Layout","type":"codeVoice"},{"text":" protocol and implementing its required","type":"text"},{"text":" ","type":"text"},{"text":"methods:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/sizeThatFits(proposal:subviews:cache:)"},{"text":" ","type":"text"},{"text":"reports the size of the composite layout view.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/placeSubviews(in:proposal:subviews:cache:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"assigns positions to the container’s subviews."}]}]}]},{"inlineContent":[{"text":"You can define a basic layout type with only these two methods:","type":"text"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["struct BasicVStack: Layout {","    func sizeThatFits(","        proposal: ProposedViewSize,","        subviews: Subviews,","        cache: inout ()","    ) -> CGSize {","        \/\/ Calculate and return the size of the layout container.","    }","","    func placeSubviews(","        in bounds: CGRect,","        proposal: ProposedViewSize,","        subviews: Subviews,","        cache: inout ()","    ) {","        \/\/ Tell each subview where to appear.","    }","}"]},{"inlineContent":[{"type":"text","text":"Use your layout the same way you use a built-in layout"},{"type":"text","text":" "},{"type":"text","text":"container, by providing a "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ViewBuilder","isActive":true},{"type":"text","text":" with the list of subviews"},{"type":"text","text":" "},{"type":"text","text":"to arrange:"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["BasicVStack {","    Text(\"A Subview\")","    Text(\"Another Subview\")","}"]},{"type":"heading","text":"Support additional behaviors","anchor":"Support-additional-behaviors","level":3},{"inlineContent":[{"type":"text","text":"You can optionally implement other protocol methods and properties to"},{"type":"text","text":" "},{"type":"text","text":"provide more layout container features:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Define explicit horizontal and vertical layout guides for the container by"},{"type":"text","text":" "},{"type":"text","text":"implementing "},{"type":"codeVoice","code":"explicitAlignment(of:in:proposal:subviews:cache:)-8ofeu"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"explicitAlignment(of:in:proposal:subviews:cache:)-3iqmu"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"respectively."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Establish the preferred spacing around the container by implementing","type":"text"},{"text":" ","type":"text"},{"code":"spacing(subviews:cache:)-86z2e","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Indicate the axis of orientation for a container that has characteristics"},{"type":"text","text":" "},{"type":"text","text":"of a stack by implementing the "},{"type":"codeVoice","code":"layoutProperties-5rb5b"},{"type":"text","text":" static property."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Create and manage a cache to store computed values across different"},{"type":"text","text":" "},{"type":"text","text":"layout protocol calls by implementing "},{"code":"makeCache(subviews:)-23agy","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"The protocol provides default implementations for these symbols","type":"text"},{"text":" ","type":"text"},{"text":"if you don’t implement them. See each method or property for details.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Add input parameters","anchor":"Add-input-parameters","level":3},{"inlineContent":[{"text":"You can define parameters as inputs to the layout, like you might","type":"text"},{"text":" ","type":"text"},{"text":"for a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/View"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["struct BasicVStack: Layout {","    var alignment: HorizontalAlignment","","    \/\/ ...","}"]},{"inlineContent":[{"text":"Set the parameters at the point where you instantiate the layout:","type":"text"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["BasicVStack(alignment: .leading) {","    \/\/ ...","}"]},{"inlineContent":[{"type":"text","text":"If the layout provides default values for its parameters, you can omit the"},{"type":"text","text":" "},{"type":"text","text":"parameters at the call site, but you might need to keep the parentheses"},{"type":"text","text":" "},{"type":"text","text":"after the name of the layout, depending on how you specify the defaults."},{"type":"text","text":" "},{"type":"text","text":"For example, suppose you set a default alignment for the basic stack in"},{"type":"text","text":" "},{"type":"text","text":"the parameter declaration:"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["struct BasicVStack: Layout {","    var alignment: HorizontalAlignment = .center","","    \/\/ ...","}"]},{"inlineContent":[{"type":"text","text":"To instantiate this layout using the default center alignment, you don’t"},{"type":"text","text":" "},{"type":"text","text":"have to specify the alignment value, but you do need to add empty"},{"type":"text","text":" "},{"type":"text","text":"parentheses:"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["BasicVStack() {","    \/\/ ...","}"]},{"inlineContent":[{"type":"text","text":"The Swift compiler requires the parentheses in this case because of how the"},{"type":"text","text":" "},{"type":"text","text":"layout protocol implements this call site syntax. Specifically, the layout’s"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/callAsFunction(_:)","isActive":true},{"type":"text","text":" method looks for an initializer with exactly zero"},{"type":"text","text":" "},{"type":"text","text":"input arguments when you omit the parentheses from the call site."},{"type":"text","text":" "},{"type":"text","text":"You can enable the simpler call site for a layout that doesn’t have an"},{"type":"text","text":" "},{"type":"text","text":"implicit initializer of this type by explicitly defining one:"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["init() {","    self.alignment = .center","}"]},{"inlineContent":[{"type":"text","text":"For information about Swift initializers, see"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/docs.swift.org\/swift-book\/LanguageGuide\/Initialization.html"},{"type":"text","text":" "},{"type":"text","text":"in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"The Swift Programming Language"}]},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","text":"Interact with subviews through their proxies","anchor":"Interact-with-subviews-through-their-proxies","level":3},{"inlineContent":[{"type":"text","text":"To perform layout, you need information about all of its subviews, which"},{"type":"text","text":" "},{"type":"text","text":"are the views that your container arranges. While your layout can’t"},{"type":"text","text":" "},{"type":"text","text":"interact directly with its subviews, it can access a set of subview proxies"},{"type":"text","text":" "},{"type":"text","text":"through the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/Subviews","isActive":true},{"type":"text","text":" collection that each protocol method receives as"},{"type":"text","text":" "},{"type":"text","text":"an input parameter. That type is an alias for the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutSubviews","isActive":true},{"type":"text","text":" "},{"type":"text","text":"collection type, which in turn contains "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutSubview","isActive":true},{"type":"text","text":" instances"},{"type":"text","text":" "},{"type":"text","text":"that are the subview proxies."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can get information about each subview from its proxy, like its"},{"type":"text","text":" "},{"type":"text","text":"dimensions and spacing preferences. This enables"},{"type":"text","text":" "},{"type":"text","text":"you to measure subviews before you commit to placing them. You also"},{"type":"text","text":" "},{"type":"text","text":"assign a position to each subview by calling its proxy’s"},{"type":"text","text":" "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutSubview\/place(at:anchor:proposal:)","type":"reference","isActive":true},{"type":"text","text":" method."},{"type":"text","text":" "},{"text":"Call the method on each subview from within your implementation of the","type":"text"},{"text":" ","type":"text"},{"text":"layout’s ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/placeSubviews(in:proposal:subviews:cache:)"},{"text":" method.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Access layout values","anchor":"Access-layout-values","level":3},{"inlineContent":[{"type":"text","text":"Views have layout values that you set with view modifiers."},{"type":"text","text":" "},{"type":"text","text":"Layout containers can choose to condition their behavior accordingly."},{"type":"text","text":" "},{"type":"text","text":"For example, a built-in "},{"type":"codeVoice","code":"HStack"},{"type":"text","text":" allocates space to its subviews based"},{"type":"text","text":" "},{"type":"text","text":"in part on the priorities that you set with the "},{"type":"codeVoice","code":"View\/layoutPriority(_:)"},{"type":"text","text":" "},{"type":"text","text":"view modifier. Your layout container accesses this value for a subview by"},{"type":"text","text":" "},{"type":"text","text":"reading the proxy’s "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutSubview\/priority"},{"type":"text","text":" property."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can also create custom layout values by creating a layout key."},{"type":"text","text":" "},{"type":"text","text":"Set a value on a view with the "},{"type":"codeVoice","code":"View\/layoutValue(key:value:)"},{"type":"text","text":" view"},{"type":"text","text":" "},{"type":"text","text":"modifier. Read the corresponding value from the subview’s proxy using the"},{"type":"text","text":" "},{"type":"text","text":"key as an index on the subview. For more information about creating,"},{"type":"text","text":" "},{"type":"text","text":"setting, and accessing custom layout values, see "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LayoutValueKey","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"navigatorTitle":[{"text":"Layout","kind":"identifier"}],"role":"symbol","title":"Layout","externalID":"s:11OpenSwiftUI6LayoutP","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Layout","kind":"identifier"}],"symbolKind":"protocol","modules":[{"name":"OpenSwiftUI"}],"roleHeading":"Protocol"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Layout/placeSubviews(in:proposal:subviews:cache:)":{"title":"placeSubviews(in:proposal:subviews:cache:)","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout\/placeSubviews(in:proposal:subviews:cache:)","url":"\/documentation\/openswiftui\/layout\/placesubviews(in:proposal:subviews:cache:)","role":"symbol","abstract":[{"text":"Assigns positions to each of the layout’s subviews.","type":"text"}],"type":"topic","required":true,"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"placeSubviews"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI4RectV","text":"Rect"},{"kind":"text","text":", "},{"kind":"externalParam","text":"proposal"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI16ProposedViewSizeV","text":"ProposedViewSize"},{"kind":"text","text":", "},{"kind":"externalParam","text":"subviews"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI6LayoutP8Subviewsa","text":"Subviews"},{"kind":"text","text":", "},{"kind":"externalParam","text":"cache"},{"kind":"text","text":": 