 part of an app’s user interface with a life cycle managed by the"},{"type":"text","text":" "},{"type":"text","text":"system."}],"type":"topic","title":"Scene","url":"\/documentation\/openswiftui\/scene","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scene"}],"navigatorTitle":[{"kind":"identifier","text":"Scene"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"title":"OpenSwiftUI","abstract":[],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","type":"topic","url":"\/documentation\/openswiftui","kind":"symbol","role":"collection"}}}