{"variants":[{"paths":["\/documentation\/openswiftui\/windowgroup\/handlesexternalevents(matching:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","metadata":{"externalID":"s:11OpenSwiftUI5ScenePAAE21handlesExternalEvents8matchingQrShySSG_tF::SYNTHESIZED::s:11OpenSwiftUI11WindowGroupV","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"handlesExternalEvents"},{"kind":"text","text":"("},{"kind":"externalParam","text":"matching"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Set","preciseIdentifier":"s:Sh"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":">) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP"}],"symbolKind":"method","title":"handlesExternalEvents(matching:)","role":"symbol","modules":[{"name":"OpenSwiftUI"}],"extendedModule":"OpenSwiftUI","roleHeading":"Instance Method"},"sections":[],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"handlesExternalEvents"},{"kind":"text","text":"("},{"kind":"externalParam","text":"matching"},{"kind":"text","text":" "},{"kind":"internalParam","text":"conditions"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sh","text":"Set"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":">) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP","text":"Scene"},{"kind":"text","text":"\n"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This modifier is only supported for WindowGroup Scene types."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For DocumentGroups, the received External Event must have a URL"},{"type":"text","text":" "},{"type":"text","text":"for the DocumentGroup to be considered. (Either via openURL, or"},{"type":"text","text":" "},{"type":"text","text":"the webPageURL property of an NSUserActivity). The UTI for the URL"},{"type":"text","text":" "},{"type":"text","text":"is implicitly matched against the DocumentGroup’s supported types."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the modifier evaluates to true, an instance of the"},{"type":"text","text":" "},{"type":"text","text":"Scene will be used."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the modifier evaluates to false, on macOS the Scene"},{"type":"text","text":" "},{"type":"text","text":"will not be used even if no other Scenes are available."},{"type":"text","text":" "},{"type":"text","text":"This case is considered an error. On iOS, the first Scene"},{"type":"text","text":" "},{"type":"text","text":"specified in the body property for the App will be used."}]},{"type":"paragraph","inlineContent":[{"text":"If no modifier is set, the Scene will be used if all","type":"text"},{"text":" ","type":"text"},{"text":"other WindowGroups with a modifier evaluate to false.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"On platforms that only allow a single Window\/Scene, this method is","type":"text"},{"text":" ","type":"text"},{"text":"ignored.","type":"text"}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup\/handlesExternalEvents(matching:)"},"schemaVersion":{"minor":3,"major":0,"patch":0},