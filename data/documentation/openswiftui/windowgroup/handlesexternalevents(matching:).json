{"abstract":[{"type":"text","text":"Specifies a modifier to indicate if this Scene can be used"},{"type":"text","text":" "},{"type":"text","text":"when creating a new Scene for the received External Event."}],"metadata":{"modules":[{"name":"OpenSwiftUI"}],"title":"handlesExternalEvents(matching:)","extendedModule":"OpenSwiftUI","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"handlesExternalEvents","kind":"identifier"},{"text":"(","kind":"text"},{"text":"matching","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Set","kind":"typeIdentifier","preciseIdentifier":"s:Sh"},{"text":"<","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":">) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5SceneP"}],"role":"symbol","roleHeading":"Instance Method","externalID":"s:11OpenSwiftUI5ScenePAAE21handlesExternalEvents8matchingQrShySSG_tF::SYNTHESIZED::s:11OpenSwiftUI11WindowGroupV","symbolKind":"method"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup\/handlesExternalEvents(matching:)"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"handlesExternalEvents"},{"kind":"text","text":"("},{"kind":"externalParam","text":"matching"},{"kind":"text","text":" "},{"kind":"internalParam","text":"conditions"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sh","text":"Set"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":">) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP","text":"Scene"},{"kind":"text","text":"\n"}]}]},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This modifier is only supported for WindowGroup Scene types."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For DocumentGroups, the received External Event must have a URL"},{"type":"text","text":" "},{"type":"text","text":"for the DocumentGroup to be considered. (Either via openURL, or"},{"type":"text","text":" "},{"type":"text","text":"the webPageURL property of an NSUserActivity). The UTI for the URL"},{"type":"text","text":" "},{"type":"text","text":"is implicitly matched against the DocumentGroup’s supported types."}]},{"type":"paragraph","inlineContent":[{"text":"If the modifier evaluates to true, an instance of the","type":"text"},{"text":" ","type":"text"},{"text":"Scene will be used.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the modifier evaluates to false, on macOS the Scene"},{"type":"text","text":" "},{"type":"text","text":"will not be used even if no other Scenes are available."},{"type":"text","text":" "},{"type":"text","text":"This case is considered an error. On iOS, the first Scene"},{"type":"text","text":" "},{"type":"text","text":"specified in the body property for the App will be used."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If no modifier is set, the Scene will be used if all"},{"type":"text","text":" "},{"type":"text","text":"other WindowGroups with a modifier evaluate to false."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On platforms that only allow a single Window\/Scene, this method is"},{"type":"text","text":" "},{"type":"text","text":"ignored."}]}],"kind":"content"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/windowgroup\/handlesexternalevents(matching:)"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup"]]},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","title":"OpenSwiftUI","abstract":[],"type":"topic","kind":"symbol","url":"\/documentation\/openswiftui","role":"collection"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/WindowGroup":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WindowGroup"}],"type":"topic","title":"WindowGroup","abstract":[{"text":"A scene that presents a group of identically structured windows.","type":"text"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"WindowGroup"}],"url":"\/documentation\/openswiftui\/windowgroup","role":"symbol"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/WindowGroup/handlesExternalEvents(matching:)":{"title":"handlesExternalEvents(matching:)","abstract":[{"type":"text","text":"Specifies a modifier to indicate if this Scene can be used"},{"type":"text","text":" "},{"type":"text","text":"when creating a new Scene for the received External Event."}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup\/handlesExternalEvents(matching:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"handlesExternalEvents"},{"kind":"text","text":"("},{"kind":"externalParam","text":"matching"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sh","text":"Set"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":">) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwi