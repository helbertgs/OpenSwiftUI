{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"handlesExternalEvents"},{"kind":"text","text":"("},{"kind":"externalParam","text":"matching"},{"kind":"text","text":" "},{"kind":"internalParam","text":"conditions"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sh","text":"Set"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":">) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5SceneP","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","text":"Scene"},{"kind":"text","text":"\n"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This modifier is only supported for WindowGroup Scene types."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For DocumentGroups, the received External Event must have a URL"},{"type":"text","text":" "},{"type":"text","text":"for the DocumentGroup to be considered. (Either via openURL, or"},{"type":"text","text":" "},{"type":"text","text":"the webPageURL property of an NSUserActivity). The UTI for the URL"},{"type":"text","text":" "},{"type":"text","text":"is implicitly matched against the DocumentGroup’s supported types."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the modifier evaluates to true, an instance of the"},{"type":"text","text":" "},{"type":"text","text":"Scene will be used."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the modifier evaluates to false, on macOS the Scene"},{"type":"text","text":" "},{"type":"text","text":"will not be used even if no other Scenes are available."},{"type":"text","text":" "},{"type":"text","text":"This case is considered an error. On iOS, the first Scene"},{"type":"text","text":" "},{"type":"text","text":"specified in the body property for the App will be used."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If no modifier is set, the Scene will be used if all"},{"type":"text","text":" "},{"type":"text","text":"other WindowGroups with a modifier evaluate to false."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On platforms that only allow a single Window\/Scene, this method is"},{"type":"text","text":" "},{"type":"text","text":"ignored."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup"]]},"kind":"symbol","abstract":[{"text":"Specifies a modifier to indicate if this Scene can be used","type":"text"},{"text":" ","type":"text"},{"text":"when creating a new Scene for the received External Event.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"extendedModule":"OpenSwiftUI","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"handlesExternalEvents"},{"kind":"text","text":"("},{"kind":"externalParam","text":"matching"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sh","kind":"typeIdentifier","text":"Set"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":">) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","kind":"typeIdentifier","text":"Scene"}],"title":"handlesExternalEvents(matching:)","symbolKind":"method","modules":[{"name":"OpenSwiftUI"}],"role":"symbol","externalID":"s:11OpenSwiftUI5ScenePAAE21handlesExternalEvents8matchingQrShySSG_tF::SYNTHESIZED::s:11OpenSwiftUI11WindowGroupV"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/wi