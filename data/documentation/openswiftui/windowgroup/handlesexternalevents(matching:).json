tent":[{"text":"This modifier is only supported for WindowGroup Scene types.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For DocumentGroups, the received External Event must have a URL","type":"text"},{"text":" ","type":"text"},{"text":"for the DocumentGroup to be considered. (Either via openURL, or","type":"text"},{"text":" ","type":"text"},{"text":"the webPageURL property of an NSUserActivity). The UTI for the URL","type":"text"},{"text":" ","type":"text"},{"text":"is implicitly matched against the DocumentGroup’s supported types.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If the modifier evaluates to true, an instance of the","type":"text"},{"text":" ","type":"text"},{"text":"Scene will be used.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the modifier evaluates to false, on macOS the Scene"},{"type":"text","text":" "},{"type":"text","text":"will not be used even if no other Scenes are available."},{"type":"text","text":" "},{"type":"text","text":"This case is considered an error. On iOS, the first Scene"},{"type":"text","text":" "},{"type":"text","text":"specified in the body property for the App will be used."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If no modifier is set, the Scene will be used if all"},{"type":"text","text":" "},{"type":"text","text":"other WindowGroups with a modifier evaluate to false."}]},{"type":"paragraph","inlineContent":[{"text":"On platforms that only allow a single Window\/Scene, this method is","type":"text"},{"text":" ","type":"text"},{"text":"ignored.","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/openswiftui\/windowgroup\/handlesexternalevents(matching:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"abstract":[{"type":"text","text":"Specifies a modifier to indicate if this Scene can be used"},{"type":"text","text":" "},{"type":"text","text":"when creating a 