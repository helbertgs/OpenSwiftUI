{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup\/defaultPosition(_:)"},"abstract":[{"text":"Sets a default position for a window.","type":"text"}],"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"extendedModule":"OpenSwiftUI","externalID":"s:11OpenSwiftUI5ScenePAAE15defaultPositionyQrAA9UnitPointVF::SYNTHESIZED::s:11OpenSwiftUI11WindowGroupV","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultPosition","kind":"identifier"},{"text":"(","kind":"text"},{"text":"UnitPoint","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI9UnitPointV"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5SceneP"}],"roleHeading":"Instance Method","role":"symbol","symbolKind":"method","title":"defaultPosition(_:)","modules":[{"name":"OpenSwiftUI"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultPosition","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"position","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"UnitPoint","kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint","preciseIdentifier":"s:11OpenSwiftUI9UnitPointV"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP"},{"text":"\n","kind":"text"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"position","content":[{"inlineContent":[{"text":"A ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint"},{"text":" that specifies where to place a","type":"text"},{"text":" ","type":"text"},{"text":"newly opened window relative to the screen bounds.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","anchor":"return-value","text":"Return Value","level":2},{"type":"paragraph","inlineContent":[{"text":"A scene that uses a default position for new windows.","type":"text"}]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The first time your app opens a window from a particular scene"},{"type":"text","text":" "},{"type":"text","text":"declaration, the system places the window at the center of the screen by"},{"type":"text","text":" "},{"type":"text","text":"default. For scene types that support multiple simultaneous windows, the"},{"type":"text","text":" "},{"type":"text","text":"system offsets each additional window by a small amount to avoid"},{"type":"text","text":" "},{"type":"text","text":"completely obscuring existing windows."}]},{"type":"paragraph","inlineContent":[{"text":"You can override the default placement of the first window by","type":"text"},{"text":" ","type":"text"},{"text":"applying a scene modifier that indicates where to place the window","type":"text"},{"text":" ","type":"text"},{"text":"relative to the screen bounds. For example, you can request that the","type":"text"},{"text":" ","type":"text"},{"text":"system place a new window in the bottom trailing corner of the screen:","type":"text"}]},{"type":"codeListing","code":["@main","struct MyApp: App {","    var body: some Scene {","        WindowGroup {","            ContentView()","        }","        .defaultPosition(.bottomTrailing)","    }","}"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"The system aligns the point in the window that corresponds to the"},{"type":"text","text":" "},{"type":"text","text":"specified "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint","isActive":true,"type":"reference"},{"type":"text","text":" with the point in the screen that corresponds"},{"type":"text","text":" "},{"type":"text","text":"to the same unit point."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You typically use one of the predefined unit points — like"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/bottomTrailing"},{"type":"text","text":" in the above example — but"},{"type":"text","text":" "},{"type":"text","text":"you can also use a custom unit point. For example, the following"},{"type":"text","text":" "},{"type":"text","text":"modifier aligns the point that’s one quarter of the way from the"},{"type":"text","text":" "},{"type":"text","text":"leading edge of the window with the point that’s one quarter of"},{"type":"text","text":" "},{"type":"text","text":"the way from the leading edge of the screen, while centering the"},{"type":"text","text":" "},{"type":"text","text":"window in the y-dimension:"}]},{"type":"codeListing","code":["WindowGroup {","    ContentView()","}",".defaultPosition(UnitPoint(x: 0.25, y: 0.5))"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"The modifier affects any scene type that creates windows in macOS,"},{"type":"text","text":" "},{"type":"text","text":"namely:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Window"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"DocumentGroup","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"code":"Settings","type":"codeVoice"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"The value that you provide acts only as an initial default. During state","type":"text"},{"text":" ","type":"text"},{"text":"restoration, the system restores the window to the position that it","type":"text"},{"text":" ","type":"text"},{"text":"last occupied.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/windowgroup\/defaultposition(_:)"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup"]]},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"title":"OpenSwiftUI","abstract":[],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","type":"topic","url":"\/documentation\/openswiftui","kind":"symbol","role":"collection"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/WindowGroup":{"url":"\/documentation\/openswiftui\/windowgroup","kind":"symbol","type":"topic","title":"WindowGroup","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WindowGroup","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"WindowGroup","kind":"identifier"}],"abstract":[{"type":"text","text":"A scene that presents a group of identically structured windows."}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/WindowGroup/defaultPosition(_:)":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup\/defaultPosition(_:)","abstract":[{"type":"text","text":"Sets a default position for a window."}],"url":"\/documentation\/openswiftui\/windowgroup\/defaultposition(_:)","role":"symbol","title":"defaultPosition(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultPosition"},{"kind":"text","text":"("},{"preciseIdentifier":"s:11OpenSwiftUI9UnitPointV","kind":"typeIdentifier","text":"UnitPoint"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","kind":"typeIdentifier","text":"Scene"}],"kind":"symbol","type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/UnitPoint/bottomTrailing":{"type":"topic","role":"symbol","title":"bottomTrailing","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bottomTrailing","kind":"identifier"},{"text":": ","kind":"text"},{"text":"UnitPoint","preciseIdentifier":"s:11OpenSwiftUI9UnitPointV","kind":"typeIdentifier"}],"abstract":[{"text":"A point that’s in the bottom, trailing corner of a view.","type":"text"}],"url":"\/documentation\/openswiftui\/unitpoint\/bottomtrailing","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/bottomTrailing"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene":{"abstract":[{"type":"text","text":"A part of an app’s user interface with a life cycle managed by the"},{"type":"text","text":" "},{"type":"text","text":"system."}],"type":"topic","title":"Scene","url":"\/documentation\/openswiftui\/scene","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scene"}],"navigatorTitle":[{"kind":"identifier","text":"Scene"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/UnitPoint":{"url":"\/documentation\/openswiftui\/unitpoint","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UnitPoint","kind":"identifier"}],"abstract":[{"type":"text","text":"A normalized 2D point in a view’s coordinate space."}],"role":"symbol","title":"UnitPoint","type":"topic","navigatorTitle":[{"text":"UnitPoint","kind":"identifier"}],"kind":"symbol"}}}