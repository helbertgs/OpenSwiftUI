\/documentation\/OpenSwiftUI\/UnitPoint","title":"UnitPoint","type":"topic","role":"symbol","url":"\/documentation\/openswiftui\/unitpoint","abstract":[{"text":"A normalized 2D point in a view’s coordinate space.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UnitPoint"}],"kind":"symbol"},"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"abstract":[],"kind":"symbol","url":"\/documentation\/openswiftui","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","type":"topic","title":"OpenSwiftUI"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/WindowGroup/defaultPosition(_:)":{"title":"defaultPosition(_:)","abstract":[{"type":"text","text":"Sets a default position for a window."}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup\/defaultPosition(_:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultPosition"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI9UnitPointV","text":"UnitPoint"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5SceneP","text":"Scene"}],"kind":"symbol","type":"topic","url":"\/documentation\/openswiftui\/windowgroup\/defaultposition(_:)"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene":{"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"identifier"}],"navigatorTitle":[{"text":"Scene","kind":"identifier"}],"url":"\/documentation\/openswiftui\/scene","kind":"symbol","abstract":[{"text":"A part of an app’s user interface with a life cycle managed by the","type":"text"},{"text":" ","type":"text"},{"text":"system.","type":"text"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","type":"topic","title":"Scene"}}}