{"sections":[],"abstract":[{"type":"text","text":"Replaces all commands defined by the modified scene with the commands"},{"type":"text","text":" "},{"type":"text","text":"from the builder."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup"]]},"variants":[{"paths":["\/documentation\/openswiftui\/windowgroup\/commandsreplaced(content:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"commandsReplaced"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Content"},{"kind":"text","text":">("},{"kind":"attribute","text":"@"},{"kind":"attribute","text":"CommandsBuilder","preciseIdentifier":"s:11OpenSwiftUI15CommandsBuilderV","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/CommandsBuilder"},{"kind":"text","text":" "},{"kind":"externalParam","text":"content"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","text":"Content"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Content"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Commands","preciseIdentifier":"s:11OpenSwiftUI8CommandsP","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Commands"},{"kind":"text","text":"\n"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"content","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"code":"Commands","type":"codeVoice"},{"type":"text","text":" builder whose output will be used to replace"},{"type":"text","text":" "},{"type":"text","text":"the commands normally provided by the modified scene."}]}]}]},{"kind":"content","content":[{"level":2,"text":"Return Value","anchor":"return-value","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A scene that replaces any commands defined by its children"},{"type":"text","text":" "},{"type":"text","text":"with alternative content."}]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"WindowGroup"},{"type":"text","text":", "},{"type":"codeVoice","code":"Window"},{"type":"text","text":", and other scene types all have an associated"},{"type":"text","text":" "},{"type":"text","text":"set of commands that they include by default. Apply this modifier to a"},{"type":"text","text":" "},{"type":"text","text":"scene to replace those commands with the output from the given builder."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, the following code adds a scene for showing the contents of"},{"type":"text","text":" "},{"type":"text","text":"the pasteboard in a dedicated window. We replace the scene’s default"},{"type":"text","text":" "},{"type":"text","text":"Window > Clipboard menu command with a custom Edit > Show Clipboard"},{"type":"text","text":" "},{"type":"text","text":"command that we place next to the other pasteboard commands."}]},{"type":"codeListing","syntax":null,"code":["@main","struct Example: App {","    @Environment(\\.openWindow) var openWindow","","    var body: some Scene {","        ...","","        Window(\"Clipboard\", id: \"clipboard\") {","            ClipboardContentView()","        }","        .commandsReplaced {","            CommandGroup(after: .pasteboard) {","                Section {","                    Button(\"Show Clipboard\") {","                        openWindow(id: \"clipboard\")","                    }","                }","            }","        }","    }","}"]}]}],"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup\/commandsReplaced(content:)","interfaceLanguage":"swift"},"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"commandsReplaced"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Content"},{"kind":"text","text":">("},{"kind":"externalParam","text":"content"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","text":"Content"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP"}],"role":"symbol","title":"commandsReplaced(content:)","symbolKind":"method","roleHeading":"Instance Method","externalID":"s:11OpenSwiftUI5ScenePAAE16commandsReplaced7contentQrqd__yXE_tAA8CommandsRd__lF::SYNTHESIZED::s:11OpenSwiftUI11WindowGroupV","extendedModule":"OpenSwiftUI","modules":[{"name":"OpenSwiftUI"}]},"kind":"symbol","references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Commands":{"url":"\/documentation\/openswiftui\/commands","kind":"symbol","title":"Commands","role":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Commands","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Commands"}],"abstract":[{"type":"text","text":"Conforming types represent a group of related commands that can be exposed"},{"type":"text","text":" "},{"type":"text","text":"to the user via the main menu on macOS and key commands on iOS."}],"navigatorTitle":[{"kind":"identifier","text":"Commands"}],"type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"title":"OpenSwiftUI","abstract":[],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","type":"topic","url":"\/documentation\/openswiftui","kind":"symbol","role":"collection"},