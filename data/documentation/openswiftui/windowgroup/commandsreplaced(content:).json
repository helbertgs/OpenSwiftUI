 Clipboard","type":"text"},{"text":" ","type":"text"},{"text":"command that we place next to the other pasteboard commands.","type":"text"}],"type":"paragraph"},{"code":["@main","struct Example: App {","    @Environment(\\.openWindow) var openWindow","","    var body: some Scene {","        ...","","        Window(\"Clipboard\", id: \"clipboard\") {","            ClipboardContentView()","        }","        .commandsReplaced {","            CommandGroup(after: .pasteboard) {","                Section {","                    Button(\"Show Clipboard\") {","                        openWindow(id: \"clipboard\")","                    }","                }","            }","        }","    }","}"],"type":"codeListing","syntax":null}],"kind":"content"}],"variants":[{"paths":["\/documentation\/openswiftui\/windowgroup\/commandsreplaced(content:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","abstract":[{"type":"text","text":"Replaces all commands defined by the modified scene with the commands"},{"type":"text","text":" "},{"type":"text","text":"from the builder."}],"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup\/commandsReplaced(content:)","interfaceLanguage":"swift"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/WindowGroup":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WindowGroup"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup","role":"symbol","abstract":[{"type":"text","text":"A scene that presents a group of identically structured windows."}],"title":"WindowGroup","url":"\/documentation\/openswiftui\/windowgroup","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"WindowGroup"}],"type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/CommandsBuilder":{"url":"\/documentation\/openswiftui\/commandsbuilder","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/CommandsBuilder","title":"CommandsBuil