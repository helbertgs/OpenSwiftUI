indingV","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"StringProtocol","preciseIdentifier":"s:Sy","kind":"typeIdentifier"},{"text":"\n","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"name":"title","content":[{"inlineContent":[{"type":"text","text":"The title of the suppression toggle in the dialog. This"},{"type":"text","text":" "},{"type":"text","text":"parameter can be elided to use the default suppression title."}],"type":"paragraph"}]},{"name":"isSuppressed","content":[{"inlineContent":[{"type":"text","text":"Whether the suppression toggle is on or off in the"},{"type":"text","text":" "},{"type":"text","text":"dialog."}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"text":"Applying dialog suppression adds a toggle to dialogs on Windows,","type":"text"},{"text":" ","type":"text"},{"text":"which allows the user to request the alert not be displayed again.","type":"text"},{"text":" ","type":"text"},{"text":"Typically whether a dialog is suppressed is stored in ","type":"text"},{"code":"AppStorage","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and used to decide whether to present the dialog in the future.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following example configures an alert with a","type":"text"},{"text":" ","type":"text"},{"text":"suppression toggle. The toggle’s state is stored in ","type":"text"},{"code":"AppStorage","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"used to determine whether or not to show the dialog when the","type":"text"},{"text":" ","type":"text"},{"text":"“Delete Items” button is pressed.","type":"text"}],"type":"paragraph"},{"code":["struct MyApp: App {","    @State private var isShowingDialog = false","    @AppStorage(\"suppressEraseItemAlert\")","    private var suppressAlert = false","","    var body: some Scene {","        Window(...) {","            Button(\"Delete items\") {","                isShowingDialog = true","            }","        }","","        AlertScene(","            \"Are you sure you want to erase these items?\",","            isPresented: $isShowingDialog","        ) {","            Button(\"Erase\", role: .destructive) {","                \/\/ Handle item deletion.","            }","            Button(\"Cancel\", role: .cancel) {","                \/\/ Handle cancellation","            }","        }","        .dialogSuppressionToggle(","            \"Do not ask about erasing items again\",","            isSuppressed: $suppressAlert)","    }","}"],"syntax":null,"type":"codeListing"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/openswiftui\/windowgroup\/dialogsuppressiontoggle(_:issuppressed:)-40vcu"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","abstract":[{"type":"text","text":"Enables user suppression of an alert with a custom suppression"},{"type":"text","text":" "},{"type":"text","text":"message."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup\/dialogSuppressionToggle(_:isSuppressed:)-40vcu"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","abstract":[],"title":"OpenSwiftUI","url":"\/documentation\/openswiftu