This","type":"text"},{"text":" ","type":"text"},{"text":"parameter can be elided to use the default suppression title.","type":"text"}]}],"name":"title"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Whether the suppression toggle is on or off in the","type":"text"},{"text":" ","type":"text"},{"text":"dialog.","type":"text"}]}],"name":"isSuppressed"}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Applying dialog suppression adds a toggle to dialogs on Windows,"},{"type":"text","text":" "},{"type":"text","text":"which allows the user to request the alert not be displayed again."},{"type":"text","text":" "},{"type":"text","text":"Typically whether a dialog is suppressed is stored in "},{"type":"codeVoice","code":"AppStorage"},{"type":"text","text":" "},{"type":"text","text":"and used to decide whether to present the dialog in the future."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example configures an alert with a"},{"type":"text","text":" "},{"type":"text","text":"suppression toggle. The toggle’s state is stored in "},{"type":"codeVoice","code":"AppStorage"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"used to determine whether or not to show the dialog when the"},{"type":"text","text":" "},{"type":"text","text":"“Delete Items” button is pressed."}]},{"code":["struct MyApp: App {","    @State private var isShowingDialog = false","    @AppStorage(\"suppressEraseItemAlert\")","    private var suppressAlert = false","","    var body: some Scene {","        Window(...) {","            Button(\"Delete items\") {","                isShowingDialog = true","            }","        }","","        AlertScene(","            \"Are you sure you want to erase these items?\",","            isPresented: $isShowingDialog","        ) {","            Button(\"Erase\", role: .destructive) {","