{"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/openswiftui\/windowgroup\/defaultwindowplacement(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"symbol","symbolKind":"method","extendedModule":"OpenSwiftUI","title":"defaultWindowPlacement(_:)","externalID":"s:11OpenSwiftUI5ScenePAAE22defaultWindowPlacementyQrAA0fG0VAA0F10LayoutRootV_AA0fG7ContextVtcF::SYNTHESIZED::s:11OpenSwiftUI11WindowGroupV","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultWindowPlacement"},{"kind":"text","text":"(("},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI16WindowLayoutRootV","text":"WindowLayoutRoot"},{"text":", ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI22WindowPlacementContextV","text":"WindowPlacementContext"},{"kind":"text","text":") -> "},{"text":"WindowPlacement","preciseIdentifier":"s:11OpenSwiftUI15WindowPlacementV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","text":"Scene","kind":"typeIdentifier"}],"modules":[{"name":"OpenSwiftUI"}],"roleHeading":"Instance Method"},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup\/defaultWindowPlacement(_:)","interfaceLanguage":"swift"},"abstract":[{"text":"Defines a function used for determining the default placement","type":"text"},{"text":" ","type":"text"},{"text":"of windows.","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultWindowPlacement"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"makePlacement"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI16WindowLayoutRootV","text":"WindowLayoutRoot","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowLayoutRoot"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI22WindowPlacementContextV","text":"WindowPlacementContext","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowPlacementContext"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI15WindowPlacementV","text":"WindowPlacement","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowPlacement"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5SceneP","text":"Scene","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"},{"kind":"text","text":"\n"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"text":"A closure to generate the default window placement.","type":"text"}],"type":"paragraph"}],"name":"makePlacement"}],"kind":"parameters"},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Use this scene modifier to indicate a default initial size and position"},{"type":"text","text":" "},{"type":"text","text":"for a new window that the system creates from a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"},{"type":"text","text":" declaration."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"On Windows, you can use the screen’s bounds to place the window."},{"type":"text","text":" "},{"type":"text","text":"For example, you can specify that the window is always placed 140"},{"type":"text","text":" "},{"type":"text","text":"points from the bottom of the screen:"}],"type":"paragraph"},{"code":["struct MyApp: App {","    var body: some Scene {","        ...","","        Window(\"Status\", id: \"status\") {","            StatusView()","        }","        .windowResizability(.contentSize)","        .defaultWindowPlacement { content, context in","            let displayBounds = context.defaultDisplay.visibleRect","            let size = content.sizeThatFits(.unspecified)","            let position = CGPoint(","                x: displayBounds.midX - (size.width \/ 2),","                y: displayBounds.maxY - size.height - 140)","            return WindowPlacement(position: position, size: size)","        }","    }","}"],"type":"codeListing","syntax":null},{"inlineContent":[{"type":"text","text":"On visionOS, the system always places the first window"},{"type":"text","text":" "},{"type":"text","text":"relative to where the person is looking."},{"type":"text","text":" "},{"type":"text","text":"The system ignores calls to "},{"code":"defaultWindowPlacement(_:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can place any subsequent windows relative to existing ones by"},{"type":"text","text":" "},{"type":"text","text":"returning one of the methods defined by "},{"code":"WindowPlacement\/Position","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"with the existing window."},{"type":"text","text":" "},{"type":"text","text":"For example, you can align the new window with the trailing edge of"},{"type":"text","text":" "},{"type":"text","text":"the "},{"code":"Content","type":"codeVoice"},{"type":"text","text":" window:"}],"type":"paragraph"},{"code":["struct MyApp: App {","    @Environment(\\.openWindow) private var openWindow","","    var body: some Scene {","        WindowGroup(\"Content\", id: \"content\") {","            Button(\"Open status window\") {","                openWindow(id: \"status\")","            }","        }","","        WindowGroup(\"Status\", id: \"status\") {","            StatusView()","        }","        .windowResizability(.contentSize)","        .defaultWindowPlacement { content, context in","            if let contentWindow = context.windows.first(","            where: { $0.id == \"content\" }) {","                WindowPlacement(.trailing(contentWindow))","            } else {","                WindowPlacement()","            }","        }","    }","}"],"type":"codeListing","syntax":null},{"inlineContent":[{"type":"text","text":"The placement that your function returns acts as a default for when the"},{"type":"text","text":" "},{"type":"text","text":"window first appears. People can later resize and move the window using"},{"type":"text","text":" "},{"type":"text","text":"interface controls that the system provides. Also, during state"},{"type":"text","text":" "},{"type":"text","text":"restoration, the system restores the window to it’s most recent size and"},{"type":"text","text":" "},{"type":"text","text":"position, rather than the default placement."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For more information on configuring how scenes behave with"},{"type":"text","text":" "},{"type":"text","text":"state restoration, see "},{"code":"Scene.stateRestoration(_:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","type":"topic","kind":"symbol","abstract":[],"title":"OpenSwiftUI","url":"\/documentation\/openswiftui"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/WindowPlacement":{"abstract":[{"type":"text","text":"A type which represents a preferred size and position for a window."}],"kind":"symbol","navigatorTitle":[{"text":"WindowPlacement","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowPlacement","title":"WindowPlacement","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WindowPlacement","kind":"identifier"}],"url":"\/documentation\/openswiftui\/windowplacement"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene":{"abstract":[{"type":"text","text":"A part of an app’s user interface with a life cycle managed by the"},{"type":"text","text":" "},{"type":"text","text":"system."}],"kind":"symbol","navigatorTitle":[{"text":"Scene","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","title":"Scene","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scene"}],"url":"\/documentation\/openswiftui\/scene"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/WindowPlacementContext":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WindowPlacementContext"}],"kind":"symbol","title":"WindowPlacementContext","url":"\/documentation\/openswiftui\/windowplacementcontext","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowPlacementContext","abstract":[{"text":"A type which represents contextual information used for sizing and","type":"text"},{"text":" ","type":"text"},{"text":"positioning windows.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"WindowPlacementContext"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/WindowGroup/defaultWindowPlacement(_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultWindowPlacement","kind":"identifier"},{"text":"((","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI16WindowLayoutRootV","text":"WindowLayoutRoot","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI22WindowPlacementContextV","text":"WindowPlacementContext","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI15WindowPlacementV","text":"WindowPlacement","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","text":"Scene","kind":"typeIdentifier"}],"kind":"symbol","title":"defaultWindowPlacement(_:)","type":"topic","url":"\/documentation\/openswiftui\/windowgroup\/defaultwindowplacement(_:)","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup\/defaultWindowPlacement(_:)","abstract":[{"text":"Defines a function used for determining the default placement","type":"text"},{"text":" ","type":"text"},{"text":"of windows.","type":"text"}],"role":"symbol"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/WindowGroup":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WindowGroup","kind":"identifier"}],"kind":"symbol","title":"WindowGroup","url":"\/documentation\/openswiftui\/windowgroup","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup","abstract":[{"type":"text","text":"A scene that presents a group of identically structured windows."}],"role":"symbol","navigatorTitle":[{"text":"WindowGroup","kind":"identifier"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/WindowLayoutRoot":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WindowLayoutRoot"}],"kind":"symbol","title":"WindowLayoutRoot","url":"\/documentation\/openswiftui\/windowlayoutroot","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowLayoutRoot","abstract":[{"text":"A proxy which represents the root contents of a window.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"WindowLayoutRoo