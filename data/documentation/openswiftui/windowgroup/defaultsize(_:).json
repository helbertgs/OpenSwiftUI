{"metadata":{"modules":[{"name":"OpenSwiftUI"}],"externalID":"s:11OpenSwiftUI5ScenePAAE11defaultSizeyQrAA0F0VF::SYNTHESIZED::s:11OpenSwiftUI11WindowGroupV","extendedModule":"OpenSwiftUI","roleHeading":"Instance Method","title":"defaultSize(_:)","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultSize","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI4SizeV","text":"Size","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","text":"Scene","kind":"typeIdentifier"}],"role":"symbol"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultSize","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"size","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI4SizeV","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Size","text":"Size","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","text":"Scene","kind":"typeIdentifier"},{"text":"\n","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"size","content":[{"inlineContent":[{"text":"The default size for new windows created from a scene.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"level":2,"anchor":"return-value","type":"heading","text":"Return Value"},{"inlineContent":[{"type":"text","text":"A scene that uses a default size for new windows."}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"Use this scene modifier to indicate a default initial size for a new","type":"text"},{"text":" ","type":"text"},{"text":"window that the system creates from a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"},{"text":" declaration. For","type":"text"},{"text":" ","type":"text"},{"text":"example, you can request that new windows that a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup"},{"text":" ","type":"text"},{"text":"generates occupy 600 points in the x-dimension and 400 points in","type":"text"},{"text":" ","type":"text"},{"text":"the y-dimension:","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["@main","struct MyApp: App {","    var body: some Scene {","        WindowGroup {","            ContentView()","        }","        .defaultSize(CGSize(width: 600, height: 400))","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The size that you specify acts only as a default for when the window","type":"text"},{"text":" ","type":"text"},{"text":"first appears. People can later resize the window using interface","type":"text"},{"text":" ","type":"text"},{"text":"controls that the system provides. Also, during state restoration,","type":"text"},{"text":" ","type":"text"},{"text":"the system restores windows to their most recent size rather than","type":"text"},{"text":" ","type":"text"},{"text":"the default size.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If you specify a default size that’s outside the range of the window’s","type":"text"},{"text":" ","type":"text"},{"text":"inherent resizability in one or both dimensions, the system clamps the","type":"text"},{"text":" ","type":"text"},{"text":"affected dimension to keep it in range. You can configure the","type":"text"},{"text":" ","type":"text"},{"text":"resizability of a scene using the ","type":"text"},{"id