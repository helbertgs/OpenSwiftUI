languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"size","content":[{"inlineContent":[{"text":"The default size for new windows created from a scene.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"anchor":"return-value","level":2,"text":"Return Value","type":"heading"},{"inlineContent":[{"type":"text","text":"A scene that uses a default size for new windows."}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"Use this scene modifier to indicate a default initial size for a new","type":"text"},{"text":" ","type":"text"},{"text":"window that the system creates from a ","type":"text"},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","isActive":true},{"text":" declaration. For","type":"text"},{"text":" ","type":"text"},{"text":"example, you can request that new windows that a ","type":"text"},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup","isActive":true},{"text":" ","type":"text"},{"text":"generates occupy 600 points in the x-dimension and 400 points in","type":"text"},{"text":" ","type":"text"},{"text":"the y-dimension:","type":"text"}],"type":"paragraph"},{"code":["@main","struct MyApp: App {","    var body: some Scene {","        WindowGroup {","            ContentView()","        }","        .defaultSize(CGSize(width: 600, height: 400))","    }","}"],"type":"codeListing","syntax":null},{"inlineContent":[{"type":"text","text":"The size that you specify acts only as a default for when the window"},{"type":"text","text":" "},{"type":"text","text":"first appears. People can later resize the window using interface"},{"type":"text","text":" "},{"type":"text","text":"controls that the system provides. Also, during state restoration,"},{"type":"text","text":" "},{"type":"text","text":"the system restores windows to their most recent size rather than"},{"type":"text","text":" "},{"type":"text","text":"the default size."}],"type":"paragraph"},{"inlineContent":[{"text":"If you specify a default size that’s outside the range of the window’s","type":"text"},{"text":" ","type":"text"},{"text":"inherent resizability in one or both dimensions, the system clamps the","type":"text"},{"text":" ","type":"text"},{"text":"affected dimension to keep it in range. You can configure the","type":"text"},{"text":" ","type":"text"},{"text":"resizability of a scene using the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/windowResizability(_:)"},{"text":" ","type":"text"},{"text":"modifier.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The default size modifier affects any scene type that creates windows"},{"type":"text","text":" "},{"type":"text","text":"in macOS, namely:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"Window","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"code":"DocumentGroup","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Settings"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"If you want to specify the input directly in terms of width and height,","type":"text"},{"text":" ","type":"text"},{"text":"use ","type":"text"},{"code":"Scene\/defaultSize(width:height:)","type":"codeVoice"},{"text":" instead.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene":{"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"identifier"}],"navigatorTitle":[{"text":"Scene","kind":"identifie