eIdentifier":"s:11OpenSwiftUI7BindingV","text":"Binding","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","text":"Scene","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","kind":"typeIdentifier"},{"text":"\n","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"label","content":[{"inlineContent":[{"text":"The label of the suppression toggle in the dialog. This","type":"text"},{"text":" ","type":"text"},{"text":"parameter can be elided to use the default suppression title.","type":"text"}],"type":"paragraph"}]},{"name":"isSuppressed","content":[{"inlineContent":[{"text":"Whether the suppression toggle is on or off in the","type":"text"},{"text":" ","type":"text"},{"text":"dialog.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Applying dialog suppression adds a toggle to dialogs on Windows,","type":"text"},{"text":" ","type":"text"},{"text":"which allows the user to request the alert not be displayed again.","type":"text"},{"text":" ","type":"text"},{"text":"Typically whether a dialog is suppressed is stored in ","type":"text"},{"code":"AppStorage","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and used to decide whether to present the dialog in the future.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The following example configures an alert with a","type":"text"},{"text":" ","type":"text"},{"text":"suppression toggle. The toggle’s state is stored in ","type":"text"},{"code":"AppStorage","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"used to determine whether or not to show the dialog when the","type":"text"},{"text":" ","type":"text"},{"text":"“Delete Items” button is pressed.","type":"text"}]},{"type":"codeListing","syntax":null,"code":["struct MyApp: App {","    @State private var isShowingDialog = false","    @AppStorage(\"suppressEraseItemAlert\")","    private var suppressAlert = false","","    var body: some Scene {","        Window(...) {","            Button(\"Delete items\") {","                isShowingDialog = true","            }","        }","","        AlertScene(","            \"Are you sure you want to erase these items?\",","            isPresented: $isShowingDialog","        ) {","            Button(\"Erase\", role: .destructive) {","                \/\/ Handle item deletion.","            }","            Button(\"Cancel\", role: .cancel) {","                \/\/ Handle cancellation","            }","        }","        .dialogSuppressionToggle(","            \"Do not ask about erasing items again\",","            isSuppressed: $suppressAlert)","    }","}"]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/windowgroup\/dialogsuppressiontoggle(_:issuppressed:)-5e5r3"]}],"kind":"symbol","abstract":[{"type":"text","text":"Enables user suppression of an alert with a custom suppression"},{"type":"text","text":" "},{"type":"text","text":"message."}],"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup\/dialogSuppressionToggle(_:isSuppressed:)-5e5r3","interfaceLanguage":"swift"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","abstract":[],"title":"OpenSwiftUI","url":"\/documentation\/openswiftui","kind":"symbol","type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Text":{"url":"\/documentation\/openswiftui\/text","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text","title