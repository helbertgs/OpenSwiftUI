":2},{"inlineContent":[{"type":"text","text":"A scene that triggers an action in response to a change."}],"type":"paragraph"}]},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this modifier to trigger a side effect when a value changes, like"},{"type":"text","text":" "},{"type":"text","text":"the value associated with an "},{"type":"codeVoice","code":"SwiftUI\/Environment"},{"type":"text","text":" key or a"},{"type":"text","text":" "},{"type":"codeVoice","code":"SwiftUI\/Binding"},{"type":"text","text":". For example, you can clear a cache when you notice"},{"type":"text","text":" "},{"type":"text","text":"that a scene moves to the background:"}]},{"code":["struct MyScene: Scene {","    @Environment(\\.scenePhase) private var scenePhase","    @StateObject private var cache = DataCache()","","    var body: some Scene {","        WindowGroup {","            MyRootView(cache: cache)","        }","        .onChange(of: scenePhase) { oldScenePhase, newScenePhase in","            if newScenePhase == .background {","                cache.empty()","            }","        }","    }","}"],"type":"codeListing","syntax":null},{"type":"paragraph","inlineContent":[{"text":"The system may call the action closure on the main actor, so avoid","type":"text"},{"text":" ","type":"text"},{"text":"long-running tasks in the closure. If you need to perform such tasks,","type":"text"},{"text":" ","type":"text"},{"text":"detach an asynchronous background task:","type":"text"}]},{"code":[".onChange(of: scenePhase) { oldScenePhase, newScenePhase in","    if newScenePhase == .background {","        Task.detached(priority: .background) {","            \/\/ ...","        }","    }","}"],"type":"codeListing","syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the value changes, the new version of the closure will be called,"},{"type":"text","text":" "},{"type":"text","text":"so any captured values will have their values from the time that the"},{"type":"text","text":" "},{"type":"text","text":"observed value has its new value. The system passes the old and new"},{"type":"text","text":" "},{"type":"text","text":"observed values into the closure."}]}]}],"sections":[],"abstract":[{"text":"Adds an action to perform when the given value changes.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/windowgroup\/onchange(of:initial:_:)-9o45b"]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"kind":"symbol","role":"collection","title":"OpenSwiftUI","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","abstract":[],"type":"topic","url":"\/documentation\/openswiftui"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/WindowGroup":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WindowGroup","kind":"identifier"}],"kind":"symbol","role":"symbol","type":"topic","navigatorTitle":[{"text":"WindowGroup","kind":"identifier"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup","url":"\/documentation\/openswiftui\/windowgroup","abstract":[{"text":"A scene that presents a group of identically structured windows.","type":"text"}],"title":"WindowGroup"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/WindowGroup/onChange(of:initial:_:)-9o45b":{"abstract":[{"text":"Adds an action to perform when the given value changes.","type":"text"}],"kind":"symbol","title":"onChange(of:initial:_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onChange","kind":"identifier"},{"text":"<","kind":"text"},{"text":"V","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"V","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"initial","kind":"externalParam"},