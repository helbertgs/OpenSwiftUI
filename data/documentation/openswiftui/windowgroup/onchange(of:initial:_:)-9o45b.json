 "},{"type":"text","text":"protocol."}],"type":"paragraph"}]},{"name":"initial","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Whether the action should be run when this scene initially"},{"type":"text","text":" "},{"type":"text","text":"appears."}]}]},{"name":"action","content":[{"inlineContent":[{"text":"A closure to run when the value changes.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"text":"Return Value","type":"heading","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A scene that triggers an action in response to a change."}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Use this modifier to trigger a side effect when a value changes, like","type":"text"},{"text":" ","type":"text"},{"text":"the value associated with an ","type":"text"},{"code":"SwiftUI\/Environment","type":"codeVoice"},{"text":" key or a","type":"text"},{"text":" ","type":"text"},{"code":"SwiftUI\/Binding","type":"codeVoice"},{"text":". For example, you can clear a cache when you notice","type":"text"},{"text":" ","type":"text"},{"text":"that a scene moves to the background:","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["struct MyScene: Scene {","    @Environment(\\.scenePhase) private var scenePhase","    @StateObject private var cache = DataCache()","","    var body: some Scene {","        WindowGroup {","            MyRootView(cache: cache)","        }","        .onChange(of: scenePhase) { oldScenePhase, newScenePhase in","            if newScenePhase == .background {","                cache.empty()","            }","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The system may call the action closure on the main actor, so avoid","type":"text"},{"text":" ","type":"text"},{"text":"long-running tasks in the closure. If you need to perform such tasks,","type":"text"},{"text":" ","type":"text"},{"text":"detach an asynchronous background task:","type":"text"}],"type":"paragraph"},{"syntax":null,"code":[".onChange(of: scenePhase) { oldScenePhase, newScenePhase in","    if newScenePhase == .background {","        Task.detached(priority: .background) {","            \/\/ ...","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"When the value changes, the new version of the closure will be called,"},{"type":"text","text":" "},{"type":"text","text":"so any captured values will have their values from the time that the"},{"type":"text","text":" "},{"type":"text","text":"observed value has its new value. The system passes the old and new"},{"type":"text","text":" "},{"type":"text","text":"observed values into the closure."}],"type":"paragraph"}]}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/windowgroup\/onchange(of:initial:_:)-9o45b"]}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup\/onChange(of:initial:_:)-9o45b"},"abstract":[{"type":"text","text":"Adds an action to perform when the given value changes."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onChange"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"V"},{"kind":"text","text":">("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"V"},{"kind":"text","text":", "},{"kind":"externalParam","text":"initial"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":", ("},{"kind":"typeIdentifier","text":"V"},{"kind":"text","text":", "},{"kind":"typeIdentifier",