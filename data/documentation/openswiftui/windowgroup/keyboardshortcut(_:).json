owGroup"},{"type":"text","text":" normally"},{"type":"text","text":" "},{"type":"text","text":"creates a File > New Window menu command whose keyboard shortcut is"},{"type":"text","text":" "},{"type":"codeVoice","code":"⌘N"},{"type":"text","text":". The following code changes it to something based on dynamic state:"}]},{"syntax":null,"type":"codeListing","code":["@main","struct Notes: App {","    @State private var newWindowShortcut: KeyboardShortcut? = ...","","    var body: some Scene {","        WindowGroup {","            ContentView($newWindowShortcut)","        }","        .keyboardShortcut(newWindowShortcut)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"shortcut"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", the scene’s presentation command will not be"},{"type":"text","text":" "},{"type":"text","text":"associated with a keyboard shortcut, even if OpenSwiftUI normally assigns"},{"type":"text","text":" "},{"type":"text","text":"one automatically."}]}],"kind":"content"}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","type":"topic","kind":"symbol","abstract":[],"title":"OpenSwiftUI","url":"\/documentation\/openswiftui"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene":{"abstract":[{"type":"text","text":"A part of an app’s user interface with a life cycle managed by the"},{"type":"text","text":" "},{"type":"text","text":"system."}],"kind":"symbol","navigatorTitle":[{"text":"Scene","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","title":"Scene","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scene"}],"url":"\/documentation\/openswiftui\/scene"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/WindowGroup":{"fragments":[{"text":"struc