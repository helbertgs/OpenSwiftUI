{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup\/keyboardShortcut(_:modifiers:localization:)"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/windowgroup\/keyboardshortcut(_:modifiers:localization:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"preciseIdentifier":"s:ScM","kind":"attribute","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"keyboardShortcut"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"key"},{"kind":"text","text":": "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyEquivalent","preciseIdentifier":"s:11OpenSwiftUI13KeyEquivalentV","kind":"typeIdentifier","text":"KeyEquivalent"},{"kind":"text","text":", "},{"kind":"externalParam","text":"modifiers"},{"kind":"text","text":": "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EventModifiers","preciseIdentifier":"s:11OpenSwiftUI14EventModifiersV","kind":"typeIdentifier","text":"EventModifiers"},{"kind":"text","text":" = .command, "},{"kind":"externalParam","text":"localization"},{"kind":"text","text":": "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyboardShortcut","preciseIdentifier":"s:11OpenSwiftUI16KeyboardShortcutV","kind":"typeIdentifier","text":"KeyboardShortcut"},{"kind":"text","text":"."},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyboardShortcut\/Localization-swift.struct","preciseIdentifier":"s:11OpenSwiftUI16KeyboardShortcutV12LocalizationV","kind":"typeIdentifier","text":"Localization"},{"kind":"text","text":" = .automatic) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP","kind":"typeIdentifier","text":"Scene"},{"kind":"text","text":"\n"}]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The key equivalent the user presses to present the scene.","type":"text"}],"type":"paragraph"}],"name":"key"},{"content":[{"inlineContent":[{"text":"The modifier keys required to perform the shortcut.","type":"text"}],"type":"paragraph"}],"name":"modifiers"},{"content":[{"inlineContent":[{"text":"The localization style to apply to the shortcut.","type":"text"}],"type":"paragraph"}],"name":"localization"}]},{"content":[{"type":"heading","anchor":"return-value","text":"Return Value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A scene that can be presented with a keyboard shortcut."}]}],"kind":"content"},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A scene’s keyboard shortcut is bound to the command it adds for creating"},{"type":"text","text":" "},{"type":"text","text":"new windows (in the case of "},{"code":"WindowGroup","type":"codeVoice"},{"type":"text","text":" and "},{"code":"DocumentGroup","type":"codeVoice"},{"type":"text","text":") or"},{"type":"text","text":" "},{"type":"text","text":"bringing a singleton window forward (in the case of "},{"code":"Window","type":"codeVoice"},{"type":"text","text":" and, on"},{"type":"text","text":" "},{"type":"text","text":"Windows, "},{"code":"Settings","type":"codeVoice"},{"type":"text","text":"). Pressing the keyboard shortcut is equivalent to"},{"type":"text","text":" "},{"type":"text","text":"selecting the menu command."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In cases where a command already has a keyboard shortcut, the scene’s"},{"type":"text","text":" "},{"type":"text","text":"keyboard shortcut is used instead. For example, "},{"code":"WindowGroup",