{"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup"]]},"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultLaunchBehavior"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"SceneLaunchBehavior","preciseIdentifier":"s:11OpenSwiftUI19SceneLaunchBehaviorV"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP"}],"externalID":"s:11OpenSwiftUI5ScenePAAE21defaultLaunchBehavioryQrAA0dfG0VF::SYNTHESIZED::s:11OpenSwiftUI11WindowGroupV","title":"defaultLaunchBehavior(_:)","role":"symbol","roleHeading":"Instance Method","symbolKind":"method","modules":[{"name":"OpenSwiftUI"}],"extendedModule":"OpenSwiftUI"},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup\/defaultLaunchBehavior(_:)"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultLaunchBehavior","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"behavior","kind":"internalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneLaunchBehavior","preciseIdentifier":"s:11OpenSwiftUI19SceneLaunchBehaviorV","text":"SceneLaunchBehavior","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP","text":"Scene","kind":"typeIdentifier"},{"text":"\n","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"This behavior can be used to define if a scene is shown on application","type":"text"},{"text":" ","type":"text"},{"text":"launch in the absence of any previously saved state.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"On platforms that do not support multiple windows, this value is","type":"text"},{"text":" ","type":"text"},{"text":"ignored.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"On platforms other than Windows, there must be at least one scene that","type":"text"},{"text":" ","type":"text"},{"text":"presents itself. If no scenes are defined to present, the first scene","type":"text"},{"text":" ","type":"text"},{"text":"will be presented, regardless of the value provided to this modifier.","type":"text"}]},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"text":"During app launch, on platforms other than Windows, the system","type":"text"},{"text":" ","type":"text"},{"text":"will only consider scenes whose role matches the","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/bundleresources\/information_property_list\/uiapplicationpreferreddefaultscenesessionrole","type":"text"},{"text":" ","type":"text"},{"text":"key in the application scene manifest of the ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":" file.","type":"text"},{"text":" ","type":"text"},{"text":"For instance, a volumetric window would need the","type":"text"},{"text":" ","type":"text"},{"code":"UIWindowSceneSessionRoleVolumetricApplication","type":"codeVoice"},{"text":" role.","type":"text"}],"type":"paragraph"}]},{"inlineContent":[{"text":"On Windows, this behavior will also be used to determine which scene is","type":"text"},{"text":" ","type":"text"},{"text":"presented when clicking on the icon of a running application with no","type":"text"},{"text":" ","type":"text"},{"text":"visible windows.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"On visionOS, the system may background the last dismissed scene instead","type":"text"},{"text":" ","type":"text"},{"text":"of closing it. Thus, the suppressed behavior additionally specifies that","type":"text"},{"text":" ","type":"text"},{"text":"the scene should not be presented when tapping on the application icon","type":"text"},{"text":" ","type":"text"},{"text":"with no visible windows.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For example, you may wish to present a welcome window on launch of your","type":"text"},{"text":" ","type":"text"},{"text":"app when there are no previous document windows being restored:","type":"text"}]},{"type":"codeListing","code":["@main","struct MyApp: App {","    var body: some Scene {","        DocumentGroup(newDocument: MyDocument()) { configuration in","            DocumentEditor(configuration.$document)","        }","","        Window(\"Welcome to My App\", id: \"welcome\") {","            WelcomeView()","        }","        .defaultLaunchBehavior(.presented)","    }","}"],"syntax":null},{"type":"paragraph","inlineContent":[{"text":"The default value for all scenes if you do not apply this modifier is","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneLaunchBehavior\/automatic","isActive":true,"type":"reference"},{"text":". With that strategy, a scene","type":"text"},{"text":" ","type":"text"},{"text":"will only present itself if it is the first scene defined by the app,","type":"text"},{"text":" ","type":"text"},{"text":"and no other scenes have presented themselves.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/openswiftui\/windowgroup\/defaultlaunchbehavior(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Sets the default launch behavior for this scene."}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/WindowGroup":{"navigatorTitle":[{"kind":"identifier","text":"WindowGroup"}],"title":"WindowGroup","role":"symbol","type":"topic","url":"\/documentation\/openswiftui\/windowgroup","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WindowGroup"}],"abstract":[{"text":"A scene that presents a group of identically structured windows.","type":"text"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/SceneLaunchBehavior/automatic":{"abstract":[{"type":"text","text":"The automatic behavior."}],"role":"symbol","kind":"symbol","url":"\/documentation\/openswiftui\/scenelaunchbehavior\/automatic","title":"automatic","type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"automatic","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI19SceneLaunchBehaviorV","text":"SceneLaunchBehavior","kind":"typeIdentifier"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneLaunchBehavior\/automatic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/SceneLaunchBehavior":{"navigatorTitle":[{"text":"SceneLaunchBehavior","kind":"identifier"}],"abstract":[{"type":"text","text":"The launch behavior for a scene."}],"role":"symbol","kind":"symbol","url":"\/documentation\/openswiftui\/scenelaunchbehavior","title":"SceneLaunchBehavior","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SceneLaunchBehavior","kind":"identifier"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneLaunchBehavior"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene":{"navigatorTitle":[{"kind":"identifier","text":"Scene"}],"title":"Scene","role":"symbol","type":"topic","url":"\/documentation\/openswiftui\/scene","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scene"}],"abstract":[{"text":"A part of an app’s user interface with a life cycle managed by the","type":"text"},{"text":" ","type":"text"},{"text":"system.","type":"text"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"title":"OpenSwiftUI","url":"\/documentation\/openswiftui","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","kind":"symbol","abstract":[]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/WindowGroup/defaultLaunchBehavior(_:)":{"title":"defaultLaunchBehavior(_:)","role":"symbol","type":"topic","url":"\/documentation\/openswiftui\/windowgroup\/defaultlaunchbehavior(_:)","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup\/defaultLaunchBehavior(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultLaunchBehavior","kind":"identifier"},{"text":"(","kind":"text"},{"text":"SceneLaunchBehavior","preciseIdentifier":"s:11OpenSwiftUI19SceneLaunchBehaviorV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"Sets the default launch behavior for this scene."}]}}}