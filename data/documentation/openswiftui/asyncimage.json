{"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"kind":"symbol","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/asyncimage"]}],"abstract":[{"type":"text","text":"A view that asynchronously loads and displays an image."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncImage","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Content","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI4ViewP","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/View"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This view uses the shared"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/URLSession"},{"type":"text","text":" "},{"type":"text","text":"instance to load an image from the specified URL, and then display it."},{"type":"text","text":" "},{"type":"text","text":"For example, you can display an icon that’s stored on a server:"}]},{"syntax":null,"type":"codeListing","code":["AsyncImage(url: URL(string: \"https:\/\/example.com\/icon.png\"))","    .frame(width: 200, height: 200)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Until the image loads, the view displays a standard placeholder that"},{"type":"text","text":" "},{"type":"text","text":"fills the available space. After the load completes successfully, the view"},{"type":"text","text":" "},{"type":"text","text":"updates to display the image. In the example above, the icon is smaller"},{"type":"text","text":" "},{"type":"text","text":"than the frame, and so appears smaller than the placeholder."}]},{"type":"paragraph","inlineContent":[]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can specify a custom placeholder using"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/AsyncImage\/init(url:scale:content:placeholder:)","isActive":true},{"type":"text","text":". With this initializer, you can"},{"type":"text","text":" "},{"type":"text","text":"also use the "},{"type":"codeVoice","code":"content"},{"type":"text","text":" parameter to manipulate the loaded image."},{"type":"text","text":" "},{"type":"text","text":"For example, you can add a modifier to make the loaded image resizable:"}]},{"syntax":null,"type":"codeListing","code":["AsyncImage(url: URL(string: \"https:\/\/example.com\/icon.png\")) { image in","    image.resizable()","} placeholder: {","    ProgressView()","}",".frame(width: 50, height: 50)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For this example, OpenSwiftUI shows a "},{"type":"codeVoice","code":"ProgressView"},{"type":"text","text":" first, and then the"},{"type":"text","text":" "},{"type":"text","text":"image scaled to fit in the specified frame:"}]},{"type":"paragraph","inlineContent":[]},{"name":"Important","type":"aside","style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You can’t apply image-specific modifiers, like"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Image\/resizable(capInsets:resizingMode:)","isActive":true},{"type":"text","text":", directly to an "},{"type":"codeVoice","code":"AsyncImage"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Instead, apply them to the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Image","isActive":true},{"type":"text","text":" instance that your "},{"type":"codeVoice","code":"content"},{"type":"text","text":" "},{"type":"text","text":"closure gets when defining the view’s appearance."}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To gain more control over the loading process, use the"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/AsyncImage\/init(url:scale:transaction:content:)","isActive":true},{"type":"text","text":" initializer, which takes a"},{"type":"text","text":" "},{"type":"codeVoice","code":"content"},{"type":"text","text":" closure that receives an "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/AsyncImagePhase","isActive":true},{"type":"text","text":" to indicate"},{"type":"text","text":" "},{"type":"text","text":"the state of the loading operation. Return a view that’s appropriate"},{"type":"text","text":" "},{"type":"text","text":"for the current phase:"}]},{"syntax":null,"type":"codeListing","code":["AsyncImage(url: URL(string: \"https:\/\/example.com\/icon.png\")) { phase in","    if let image = phase.image {","        image \/\/ Displays the loaded image.","    } else if phase.error != nil {","        Color.red \/\/ Indicates an error.","    } else {","        Color.blue \/\/ Acts as a placeholder.","    }","}"]}],"kind":"content"}],"metadata":{"navigatorTitle":[{"text":"AsyncImage","kind":"identifier"}],"title":"AsyncImage","role":"symbol","symbolKind":"struct","roleHeading":"Structure","externalID":"s:11OpenSwiftUI10AsyncImageV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncImage","kind":"identifier"}],"modules":[{"name":"OpenSwiftUI"}]},"relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/OpenSwiftUI\/s8CopyableP","doc: