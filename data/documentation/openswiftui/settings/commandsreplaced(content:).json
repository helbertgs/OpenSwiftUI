 > Show Clipboard"},{"type":"text","text":" "},{"type":"text","text":"command that we place next to the other pasteboard commands."}],"type":"paragraph"},{"code":["@main","struct Example: App {","    @Environment(\\.openWindow) var openWindow","","    var body: some Scene {","        ...","","        Window(\"Clipboard\", id: \"clipboard\") {","            ClipboardContentView()","        }","        .commandsReplaced {","            CommandGroup(after: .pasteboard) {","                Section {","                    Button(\"Show Clipboard\") {","                        openWindow(id: \"clipboard\")","                    }","                }","            }","        }","    }","}"],"syntax":null,"type":"codeListing"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/openswiftui\/settings\/commandsreplaced(content:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","abstract":[{"type":"text","text":"Replaces all commands defined by the modified scene with the commands"},{"type":"text","text":" "},{"type":"text","text":"from the builder."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Settings\/commandsReplaced(content:)"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Settings/commandsReplaced(content:)":{"url":"\/documentation\/openswiftui\/settings\/commandsreplaced(content:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"commandsReplaced"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Content"},{"kind":"text","text":">("},{"kind":"externalParam","text":"content"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","text":"Content"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP"}],"type":"topic","abstract":[{"type":"text","text":"Replaces all commands define