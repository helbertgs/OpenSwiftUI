"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Commands"},{"text":" builder whose output will be used to replace","type":"text"},{"text":" ","type":"text"},{"text":"the commands normally provided by the modified scene.","type":"text"}]}]}],"kind":"parameters"},{"content":[{"level":2,"anchor":"return-value","text":"Return Value","type":"heading"},{"inlineContent":[{"type":"text","text":"A scene that replaces any commands defined by its children"},{"type":"text","text":" "},{"type":"text","text":"with alternative content."}],"type":"paragraph"}],"kind":"content"},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"WindowGroup"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Window"},{"type":"text","text":", and other scene types all have an associated"},{"type":"text","text":" "},{"text":"set of commands that they include by default. Apply this modifier to a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"scene to replace those commands with the output from the given builder."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, the following code adds a scene for showing the contents of"},{"type":"text","text":" "},{"text":"the pasteboard in a dedicated window. We replace the scene’s default","type":"text"},{"type":"text","text":" "},{"text":"Window > Clipboard menu command with a custom Edit > Show Clipboard","type":"text"},{"type":"text","text":" "},{"type":"text","text":"command that we place next to the other pasteboard commands."}],"type":"paragraph"},{"code":["@main","struct Example: App {","    @Environment(\\.openWindow) var openWindow","","    var body: some Scene {","        ...","","        Window(\"Clipboard\", id: \"clipboard\") {","            ClipboardContentView()","        }","        .commandsReplaced {","            CommandGroup(after: .pasteboard) {","                Section {","      