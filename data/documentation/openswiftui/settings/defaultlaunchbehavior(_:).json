{"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Settings\/defaultLaunchBehavior(_:)","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/openswiftui\/settings\/defaultlaunchbehavior(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultLaunchBehavior","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"behavior","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"SceneLaunchBehavior","preciseIdentifier":"s:11OpenSwiftUI19SceneLaunchBehaviorV","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneLaunchBehavior","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","kind":"typeIdentifier"},{"text":"\n","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"This behavior can be used to define if a scene is shown on application","type":"text"},{"text":" ","type":"text"},{"text":"launch in the absence of any previously saved state.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"On platforms that do not support multiple windows, this value is","type":"text"},{"text":" ","type":"text"},{"text":"ignored.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"On platforms other than Windows, there must be at least one scene that","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"presents itself. If no scenes are defined to present, the first scene"},{"type":"text","text":" "},{"type":"text","text":"will be presented, regardless of the value provided to this modifier."}]},{"type":"aside","name":"Note","content":[{"inlineContent":[{"type":"text","text":"During app launch, on platforms other than Windows, the system"},{"type":"text","text":" "},{"type":"text","text":"will only consider scenes whose role matches the"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/bundleresources\/information_property_list\/uiapplicationpreferreddefaultscenesessionrole"},{"type":"text","text":" "},{"type":"text","text":"key in the application scene manifest of the "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" file."},{"type":"text","text":" "},{"type":"text","text":"For instance, a volumetric window would need the"},{"type":"text","text":" "},{"type":"codeVoice","code":"UIWindowSceneSessionRoleVolumetricApplication"},{"type":"text","text":" role."}],"type":"paragraph"}],"style":"note"},{"type":"paragraph","inlineContent":[{"text":"On Windows, this behavior will also be used to determine which scene is","type":"text"},{"text":" ","type":"text"},{"text":"presented when clicking on the icon of a running application with no","type":"text"},{"text":" ","type":"text"},{"text":"visible windows.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"On visionOS, the system may background the last dismissed scene instead","type":"text"},{"text":" ","type":"text"},{"text":"of closing it. Thus, the suppressed behavior additionally specifies that","type":"text"},{"text":" ","type":"text"},{"text":"the scene should not be presented when tapping on the application icon","type":"text"},{"text":" ","type":"text"},{"text":"with no visible windows.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For example, you may wish to present a welcome window on launch of your","type":"text"},{"text":" ","type":"text"},{"text":"app when there are no previous document windows being restored:","type":"text"}]},{"type":"codeListing","syntax":null,"code":["@main","struct MyApp: App {","    var body: some Scene {","        DocumentGroup(newDocument: MyDocument()) { configuration in","            DocumentEditor(configuration.$document)","        }","","        Window(\"Welcome to My App\", id: \"welcome\") {","            WelcomeView()","        }","        .defaultLaunchBehavior(.presented)","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The default value for all scenes if you do not apply this modifier is","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneLaunchBehavior\/automatic"},{"text":". With that strategy, a scene","type":"text"},{"text":" ","type":"text"},{"text":"will only present itself if it is the first scene defined by the app,","type":"text"},{"text":" ","type":"text"},{"text":"and no other scenes have presented themselves.","type":"text"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Settings"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultLaunchBehavior","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI19SceneLaunchBehaviorV","text":"SceneLaunchBehavior","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","text":"Scene","kind":"typeIdentifier"}],"modules":[{"name":"OpenSwiftUI"}],"title":"defaultLaunchBehavior(_:)","role":"symbol","extendedModule":"OpenSwiftUI","roleHeading":"Instance Method","symbolKind":"method","externalID":"s:11OpenSwiftUI5ScenePAAE21defaultLaunchBehavioryQrAA0dfG0VF::SYNTHESIZED::s:11OpenSwiftUI8SettingsV"},"kind":"symbol","abstract":[{"type":"text","text":"Sets the default launch behavior for this scene."}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","abstract":[],"title":"OpenSwiftUI","url":"\/documentation\/openswiftui","kind":"symbol","type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scene"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","role":"symbol","abstract":[{"type":"text","text":"A part of an app’s user interface with a life cycle managed by the"},{"type":"text","text":" "},{"type":"text","text":"system."}],"title":"Scene","kind":"symbol","url":"\/documentation\/openswiftui\/scene","navigatorTitle":[{"kind":"identifier","text":"Scene"}],"type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/SceneLaunchBehavior/automatic":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"automatic","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI19SceneLaunchBehaviorV","text":"SceneLaunchBehavior","kind":"typeIdentifier"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneLaunchBehavior\/automatic","role":"symbol","abstract":[{"type":"text","text":"The automatic behavior."}],"title":"automatic","url":"\/documentation\/openswiftui\/scenelaunchbehavior\/automatic","kind":"symbol","type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Settings":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Settings","kind":"identifier"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Settings","role":"symbol","abstract":[{"type":"text","text":"A scene that presents an interface for viewing and modifying an app’s"},{"typ