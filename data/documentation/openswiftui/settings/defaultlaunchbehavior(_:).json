{"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Settings"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"paths":["\/documentation\/openswiftui\/settings\/defaultlaunchbehavior(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Instance Method","extendedModule":"OpenSwiftUI","symbolKind":"method","title":"defaultLaunchBehavior(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultLaunchBehavior","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI19SceneLaunchBehaviorV","text":"SceneLaunchBehavior","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","text":"Scene","kind":"typeIdentifier"}],"role":"symbol","modules":[{"name":"OpenSwiftUI"}],"externalID":"s:11OpenSwiftUI5ScenePAAE21defaultLaunchBehavioryQrAA0dfG0VF::SYNTHESIZED::s:11OpenSwiftUI8SettingsV"},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Settings\/defaultLaunchBehavior(_:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Sets the default launch behavior for this scene."}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultLaunchBehavior"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"behavior"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneLaunchBehavior","preciseIdentifier":"s:11OpenSwiftUI19SceneLaunchBehaviorV","text":"SceneLaunchBehavior"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP","text":"Scene"},{"kind":"text","text":"\n"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This behavior can be used to define if a scene is shown on application"},{"type":"text","text":" "},{"type":"text","text":"launch in the absence of any previously saved state."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On platforms that do not support multiple windows, this value is"},{"type":"text","text":" "},{"type":"text","text":"ignored."}]},{"type":"paragraph","inlineContent":[{"text":"On platforms other than Windows, there must be at least one scene that","type":"text"},{"text":" ","type":"text"},{"text":"presents itself. If no scenes are defined to present, the first scene","type":"text"},{"text":" ","type":"text"},{"text":"will be presented, regardless of the value provided to this modifier.","type":"text"}]},{"name":"Note","style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"During app launch, on platforms other than Windows, the system"},{"type":"text","text":" "},{"type":"text","text":"will only consider scenes whose role matches the"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/bundleresources\/information_property_list\/uiapplicationpreferreddefaultscenesessionrole"},{"type":"text","text":" "},{"type":"text","text":"key in the application scene manifest of the "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" file."},{"type":"text","text":" "},{"type":"text","text":"For instance, a volumetric window would need the"},{"type":"text","text":" "},{"type":"codeVoice","code":"UIWindowSceneSessionRoleVolumetricApplication"},{"type":"text","text":" role."}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On Windows, this behavior will also be used to determine which scene is"},{"text":" ","type":"text"},{"type":"text","text":"presented when clicking on the icon of a running application with no"},{"text":" ","type":"text"},{"type":"text","text":"visible windows."}]},{"inlineContent":[{"type":"text","text":"On visionOS, the system may background the last dismissed scene instead"},{"type":"text","text":" "},{"type":"text","text":"of closing it. Thus, the suppressed behavior additionally specifies that"},{"type":"text","text":" "},{"type":"text","text":"the scene should not be presented when tapping on the application icon"},{"type":"text","text":" "},{"type":"text","text":"with no visible windows."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, you may wish to present a welcome window on launch of your"},{"type":"text","text":" "},{"type":"text","text":"app when there are no previous document windows being restored:"}],"type":"paragraph"},{"code":["@main","struct MyApp: App {","    var body: some Scene {","        DocumentGroup(newDocument: MyDocument()) { configuration in","            DocumentEditor(configuration.$document)","        }","","        Window(\"Welcome to My App\", id: \"welcome\") {","            WelcomeView()","        }","        .defaultLaunchBehavior(.presented)","    }","}"],"type":"codeListing","syntax":null},{"type":"paragraph","inlineContent":[{"text":"The default value for all scenes if you do not apply this modifier is","type":"text"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneLaunchBehavior\/automatic"},{"text":". With that strategy, a scene","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"will only present itself if it is the first scene defined by the app,"},{"type":"text","text":" "},{"type":"text","text":"and no other scenes have presented themselves."}]}],"kind":"content"}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Settings":{"abstract":[{"type":"text","text":"A scene that presents an interface for viewing and modifying an app’s"},{"type":"text","text":" "},{"type":"text","text":"settings."}],"kind":"symbol","navigatorTitle":[{"text":"Settings","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Settings","title":"Settings","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Settings","kind":"identifier"}],"url":"\/documentation\/openswiftui\/settings"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/SceneLaunchBehavior":{"abstract":[{"type":"text","text":"The launch behavior for a scene."}],"kind":"symbol","navigatorTitle":[{"text":"SceneLaunchBehavior","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneLaunchBehavior","title":"SceneLaunchBehavior","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"SceneLaunchBehavior","kind":"identifier"}],"url":"\/documentation\/openswiftui\/scenelaunchbehavior"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/SceneLaunchBehavior/automatic":{"abstract":[{"type":"text","text":"The automatic behavior."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneLaunchBehavior\/automatic","title":"automatic","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"automatic","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI19SceneLaunchBehaviorV","text":"SceneLaunchBehavior"}],"url":"\/documentation\/openswiftui\/scenelaunchbehavior\/automatic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","type":"topic","kind":"symbol","abstract":[],"title":"OpenSwiftUI","url":"\/documentation\/openswiftui"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene":{"abstract":[{"type":"text","text":"A part of an app’s user interface with a life cycle managed by the"},{"type":"text","text":" "},{"type":"text","text":"system."}],"kind":"symbol","navigatorTitle":[{"text":"Scene","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","title":"Scene","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scene"}],"url":"\/documentation\/openswiftui\/scene"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Settings/defaultLaunchBehavior(_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultLaunchBehavior","kind":"identifier"},{"text":"(","kind":"text"},{"text":"SceneLaunchBehavior","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI19SceneLaunchBehaviorV"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5SceneP"}],"kind":"symbol","title":"defaultLaunchBehavior(_:)","url":"\/documentation\/openswiftui\/settings\/defaultlaunchbehavior(_:)","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Settings\/defaultLaunchBehavior(_:)","abstract":[{"type":"text","text":"Sets the default launch behavior for this scene."}],"role":"symbol"}}}