{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Settings"]]},"sections":[],"variants":[{"paths":["\/documentation\/openswiftui\/settings\/handlesexternalevents(matching:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Specifies the external events for which OpenSwiftUI opens a new instance"},{"type":"text","text":" "},{"type":"text","text":"of the modified scene."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"handlesExternalEvents","kind":"identifier"},{"text":"(","kind":"text"},{"text":"matching","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"conditions","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Set","preciseIdentifier":"s:Sh","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP","kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"},{"text":"\n","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"A set of strings that OpenSwiftUI compares against"},{"type":"text","text":" "},{"type":"text","text":"the incoming user activity or URL to see if OpenSwiftUI"},{"type":"text","text":" "},{"type":"text","text":"can open a new scene instance to handle the external event."}],"type":"paragraph"}],"name":"conditions"}]},{"content":[{"type":"heading","anchor":"return-value","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A scene type that limits the kinds of external events for"},{"type":"text","text":" "},{"type":"text","text":"which OpenSwiftUI opens a new instance."}]}],"kind":"content"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When your app receives an external event like a user activity or a"},{"type":"text","text":" "},{"type":"text","text":"URL, OpenSwiftUI routes the event to a scene for processing. OpenSwiftUI"},{"type":"text","text":" "},{"type":"text","text":"selects the scene that receives the event according to the following"},{"type":"text","text":" "},{"type":"text","text":"rules, which it evaluates in order until it finds a destination scene:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"On platforms that support only a single scene per app, send"},{"type":"text","text":" "},{"type":"text","text":"the event to the one open scene."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Find an open scene that indicates it prefers to or can handle the"},{"type":"text","text":" "},{"type":"text","text":"event, if any, and send the event to that scene. You use the"},{"type":"text","text":" "},{"type":"codeVoice","code":"View\/handlesExternalEvents(preferring:allowing:)"},{"type":"text","text":" view modifier"},{"type":"text","text":" "},{"type":"text","text":"on a view inside the scene to register this preference."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Find a scene declaration with a "},{"type":"codeVoice","code":"handlesExternalEvents(matching:)"},{"type":"text","text":" "},{"type":"text","text":"scene modifier containing "},{"type":"codeVoice","code":"conditions"},{"type":"text","text":" that match the external event."},{"type":"text","text":" "},{"type":"text","text":"Create a new instance of the first scene that matches and route the"},{"type":"text","text":" "},{"type":"text","text":"event there."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Find the first scene declaration that doesn’t have the scene modifier."},{"type":"text","text":" "},{"type":"text","text":"Create a new instance of this scene and route the event there."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Make sure that at least one of these rules succeeds in your app for all","type":"text"},{"text":" ","type":"text"},{"text":"events that your app claims to handle. Also, make sure","type":"text"},{"text":" ","type":"text"},{"text":"that the scene that receives an event actually handles it. For example,","type":"text"},{"text":" ","type":"text"},{"text":"be sure that a scene that receives user activities handles them with an","type":"text"},{"text":" ","type":"text"},{"text":"appropriate ","type":"text"},{"code":"View\/onContinueUserActivity(_:perform:)","type":"codeVoice"},{"text":" view modifier.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Don’t confuse the ","type":"text"},{"code":"handlesExternalEvents(matching:)","type":"codeVoice"},{"text":" scene","type":"text"},{"text":" ","type":"text"},{"text":"modifier with the ","type":"text"},{"code":"View\/handlesExternalEvents(preferring:allowing:)","type":"codeVoice"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"view"}],"type":"emphasis"},{"text":" modifier. You use the scene modifier to help OpenSwiftUI choose a","type":"text"},{"text":" ","type":"text"},{"text":"new scene to open when no open scene handles an external event,","type":"text"},{"text":" ","type":"text"},{"text":"whereas you use the view modifier to indicate that an open scene can","type":"text"},{"text":" ","type":"text"},{"text":"or prefers to handle certain events.","type":"text"}]},{"type":"heading","level":3,"text":"Matching an event","anchor":"Matching-an-event"},{"type":"paragraph","inlineContent":[{"text":"To find a scene type that handles a particular external event, OpenSwiftUI","type":"text"},{"text":" ","type":"text"},{"text":"compares a property of the event against the strings that you specify","type":"text"},{"text":" ","type":"text"},{"text":"in the ","type":"text"},{"code":"conditions","type":"codeVoice"},{"text":" set. OpenSwiftUI examines the following event","type":"text"},{"text":" ","type":"text"},{"text":"properties to perform the comparison:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"For an"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/NSUserActivity"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"like when your app handles Handoff, OpenSwiftUI uses the activity’s"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/NSUserActivity\/3238062-targetContentIdentifier"},{"type":"text","text":" "},{"type":"text","text":"property, or if that’s "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", its"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/NSUserActivity\/1418086-webpageurl"},{"type":"text","text":" "},{"type":"text","text":"property rendered as an"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/URL\/1779984-absoluteString"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"For a"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/URL"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"like when another process opens a URL that your app handles,"},{"type":"text","text":" "},{"type":"text","text":"OpenSwiftUI uses the URL’s"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/URL\/1779984-absoluteString"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"An empty set of strings never matches. Similarly, empty strings never","type":"text"},{"text":" ","type":"text"},{"text":"match. Conversely, as a special case, the string that contains only an","type":"text"},{"text":" ","type":"text"},{"text":"asterisk (","type":"text"},{"code":"*","type":"codeVoice"},{"text":") matches anything. The modifier performs string","type":"text"},{"text":" ","type":"text"},{"text":"comparisons that are case and diacritic insensitive.","type":"text"}]},{"name":"Important","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"code":"DocumentGroup","type":"codeVoice"},{"type":"text","text":" scenes ignore this modifier. Instead,"},{"type":"text","text":" "},{"type":"text","text":"document scenes decide whether to open a new scene to handle an"},{"type":"text","text":" "},{"type":"text","text":"external event by comparing the incoming URL or user activity’s"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/NSUserActivity\/1418086-webpageurl"},{"type":"text","text":" "},{"type":"text","text":"against the document group’s supported types."}],"type":"paragraph"}],"style":"important"},{"type":"heading","level":3,"text":"Choosing a window to open","anchor":"Choosing-a-window-to-open"},{"type":"paragraph","inlineContent":[{"text":"The following example shows an app with a photo browser scene","type":"text"},{"text":" ","type":"text"},{"text":"that displays a collection of photos, and a photo detail scene that","type":"text"},{"text":" ","type":"text"},{"text":"enables closer examination of a particular photo:","type":"text"}]},{"type":"codeListing","syntax":null,"code":["@main","struct MyPhotos: App {","    var body: some Scene {","        WindowGroup {","            PhotosBrowser()","        }","","        WindowGroup(\"Photo\") {","            PhotoDetail()","        }","        .handlesExternalEvents(matching: [\"photoIdentifier=\"])","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The app uses the ","type":"text"},{"code":"handlesExternalEvents(matching:)","type":"codeVoice"},{"text":" modifier on the","type":"text"},{"text":" ","type":"text"},{"text":"second scene to ensure that an external event with an identifier","type":"text"},{"text":" ","type":"text"},{"text":"that contains the string ","type":"text"},{"code":"photoIdentifier=","type":"codeVoice"},{"text":" creates a new scene of","type":"text"},{"text":" ","type":"text"},{"text":"the second type. Other events, if not handled by an open scene,","type":"text"},{"text":" ","type":"text"},{"text":"cause the creation of a new browser window instead.","type":"text"}]}],"kind":"content"}],"metadata":{"title":"handlesExternalEvents(matching:)","role":"symbol","extendedModule":"OpenSwiftUI","roleHeading":"Instance Method","externalID":"s:11OpenSwiftUI5ScenePAAE21handlesExternalEvents8matchingQrShySSG_tF::SYNTHESIZED::s:11OpenSwiftUI8SettingsV","symbolKind":"method","modules":[{"name":"OpenSwiftUI"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"handlesExternalEvents"},{"kind":"text","text":"("},{"kind":"externalParam","text":"matching"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sh","text":"Set"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":">) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5SceneP","text":"Scene"}]},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Settings\/handlesExternalEvents(matching:)","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","type":"topic","kind":"symbol","abstract":[],"title":"OpenSwiftUI","url":"\/documentation\/openswiftui"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Settings":{"abstract":[{"type":"text","text":"A scene that presents an interface for viewing and modifying an app’s"},{"type":"text","text":" "},{"type":"text","text":"settings."}],"kind":"symbol","navigatorTitle":[{"text":"Settings","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Settings","title":"Settings","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Settings","kind":"identifier"}],"url":"\/documentation\/openswiftui\/settings"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene":{"abstract":[{"type":"text","text":"A part of an app’s user interface with a life cycle managed by the"},{"type":"text","text":" "},{"type":"text","text":"system."}],"kind":"symbol","navigatorTitle":[{"text":"Scene","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","title":"Scene","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scene"}],"url":"\/documentation\/openswiftui\/scene"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Settings/handlesExternalEvents(matching:)":{"kind":"symbol","abstract":[{"text":"Specifies the external events for which OpenSwiftUI opens a new instance","type":"text"},{"text":" ","type":"text"},{"text":"of the modified scene.","type":"text"}],"title":"handlesExternalEvents(matching:)","role":"symbol","url":"\/documentation\/openswiftui\/settings\/handlesexternalevents(matching:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"handlesExternalEvents","kind":"identifier"},{"text":"(","kind":"text"},{"text":"matching","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Set","kind":"typeIdentifier","preciseIdentifier":"s:Sh"},{"text":"<","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":">) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5SceneP"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Settings\/handlesExternalEvents(matching:)","type":"topic"}}}