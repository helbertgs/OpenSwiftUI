{"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Settings"]]},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Settings\/handlesExternalEvents(matching:)","interfaceLanguage":"swift"},"abstract":[{"text":"Specifies the external events for which OpenSwiftUI opens a new instance","type":"text"},{"type":"text","text":" "},{"text":"of the modified scene.","type":"text"}],"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"preciseIdentifier":"s:ScM","kind":"attribute","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"handlesExternalEvents"},{"kind":"text","text":"("},{"kind":"externalParam","text":"matching"},{"kind":"text","text":" "},{"kind":"internalParam","text":"conditions"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sh","kind":"typeIdentifier","text":"Set"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":">) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","kind":"typeIdentifier","text":"Scene"},{"text":"\n","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"A set of strings that OpenSwiftUI compares against","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the incoming user activity or URL to see if OpenSwiftUI"},{"type":"text","text":" "},{"type":"text","text":"can open a new scene instance to handle the external event."}]}],"name":"conditions"}],"kind":"parameters"},{"content":[{"level":2,"text":"Return Value","anchor":"return-value","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A scene type that limits the kinds of external events for"},{"type":"text","text":" "},{"type":"text","text":"which OpenSwiftUI opens a new instance."}]}],"kind":"content"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When your app receives an external event like a user activity or a"},{"type":"text","text":" "},{"type":"text","text":"URL, OpenSwiftUI routes the event to a scene for processing. OpenSwiftUI"},{"type":"text","text":" "},{"type":"text","text":"selects the scene that receives the event according to the following"},{"type":"text","text":" "},{"type":"text","text":"rules, which it evaluates in order until it finds a destination scene:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"On platforms that support only a single scene per app, send","type":"text"},{"text":" ","type":"text"},{"text":"the event to the one open scene.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Find an open scene that indicates it prefers to or can handle the"},{"type":"text","text":" "},{"type":"text","text":"event, if any, and send the event to that scene. You use the"},{"type":"text","text":" "},{"code":"View\/handlesExternalEvents(preferring:allowing:)","type":"codeVoice"},{"type":"text","text":" view modifier"},{"type":"text","text":" "},{"type":"text","text":"on a view inside the scene to register this preference."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Find a scene declaration with a ","type":"text"},{"code":"handlesExternalEvents(matching:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"scene modifier containing ","type":"text"},{"code":"conditions","type":"codeVoice"},{"text":" that match the external event.","type":"text"},{"text":" ","type":"text"},{"text":"Create a new instance of the first scene that matches and route the","type":"text"},{"text":" ","type":"text"},{"text":"event there.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Find the first scene declaration that doesn’t have the scene modifier."},{"type":"text","text":" "},{"type":"text","text":"Create a new instance of this scene and route the event there."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make sure that at least one of these rules succeeds in your app for all"},{"type":"text","text":" "},{"type":"text","text":"events that your app claims to handle. Also, make sure"},{"type":"text","text":" "},{"type":"text","text":"that the scene that receives an event actually handles it. For example,"},{"type":"text","text":" "},{"type":"text","text":"be sure that a scene that receives user activities handles them with an"},{"type":"text","text":" "},{"type":"text","text":"appropriate "},{"type":"codeVoice","code":"View\/onContinueUserActivity(_:perform:)"},{"type":"text","text":" view modifier."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Don’t confuse the "},{"type":"codeVoice","code":"handlesExternalEvents(matching:)"},{"type":"text","text":" scene"},{"type":"text","text":" "},{"type":"text","text":"modifier with the "},{"type":"codeVoice","code":"View\/handlesExternalEvents(preferring:allowing:)"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"view"}]},{"type":"text","text":" modifier. You use the scene modifier to help OpenSwiftUI choose a"},{"type":"text","text":" "},{"type":"text","text":"new scene to open when no open scene handles an external event,"},{"type":"text","text":" "},{"type":"text","text":"whereas you use the view modifier to indicate that an open scene can"},{"type":"text","text":" "},{"type":"text","text":"or prefers to handle certain events."}]},{"level":3,"text":"Matching an event","anchor":"Matching-an-event","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To find a scene type that handles a particular external event, OpenSwiftUI"},{"type":"text","text":" "},{"type":"text","text":"compares a property of the event against the strings that you specify"},{"type":"text","text":" "},{"type":"text","text":"in the "},{"type":"codeVoice","code":"conditions"},{"type":"text","text":" set. OpenSwiftUI examines the following event"},{"type":"text","text":" "},{"type":"text","text":"properties to perform the comparison:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"For an","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/NSUserActivity","type":"text"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"like when your app handles Handoff, OpenSwiftUI uses the activity’s","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/NSUserActivity\/3238062-targetContentIdentifier","type":"text"},{"text":" ","type":"text"},{"text":"property, or if that’s ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", its","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/NSUserActivity\/1418086-webpageurl","type":"text"},{"text":" ","type":"text"},{"text":"property rendered as an","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/URL\/1779984-absoluteString","type":"text"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For a"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/URL"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"like when another process opens a URL that your app handles,"},{"type":"text","text":" "},{"type":"text","text":"OpenSwiftUI uses the URL’s"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/URL\/1779984-absoluteString"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An empty set of strings never matches. Similarly, empty strings never"},{"type":"text","text":" "},{"type":"text","text":"match. Conversely, as a special case, the string that contains only an"},{"type":"text","text":" "},{"type":"text","text":"asterisk ("},{"type":"codeVoice","code":"*"},{"type":"text","text":") matches anything. The modifier performs string"},{"type":"text","text":" "},{"type":"text","text":"comparisons that are case and diacritic insensitive."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"DocumentGroup","type":"codeVoice"},{"type":"text","text":" scenes ignore this modifier. Instead,"},{"type":"text","text":" "},{"type":"text","text":"document scenes decide whether to open a new scene to handle an"},{"type":"text","text":" "},{"type":"text","text":"external event by comparing the incoming URL or user activity’s"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/NSUserActivity\/1418086-webpageurl"},{"type":"text","text":" "},{"type":"text","text":"against the document group’s supported types."}]}],"type":"aside","style":"important","name":"Important"},{"level":3,"text":"Choosing a window to open","anchor":"Choosing-a-window-to-open","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example shows an app with a photo browser scene"},{"type":"text","text":" "},{"type":"text","text":"that displays a collection of photos, and a photo detail scene that"},{"type":"text","text":" "},{"type":"text","text":"enables closer examination of a particular photo:"}]},{"code":["@main","struct MyPhotos: App {","    var body: some Scene {","        WindowGroup {","            PhotosBrowser()","        }","","        WindowGroup(\"Photo\") {","            PhotoDetail()","        }","        .handlesExternalEvents(matching: [\"photoIdentifier=\"])","    }","}"],"syntax":null,"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The app uses the "},{"type":"codeVoice","code":"handlesExternalEvents(matching:)"},{"type":"text","text":" modifier on the"},{"type":"text","text":" "},{"type":"text","text":"second scene to ensure that an external event with an identifier"},{"type":"text","text":" "},{"type":"text","text":"that contains the string "},{"type":"codeVoice","code":"photoIdentifier="},{"type":"text","text":" creates a new scene of"},{"type":"text","text":" "},{"type":"text","text":"the second type. Other events, if not handled by an open scene,"},{"type":"text","text":" "},{"type":"text","text":"cause the creation of a new browser window instead."}]}],"kind":"content"}],"metadata":{"externalID":"s:11OpenSwiftUI5ScenePAAE21handlesExternalEvents8matchingQrShySSG_tF::SYNTHESIZED::s:11OpenSwiftUI8SettingsV","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"handlesExternalEvents","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"matching"},{"kind":"text","text":": "},{"text":"Set","kind":"typeIdentifier","preciseIdentifier":"s:Sh"},{"text":"<","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":">) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5SceneP"}],"extendedModule":"OpenSwiftUI","role":"symbol","title":"handlesExternalEvents(matching:)","symbolKind":"method","modules":[{"name":"OpenSwiftUI"}]},"variants":[{"paths":["\/documentation\/openswiftui\/settings\/handlesexternalevents(matching:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Settings/handlesExternalEvents(matching:)":{"kind":"symbol","url":"\/documentation\/openswiftui\/settings\/handlesexternalevents(matching:)","abstract":[{"text":"Specifies the external events for which OpenSwiftUI opens a new instance","type":"text"},{"text":" ","type":"text"},{"text":"of the modified scene.","type":"text"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Settings\/handlesExternalEvents(matching:)","role":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"handlesExternalEvents","kind":"identifier"},{"text":"(","kind":"text"},{"text":"matching","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Set","preciseIdentifier":"s:Sh","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP","kind":"typeIdentifier"}],"title":"handlesExternalEvents(matching:)"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Settings":{"type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Settings"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Settings","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Settings"}],"abstract":[{"text":"A scene that presents an interface for viewing and modifying an app’s","type":"text"},{"text":" ","type":"text"},{"text":"settings.","type":"text"}],"url":"\/documentation\/openswiftui\/settings","title":"Settings","kind":"symbol"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene":{"navigatorTitle":[{"kind":"identifier","text":"Scene"}],"title":"Scene","role":"symbol","type":"topic","url":"\/documentation\/openswiftui\/scene","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scene"}],"abstract":[{"text":"A part of an app’s user interface with a life cycle managed by the","type":"text"},{"text":" ","type":"text"},{"text":"system.","type":"text"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"title":"OpenSwiftUI","url":"\/documentation\/openswiftui","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","kind":"symbol","abstract":[]}}}