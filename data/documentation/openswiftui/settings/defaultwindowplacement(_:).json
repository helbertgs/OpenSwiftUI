{"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Settings\/defaultWindowPlacement(_:)"},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Settings"]]},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultWindowPlacement","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"makePlacement","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"@escaping ","kind":"attribute"},{"text":"(","kind":"text"},{"text":"WindowLayoutRoot","preciseIdentifier":"s:11OpenSwiftUI16WindowLayoutRootV","kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowLayoutRoot"},{"text":", ","kind":"text"},{"text":"WindowPlacementContext","preciseIdentifier":"s:11OpenSwiftUI22WindowPlacementContextV","kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowPlacementContext"},{"text":") -> ","kind":"text"},{"text":"WindowPlacement","preciseIdentifier":"s:11OpenSwiftUI15WindowPlacementV","kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowPlacement"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP","kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"},{"text":"\n","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"A closure to generate the default window placement.","type":"text"}],"type":"paragraph"}],"name":"makePlacement"}]},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"text":"Use this scene modifier to indicate a default initial size and position","type":"text"},{"text":" ","type":"text"},{"text":"for a new window that the system creates from a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"},{"text":" declaration.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"On Windows, you can use the screen’s bounds to place the window.","type":"text"},{"text":" ","type":"text"},{"text":"For example, you can specify that the window is always placed 140","type":"text"},{"text":" ","type":"text"},{"text":"points from the bottom of the screen:","type":"text"}],"type":"paragraph"},{"code":["struct MyApp: App {","    var body: some Scene {","        ...","","        Window(\"Status\", id: \"status\") {","            StatusView()","        }","        .windowResizability(.contentSize)","        .defaultWindowPlacement { content, context in","            let displayBounds = context.defaultDisplay.visibleRect","            let size = content.sizeThatFits(.unspecified)","            let position = CGPoint(","                x: displayBounds.midX - (size.width \/ 2),","                y: displayBounds.maxY - size.height - 140)","            return WindowPlacement(position: position, size: size)","        }","    }","}"],"type":"codeListing","syntax":null},{"inlineContent":[{"text":"On visionOS, the system always places the first window","type":"text"},{"text":" ","type":"text"},{"text":"relative to where the person is looking.","type":"text"},{"text":" ","type":"text"},{"text":"The system ignores calls to ","type":"text"},{"code":"defaultWindowPlacement(_:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You can place any subsequent windows relative to existing ones by","type":"text"},{"text":" ","type":"text"},{"text":"returning one of the methods defined by ","type":"text"},{"code":"WindowPlacement\/Position","type":"codeVoice"},{"text":" ","type":"text"},{"text":"with the existing window.","type":"text"},{"text":" ","type":"text"},{"text":"For example, you can align the new window with the trailing edge of","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"Content","type":"codeVoice"},{"text":" window:","type":"text"}],"type":"paragraph"},{"code":["struct MyApp: App {","    @Environment(\\.openWindow) private var openWindow","","    var body: some Scene {","        WindowGroup(\"Content\", id: \"content\") {","            Button(\"Open status window\") {","                openWindow(id: \"status\")","            }","        }","","        WindowGroup(\"Status\", id: \"status\") {","            StatusView()","        }","        .windowResizability(.contentSize)","        .defaultWindowPlacement { content, context in","            if let contentWindow = context.windows.first(","            where: { $0.id == \"content\" }) {","                WindowPlacement(.trailing(contentWindow))","            } else {","                WindowPlacement()","            }","        }","    }","}"],"type":"codeListing","syntax":null},{"inlineContent":[{"text":"The placement that your function returns acts as a default for when the","type":"text"},{"text":" ","type":"text"},{"text":"window first appears. People can later resize and move the window using","type":"text"},{"text":" ","type":"text"},{"text":"interface controls that the system provides. Also, during state","type":"text"},{"text":" ","type":"text"},{"text":"restoration, the system restores the window to it’s most recent size and","type":"text"},{"text":" ","type":"text"},{"text":"position, rather than the default placement.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For more information on configuring how scenes behave with","type":"text"},{"text":" ","type":"text"},{"text":"state restoration, see ","type":"text"},{"code":"Scene.stateRestoration(_:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"abstract":[{"type":"text","text":"Defines a function used for determining the default placement"},{"type":"text","text":" "},{"type":"text","text":"of windows."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/settings\/defaultwindowplacement(_:)"]}],"metadata":{"role":"symbol","symbolKind":"method","extendedModule":"OpenSwiftUI","externalID":"s:11OpenSwiftUI5ScenePAAE22defaultWindowPlacementyQrAA0fG0VAA0F10LayoutRootV_AA0fG7ContextVtcF::SYNTHESIZED::s:11OpenSwiftUI8SettingsV","title":"defaultWindowPlacement(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultWindowPlacement","kind":"identifier"},{"text":"((","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI16WindowLayoutRootV","text":"WindowLayoutRoot","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI22WindowPlacementContextV","text":"WindowPlacementContext","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI15WindowPlacementV","text":"WindowPlacement","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","text":"Scene","kind":"typeIdentifier"}],"modules":[{"name":"OpenSwiftUI"}],"roleHeading":"Instance Method"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","type":"topic","kind":"symbol","abstract":[],"title":"OpenSwiftUI","url":"\/documentation\/openswiftui"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/WindowPlacement":{"abstract":[{"type":"text","text":"A type which represents a preferred size and position for a window."}],"kind":"symbol","navigatorTitle":[{"text":"WindowPlacement","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowPlacement","title":"WindowPlacement","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WindowPlacement","kind":"identifier"}],"url":"\/documentation\/openswiftui\/windowplacement"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Settings":{"abstract":[{"type":"text","text":"A scene that presents an interface for viewing and modifying an app’s"},{"type":"text","text":" "},{"type":"text","text":"settings."}],"kind":"symbol","navigatorTitle":[{"text":"Settings","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Settings","title":"Settings","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Settings","kind":"identifier"}],"url":"\/documentation\/openswiftui\/settings"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene":{"abstract":[{"type":"text","text":"A part of an app’s user interface with a life cycle managed by the"},{"type":"text","text":" "},{"type":"text","text":"system."}],"kind":"symbol","navigatorTitle":[{"text":"Scene","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","title":"Scene","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scene"}],"url":"\/documentation\/openswiftui\/scene"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/WindowPlacementContext":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WindowPlacementContext"}],"kind":"symbol","title":"WindowPlacementContext","url":"\/documentation\/openswiftui\/windowplacementcontext","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowPlacementContext","abstract":[{"text":"A type whic