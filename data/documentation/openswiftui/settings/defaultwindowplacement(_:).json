{"metadata":{"symbolKind":"method","role":"symbol","extendedModule":"OpenSwiftUI","title":"defaultWindowPlacement(_:)","externalID":"s:11OpenSwiftUI5ScenePAAE22defaultWindowPlacementyQrAA0fG0VAA0F10LayoutRootV_AA0fG7ContextVtcF::SYNTHESIZED::s:11OpenSwiftUI8SettingsV","roleHeading":"Instance Method","modules":[{"name":"OpenSwiftUI"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultWindowPlacement"},{"kind":"text","text":"(("},{"kind":"typeIdentifier","text":"WindowLayoutRoot","preciseIdentifier":"s:11OpenSwiftUI16WindowLayoutRootV"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"WindowPlacementContext","preciseIdentifier":"s:11OpenSwiftUI22WindowPlacementContextV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"WindowPlacement","preciseIdentifier":"s:11OpenSwiftUI15WindowPlacementV"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP"}]},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Defines a function used for determining the default placement"},{"type":"text","text":" "},{"type":"text","text":"of windows."}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Settings"]]},"kind":"symbol","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Settings\/defaultWindowPlacement(_:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/settings\/defaultwindowplacement(_:)"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultWindowPlacement"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"makePlacement"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"text","text":"("},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowLayoutRoot","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI16WindowLayoutRootV","text":"WindowLayoutRoot"},{"kind":"text","text":", "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowPlacementContext","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI22WindowPlacementContextV","text":"WindowPlacementContext"},{"kind":"text","text":") -> "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowPlacement","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI15WindowPlacementV","text":"WindowPlacement"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI5SceneP","text":"Scene"},{"kind":"text","text":"\n"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"name":"makePlacement","content":[{"type":"paragraph","inlineContent":[{"text":"A closure to generate the default window placement.","type":"text"}]}]}],"kind":"parameters"},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this scene modifier to indicate a default initial size and position"},{"type":"text","text":" "},{"type":"text","text":"for a new window that the system creates from a "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","isActive":true},{"type":"text","text":" declaration."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On Windows, you can use the screen’s bounds to place the window."},{"type":"text","text":" "},{"type":"text","text":"For example, you can specify that the window is always placed 140"},{"type":"text","text":" "},{"type":"text","text":"points from the bottom of the screen:"}]},{"type":"codeListing","code":["struct MyApp: App {","    var body: some Scene {","        ...","","        Window(\"Status\", id: \"status\") {","            StatusView()","        }","        .windowResizability(.contentSize)","        .defaultWindowPlacement { content, context in","            let displayBounds = context.defaultDisplay.visibleRect","            let size = content.sizeThatFits(.unspecified)","            let position = CGPoint(","                x: displayBounds.midX - (size.width \/ 2),","                y: displayBounds.maxY - size.height - 140)","            return WindowPlacement(position: position, size: size)","        }","    }","}"],"syntax":null},{"inlineContent":[{"type":"text","text":"On visionOS, the system always places the first window"},{"type":"text","text":" "},{"type":"text","text":"relative to where the person is looking."},{"type":"text","text":" "},{"type":"text","text":"The system ignores calls to "},{"type":"codeVoice","code":"defaultWindowPlacement(_:)"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can place any subsequent windows relative to existing ones by"},{"type":"text","text":" "},{"type":"text","text":"returning one of the methods defined by "},{"type":"codeVoice","code":"WindowPlacement\/Position"},{"type":"text","text":" "},{"type":"text","text":"with the existing window."},{"type":"text","text":" "},{"type":"text","text":"For example, you can align the new window with the trailing edge of"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"Content"},{"type":"text","text":" window:"}],"type":"paragraph"},{"code":["struct MyApp: App {","    @Environment(\\.openWindow) private var openWindow","","    var body: some Scene {","        WindowGroup(\"Content\", id: \"content\") {","            Button(\"Open status window\") {","                openWindow(id: \"status\")","            }","        }","","        WindowGroup(\"Status\", id: \"status\") {","            StatusView()","        }","        .windowResizability(.contentSize)","        .defaultWindowPlacement { content, context in","            if let contentWindow = context.windows.first(","            where: { $0.id == \"content\" }) {","                WindowPlacement(.trailing(contentWindow))","            } else {","                WindowPlacement()","            }","        }","    }","}"],"syntax":null,"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The placement that your function returns acts as a default for when the"},{"type":"text","text":" "},{"type":"text","text":"window first appears. People can later resize and move the window using"},{"type":"text","text":" "},{"type":"text","text":"interface controls that the system provides. Also, during state"},{"type":"text","text":" "},{"text":"restoration, the system restores the window to it’s most recent size and","type":"text"},{"type":"text","text":" "},{"text":"position, rather than the default placement.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For more information on configuring how scenes behave with"},{"type":"text","text":" "},{"type":"text","text":"state restoration, see "},{"type":"codeVoice","code":"Scene.stateRestoration(_:)"},{"type":"text","text":"."}]}],"kind":"content"}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Settings":{"type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Settings"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Settings","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Settings"}],"abstract":[{"text":"A scene that presents an interface for viewi