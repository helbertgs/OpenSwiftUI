rform such tasks,"},{"type":"text","text":" "},{"type":"text","text":"detach an asynchronous background task:"}]},{"syntax":null,"type":"codeListing","code":[".onChange(of: scenePhase) { oldScenePhase, newScenePhase in","    if newScenePhase == .background {","        Task.detached(priority: .background) {","            \/\/ ...","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the value changes, the new version of the closure will be called,"},{"type":"text","text":" "},{"type":"text","text":"so any captured values will have their values from the time that the"},{"type":"text","text":" "},{"type":"text","text":"observed value has its new value. The system passes the old and new"},{"type":"text","text":" "},{"type":"text","text":"observed values into the closure."}]}],"kind":"content"}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Binding":{"abstract":[{"type":"text","text":"A property wrapper type that can read and write a value owned by a source of"},{"type":"text","text":" "},{"type":"text","text":"truth."}],"kind":"symbol","navigatorTitle":[{"text":"Binding","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding","title":"Binding","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Binding","kind":"identifier"}],"url":"\/documentation\/openswiftui\/binding"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Settings/onChange(of:initial:_:)-4o54u":{"kind":"symbol","abstract":[{"text":"Adds an action to perform when the given value changes.","type":"text"}],"title":"onChange(of:initial:_:)","role":"symbol","url":"\/documentation\/openswiftui\/settings\/onchange(of:initial:_:)-4o54u","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onChange","kind":"identifier"},{"text":"<","kind":"text"},{"text":"V","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"of","kind":"external