chor":"return-value","type":"heading","text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A scene that uses a default size for new windows."}]}]},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"type":"text","text":"Use this scene modifier to indicate a default initial size for a new"},{"type":"text","text":" "},{"type":"text","text":"window that the system creates from a "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","type":"reference","isActive":true},{"type":"text","text":" declaration. For"},{"type":"text","text":" "},{"type":"text","text":"example, you can request that new windows that a "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"generates occupy 600 points in the x-dimension and 400 points in"},{"type":"text","text":" "},{"type":"text","text":"the y-dimension:"}],"type":"paragraph"},{"code":["@main","struct MyApp: App {","    var body: some Scene {","        WindowGroup {","            ContentView()","        }","        .defaultSize(CGSize(width: 600, height: 400))","    }","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The size that you specify acts only as a default for when the window"},{"type":"text","text":" "},{"type":"text","text":"first appears. People can later resize the window using interface"},{"type":"text","text":" "},{"type":"text","text":"controls that the system provides. Also, during state restoration,"},{"type":"text","text":" "},{"type":"text","text":"the system restores windows to their most recent size rather than"},{"type":"text","text":" "},{"type":"text","text":"the default size."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you specify a default size that’s outside the range of the window’s"},{"text":" ","type":"text"},{"type":"text","text":"inherent resizability in one or both dimensions, the system clamps the"},{"text":" ","type":"text"},{"type":"text","text":"affected dimension to keep it in range. You can configure the"},{"type":"text","text":" "},{"type":"text","text":"resizability of a scene using the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/windowResizability(_:)"},{"text":" ","type":"text"},{"text":"modifier.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The default size modifier affects any scene type that creates windows","type":"text"},{"text":" ","type":"text"},{"text":"in Windows, namely:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup","type":"reference"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window","type":"reference"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"DocumentGroup","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Settings","type":"reference"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you want to specify the input directly in terms of width and height,"},{"type":"text","text":" "},{"text":"use ","type":"text"},{"code":"Scene\/defaultSize(width:height:)","type":"codeVoice"},{"text":" instead.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/openswiftui\/settings\/defaultsize(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","abstract":[{"type":"text","text":"Sets a default size for a window."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Settings\/defaultSize(_:)"},"references":{"doc://OpenSwiftUI/documen