/com.apple.documentation\/documentation\/Swift\/ExpressibleByStringLiteral","type":"text"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Types whose initializers take a "},{"type":"codeVoice","code":"LocalizedStringKey"},{"type":"text","text":" usually have"},{"type":"text","text":" "},{"type":"text","text":"a corresponding initializer that accepts a parameter that conforms to"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Swift\/StringProtocol"},{"type":"text","text":". Passing"},{"type":"text","text":" "},{"type":"text","text":"a "},{"type":"codeVoice","code":"String"},{"type":"text","text":" variable to these initializers avoids localization, which is"},{"type":"text","text":" "},{"type":"text","text":"usually appropriate when the variable contains a user-provided value."}],"type":"paragraph"},{"inlineContent":[{"text":"As a general rule, use a string literal argument when you want","type":"text"},{"text":" ","type":"text"},{"text":"localization, and a string variable argument when you don’t. In the case","type":"text"},{"text":" ","type":"text"},{"text":"where you want to localize the value of a string variable, use the string to","type":"text"},{"text":" ","type":"text"},{"text":"create a new ","type":"text"},{"type":"codeVoice","code":"LocalizedStringKey"},{"text":" instance.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example shows how to create "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text","isActive":true},{"type":"text","text":" instances both"},{"type":"text","text":" "},{"type":"text","text":"with and without localization. The title parameter provided to the"},{"type":"text","text":" "},{"type":"codeVoice","code":"Section"},{"type":"text","text":" is a literal string, so SwiftUI creates a"},{"type":"text","text":" "},{"type":"codeVoice","code":"LocalizedStringKey"},{"type":"text","text":" for it. However, the string entries in the"},{"type":"text","text":" "},{"type":"codeVoice","code":"messageStore.today"},{"type":"text","text":" array are "},{"type":"codeVoice","code":"String"},{"type":"text","text":" variables, so the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text","isActive":true},{"type":"text","text":" views"},{"type":"text","text":" "},{"type":"text","text":"in the list use the string values verbatim."}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["List {","    Section(header: Text(\"Today\")) {","        ForEach(messageStore.today) { message in","            Text(message.title)","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"If the app is localized into Japanese with the following"},{"type":"text","text":" "},{"type":"text","text":"translation of its "},{"type":"codeVoice","code":"Localizable.strings"},{"type":"text","text":" file:"}],"type":"paragraph"},{"type":"codeListing","syntax":"other","code":["\"Today\" = \"今日\";"]},{"inlineContent":[{"text":"When run in Japanese, the example produces a","type":"text"},{"text":" ","type":"text"},{"text":"list like the following, localizing “Today” for the section header, but not","type":"text"},{"text":" ","type":"text"},{"text":"the list items.","type":"text"}],"type":"paragraph"},{"inlineContent":[],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/openswiftui\/localizedstringkey"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/LocalizedStringKey/StringLiteralType":{"role":"symbol","type":"topic","kind":"symbol","abstract":[{"text":"A type that represents a string literal.","type":"text"}],"url":"\/documentation\/openswiftui\/localizedstringkey\/stringliteraltype","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LocalizedStringKey\/StringLit