":" protocol provides scene modifiers, defined as protocol methods"},{"type":"text","text":" "},{"type":"text","text":"with default implementations, that you use to configure a scene. For"},{"type":"text","text":" "},{"type":"text","text":"example, you can use the "},{"type":"codeVoice","code":"OpenSwiftUI\/Scene\/onChange(of:perform:)"},{"type":"text","text":" modifier to"},{"type":"text","text":" "},{"type":"text","text":"trigger an action when a value changes. The following code empties a cache"},{"type":"text","text":" "},{"type":"text","text":"when all of the scenes in the window group have moved to the background:"}]},{"syntax":null,"type":"codeListing","code":["struct MyScene: Scene {","    @Environment(\\.scenePhase) private var scenePhase","    @StateObject private var cache = DataCache()","","    var body: some Scene {","        WindowGroup {","            MyRootView()","        }","        .onChange(of: scenePhase) { newScenePhase in","            if newScenePhase == .background {","                cache.empty()","            }","        }","    }","}"]}],"kind":"content"}],"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/Body-swift.associatedtype"],"generated":true,"title":"Associated Types","anchor":"Associated-Types"},{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/body-swift.property"],"generated":true,"title":"Instance Properties","anchor":"Instance-Properties"},{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/backgroundTask(_:action:)-249fn","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/backgroundTask(_:action:)-4bcuo","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/commands(content:)","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/commandsRemoved()","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/commandsReplaced(cont