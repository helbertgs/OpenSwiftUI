{"metadata":{"modules":[{"name":"OpenSwiftUI"}],"externalID":"s:11OpenSwiftUI5SceneP","symbolKind":"protocol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Scene"}],"title":"Scene","roleHeading":"Protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scene"}]},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"identifier"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You create an "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/App","type":"reference","isActive":true},{"type":"text","text":" by combining one or more instances"},{"type":"text","text":" "},{"type":"text","text":"that conform to the "},{"code":"Scene","type":"codeVoice"},{"type":"text","text":" protocol in the app’s"},{"type":"text","text":" "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/App\/body-swift.property","type":"reference","isActive":true},{"type":"text","text":". You can use the built-in scenes that"},{"type":"text","text":" "},{"type":"text","text":"OpenSwiftUI provides, like "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup","type":"reference","isActive":true},{"type":"text","text":", along with custom scenes"},{"type":"text","text":" "},{"type":"text","text":"that you compose from other scenes. To create a custom scene, declare a"},{"type":"text","text":" "},{"type":"text","text":"type that conforms to the "},{"code":"Scene","type":"codeVoice"},{"type":"text","text":" protocol. Implement the required"},{"type":"text","text":" "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/body-swift.property","type":"reference","isActive":true},{"type":"text","text":" computed property and provide the"},{"type":"text","text":" "},{"type":"text","text":"content for your custom scene:"}]},{"syntax":null,"type":"codeListing","code":["struct MyScene: Scene {","    var body: some Scene {","        WindowGroup {","            MyRootView()","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"A scene acts as a container for a view hierarchy that you want to display","type":"text"},{"text":" ","type":"text"},{"text":"to the user. The system decides when and how to present the view hierarchy","type":"text"},{"text":" ","type":"text"},{"text":"in the user interface in a way that’s platform-appropriate and dependent","type":"text"},{"text":" ","type":"text"},{"text":"on the current state of the app. For example, for the window group shown","type":"text"},{"text":" ","type":"text"},{"text":"above, the system lets the user create or remove windows that contain","type":"text"},{"text":" ","type":"text"},{"code":"MyRootView","type":"codeVoice"},{"text":" on platforms like macOS and iPadOS. On other platforms, the","type":"text"},{"text":" ","type":"text"},{"text":"same view hierarchy might consume the entire display when active.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Read the "},{"code":"OpenSwiftUI\/EnvironmentValues\/scenePhase","type":"codeVoice"},{"type":"text","text":" environment"},{"type":"text","text":" "},{"type":"text","text":"value from within a scene or one of its views to check whether a scene is"},{"type":"text","text":" "},{"type":"text","text":"active or in some other state. You can create a property that contains the"},{"type":"text","text":" "},{"type":"text","text":"scene phase, which is one of the values in the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ScenePhase","isActive":true},{"type":"text","text":" "},{"text":"enumeration, using the ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment","isActive":true,"type":"reference"},{"text":" attribute:","type":"text"}]},{"syntax":null,"type":"codeListing","code":["struct MyScene: Scene {","    @Environment(\\.scenePhase) private var scenePhase","","    \/\/ ...","}"]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"Scene"},{"type":"text","text":" protocol provides scene modifiers, defined as protocol methods"},{"type":"text","text":" "},{"type":"text","text":"with default implementations, that you use to configure a scene. For"},{"type":"text","text":" "},{"type":"text","text":"example, you can use the "},{"type":"codeVoice","code":"OpenSwiftUI\/Scene\/onChange(of:perform:)"},{"type":"text","text":" modifier to"},{"type":"text","text":" "},{"type":"text","text":"trigger an action when a value changes. The following code empties a cache"},{"text":" ","type":"text"},{"text":"when all of the scenes in the window group have moved to the background:","type":"text"}]},{"syntax":null,"type":"codeListing","code":["struct MyScene: Scene {","    @Environment(\\.scenePhase) private var scenePhase","    @StateObject private var cache = DataCache()","","    var body: some Scene {","        WindowGroup {","            MyRootView()","        }","        .onChange(of: scenePhase) { newScenePhase in","            if newScenePhase == .background {","                cache.empty()","            }","        }","    }","}"]}]}],"abstract":[{"type":"text","text":"A part of an app’s user interface with a life cycle managed by the"},{"type":"text","text":" "},{"type":"text","text":"system."}],"topicSections":[{"anchor":"Associated-Types","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/Body-swift.associatedtype"],"title":"Associated Types","generated":true},{"anchor":"Instance-Properties","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/body-swift.property"],"title":"Instance Properties","generated":true},{"anchor":"Insta