{"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scene"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"You create an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/App","type":"reference"},{"text":" by combining one or more instances","type":"text"},{"text":" ","type":"text"},{"text":"that conform to the ","type":"text"},{"code":"Scene","type":"codeVoice"},{"text":" protocol in the app’s","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/App\/body-swift.property","type":"reference"},{"text":". You can use the built-in scenes that","type":"text"},{"text":" ","type":"text"},{"text":"OpenSwiftUI provides, like ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup","type":"reference"},{"text":", along with custom scenes","type":"text"},{"text":" ","type":"text"},{"text":"that you compose from other scenes. To create a custom scene, declare a","type":"text"},{"text":" ","type":"text"},{"text":"type that conforms to the ","type":"text"},{"code":"Scene","type":"codeVoice"},{"text":" protocol. Implement the required","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/body-swift.property","type":"reference"},{"text":" computed property and provide the","type":"text"},{"text":" ","type":"text"},{"text":"content for your custom scene:","type":"text"}]},{"syntax":null,"type":"codeListing","code":["struct MyScene: Scene {","    var body: some Scene {","        WindowGroup {","            MyRootView()","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":