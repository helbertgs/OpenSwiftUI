{"abstract":[{"text":"A part of an app’s user interface with a life cycle managed by the","type":"text"},{"text":" ","type":"text"},{"text":"system.","type":"text"}],"variants":[{"paths":["\/documentation\/openswiftui\/scene"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"kind":"relationships","title":"Conforming Types","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ModifiedContent","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Swift\/Never","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup"],"type":"conformingTypes"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scene"}]}]},{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You create an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/App"},{"type":"text","text":" by combining one or more instances"},{"type":"text","text":" "},{"type":"text","text":"that conform to the "},{"type":"codeVoice","code":"Scene"},{"type":"text","text":" protocol in the app’s"},{"type":"text","text":" "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/App\/body-swift.property","isActive":true,"type":"reference"},{"text":". You can use the built-in scenes that","type":"text"},{"text":" ","type":"text"},{"text":"OpenSwiftUI provides, like ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup","isActive":true,"type":"reference"},{"text":", along with custom scenes","type":"text"},{"text":" ","type":"text"},{"text":"that you compose from other scenes. To create a custom scene, declare a","type":"text"},{"text":" ","type":"text"},{"text":"type that conforms to the ","type":"text"},{"code":"Scene","type":"codeVoice"},{"text":" protocol. Implement the required","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/body-swift.property","isActive":true,"type":"reference"},{"text":" computed property and provide the","type":"text"},{"text":" ","type":"text"},{"text":"content for your custom scene:","type":"text"}]},{"syntax":null,"code":["struct MyScene: Scene {","    var body: some Scene {","        WindowGroup {","            MyRootView()","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A scene acts as a container for a view hierarchy that you want to display"},{"type":"text","text":" "},{"type":"text","text":"to the user. The system decides when and how to present the view hierarchy"},{"type":"text","text":" "},{"type":"text","text":"in the user interface in a way that’s platform-appropriate and dependent"},{"type":"text","text":" "},{"type":"text","text":"on the current state of the app. For example, for the window group shown"},{"type":"text","text":" "},{"type":"text","text":"above, the system lets the user create or remove windows that contain"},{"type":"text","text":" "},{"code":"MyRootView","type":"codeVoice"},{"type":"text","text":" on platforms like macOS and iPadOS. On other platforms, the"},{"type":"text","text":" "},{"type":"text","text":"same view hierarchy might consume the entire display when active."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Read the "},{"type":"codeVoice","code":"OpenSwiftUI\/EnvironmentValues\/scenePhase"},{"type":"text","text":" environment"},{"type":"text","text":" "},{"type":"text","text":"value from within a scene or one of its views to check whether a scene is"},{"type":"text","text":" "},{"type":"text","text":"active or in some other state. You can create a property that contains the"},{"type":"text","text":" "},{"type":"text","text":"scene phase, which is one of the values in the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ScenePhase"},{"type":"text","text":" "},{"type":"text","text":"enumeration, using the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Environment"},{"type":"text","text":" attribute:"}],"type":"paragraph"},{"syntax":null,"code":["struct MyScene: Scene {","    @Environment(\\.scenePhase) private var scenePhase","","    \/\/ ...","}"],"type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"Scene"},{"text":" protocol provides scene modifiers, defined as protocol methods","type":"text"},{"text":" ","type":"text"},{"text":"with default implementations, that you use to configure a scene. For","type":"text"},{"text":" ","type":"text"},{"text":"example, you can use the ","type":"text"},{"type":"codeVoice","code":"OpenSwiftUI\/Scene\/onChange(of:perform:)"},{"text":" modifier to","type":"text"},{"text":" ","type":"text"},{"text":"trigger an action when a value changes. The following code empties a cache","type":"text"},{"text":" ","type":"text"},{"text":"when all of the scenes in the window group have moved to the background:","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["struct MyScene: Scene {","    @Environment(\\.scenePhase) private var scenePhase","    @StateObject private var cache = DataCache()","","    var body: some Scene {","        WindowGroup {","            MyRootView()","        }","        .onChange(of: scenePhase) { newScenePhase in","            if newScenePhase == .background {","                cache.empty()","            }","        }","    }","}"],"type":"codeListing"}],"kind":"content"}],"topicSections":[{"title":"Associated Types","anchor":"Associated-Types","generated":true,"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene\/Body-swift.associatedtype"]},{"title":"Instance Properties","anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/OpenSwiftUI\/documenta