{"abstract":[{"text":"A modifier that you apply to a view or another view modifier, producing a","type":"text"},{"text":" ","type":"text"},{"text":"different version of the original value.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ViewModifier"},"metadata":{"modules":[{"name":"OpenSwiftUI"}],"title":"ViewModifier","roleHeading":"Protocol","role":"symbol","navigatorTitle":[{"text":"ViewModifier","kind":"identifier"}],"externalID":"s:11OpenSwiftUI12ViewModifierP","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ViewModifier","kind":"identifier"}],"symbolKind":"protocol"},"relationshipsSections":[{"kind":"relationships","type":"inheritedBy","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EnvironmentalModifier"],"title":"Inherited By"},{"kind":"relationships","type":"conformingTypes","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/EmptyModifier","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ModifiedContent"],"title":"Conforming Types"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ViewModifier","kind":"identifier"}]}]},{"kind":"content","content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"Adopt the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ViewModifier","type":"reference"},{"text":" protocol when you want to create a reusable","type":"text"},{"text":" ","type":"text"},{"text":"modifier that you can apply to any view. The example below combines several","type":"text"},{"text":" ","type":"text"},{"text":"modifiers to create a new modifier that you can use to create blue caption","type":"text"},{"text":" ","type":"text"},{"text":"text surrounded by a rounded rectangle:","type":