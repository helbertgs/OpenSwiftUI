"text","text":". With that strategy, "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Settings"},{"type":"text","text":" "},{"type":"text","text":"windows use the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowResizability\/contentSize"},{"type":"text","text":" strategy, while"},{"type":"text","text":" "},{"type":"text","text":"all others use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowResizability\/contentMinSize"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/openswiftui\/windowresizability"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/WindowResizability":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowResizability","url":"\/documentation\/openswiftui\/windowresizability","title":"WindowResizability","role":"symbol","abstract":[{"type":"text","text":"The resizability of a window."}],"type":"topic","kind":"symbol","navigatorTitle":[{"text":"WindowResizability","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WindowResizability","kind":"identifier"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/WindowResizability/contentMinSize":{"url":"\/documentation\/openswiftui\/windowresizability\/contentminsize","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"contentMinSize"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSwiftUI18WindowResizabilityV","kind":"typeIdentifier","text":"WindowResizability"}],"type":"topic","abstract":[{"type":"text","text":"A window resizability that’s partially derived from the window’s"},{"type":"text","text":" "},{"type":"text","text"