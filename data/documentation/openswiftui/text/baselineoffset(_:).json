tent":[{"level":2,"anchor":"return-value","type":"heading","text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Text that’s above or below its baseline."}]}],"kind":"content"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Change the baseline offset to move the text in the view (in points) up"},{"type":"text","text":" "},{"type":"text","text":"or down relative to its baseline. The bounds of the view expand to"},{"type":"text","text":" "},{"type":"text","text":"contain the moved text."}]},{"type":"codeListing","syntax":null,"code":["HStack(alignment: .top) {","    Text(\"Hello\")","        .baselineOffset(-10)","        .border(Color.red)","    Text(\"Hello\")","        .border(Color.green)","    Text(\"Hello\")","        .baselineOffset(10)","        .border(Color.blue)","}",".background(Color(white: 0.9))"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"By drawing a border around each text view, you can see how the text"},{"type":"text","text":" "},{"type":"text","text":"moves, and how that affects the view."}]},{"type":"paragraph","inlineContent":[]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The first view, with a negative offset, grows downward to handle the"},{"type":"text","text":" "},{"type":"text","text":"lowered text. The last view, with a positive offset, grows upward. The"},{"type":"text","text":" "},{"type":"text","text":"enclosing "},{"type":"codeVoice","code":"HStack"},{"type":"text","text":" instance, shown in gray, ensures all the text views"},{"type":"text","text":" "},{"type":"text","text":"remain aligned at their top edge, regardless of the offset."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/openswiftui\/text\/baselineoffset(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/docume