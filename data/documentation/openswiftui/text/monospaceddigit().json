 of the text view doesn’t support fixed-width digits,","type":"text"},{"text":" ","type":"text"},{"text":"the font remains unchanged.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/text\/monospaceddigit()"]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/VStack":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/VStack","url":"\/documentation\/openswiftui\/vstack","title":"VStack","role":"symbol","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A view that arranges its subviews in a vertical line."}],"navigatorTitle":[{"text":"VStack","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VStack","kind":"identifier"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Text/monospacedDigit()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"monospacedDigit"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Text","preciseIdentifier":"s:11OpenSwiftUI4TextV"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text\/monospacedDigit()","role":"symbol","abstract":[{"type":"text","text":"Modifies the text view’s font to use fixed-width digits, while leaving"},{"type":"text","text":" "},{"type":"text","text":"other characters proportionally spaced."}],"title":"monospacedDigit()","url":"\/documentation\/openswiftui\/text\/monospaceddigit()","kind":"symbol","type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Text":{"url":"\/documentation\/openswiftui\/text","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text","title":"Text","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A view that displays one or more lines of read-only text."}],"navigatorTitle":[{"kind":"identifier","text":"Text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":