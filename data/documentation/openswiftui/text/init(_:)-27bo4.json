cts ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/AttributeScopes\/FoundationAttributes\/writingDirection","type":"text"},{"text":" ","type":"text"},{"text":"and renders the","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/Foundation\/AttributeScopes\/FoundationAttributes\/3764633-link","type":"text"},{"text":" ","type":"text"},{"text":"attribute as a clickable link. ","type":"text"},{"code":"Text","type":"codeVoice"},{"text":" ignores any other","type":"text"},{"text":" ","type":"text"},{"text":"Foundation-defined attributes in an attributed string.","type":"text"}],"type":"paragraph"}]},{"type":"heading","text":"OpenSwiftUI attributes","anchor":"OpenSwiftUI-attributes","level":3},{"type":"paragraph","inlineContent":[{"text":"OpenSwiftUI also defines additional attributes in the attribute scope","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/AttributeScopes\/SwiftUIAttributes","type":"text"},{"text":" ","type":"text"},{"text":"which you can access from an attributed string’s","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/AttributeScopes\/3788543-OpenSwiftUI","type":"text"},{"text":" ","type":"text"},{"text":"property. OpenSwiftUI attributes take precedence over equivalent attributes","type":"text"},{"text":" ","type":"text"},{"text":"from other frameworks, such as","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/AttributeScopes\/UIKitAttributes","type":"text"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/AttributeScopes\/AppKitAttributes","type":"text"},{"text":".","type":"text"}]},{"type":"heading","text":"Markdown support","anchor":"Markdown-support","level":3},{"type":"paragraph","inlineContent":[{"text":"You can create an ","type":"text"},{"code":"AttributedString","type":"codeVoice"},{"text":" with Markdown syntax, which allows","type":"text"},{"text":" ","type":"text"},{"text":"you to style distinct runs within a ","type":"text"},{"code":"Text","type":"codeVoice"},{"text":" view:","type":"text"}]},{"type":"codeListing","code":["let content = try! AttributedString(","    markdown: \"**Thank You!** Please visit our [website](http:\/\/example.com).\")","","var body: some View {","    Text(content)","}"],"syntax":null},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"**","type":"codeVoice"},{"text":" syntax around “Thank You!” applies an","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/AttributeScopes\/FoundationAttributes\/3796123-inlinePresentationIntent","type":"text"},{"text":" ","type":"text"},{"text":"attribute with the value","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/InlinePresentationIntent\/3746899-stronglyEmphasized","type":"text"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"OpenSwiftUI renders this as","type":"text"},{"text":" ","type":"text"},{"text":"bold text, as described earlier. The link syntax around “website”","type":"text"},{"text":" ","type":"text"},{"text":"creates a","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/AttributeScopes\/FoundationAttributes\/3764633-link","type":"text"},{"text":" ","type":"text"},{"text":"attribute, which ","type":"text"},{"code":"Text","type":"codeVoice"},{"text":" styles to indicate it’s a link; by default,","type":"text"},{"text":" ","type":"text"},{"text":"clicking or tapping the link opens the linked URL in the user’s default","type":"text"},{"text":" ","type":"text"},{"text":"browser. Alternatively, you can perform custom link handling by putting","type":"text"},{"text":" ","type":"text"},