{"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"symbolKind":"init","role":"symbol","extendedModule":"OpenSwiftUI","title":"init(_:)","roleHeading":"Initializer","externalID":"s:11OpenSwiftUI4TextVyAC10Foundation16AttributedStringVcfc","modules":[{"name":"OpenSwiftUI"}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation16AttributedStringV","text":"AttributedString"},{"kind":"text","text":")"}]},"abstract":[{"type":"text","text":"Creates a text view that displays styled attributed content."}],"sections":[],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text"]]},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text\/init(_:)-27bo4"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/text\/init(_:)-27bo4"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"attributedContent","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"AttributedString","preciseIdentifier":"s:10Foundation16AttributedStringV","kind":"typeIdentifier"},{"text":")","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"An attributed string to style and display,","type":"text"},{"text":" ","type":"text"},{"text":"in accordance with its attributes.","type":"text"}]}],"name":"attributedContent"}]},{"kind":"content","content":[{"anchor":"Format-text-by-combining-attributes-and-view-modifiers","level":3,"text":"Format text by combining attributes and view modifiers","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this initializer to style text according to attributes found in the specified"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/AttributedString"},{"type":"text","text":"."},{"type":"text","text":" "},{"text":"Attributes in the attributed string take precedence over styles added by","type":"text"},{"text":" ","type":"text"},{"text":"view modifiers. For example, the attributed text in the following","type":"text"},{"text":" ","type":"text"},{"text":"example appears in blue, despite the use of the ","type":"text"},{"code":"View\/foregroundColor(_:)","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"modifier to use red throughout the enclosing "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/VStack","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","code":["var content: AttributedString {","    var attributedString = AttributedString(\"Blue text\")","    attributedString.foregroundColor = .blue","    return attributedString","}","","var body: some View {","    VStack {","        Text(content)","        Text(\"Red text\")","    }","    .foregroundColor(.red)","}"],"syntax":null},{"inlineContent":[],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"OpenSwiftUI combines text attributes with OpenSwiftUI modifiers whenever","type":"text"},{"text":" ","type":"text"},{"text":"possible. For example, the following listing creates text that is","type":"text"},{"text":" ","type":"text"},{"text":"both bold and red:","type":"text"}]},{"type":"codeListing","code":["var content: AttributedString {","    var content = AttributedString(\"Some text\")","    content.inlinePresentationIntent = .stronglyEmphasized","    return content","}","","var body: some View {","    Text(content).foregroundColor(Color.red)","}"],"syntax":null},{"type":"heading","text":"Supported Foundation attributes","anchor":"Supported-Foundation-attributes","level":3},{"type":"par