{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text\/init(_:)-27bo4"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/text\/init(_:)-27bo4"]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"attributedContent"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10Foundation16AttributedStringV","kind":"typeIdentifier","text":"AttributedString"},{"kind":"text","text":")"}]}],"kind":"declarations"},{"parameters":[{"name":"attributedContent","content":[{"inlineContent":[{"text":"An attributed string to style and display,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"in accordance with its attributes."}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"content","content":[{"anchor":"Format-text-by-combining-attributes-and-view-modifiers","level":3,"text":"Format text by combining attributes and view modifiers","type":"heading"},{"inlineContent":[{"type":"text","text":"Use this initializer to style text according to attributes found in the specified"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/AttributedString"},{"type":"text","text":"."},{"type":"text","text":" "},{"text":"Attributes in the attributed string take precedence over styles added by","type":"text"},{"type":"text","text":" "},{"type":"text","text":"view modifiers. For example, the attributed text in the following"},{"type":"text","text":" "},{"type":"text","text":"example appears in blue, despite the use of the "},{"code":"View\/foregroundColor(_:)","type":"codeVoice"},{"type":"text","text":" "},{"text":"modifier to use red throughout the enclosing ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/VStack"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["var content: AttributedString {","    var attributedString = AttributedString(\"Blue text\")","    attributedString.foregroundColor = .blue","    return attributedString","}","","var body: some View {","    VStack {","        Text(content)","        Text(\"Red text\")","    }","    .foregroundColor(.red)","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[],"type":"paragraph"},{"inlineContent":[{"text":"OpenSwiftUI combines text attributes with OpenSwiftUI modifiers whenever","type":"text"},{"text":" ","type":"text"},{"text":"possible. For example, the following listing creates text that is","type":"text"},{"text":" ","type":"text"},{"text":"both bold and red:","type":"text"}],"type":"paragraph"},{"code":["var content: AttributedString {","    var content = AttributedString(\"Some text\")","    content.inlinePresentationIntent = .stronglyEmphasized","    return content","}","","var body: some View {","    Text(content).foregroundColor(Color.red)","}"],"syntax":null,"type":"codeListing"},{"anchor":"Supported-Foundation-attributes","level":3,"type":"heading","text":"Supported Foundation attributes"},{"inlineContent":[{"text":"A OpenSwiftUI ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text"},{"type":"text","text":" view renders most of the styles defined by the"},{"type":"text","text":" "},{"text":"Foundation attribute","type":"text"},{"type":"text","text":" "},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/AttributeScopes\/FoundationAttributes\/3796123-inlinePresentationIntent","type":"text"},{"text":", like the","type":"text"},{"type":"text","text":" "},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/InlinePresentationIntent\/3746899-stronglyEmphasized","type":"text"},{"type":"text","text":" "},{"text":"value, which OpenSwiftUI presents as bold text.","type":"text"}],"type":"paragraph"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text"},{"type":"text","text":" uses only a subset of the attributes defined in"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/AttributeScopes\/FoundationAttributes"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"codeVoice","code":"Text"},{"type":"text","text":" renders all"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/InlinePresentationIntent"},{"type":"text","text":" "},{"type":"text","text":"attributes except for"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/InlinePresentationIntent\/3787563-lineBreak"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/InlinePresentationIntent\/3787564-softBreak"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"It also respects "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/AttributeScopes\/FoundationAttributes\/writingDirection"},{"type":"text","text":" "},{"text":"and renders the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/Foundation\/AttributeScopes\/FoundationAttributes\/3764633-link"},{"type":"text","text":" "},{"text":"attribute as a clickable link. ","type":"text"},{"type":"codeVoice","code":"Text"},{"type":"text","text":" ignores any other"},{"type":"text","text":" "},{"type":"text","text":"Foundation-defined attributes in an attributed string."}],"type":"paragraph"}],"name":"Important","style":"important"},{"level":3,"text":"OpenSwiftUI attributes","type":"heading","anchor":"OpenSwiftUI-attributes"},{"inlineContent":[{"type":"text","text":"OpenSwiftUI also defines additional attributes in the attribute scope"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/AttributeScopes\/SwiftUIAttributes"},{"type":"text","text":" "},{"type":"text","text":"which you can access from an attributed string’s"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/AttributeScopes\/3788543-OpenSwiftUI"},{"type":"text","text":" "},{"type":"text","text":"property. OpenSwiftUI attributes take precedence over equivalent attributes"},{"type":"text","text":" "},{"type":"text","text":"from other frameworks, such as"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/AttributeScopes\/UIKitAttributes"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/AttributeScopes\/AppKitAttributes"},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"text":"Markdown support","type":"heading","anchor":"Markdown-support"},{"inlineContent":[{"type":"text","text":"You can create an "},{"code":"AttributedString","type":"codeVoice"},{"type":"text","text":" with Markdown syntax, which allows"},{"type":"text","text":" "},{"type":"text","text":"you to style distinct runs within a "},{"code":"Text","type":"codeVoice"},{"type":"text","text":" view:"}],"type":"paragraph"},{"code":["let content = try! AttributedString(","    markdown: \"**Thank You!** Please visit our [website](http:\/\/example.com).\")","","var body: some View {","    Text(content)","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The "},{"code":"**","type":"codeVoice"},{"type":"text","text":" syntax around “Thank You!” applies an"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/AttributeScopes\/FoundationAttributes\/3796123-inlinePresentationIntent"},{"type":"text","text":" "},{"type":"text","text":"attribute with the value"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/InlinePresentationIntent\/3746899-stronglyEmphasized"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"OpenSwiftUI renders this as"},{"type":"text","text":" "},{"type":"text","text":"bold text, as described earlier. The link syntax around “website”"},{"type":"text","text":" "},{"type":"text","text":"creates a"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/AttributeScopes\/FoundationAttributes\/3764633-link"},{"type":"text","text":" "},{"type":"text","text":"attribute, which "},{"code":"Text","type":"codeVoice"},{"type":"text","text":" styles to indicate it’s a link; by default,"},{"type":"text","text":" "},{"type":"text","text":"clicking or tapping the link opens the linked URL in the user’s default"},{"type":"text","text":" "},{"type":"text","text":"browser. Alternatively, you can perform custom link handling by putting"},{"type":"text","text":" "},{"type":"text","text":"an "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction","type":"reference","isActive":true},{"type":"text","text":" in the text view’s environment."}],"type":"paragraph"},{"inlineContent":[],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can also use Markdown syntax in localized string keys, which means"},{"type":"text","text":" "},{"text":"you can write the above example without needing to explicitly create","type":"text"},{"type":"text","text":" "},{"text":"an ","type":"text"},{"type":"codeVoice","code":"AttributedString"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["var body: some View {","    Text(\"**Thank You!** Please visit our [website](https:\/\/example.com).\")","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"In your app’s strings files, use Markdown syntax to apply styling","type":"text"},{"type":"text","text":" "},{"type":"text","text":"to the app’s localized strings. You also use this approach when you want"},{"type":"text","text":" "},{"type":"text","text":"to perform automatic grammar agreement on localized strings, with"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"^[text](inflect:true)","type":"codeVoice"},{"text":" syntax.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For details about Markdown syntax support in OpenSwiftUI, see","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text\/init(_:tableName:bundle:comment:)"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Applying-a-custom-text-formatting-definition","level":3,"type":"heading","text":"Applying a custom text formatting definition"},{"inlineContent":[{"text":"Use the ","type":"text"},{"code":"View\/attributedTextFormattingDefinition(_:)-(D)","type":"codeVoice"},{"text":" modifier to","type":"text"},{"text":" ","type":"text"},{"text":"apply a custom ","type":"text"},{"code":"AttributedTextFormattingDefinition","type":"codeVoice"},{"text":" to text created","type":"text"},{"text":" ","type":"text"},{"text":"using this initializer. This will result in the text only applying","type":"text"},{"text":" ","type":"text"},{"text":"attributes in the definition’s attribute scope and constraining","type":"text"},{"text":" ","type":"text"},{"text":"attributes according to the definition’s value constraints prior to","type":"text"},{"text":" ","type":"text"},{"text":"display.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Custom attributes listed in the definition’s","type":"text"},{"text":" ","type":"text"},{"code":"AttributedTextFormattingDefinition\/Scope","type":"codeVoice"},{"text":", where the","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/AttributedStringKey\/Value","type":"text"},{"text":" ","type":"text"},{"text":"conforms to the ","type":"text"},{"code":"TextAttribute","type":"codeVoice"},{"text":" protocol, can be read when observing","type":"text"},{"text":" ","type":"text"},{"text":"the text’s layout using ","type":"text"},{"code":"Text\/Layout\/Run\/subscript(key:)->T?","type":"codeVoice"},{"text":", just","type":"text"},{"text":" ","type":"text"},{"text":"as text attributes applied using the ","type":"text"},{"code":"Text\/customAttribute(_:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"modifier.","type":"text"}],"type":"paragraph"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation16AttributedStringV","text":"AttributedString"},{"kind":"text","text":")"}],"modules":[{"name":"OpenSwiftUI"}],"title":"init(_:)","role":"symbol","extendedModule":"OpenSwiftUI","roleHeading":"Initializer","symbolKind":"init","externalID":"s:11OpenSwiftUI4TextVyAC10Foundation16AttributedStringVcfc"},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text"]]},"kind":"symbol","abstract":[{"type":"text","text":"Creates a text view that displays styled attributed content."}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","abstract":[],"title":"OpenSwiftUI","url":"\/documentation\/openswiftui","kind":"symbol","type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Text":{"url":"\/documentation\/openswiftui\/text","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text","title":"Text","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text"