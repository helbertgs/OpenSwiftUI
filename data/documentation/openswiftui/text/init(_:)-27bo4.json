{"abstract":[{"type":"text","text":"Creates a text view that displays styled attributed content."}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/text\/init(_:)-27bo4"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"symbolKind":"init","roleHeading":"Initializer","externalID":"s:11OpenSwiftUI4TextVyAC10Foundation16AttributedStringVcfc","modules":[{"name":"OpenSwiftUI"}],"role":"symbol","title":"init(_:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"AttributedString","preciseIdentifier":"s:10Foundation16AttributedStringV","kind":"typeIdentifier"},{"text":")","kind":"text"}],"extendedModule":"OpenSwiftUI"},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text\/init(_:)-27bo4","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"attributedContent","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"AttributedString","preciseIdentifier":"s:10Foundation16AttributedStringV","kind":"typeIdentifier"},{"text":")","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"attributedContent","content":[{"inlineContent":[{"type":"text","text":"An attributed string to style and display,"},{"type":"text","text":" "},{"type":"text","text":"in accordance with its attributes."}],"type":"paragraph"}]}]},{"content":[{"type":"heading","level":3,"text":"Format text by combining attributes and view modifiers","anchor":"Format-text-by-combining-attributes-and-view-modifiers"},{"type":"paragraph","inlineContent":[{"text":"Use this initializer to style text according to attributes found in the specified","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/AttributedString","type":"text"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Attributes in the attributed string take precedence over styles added by","type":"text"},{"text":" ","type":"text"},{"text":"view modifiers. For example, the attributed text in the following","type":"text"},{"text":" ","type":"text"},{"text":"example appears in blue, despite the use of the ","type":"text"},{"code":"View\/foregroundColor(_:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"modifier to use red throughout the enclosing ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/VStack"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":null,"code":["var content: AttributedString {","    var attributedString = AttributedString(\"Blue text\")","    attributedString.foregroundColor = .blue","    return attributedString","}","","var body: some View {","    VStack {","        Text(content)","        Text(\"Red text\")","    }","    .foregroundColor(.red)","}"]},{"type":"paragraph","inlineContent":[]},{"type":"paragraph","inlineContent":[{"text":"OpenSwiftUI combines text attributes with OpenSwiftUI modifiers whenever","type":"text"},{"text":" ","type":"text"},{"text":"possible. For example, the following listing creates text that is","type":"text"},{"text":" ","type":"text"},{"text":"both bold and red:","type":"text"}]},{"type":"codeListing","syntax":null,"code":["var content: AttributedString {","    var content = AttributedString(\"Some text\")","    content.inlinePresentationIntent = .stronglyEmphasized","    return content","}","","var body: some View {","    Text(content).foregroundColor(Color.red)","}"]},{"type":"heading","level":3,"text":"Supported Foundation attributes","anchor":"Supported-Foundation-attributes"},{"type":"paragraph","inlineContent":[{"text":"A OpenSwiftUI ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text"},{"text":" view renders most of the styles defined by the","type":"text"},{"text":" ","type":"text"},{"text":"Foundation attribute","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/AttributeScopes\/FoundationAttributes\/3796123-inlinePresentationIntent","type":"text"},{"text":", like the","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/InlinePresentationIntent\/3746899-stronglyEmphasized","type":"text"},{"text":" ","type":"text"},{"text":"value, which OpenSwiftUI presents as bold text.","type":"text"}]},{"type":"aside","style":"important","name":"Important","content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text","isActive":true},{"type":"text","text":" uses only a subset of the attributes defined in"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/AttributeScopes\/FoundationAttributes"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"codeVoice","code":"Text"},{"type":"text","text":" renders all"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/InlinePresentationIntent"},{"type":"text","text":" "},{"type":"text","text":"attributes except for"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/InlinePresentationIntent\/3787563-lineBreak"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/InlinePresentationIntent\/3787564-softBreak"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"It also respects "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/AttributeScopes\/FoundationAttributes\/writingDirection"},{"type":"text","text":" "},{"type":"text","text":"and renders the"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/Foundation\/AttributeScopes\/FoundationAttributes\/3764633-link"},{"type":"text","text":" "},{"type":"text","text":"attribute as a clickable link. "},{"type":"codeVoice","code":"Text"},{"type":"text","text":" ignores any other"},{"type":"text","text":" "},{"type":"text","text":"Foundation-defined attributes in an attributed string."}],"type":"paragraph"}]},{"type":"heading","level":3,"text":"OpenSwiftUI attributes","anchor":"OpenSwiftUI-attributes"},{"type":"paragraph","inlineContent":[{"text":"OpenSwiftUI also defines additional attributes in the attribute scope","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/AttributeScopes\/SwiftUIAttributes","type":"text"},{"text":" ","type":"text"},{"text":"which you can access from an attributed string’s","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/AttributeScopes\/3788543-OpenSwiftUI","type":"text"},{"text":" ","type":"text"},{"text":"property. OpenSwiftUI attributes take precedence over equivalent attributes","type":"text"},{"text":" ","type":"text"},{"text":"from other frameworks, such as","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/AttributeScopes\/UIKitAttributes","type":"text"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/AttributeScopes\/AppKitAttributes","type":"text"},{"text":".","type":"text"}]},{"type":"heading","level":3,"text":"Markdown support","anchor":"Markdown-support"},{"type":"paragraph","inlineContent":[{"text":"You can create an ","type":"text"},{"code":"AttributedString","type":"codeVoice"},{"text":" with Markdown syntax, which allows","type":"text"},{"text":" ","type":"text"},{"text":"you to style distinct runs within a ","type":"text"},{"code":"Text","type":"codeVoice"},{"text":" view:","type":"text"}]},{"type":"codeListing","syntax":null,"code":["let content = try! AttributedString(","    markdown: \"**Thank You!** Please visit our [website](http:\/\/example.com).\")","","var body: some View {","    Text(content)","}"]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"**","type":"codeVoice"},{"text":" syntax around “Thank You!” applies an","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/AttributeScopes\/FoundationAttributes\/3796123-inlinePresentationIntent","type":"text"},{"text":" ","type":"text"},{"text":"attribute with the value","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/InlinePresentationIntent\/3746899-stronglyEmphasized","type":"text"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"OpenSwiftUI renders this as","type":"text"},{"text":" ","type":"text"},{"text":"bold text, as described earlier. The link syntax around “website”","type":"text"},{"text":" ","type":"text"},{"text":"creates a","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/AttributeScopes\/FoundationAttributes\/3764633-link","type":"text"},{"text":" ","type":"text"},{"text":"attribute, which ","type":"text"},{"code":"Text","type":"codeVoice"},{"text":" styles to indicate it’s a link; by default,","type":"text"},{"text":" ","type":"text"},{"text":"clicking or tapping the link opens the linked URL in the user’s default","type":"text"},{"text":" ","type":"text"},{"text":"browser. Alternatively, you can perform custom link handling by putting","type":"text"},{"text":" ","type":"text"},{"text":"an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/OpenURLAction"},{"text":" in the text view’s environment.","type":"text"}]},{"type":"paragraph","inlineContent":[]},{"type":"paragraph","inlineContent":[{"text":"You can also use Markdown syntax in localized string keys, which means","type":"text"},{"text":" ","type":"text"},{"text":"you can write the above example without needing to explicitly create","type":"text"},{"text":" ","type":"text"},{"text":"an ","type":"text"},{"code":"AttributedString","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":null,"code":["var body: some View {","    Text(\"**Thank You!** Please visit our [website](https:\/\/example.com).\")","}"]},{"type":"paragraph","inlineContent":[{"text":"In your app’s strings files, use Markdown syntax to apply styling","type":"text"},{"text":" ","type":"text"},{"text":"to the app’s localized strings. You also use this approach when you want","type":"text"},{"text":" ","type":"text"},{"text":"to perform automatic grammar agreement on localized strings, with","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"^[text](inflect:true)","type":"codeVoice"},{"text":" syntax.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For details about Markdown syntax support in OpenSwiftUI, see","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text\/init(_:tableName:bundle:comment:)"},{"type":"text","text":"."}]},{"type":"heading","level":3,"text":"Applying a custom text formatting definition","anchor":"Applying-a-custom-text-formatting-definition"},{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"code":"View\/attributedTextFormattingDefinition(_:)-(D)","type":"codeVoice"},{"text":" modifier to","type":"text"},{"text":" ","type":"text"},{"text":"apply a custom ","type":"text"},{"code":"AttributedTextFormattingDefinition","type":"codeVoice"},{"text":" to text created","type":"text"},{"text":" ","type":"text"},{"text":"using this initializer. This will result in the text only applying","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"attributes in the definition’s attribute scope and constraining"},{"type":"text","text":" "},{"type":"text","text":"attributes according to the definition’s value constraints prior to"},{"text":" ","type":"text"},{"type":"text","text":"display."}]},{"inlineContent":[{"type":"text","text":"Custom attributes listed in the definition’s"},{"type":"text","text":" "},{"code":"AttributedTextFormattingDefinition\/Scope","type":"codeVoice"},{"type":"text","text":", where the"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/AttributedStringKey\/Value"},{"type":"text","text":" "},{"type":"text","text":"conforms to the "},{"code":"TextAttribute","type":"codeVoice"},{"type":"text","text":" protocol, can be read when observing"},{"type":"text","text":" "},{"type":"text","text":"the text’s layout using "},{"type":"codeVoice","code":"Text\/Layout\/Run\/subscript(key:)->T?"},{"type":"text","text":", just"},{"type":"text","text":" "},{"type":"text","text":"as text attributes applied using the "},{"code":"Text\/customAttribute(_:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"modifier."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","type":"topic","kind":"symbol","abstract":[],"title":"OpenSwiftUI","url":"\/documentation\/openswiftui"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Text/init(_:)-27bo4":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text\/init(_:)-27bo4","role":"symbol","kind":"symbol","type":"topic","abstract":[{"text":"Creates a text view that displays style