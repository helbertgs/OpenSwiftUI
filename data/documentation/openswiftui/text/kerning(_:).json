with the specified amount of kerning."}]}],"kind":"content"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Kerning defines the offset, in points, that a text view should shift"},{"type":"text","text":" "},{"text":"characters from the default spacing. Use positive kerning to widen the","type":"text"},{"text":" ","type":"text"},{"text":"spacing between characters. Use negative kerning to tighten the spacing","type":"text"},{"text":" ","type":"text"},{"text":"between characters.","type":"text"}]},{"type":"codeListing","syntax":null,"code":["VStack(alignment: .leading) {","    Text(\"ABCDEF\").kerning(-3)","    Text(\"ABCDEF\")","    Text(\"ABCDEF\").kerning(3)","}"]},{"type":"paragraph","inlineContent":[{"text":"The last character in the first case, which uses negative kerning,","type":"text"},{"text":" ","type":"text"},{"text":"experiences cropping because the kerning affects the trailing edge of","type":"text"},{"text":" ","type":"text"},{"text":"the text view as well.","type":"text"}]},{"type":"paragraph","inlineContent":[]},{"type":"paragraph","inlineContent":[{"text":"Kerning attempts to maintain ligatures. For example, the Hoefler Text","type":"text"},{"text":" ","type":"text"},{"text":"font uses a ligature for the letter combination ","type":"text"},{"inlineContent":[{"type":"text","text":"ffl"}],"type":"emphasis"},{"text":", as in the word","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"raffle"}],"type":"emphasis"},{"text":", shown here with a small negative and a small positive kerning:","type":"text"}]},{"type":"paragraph","inlineContent":[]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"inlineContent":[{"type":"text","text":"ffl"}],"type":"emphasis"},{"text":" letter combination keeps a constant shape as the other letters","type":"text"},{"text":" ","type":"text"},{"text":"move together or apart. Beyond a certain point in either direction,","type":"text"},{"text":" ","type":"text"},{"text":"however, kerning does disable nonessential ligatures.","type":"text"}]},{"type":"paragraph","inlineContent":[]},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"If you add both the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text\/tracking(_:)","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text\/kerning(_:)","isActive":true},{"type":"text","text":" modifiers to a view, the view applies the"},{"type":"text","text":" "},{"type":"text","text":"tracking and ignores the kerning."}],"type":"paragraph"}],"style":"important","name":"Important"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text\/kerning(_:)"},"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text"]]},"abstract":[{"text":"Sets the spacing, or kerning, between characters.","type":"text"}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Text/kerning(_:)":{"kind":"symbol","url":"\/documentation\/openswiftui\/text\/kerning(_:)","abstract":[{"type":"text","text":"Sets the spacing, or kerning, between characters."}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text\/kerning(_:)","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kerning"},{"kind":"text","text":"("},{"preciseIdentifier":"s:14CoreFoundation7CGFloatV","kind":"typeIdentifier","text":"CGFloat"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:11OpenSwiftUI4TextV","kind":"typeIdentifier","text":"Text"}],"title":"kerning(_:)"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Text/tracking(_:)":{"fragments":[{"kind":"