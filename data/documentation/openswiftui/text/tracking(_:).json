{"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text\/tracking(_:)","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/openswiftui\/text\/tracking(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"nonisolated"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"tracking"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"tracking"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"CGFloat","preciseIdentifier":"s:14CoreFoundation7CGFloatV"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:11OpenSwiftUI4TextV","kind":"typeIdentifier","text":"Text","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The amount of additional space, in points, that","type":"text"},{"text":" ","type":"text"},{"text":"the view should add to each character cluster after layout. Value of ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" ","type":"text"},{"text":"sets the tracking to the system default value.","type":"text"}]}],"name":"tracking"}]},{"kind":"content","content":[{"anchor":"return-value","level":2,"text":"Return Value","type":"heading"},{"inlineContent":[{"type":"text","text":"Text with the specified amount of tracking."}],"type":"paragraph"}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Tracking adds space, measured in points, between the characters in the"},{"type":"text","text":" "},{"type":"text","text":"text view. A positive value increases the spacing between characters,"},{"type":"text","text":" "},{"type":"text","text":"while a negative value brings the characters closer together."}],"type":"paragraph"},{"syntax":null,"code":["VStack(alignment: .leading) {","    Text(\"ABCDEF\").tracking(-3)","    Text(\"ABCDEF\")","    Text(\"ABCDEF\").tracking(3)","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The code above uses an unusually large amount of tracking to make it"},{"type":"text","text":" "},{"type":"text","text":"easy to see the effect."}],"type":"paragraph"},{"inlineContent":[],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The effect of tracking resembles that of the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text\/kerning(_:)"},{"type":"text","text":" "},{"type":"text","text":"modifier, but adds or removes trailing whitespace, rather than changing"},{"type":"text","text":" "},{"type":"text","text":"character offsets. Also, using any nonzero amount of tracking disables"},{"type":"text","text":" "},{"type":"text","text":"nonessential ligatures, whereas kerning attempts to maintain ligatures."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"If you add both the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text\/tracking(_:)"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text\/kerning(_:)"},{"text":" modifiers to a view, the view applies the","type":"text"},{"text":" ","type":"text"},{"text":"tracking and ignores the kerning.","type":"text"}]}],"name":"Important","style":"important","type":"aside"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text"]]},"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"k