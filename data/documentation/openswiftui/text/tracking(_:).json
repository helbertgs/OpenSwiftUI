{"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"nonisolated","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tracking","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"tracking","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:14CoreFoundation7CGFloatV","text":"CGFloat","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text","preciseIdentifier":"s:11OpenSwiftUI4TextV","text":"Text","kind":"typeIdentifier"}],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The amount of additional space, in points, that"},{"type":"text","text":" "},{"type":"text","text":"the view should add to each character cluster after layout. Value of "},{"type":"codeVoice","code":"0"},{"type":"text","text":" "},{"type":"text","text":"sets the tracking to the system default value."}],"type":"paragraph"}],"name":"tracking"}]},{"kind":"content","content":[{"level":2,"text":"Return Value","anchor":"return-value","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Text with the specified amount of tracking.","type":"text"}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Tracking adds space, measured in points, between the characters in the","type":"text"},{"text":" ","type":"text"},{"text":"text view. A positive value increases the spacing between characters,","type":"text"},{"text":" ","type":"text"},{"text":"while a negative value brings the characters closer together.","type":"text"}]},{"code":["VStack(alignment: .leading) {","    Text(\"ABCDEF\").tracking(-3)","    Text(\"ABCDEF\")","    Text(\"ABCDEF\").tracking(3)","}"],"syntax":