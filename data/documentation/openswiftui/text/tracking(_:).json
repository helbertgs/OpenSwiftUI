{"abstract":[{"text":"Sets the tracking for the text.","type":"text"}],"kind":"symbol","variants":[{"paths":["\/documentation\/openswiftui\/text\/tracking(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"symbolKind":"method","externalID":"s:11OpenSwiftUI4TextV8trackingyAC14CoreFoundation7CGFloatVF","roleHeading":"Instance Method","modules":[{"name":"OpenSwiftUI"}],"role":"symbol","title":"tracking(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tracking","kind":"identifier"},{"text":"(","kind":"text"},{"text":"CGFloat","kind":"typeIdentifier","preciseIdentifier":"s:14CoreFoundation7CGFloatV"},{"text":") -> ","kind":"text"},{"text":"Text","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI4TextV"}],"extendedModule":"OpenSwiftUI"},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text\/tracking(_:)"},"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"nonisolated","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tracking","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"tracking","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"CGFloat","kind":"typeIdentifier","preciseIdentifier":"s:14CoreFoundation7CGFloatV"},{"text":") -> ","kind":"text"},{"text":"Text","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI4TextV","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"tracking","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The amount of additional space, in points, that"},{"type":"text","text":" "},{"type":"text","text":"the view should add to each character cluster after layout. Value of "},{"type":"codeVoice","code":"0"},{"type":"text","text":" "},{"type":"text","text":"sets the tracking to the system default value."}]}]}]},{"kind":"content","content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Text with the specified amount of tracking."}],"type":"paragraph"}]},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Tracking adds space, measured in points, between the characters in the"},{"type":"text","text":" "},{"type":"text","text":"text view. A positive value increases the spacing between characters,"},{"type":"text","text":" "},{"type":"text","text":"while a negative value brings the characters closer together."}]},{"syntax":null,"type":"codeListing","code":["VStack(alignment: .leading) {","    Text(\"ABCDEF\").tracking(-3)","    Text(\"ABCDEF\")","    Text(\"ABCDEF\").tracking(3)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The code above uses an unusually large amount of tracking to make it"},{"type":"text","text":" "},{"type":"text","text":"easy to see the effect."}]},{"type":"paragraph","inlineContent":[]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The effect of tracking resembles that of the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text\/kerning(_:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"modifier, but adds or removes trailing whitespace, rather than changing"},{"type":"text","text":" "},{"type":"text","text":"character offsets. Also, using any nonzero amount of tracking disables"},{"type":"text","text":" "},{"type":"text","text":"nonessential ligatures, whereas kerning attempts to maintain ligatures."}]},{"name":"Important","type":"aside","style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If you add both the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text\/tracking(_:)","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text\/kerning(_:)","isActive":true},{"type":"text","text":" modifiers to a view, the view applies the"},{"type":"text","text":" "},{"type":"text","text":"tracking and ignores the kerning."}]}]}],"kind":"content"}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","type":"topic","kind":"symbol","abstract":[],"title":"OpenSwiftUI","url":"\/documentation\/openswiftui"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Text":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Text"}],"kind":"symbol","title":"Text","url":"\/documentation\/openswiftui\/text","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text","abstract":[{"type":"text","text":"A view that displays one or more lines of read-only text."}],"role":"symbol","navigatorTitle":[{"text":"Text","kind":"identifier"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Text/tracking(_:)":{"abstract":[{"text":"Sets the tracking for the text.","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text\/tracking(_:)","title":"tracking(_:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tracking","kind":"identifier"},{"text":"(","kind":"text"},{"text":"CGFloat","kind":"typeIdentifier","preciseIdentifier":"s:14CoreFoundation7CGFloatV"},{"text":") -> ","kind":"text"},{"text":"Text","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI4TextV"}],"url":"\/documentation\/openswiftui\/text\/tracking(_:)"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Text/kerning(_:)":{"abstract":[{"type":"text","text":"Sets the spacing, or kerning, between characters."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text\/kerning(_:)","title":"kerning(_:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kerning"},{"kind":"text","text":"("},{"preciseIdentifier":"s:14CoreFoundation7CGFloatV","kind":"typeIdentifier","text":"CGFloat"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:11OpenSwiftUI4TextV","kind":"typeIdentifier","text":"Text"}],"url":"\/documentation\/openswiftui\/text\/kerning(_:)"}}}