{"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"symbolKind":"init","role":"symbol","extendedModule":"OpenSwiftUI","title":"init(_:tableName:bundle:comment:)","roleHeading":"Initializer","externalID":"s:11OpenSwiftUI4TextV_9tableName6bundle7commentAcA18LocalizedStringKeyV_SSSgSo8NSBundleCSgs06StaticJ0VSgtcfc","modules":[{"name":"OpenSwiftUI"}],"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"LocalizedStringKey","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI18LocalizedStringKeyV"},{"text":", ","kind":"text"},{"text":"tableName","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"bundle","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bundle","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSBundle"},{"text":"?, ","kind":"text"},{"text":"comment","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"StaticString","kind":"typeIdentifier","preciseIdentifier":"s:s12StaticStringV"},{"text":"?)","kind":"text"}]},"abstract":[{"text":"Creates a text view that displays localized content identified by a key.","type":"text"}],"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text"]]},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text\/init(_:tableName:bundle:comment:)","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/text\/init(_:tablename:bundle:comment:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"key"},{"kind":"text","text":": "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LocalizedStringKey","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSwiftUI18LocalizedStringKeyV","text":"LocalizedStringKey"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tableName"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"bundle"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSBundle","text":"Bundle"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"comment"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s12StaticStringV","text":"StaticString"},{"kind":"text","text":"? = nil)"}],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The key for a string in the table identified by ","type":"text"},{"code":"tableName","type":"codeVoice"},{"text":".","type":"text"}]}],"name":"key"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The name of the string table to search. If "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", use the"},{"type":"text","text":" "},{"type":"text","text":"table in the "},{"code":"Localizable.strings","type":"codeVoice"},{"type":"text","text":" file."}]}],"name":"tableName"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The bundle containing the strings file. If ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", use the","type":"text"},{"text":" ","type":"text"},{"text":"main bundle.","type":"text"}]}],"name":"bundle"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Contextual information about this key-value pair."}]}],"name":"comment"}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this initializer to look for the "},{"code":"key","type":"codeVoice"},{"type":"text","text":" parameter in a localization"},{"type":"text","text":" "},{"type":"text","text":"table and display the associated string value in the initialized text"},{"type":"text","text":" "},{"type":"text","text":"view. If the initializer can’t find the key in the table, or if no table"},{"type":"text","text":" "},{"type":"text","text":"exists, the text view displays the string representation of the key"},{"type":"text","text":" "},{"type":"text","text":"instead."}]},{"code":["Text(\"pencil\") \/\/ Localizes the key if possible, or displays \"pencil\" if not."],"syntax":null,"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you initialize a text view with a string literal, the view triggers"},{"type":"text","text":" "},{"type":"text","text":"this initializer because it assumes you want the string localized, even"},{"type":"text","text":" "},{"type":"text","text":"when you don’t explicitly specify a table, as in the above example. If"},{"type":"text","text":" "},{"type":"text","text":"you haven’t provided localization for a particular string, you still get"},{"type":"text","text":" "},{"type":"text","text":"reasonable behavior, because the initializer displays the key, which"},{"type":"text","text":" "},{"type":"text","text":"typically contains the unlocalized string."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you initialize a text view with a string variable rather than a"},{"type":"text","text":" "},{"type":"text","text":"string literal, the view triggers the "},{"code":"Text\/init(_:)-9d1g4","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"initializer instead, because it assumes that you don’t want localization"},{"type":"text","text":" "},{"type":"text","text":"in that case. If you do want to localize the value stored in a string"},{"type":"text","text":" "},{"type":"text","text":"variable, you can choose to call the "},{"code":"init(_:tableName:bundle:comment:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"initializer by first creating a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LocalizedStringKey"},{"type":"text","text":" instance from the"},{"type":"text","text":" "},{"type":"text","text":"string variable:"}]},{"code":["Text(LocalizedStringKey(someString)) \/\/ Localizes the contents of `someString`."],"syntax":null,"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you have a string literal that you don’t want to localize, use the"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text\/init(verbatim:)"},{"type":"text","text":" initializer instead."}]},{"level":3,"text":"Styling localized strings with markdown","anchor":"Styling-localized-strings-with-markdown","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the localized string or the fallback key contains Markdown, the"},{"type":"text","text":" "},{"type":"text","text":"view displays the text with appropriate styling. For example, consider"},{"type":"text","text":" "},{"type":"text","text":"an app with the following entry in its Spanish localization file:"}]},{"code":["\"_Please visit our [website](https:\/\/www.example.com)._\" = \"_Visita nuestro [sitio web](https:\/\/www.example.com)._\";"],"syntax":null,"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can create a "},{"code":"Text","type":"codeVoice"},{"type":"text","text":" view with the Markdown-formatted base language"},{"type":"text","text":" "},{"type":"text","text":"version of the string as the localization key, like this:"}]},{"code":["Text(\"_Please visit our [website](https:\/\/www.example.com)._\")"],"syntax":null,"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When viewed in a Spanish locale, the view uses the Spanish text from the"},{"type":"text","text":" "},{"type":"text","text":"strings file, applying the Markdown styling."}]},{"type":"paragraph","inlineContent":[]},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"Text","type":"codeVoice"},{"text":" doesn’t render all styling possible in Markdown. It","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t support line breaks, soft breaks, or any style of paragraph- or","type":"text"},{"text":" ","type":"text"},{"text":"block-based formatting like lists, block quotes, code blocks, or tables.","type":"text"},{"text":" ","type":"text"},{"text":"It also doesn’t support the","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/AttributeScopes\/FoundationAttributes\/3796122-imageURL","type":"text"},{"text":" ","type":"text"},{"text":"attribute. Parsing with OpenSwiftUI treats any whitespace in the Markdown","type":"text"},{"text":" ","type":"text"},{"text":"string as described by the","type":"text"},{"text":" ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/AttributedString\/MarkdownParsingOptions\/InterpretedSyntax\/inlineOnlyPreservingWhitespace","type":"text"},{"text":" ","type":"text"},{"text":"parsing option.","type":"text"}]}],"type":"aside","style":"important","name":"Important"}]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/LocalizedStringKey":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LocalizedStringKey"}],"title":"LocalizedStringKey","navigatorTitle":[{"kind":"identifier","text":"LocalizedStringKey"}],"url":"\/documentation\/openswiftui\/localizedstringkey","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LocalizedStringKey","role":"symbol","kind":"symbol","abstract":[{"text":"The key used to look up an entry in a strings file or strings dictionary","type":"text"},{"text":" ","type":"text"},{"text":"file.","type":"text"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"title":"OpenSwiftUI","url":"\/documentation\/openswiftui","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","kind":"symbol","abstract":[]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Text/init(verbatim:)":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"verbatim"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":")"}],"title":"init(verbatim:)","url":"\/documentation\/openswiftui\/text\/init(verbatim:)","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text\/init(verbatim:)","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Creates a text view that displays a string literal without localization."}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Text":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Text"}],"title":"Text","navigatorTitle":[{"kind":"identifier","text":"Text"}],"url":"\/documentation\/openswiftui\/text","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text","role":"symbol","kind":"symbol","abstract":[{"text":"A view that displays one or more lines of read-only text.","type":"text"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Text/init(_:tableName:bundle:comment:)":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"LocalizedStringKey","preciseIdentifier":"s:11OpenSwiftUI18LocalizedStringKeyV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tableName"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"bundle"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bundle","preciseIdentifier":"c:objc(cs)NSBundle"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"comment"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"StaticString","preciseIdentifier":"s:s12StaticStringV"},{"kind":"text","text":"?)"}],"title":"init(_:tableName:bundle:comment:)","url":"\/documentation\/openswiftui\/text\/init(_:tablename:bundle:comment:)","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text\/init(_:tableName:bundle:comment:)","role":"symbol","kind":"symbol","abstract":[{"text":"Creates a text view that displays localized content identified by a key.","type":"text"}]}}}