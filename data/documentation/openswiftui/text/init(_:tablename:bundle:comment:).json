{"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text\/init(_:tableName:bundle:comment:)","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/openswiftui\/text\/init(_:tablename:bundle:comment:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"key"},{"kind":"text","text":": "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LocalizedStringKey","preciseIdentifier":"s:11OpenSwiftUI18LocalizedStringKeyV","kind":"typeIdentifier","text":"LocalizedStringKey"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tableName"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"bundle"},{"kind":"text","text":": "},{"preciseIdentifier":"c:objc(cs)NSBundle","kind":"typeIdentifier","text":"Bundle"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"comment"},{"kind":"text","text":": "},{"preciseIdentifier":"s:s12StaticStringV","kind":"typeIdentifier","text":"StaticString"},{"kind":"text","text":"? = nil)"}]}]},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The key for a string in the table identified by "},{"type":"codeVoice","code":"tableName"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"key"},{"content":[{"inlineContent":[{"type":"text","text":"The name of the string table to search. If "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", use the"},{"type":"text","text":" "},{"type":"text","text":"table in the "},{"type":"codeVoice","code":"Localizable.strings"},{"type":"text","text":" file."}],"type":"paragraph"}],"name":"tableName"},{"content":[{"inlineContent":[{"type":"text","text":"The bundle containing the strings file. If "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", use the"},{"type":"text","text":" "},{"type":"text","text":"main bundle."}],"type":"paragraph"}],"name":"bundle"},{"content":[{"inlineContent":[{"type":"text","text":"Contextual information about this key-value pair."}],"type":"paragraph"}],"name":"comment"}],"kind":"parameters"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Use this initializer to look for the "},{"code":"key","type":"codeVoice"},{"type":"text","text":" parameter in a localization"},{"type":"text","text":" "},{"type":"text","text":"table and display the associated string value in the initialized text"},{"type":"text","text":" "},{"type":"text","text":"view. If the initializer can’t find the key in the table, or if no table"},{"type":"text","text":" "},{"type":"text","text":"exists, the text view displays the string representation of the key"},{"type":"text","text":" "},{"type":"text","text":"instead."}],"type":"paragraph"},{"syntax":null,"code":["Text(\"pencil\") \/\/ Localizes the key if possible, or displays \"pencil\" if not."],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"When you initialize a text view with a string literal, the view triggers"},{"type":"text","text":" "},{"type":"text","text":"this initializer because it assumes you want the string localized, even"},{"type":"text","text":" "},{"type":"text","text":"when you don’t explicitly specify a table, as in the above example. If"},{"type":"text","text":" "},{"type":"text","text":"you haven’t provided localization for a particular string, you still get"},{"type":"text","text":" "},{"type":"text","text":"reasonable behavior, because the initializer displays the key, which"},{"type":"text","text":" "},{"type":"text","text":"typically contains the unlocalized string."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If you initialize a text view with a string variable rather than a"},{"type":"text","text":" "},{"type":"text","text":"string literal, the view triggers the "},{"type":"codeVoice","code":"Text\/init(_:)-9d1g4"},{"type":"text","text":" "},{"type":"text","text":"initializer instead, because it assumes that you don’t want localization"},{"type":"text","text":" "},{"type":"text","text":"in that case. If you do want to localize the value stored in a string"},{"type":"text","text":" "},{"type":"text","text":"variable, you can choose to call the "},{"type":"codeVoice","code":"init(_:tableName:bundle:comment:)"},{"type":"text","text":" "},{"type":"text","text":"initializer by first creating a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/LocalizedStringKey"},{"type":"text","text":" instance from the"},{"type":"text","text":" "},{"type":"text","text":"string variable:"}],"type":"paragraph"},{"syntax":null,"code":["Text(LocalizedStringKey(someString)) \/\/ Localizes the contents of `someString`."],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"If you have a string literal that you don’t want to localize, use the"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text\/init(verbatim:)"},{"type":"text","text":" initializer instead."}],"type":"paragraph"},{"anchor":"Styling-localized-strings-with-markdown","level":3,"text":"Styling localized strings with markdown","type":"heading"},{"inlineContent":[{"type":"text","text":"If the localized string or the fallback key contains Markdown, the"},{"type":"text","text":" "},{"type":"text","text":"view displays the text with appropriate styling. For example, consider"},{"type":"text","text":" "},{"type":"text","text":"an app with the following entry in its Spanish localization file:"}],"type":"paragraph"},{"syntax":null,"code":["\"_Please visit our [website](https:\/\/www.example.com)._\" = \"_Visita nuestro [sitio web](https:\/\/www.example.com)._\";"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"You can create a "},{"type":"codeVoice","code":"Text"},{"type":"text","text":" view with the Markdown-formatted base language"},{"type":"text","text":" "},{"type":"text","text":"version of the string as the localization key, like this:"}],"type":"paragraph"},{"syntax":null,"code":["Text(\"_Please visit our [website](https:\/\/www.example.com)._\")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"When viewed in a Spanish locale, the view uses the Spanish text from the"},{"type":"text","text":" "},{"type":"text","text":"strings file, applying the Markdown styling."}],"type":"paragraph"},{"inlineContent":[],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"Text","type":"codeVoice"},{"type":"text","text":" doesn’t render all styling possible in Markdown. It"},{"type":"text","text":" "},{"type":"text","text":"doesn’t support line breaks, soft breaks, or any style of paragraph- or"},{"type":"text","text":" "},{"type":"text","text":"block-based formatting like lists, block quotes, code blocks, or tables."},{"type":"text","text":" "},{"type":"text","text":"It also doesn’t support the"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/AttributeScopes\/FoundationAttributes\/3796122-imageURL"},{"type":"text","text":" "},{"type":"text","text":"attribute. Parsing with OpenSwiftUI treats any whitespace in the Markdown"},{"type":"text","text":" "},{"type":"text","text":"string as described by the"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/AttributedString\/MarkdownParsingOptions\/InterpretedSyntax\/inlineOnlyPreservingWhitespace"},{"type":"text","text":" "},{"type":"text","text":"parsing option."}]}],"name":"Important","style":"important","type":"aside"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"preciseIdentifier":"s:11OpenSwiftUI18LocalizedStringKeyV","kind":"typeIdentifier","text":"LocalizedStringKey"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tableName"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"bundle"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bundle","preciseIdentifier":"c:objc(cs)NSBundle"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"comment"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"StaticString","preciseIdentifier":"s:s12StaticStringV"},{"kind":"text","text":"?)"}],"modules":[{"name":"OpenSwiftUI"}],"title":"init(_:tableName:bundle:comment:)","role":"symbol","extendedModule":"OpenSwiftUI","roleHeading":"Initializer","symbolKind":"init","externalID":"s:11OpenSwiftUI4TextV_9tableName6bundle7commentAcA18LocalizedStringKeyV_SSSgSo8NSBundleCSgs06StaticJ0VSgtcfc"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text"]]},"abstract":[{"text":"Creates a text view that displays localized content identified by a key.","type":"text"}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Text":{"url":"\/documentation\/openswiftui\/text","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Text","title":"Text","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A view that displays one or more lines of read-only text."}],"navigatorTitle":[{"kind":"identifier","text":"Text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Text","kind":"identifier"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Text/init(_:tableName:bundle:comment:)":{"identifier":"doc