":"text","text":", which causes the shortcut to become "},{"type":"codeVoice","code":"⌥⌘5"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"If configured, which is the default behavior, automatic shortcut"},{"type":"text","text":" "},{"type":"text","text":"remapping will convert it to "},{"type":"codeVoice","code":"⌘Ö"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"In addition to that, some keyboard shortcuts carry information","type":"text"},{"text":" ","type":"text"},{"text":"about directionality.","type":"text"},{"text":" ","type":"text"},{"text":"Right-aligning a block of text or seeking forward in context of music","type":"text"},{"text":" ","type":"text"},{"text":"playback are such examples. These kinds of shortcuts benefit from the option","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyboardShortcut\/Localization-swift.struct\/withoutMirroring"},{"text":" ","type":"text"},{"text":"to tell the system that they won’t be flipped when running in a","type":"text"},{"text":" ","type":"text"},{"text":"right-to-left context.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/openswiftui\/keyboardshortcut\/localization-swift.struct"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyboardShortcut"]]},"topicSections":[{"generated":true,"title":"Type Properties","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyboardShortcut\/Localization-swift.struct\/automatic","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyboardShortcut\/Localization-swift.struct\/custom","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyboardShortcut\/Localization-swift.struct\/withoutMirroring"],"