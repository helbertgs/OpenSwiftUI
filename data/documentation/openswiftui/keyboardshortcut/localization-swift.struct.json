UI\/KeyboardShortcut\/Localization-swift.struct\/withoutMirroring","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"to tell the system that they won’t be flipped when running in a","type":"text"},{"text":" ","type":"text"},{"text":"right-to-left context.","type":"text"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyboardShortcut"]]},"topicSections":[{"generated":true,"anchor":"Type-Properties","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyboardShortcut\/Localization-swift.struct\/automatic","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyboardShortcut\/Localization-swift.struct\/custom","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyboardShortcut\/Localization-swift.struct\/withoutMirroring"],"title":"Type Properties"},{"generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyboardShortcut\/Localization-swift.struct\/Equatable-Implementations","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyboardShortcut\/Localization-swift.struct\/Hashable-Implementations"],"title":"Default Implementations"}],"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyboardShortcut\/Localization-swift.struct","interfaceLanguage":"swift"},"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/OpenSwiftUI\/s8CopyableP","doc:\/\/OpenSwiftUI\/SQ","doc:\/\/OpenSwiftUI\/s9EscapableP","doc:\/\/OpenSwiftUI\/SH","doc:\/\/OpenSwiftUI\/s8SendableP","doc:\/\/OpenSwiftUI\/s16SendableMetatypeP"],"kind":"relationships"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"Options for how a keyboard shortcut participates in automatic localization.","type":"text"}],"variants":[{"paths":["\/documentation\/openswiftui\/keyboardshortcut\/localization-swift.struct"],"traits":[{"interfaceLanguage":"swift"}]}],"secti