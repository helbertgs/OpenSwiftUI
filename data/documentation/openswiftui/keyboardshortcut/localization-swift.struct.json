{"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyboardShortcut\/Localization-swift.struct"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyboardShortcut"]]},"topicSections":[{"generated":true,"anchor":"Type-Properties","title":"Type Properties","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyboardShortcut\/Localization-swift.struct\/automatic","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyboardShortcut\/Localization-swift.struct\/custom","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyboardShortcut\/Localization-swift.struct\/withoutMirroring"]},{"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyboardShortcut\/Localization-swift.struct\/Equatable-Implementations","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyboardShortcut\/Localization-swift.struct\/Hashable-Implementations"],"generated":true}],"sections":[],"abstract":[{"type":"text","text":"Options for how a keyboard shortcut participates in automatic localization."}],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/OpenSwiftUI\/s8CopyableP","doc:\/\/OpenSwiftUI\/SQ","doc:\/\/OpenSwiftUI\/s9EscapableP","doc:\/\/OpenSwiftUI\/SH","doc:\/\/OpenSwiftUI\/s8SendableP","doc:\/\/OpenSwiftUI\/s16SendableMetatypeP"],"kind":"relationships"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Localization","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"A shortcut’s "},{"type":"codeVoice","code":"key"},{"type":"text","text":" that is defined on an US-English keyboard"},{"type":"text","text":" "},{"type":"text","text":"layout might not be reachable on international layouts."},{"type":"text","text":" "},{"type":"text","text":"For example the shortcut "},{"type":"codeVoice","code":"⌘["},{"type":"text","text":" works well for the US layout but is"},{"type":"text","text":" "},{"type":"text","text":"hard to reach for German users."},{"type":"text","text":" "},{"type":"text","text":"On the German keyboard layout, pressing "},{"type":"codeVoice","code":"⌥5"},{"type":"text","text":" will produce"},{"type":"text","text":" "},{"type":"codeVoice","code":"["},{"type":"text","text":", which causes the shortcut to become "},{"type":"codeVoice","code":"⌥⌘5"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"If configured, which is the default behavior, automatic shortcut"},{"type":"text","text":" "},{"type":"text","text":"remapping will convert it to "},{"type":"codeVoice","code":"⌘Ö"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In addition to that, some keyboard shortcuts carry information"},{"type":"text","text":" "},{"type":"text","text":"about directionality."},{"type":"text","text":" "},{"type":"text","text":"Right-aligning a block of text or seeking forward in context of music"},{"type":"text","text":" "},{"type":"text","text":"playback are such examples. These kinds of shortcuts benefit from the option"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/KeyboardShortcut\/Localization-swift.struct\/withoutMirroring","isActive":true},{"type":"text","text":" "},{"type":"text","text":"to tell the system that they won’t be flipped when running in a"},{"type":"text","text":" "},{"type":"text","text":"right-to-left context."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/openswiftui\/keyboardshortcut\/localization-swift.struct"],"traits":[{"interfa