xt","text":" normally"},{"type":"text","text":" "},{"type":"text","text":"creates a File > New Window menu command whose keyboard shortcut is"},{"type":"text","text":" "},{"code":"⌘N","type":"codeVoice"},{"type":"text","text":". The following code changes it to something based on dynamic state:"}]},{"type":"codeListing","syntax":null,"code":["@main","struct Notes: App {","    @State private var newWindowShortcut: KeyboardShortcut? = ...","","    var body: some Scene {","        WindowGroup {","            ContentView($newWindowShortcut)","        }","        .keyboardShortcut(newWindowShortcut)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"code":"shortcut","type":"codeVoice"},{"type":"text","text":" is "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", the scene’s presentation command will not be"},{"type":"text","text":" "},{"type":"text","text":"associated with a keyboard shortcut, even if OpenSwiftUI normally assigns"},{"type":"text","text":" "},{"type":"text","text":"one automatically."}]}],"kind":"content"}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Window":{"navigatorTitle":[{"kind":"identifier","text":"Window"}],"title":"Window","role":"symbol","type":"topic","url":"\/documentation\/openswiftui\/window","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Window"}],"abstract":[{"text":"A scene that presents its content in a single, unique window.","type":"text"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"title":"OpenSwiftUI","url":"\/documentation\/openswiftui","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","kind":"symbol","abstract":[]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Window/keyboardShortcut(_:)":{"kind":"symbol","url":"\/documentation\/openswiftui\/window\/keyboardshortcut(_:)","abstract"