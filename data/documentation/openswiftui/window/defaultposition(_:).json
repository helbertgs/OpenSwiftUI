’s user interface with a life cycle managed by the"},{"type":"text","text":" "},{"type":"text","text":"system."}],"title":"Scene","kind":"symbol","url":"\/documentation\/openswiftui\/scene","navigatorTitle":[{"kind":"identifier","text":"Scene"}],"type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/WindowGroup":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WindowGroup"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup","role":"symbol","abstract":[{"type":"text","text":"A scene that presents a group of identically structured windows."}],"title":"WindowGroup","url":"\/documentation\/openswiftui\/windowgroup","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"WindowGroup"}],"type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/UnitPoint":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UnitPoint","kind":"identifier"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint","role":"symbol","abstract":[{"type":"text","text":"A normalized 2D point in a view’s coordinate space."}],"title":"UnitPoint","url":"\/documentation\/openswiftui\/unitpoint","kind":"symbol","navigatorTitle":[{"text":"UnitPoint","kind":"identifier"}],"type":"topic"}}}