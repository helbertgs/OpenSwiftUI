{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultPosition","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"position","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"UnitPoint","kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint","preciseIdentifier":"s:11OpenSwiftUI9UnitPointV"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"typeIdentifier","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP"},{"text":"\n","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint"},{"type":"text","text":" that specifies where to place a"},{"type":"text","text":" "},{"type":"text","text":"newly opened window relative to the screen bounds."}]}],"name":"position"}],"kind":"parameters"},{"content":[{"anchor":"return-value","level":2,"text":"Return Value","type":"heading"},{"inlineContent":[{"text":"A scene that uses a default position for new windows.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"The first time your app opens a window from a particular scene","type":"text"},{"text":" ","type":"text"},{"text":"declaration, the system places the window at the center of the screen by","type":"text"},{"text":" ","type":"text"},{"text":"default. For scene types that support multiple simultaneous windows, the","type":"text"},{"text":" ","type":"text"},{"text":"system offsets each additional window by a small amount to avoid","type":"text"},{"text":" ","type":"text"},{"text":"completely obscuring existing windows.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You can override the default placement of the first window by","type":"text"},{"text":" ","type":"text"},{"text":"applying a scene modifier that indicates where to place the window","type":"text"},{"text":" ","type":"text"},{"text":"relative to the screen bounds. For example, you can request that the","type":"text"},{"text":" ","type":"text"},{"text":"system place a new window in the bottom trailing corner of the screen:","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["@main","struct MyApp: App {","    var body: some Scene {","        WindowGroup {","            ContentView()","        }","        .defaultPosition(.bottomTrailing)","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The system aligns the point in the window that corresponds to the","type":"text"},{"text":" ","type":"text"},{"text":"specified ","type":"text"},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint","isActive":true},{"text":" with the point in the screen that corresponds","type":"text"},{"text":" ","type":"text"},{"text":"to the same unit point.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You typically use one of the predefined unit points — like","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/UnitPoint\/bottomTrailing","isActive":true},{"text":" in the above example — but","type":"text"},{"text":" ","type":"text"},{"text":"you can also use a custom unit point. For example, the following","type":"text"},{"text":" ","type":"text"},{"text":"modifier aligns the point that’s one quarter of the way from the","type":"text"},{"text":" ","type":"text"},{"text":"leading edge of the window with the point that’s one quarter of","type":"text"},{"text":" ","type":"text"},{"text":"the way from the leading edge of the screen, while centering the","type":"text"},{"text":" ","type":"text"},{"text":"window in the y-dimension:","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["WindowGroup {","    ContentView()","}",".defaultPosition(UnitPoint(x: 0.25, y: 0.5))"],"type":"codeListing"},{"inlineContent":[{"text":"The modifier affects any scene type that creates windows in Windows,","type":"text"},{"text":" ","type":"text"},{"text":"namely:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/WindowGroup","isActive":true,"type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window","isActive":true,"type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"DocumentGroup","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Settings","isActive":true,"type":"reference"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The value that you provide acts only as an initial default. During state","type":"text"},{"text":" ","type":"text"},{"text":"restoration, the system restores the window to the position that it","type":"text"},{"text":" ","type":"text"},{"text":"last occupied.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window\/defaultPosition(_:)"},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"Sets a default position for a window.","type":"text"}],"variants":[{"tra