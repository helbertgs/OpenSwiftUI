{"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window"]]},"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultLaunchBehavior","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI19SceneLaunchBehaviorV","text":"SceneLaunchBehavior","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI5SceneP","text":"Scene","kind":"typeIdentifier"}],"externalID":"s:11OpenSwiftUI5ScenePAAE21defaultLaunchBehavioryQrAA0dfG0VF::SYNTHESIZED::s:11OpenSwiftUI6WindowV","title":"defaultLaunchBehavior(_:)","role":"symbol","roleHeading":"Instance Method","symbolKind":"method","modules":[{"name":"OpenSwiftUI"}],"extendedModule":"OpenSwiftUI"},"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window\/defaultLaunchBehavior(_:)"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultLaunchBehavior"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"behavior"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"SceneLaunchBehavior","preciseIdentifier":"s:11OpenSwiftUI19SceneLaunchBehaviorV","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneLaunchBehavior"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene"},{"kind":"text","text":"\n"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"This behavior can be used to define if a scene is shown on application"},{"type":"text","text":" "},{"type":"text","text":"launch in the absence of any previously saved state."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"On platforms that do not support multiple windows, this value is"},{"type":"text","text":" "},{"type":"text","text":"ignored."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"On platforms other than Windows, there must be at least one scene that"},{"type":"text","text":" "},{"type":"text","text":"presents itself. If no scenes are defined to present, the first scene"},{"type":"text","text":" "},{"type":"text","text":"will be presented, regardless of the value provided to this modifier."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"During app launch, on platforms other than Windows, the system"},{"type":"text","text":" "},{"type":"text","text":"will only consider scenes whose role matches the"},{"type":"text","text":" "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/bundleresources\/information_property_list\/uiapplicationpreferreddefaultscenesessionrole"},{"type":"text","text":" "},{"type":"text","text":"key in the application scene manifest of the "},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":" file."},{"type":"text","text":" "},{"type":"text","text":"For instance, a volumetric window would need the"},{"type":"text","text":" "},{"code":"UIWindowSceneSessionRoleVolumetricApplication","type":"codeVoice"},{"type":"text","text":" role."}]}],"name":"Note","style":"note","type":"aside"},{"inlineContent":[{"type":"text","text":"On Windows, this behavior will also be used to determine which scene is"},{"type":"text","text":" "},{"type":"text","text":"presented when clicking on the icon of a running application with no"},{"type":"text","text":" "},{"type":"text","text":"visible windows."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"On visionOS, the system may background the last dismissed scene instead"},{"type":"text","text":" "},{"type":"text","text":"of closing it. Thus, the suppressed behavior additionally specifies that"},{"type":"text","text":" "},{"type":"text","text":"the scene should not be presented when tapping on the application icon"},{"type":"text","text":" "},{"type":"text","text":"with no visible windows."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, you may wish to present a welcome window on launch of your"},{"type":"text","text":" "},{"type":"text","text":"app when there are no previous document windows being restored:"}],"type":"paragraph"},{"syntax":null,"code":["@main","struct MyApp: App {","    var body: some Scene {","        DocumentGroup(newDocument: MyDocument()) { configuration in","            DocumentEditor(configuration.$document)","        }","","        Window(\"Welcome to My App\", id: \"welcome\") {","            WelcomeView()","        }","        .defaultLaunchBehavior(.presented)","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The default value for all scenes if you do not apply this modifier is"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneLaunchBehavior\/automatic"},{"type":"text","text":". With that strategy, a scene"},{"type":"text","text":" "},{"type":"text","text":"will only present itself if it is the first scene defined by the app,"},{"type":"text","text":" "},{"type":"text","text":"and no other scenes have presented themselves."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/openswiftui\/window\/defaultlaunchbehavior(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Sets the default launch behavior for this scene.","type":"text"}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/SceneLaunchBehavior/automatic":{"abstract":[{"type":"text","text":"The automatic behavior."}],"role":"symbol","kind":"symbol","url":"\/documentation\/openswiftui\/scenelaunchbehavior\/automatic","title":"automatic","type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"automatic","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSwiftUI19SceneLaunchBehaviorV","text":"SceneLaunchBehavior","kind":"typeIdentifier"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneLaunchBehavior\/automatic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Window/defaultLaunchBehavior(_:)":{"title":"defaultLaunchBehavior(_:)","role":"symbol","type":"topic","url":"\/documentation\/openswiftui\/window\/defaultlaunchbehavior(_:)","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window\/defaultLaunchBehavior(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultLaunchBehavior","kind":"identifier"},{"text":"(","kind":"text"},{"text":"SceneLaunchBehavior","preciseIdentifier":"s:11OpenSwiftUI19SceneLaunchBehaviorV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","preciseIdentifier":"s:11OpenSwiftUI5SceneP","kind":"typeIdentifier"}],"abstract":[{"text":"Sets the default launch behavior for this scene.","type":"text"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Window":{"navigatorTitle":[{"kind":"identifier","text":"Window"}],"title":"Window","role":"symbol","type":"topic","url":"\/documentation\/openswiftui\/window","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Window","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Window"}],"abstract":[{"text":"A scene that presents its content in a single, unique window.","type":"text"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Scene":{"navigatorTitle":[{"kind":"identifier","text":"Scene"}],"title":"Scene","role":"symbol","type":"topic","url":"\/documentation\/openswiftui\/scene","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Scene","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scene"}],"abstract":[{"text":"A part of an app’s user interface with a life cycle managed by the","type":"text"},{"text":" ","type":"text"},{"text":"system.","type":"text"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/SceneLaunchBehavior":{"navigatorTitle":[{"text":"SceneLaunchBehavior","kind":"identifier"}],"abstract":[{"type":"text","text":"The launch behavior for a scene."}],"role":"symbol","kind":"symbol","url":"\/documentation\/openswiftui\/scenelaunchbehavior","title":"SceneLaunchBehavior","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SceneLaunchBehavior","kind":"identifier"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/SceneLaunchBehavior"},"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"title":"OpenSwiftUI","url":"\/documentation\/openswiftui","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","kind":"symbol","abstract":[]}}}