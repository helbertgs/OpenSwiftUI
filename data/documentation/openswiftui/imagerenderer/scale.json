{"abstract":[{"type":"text","text":"The scale at which to render the image."}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/imagerenderer\/scale"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ImageRenderer"]]},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ImageRenderer\/scale","interfaceLanguage":"swift"},"metadata":{"symbolKind":"property","roleHeading":"Instance Property","externalID":"s:11OpenSwiftUI13ImageRendererC5scaleSdvp","modules":[{"name":"OpenSwiftUI"}],"role":"symbol","title":"scale","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"scale","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}]},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"scale","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This value is a ratio of view points to image pixels. This relationship"},{"type":"text","text":" "},{"type":"text","text":"means that values greater than "},{"type":"codeVoice","code":"1.0"},{"type":"text","text":" create an image larger than the"},{"type":"text","text":" "},{"type":"text","text":"original content view, and less than "},{"type":"codeVoice","code":"1.0"},{"type":"text","text":" creates a smaller image. The"},{"type":"text","text":" "},{"type":"text","text":"following example shows a 100 x 50 rectangle view and an image rendered"},{"type":"text","text":" "},{"type":"text","text":"from it with a "},{"type":"codeVoice","code":"scale"},{"type":"text","text":" of "},{"type":"codeVoice","code":"2.0"},{"type":"text","text":", resulting in an image size of"},{"type":"text","text":" "},{"type":"text","text":"200 x 100."}]},{"syntax":null,"type":"codeListing","code":["let rectangle = Rectangle()","    .frame(width: 100, height: 50)","let renderer = ImageRenderer(content: rectangle)","renderer.scale = 2.0","if let rendered = renderer.cgImage {","    print(\"Scaled image: \\(rendered.width) x \\(rendered.height)\")","}","\/\/ Prints \"Scaled image: 200 x 100\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default value of this property is "},{"type":"codeVoice","code":"1.0"},{"type":"text","text":"."}]}],"kind":"content"}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/ImageRenderer/scale":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"scale","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"}],"kind":"symbol","title":"scale","type":"topic","url":"\/documentation\/openswiftui\/imagerenderer\/scale","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ImageRenderer\/scale","abstract":[{"text":"The scale at which to render the image.","type":"text"}],"role":"symbol"},"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","type":"topic","kind":"symbol","abstract":[],"title":"OpenSwiftUI","url":"\/documentation\/openswiftui"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/ImageRenderer":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ImageRenderer","kind":"identifier"}],"kind":"symbol","title":"ImageRenderer","type":"topic","url":"\/documentation\/openswiftui\/imagerenderer","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ImageRenderer","abstract":[{"type":"text","text":"An object that creates images from OpenSwiftUI views."}],"role":"symbol","navigatorTitle":[{"text":"ImageRenderer","kind":"identifier"}]}}}