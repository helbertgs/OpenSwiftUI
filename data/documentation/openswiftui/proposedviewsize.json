nd":"keyword"},{"text":" ","kind":"text"},{"text":"ProposedViewSize","kind":"identifier"}]}]},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"During layout in SwiftUI, views choose their own size, but they do that"},{"type":"text","text":" "},{"type":"text","text":"in response to a size proposal from their parent view. When you create"},{"type":"text","text":" "},{"type":"text","text":"a custom layout using the "},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout","type":"reference","isActive":true},{"type":"text","text":" protocol, your layout container"},{"type":"text","text":" "},{"type":"text","text":"participates in this process using "},{"code":"ProposedViewSize","type":"codeVoice"},{"type":"text","text":" instances."},{"type":"text","text":" "},{"type":"text","text":"The layout protocol’s methods take a proposed size input that you"},{"type":"text","text":" "},{"type":"text","text":"can take into account when arranging views and calculating the size of"},{"type":"text","text":" "},{"type":"text","text":"the composite container. Similarly, your layout proposes a size to each"},{"type":"text","text":" "},{"type":"text","text":"of its own subviews when it measures and places them."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Layout containers typically measure their subviews by proposing several"},{"type":"text","text":" "},{"type":"text","text":"sizes and looking at the responses. The container can use this information"},{"type":"text","text":" "},{"type":"text","text":"to decide how to allocate space among its subviews. A"},{"type":"text","text":" "},{"type":"text","text":"layout might try the following special proposals:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/zero","type":"reference"},{"text":" proposal; the view responds with its minimum size.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"The ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/infinity"},{"text":" proposal; the view responds with its maximum size.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/unspecified"},{"text":" proposal; the view responds with its ideal size.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"A layout might also try special cases for one dimension at a time. For","type":"text"},{"text":" ","type":"text"},{"text":"example, an ","type":"text"},{"code":"HStack","type":"codeVoice"},{"text":" might measure the flexibility of its subviews’","type":"text"},{"text":" ","type":"text"},{"text":"widths, while using a fixed value for the height.","type":"text"}]}],"kind":"content"}],"relationshipsSections":[{"identifiers":["doc:\/\/OpenSwiftUI\/s15BitwiseCopyableP","doc:\/\/OpenSwiftUI\/SQ","doc:\/\/OpenSwiftUI\/s8SendableP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"title":"ProposedViewSize","role":"symbol","externalID":"s:11OpenSwiftUI16ProposedViewSizeV","navigatorTitle":[{"text":"ProposedViewSize","kind":"identifier"}],"roleHeading":"Structure","symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ProposedViewSize"}],"modules":[{"name":"OpenSwiftUI"}]},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/ProposedViewSize/replacingUnspecifiedDimensions(by:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"replacingUnspecifiedDimensions","kind":"iden