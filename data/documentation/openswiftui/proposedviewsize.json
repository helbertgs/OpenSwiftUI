ntent":[{"text":"During layout in SwiftUI, views choose their own size, but they do that","type":"text"},{"text":" ","type":"text"},{"text":"in response to a size proposal from their parent view. When you create","type":"text"},{"text":" ","type":"text"},{"text":"a custom layout using the ","type":"text"},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout","isActive":true},{"text":" protocol, your layout container","type":"text"},{"text":" ","type":"text"},{"text":"participates in this process using ","type":"text"},{"type":"codeVoice","code":"ProposedViewSize"},{"text":" instances.","type":"text"},{"text":" ","type":"text"},{"text":"The layout protocol’s methods take a proposed size input that you","type":"text"},{"text":" ","type":"text"},{"text":"can take into account when arranging views and calculating the size of","type":"text"},{"text":" ","type":"text"},{"text":"the composite container. Similarly, your layout proposes a size to each","type":"text"},{"text":" ","type":"text"},{"text":"of its own subviews when it measures and places them.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Layout containers typically measure their subviews by proposing several","type":"text"},{"text":" ","type":"text"},{"text":"sizes and looking at the responses. The container can use this information","type":"text"},{"text":" ","type":"text"},{"text":"to decide how to allocate space among its subviews. A","type":"text"},{"text":" ","type":"text"},{"text":"layout might try the following special proposals:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/zero","isActive":true,"type":"reference"},{"text":" proposal; the view responds with its minimum size.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/infinity","isActive":true,"type":"reference"},{"text":" proposal; the view responds with its maximum size.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/unspecified","isActive":true},{"type":"text","text":" proposal; the view responds with its ideal size."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"A layout might also try special cases for one dimension at a time. For"},{"type":"text","text":" "},{"type":"text","text":"example, an "},{"code":"HStack","type":"codeVoice"},{"type":"text","text":" might measure the flexibility of its subviews’"},{"type":"text","text":" "},{"type":"text","text":"widths, while using a fixed value for the height."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/openswiftui\/proposedviewsize"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"OpenSwiftUI"}],"title":"ProposedViewSize","role":"symbol","symbolKind":"struct","roleHeading":"Structure","externalID":"s:11OpenSwiftUI16ProposedViewSizeV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ProposedViewSize","kind":"identifier"}],"navigatorTitle":[{"text":"ProposedViewSize","kind":"identifier"}]},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize","interfaceLanguage":"swift"},"kind":"symbol","relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/OpenSwiftUI\/s15BitwiseCopyableP","doc:\/\/OpenSwiftUI\/SQ","doc:\/\/OpenSwiftUI\/s8SendableP"],"type":"conformsTo"}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/ProposedViewSize/height":{"kind":"symbol","type":"topic","title":"height","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/height","abstract":[{"type