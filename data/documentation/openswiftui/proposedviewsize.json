{"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/OpenSwiftUI\/s15BitwiseCopyableP","doc:\/\/OpenSwiftUI\/SQ","doc:\/\/OpenSwiftUI\/SH","doc:\/\/OpenSwiftUI\/s8SendableP","doc:\/\/OpenSwiftUI\/s16SendableMetatypeP"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ProposedViewSize"}],"modules":[{"name":"OpenSwiftUI"}],"title":"ProposedViewSize","role":"symbol","roleHeading":"Structure","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"ProposedViewSize"}],"externalID":"s:11OpenSwiftUI16ProposedViewSizeV"},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ProposedViewSize"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"text":"During layout in OpenSwiftUI, views choose their own size, but they do that","type":"text"},{"text":" ","type":"text"},{"text":"in response to a size proposal from their parent view. When you create","type":"text"},{"text":" ","type":"text"},{"text":"a custom layout using the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout","type":"reference"},{"text":" protocol, your layout container","type":"text"},{"text":" ","type":"text"},{"text":"participates in this process using ","type":"text"},{"code":"ProposedViewSize","type":"codeVoice"},{"text":" instances.","type":"text"},{"text":" ","type":"text"},{"text":"The layout protocol’s methods take a proposed size input that you","type":"text"},{"text":" ","type":"text"},{"text":"can take into account when arranging views and calculating the size of","type":"text"},{"text":" ","type":"text"},{"text":"the composite container. Similarly, your layout proposes a size to each","type":"text"},{"text":" ","type":"text"},{"text":"of its own subviews when it measures and places them.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Layout containers typically measure their subviews by proposing several","type":"text"},{"text":" ","type":"text"},{"text":"sizes and looking at the responses. The container can use this information","type":"text"},{"text":" ","type":"text"},{"text":"to decide how to allocate space among its subviews. A","type":"text"},{"text":" ","type":"text"},{"text":"layout might try the following special proposals:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/zero","type":"reference"},{"type":"text","text":" proposal; the view responds with its minimum size."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/infinity","type":"reference"},{"type":"text","text":" proposal; the view responds with its maximum size."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/unspecified","type":"reference"},{"type":"text","text":" proposal; the view responds with its ideal size."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"A layout might also try special cases for one dimension at a time. For","type":"text"},{"text":" ","type":"text"},{"text":"example, an ","type":"text"},{"code":"HStack","type":"codeVoice"},{"text":" might measure the flexibility of its subviews’","type":"text"},{"text":" ","type":"text"},{"text":"widths, while using a fixed value for the height.","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/openswiftui\/proposedviewsize"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","abstract":[{"text":"A proposal for the size of a view.","type":"text"}],"topicSections":[{"anchor":"Initializers","generated":true,"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/init(_:)","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/init(width:height:)"],"title":"Initializers"},{"anchor":"Instance-Properties","generated":true,"title":"Instance Properties","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/height","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/width"]},{"anchor":"Instance-Methods","generated":true,"title":"Instance Methods","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/replacingUnspecifiedDimensions(by:)"]},{"anchor":"Type-Properties","generated":true,"title":"Type Properties","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/infinity","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/unspecified","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/zero"]},{"anchor":"Default-Implementations","generated":true,"title":"Default Implementations","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/Equatable-Implementations"]}],"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize","interfaceLanguage":"swift"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/ProposedViewSize/infinity":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/infinity","url":"\/documentation\/openswiftui\/proposedviewsize\/infinity","title":"infinity","role":"symbol","type":"topic","kind":"symbol","abstract":