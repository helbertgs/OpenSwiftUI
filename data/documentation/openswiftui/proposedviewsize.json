{"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize"},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"kind":"symbol","topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/init(_:)","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/init(width:height:)"],"generated":true},{"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/height","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/width"],"generated":true},{"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/replacingUnspecifiedDimensions(by:)"],"generated":true},{"anchor":"Type-Properties","title":"Type Properties","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/infinity","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/unspecified","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/zero"],"generated":true},{"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/Equatable-Implementations"],"generated":true}],"sections":[],"abstract":[{"type":"text","text":"A proposal for the size of a view."}],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/OpenSwiftUI\/s15BitwiseCopyableP","doc:\/\/OpenSwiftUI\/SQ","doc:\/\/OpenSwiftUI\/SH","doc:\/\/OpenSwiftUI\/s8SendableP","doc:\/\/OpenSwiftUI\/s16SendableMetatypeP"],"kind":"relationships"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ProposedViewSize"}],"languages":["swift"]}]},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"During layout in OpenSwiftUI, views choose their own size, but they do that"},{"type":"text","text":" "},{"type":"text","text":"in response to a size proposal from their parent view. When you create"},{"type":"text","text":" "},{"type":"text","text":"a custom layout using the "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Layout","isActive":true},{"type":"text","text":" protocol, your layout container"},{"type":"text","text":" "},{"type":"text","text":"participates in this process using "},{"code":"ProposedViewSize","type":"codeVoice"},{"type":"text","text":" instances."},{"type":"text","text":" "},{"type":"text","text":"The layout protocol’s methods take a proposed size input that you"},{"type":"text","text":" "},{"type":"text","text":"can take into account when arranging views and calculating the size of"},{"type":"text","text":" "},{"type":"text","text":"the composite container. Similarly, your layout proposes a size to each"},{"type":"text","text":" "},{"type":"text","text":"of its own subviews when it measures and places them."}]},{"inlineContent":[{"type":"text","text":"Layout containers typically measure their subviews by proposing several"},{"type":"text","text":" "},{"type":"text","text":"sizes and looking at the responses. The container can use this information"},{"type":"text","text":" "},{"type":"text","text":"to decide how to allocate space among its subviews. A"},{"type":"text","text":" "},{"type":"text","text":"layout might try the following special proposals:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/zero","type":"reference"},{"type":"text","text":" proposal; the view responds with its minimum size."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/infinity"},{"type":"text","text":" proposal; the view responds with its maximum size."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/unspecified","isActive":true},{"type":"text","text":" proposal; the view responds with its ideal size."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"A layout might also try special cases for one dimension at a time. For"},{"type":"text","text":" "},{"type":"text","text":"example, an "},{"type":"reference","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/HStack","isActive":true},{"type":"text","text":" might measure the flexibility of its subviews’"},{"type":"text","text":" "},{"type":"text","text":"widths, while using a fixed value for the height."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/proposedviewsize"]}],"metadata":{"role":"symbol","symbolKind":"struct","navigatorTitle":[{"text":"ProposedViewSize","kind":"identifier"}],"externalID":"s:11OpenSwiftUI16ProposedViewSizeV","title":"ProposedViewSize","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ProposedViewSize","kind":"identifier"}],"modules":[{"name":"OpenSwiftUI"}],"roleHeading":"Structure"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/ProposedViewSize/init(width:height:)":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/ProposedViewSize\/init(width:height:)","role":"symbol","type":"topic","kind":"symbol","a