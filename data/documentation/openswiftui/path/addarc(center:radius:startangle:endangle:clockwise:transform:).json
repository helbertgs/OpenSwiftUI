{"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path"]]},"kind":"symbol","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/path\/addarc(center:radius:startangle:endangle:clockwise:transform:)"]}],"abstract":[{"type":"text","text":"Adds an arc of a circle to the path, specified with a radius and angles."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"addArc","kind":"identifier"},{"text":"(","kind":"text"},{"text":"center","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Point3D","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial7Point3DV"},{"text":", ","kind":"text"},{"text":"radius","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":", ","kind":"text"},{"text":"startAngle","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Angle2D","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial7Angle2DV"},{"text":", ","kind":"text"},{"text":"endAngle","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Angle2D","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial7Angle2DV"},{"text":", ","kind":"text"},{"text":"clockwise","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"transform","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"AffineTransform3D","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial17AffineTransform3DV"},{"text":" = .identity)","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"center","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The center of the arc, in user space coordinates."}]}]},{"name":"radius","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The radius of the arc, in user space coordinates."}]}]},{"name":"startAngle","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The angle to the starting point of the arc, measured from the positive x-axis."}]}]},{"name":"endAngle","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The angle to the end point of the arc, measured from the positive x-axis."}]}]},{"name":"clockwise","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"True to make a clockwise arc; false to make a counterclockwise arc."}]}]},{"name":"transform","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An affine transform to apply to the arc before adding to the path. Defaults to the identity transform if not specified."}]}]}]},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"This method calculates starting and ending points using the radius and angles you specify, uses a sequence of cubic Bézier curves to approximate a segment of a circle between those points, and then appends those curves to the path."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The clockwise parameter determines the direction in which the arc is created; the actual direction of the final path is dependent on the transform parameter and the current transform of a context where the path is drawn."},{"type":"text","text":" "},{"type":"text","text":"However, because OpenSwiftUI by default uses a vertically-flipped coordinate system (with the origin in the top-left of the view), specifying a clockwise arc results in a counterclockwise arc after the transformation is applied."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If the path ends with an unclosed subpath, this method adds a line connecting the current point to the starting point of the arc."},{"type":"text","text":" "},{"type":"text","text":"If there is no unclosed subpath, this method creates a new subpath whose starting point is the starting point of the arc."},{"type":"text","text":" "},{"type":"text","text":"The ending point of the arc becomes the new current point of the path."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"title":"addArc(center:radius:startAngle:endAngle:clockwise:transform:)","role":"symbol","symbolKind":"method","roleHeading":"Instance Method","externalID":"s:11OpenSwiftUI4PathV6addArc6center6radius10startAngle03endJ09clockwise9transformy0A7Spatial7Point3DV_SdAK7Angle2DVAOSbAK17AffineTransform3DVtF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"addArc","kind":"identifier"},{"text":"(","kind":"text"},{"text":"center","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Point3D","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial7Point3DV"},{"text":", ","kind":"text"},{"text":"radius","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":", ","kind":"text"},{"text":"startAngle","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Angle2D","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial7Angle2DV"},{"text":", ","kind":"text"},{"text":"endAngle","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Angle2D","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial7Angle2DV"},{"text":", ","kind":"text"},{"text":"clockwise","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"transform","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"AffineTransform3D","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial17AffineTransform3DV"},{"text":")","kind":"text"}],"modules":[{"name":"OpenSwiftUI"}]},"identifier":{"