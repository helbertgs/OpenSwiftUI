{"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"symbolKind":"method","role":"symbol","title":"addArc(center:radius:startAngle:endAngle:clockwise:transform:)","externalID":"s:11OpenSwiftUI4PathV6addArc6center6radius10startAngle03endJ09clockwise9transformy0A7Spatial7Point3DV_SdAK7Angle2DVAOSbAK17AffineTransform3DVtF","roleHeading":"Instance Method","modules":[{"name":"OpenSwiftUI"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"addArc"},{"kind":"text","text":"("},{"kind":"externalParam","text":"center"},{"kind":"text","text":": "},{"text":"Point3D","preciseIdentifier":"s:11OpenSpatial7Point3DV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"radius","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"startAngle"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial7Angle2DV","text":"Angle2D"},{"kind":"text","text":", "},{"kind":"externalParam","text":"endAngle"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial7Angle2DV","text":"Angle2D"},{"kind":"text","text":", "},{"kind":"externalParam","text":"clockwise"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"transform"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSpatial17AffineTransform3DV","text":"AffineTransform3D","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"abstract":[{"type":"text","text":"Adds an arc of a circle to the path, specified with a radius and angles."}],"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path"]]},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path\/addArc(center:radius:startAngle:endAngle:clockwise:transform:)","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/path\/addarc(center:radius:startangle:endangle:clockwise:transform:)"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"addArc"},{"text":"(","kind":"text"},{"text":"center","kind":"externalParam"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSpatial7Point3DV","kind":"typeIdentifier","text":"Point3D"},{"kind":"text","text":", "},{"kind":"externalParam","text":"radius"},{"kind":"text","text":": "},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"startAngle","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Angle2D","preciseIdentifier":"s:11OpenSpatial7Angle2DV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"endAngle","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Angle2D","preciseIdentifier":"s:11OpenSpatial7Angle2DV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"clockwise","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"transform","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"AffineTransform3D","preciseIdentifier":"s:11OpenSpatial17AffineTransform3DV","kind":"typeIdentifier"},{"kind":"text","text":" = .identity)"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"center","content":[{"inlineContent":[{"text":"The center of the arc, in user space coordinates.","type":"text"}],"type":"paragraph"}]},{"name":"radius","content":[{"inlineContent":[{"type":"text","text":"The radius of the arc, in user space coordinates."}],"type":"paragraph"}]},{"name":"startAngle","content":[{"inlineContent":[{"type":"text","text":"The angle to the starting point of the arc, measured from the positive x-axis."}],"type":"paragraph"}]},{"name":"endAngle","content":[{"inlineContent":[{"type":"text","text":"The angle to the end point of the arc, measured from the positive x-axis."}],"type":"paragraph"}]},{"name":"clockwise","content":[{"inlineContent":[{"type":"text","text":"True to make a clockwise arc; false to make a counterclockwise arc."}],"type":"paragraph"}]},{"name":"transform","content":[{"inlineContent":[{"type":"text","text":"An affine transform to apply to the arc before adding to the path. Defaults to the identity transform if not specified."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"This method calculates starting and ending points using the radius and angles you specify, uses a sequence of cubic Bézier curves to approximate a segment of a circle between those points, and then appends those curves to the path."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The clockwise parameter determines the direction in which the arc is created; the actual direction of the final path is dependent on the transform parameter and the current transform of a context where the path is drawn."},{"type":"text","text":" "},{"type":"text","text":"However, because OpenSwiftUI by default uses a vertically-flipped coordinate system (with the origin in the top-left of the view), specifying a clockwise arc results in a counterclockwise arc after the transformation is applied."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If the path ends with an unclosed subpath, this method adds a line connecting the current point to the starting point of the arc."},{"text":" ","type":"text"},{"type":"text","text":"If there is no unclosed subpath, this method creates a new subpath whose starting point is the starting point of the arc."},{"type":"text","text":" "},{"type":"text","text":"The ending point of the arc becomes the new current point of the path."}],"type":"paragraph"}]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"title":"OpenSwiftUI","url":"\/documentation\/openswiftui","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","kind":"symbol","abstract":[]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Path/addArc(center:radius:startAngle:endAngle:clockwise:transform:)":{"type":"topic","role":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path\/addArc(center:radius:startAngle:endAngle:clockwise:transform:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"addArc"},{"kind":"text","text":"("},{"kind":"externalParam","text":"center"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Point3D","preciseIdentifier":"s:11OpenSpatial7Point3DV"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"radius"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"startAngle"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Angle2D","preciseIdentifier":"s:11OpenSpatial7Angle2DV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"endAngle"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Angle2D","preciseIdentifier":"s:11OpenSpatial7Angle2DV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"clockwise"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":", "},{"kind":"externalParam","text":"transform"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"AffineTransform3D","preciseIdentifier":"s:11OpenSpatial17AffineTransform3DV"},{"kind":"text","text":")"}],"abstract":[{"type":"text","text":"Adds an arc of a circle to the path, specified with a radius and angles."}],"title":"addArc(center:radius:startAngle:endAngle:clockwise:transform:)","url":"\/documentation\/openswiftui\/path\/addarc(center:radius:startangle:endangle:clockwise:transform:)","kind":"symbol"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Path":{"navigatorTitle":[{"text":"Path","kind":"identifier"}],"title":"Path","role":"symbol","type":"topic","url":"\/documentation\/openswiftui\/path","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Path","kind":"identifier"}],"abstract":[{"type":"text","text":"The outline of a 2D shape."}]}}}