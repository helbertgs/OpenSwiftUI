, ","kind":"text"},{"text":"clockwise","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"transform","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSpatial17AffineTransform3DV","text":"AffineTransform3D","kind":"typeIdentifier"},{"text":")","kind":"text"}],"role":"symbol","title":"addArc(center:radius:startAngle:endAngle:clockwise:transform:)","type":"topic","abstract":[{"text":"Adds an arc of a circle to the path, specified with a radius and angles.","type":"text"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path\/addArc(center:radius:startAngle:endAngle:clockwise:transform:)"}}}