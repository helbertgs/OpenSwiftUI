{"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path"]]},"sections":[],"abstract":[{"type":"text","text":"Creates a path as an ellipse within the given rectangle."}],"metadata":{"role":"symbol","modules":[{"name":"OpenSwiftUI"}],"title":"init(ellipseIn:)","roleHeading":"Initializer","symbolKind":"init","externalID":"s:11OpenSwiftUI4PathV9ellipseInAC0A7Spatial6Rect3DV_tcfc","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"ellipseIn"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Rect3D","preciseIdentifier":"s:11OpenSpatial6Rect3DV"},{"kind":"text","text":")"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/path\/init(ellipsein:)"]}],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"ellipseIn","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"rect","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Rect3D","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial6Rect3DV"},{"text":")","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The rectangle that bounds the ellipse."}],"type":"paragraph"}],"name":"rect"}]},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is a convenience function that creates a path of an ellipse."},{"type":"text","text":" "},{"type":"text","text":"Using this convenience function is more efficient than creating a path and adding an ellipse to it."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The ellipse is approximated by a sequence of Bézier curves."},{"type":"text","text":" "},{"type":"text","text":"Its center is the midpoint of the rectangle defined by the rect parameter."},{"type":"text","text":" "},{"type":"text","text":"If the rectangle is square, then the ellipse is circular with a radius equal to one-half the width (or height) of the rectangle."},{"type":"text","text":" "},{"type":"text","text":"If the rect parameter specifies a rectangular shape, then the major and minor axes of the ellipse are defined by the width and height of the rectangle."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The ellipse forms a complete subpath of the path—that is, the ellipse drawing starts with a move-to operation and ends with a close-subpath operation, with all moves oriented in the clockwise direction."},{"type":"text","text":" "},{"type":"text","text":"If you supply an affine transform, then the constructed Bézier curves that define the ellipse are transformed before they are added to the path."}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path\/init(ellipseIn:)","interfaceLanguage":"swift"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","title":"OpenSwiftUI","abstract":[],"type":"topic","kind":"symbol","url":"\/documentation\/openswiftui","role":"collection"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Path/init(ellipseIn:)":{"role":"symbol","title":"init(ellipseIn:)","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Creates a path as an ellipse within the given rectangle."}],"url":"\/documentation\/openswiftui\/path\/init(ellipsein:)","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path\/init(ellipseIn:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ellipseIn","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Rect3D","preciseIdentifier":"s:11OpenSpatial6Rect3DV","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Path":{"url":"\/documentation\/openswiftui\/path","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Path"}],"navigatorTitle":[{"kind":"identifier","text":"Path"}],"abstract":[{"type":"text","text":"The outline of a 2D shape."}],"kind":"symbol","title":"Path","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path"}}}