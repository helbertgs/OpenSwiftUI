{"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path\/init(ellipseIn:)","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/openswiftui\/path\/init(ellipsein:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"ellipseIn"},{"kind":"text","text":" "},{"kind":"internalParam","text":"rect"},{"kind":"text","text":": "},{"text":"Rect3D","preciseIdentifier":"s:11OpenSpatial6Rect3DV","kind":"typeIdentifier"},{"text":")","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The rectangle that bounds the ellipse."}],"type":"paragraph"}],"name":"rect"}]},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"type":"text","text":"This is a convenience function that creates a path of an ellipse."},{"type":"text","text":" "},{"type":"text","text":"Using this convenience function is more efficient than creating a path and adding an ellipse to it."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The ellipse is approximated by a sequence of Bézier curves."},{"type":"text","text":" "},{"type":"text","text":"Its center is the midpoint of the rectangle defined by the rect parameter."},{"type":"text","text":" "},{"type":"text","text":"If the rectangle is square, then the ellipse is circular with a radius equal to one-half the width (or height) of the rectangle."},{"type":"text","text":" "},{"type":"text","text":"If the rect parameter specifies a rectangular shape, then the major and minor axes of the ellipse are defined by the width and height of the rectangle."}]},{"inlineContent":[{"type":"text","text":"The ellipse forms a complete subpath of the path—that is, the ellipse drawing starts with a move-to operation and ends with a close-subpath operation, with all moves oriented in the clockwise direction."},{"type":"text","text":" "},{"type":"text","text":"If you supply an affine transform, then the constructed Bézier curves that define the ellipse are transformed before they are added to the path."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path"]]},"metadata":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"ellipseIn"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial6Rect3DV","text":"Rect3D"},{"kind":"text","text":")"}],"modules":[{"name":"OpenSwiftUI"}],"title":"init(ellipseIn:)","role":"symbol","roleHeading":"Initializer","symbolKind":"init","externalID":"s:11OpenSwiftUI4PathV9ellipseInAC0A7Spatial6Rect3DV_tcfc"},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","abstract":[{"type":"text","text":"Creates a path as an ellipse within the given rectangle."}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Path":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Path"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path","role":"symbol","abstract":[{"type":"text","text":"The outline of a 2D shape."}],"title":"Path","kind":"symbol","url":"\/documentation\/openswiftui\/path","navigatorTitle":[{"kind":"identifier","text":"Path"}],"type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Path/init(ellipseIn:)":{"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ellipseIn","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Rect3D","preciseIdentifier":"s:11OpenSpatial6Rect3DV","kind":"typeIdentifier"},{"text":")","kind":"text"}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path\/init(ellipseIn:)","role":"symbol","abstract":[{"type":"text","text":"Creates a path as an ellipse within the given rectangle."}],"title":"init(ellipseIn:)","kind":"symbol","url":"\/documentation\/openswiftui\/path\/init(ellipsein:)","type":"topic"},"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","abstract":[],"title":"OpenSwiftUI","url":"\/documentation\/openswiftui","kind":"symbol","type":"topic"}}}