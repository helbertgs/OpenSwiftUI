{"metadata":{"externalID":"s:11OpenSwiftUI4PathV9ellipseInAC0A7Spatial6Rect3DV_tcfc","modules":[{"name":"OpenSwiftUI"}],"roleHeading":"Initializer","role":"symbol","symbolKind":"init","title":"init(ellipseIn:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ellipseIn","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Rect3D","preciseIdentifier":"s:11OpenSpatial6Rect3DV","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path"]]},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path\/init(ellipseIn:)"},"abstract":[{"type":"text","text":"Creates a path as an ellipse within the given rectangle."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"ellipseIn"},{"kind":"text","text":" "},{"kind":"internalParam","text":"rect"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSpatial6Rect3DV","kind":"typeIdentifier","text":"Rect3D"},{"kind":"text","text":")"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"rect","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The rectangle that bounds the ellipse."}]}]}]},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"This is a convenience function that creates a path of an ellipse.","type":"text"},{"text":" ","type":"text"},{"text":"Using this convenience function is more efficient than creating a path and adding an ellipse to it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The ellipse is approximated by a sequence of Bézier curves."},{"type":"text","text":" "},{"type":"text","text":"Its center is the midpoint of the rectangle defined by the rect parameter."},{"type":"text","text":" "},{"type":"text","text":"If the rectangle is square, then the ellipse is circular with a radius equal to one-half the width (or height) of the rectangle."},{"type":"text","text":" "},{"type":"text","text":"If the rect parameter specifies a rectangular shape, then the major and minor axes of the ellipse are defined by the width and height of the rectangle."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The ellipse forms a complete subpath of the path—that is, the ellipse drawing starts with a move-to operation and ends with a close-subpath operation, with all moves oriented in the clockwise direction."},{"type":"text","text":" "},{"type":"text","text":"If you supply an affine transform, then the constructed Bézier curves that define the ellipse are transformed before they are added to the path."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/path\/init(ellipsein:)"]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"kind":"symbol","role":"collection","title":"OpenSwiftUI","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","abstract":[],"type":"topic","url":"\/documentation\/openswiftui"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Path/init(ellipseIn:)":{"type":"topic","kind":"symbol","url":"\/documentation\/openswiftui\/path\/init(ellipsein:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ellipseIn","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Rect3D","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial6Rect3DV"},{"text":")","kind":"text"}],"title":"init(ellipseIn:)","role":"symbol","abstract":[{"type":"text","text":"Creates a path as an ellipse within the given rectangle."}],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path\/init(ellipseIn:)"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Path":{"kind":"symbol","url":"\/documentation\/openswiftui\/path","abstract":[{"type":"text","text":"The outline of a 2D shape."}],"title":"Path","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Path"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Path"}]}}}