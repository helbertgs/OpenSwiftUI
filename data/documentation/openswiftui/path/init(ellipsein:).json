{"metadata":{"roleHeading":"Initializer","modules":[{"name":"OpenSwiftUI"}],"symbolKind":"init","externalID":"s:11OpenSwiftUI4PathV9ellipseInAC0A7Spatial6Rect3DV_tcfc","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"ellipseIn"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial6Rect3DV","text":"Rect3D"},{"kind":"text","text":")"}],"title":"init(ellipseIn:)"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"ellipseIn"},{"kind":"text","text":" "},{"kind":"internalParam","text":"rect"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSpatial6Rect3DV","kind":"typeIdentifier","text":"Rect3D"},{"kind":"text","text":")"}],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"name":"rect","content":[{"inlineContent":[{"text":"The rectangle that bounds the ellipse.","type":"text"}],"type":"paragraph"}]}]},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"This is a convenience function that creates a path of an ellipse.","type":"text"},{"text":" ","type":"text"},{"text":"Using this convenience function is more efficient than creating a path and adding an ellipse to it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The ellipse is approximated by a sequence of Bézier curves.","type":"text"},{"text":" ","type":"text"},{"text":"Its center is the midpoint of the rectangle defined by the rect parameter.","type":"text"},{"text":" ","type":"text"},{"text":"If the rectangle is square, then the ellipse is circular with a radius equal to one-half the width (or height) of the rectangle.","type":"text"},{"text":" ","type":"text"},{"text":"If the rect parameter specifies a rectangular shape, then the major and minor axes of the ellipse are defined by the width and height of the rectangle.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The ellipse forms a complete subpath of the path—that is, the ellipse drawing starts with a move-to operation and ends with a close-subpath operation, with all moves oriented in the clockwise direction.","type":"text"},{"text":" ","type":"text"},{"text":"If you supply an affine transform, then the constructed Bézier curves that define the ellipse are transformed before they are added to the path.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path"]]},"abstract":[{"type":"text","text":"Creates a path as an ellipse within the given rectangle."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/path\/init(ellipsein:)"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path\/init(ellipseIn:)","interfaceLanguage":"swift"},"kind":"symbol","sections":[],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Path":{"title":"Path","abstract":[{"type":"text","text":"The outline of a 2D shape."}],"navigatorTitle":[{"text":"Path","kind":"identifier"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path","url":"\/documentation\/openswiftui\/path","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Path","kind":"identifier"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Path/init(ellipseIn:)":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path\/init(ellipseIn:)","url":"\/documentation\/openswiftui\/path\/init(ellipsein:)","abstract":[{"text":"Creates a path as an ellipse within the given rectangle.","type":"text"}],"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ellipseIn","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSpatial6Rect3DV","text":"Rect3D","kind":"typeIdentifier"},{"text":")","kind":"text"}],"type":"topic","role":"symbol","kind":"symbol","title":"init(ellipseIn:)"},"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"title":"OpenSwiftUI","abstract":[],"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","type":"topic","url":"\/documentation\/openswiftui","kind":"symbol","role":"collection"}}}