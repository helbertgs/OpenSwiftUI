{"sections":[],"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path\/addArc(tangent1End:tangent2End:radius:transform:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"addArc"},{"kind":"text","text":"("},{"kind":"externalParam","text":"tangent1End"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial7Point3DV","text":"Point3D"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tangent2End"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial7Point3DV","text":"Point3D"},{"kind":"text","text":", "},{"kind":"externalParam","text":"radius"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"transform"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial17AffineTransform3DV","text":"AffineTransform3D"},{"kind":"text","text":" = .identity)"}],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The end point, in user space coordinates, for the first tangent line to be used in constructing the arc. (The start point for this tangent line is the path’s current point.)","type":"text"}]}],"name":"tangent1End"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The end point, in user space coordinates, for the second tangent line to be used in constructing the arc. (The start point for this tangent line is the tangent1End point.)","type":"text"}]}],"name":"tangent2End"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The radius of the arc, in user space coordinates.","type":"text"}]}],"name":"radius"},{"content":[{"type":"paragraph","inlineContent":[{"text":"An affine transform to apply to the arc before adding to the path. Defaults to the identity transform if not specified.","type":"text"}]}],"name":"transform"}],"kind":"parameters"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method calculates two tangent lines—the first from the current point to the tangent1End point, and the second from the tangent1End point to the tangent2End point—then calculates the start and end points for a circular arc of the specified radius such that the arc is tangent to both lines."},{"type":"text","text":" "},{"type":"text","text":"Finally, this method approximates that arc with a sequence of cubic Bézier curves and appends those curves to the path."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the starting point of the arc (that is, the point where a circle of the specified radius must meet the first tangent line in order to also be tangent to the second line) is not the current point, this method appends a straight line segment from the current point to the starting point of the arc."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The ending point of the arc (that is, the point where a circle of the specified radius must meet the second tangent line in order to also be tangent to the first line) becomes the new current point of the path."}]}],"kind":"content"}],"metadata":{"roleHeading":"Instance Method","modules":[{"name":"OpenSwiftUI"}],"title":"addArc(tangent1End:tangent2End:radius:transform:)","externalID":"s:11OpenSwiftUI4PathV6addArc11tangent1End08tangent2H06radius9transformy0A7Spatial7Point3DV_AKSdAI17AffineTransform3DVtF","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"addArc"},{"kind":"text","text":"("},{"kind":"externalParam","text":"tangent1End"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial7Point3DV","text":"Point3D"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tangent2End"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial7Point3DV","text":"Point3D"},{"kind":"text","text":", "},{"kind":"externalParam","text":"radius"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"transform"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial17AffineTransform3DV","text":"AffineTransform3D"},{"kind":"text","text":")"}],"symbolKind":"method"},"kind":"symbol","abstract":[{"type":"text","text":"Adds an arc of a circle to the path, specified with a radius and two tangent lines."}],"variants":[{"paths":["\/documentation\/openswiftui\/path\/addarc(tangent1end:tangent2end:radius:transform:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Path/addArc(tangent1End:tangent2End:radius:transform:)":{"type":"topic","role":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path\/addArc(tangent1End:tangent2End:radius:transform:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"addArc"},{"kind":"text","text":"("},{"kind":"externalParam","text":"tangent1End"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Point3D","preciseIdentifier":"s:11OpenSpatial7Point3DV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tangent2End"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Point3D","preciseIdentifier":"s:11OpenSpatial7Point3DV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"radius"},{"kind":"text",