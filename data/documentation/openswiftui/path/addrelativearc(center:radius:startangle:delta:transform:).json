{"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path\/addRelativeArc(center:radius:startAngle:delta:transform:)","interfaceLanguage":"swift"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/path\/addrelativearc(center:radius:startangle:delta:transform:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"addRelativeArc"},{"kind":"text","text":"("},{"kind":"externalParam","text":"center"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSpatial7Point3DV","kind":"typeIdentifier","text":"Point3D"},{"kind":"text","text":", "},{"kind":"externalParam","text":"radius"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"startAngle"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial7Angle2DV","text":"Angle2D"},{"kind":"text","text":", "},{"kind":"externalParam","text":"delta"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial7Angle2DV","text":"Angle2D"},{"kind":"text","text":", "},{"kind":"externalParam","text":"transform"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial17AffineTransform3DV","text":"AffineTransform3D"},{"kind":"text","text":" = .identity)"}]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The center of the arc, in user space coordinates."}],"type":"paragraph"}],"name":"center"},{"name":"radius","content":[{"inlineContent":[{"type":"text","text":"The radius of the arc, in user space coordinates."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The angle to the starting point of the arc, measured from the positive x-axis."}],"type":"paragraph"}],"name":"startAngle"},{"content":[{"inlineContent":[{"type":"text","text":"The difference between the starting angle and ending angle of the arc. A positive value creates a counter- clockwise arc (in user space coordinates), and vice versa."}],"type":"paragraph"}],"name":"delta"},{"content":[{"inlineContent":[{"type":"text","text":"An affine transform to apply to the arc before adding to the path. Defaults to the identity transform if not specified."}],"type":"paragraph"}],"name":"transform"}]},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"text":"This method calculates starting and ending points using the radius and angles you specify, uses a sequence of cubic Bézier curves to approximate a segment of a circle between those points, and then appends those curves to the path.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The delta parameter determines both the length of the arc the direction in which the arc is created; the actual direction of the final path is dependent on the transform parameter and the current transform of a context where the path is drawn.","type":"text"},{"text":" ","type":"text"},{"text":"However, because OpenSwiftUI by default uses a vertically-flipped coordinate system (with the origin in the top-left of the view), specifying a clockwise arc results in a counterclockwise arc after the transformation is applied.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If the path ends with an unclosed subpath, this method adds a line connecting the current point to the starting point of the arc.","type":"text"},{"text":" ","type":"text"},{"text":"If there is no unclosed subpath, this method creates a new subpath whose starting point is the starting point of the arc.","type":"text"},{"text":" ","type":"text"},{"text":"The ending point of the arc becomes the new current point of the path.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path"]]},"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"addRelativeArc"},{"kind":"text","text":"("},{"kind":"externalParam","text":"center"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSpatial7Point3DV","kind":"typeIdentifier","text":"Point3D"},{"kind":"text","text":", "},{"kind":"externalParam","text":"radius"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"startAngle"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSpatial7Angle2DV","kind":"typeIdentifier","text":"Angle2D"},{"kind":"text","text":", "},{"kind":"externalParam","text":"delta"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSpatial7Angle2DV","kind":"typeIdentifier","text":"Angle2D"},{"kind":"text","text":", "},{"kind":"externalParam","text":"transform"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial17AffineTransform3DV","text":"AffineTransform3D"},{"kind":"text","text":")"}],"modules":[{"name":"OpenSwiftUI"}],"title":"addRelativeArc(center:radius:startAngle:delta:transform:)","role":"symbol","roleHeading":"Instance Method","symbolKind":"method","externalID":"s:11OpenSwiftUI4PathV14addRelativeArc6center6radius10startAngle5delta9transformy0A7Spatial7Point3DV_SdAJ7Angle2DVAnJ17AffineTransform3DVtF"},"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Adds an arc of a circle to the path, specified with a radius and a difference in angle.","type":"text"}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Path":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Path"}],"i