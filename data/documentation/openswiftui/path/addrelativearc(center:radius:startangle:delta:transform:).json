a circle to the path, specified with a radius and a difference in angle.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"addRelativeArc","kind":"identifier"},{"text":"(","kind":"text"},{"text":"center","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Point3D","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial7Point3DV"},{"text":", ","kind":"text"},{"text":"radius","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"startAngle","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Angle2D","preciseIdentifier":"s:11OpenSpatial7Angle2DV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"delta","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Angle2D","preciseIdentifier":"s:11OpenSpatial7Angle2DV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"transform","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"AffineTransform3D","preciseIdentifier":"s:11OpenSpatial17AffineTransform3DV","kind":"typeIdentifier"},{"text":" = .identity)","kind":"text"}]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The center of the arc, in user space coordinates."}]}],"name":"center"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The radius of the arc, in user space coordinates."}]}],"name":"radius"},{"content":[{"inlineContent":[{"type":"text","text":"The angle to the starting point of the arc, measured from the positive x-axis."}],"type":"paragraph"}],"name":"startAngle"},{"content":[{"inlineContent":[{"type":"text","text":"The difference between the starting angle and ending angle of the arc. A positive value creates a counter- clockwise arc (in user space coordinates), and vice versa."}],"type":"paragraph"}],"name":"delta"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An affine transform to apply to the arc before adding to the path. Defaults to the identity transform if not specified."}]}],"name":"transform"}],"kind":"parameters"},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method calculates starting and ending points using the radius and angles you specify, uses a sequence of cubic Bézier curves to approximate a segment of a circle between those points, and then appends those curves to the path."}]},{"type":"paragraph","inlineContent":[{"text":"The delta parameter determines both the length of the arc the direction in which the arc is created; the actual direction of the final path is dependent on the transform parameter and the current transform of a context where the path is drawn.","type":"text"},{"text":" ","type":"text"},{"text":"However, because SwiftUI by default uses a vertically-flipped coordinate system (with the origin in the top-left of the view), specifying a clockwise arc results in a counterclockwise arc after the transformation is applied.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If the path ends with an unclosed subpath, this method adds a line connecting the current point to the starting point of the arc.","type":"text"},{"text":" ","type":"text"},{"text":"If there is no unclosed subpath, this method creates a new subpath whose starting point is the starting point of the arc.","type":"text"},{"text":" ","type":"text"},{"text":"The ending point of the arc becomes the new current point of the path.","type":"text"}]}]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"abstract":[],"kind":"symbol","url":"\/documentation\/openswiftui","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","role":"collection","type":"topic","title":"OpenSwiftUI"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Path":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path","type":"topic","kind":"symbol","url":"\/documentation\/openswiftui\/path","title":"Path","abstract":[{"type":"text","text":"The outline of a 2D shape."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Path"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Path"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Path/addRelativeArc(center:radius:startAngle:delta:transform:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"addRelativeArc"},{"kind":"text","text":"("},{"kind":"externalParam","text":"center"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Point3D","preciseIdentifier":"s:11OpenSpatial7Point3DV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"radius"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":", "},{"kind":"externalParam","text":"startAngle"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Angle2D","preciseIdentifier":"s:11OpenSpatial7Angle2DV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"delta"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Angle2D","preciseIdentifier":"s:11OpenSpatial7Angle2DV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"transform"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"AffineTransform3D","preciseIdentifier":"s:11OpenSpatial17AffineTransform3DV"},{"kind":"text","text":")"}],"url":"\/documentation\/openswiftui\/path\/addrelativearc(center:radius:startangle:delta:transform:)","title":"addRelativeArc(center:radius:startAngle:delta:transform:)","role":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path\/addRelativeArc(center:radius:startAngle:delta:transform:)","type":"topic","abstract":[{"type":"text","text":"Adds an arc of a circle to the path, specified with a radius and a difference in angle."}],"kind":"symbol"}}}