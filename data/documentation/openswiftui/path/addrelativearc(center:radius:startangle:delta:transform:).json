{"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"addRelativeArc","kind":"identifier"},{"text":"(","kind":"text"},{"text":"center","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSpatial7Point3DV","text":"Point3D","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"radius","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"startAngle","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Angle2D","preciseIdentifier":"s:11OpenSpatial7Angle2DV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"delta","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Angle2D","preciseIdentifier":"s:11OpenSpatial7Angle2DV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"transform","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"AffineTransform3D","preciseIdentifier":"s:11OpenSpatial17AffineTransform3DV","kind":"typeIdentifier"},{"text":" = .identity)","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The center of the arc, in user space coordinates."}]}],"name":"center"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The radius of the arc, in user space coordinates."}]}],"name":"radius"},{"content":[{"inlineContent":[{"type":"text","text":"The angle to the starting point of the arc, measured from the positive x-axis."}],"type":"paragraph"}],"name":"startAngle"},{"content":[{"inlineContent":[{"type":"text","text":"The difference between the starting angle and ending angle of the arc. A positive value creates a counter- clockwise arc (in user space coordinates), and vice versa."}],"type":"paragraph"}],"name":"delta"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An affine transform to apply to the arc before adding to the path. Defaults to the identity transform if not specified."}]}],"name":"transform"}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"This method calculates starting and ending points using the radius and angles you specify, uses a sequence of cubic Bézier curves to approximate a segment of a circle between those points, and then appends those curves to the path."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The delta parameter determines both the length of the arc the direction in which the arc is created; the actual direction of the final path is dependent on the transform parameter and the current transform of a context where the path is drawn."},{"type":"text","text":" "},{"type":"text","text":"However, because SwiftUI by default uses a vertically-flipped coordinate system (with the origin in the top-left of the view), specifying a clockwise arc results in a counterclockwise arc after the transformation is applied."}],"type":"paragraph"},{"inlineContent":[{"text":"If the path ends with an unclosed subpath, this method adds a line connecting the current point to the starting point of the arc.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"If there is no unclosed subpath, this method creates a new subpath whose starting point is the starting point of the arc."},{"type":"text","text":" "},{"type":"text","text":"The ending point of the arc becomes the new current point of the path."}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path\/addRelativeArc(center:radius:startAngle:delta:transform:)"},"sections":[],"kind":"symbol","abstract":[{"type":"text","tex