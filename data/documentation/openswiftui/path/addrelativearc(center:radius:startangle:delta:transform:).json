{"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path"]]},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"addRelativeArc","kind":"identifier"},{"text":"(","kind":"text"},{"text":"center","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Point3D","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial7Point3DV"},{"text":", ","kind":"text"},{"text":"radius","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"startAngle"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial7Angle2DV","text":"Angle2D"},{"kind":"text","text":", "},{"kind":"externalParam","text":"delta"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial7Angle2DV","text":"Angle2D"},{"text":", ","kind":"text"},{"text":"transform","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"AffineTransform3D","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial17AffineTransform3DV"},{"text":" = .identity)","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"center","content":[{"inlineContent":[{"text":"The center of the arc, in user space coordinates.","type":"text"}],"type":"paragraph"}]},{"name":"radius","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The radius of the arc, in user space coordinates."}]}]},{"name":"startAngle","content":[{"inlineContent":[{"text":"The angle to the starting point of the arc, measured from the positive x-axis.","type":"text"}],"type":"paragraph"}]},{"name":"delta","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The difference between the starting angle and ending angle of the arc. A positive value creates a counter- clockwise arc (in user space coordinates), and vice versa."}]}]},{"name":"transform","content":[{"inlineContent":[{"text":"An affine transform to apply to the arc before adding to the path. Defaults to the identity transform if not specified.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"text":"This method calculates starting and ending points using the radius and angles you specify, uses a sequence of cubic Bézier curves to approximate a segment of a circle between those points, and then appends those curves to the path.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The delta parameter determines both the length of the arc the direction in which the arc is created; the actual direction of the final path is dependent on the transform parameter and the current transform of a context where the path is drawn."},{"type":"text","text":" "},{"type":"text","text":"However, because SwiftUI by default uses a vertically-flipped coordinate system (with the origin in the top-left of the view), specifying a clockwise arc results in a counterclockwise arc after the transformation is applied."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If the path ends with an unclosed subpath, this method adds a line connecting the current point to the starting point of the arc."},{"type":"text","text":" "},{"type":"text","text":"If there is no unclosed subpath, this method creates a new subpath whose starting point is the starting point of the arc."},{"type":"text","text":" "},{"type":"text","text":"The ending point of the arc becomes the new current point of the path."}],"type":"paragraph"}]}],"metadata":{"modules":[{"name":"OpenSwiftUI"}],"roleHeading":"Instance Method","externalID":"s:11OpenSwiftUI4PathV14addRelativeArc6center6radius10startAngle5delta9transformy0A7Spatial7Point3DV_SdAJ7Angle2DVAnJ17AffineTransform3DVtF","role":"symbol","title":"addRelativeArc(center:radius:startAngle:delta:transform:)","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"addRelativeArc"},{"kind":"text","text":"("},{"kind":"externalParam","text":"center"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSpatial7Point3DV","kind":"typeIdentifier","text":"Point3D"},{"kind":"text","text":", "},{"kind":"externalParam","text":"radius"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"startAngle"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSpatial7Angle2DV","kind":"typeIdentifier","text":"Angle2D"},{"kind":"text","text":", "},{"kind":"externalParam","text":"delta"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSpatial7Angle2DV","kind":"typeIdentifier","text":"Angle2D"},{"kind":"text","text":", "},{"kind":"externalParam","text":"transform"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSpatial17AffineTransform3DV","kind":"typeIdentifier","text":"AffineTransform3D"},{"kind":"text","text":")"}]},"kind":"symbol","sections":[],"abstract":[{"type":"text","text":"Adds an arc of a circle to the path, specified with a radius and a difference in angle."}],"variants":[{"paths":["\/documentation\/openswiftui\/path\/addrelativearc(center:radius:startangle:delta:transform:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path\/addRelativeArc(center:radius:startAngle:delta:transform:)","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Path/addRelativeArc(center:radius:startAngle:delta:transform:)":{"abstract":[{"text":"Adds an arc of a circle to the path, specified with a radius and a difference in angle.","type":"text"}],"url":"\/documentation\/openswiftui\/path\/addrelativearc(center:radius:startangle:delta:transform:)","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path\/addRelativeArc(center:radius:startAngle:delta:transform:)","title":"addRelativeArc(center:radius:startAngle:delta:transform:)","type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"addRelativeArc","kind":"identifier"},{"text":"(","kind":"text"},{"text":"center","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Point3D","preciseIdentifier":"s:11OpenSpatial7Point3DV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"radius","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"startAngle","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Angle2D","preciseIdentifier":"s:11OpenSpatial7Angle2DV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"delta","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Angle2D","preciseIdentifier":"s:11OpenSpatial7Angle2DV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"transform","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"AffineTransform3D","preciseIdentifier":"s:11OpenSpatial17AffineTransform3DV","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"kind":"symbol","role":"collection","title":"OpenSwiftUI","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","abstract":[],"type":"topic","url":"\/documentation\/openswiftui"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Path":{"kind":"symbol","url":"\/documentation\/openswiftui\/path","abstract":[{"type":"text","text":"The outline of a 2D shape."}],"title":"Path","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path","type"