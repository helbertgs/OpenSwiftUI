{"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path\/addRelativeArc(center:radius:startAngle:delta:transform:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path"]]},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"addRelativeArc","kind":"identifier"},{"text":"(","kind":"text"},{"text":"center","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Point3D","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial7Point3DV"},{"text":", ","kind":"text"},{"text":"radius","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":", ","kind":"text"},{"text":"startAngle","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Angle2D","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial7Angle2DV"},{"text":", ","kind":"text"},{"text":"delta","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Angle2D","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial7Angle2DV"},{"text":", ","kind":"text"},{"text":"transform","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"AffineTransform3D","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial17AffineTransform3DV"},{"text":" = .identity)","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]},{"parameters":[{"name":"center","content":[{"inlineContent":[{"type":"text","text":"The center of the arc, in user space coordinates."}],"type":"paragraph"}]},{"name":"radius","content":[{"inlineContent":[{"type":"text","text":"The radius of the arc, in user space coordinates."}],"type":"paragraph"}]},{"name":"startAngle","content":[{"inlineContent":[{"type":"text","text":"The angle to the starting point of the arc, measured from the positive x-axis."}],"type":"paragraph"}]},{"name":"delta","content":[{"inlineContent":[{"type":"text","text":"The difference between the starting angle and ending angle of the arc. A positive value creates a counter- clockwise arc (in user space coordinates), and vice versa."}],"type":"paragraph"}]},{"name":"transform","content":[{"inlineContent":[{"type":"text","text":"An affine transform to apply to the arc before adding to the path. Defaults to the identity transform if not specified."}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method calculates starting and ending points using the radius and angles you specify, uses a sequence of cubic Bézier curves to approximate a segment of a circle between those points, and then appends those curves to the path."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The delta parameter determines both the length of the arc the direction in which the arc is created; the actual direction of the final path is dependent on the transform parameter and the current transform of a context where the path is drawn."},{"type":"text","text":" "},{"type":"text","text":"However, because OpenSwiftUI by default uses a vertically-flipped coordinate system (with the origin in the top-left of the view), specifying a clockwise arc results in a counterclockwise arc after the transformation is applied."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the path ends with an unclosed subpath, this method adds a line connecting the current point to the starting point of the arc."},{"type":"text","text":" "},{"type":"text","text":"If there is no unclosed subpath, this method creates a new subpath whose starting point is the starting point of the arc."},{"type":"text","text":" "},{"type":"text","text":"The ending point of the arc becomes the new current point of the path."}]}]}],"sections":[],"abstract":[{"text":"Adds an arc of a circle to the path, specified with a radius and a difference in angle.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/path\/addrelativearc(center:radius:startangle:delta:transform:)"]}],"metadata":{"role":"symbol","symbolKind":"method","title":"addRelativeArc(center:radius:startAngle:delta:transform:)","externalID":"s:11OpenSwiftUI4PathV14addRelativeArc6center6radius10startAngle5delta9transformy0A7Spatial7Point3DV_SdAJ7Angle2DVAnJ17AffineTransform3DVtF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"addRelativeArc","kind":"identifier"},{"text":"(","kind":"text"},{"text":"center","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Point3D","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial7Point3DV"},{"text":", ","kind":"text"},{"text":"radius","kind":"externalParam"},{"kind":"text","text":": "},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":", ","kind":"text"},{"text":"startAngle","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Angle2D","preciseIdentifier":"s:11OpenSpatial7Angle2DV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"delta","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Angle2D","preciseIdentifier":"s:11OpenSpatial7Angle2DV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"transform","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"AffineTransform3D","preciseIdentifier":"s:11OpenSpatial17AffineTransform3DV","kind":"typeIdentifier"},{"text":")","kind":"text"}],"modules":[{"name":"OpenSwiftUI"}],"roleHeading":"Instance Method"},"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Path":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path","role":"symbol","kind":"symbol","type":"topic