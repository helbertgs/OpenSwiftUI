{"sections":[],"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path"]]},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path\/addEllipse(in:transform:)","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"addEllipse","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"rect","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Rect3D","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial6Rect3DV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"transform"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11OpenSpatial17AffineTransform3DV","kind":"typeIdentifier","text":"AffineTransform3D"},{"kind":"text","text":" = .identity)"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"rect","content":[{"type":"paragraph","inlineContent":[{"text":"A rectangle that defines the area for the ellipse to fit in.","type":"text"}]}]},{"name":"transform","content":[{"type":"paragraph","inlineContent":[{"text":"An affine transform to apply to the ellipse before adding to the path. Defaults to the identity transform if not specified.","type":"text"}]}]}],"kind":"parameters"},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The ellipse is approximated by a sequence of Bézier curves."},{"type":"text","text":" "},{"type":"text","text":"Its center is the midpoint of the rectangle defined by the rect parameter."},{"type":"text","text":" "},{"type":"text","text":"If the rectangle is square, then the ellipse is circular with a radius equal to one-half the width (or height) of the rectangle."},{"type":"text","text":" "},{"type":"text","text":"If the rect parameter specifies a rectangular shape, then the major and minor axes of the ellipse are defined by the width and height of the rectangle."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The ellipse forms a complete subpath of the path— that is, the ellipse drawing starts with a move-to operation and ends with a close-subpath operation, with all moves oriented in the clockwise direction."}]}],"kind":"content"}],"kind":"symbol","metadata":{"title":"addEllipse(in:transform:)","symbolKind":"method","role":"symbol","modules":[{"name":"OpenSwiftUI"}],"roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"addEllipse","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Rect3D","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial6Rect3DV"},{"text":", ","kind":"text"},{"text":"transform","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"AffineTransform3D","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial17AffineTransform3DV"},{"text":")","kind":"text"}],"externalID":"s:11OpenSwiftUI4PathV10addEllipse2in9transformy0A7Spatial6Rect3DV_AG17AffineTransform3DVtF"},"abstract":[{"text":"Adds an ellipse that fits inside the specified rectangle to the path.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/path\/addellipse(in:transform:)"]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Path/addEllipse(in:transform:)":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path\/addEllipse(in:transform:)","role":"symbol","title":"addEllipse(in:transform:)","abstract":[{"type":"text","text":"Adds an ellipse that fits inside the specified rectangle to the path."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},