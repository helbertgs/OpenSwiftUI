{"abstract":[{"text":"Adds an ellipse that fits inside the specified rectangle to the path.","type":"text"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/path\/addellipse(in:transform:)"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"symbolKind":"method","roleHeading":"Instance Method","externalID":"s:11OpenSwiftUI4PathV10addEllipse2in9transformy0A7Spatial6Rect3DV_AG17AffineTransform3DVtF","modules":[{"name":"OpenSwiftUI"}],"title":"addEllipse(in:transform:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"addEllipse","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Rect3D","preciseIdentifier":"s:11OpenSpatial6Rect3DV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"transform","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"AffineTransform3D","preciseIdentifier":"s:11OpenSpatial17AffineTransform3DV","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path"]]},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path\/addEllipse(in:transform:)","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"addEllipse","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"rect","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Rect3D","preciseIdentifier":"s:11OpenSpatial6Rect3DV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"transform","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"AffineTransform3D","preciseIdentifier":"s:11OpenSpatial17AffineTransform3DV","kind":"typeIdentifier"},{"text":" = .identity)","kind":"text"}],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A rectangle that defines the area for the ellipse to fit in."}]}],"name":"rect"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An affine transform to apply to the ellipse before adding to the path. Defaults to the identity transform if not specified."}]}],"name":"transform"}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The ellipse is approximated by a sequence of Bézier curves."},{"type":"text","text":" "},{"type":"text","text":"Its center is the midpoint of the rectangle defined by the rect parameter."},{"type":"text","text":" "},{"type":"text","text":"If the rectangle is square, then the ellipse is circular with a radius equal to one-half the width (or height) of the rectangle."},{"type":"text","text":" "},{"type":"text","text":"If the rect parameter specifies a rectangular shape, then the major and minor axes of the ellipse are defined by the width and height of the rectangle."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The ellipse forms a complete subpath of the path— that is, the ellipse drawing starts with a move-to operation and ends with a close-subpath operation, with all moves oriented in the clockwise direction."}]}]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Path":{"identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path","role":"symbol","kind":"symbol","type":"topic","navigatorTitle":[{"text":"Path","kind":"identifier"}],"abstract":[{"type":"text","text":"The outline of a 2D shape."}],"title":"Path","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Path","kind":"identi