{"kind":"symbol","sections":[],"metadata":{"symbolKind":"method","externalID":"s:11OpenSwiftUI4PathV10addEllipse2in9transformy0A7Spatial6Rect3DV_AG17AffineTransform3DVtF","modules":[{"name":"OpenSwiftUI"}],"roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"addEllipse","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSpatial6Rect3DV","text":"Rect3D","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"transform","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11OpenSpatial17AffineTransform3DV","text":"AffineTransform3D","kind":"typeIdentifier"},{"text":")","kind":"text"}],"role":"symbol","title":"addEllipse(in:transform:)"},"identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path\/addEllipse(in:transform:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"addEllipse","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"rect","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Rect3D","preciseIdentifier":"s:11OpenSpatial6Rect3DV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"transform","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"AffineTransform3D","preciseIdentifier":"s:11OpenSpatial17AffineTransform3DV","kind":"typeIdentifier"},{"text":" = .identity)","kind":"text"}]}]},{"parameters":[{"name":"rect","content":[{"inlineContent":[{"text":"A rectangle that defines the area for the ellipse to fit in.","type":"text"}],"type":"paragraph"}]},{"name":"transform","content":[{"type":"paragraph","inlineContent":[{"text":"An affine transform to apply to the ellipse before adding to the path. Defaults to the identity transform if not specified.","type":"text"}]}]}],"kind":"parameters"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"The ellipse is approximated by a sequence of Bézier curves.","type":"text"},{"text":" ","type":"text"},{"text":"Its center is the midpoint of the rectangle defined by the rect parameter.","type":"text"},{"text":" ","type":"text"},{"text":"If the rectangle is square, then the ellipse is circular with a radius equal to one-half the width (or height) of the rectangle.","type":"text"},{"text":" ","type":"text"},{"text":"If the rect parameter specifies a rectangular shape, then the major and minor axes of the ellipse are defined by the width and height of the rectangle.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The ellipse forms a complete subpath of the path— that is, the ellipse drawing starts with a move-to operation and ends with a close-subpath operation, with all moves oriented in the clockwise direction."}]}],"kind":"content"}],"abstract":[{"type":"text","text":"Adds an ellipse that fits inside the specified rectangle to the path."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/path\/addellipse(in:transform:)"]}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI":{"kind":"symbol","role":"collection","title":"OpenSwiftUI","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","abstract":[],"type":"topic","url":"\/documentation\/openswiftui"},"doc://OpenSwiftUI/documentation/OpenSwiftUI/Path":{"kind":"symbol","url":"\/documentation\/openswiftui\/path","abstract":[{"type":"text","text":"The outline of a 2D shape.