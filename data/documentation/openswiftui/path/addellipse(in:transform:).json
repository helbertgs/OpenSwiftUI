{"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path"]]},"metadata":{"externalID":"s:11OpenSwiftUI4PathV10addEllipse2in9transformy0A7Spatial6Rect3DV_AG17AffineTransform3DVtF","title":"addEllipse(in:transform:)","role":"symbol","roleHeading":"Instance Method","symbolKind":"method","modules":[{"name":"OpenSwiftUI"}],"fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"addEllipse","kind":"identifier"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Rect3D","preciseIdentifier":"s:11OpenSpatial6Rect3DV"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"transform"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"AffineTransform3D","preciseIdentifier":"s:11OpenSpatial17AffineTransform3DV"},{"kind":"text","text":")"}]},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","identifier":{"url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path\/addEllipse(in:transform:)","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"addEllipse","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"rect","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Rect3D","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial6Rect3DV"},{"text":", ","kind":"text"},{"text":"transform","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"AffineTransform3D","kind":"typeIdentifier","preciseIdentifier":"s:11OpenSpatial17AffineTransform3DV"},{"text":" = .identity)","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A rectangle that defines the area for the ellipse to fit in."}]}],"name":"rect"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An affine transform to apply to the ellipse before adding to the path. Defaults to the identity transform if not specified."}]}],"name":"transform"}],"kind":"parameters"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"The ellipse is approximated by a sequence of Bézier curves.","type":"text"},{"text":" ","type":"text"},{"text":"Its center is the midpoint of the rectangle defined by the rect parameter.","type":"text"},{"text":" ","type":"text"},{"text":"If the rectangle is square, then the ellipse is circular with a radius equal to one-half the width (or height) of the rectangle.","type":"text"},{"text":" ","type":"text"},{"text":"If the rect parameter specifies a rectangular shape, then the major and minor axes of the ellipse are defined by the width and height of the rectangle.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The ellipse forms a complete subpath of the path— that is, the ellipse drawing starts with a move-to operation and ends with a close-subpath operation, with all moves oriented in the clockwise direction.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/path\/addellipse(in:transform:)"]}],"abstract":[{"type":"text","text":"Adds an ellipse that fits inside the specified rectangle to the path."}],"references":{"doc://OpenSwiftUI/documentation/OpenSwiftUI/Path/addEllipse(in:transform:)":{"title":"addEllipse(in:transform:)","role":"symbol","type":"topic","url":"\/documentation\/openswiftui\/path\/addellipse(in:transform:)","kind":"symbol","identifier":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Path\/addEllipse(in:transform:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text"