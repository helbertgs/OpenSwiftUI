{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","abstract":[{"text":"A property wrapper type that can read and write a value owned by a source of","type":"text"},{"text":" ","type":"text"},{"text":"truth.","type":"text"}],"metadata":{"modules":[{"name":"OpenSwiftUI"}],"title":"Binding","externalID":"s:11OpenSwiftUI7BindingV","role":"symbol","roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Binding","kind":"identifier"}],"symbolKind":"struct","navigatorTitle":[{"text":"Binding","kind":"identifier"}]},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/DynamicProperty","doc:\/\/OpenSwiftUI\/SK","doc:\/\/OpenSwiftUI\/Sl","doc:\/\/OpenSwiftUI\/s8CopyableP","doc:\/\/OpenSwiftUI\/Sk","doc:\/\/OpenSwiftUI\/ST"],"kind":"relationships","type":"conformsTo"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"attribute","text":"@propertyWrapper"},{"kind":"text","text":" "},{"kind":"attribute","text":"@dynamicMemberLookup"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Binding"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Value"},{"kind":"text","text":">"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Use a binding to create a two-way connection between a property that stores"},{"type":"text","text":" "},{"type":"text","text":"data, and a view that displays and changes the data. A binding connects a"},{"type":"text","text":" "},{"type":"text","text":"property to a source of truth stored elsewhere, instead of storing data"},{"type":"text","text":" "},{"type":"text","text":"directly. For example, a button that toggles between play and pause can"},{"type":"text","text":" "},{"type":"text","text":"create a binding to a property of its parent view using the "},{"type":"codeVoice","code":"Binding"},{"type":"text","text":" "},{"type":"text","text":"property wrapper."}],"type":"paragraph"},{"code":["struct PlayButton: View {","    @Binding var isPlaying: Bool","","    var body: some View {","        Button(isPlaying ? \"Pause\" : \"Play\") {","            isPlaying.toggle()","        }","    }","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The parent view declares a property to hold the playing state, using the"},{"type":"text","text":" "},{"type":"codeVoice","code":"State"},{"type":"text","text":" property wrapper to indicate that this property is the value’s"},{"type":"text","text":" "},{"type":"text","text":"source of truth."}],"type":"paragraph"},{"code":["struct PlayerView: View {","    var episode: Episode","    @State private var isPlaying: Bool = false","","    var body: some View {","        VStack {","            Text(episode.title)","                .foregroundStyle(isPlaying ? .primary : .secondary)","            PlayButton(isPlaying: $isPlaying) \/\/ Pass a binding.","        }","    }","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"When ","type":"text"},{"code":"PlayerView","type":"codeVoice"},{"text":" initializes ","type":"text"},{"code":"PlayButton","type":"codeVoice"},{"text":", it passes a binding of its state","type":"text"},{"text":" ","type":"text"},{"text":"property into the button’s binding property. Applying the ","type":"text"},{"code":"$","type":"codeVoice"},{"text":" prefix to a","type":"text"},{"text":" ","type":"text"},{"text":"property wrapped value returns its ","type":"text"},{"code":"State\/projectedValue","type":"codeVoice"},{"text":", which for a","type":"text"},{"text":" ","type":"text"},{"text":"state property wrapper returns a binding to the value.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Whenever the user taps the "},{"code":"PlayButton","type":"codeVoice"},{"type":"text","text":", the "},{"code":"PlayerView","type":"codeVoice"},{"type":"text","text":" updates its"},{"type":"text","text":" "},{"code":"isPlaying","type":"codeVoice"},{"type":"text","text":" state."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/openswiftui\/binding"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding"},"topicSections":[{"anchor":"Initializers","generated":true,"title":"Initializers","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding\/init(_:)-57cwg","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding\/init(_:)-jtxz","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding\/init(_:)-qgp1","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding\/init(get:set:)","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding\/init(projectedValue:)"]},{"anchor":"Instance-Properties","generated":true,"title":"Instance Properties","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding\/projectedValue","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding\/wrappedValue"]},{"anchor":"Instance-Methods","generated":true,"title":"Instance Methods","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding\/animation(_:)","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding\/transaction(_:)"]},{"anchor":"Subscripts","generated":true,"title":"Subscripts","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding\/subscript(dynamicMember:)"]},{"anchor":"Type-Methods","generated":true,"title":"Type Methods","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding\/constant(_:)"]},{"anchor":"Default-Implementations","generated":true,"title":"Default Implementations","identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/B