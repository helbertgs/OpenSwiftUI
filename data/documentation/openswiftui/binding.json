{"abstract":[{"type":"text","text":"A property wrapper type that can read and write a value owned by a source of"},{"type":"text","text":" "},{"type":"text","text":"truth."}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openswiftui\/binding"]}],"metadata":{"symbolKind":"struct","externalID":"s:11OpenSwiftUI7BindingV","roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Binding"}],"navigatorTitle":[{"kind":"identifier","text":"Binding"}],"modules":[{"name":"OpenSwiftUI"}],"role":"symbol","title":"Binding"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"@propertyWrapper","kind":"attribute"},{"text":" ","kind":"text"},{"text":"@dynamicMemberLookup","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Binding","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Value","kind":"genericParameter"},{"text":">","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"text":"Use a binding to create a two-way connection between a property that stores","type":"text"},{"text":" ","type":"text"},{"text":"data, and a view that displays and changes the data. A binding connects a","type":"text"},{"text":" ","type":"text"},{"text":"property to a source of truth stored elsewhere, instead of storing data","type":"text"},{"text":" ","type":"text"},{"text":"directly. For example, a button that toggles between play and pause can","type":"text"},{"text":" ","type":"text"},{"text":"create a binding to a property of its parent view using the ","type":"text"},{"code":"Binding","type":"codeVoice"},{"text":" ","type":"text"},{"text":"property wrapper.","type":"text"}],"type":"paragraph"},{"code":["struct PlayButton: View {","    @Binding var isPlaying: Bool","","    var body: some View {","        Button(isPlaying ? \"Pause\" : \"Play\") {","            isPlaying.toggle()","        }","    }","}"],"type":"codeListing","syntax":null},{"inlineContent":[{"text":"The parent view declares a property to hold the playing state, using the","type":"text"},{"text":" ","type":"text"},{"code":"State","type":"codeVoice"},{"text":" property wrapper to indicate that this property is the value’s","type":"text"},{"text":" ","type":"text"},{"text":"source of truth.","type":"text"}],"type":"paragraph"},{"code":["struct PlayerView: View {","    var episode: Episode","    @State private var isPlaying: Bool = false","","    var body: some View {","        VStack {","            Text(episode.title)","                .foregroundStyle(isPlaying ? .primary : .secondary)","            PlayButton(isPlaying: $isPlaying) \/\/ Pass a binding.","        }","    }","}"],"type":"codeListing","syntax":null},{"inlineContent":[{"text":"When ","type":"text"},{"code":"PlayerView","type":"codeVoice"},{"text":" initializes ","type":"text"},{"code":"PlayButton","type":"codeVoice"},{"text":", it passes a binding of its state","type":"text"},{"text":" ","type":"text"},{"text":"property into the button’s binding property. Applying the ","type":"text"},{"code":"$","type":"codeVoice"},{"text":" prefix to a","type":"text"},{"text":" ","type":"text"},{"text":"property wrapped value returns its ","type":"text"},{"code":"State\/projectedValue","type":"codeVoice"},{"text":", which for a","type":"text"},{"text":" ","type":"text"},{"text":"state property wrapper returns a binding to the value.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Whenever the user taps the "},{"type":"codeVoice","code":"PlayButton"},{"type":"text","text":", the "},{"type":"codeVoice","code":"PlayerView"},{"type":"text","text":" updates its"},{"type":"text","text":" "},{"type":"codeVoice","code":"isPlaying"},{"type":"text","text":" state."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI"]]},"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding\/init(_:)-57cwg","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding\/init(_:)-jtxz","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding\/init(_:)-qgp1","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding\/init(get:set:)","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding\/init(projectedValue:)"],"anchor":"Initializers","title":"Initializers","generated":true},{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding\/projectedValue","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding\/wrappedValue"],"anchor":"Instance-Properties","title":"Instance Properties","generated":true},{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding\/animation(_:)","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding\/transaction(_:)"],"anchor":"Instance-Methods","title":"Instance Methods","generated":true},{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding\/subscript(dynamicMember:)"],"anchor":"Subscripts","title":"Subscripts","generated":true},{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding\/constant(_:)"],"anchor":"Type-Methods","title":"Type Methods","generated":true},{"identifiers":["doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding\/BidirectionalCollection-Implementations","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding\/Collection-Implementations","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding\/DynamicProperty-Implementations","doc:\/\/OpenSwiftUI\/documentation\/OpenSwiftUI\/Binding\/RandomAccessCollection-Implementations